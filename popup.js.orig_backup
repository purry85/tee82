    const btnToggleActionList = document.getElementById('btnToggleActionList');
    const actionListMenu = document.getElementById('actionListMenu');
    const actionListArrow = document.getElementById('actionListArrow');
    if (btnToggleActionList && actionListMenu) {
        btnToggleActionList.addEventListener('click', () => {
            const isHidden = actionListMenu.style.display === 'none' || !actionListMenu.style.display;
            actionListMenu.style.display = isHidden ? 'block' : 'none';
            if (actionListArrow) {
                actionListArrow.textContent = isHidden ? '▴ 접기' : '▾ 펼치기';
            }
            try {
                localStorage.setItem('v2_actionListOpen', isHidden ? 'true' : 'false');
            } catch(e) {}
        });

        // 이전 열림/닫힘 상태 복원 (기본값: 닫힘 false)
        try {
            const savedActionOpen = localStorage.getItem('v2_actionListOpen');
            if (savedActionOpen === 'true') {
                actionListMenu.style.display = 'block';
                if (actionListArrow) actionListArrow.textContent = '▴ 접기';
            } else {
                actionListMenu.style.display = 'none';
                if (actionListArrow) actionListArrow.textContent = '▾ 펼치기';
            }
        } catch(e) {}
    }

    // 자동등록 중단 이벤트 연결 (진행 모달 내 버튼 및 상단 헤더 버튼)
    document.getElementById('btnStopRegistration')?.addEventListener('click', stopRegistration);
    document.getElementById('btnHeaderStop')?.addEventListener('click', stopRegistration);

    // 독립창으로 분리 (화면 높이의 88% 이상으로 길게 열기)
    const btnPopout = document.getElementById('btnPopoutWindow');
    if (btnPopout) {
        btnPopout.addEventListener('click', () => {
            const h = Math.min(1050, Math.floor(window.screen.availHeight * 0.88));
            const w = 530;
            const left = Math.max(0, window.screen.availWidth - w - 20);
            chrome.windows.create({
                url: chrome.runtime.getURL('popup.html?mode=window'),
                type: 'popup',
                width: w,
                height: h,
                top: 40,
                left: left
            });
            window.close();
        });
    }

    // 사이드패널 열기 (화면 전체 100% 높이)
    const btnSidePanel = document.getElementById('btnOpenSidePanel');
    if (btnSidePanel) {
        btnSidePanel.addEventListener('click', async () => {
            try {
                if (chrome.sidePanel && typeof chrome.sidePanel.open === 'function') {
                    const win = await chrome.windows.getCurrent();
                    await chrome.sidePanel.open({ windowId: win.id });
                    window.close();
                    return;
                }
            } catch (err) {
                console.warn('[AutomaTee] popup에서 sidePanel.open 직접 호출 실패:', err);
            }
            chrome.runtime.sendMessage({ action: 'OPEN_SIDE_PANEL' }, (res) => {
                if (res && res.success) {
                    window.close();
                }
            });
        });
    }

    // ----------------------------------------------------
    // AutomaTee 최신 업데이트 모달 및 자동 업데이트 연동 로직
    // ----------------------------------------------------
    try {
        document.title = '오토매티 자동등록 솔루션';
        // [핵심] 디스크에 새 파일(최신 버전)이 덮어씌워졌을 때 사용자가 수동 '다시 로드'를 누를 필요 없이 자동 새로고침(reload)
        if (typeof chrome !== 'undefined' && chrome.runtime?.getURL && chrome.runtime?.reload && chrome.runtime?.getManifest) {
            const curRunningVer = chrome.runtime.getManifest()?.version || '';
            fetch(chrome.runtime.getURL('version.json?_t=' + Date.now()), { cache: 'no-store' })
                .then(r => r.ok ? r.json() : null)
                .then(vj => {
                    const diskVer = vj?.version ? String(vj.version).trim() : '';
                    if (diskVer && curRunningVer && compareVersions(diskVer, curRunningVer) > 0) {
                        console.log(`[AutomaTee] 디스크 최신 파일 감지 (v${curRunningVer} -> v${diskVer}) -> 브라우저 자동 새로고침(reload) 실행`);
                        chrome.runtime.reload();
                    }
                })
                .catch(() => {});
        }
    } catch (e) {}

    const INITIAL_APP_VERSION = "2.0.0";

    function getCurrentAppVersion() {
        let manifestVer = null;
        try {
            if (typeof chrome !== 'undefined' && chrome.runtime?.getManifest?.()?.version) {
                manifestVer = chrome.runtime.getManifest().version;
            }
        } catch (e) {}

        // 브라우저 메모리에 실제 로드된 manifest 버전이 최우선 (버전 비교 왜곡 원천 차단)
        if (manifestVer && /^\d+(\.\d+)+$/.test(manifestVer.trim())) {
            return manifestVer.trim();
        }

        let customVer = null;
        try {
            customVer = localStorage.getItem('v2_custom_app_version');
        } catch (e) {}
        if (customVer && /^\d+(\.\d+)+$/.test(customVer.trim())) {
            return customVer.trim();
        }
        return INITIAL_APP_VERSION;
    }

    function updateAppVersionUI(ver) {
        const v = ver || getCurrentAppVersion();
        document.querySelectorAll('#footerAppVersion').forEach(el => {
            el.textContent = `Ver ${v}`;
        });
        document.querySelectorAll('#badgeCurrentVer, .badge-ver').forEach(el => {
            el.textContent = `Ver ${v} (최신)`;
        });
    }

    // 초기 UI 즉시 반영
    updateAppVersionUI();

    const updateModal = document.getElementById('updateModal');
    const btnOpenUpdateModal = document.getElementById('btnOpenUpdateModal');
    const btnQuickActionUpdate = document.getElementById('btnQuickActionUpdate');
    const btnFooterUpdate = document.getElementById('btnFooterUpdate');
    const btnCloseUpdateModalX = document.getElementById('btnCloseUpdateModalX');
    const btnCloseUpdateModal = document.getElementById('btnCloseUpdateModal');
    const btnRunFullUpdate = document.getElementById('btnRunFullUpdate');
    const btnSyncDictFromGitHub = document.getElementById('btnSyncDictFromGitHub');
    const fullUpdateStatusHint = document.getElementById('fullUpdateStatusHint');
    const syncDictStatusHint = document.getElementById('syncDictStatusHint');

    function openUpdateModal() {
        if (updateModal) {
            updateModal.style.display = 'flex';
            updateAppVersionUI();
            if (typeof initAdminReleasePublisher === 'function') initAdminReleasePublisher();
            const cardMobileUpdate = document.getElementById('cardMobileUpdate');
            if (cardMobileUpdate) {
                cardMobileUpdate.style.setProperty('display', 'flex', 'important');
            }
            if (fullUpdateStatusHint) {
                fullUpdateStatusHint.innerHTML = "※ 최초 1회는 아래 2번의 <strong>[원클릭 환경 등록]</strong>을 완료해 두시면 바로 연결됩니다.";
            }
            if (syncDictStatusHint) {
                syncDictStatusHint.innerHTML = "※ 브라우저 안에서 1초 만에 최신 구장명 사전을 가져와 병합합니다.";
            }
        }
    }

    function closeUpdateModal() {
        if (updateModal) updateModal.style.display = 'none';
    }

    if (btnOpenUpdateModal) btnOpenUpdateModal.addEventListener('click', openUpdateModal);
    if (btnQuickActionUpdate) btnQuickActionUpdate.addEventListener('click', openUpdateModal);
    if (btnFooterUpdate) {
        btnFooterUpdate.addEventListener('click', (e) => {
            e.preventDefault();
            openUpdateModal();
        });
    }
    if (btnCloseUpdateModalX) btnCloseUpdateModalX.addEventListener('click', closeUpdateModal);
    if (btnCloseUpdateModal) btnCloseUpdateModal.addEventListener('click', closeUpdateModal);
    if (updateModal) {
        updateModal.addEventListener('click', (e) => {
            if (e.target === updateModal) closeUpdateModal();
        });
    }

    const isMobileDevice = /Android|iPhone|iPad|iPod|Lemur/i.test(navigator.userAgent || '');
    const GITHUB_ZIP_DOWNLOAD_URL = 'https://github.com/purry85/tee82/archive/refs/heads/main.zip';

    function clearAuthOnUpdate() {
        try {
            if (typeof isCurrentUserAdmin === 'function' && isCurrentUserAdmin()) {
                console.log('[AutomaTee Auth] 관리자 계정 감지 -> 업데이트 다운로드 시 로그인 세션 유지 (로그아웃 제외)');
                return;
            }
            localStorage.removeItem('v2_auth_user');
            localStorage.removeItem('v2_auth_app_version');
            localStorage.removeItem('v2_labModeActive');
            localStorage.removeItem('v2_isAdmin');
            localStorage.removeItem('v2_multiFeatureActive');
            if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
                chrome.storage.local.remove(['v2_auth_user', 'v2_labModeActive', 'v2_isAdmin', 'v2_multiFeatureActive']);
                chrome.storage.local.set({ v2_auth_invalidated_at: Date.now() });
            }
        } catch (e) {}
    }

    function downloadMobileUpdateZip() {
        clearAuthOnUpdate();
        showToast('📥 모바일 최신 배포 ZIP 다운로드를 시작합니다...');
        try {
            const link = document.createElement('a');
            link.href = GITHUB_ZIP_DOWNLOAD_URL;
            link.download = 'tee82-latest.zip';
            link.target = '_blank';
            document.body.appendChild(link);
            link.click();
            setTimeout(() => link.remove(), 1000);
        } catch(e) {
            window.open(GITHUB_ZIP_DOWNLOAD_URL, '_blank');
        }
    }

    const btnDownloadMobileZip = document.getElementById('btnDownloadMobileZip');
    if (btnDownloadMobileZip) {
        btnDownloadMobileZip.addEventListener('click', downloadMobileUpdateZip);
    }

    function launchUpdateProtocol() {
        clearAuthOnUpdate();
        if (isMobileDevice) {
            downloadMobileUpdateZip();
            return;
        }
        try {
            const link = document.createElement('a');
            link.href = 'tee82://update';
            link.style.display = 'none';
            document.body.appendChild(link);
            link.click();
            setTimeout(() => link.remove(), 1000);
        } catch(e) {
            window.location.href = 'tee82://update';
        }
    }

    function launchGithubUploadProtocol(targetVersion, targetTitle = '', targetNotes = '') {
        const v = (targetVersion || '').trim();
        let query = '';
        try {
            if (targetTitle || targetNotes) {
                const tB64 = btoa(unescape(encodeURIComponent(targetTitle || '')));
                const nB64 = btoa(unescape(encodeURIComponent(targetNotes || '')));
                query = `?t=${encodeURIComponent(tB64)}&n=${encodeURIComponent(nB64)}`;
            }
        } catch(e) {}
        const protocolUrl = `tee82-upload://${encodeURIComponent(v)}${query}`;
        try {
            const link = document.createElement('a');
            link.href = protocolUrl;
            link.style.display = 'none';
            document.body.appendChild(link);
            link.click();
            setTimeout(() => link.remove(), 1000);
        } catch(e) {
            try {
                window.location.href = protocolUrl;
            } catch(locErr) {}
        }
    }

    // 1. 원클릭 프로그램 전체 업데이트 실행 (tee82://update 프로토콜 호출)
    if (btnRunFullUpdate) {
        btnRunFullUpdate.addEventListener('click', () => {
            const curVer = getCurrentAppVersion();
            clearAuthOnUpdate();
            launchUpdateProtocol();

            if (fullUpdateStatusHint) {
                fullUpdateStatusHint.innerHTML = `
                    <span style="color:#2563EB; font-weight:700;">업데이트 다운로더를 호출했습니다! (현재 Ver ${curVer})</span><br>
                    검은색 명령창에서 다운로드 완료 후, <a href="#" id="linkReloadExt" style="color:#059669; font-weight:bold; text-decoration:underline; cursor:pointer;">[여기를 클릭하여 확장 프로그램 새로고침]</a>을 해주세요.<br>
                    <span style="color:#94A3B8;">(※ 창이 안 뜬다면 <strong>'원클릭_등록.bat'</strong>을 최초 1회 실행했는지 확인해 주세요)</span>
                `;
                document.getElementById('linkReloadExt')?.addEventListener('click', (e) => {
                    e.preventDefault();
                    clearAuthOnUpdate();
                    if (typeof chrome !== 'undefined' && chrome.runtime && chrome.runtime.reload) {
                        chrome.runtime.reload();
                    } else {
                        window.location.reload();
                    }
                });
            }
            showToast(`업데이트 다운로더 호출!`);
        });
    }

    // 최초 1회 원클릭 환경 등록 모달 제어
    const setupGuideModal = document.getElementById('setupGuideModal');
    const btnQuickActionSetup = document.getElementById('btnQuickActionSetup');
    const btnCloseSetupGuideModalX = document.getElementById('btnCloseSetupGuideModalX');
    const btnCloseSetupGuideModal = document.getElementById('btnCloseSetupGuideModal');
    const btnTestProtocolLaunch = document.getElementById('btnTestProtocolLaunch');

    function openSetupGuideModal() {
        if (setupGuideModal) setupGuideModal.style.display = 'flex';
    }
    function closeSetupGuideModal() {
        if (setupGuideModal) setupGuideModal.style.display = 'none';
    }

    if (btnQuickActionSetup) btnQuickActionSetup.addEventListener('click', openSetupGuideModal);
    if (btnCloseSetupGuideModalX) btnCloseSetupGuideModalX.addEventListener('click', closeSetupGuideModal);
    if (btnCloseSetupGuideModal) btnCloseSetupGuideModal.addEventListener('click', closeSetupGuideModal);
    if (setupGuideModal) {
        setupGuideModal.addEventListener('click', (e) => {
            if (e.target === setupGuideModal) closeSetupGuideModal();
        });
    }
    const btnDownloadSetupBat = document.getElementById('btnDownloadSetupBat');
    if (btnDownloadSetupBat) {
        btnDownloadSetupBat.addEventListener('click', () => {
            downloadSetupBatFile();
        });
    }

    function downloadSetupBatFile() {
        const batContent = `@echo off\\r\\nchcp 65001 >nul\\r\\ntitle AutomaTee 원클릭 환경 자동 등록\\r\\necho ============================================================\\r\\necho        AutomaTee 원클릭 자동 업데이트 환경 등록기\\r\\necho ============================================================\\r\\necho.\\r\\necho [1/3] 등록 디렉토리 설정 중...\\r\\nset "TARGET_DIR=%LOCALAPPDATA%\\Automatee"\\r\\nif not exist "%TARGET_DIR%" mkdir "%TARGET_DIR%"\\r\\necho.\\r\\necho [2/3] 업데이트 스크립트(updater.ps1 / updater.bat) 생성 중...\\r\\npowershell.exe -NoProfile -ExecutionPolicy Bypass -Command "\$b=''; [System.IO.File]::WriteAllBytes(\$env:LOCALAPPDATA + '\\Automatee\\updater.ps1', [System.Convert]::FromBase64String(\$b))"\\r\\necho @echo off > "%TARGET_DIR%\\updater.bat"\\r\\necho powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%TARGET_DIR%\\updater.ps1" >> "%TARGET_DIR%\\updater.bat"\\r\\necho.\\r\\necho [3/3] tee82:// 프로토콜 윈도우 레지스트리 등록 중...\\r\\nreg add "HKCU\\Software\\Classes\\tee82" /ve /t REG_SZ /d "URL:AutomaTee Protocol" /f >nul\\r\\nreg add "HKCU\\Software\\Classes\\tee82" /v "URL Protocol" /t REG_SZ /d "" /f >nul\\r\\nreg add "HKCU\\Software\\Classes\\tee82\\shell\\open\\command" /ve /t REG_SZ /d "cmd.exe /c start \\"\\" \\"%TARGET_DIR%\\updater.bat\\"" /f >nul\\r\\necho.\\r\\npowershell.exe -NoProfile -ExecutionPolicy Bypass -Command "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; Write-Host '============================================================' -ForegroundColor Green; Write-Host '  [SUCCESS] AutomaTee 원클릭 환경 등록이 성공적으로 완료되었습니다!' -ForegroundColor Green; Write-Host '  이제 브라우저에서 [원클릭 프로그램 업데이트] 버튼을 누르면' -ForegroundColor Yellow; Write-Host '  최신 코드로 자동 교체됩니다.' -ForegroundColor Yellow; Write-Host '============================================================' -ForegroundColor Green"\\r\\necho.\\r\\necho 등록이 완료되었습니다. 창을 닫으려면 아무 키나 누르세요.\\r\\npause >nul`;

        try {
            const blob = new Blob([batContent], { type: 'application/x-bat;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = '원클릭_등록.bat';
            document.body.appendChild(a);
            a.click();
            setTimeout(() => {
                URL.revokeObjectURL(url);
                a.remove();
            }, 1500);

            const setupStatusHint = document.getElementById('setupStatusHint');
            if (setupStatusHint) {
                setupStatusHint.innerHTML = `
                    <span style="color:#059669; font-weight:700;">'원클릭_등록.bat' 파일이 다운로드되었습니다!</span><br>
                    다운로드 창에서 <strong>'원클릭_등록.bat'</strong>을 클릭하여 1회 실행하신 뒤,<br>
                    아래의 <strong>[지금 연동 연결 테스트 실행]</strong>을 눌러 정상 등록을 확인하세요.
                `;
            }
            showToast('📥 [원클릭_등록.bat] 다운로드 완료! 다운로드된 파일을 클릭하여 실행해 주세요.');
        } catch(e) {
            alert('파일 다운로드 중 오류가 발생했습니다: ' + e.message);
        }
    }

    if (btnTestProtocolLaunch) {
        btnTestProtocolLaunch.addEventListener('click', () => {
            launchUpdateProtocol();
            showToast('연결 테스트를 호출했습니다. 알림창이 뜨면 [열기]를 누르세요.');
        });
    }

    // ========================================================
    // 버전 비교 & 관리자 공지 발행 & 클라이언트 권장 업데이트 시스템
    // ========================================================
    function compareVersions(v1, v2) {
        if (!v1 || !v2) return 0;
        const p1 = String(v1).replace(/^v/i, '').split('.').map(n => parseInt(n, 10) || 0);
        const p2 = String(v2).replace(/^v/i, '').split('.').map(n => parseInt(n, 10) || 0);
        const maxLen = Math.max(p1.length, p2.length);
        for (let i = 0; i < maxLen; i++) {
            const num1 = p1[i] || 0;
            const num2 = p2[i] || 0;
            if (num1 > num2) return 1;
            if (num1 < num2) return -1;
        }
        return 0;
    }

    function initAdminReleasePublisher() {
        const cardAdmin = document.getElementById('cardAdminReleasePublish');
        const inputVer = document.getElementById('inputAdminReleaseVer');
        const inputTitle = document.getElementById('inputAdminReleaseTitle');
        const inputNotes = document.getElementById('inputAdminReleaseNotes');
        const btnPublish = document.getElementById('btnAdminPublishRelease');
        const btnRunNow = document.getElementById('btnAdminRunUpdateNow');
        const btnUnlock = document.getElementById('btnUnlockAdminUpdateCard');

        const isAdmin = typeof isCurrentUserAdmin === 'function' ? isCurrentUserAdmin() : false;

        if (cardAdmin) {
            cardAdmin.style.display = isAdmin ? 'block' : 'none';
        }

        if (btnUnlock) {
            btnUnlock.style.display = isAdmin ? 'none' : 'inline-block';
            if (!btnUnlock.dataset.bound) {
                btnUnlock.dataset.bound = 'true';
                btnUnlock.addEventListener('click', () => {
                    const pw = prompt('👑 관리자 인증 비밀번호를 입력해주세요:');
                    if (pw === 'Hyunkyu12!' || pw === 'dlrguswo' || pw === 'admin') {
                        localStorage.setItem('v2_isAdmin', 'true');
                        try {
                            chrome.storage.local.set({ v2_isAdmin: true });
                        } catch(e) {}
                        initAdminReleasePublisher();
                        showToast('👑 관리자 인증 완료! 최신 배포 및 업데이트 공지 작성기가 활성화되었습니다.');
                    } else if (pw) {
                        alert('관리자 비밀번호가 일치하지 않습니다.');
                    }
                });
            }
        }

        if (!cardAdmin) return;

        if (isAdmin) {
            const curVer = getCurrentAppVersion();
            const savedVer = localStorage.getItem('v2_published_release_ver') || curVer;
            const defaultVer = (typeof compareVersions === 'function' && compareVersions(curVer, savedVer) >= 0) ? curVer : savedVer;
            const savedTitle = localStorage.getItem('v2_published_release_title') || `v${defaultVer} 주요 기능 개선`;
            const savedNotes = localStorage.getItem('v2_published_release_notes') || "• 플랫폼 동시 등록 개편 (원하는 사이트 체크 실행)\n• 공지 동기화 복구 (3중 무장애 안심 동기화)\n• 기본 속도 '빠른 손 / 빠른 진행' 최적화\n• 원클릭 프로그램 자동 업데이트 시스템 탑재";

            if (inputVer) {
                if (!inputVer.value || compareVersions(defaultVer, inputVer.value) > 0) {
                    inputVer.value = defaultVer;
                }
            }
            if (inputTitle) {
                if (!inputTitle.value || inputTitle.value.startsWith('v')) {
                    inputTitle.value = `v${inputVer?.value || defaultVer} 주요 기능 개선`;
                }
            }
            if (inputNotes && !inputNotes.value) {
                inputNotes.value = savedNotes;
                // 만약 저장된 버전보다 현재 패키지 버전이 더 높다면 로컬 version.json의 최신 업데이트 노트를 자동 채움
                if (compareVersions(curVer, savedVer) > 0 || !localStorage.getItem('v2_published_release_notes')) {
                    try {
                        const localUrl = (typeof chrome !== 'undefined' && chrome.runtime && chrome.runtime.getURL)
                            ? chrome.runtime.getURL('version.json')
                            : 'version.json';
                        fetch(`${localUrl}?_t=${Date.now()}`, { cache: 'no-store' })
                            .then(r => r.ok ? r.json() : null)
                            .then(vj => {
                                if (vj && (vj.releaseNotes || vj.notes)) {
                                    const nStr = Array.isArray(vj.releaseNotes) ? vj.releaseNotes.join('\n') : (vj.releaseNotes || vj.notes || '');
                                    if (nStr.trim() && inputNotes) {
                                        inputNotes.value = nStr.trim();
                                    }
                                    if (vj.title && inputTitle) {
                                        inputTitle.value = vj.title;
                                    }
                                }
                            }).catch(() => {});
                    } catch(e) {}
                }
            }

            if (inputVer && !inputVer.dataset.bound) {
                inputVer.dataset.bound = 'true';
                inputVer.addEventListener('input', () => {
                    const v = inputVer.value.trim();
                    if (v && inputTitle && (!inputTitle.value || inputTitle.value.startsWith('v'))) {
                        inputTitle.value = `v${v} 주요 기능 개선`;
                    }
                });
            }

            if (btnPublish && !btnPublish.dataset.bound) {
                btnPublish.dataset.bound = 'true';
                btnPublish.addEventListener('click', async () => {
                    const ver = (inputVer?.value || '').trim();
                    const title = (inputTitle?.value || '').trim() || `v${ver} 최신 업데이트`;
                    const notes = (inputNotes?.value || '').trim();
                    if (!ver) {
                        alert('발행할 버전 번호를 입력해 주세요. (예: 2.0.95)');
                        inputVer?.focus();
                        return;
                    }
                    if (!notes) {
                        alert('업데이트 상세 내용을 입력해 주세요.');
                        inputNotes?.focus();
                        return;
                    }

                    btnPublish.disabled = true;
                    btnPublish.innerHTML = '<span>⏳</span> <span>버전 업데이트 및 실시간 배포 중...</span>';

                    try {
                        // 1. 관리자 자신의 버전을 사용자가 입력한 새 버전으로 즉시 업데이트!
                        localStorage.setItem('v2_custom_app_version', ver);
                        localStorage.setItem('v2_published_release_ver', ver);
                        localStorage.setItem('v2_published_release_title', title);
                        localStorage.setItem('v2_published_release_notes', notes);
                        localStorage.setItem('v2_last_seen_version', ver);
                        sessionStorage.setItem('v2_update_dismissed', ver);

                        try {
                            if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
                                chrome.storage.local.set({
                                    v2_custom_app_version: ver,
                                    v2_published_release: {
                                        version: ver,
                                        title: title,
                                        releaseNotes: notes,
                                        publishedAt: Date.now()
                                    }
                                });
                            }
                        } catch(e) {}

                        // 관리자 화면의 푸터, 배지, 버전 표시 전체를 입력한 새 버전으로 즉시 갱신!
                        updateAppVersionUI(ver);

                        // 관리자 화면의 상단 업데이트 배너 및 팝업 억제
                        const topBanner = document.getElementById('topUpdateBanner');
                        if (topBanner) topBanner.style.display = 'none';

                        // 2. 구글 스프레드시트에 최신 배포 버전 등록 전송 (모든 사용자 실시간 감지용)
                        const rawApiUrl = (typeof getAuthApiUrl === 'function' ? getAuthApiUrl() : '') || currentAuthApiUrl || DEFAULT_AUTH_API_URL;
                        const apiUrl = cleanGoogleWebAppUrl(rawApiUrl);
                        let sheetSaved = false;
                        let sheetErrMsg = '';
                        if (apiUrl) {
                            try {
                                const uId = (currentAuthUser && (currentAuthUser.id || currentAuthUser.name)) ? (currentAuthUser.id || currentAuthUser.name) : 'admin';
                                const uPw = (currentAuthUser && currentAuthUser.pw) ? currentAuthUser.pw : '1234';
                                const targetUrl = `${apiUrl}?action=publish_release&version=${encodeURIComponent(ver)}&title=${encodeURIComponent(title)}&notes=${encodeURIComponent(notes)}&id=${encodeURIComponent(uId)}&pw=${encodeURIComponent(uPw)}&_t=${Date.now()}`;
                                const pRes = await fetch(targetUrl, {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                                    body: JSON.stringify({ action: 'publish_release', version: ver, title: title, notes: notes })
                                });
                                const pText = await pRes.text();
                                let pJson = null;
                                try { pJson = JSON.parse(pText); } catch(e) {}
                                if (pJson && pJson.success) {
                                    sheetSaved = true;
                                } else if (pText && (pText.includes('accounts.google.com') || pText.includes('Google Drive') || pText.includes('Sign in'))) {
                                    sheetErrMsg = '웹앱 배포 설정이 [모든 사용자(Anyone)]가 아닙니다.';
                                } else if (pJson && !pJson.success) {
                                    sheetErrMsg = pJson.message || '';
                                }
                            } catch(e) {
                                sheetErrMsg = e.message || '';
                            }
                        }

                        // 3. 깃허브 배포 및 설치기 자동 빌더 (깃허브_올리기.exe) 실행!
                        try {
                            launchGithubUploadProtocol(ver, title, notes);
                        } catch(uploadErr) {
                            console.warn('[Admin Publish] 깃허브_올리기 호출 예외:', uploadErr);
                        }

                        // 설정 모달 닫기
                        const updateModal = document.getElementById('updateModal');
                        if (updateModal) updateModal.style.display = 'none';

                        if (sheetSaved) {
                            showToast(`[Ver ${ver}] 버전 발행 완료!\n• 구글 시트에 실시간 전파되었습니다.\n• [깃허브_올리기.exe]가 자동 실행되어 코드 암호화/GitHub 푸시/설치기 빌드가 진행됩니다.`);
                        } else if (apiUrl) {
                            showToast(`[Ver ${ver}] 버전 적용 완료!\n• [깃허브_올리기.exe]가 자동 실행됩니다.\n⚠️ 구글 시트 등록 알림: ${sheetErrMsg || '확인 필요'}`);
                        } else {
                            showToast(`[Ver ${ver}] 버전 적용 및 [깃허브_올리기.exe]가 자동 실행됩니다!`);
                        }
                    } catch(err) {
                        showToast(`버전 업데이트 완료 (Ver ${ver})`);
                    } finally {
                        btnPublish.disabled = false;
                        btnPublish.innerHTML = '<span>🚀</span> <span>최신 버전 배포 및 내 버전 즉시 적용 (전체 사용자 실시간 전파)</span>';
                    }
                });
            }

            const btnUploaderDirect = document.getElementById('btnAdminRunGithubUploaderDirect');
            if (btnUploaderDirect && !btnUploaderDirect.dataset.bound) {
                btnUploaderDirect.dataset.bound = 'true';
                btnUploaderDirect.addEventListener('click', () => {
                    const ver = (inputVer?.value || '').trim() || getCurrentAppVersion();
                    const title = (inputTitle?.value || '').trim() || `v${ver} 주요 기능 개선`;
                    const notes = (inputNotes?.value || '').trim();
                    if (notes) {
                        try {
                            localStorage.setItem('v2_custom_app_version', ver);
                            localStorage.setItem('v2_published_release_ver', ver);
                            localStorage.setItem('v2_published_release_title', title);
                            localStorage.setItem('v2_published_release_notes', notes);
                            localStorage.setItem('v2_last_seen_version', ver);
                            sessionStorage.setItem('v2_update_dismissed', ver);
                            if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
                                chrome.storage.local.set({
                                    v2_custom_app_version: ver,
                                    v2_published_release: {
                                        version: ver,
                                        title: title,
                                        releaseNotes: notes,
                                        publishedAt: Date.now()
                                    }
                                });
                            }
                            updateAppVersionUI(ver);
                        } catch(e) {}
                    }
                    // 구글 스프레드시트에도 비동기로 최신 배포 노트 등록 전송
                    try {
                        const rawApiUrl = (typeof getAuthApiUrl === 'function' ? getAuthApiUrl() : '') || currentAuthApiUrl || DEFAULT_AUTH_API_URL;
                        const apiUrl = cleanGoogleWebAppUrl(rawApiUrl);
                        if (apiUrl && notes) {
                            const uId = (currentAuthUser && (currentAuthUser.id || currentAuthUser.name)) ? (currentAuthUser.id || currentAuthUser.name) : 'admin';
                            const uPw = (currentAuthUser && currentAuthUser.pw) ? currentAuthUser.pw : '1234';
                            const targetUrl = `${apiUrl}?action=publish_release&version=${encodeURIComponent(ver)}&title=${encodeURIComponent(title)}&notes=${encodeURIComponent(notes)}&id=${encodeURIComponent(uId)}&pw=${encodeURIComponent(uPw)}&_t=${Date.now()}`;
                            fetch(targetUrl, {
                                method: 'POST',
                                headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                                body: JSON.stringify({ action: 'publish_release', version: ver, title: title, notes: notes })
                            }).catch(() => {});
                        }
                    } catch(e) {}
                    launchGithubUploadProtocol(ver, title, notes);
                    showToast(`[깃허브_올리기.exe]를 호출했습니다! (Ver ${ver})`);
                });
            }
        }
    }

    function openNewVersionModal(remoteData, currentVer, isPostUpdate = false, isPublisherPreview = false) {
        const modal = document.getElementById('newVersionAlertModal');
        if (!modal) return;

        const lblCurrent = document.getElementById('lblCurrentVerText');
        const lblRemote = document.getElementById('lblRemoteVerText');
        const headerTitle = document.getElementById('newVersionModalHeaderTitle');
        const notesHeader = document.getElementById('lblReleaseNotesHeader');
        const notesBox = document.getElementById('newVersionReleaseNotes');
        const btnExecute = document.getElementById('btnExecuteOneClickUpdate');
        const btnText = document.getElementById('btnExecuteOneClickUpdateText');
        const hintEl = document.getElementById('newVersionUpdateHint');
        const btnDismiss = document.getElementById('btnDismissNewVersionModal');
        const btnCloseX = document.getElementById('btnCloseNewVersionModalX');

        const closeModal = () => {
            modal.style.display = 'none';
        };
        if (btnCloseX) btnCloseX.onclick = closeModal;
        if (btnDismiss) btnDismiss.onclick = closeModal;

        if (notesHeader) {
            notesHeader.textContent = isPostUpdate ? '이번 버전 업데이트 내용:' : (isPublisherPreview ? '📢 발행된 업데이트 상세 내용 (모든 사용자에게 노출):' : '주요 업데이트 내용:');
        }

        if (lblCurrent) {
            lblCurrent.innerHTML = isPostUpdate ? `이전: <b>v${currentVer}</b>` : (isPublisherPreview ? `내 PC: <b>v${currentVer}</b>` : `현재: <b>v${currentVer}</b>`);
        }
        if (lblRemote) {
            lblRemote.textContent = isPostUpdate ? `v${remoteData.version} (최신)` : `v${remoteData.version}`;
        }
        if (headerTitle) {
            if (isPostUpdate) {
                headerTitle.textContent = `AutomaTee v${remoteData.version} 업데이트 완료!`;
            } else if (isPublisherPreview) {
                headerTitle.textContent = `📢 v${remoteData.version} 공지 발행 완료 (${remoteData.title || '새 버전'})`;
            } else {
                headerTitle.textContent = remoteData.title || `AutomaTee v${remoteData.version} 새 버전 출시`;
            }
        }

        if (notesBox) {
            let text = '';
            if (Array.isArray(remoteData.releaseNotes)) {
                text = remoteData.releaseNotes.join('\n');
            } else if (typeof remoteData.releaseNotes === 'string') {
                text = remoteData.releaseNotes;
            } else if (typeof remoteData.notes === 'string') {
                text = remoteData.notes;
            }
            notesBox.textContent = text || '• 최신 기능 개선 및 안정성 향상 패치가 적용되었습니다.';
        }

        if (isPostUpdate) {
            // 1. 업데이트 완료 후 첫 시작 안내 모드
            if (btnExecute && btnText) {
                btnText.textContent = '✨ 확인 (최신 버전 사용하기)';
                btnExecute.style.background = 'linear-gradient(135deg, #059669, #047857)';
                btnExecute.onclick = () => {
                    closeModal();
                    showToast('최신 버전이 성공적으로 적용되었습니다!');
                };
            }
            if (hintEl) {
                hintEl.innerHTML = '※ 최신 기능 및 버그 수정 패치가 성공적으로 반영되었습니다.';
            }
            if (btnDismiss) btnDismiss.textContent = '닫기';
        } else if (isPublisherPreview) {
            // 2. 관리자 공지 발행 직후 미리보기 및 내 PC 업데이트 실행 모드
            if (btnExecute && btnText) {
                btnText.textContent = '지금 내 PC에서도 최신 버전 업데이트 실행';
                btnExecute.style.background = 'linear-gradient(135deg, #4F46E5, #4338CA)';
                btnExecute.onclick = () => {
                    clearAuthOnUpdate();
                    launchUpdateProtocol();
                    showToast(`원클릭 업데이트를 실행했습니다! (Ver ${remoteData.version})`);
                    closeModal();
                };
            }
            if (hintEl) {
                hintEl.innerHTML = '※ 이 공지와 업데이트가 모든 사용자에게 실시간 전파되었습니다.<br>내 PC도 최신 버전으로 교체하시려면 위 버튼을 눌러주세요.';
            }
            if (btnDismiss) btnDismiss.textContent = '나중에 업데이트 (닫기)';
        } else {
            // 3. 일반 새 버전 권장 업데이트 모드
            if (btnExecute && btnText) {
                btnText.textContent = '원클릭 프로그램 업데이트 실행';
                btnExecute.style.background = 'linear-gradient(135deg, #4F46E5, #4338CA)';
                btnExecute.onclick = () => {
                    clearAuthOnUpdate();
                    try {
                        const rVer = String(remoteData.version || '').trim();
                        if (rVer) {
                            sessionStorage.setItem('v2_update_dismissed', rVer);
                        }
                        if (remoteData.title) localStorage.setItem('v2_published_release_title', remoteData.title);
                        const rNotes = Array.isArray(remoteData.releaseNotes) ? remoteData.releaseNotes.join('\n') : (remoteData.releaseNotes || remoteData.notes || '');
                        if (rNotes) localStorage.setItem('v2_published_release_notes', rNotes);
                    } catch(e) {}
                    launchUpdateProtocol();

                    btnText.textContent = '⏳ 업데이트 다운로드 및 적용 중... (3초 소요)';
                    btnExecute.style.opacity = '0.85';

                    setTimeout(() => {
                        btnText.textContent = '🔄 [최신 버전으로 자동 새로고침 중...]';
                        btnExecute.style.background = 'linear-gradient(135deg, #059669, #047857)';
                        btnExecute.style.opacity = '1';
                        showToast('최신 버전 업데이트 다운로드 완료! 자동 새로고침합니다.');
                        setTimeout(() => {
                            if (typeof chrome !== 'undefined' && chrome.runtime?.reload) {
                                chrome.runtime.reload();
                            } else {
                                window.location.reload();
                            }
                        }, 1200);
                    }, 3500);
                };
            }
            if (hintEl) {
                hintEl.innerHTML = '※ 클릭 시 최신 코드가 3초 만에 자동 교체되고 브라우저가 자동 새로고침됩니다.<br><a href="https://github.com/purry85/tee82/archive/refs/heads/main.zip" target="_blank" style="color: #4F46E5; text-decoration: underline;">창이 안 뜰 경우 수동 ZIP 다운로드</a>';
            }
            if (btnDismiss) btnDismiss.textContent = '나중에 하기 (닫기)';
        }

        modal.style.display = 'flex';
    }

    async function checkForRemoteAppUpdate(isManual = false, forceShow = false) {
        try {
            const currentVer = getCurrentAppVersion();
            let remoteData = null;

            // 0. 로그인 응답 등에서 미리 수신된 원격 릴리즈 정보가 있는 경우 우선 적용
            if (window.__latestRemoteRelease && window.__latestRemoteRelease.version) {
                remoteData = window.__latestRemoteRelease;
            }

            // 1. Google Sheets Apps Script API 시도
            const rawApiUrl = (typeof getAuthApiUrl === 'function' ? getAuthApiUrl() : '') || currentAuthApiUrl || DEFAULT_AUTH_API_URL;
            const apiUrl = cleanGoogleWebAppUrl(rawApiUrl);
            if (!remoteData && apiUrl) {
                try {
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), 3500);
                    const res = await fetch(`${apiUrl}?action=get_release&_t=${Date.now()}`, { signal: controller.signal, cache: 'no-store' });
                    clearTimeout(timeoutId);
                    if (res.ok) {
                        const text = await res.text();
                        let json = null;
                        try { json = JSON.parse(text); } catch(e) {}
                        if (json && json.success && json.version) {
                            remoteData = json;
                        }
                    }
                } catch(e) {}
            }

            // 2. GitHub 원격 version.json 폴백 (상시 보장, 캐시 100% 무효화)
            if (!remoteData || !remoteData.version) {
                try {
                    const ghRes = await fetch(`https://raw.githubusercontent.com/purry85/tee82/main/version.json?_t=${Date.now()}`, { cache: 'no-store' });
                    if (ghRes.ok) {
                        const ghJson = await ghRes.json();
                        if (ghJson && ghJson.version) {
                            remoteData = ghJson;
                        }
                    }
                } catch(e) {}
            }

            if (!remoteData || !remoteData.version) {
                if (isManual) showToast(`현재 최신 버전(Ver ${currentVer})입니다.`);
                return;
            }

            const remoteVer = remoteData.version.trim();
            const isNewer = compareVersions(remoteVer, currentVer) > 0;

            const topBanner = document.getElementById('topUpdateBanner');
            const topVer = document.getElementById('topBannerRemoteVer');
            const topTitle = document.getElementById('topBannerTitleSummary');
            if (topVer) topVer.textContent = `v${remoteVer}`;
            if (topTitle) topTitle.textContent = remoteData.title ? `(${remoteData.title})` : '';

            if (isNewer) {
                if (topBanner) topBanner.style.display = 'flex';

                const dismissedVer = sessionStorage.getItem('v2_update_dismissed');
                if (!isManual && !forceShow && dismissedVer === remoteVer) {
                    return;
                }

                openNewVersionModal(remoteData, currentVer);
            } else {
                if (topBanner) topBanner.style.display = 'none';
                if (isManual) {
                    showToast(`현재 최신 버전(Ver ${currentVer})을 사용 중입니다.`);
                }
            }
        } catch (err) {
            console.log('[AutomaTee Update] 버전 확인 생략:', err);
        }
    }
    window.checkForRemoteAppUpdate = checkForRemoteAppUpdate;

    // 모달 닫기 및 상단 배너 클릭 리스너 바인딩
    document.getElementById('btnCloseNewVersionModalX')?.addEventListener('click', () => {
        const remoteVer = document.getElementById('lblRemoteVerText')?.textContent?.replace(/^v/i, '') || '';
        if (remoteVer) sessionStorage.setItem('v2_update_dismissed', remoteVer);
        const modal = document.getElementById('newVersionAlertModal');
        if (modal) modal.style.display = 'none';
    });

    document.getElementById('btnDismissNewVersionModal')?.addEventListener('click', () => {
        const remoteVer = document.getElementById('lblRemoteVerText')?.textContent?.replace(/^v/i, '') || '';
        if (remoteVer) sessionStorage.setItem('v2_update_dismissed', remoteVer);
        const modal = document.getElementById('newVersionAlertModal');
        if (modal) modal.style.display = 'none';
    });

    document.getElementById('btnTopBannerUpdate')?.addEventListener('click', () => {
        checkForRemoteAppUpdate(true);
    });

    async function getCurrentVersionReleasePayload(curVer) {
        // 0. 관리자가 현재 버전(curVer)에 대해 직접 입력·발행한 업데이트 내용이 있다면 최우선 표시!
        try {
            const savedVer = localStorage.getItem('v2_published_release_ver') || '';
            const savedNotes = localStorage.getItem('v2_published_release_notes') || '';
            const savedTitle = localStorage.getItem('v2_published_release_title') || '';
            if (savedVer && compareVersions(savedVer, curVer) === 0 && savedNotes.trim()) {
                return {
                    version: curVer,
                    title: savedTitle || `v${curVer} 주요 기능 업데이트`,
                    releaseNotes: savedNotes
                };
            }
        } catch(e) {}

        // 1. Google Sheets 서버에 발행된 최신 릴리즈 정보 확인
        try {
            const rawApiUrl = (typeof getAuthApiUrl === 'function' ? getAuthApiUrl() : '') || currentAuthApiUrl || DEFAULT_AUTH_API_URL;
            const apiUrl = cleanGoogleWebAppUrl(rawApiUrl);
            if (apiUrl) {
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 2500);
                const res = await fetch(`${apiUrl}?action=get_release&_t=${Date.now()}`, { signal: controller.signal });
                clearTimeout(timeoutId);
                if (res.ok) {
                    const json = await res.json();
                    if (json && json.success && json.version && compareVersions(json.version, curVer) >= 0) {
                        const rNotes = Array.isArray(json.releaseNotes) ? json.releaseNotes.join('\n') : (json.releaseNotes || json.notes || '');
                        if (rNotes.trim()) {
                            return {
                                version: curVer,
                                title: json.title || `v${curVer} 주요 기능 업데이트`,
                                releaseNotes: json.releaseNotes || json.notes
                            };
                        }
                    }
                }
            }
        } catch(e) {}

        // 2. 원격 GitHub version.json 조회 (최신 배포 노트)
        try {
            const ghRes = await fetch(`https://raw.githubusercontent.com/purry85/tee82/main/version.json?_t=${Date.now()}`, { cache: 'no-store' });
            if (ghRes.ok) {
                const ghJson = await ghRes.json();
                if (ghJson && (ghJson.releaseNotes || ghJson.notes) && (!ghJson.version || compareVersions(ghJson.version, curVer) >= 0)) {
                    return {
                        version: curVer,
                        title: ghJson.title || `v${curVer} 주요 기능 업데이트`,
                        releaseNotes: ghJson.releaseNotes || ghJson.notes
                    };
                }
            }
        } catch(e) {}

        // 3. 로컬 version.json (확장프로그램 패키지 내장 파일) 조회
        try {
            const localUrl = (typeof chrome !== 'undefined' && chrome.runtime && chrome.runtime.getURL)
                ? chrome.runtime.getURL('version.json')
                : 'version.json';
            const res = await fetch(`${localUrl}?_t=${Date.now()}`, { cache: 'no-store' });
            if (res.ok) {
                const vj = await res.json();
                if (vj && (vj.releaseNotes || vj.notes)) {
                    const notesStr = Array.isArray(vj.releaseNotes) ? vj.releaseNotes.join('\n') : (vj.releaseNotes || vj.notes || '');
                    if (notesStr.trim()) {
                        return {
                            version: curVer,
                            title: vj.title || `v${curVer} 주요 기능 업데이트`,
                            releaseNotes: vj.releaseNotes || vj.notes
                        };
                    }
                }
            }
        } catch(e) {}

        // 4. localStorage 폴백
        const savedNotes = localStorage.getItem('v2_published_release_notes') || '';
        const savedTitle = localStorage.getItem('v2_published_release_title') || `v${curVer} 주요 기능 업데이트`;
        return {
            version: curVer,
            title: savedTitle,
            releaseNotes: savedNotes || [
                `• AutomaTee v${curVer} 최신 기능 개선 및 안정화 패치가 적용되었습니다.`,
                '• 구장별 타임 회원 고유 시드 분산 및 스마트수정 동일 타임 유지 최적화',
                '• 구장 선택 모달 및 2열 그리드 타 구장 오매칭 원천 차단'
            ]
        };
    }

    async function checkAndShowPostUpdateModal() {
        const curVer = getCurrentAppVersion();
        const lastSeenVer = localStorage.getItem('v2_last_seen_version');

        if (lastSeenVer && compareVersions(curVer, lastSeenVer) > 0) {
            localStorage.setItem('v2_last_seen_version', curVer);
            const releasePayload = await getCurrentVersionReleasePayload(curVer);
            openNewVersionModal(releasePayload, lastSeenVer, true);
            return;
        }

        localStorage.setItem('v2_last_seen_version', curVer);
    }

    const linkViewReleaseNotes = document.getElementById('linkViewReleaseNotes');
    if (linkViewReleaseNotes) {
        linkViewReleaseNotes.addEventListener('click', async (e) => {
            e.preventDefault();
            const curVer = getCurrentAppVersion();
            const releasePayload = await getCurrentVersionReleasePayload(curVer);
            openNewVersionModal(releasePayload, curVer, true);
        });
    }

    // 시작 시 원격 업데이트 및 관리자 발행기 초기화
    setTimeout(() => {
        initAdminReleasePublisher();
        checkAndShowPostUpdateModal();
        checkForRemoteAppUpdate(false);
    }, 800);

    // ★ 모든 사용자 실시간 새 버전 감지: 3~5분(±30초 지터) 주기 자동 검사 & 실시간 스토리지 변경 감지
    function scheduleNextVersionCheck() {
        const baseSeconds = 240; // 4분
        const jitterSeconds = (Math.random() * 60) - 30; // ±30초 무작위 분산
        setTimeout(() => {
            try {
                checkForRemoteAppUpdate(false);
            } catch(e) {}
            scheduleNextVersionCheck();
        }, Math.round((baseSeconds + jitterSeconds) * 1000));
    }
    scheduleNextVersionCheck();

    try {
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.onChanged) {
            chrome.storage.onChanged.addListener((changes, areaName) => {
                if (areaName === 'local' && (changes.v2_published_release || changes.v2_custom_app_version)) {
                    checkForRemoteAppUpdate(false);
                }
            });
        }
    } catch(e) {}

    // 2. GitHub 최신 매핑사전 실시간 동기화 (네트워크 비동기 fetch)
    if (btnSyncDictFromGitHub) {
        btnSyncDictFromGitHub.addEventListener('click', async () => {
            if (syncDictStatusHint) {
                syncDictStatusHint.innerHTML = '<span style="color:#2563EB; font-weight:600;">⏳ GitHub에서 최신 사전을 불러오는 중입니다...</span>';
            }
            btnSyncDictFromGitHub.disabled = true;

            try {
                let remoteDict = null;
                try {
                    const resJson = await fetch(`https://raw.githubusercontent.com/purry85/tee82/main/dictionary.json?t=${Date.now()}`);
                    if (resJson.ok) {
                        const parsed = await resJson.json();
                        if (parsed && typeof parsed === 'object') remoteDict = parsed;
                    }
                } catch(e) {}

                if (!remoteDict) {
                    const res = await fetch(`https://raw.githubusercontent.com/purry85/tee82/main/popup.js?t=${Date.now()}`);
                    if (!res.ok) throw new Error(`HTTP 상태코드: ${res.status}`);
                    const text = await res.text();

                    const m = text.match(/const\s+DEFAULT_SYNC_CODE\s*=\s*"([^"]+)"/);
                    if (!m || !m[1]) throw new Error('사전 코드를 찾을 수 없습니다.');

                    remoteDict = decodeSyncString(m[1]);
                }
                if (!remoteDict || typeof remoteDict !== 'object') throw new Error('사전 데이터 디코딩에 실패했습니다.');

                let addedCount = 0;
                let updatedCount = 0;
                for (const [k, v] of Object.entries(remoteDict)) {
                    const norm = normalizeDictEntry(v, k);
                    if (!dictionary[k]) {
                        dictionary[k] = norm;
                        addedCount++;
                    } else {
                        dictionary[k] = norm;
                        updatedCount++;
                    }
                }

                saveDictionary();
                updateDictStats();
                updateLivePrepaidFees();

                const curVer = getCurrentAppVersion();

                if (syncDictStatusHint) {
                    syncDictStatusHint.innerHTML = `
                        <span style="color:#059669; font-weight:700;">동기화 완료!</span><br>
                        GitHub 최신 사전이 성공적으로 적용되었습니다. (총 ${Object.keys(dictionary).length}개 구장, 신규 ${addedCount}개 / 갱신 ${updatedCount}개)
                    `;
                }
                showToast(`최신 매핑사전 동기화 완료! (총 ${Object.keys(dictionary).length}개)`);
            } catch(err) {
                if (syncDictStatusHint) {
                    syncDictStatusHint.innerHTML = `<span style="color:#EF4444; font-weight:700;">❌ 동기화 실패: ${err.message} (인터넷 또는 GitHub 연결을 확인하세요)</span>`;
                }
                showToast('동기화 실패: ' + err.message);
            } finally {
                btnSyncDictFromGitHub.disabled = false;
            }
        });
    }

    // 사전 관리 모달 & 기기 간 동기화 로직
    const btnOpenDict = document.getElementById('btnOpenDict');
    const dictModal = document.getElementById('dictManagerModal');
    const btnCloseDictModal = document.getElementById('btnCloseDictModal');
    const btnCancelDictModal = document.getElementById('btnCancelDictModal');
    const managerSearch = document.getElementById('managerSearch');
    const btnAddNewDict = document.getElementById('btnAddNewDict');
    const btnExportSync = document.getElementById('btnExportSync');
    const btnImportSync = document.getElementById('btnImportSync');
    const syncCodeInput = document.getElementById('syncCode');
    const importCodeInput = document.getElementById('importCode');

    let dictSnapshot = null; // 모달 열기 전 스냅샷 (취소 시 원복용)
    let managerSortCol = 0; // 0: 원본, 1: 지역, 2: 골프몬/단일변환, 3: 골팡, 4: 골마켓
    let managerSortAsc = true;
    let currentDictFilter = 'all'; // 'all' | 'diff' | 'dup' | 'empty'
    let currentDictSite = 'golfmon'; // 'golfmon' | 'golfpang' | 'golmarket' | 'all'

    const siteTabConfig = {
        golfmon: {
            title: '골프몬 변환명',
            desc: '<strong>골프몬(golfmon.net)</strong> 등록 시 자동 매칭될 구장명 사전입니다.',
            color: '#5C479C'
        },
        golfpang: {
            title: '골팡 변환명',
            desc: '<strong>골팡(golfpang.com)</strong> 등록 시 자동 매칭될 구장명 사전입니다.',
            color: '#2563EB'
        },
        golmarket: {
            title: '골마켓 변환명',
            desc: '🛒 <strong>골마켓(golmarket.co.kr)</strong> 조인/부킹 등록 시 자동 매칭될 구장명 사전입니다. (예: 골프존카운티 진천, 동촌GC)',
            color: '#059669'
        },
        golfrock: {
            title: '골프락 변환명',
            desc: '🪨 <strong>골프락(golfrock.co.kr)</strong> 등록 시 자동 매칭될 구장명 사전입니다.',
            color: '#B45309'
        },
        golfland: {
            title: '골프랜드 변환명',
            desc: '<strong>골프랜드</strong> 등록 시 자동 매칭될 구장명 사전입니다.',
            color: '#10B981'
        },
        golftop: {
            title: '골프탑 변환명',
            desc: '<strong>골프탑(intra.golftop.kr)</strong> 홍보 등록 시 자동 매칭될 구장명 사전입니다.',
            color: '#F59E0B'
        },
        all: {
            title: '전체 비교',
            desc: '<strong>전체 비교</strong>: 구장별로 각 사이트 변환명을 한눈에 비교하고 동시에 수정할 수 있습니다.',
            color: '#D97706'
        }
    };

    function switchDictSite(site) {
        flushAndSaveDictTable(false);
        currentDictSite = site;

        document.querySelectorAll('#dictSiteTabs .dict-site-tab').forEach(tab => {
            tab.classList.toggle('active', tab.dataset.site === site);
        });

        const descEl = document.getElementById('dictSiteDesc');
        if (descEl && siteTabConfig[site]) {
            descEl.innerHTML = siteTabConfig[site].desc;
            descEl.style.borderLeftColor = siteTabConfig[site].color;
        }

        if (currentDictSite !== 'all' && managerSortCol > 2) {
            managerSortCol = 2;
        }

        renderDictModal();
    }

    function updateDictStats() {
        const entries = Object.keys(dictionary).map(key => {
            return {
                key: key,
                ...normalizeDictEntry(dictionary[key], key)
            };
        });

        const mappedCounts = {};
        const baseCounts = {};

        entries.forEach(item => {
            const curVal = currentDictSite === 'all' ? item.golfmon : (item[currentDictSite] || item.name || '');
            const m = (curVal || '').trim().toLowerCase();
            if (m) mappedCounts[m] = (mappedCounts[m] || 0) + 1;
            const base = item.key.split(/[\(_\[\/]/)[0].trim().toLowerCase();
            if (base) baseCounts[base] = (baseCounts[base] || 0) + 1;
        });

        let dupCount = 0;
        let emptyCount = 0;
        let diffCount = 0;
        const isGolflandOpen = true;

        entries.forEach(item => {
            const isDiff = (item.golfmon !== item.golfpang) ||
                           (item.golfmon !== item.golmarket) ||
                           (item.golfmon !== item.golfrock) ||
                           (isGolflandOpen && (item.golfmon !== item.golfland)) ||
                           (item.golfpang !== item.golmarket) ||
                           (item.golfpang !== item.golfrock) ||
                           (isGolflandOpen && (item.golfpang !== item.golfland)) ||
                           (item.golmarket !== item.golfrock) ||
                           (isGolflandOpen && (item.golmarket !== item.golfland)) ||
                           (isGolflandOpen && (item.golfrock !== item.golfland));
            if (isDiff) diffCount++;

            const curVal = currentDictSite === 'all' ? item.golfmon : (item[currentDictSite] || item.name || '');
            const m = (curVal || '').trim().toLowerCase();
            const base = item.key.split(/[\(_\[\/]/)[0].trim().toLowerCase();
            const isMappedDup = m && mappedCounts[m] > 1;
            const isBaseDup = base && baseCounts[base] > 1;
            if (isMappedDup || isBaseDup) dupCount++;

            const isMissingRegion = !item.region || item.region.trim() === '';
            let isMissingName = false;
            if (currentDictSite === 'all') {
                isMissingName = !item.golfmon || !item.golfpang || !item.golmarket || !item.golfrock || (isGolflandOpen && !item.golfland);
            } else {
                const sName = item[currentDictSite] || '';
                isMissingName = !sName || sName.trim() === '';
            }
            if (isMissingRegion || isMissingName) emptyCount++;
        });

        const chipAllCount = document.getElementById('chipAllCount');
        const chipDiffCount = document.getElementById('chipDiffCount');
        const chipDupCount = document.getElementById('chipDupCount');
        const chipEmptyCount = document.getElementById('chipEmptyCount');

        if (chipAllCount) chipAllCount.innerText = entries.length;
        if (chipDiffCount) chipDiffCount.innerText = diffCount;
        if (chipDupCount) chipDupCount.innerText = dupCount;
        if (chipEmptyCount) chipEmptyCount.innerText = emptyCount;
    }

    function flushAndSaveDictTable(saveToStorage = false, excludeKey = null) {
        try {
            const tbody = document.getElementById('dictTableBody');
            if (!tbody) return;
            const rows = tbody.querySelectorAll('tr');
            rows.forEach(tr => {
                const keyInp = tr.querySelector('.dict-edit-key');
                const regInp = tr.querySelector('.dict-edit-reg');
                if (!keyInp) return;
                const oldKey = keyInp.dataset.oldkey;
                const curKey = keyInp.value.trim();
                if (!curKey) return;
                if (excludeKey && (curKey === excludeKey || oldKey === excludeKey)) return;

                const rawReg = regInp ? regInp.value.trim() : '';

                if (curKey !== oldKey && oldKey && dictionary[oldKey]) {
                    const oldEntry = dictionary[oldKey];
                    delete dictionary[oldKey];
                    dictionary[curKey] = oldEntry;
                    keyInp.dataset.oldkey = curKey;
                }

                const existing = normalizeDictEntry(dictionary[curKey], curKey);
                if (currentDictSite === 'golfrock') {
                    existing.golfrockRegion = toGolfrockRegion(rawReg) || rawReg;
                } else {
                    existing.region = toStandardRegion(rawReg) || rawReg;
                }

                if (currentDictSite === 'all') {
                    const gmInp = tr.querySelector('.dict-edit-gm');
                    const gpInp = tr.querySelector('.dict-edit-gp');
                    const gmkInp = tr.querySelector('.dict-edit-gmk');
                    const grkInp = tr.querySelector('.dict-edit-grk');
                    const gldInp = tr.querySelector('.dict-edit-gld');
                    if (gmInp) {
                        existing.golfmon = gmInp.value.trim();
                        existing.name = existing.golfmon;
                    }
                    if (gpInp) existing.golfpang = gpInp.value.trim();
                    if (gmkInp) existing.golmarket = gmkInp.value.trim();
                    if (grkInp) existing.golfrock = grkInp.value.trim();
                    if (gldInp) existing.golfland = gldInp.value.trim();
                } else {
                    const siteInp = tr.querySelector('.dict-edit-sitename');
                    if (siteInp) {
                        const val = siteInp.value.trim();
                        existing[currentDictSite] = val;
                        if (currentDictSite === 'golfmon') {
                            existing.name = val;
                        }
                    }
                }
                dictionary[curKey] = existing;
            });
            if (saveToStorage) {
                saveDictionary();
            }
        } catch(e) {
            console.error('Error in flushAndSaveDictTable:', e);
        }
    }

    function sortDictManager(colIndex) {
        flushAndSaveDictTable(false);
        if (managerSortCol === colIndex) {
            managerSortAsc = !managerSortAsc;
        } else {
            managerSortCol = colIndex;
            managerSortAsc = true;
        }
        renderDictModal();
    }

    function renderDictModal() {
        const thead = document.getElementById('dictTableHead');
        const tbody = document.getElementById('dictTableBody');
        const table = document.querySelector('.dict-table');
        if (!tbody || !thead) return;

        tbody.innerHTML = '';
        table?.classList.toggle('table-view-all', currentDictSite === 'all');

        const arrow = (col) => (managerSortCol === col ? (managerSortAsc ? ' ▲' : ' ▼') : '');
        const isGolflandOpen = true;

        // 헤더 렌더링
        if (currentDictSite === 'all') {
            if (isGolflandOpen) {
                thead.innerHTML = `
                    <tr>
                        <th style="width: 15%;" data-col="0">원본 구장명${arrow(0)}</th>
                        <th style="width: 9%;" data-col="1">지역${arrow(1)}</th>
                        <th style="width: 14%;" data-col="2">골프몬${arrow(2)}</th>
                        <th style="width: 14%;" data-col="3">골팡${arrow(3)}</th>
                        <th style="width: 14%;" data-col="4">골마켓${arrow(4)}</th>
                        <th style="width: 14%;" data-col="5">골프락${arrow(5)}</th>
                        <th style="width: 14%;" data-col="6">골프랜드${arrow(6)}</th>
                        <th style="width: 6%; text-align: center;">✕</th>
                    </tr>
                `;
            } else {
                thead.innerHTML = `
                    <tr>
                        <th style="width: 18%;" data-col="0">원본 구장명${arrow(0)}</th>
                        <th style="width: 12%;" data-col="1">지역${arrow(1)}</th>
                        <th style="width: 17%;" data-col="2">골프몬${arrow(2)}</th>
                        <th style="width: 17%;" data-col="3">골팡${arrow(3)}</th>
                        <th style="width: 17%;" data-col="4">골마켓${arrow(4)}</th>
                        <th style="width: 17%;" data-col="5">골프락${arrow(5)}</th>
                        <th style="width: 2%; text-align: center;">✕</th>
                    </tr>
                `;
            }
        } else {
            const siteLabel = siteTabConfig[currentDictSite]?.title || '변환될 이름';
            thead.innerHTML = `
                <tr>
                    <th style="width: 32%;" data-col="0">원본 구장명${arrow(0)}</th>
                    <th style="width: 20%;" data-col="1">지역${arrow(1)}</th>
                    <th style="width: 34%;" data-col="2">${siteLabel}${arrow(2)}</th>
                    <th style="width: 14%; text-align: center;">관리</th>
                </tr>
            `;
        }

        // 헤더 정렬 클릭 이벤트 연결
        thead.querySelectorAll('th[data-col]').forEach(th => {
            th.addEventListener('click', () => {
                const col = parseInt(th.dataset.col, 10);
                sortDictManager(col);
            });
        });

        // 사전 목록 배열화
        let entries = Object.keys(dictionary).map(key => {
            const norm = normalizeDictEntry(dictionary[key], key);
            const displayRegion = (currentDictSite === 'golfrock')
                ? (norm.golfrockRegion || GOLFROCK_REGIONS[key] || GOLFROCK_REGIONS[norm.golfrock] || (norm.region ? toGolfrockRegion(norm.region) : ''))
                : norm.region;
            return {
                key: key,
                region: displayRegion,
                golfrockRegion: norm.golfrockRegion || GOLFROCK_REGIONS[key] || GOLFROCK_REGIONS[norm.golfrock] || (norm.region ? toGolfrockRegion(norm.region) : ''),
                golfmon: norm.golfmon,
                golfpang: norm.golfpang,
                golmarket: norm.golmarket,
                golfrock: norm.golfrock,
                golfland: norm.golfland,
                name: norm.name
            };
        });

        // 중복 및 상이 통계 계산
        const mappedCounts = {};
        const baseCounts = {};

        entries.forEach(item => {
            const curVal = currentDictSite === 'all' ? item.golfmon : (item[currentDictSite] || item.name || '');
            const m = (curVal || '').trim().toLowerCase();
            if (m) mappedCounts[m] = (mappedCounts[m] || 0) + 1;
            const base = item.key.split(/[\(_\[\/]/)[0].trim().toLowerCase();
            if (base) baseCounts[base] = (baseCounts[base] || 0) + 1;
        });

        entries.forEach(item => {
            item.isDiff = (item.golfmon !== item.golfpang) ||
                          (item.golfmon !== item.golmarket) ||
                          (item.golfmon !== item.golfrock) ||
                          (isGolflandOpen && (item.golfmon !== item.golfland)) ||
                          (item.golfpang !== item.golmarket) ||
                          (item.golfpang !== item.golfrock) ||
                          (isGolflandOpen && (item.golfpang !== item.golfland)) ||
                          (item.golmarket !== item.golfrock) ||
                          (isGolflandOpen && (item.golmarket !== item.golfland)) ||
                          (isGolflandOpen && (item.golfrock !== item.golfland));

            const curVal = currentDictSite === 'all' ? item.golfmon : (item[currentDictSite] || item.name || '');
            const m = (curVal || '').trim().toLowerCase();
            const base = item.key.split(/[\(_\[\/]/)[0].trim().toLowerCase();
            item.mappedDupCount = m ? (mappedCounts[m] || 0) : 0;
            item.baseDupCount = base ? (baseCounts[base] || 0) : 0;
            item.isMappedDup = item.mappedDupCount > 1;
            item.isBaseDup = item.baseDupCount > 1;
            item.isDup = item.isMappedDup || item.isBaseDup;

            item.isMissingRegion = !item.region || item.region.trim() === '';
            if (currentDictSite === 'all') {
                item.isMissingName = !item.golfmon || !item.golfpang || !item.golmarket || !item.golfrock || (isGolflandOpen && !item.golfland);
            } else {
                const sName = item[currentDictSite] || '';
                item.isMissingName = !sName || sName.trim() === '';
            }
            item.isMissing = item.isMissingRegion || item.isMissingName;
        });

        // 칩 카운트 갱신
        const chipAllCount = document.getElementById('chipAllCount');
        const chipDiffCount = document.getElementById('chipDiffCount');
        const chipDupCount = document.getElementById('chipDupCount');
        const chipEmptyCount = document.getElementById('chipEmptyCount');

        if (chipAllCount) chipAllCount.innerText = entries.length;
        if (chipDiffCount) chipDiffCount.innerText = entries.filter(e => e.isDiff).length;
        if (chipDupCount) chipDupCount.innerText = entries.filter(e => e.isDup).length;
        if (chipEmptyCount) chipEmptyCount.innerText = entries.filter(e => e.isMissing).length;

        // 칩 활성화 상태 동기화
        document.getElementById('btnFilterAll')?.classList.toggle('active', currentDictFilter === 'all');
        document.getElementById('btnFilterDiff')?.classList.toggle('active', currentDictFilter === 'diff');
        document.getElementById('btnFilterDup')?.classList.toggle('active', currentDictFilter === 'dup');
        document.getElementById('btnFilterEmpty')?.classList.toggle('active', currentDictFilter === 'empty');

        // 필터 조건 적용
        let filtered = entries.filter(item => {
            if (currentDictFilter === 'diff') return item.isDiff;
            if (currentDictFilter === 'dup') return item.isDup;
            if (currentDictFilter === 'empty') return item.isMissing;
            return true;
        });

        // 검색어 필터링
        const search = (managerSearch?.value || '').toLowerCase().trim();
        if (search) {
            filtered = filtered.filter(item =>
                item.key.toLowerCase().includes(search) ||
                item.region.toLowerCase().includes(search) ||
                (item.golfrockRegion || '').toLowerCase().includes(search) ||
                (item.golfmon || '').toLowerCase().includes(search) ||
                (item.golfpang || '').toLowerCase().includes(search) ||
                (item.golmarket || '').toLowerCase().includes(search) ||
                (item.golfrock || '').toLowerCase().includes(search) ||
                (isGolflandOpen && (item.golfland || '').toLowerCase().includes(search))
            );
        }

        // 정렬
        filtered.sort((a, b) => {
            let valA = '', valB = '';
            if (managerSortCol === 0) { valA = a.key; valB = b.key; }
            else if (managerSortCol === 1) { valA = a.region; valB = b.region; }
            else if (currentDictSite !== 'all') {
                if (managerSortCol === 2) { valA = a[currentDictSite] || ''; valB = b[currentDictSite] || ''; }
            } else {
                if (managerSortCol === 2) { valA = a.golfmon || ''; valB = b.golfmon || ''; }
                else if (managerSortCol === 3) { valA = a.golfpang || ''; valB = b.golfpang || ''; }
                else if (managerSortCol === 4) { valA = a.golmarket || ''; valB = b.golmarket || ''; }
                else if (managerSortCol === 5) { valA = a.golfrock || ''; valB = b.golfrock || ''; }
                else if (managerSortCol === 6 && isGolflandOpen) { valA = a.golfland || ''; valB = b.golfland || ''; }
            }
            const res = (valA || '').localeCompare(valB || '', 'ko');
            return managerSortAsc ? res : -res;
        });

        if (filtered.length === 0) {
            const emptyTr = document.createElement('tr');
            let msg = '검색 결과가 없습니다.';
            if (currentDictFilter === 'diff') msg = '각 사이트 구장명이 서로 다른 항목이 없습니다.';
            else if (currentDictFilter === 'dup') msg = '중복된 구장이 없습니다. 완벽합니다!';
            else if (currentDictFilter === 'empty') msg = '미입력 항목이 없습니다. 모두 입력되었습니다!';
            const colSpan = currentDictSite === 'all' ? (isGolflandOpen ? 8 : 7) : 4;
            emptyTr.innerHTML = `<td colspan="${colSpan}" style="text-align:center; padding: 18px 8px; color: #6B7280; font-size: 11px;">${msg}</td>`;
            tbody.appendChild(emptyTr);
            return;
        }

        filtered.forEach(item => {
            const tr = document.createElement('tr');
            if (item.isDup) tr.classList.add('has-dup');
            if (item.isMissing) tr.classList.add('has-empty');

            let keyClass = 'dict-edit-key';
            let keyTitle = '';
            if (item.isBaseDup) {
                keyClass += ' input-warning-dup';
                keyTitle = `⚠️ 동일 구장명 매핑이 ${item.baseDupCount}건 등록되어 있습니다.`;
            }

            let regClass = 'dict-edit-reg';
            let regPlaceholder = '지역';
            let regTitle = '';
            if (item.isMissingRegion) {
                regClass += ' input-warning-empty';
                regPlaceholder = '지역 미입력 ⚠️';
                regTitle = '⚠️ 지역이 입력되지 않았습니다.';
            }

            if (currentDictSite === 'all') {
                const diffCls = item.isDiff ? 'dict-input-diff' : '';
                const golflandColHtml = isGolflandOpen ? `
                    <td><input type="text" value="${escapeAttr(item.golfland)}" data-key="${escapeAttr(item.key)}" data-site="golfland" class="dict-edit-sitename dict-edit-gld ${diffCls}" placeholder="골프랜드"></td>
                ` : '';
                tr.innerHTML = `
                    <td><input type="text" value="${escapeAttr(item.key)}" data-oldkey="${escapeAttr(item.key)}" class="${keyClass}" title="${escapeAttr(keyTitle)}"></td>
                    <td><input type="text" list="regionSuggestions" value="${escapeAttr(item.region)}" data-key="${escapeAttr(item.key)}" class="${regClass}" placeholder="${regPlaceholder}" title="${escapeAttr(regTitle)}"></td>
                    <td><input type="text" value="${escapeAttr(item.golfmon)}" data-key="${escapeAttr(item.key)}" data-site="golfmon" class="dict-edit-sitename dict-edit-gm ${diffCls}" placeholder="골프몬"></td>
                    <td><input type="text" value="${escapeAttr(item.golfpang)}" data-key="${escapeAttr(item.key)}" data-site="golfpang" class="dict-edit-sitename dict-edit-gp ${diffCls}" placeholder="골팡"></td>
                    <td><input type="text" value="${escapeAttr(item.golmarket)}" data-key="${escapeAttr(item.key)}" data-site="golmarket" class="dict-edit-sitename dict-edit-gmk ${diffCls}" placeholder="골마켓"></td>
                    <td><input type="text" value="${escapeAttr(item.golfrock)}" data-key="${escapeAttr(item.key)}" data-site="golfrock" class="dict-edit-sitename dict-edit-grk ${diffCls}" placeholder="골프락"></td>
                    ${golflandColHtml}
                    <td style="text-align:center;"><button type="button" class="btn-dict-del" data-key="${escapeAttr(item.key)}" style="padding: 2px 4px; font-size: 9px;" title="삭제">✕</button></td>
                `;
            } else {
                let nameClass = 'dict-edit-sitename';
                let namePlaceholder = '변환명';
                let nameTitle = '';
                const curVal = item[currentDictSite] || '';
                if (!curVal || curVal.trim() === '') {
                    nameClass += ' input-warning-empty';
                    namePlaceholder = '변환명 미입력 ⚠️';
                    nameTitle = '⚠️ 변환될 이름이 입력되지 않았습니다.';
                } else if (item.isMappedDup) {
                    nameClass += ' input-warning-dup';
                    nameTitle = `⚠️ 동일한 변환명('${curVal}')이 ${item.mappedDupCount}건 중복 등록되어 있습니다.`;
                }

                tr.innerHTML = `
                    <td><input type="text" value="${escapeAttr(item.key)}" data-oldkey="${escapeAttr(item.key)}" class="${keyClass}" title="${escapeAttr(keyTitle)}"></td>
                    <td><input type="text" list="regionSuggestions" value="${escapeAttr(item.region)}" data-key="${escapeAttr(item.key)}" class="${regClass}" placeholder="${regPlaceholder}" title="${escapeAttr(regTitle)}"></td>
                    <td><input type="text" value="${escapeAttr(curVal)}" data-key="${escapeAttr(item.key)}" data-site="${currentDictSite}" class="${nameClass}" placeholder="${namePlaceholder}" title="${escapeAttr(nameTitle)}"></td>
                    <td style="text-align:center;"><button type="button" class="btn-dict-del" data-key="${escapeAttr(item.key)}">삭제</button></td>
                `;
            }
            tbody.appendChild(tr);
        });

        // 원본 구장명 변경 (수정 시 메모리 반영 및 행 내부 키 동기화)
        tbody.querySelectorAll('.dict-edit-key').forEach(inp => {
            function handleKeyUpdate() {
                const oldKey = inp.dataset.oldkey;
                const newKey = inp.value.trim();
                if (!newKey) {
                    showToast('원본 구장명은 비워둘 수 없습니다.');
                    inp.value = oldKey;
                    return;
                }
                if (newKey !== oldKey) {
                    if (dictionary[newKey]) {
                        alert(`'${newKey}'(은)는 이미 존재하는 구장명입니다.`);
                        inp.value = oldKey;
                        return;
                    }
                    const currentData = normalizeDictEntry(dictionary[oldKey], newKey);
                    dictionary[newKey] = currentData;
                    delete dictionary[oldKey];
                    inp.dataset.oldkey = newKey;
                    
                    const parentTr = inp.closest('tr');
                    if (parentTr) {
                        parentTr.querySelectorAll('.dict-edit-reg, .dict-edit-sitename, .btn-dict-del').forEach(el => {
                            el.dataset.key = newKey;
                        });
                    }
                }
            }
            inp.addEventListener('change', handleKeyUpdate);
            inp.addEventListener('blur', handleKeyUpdate);
        });

        // 지역 변경 (change/blur 시 메모리 반영 및 정규화)
        tbody.querySelectorAll('.dict-edit-reg').forEach(inp => {
            function handleRegionUpdate() {
                const k = inp.dataset.key;
                if (!k) return;
                const rawVal = inp.value.trim();
                const entry = normalizeDictEntry(dictionary[k], k);
                let val = '';
                if (currentDictSite === 'golfrock') {
                    val = toGolfrockRegion(rawVal) || rawVal;
                    entry.golfrockRegion = val;
                } else {
                    val = toStandardRegion(rawVal) || rawVal;
                    entry.region = val;
                }
                inp.value = val;
                dictionary[k] = entry;

                if (val) {
                    inp.classList.remove('input-warning-empty');
                    inp.placeholder = '지역';
                    inp.title = '';
                } else {
                    inp.classList.add('input-warning-empty');
                    inp.placeholder = '지역 미입력 ⚠️';
                    inp.title = '⚠️ 지역이 입력되지 않았습니다.';
                }
            }
            inp.addEventListener('change', handleRegionUpdate);
            inp.addEventListener('blur', handleRegionUpdate);
        });

        // 사이트별 변환명 변경 (change/blur 시 메모리 반영, 한글자 타이핑 시 저장 제거)
        tbody.querySelectorAll('.dict-edit-sitename').forEach(inp => {
            function handleSiteNameUpdate() {
                const k = inp.dataset.key;
                const site = inp.dataset.site || currentDictSite;
                if (!k || !site) return;
                const val = inp.value.trim();
                const entry = normalizeDictEntry(dictionary[k], k);
                entry[site] = val;
                if (site === 'golfmon') {
                    entry.name = val;
                }
                dictionary[k] = entry;

                if (val) {
                    inp.classList.remove('input-warning-empty');
                    inp.placeholder = '변환명';
                    inp.title = '';
                } else {
                    inp.classList.add('input-warning-empty');
                    inp.placeholder = '변환명 미입력 ⚠️';
                    inp.title = '⚠️ 변환될 이름이 입력되지 않았습니다.';
                }
            }
            inp.addEventListener('change', handleSiteNameUpdate);
            inp.addEventListener('blur', handleSiteNameUpdate);
        });
    }

    // 테이블 내 삭제 버튼 이벤트 위임 (Chromium confirm 차단 문제 완전 해결 및 즉시 삭제)
    const dictTableBody = document.getElementById('dictTableBody');
    if (dictTableBody) {
        dictTableBody.addEventListener('click', (e) => {
            const btn = e.target.closest('.btn-dict-del');
            if (!btn) return;
            const k = btn.dataset.key;
            if (!k) return;

            flushAndSaveDictTable(false, k);
            if (dictionary[k]) {
                delete dictionary[k];
            }
            saveDictionary();
            renderDictModal();
            showToast(`'${k}' 매핑이 삭제되었습니다.`);
        });
    }

    // 사이트별 사전 분리 탭 클릭 이벤트 위임
    const dictSiteTabs = document.getElementById('dictSiteTabs');
    if (dictSiteTabs) {
        dictSiteTabs.addEventListener('click', (e) => {
            const tab = e.target.closest('.dict-site-tab');
            if (tab && tab.dataset.site) {
                switchDictSite(tab.dataset.site);
            }
        });
    }

    // 필터 칩 클릭 이벤트 연결
    ['btnFilterAll', 'btnFilterDiff', 'btnFilterDup', 'btnFilterEmpty'].forEach(id => {
        const btn = document.getElementById(id);
        if (btn) {
            btn.addEventListener('click', () => {
                flushAndSaveDictTable(false);
                currentDictFilter = btn.dataset.filter || 'all';
                renderDictModal();
                if (currentDictFilter === 'diff') {
                    const isGolflandOpen = true;
                    const siteNames = isGolflandOpen ? '골프몬 · 골팡 · 골마켓 · 골프락 · 골프랜드' : '골프몬 · 골팡 · 골마켓 · 골프락';
                    showToast(`🔀 ${siteNames} 간 명칭이 서로 다른 구장만 표시합니다.`);
                } else if (currentDictFilter === 'dup') {
                    showToast('중복된 구장만 필터링하여 표시합니다.');
                } else if (currentDictFilter === 'empty') {
                    showToast('❓ 지역/변환명 미입력 항목만 필터링하여 표시합니다.');
                }
            });
        }
    });

    if (btnOpenDict && dictModal) {
        btnOpenDict.addEventListener('click', () => {
            dictSnapshot = JSON.parse(JSON.stringify(dictionary)); // 스냅샷 보관 (취소 시 원복용)
            const isLab = localStorage.getItem('v2_labModeActive') === 'true';
            updateLabFeaturesUI(isLab);
            if (managerSearch) managerSearch.value = '';
            if (syncCodeInput) syncCodeInput.value = '';
            if (importCodeInput) importCodeInput.value = '';
            currentDictFilter = 'all';
            currentDictSite = 'golfmon';
            managerSortCol = 0;
            managerSortAsc = true;
            document.querySelectorAll('#dictSiteTabs .dict-site-tab').forEach(tab => {
                tab.classList.toggle('active', tab.dataset.site === 'golfmon');
            });
            const descEl = document.getElementById('dictSiteDesc');
            if (descEl && siteTabConfig.golfmon) {
                descEl.innerHTML = siteTabConfig.golfmon.desc;
                descEl.style.borderLeftColor = siteTabConfig.golfmon.color;
            }
            renderDictModal();
            dictModal.style.display = 'flex';
        });
    }

    // 저장 후 닫기 버튼: 테이블 입력값을 메모리에 반영하고 저장소에 일괄 저장
    if (btnCloseDictModal && dictModal) {
        btnCloseDictModal.addEventListener('click', () => {
            flushAndSaveDictTable(true);
            updateDictStats();
            dictSnapshot = null;
            dictModal.style.display = 'none';
            showToast('매핑사전이 저장되었습니다.');
        });
    }

    // 취소 버튼: 모달 열기 전 스냅샷으로 원복
    if (btnCancelDictModal && dictModal) {
        btnCancelDictModal.addEventListener('click', () => {
            if (dictSnapshot) {
                dictionary = JSON.parse(JSON.stringify(dictSnapshot));
                saveDictionary();
                dictSnapshot = null;
            }
            dictModal.style.display = 'none';
            showToast('사전 수정을 취소하고 이전 상태로 복원했습니다.');
        });
    }

    // 모달 배경 클릭: 안전하게 일괄 저장 후 닫기
    if (dictModal) {
        dictModal.addEventListener('click', (e) => {
            if (e.target === dictModal) {
                flushAndSaveDictTable(true);
                updateDictStats();
                dictSnapshot = null;
                dictModal.style.display = 'none';
                showToast('매핑사전이 저장되었습니다.');
            }
        });
    }

    window.addEventListener('beforeunload', () => {
        saveDictionary();
    });

    if (managerSearch) {
        managerSearch.addEventListener('input', () => {
            flushAndSaveDictTable(false);
            renderDictModal();
        });
    }

    // 비정상 항목 일괄 정리 버튼 (특수기호(-, ■), 시간, 공지문구 등)
    const btnCleanJunkDict = document.getElementById('btnCleanJunkDict');
    if (btnCleanJunkDict) {
        btnCleanJunkDict.addEventListener('click', () => {
            flushAndSaveDictTable(false);
            const junkKeys = Object.keys(dictionary).filter(k => isJunkDictKey(k));
            if (junkKeys.length === 0) {
                showToast('정리할 비정상 항목이 없습니다. 사전이 깨끗합니다!');
                return;
            }
            junkKeys.forEach(k => {
                delete dictionary[k];
            });
            saveDictionary();
            renderDictModal();
            showToast(`비정상 항목 ${junkKeys.length}건(${junkKeys.slice(0, 3).join(', ')}${junkKeys.length > 3 ? ' 등' : ''})이 일괄 삭제되었습니다.`);
        });
    }

    // 새 매핑 추가: 모달 편집 중 메모리에 추가 및 즉시 영구 저장
    if (btnAddNewDict) {
        btnAddNewDict.addEventListener('click', () => {
            flushAndSaveDictTable(false);
            const raw = prompt("추가할 원본 구장명을 입력하세요:\n(예: 벨라스톤, 마론뉴데이 등)");
            if (raw && raw.trim()) {
                const clean = raw.trim();
                if (dictionary[clean]) {
                    alert(`'${clean}'(은)는 이미 등록된 구장입니다.`);
                    if (managerSearch) {
                        managerSearch.value = clean;
                        renderDictModal();
                    }
                    return;
                }
                const defReg = getRegion('', clean);
                const defGm = clean;
                const defGp = clean;
                const defGmk = getGolmarketGolfName(clean) || clean;
                const defGrk = clean;
                const defGld = clean;

                dictionary[clean] = {
                    region: defReg,
                    golfmon: defGm,
                    golfpang: defGp,
                    golmarket: defGmk,
                    golfrock: defGrk,
                    golfland: defGld,
                    name: defGm
                };
                saveDictionary();

                // 검색창을 해당 구장명으로 설정하여 바로 나타나도록 처리
                if (managerSearch) managerSearch.value = clean;
                renderDictModal();
                showToast(`'${clean}' 추가되었습니다.`);

                setTimeout(() => {
                    const row = document.querySelector(`.dict-edit-reg[data-key="${clean}"]`) ||
                                document.querySelector(`.dict-edit-sitename[data-key="${clean}"]`);
                    if (row) row.focus();
                }, 100);
            }
        });
    }

    // 기기 간 동기화 UI 요소 참조
    const btnExportFile = document.getElementById("btnExportFile");
    const btnPasteClipboard = document.getElementById("btnPasteClipboard");
    const btnImportFile = document.getElementById("btnImportFile");
    const fileInputDict = document.getElementById("fileInputDict");
    const syncStatusMsg = document.getElementById("syncStatusMsg");

    function showSyncStatus(msg, isSuccess) {
        if (!syncStatusMsg) return;
        syncStatusMsg.style.display = "block";
        syncStatusMsg.style.color = isSuccess ? "#059669" : "#DC2626";
        syncStatusMsg.innerHTML = msg;
    }

    function handleImportSyncCode(codeStr) {
        if (!codeStr || !codeStr.trim()) {
            showSyncStatus("⚠️ 가져올 동기화 코드를 입력하거나 붙여넣어주세요.", false);
            return false;
        }
        try {
            const decoded = decodeSyncString(codeStr);
            if (!decoded || typeof decoded !== "object" || Object.keys(decoded).length === 0) {
                showSyncStatus("❌ 올바르지 않거나 손상된 동기화 코드입니다.", false);
                return false;
            }

            const count = Object.keys(decoded).length;
            dictionary = {};
            for (const [k, v] of Object.entries(decoded)) {
                dictionary[k] = normalizeDictEntry(v, k);
            }
            saveDictionary();
            dictSnapshot = JSON.parse(JSON.stringify(dictionary));
            renderDictModal();
            if (typeof updateDictStats === "function") updateDictStats();

            showSyncStatus(`동기화 완료! 총 ${count}개 골프장 사전이 즉시 적용되었습니다.`, true);
            showToast(`동기화 성공! (${count}개 구장 적용됨)`);
            if (importCodeInput) importCodeInput.value = "";
            return true;
        } catch (e) {
            console.error("Import sync error:", e);
            showSyncStatus("❌ 사전 데이터 해석 중 오류가 발생했습니다: " + (e.message || ""), false);
            return false;
        }
    }

    // 1. 코드 생성 및 클립보드 복사
    if (btnExportSync) {
        btnExportSync.addEventListener("click", () => {
            flushAndSaveDictTable(true);
            try {
                const str = btoa(encodeURIComponent(JSON.stringify(dictionary)));
                if (syncCodeInput) {
                    syncCodeInput.value = str;
                    syncCodeInput.select();
                }
                const count = Object.keys(dictionary).length;
                navigator.clipboard.writeText(str).then(() => {
                    showSyncStatus(`${count}개 골프장 동기화 코드가 클립보드에 복사되었습니다!`, true);
                    showToast("동기화 코드가 복사되었습니다!");
                }).catch(() => {
                    showSyncStatus(`${count}개 골프장 코드가 생성되었습니다. 위 칸의 코드를 복사하세요.`, true);
                    showToast("코드가 생성되었습니다. 복사하세요.");
                });
            } catch(e) {
                showSyncStatus("❌ 코드 생성 중 오류가 발생했습니다: " + e.message, false);
            }
        });
    }

    // 2. 사전을 JSON 파일로 내보내기/저장
    if (btnExportFile) {
        btnExportFile.addEventListener("click", () => {
            flushAndSaveDictTable(true);
            try {
                const jsonStr = JSON.stringify(dictionary, null, 2);
                const blob = new Blob([jsonStr], { type: "application/json" });
                const url = URL.createObjectURL(blob);
                const a = document.createElement("a");
                a.href = url;
                const d = new Date();
                const dateStr = d.getFullYear() + String(d.getMonth()+1).padStart(2,"0") + String(d.getDate()).padStart(2,"0");
                a.download = `golf_dictionary_${dateStr}.json`;
                document.body.appendChild(a);
                a.click();
                setTimeout(() => {
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);
                }, 200);
                showSyncStatus(`💾 ${Object.keys(dictionary).length}개 골프장 사전이 파일로 저장되었습니다.`, true);
                showToast("사전 JSON 파일이 다운로드되었습니다!");
            } catch(e) {
                showSyncStatus("❌ 파일 저장 실패: " + e.message, false);
            }
        });
    }

    // 3. 클립보드 바로 붙여넣기 및 자동 가져오기 버튼
    if (btnPasteClipboard) {
        btnPasteClipboard.addEventListener("click", async () => {
            try {
                const text = await navigator.clipboard.readText();
                if (!text || !text.trim()) {
                    showSyncStatus("⚠️ 클립보드가 비어 있습니다.", false);
                    return;
                }
                if (importCodeInput) importCodeInput.value = text.trim();
                handleImportSyncCode(text.trim());
            } catch(err) {
                showSyncStatus("브라우저 권한으로 인해 클립보드 자동 읽기가 차단되었습니다. 입력창을 클릭 후 Ctrl+V로 붙여넣어주세요.", false);
            }
        });
    }

    // 4. 사전 가져오기 버튼 클릭
    if (btnImportSync) {
        btnImportSync.addEventListener("click", () => {
            const code = importCodeInput ? importCodeInput.value.trim() : "";
            handleImportSyncCode(code);
        });
    }

    // 5. 붙여넣기 칸 실시간 감지 (paste, input, Enter 키)
    if (importCodeInput) {
        importCodeInput.addEventListener("paste", () => {
            setTimeout(() => {
                const val = importCodeInput.value.trim();
                if (val) {
                    const decoded = decodeSyncString(val);
                    if (decoded && typeof decoded === "object") {
                        const count = Object.keys(decoded).length;
                        showSyncStatus(`유효한 동기화 코드 감지됨 (${count}개 구장) - [사전 가져오기] 클릭 시 즉시 적용됩니다.`, true);
                    } else {
                        showSyncStatus("⚠️ 코드가 감지되었으나 유효한 사전 형식이 아닙니다.", false);
                    }
                }
            }, 60);
        });

        importCodeInput.addEventListener("keydown", (e) => {
            if (e.key === "Enter") {
                e.preventDefault();
                handleImportSyncCode(importCodeInput.value.trim());
            }
        });
    }

    // 6. 저장된 JSON 파일 열기/불러오기
    if (btnImportFile && fileInputDict) {
        btnImportFile.addEventListener("click", () => {
            fileInputDict.value = "";
            fileInputDict.click();
        });
        fileInputDict.addEventListener("change", (e) => {
            const file = e.target.files && e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = (event) => {
                const content = event.target.result;
                handleImportSyncCode(content);
            };
            reader.onerror = () => {
                showSyncStatus("❌ 파일 읽기 실패", false);
            };
            reader.readAsText(file, "utf-8");
        });
    }

    // 다른 창/패널과의 실시간 스토리지 동기화
    if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.onChanged) {
        chrome.storage.onChanged.addListener((changes, area) => {
            if (area === 'local' && changes.v2_golfDict) {
                const newDict = changes.v2_golfDict.newValue;
                if (newDict && typeof newDict === 'object') {
                    dictionary = newDict;
                    try { localStorage.setItem('v2_golfDict', JSON.stringify(dictionary)); } catch(e) {}
                    if (dictModal && dictModal.style.display === 'flex') {
                        renderDictModal();
                    }
                }
            }
            if (area === 'local' && changes.v2_savedGolfmonMemo) {
                const newMemo = changes.v2_savedGolfmonMemo.newValue;
                const memoEl = document.getElementById('golfmonMemo');
                if (memoEl && typeof newMemo === 'string' && memoEl.value !== newMemo) {
                    memoEl.value = newMemo;
                    try { localStorage.setItem('v2_savedGolfmonMemo', newMemo); } catch(e) {}
                }
            }
            if (area === 'local' && changes.v2_prepaidExcludeList) {
                const newList = changes.v2_prepaidExcludeList.newValue;
                if (Array.isArray(newList)) {
                    prepaidExcludeList = newList;
                    updatePrepaidExcludeUI();
                    updateLivePrepaidFees();
                }
            }
            if (area === 'local' && changes.v2_prepaidPlusChecked) {
                const newChecked = changes.v2_prepaidPlusChecked.newValue;
                if (typeof newChecked === 'boolean') {
                    const chk = document.getElementById('chkPrepaidPlus');
                    if (chk) {
                        chk.checked = newChecked;
                        updatePrepaidToggleUI();
                        updateLivePrepaidFees();
                    }
                }
            }
            if (area === 'local' && typeof changes.v2_isNoticeRulesActive !== 'undefined') {
                const newActive = changes.v2_isNoticeRulesActive.newValue;
                if (typeof newActive === 'boolean' && newActive !== isNoticeRulesActive) {
                    setNoticeRulesActive(newActive, false);
                }
            }
            if (area === 'local' && typeof changes.v2_isCoursePriceRulesActive !== 'undefined') {
                const newActive = changes.v2_isCoursePriceRulesActive.newValue;
                if (typeof newActive === 'boolean' && newActive !== isCoursePriceRulesActive) {
                    setCoursePriceRulesActive(newActive, false);
                }
            }
            if (area === 'local' && changes.v2_coursePriceAdjustments) {
                const newList = changes.v2_coursePriceAdjustments.newValue;
                if (Array.isArray(newList)) {
                    customCoursePriceAdjustments = newList
                        .map(item => normalizeCoursePriceAdjustmentItem(item))
                        .filter(Boolean);
                    updateCoursePriceBadgeUI();
                    updateLivePrepaidFees();
                }
            }
            if (area === 'local' && typeof changes.v2_labModeActive !== 'undefined') {
                const isAdmin = isCurrentUserAdmin();
                const newLab = isAdmin && !!changes.v2_labModeActive.newValue;
                const chkLab = document.getElementById('chkLabMode');
                const labPanel = document.getElementById('labSettingsPanel');
                if (chkLab) chkLab.checked = newLab;
                if (labPanel) labPanel.style.display = newLab ? 'block' : 'none';
                try { localStorage.setItem('v2_labModeActive', newLab ? 'true' : 'false'); } catch(e) {}
            }
            if (area === 'local' && typeof changes.v2_autoSelectPriority !== 'undefined') {
                const newPri = changes.v2_autoSelectPriority.newValue;
                if (typeof newPri === 'string' && newPri !== autoSelectPriority) {
                    setAutoSelectPriority(newPri, false);
                }
            }
            if (area === 'local' && (typeof changes.v2_updateActionsActive !== 'undefined' || typeof changes.v2_priceUpdateActive !== 'undefined' || typeof changes.v2_replacePostActive !== 'undefined')) {
                const newAct = typeof changes.v2_updateActionsActive !== 'undefined'
                    ? !!changes.v2_updateActionsActive.newValue
                    : (!!changes.v2_priceUpdateActive?.newValue || !!changes.v2_replacePostActive?.newValue);
                const chkAct = document.getElementById('chkOpenUpdateActions');
                if (chkAct) chkAct.checked = newAct;
                try {
                    localStorage.setItem('v2_updateActionsActive', newAct ? 'true' : 'false');
                    localStorage.setItem('v2_priceUpdateActive', newAct ? 'true' : 'false');
                    localStorage.setItem('v2_replacePostActive', newAct ? 'true' : 'false');
                } catch(e) {}
                const isLabActive = localStorage.getItem('v2_labModeActive') === 'true';
                updateLabFeaturesUI(isLabActive);
            }
            if (area === 'local' && typeof changes.v2_dateResetActive !== 'undefined') {
                const newReset = !!changes.v2_dateResetActive.newValue;
                const chkReset = document.getElementById('chkOpenDateReset');
                if (chkReset) chkReset.checked = newReset;
                try { localStorage.setItem('v2_dateResetActive', newReset ? 'true' : 'false'); } catch(e) {}
                const isLabActive = localStorage.getItem('v2_labModeActive') === 'true';
                updateLabFeaturesUI(isLabActive);
            }
            if (area === 'local' && typeof changes.v2_soldOutFeatureActive !== 'undefined') {
                const newSoldOut = !!changes.v2_soldOutFeatureActive.newValue;
                const chkSoldOut = document.getElementById('chkOpenSoldOutFeature');
                if (chkSoldOut) chkSoldOut.checked = newSoldOut;
                try { localStorage.setItem('v2_soldOutFeatureActive', newSoldOut ? 'true' : 'false'); } catch(e) {}
                const isLabActive = localStorage.getItem('v2_labModeActive') === 'true';
                updateLabFeaturesUI(isLabActive);
            }

            if (area === 'local' && changes.v2_specialTargetCourses) {
                const newCourses = changes.v2_specialTargetCourses.newValue;
                if (Array.isArray(newCourses)) {
                    specialTargetCourses = newCourses.map(s => String(s || '').trim()).filter(Boolean);
                    try { localStorage.setItem('v2_specialTargetCourses', JSON.stringify(specialTargetCourses)); } catch(e) {}
                    updateSpecialMacroBtnTooltip();
                }
            }
            if (area === 'local' && typeof changes.v2_confirmCourseMismatch !== 'undefined') {
                const newMis = !!changes.v2_confirmCourseMismatch.newValue;
                const chkMis = document.getElementById('chkConfirmCourseMismatch');
                if (chkMis) chkMis.checked = newMis;
                try { localStorage.setItem('v2_confirmCourseMismatch', newMis ? 'true' : 'false'); } catch(e) {}
            }
            if (area === 'local' && changes.golmarket_task) {
                const newTask = changes.golmarket_task.newValue;
                if (newTask && newTask.isRunning) {
                    const overlay = document.getElementById('progressOverlay');
                    if (!overlay || overlay.style.display !== 'flex') {
                        showProgressModal(newTask.totalCount || newTask.items?.length, newTask.isTransferMode ? 'golmarket_transfer' : 'golmarket');
                    }
                    const curItem = newTask.items ? newTask.items[newTask.currentIndex] : null;
                    if (curItem) {
                        updateProgress(newTask.currentIndex + 1, newTask.totalCount || newTask.items.length, curItem.golf, curItem.date, curItem.time);
                    }
                    document.getElementById('btnHeaderStop')?.classList.add('active');
                } else if (!newTask) {
                    const overlay = document.getElementById('progressOverlay');
                    if (overlay && overlay.style.display === 'flex') {
                        overlay.style.display = 'none';
                    }
                    document.getElementById('btnHeaderStop')?.classList.remove('active');
                }
            }
            if (area === 'local' && changes.golfrock_task) {
                const newTask = changes.golfrock_task.newValue;
                if (newTask && newTask.isRunning) {
                    const overlay = document.getElementById('progressOverlay');
                    if (!overlay || overlay.style.display !== 'flex') {
                        showProgressModal(newTask.totalCount || newTask.items?.length, 'golfrock');
                    }
                    const curItem = newTask.items ? newTask.items[newTask.currentIndex] : null;
                    if (curItem) {
                        updateProgress(newTask.currentIndex + 1, newTask.totalCount || newTask.items.length, curItem.golf, curItem.date, curItem.time);
                    }
                    document.getElementById('btnHeaderStop')?.classList.add('active');
                } else if (!newTask) {
                    const overlay = document.getElementById('progressOverlay');
                    if (overlay && overlay.style.display === 'flex') {
                        overlay.style.display = 'none';
                    }
                    document.getElementById('btnHeaderStop')?.classList.remove('active');
                }
            }
            if (area === 'local' && changes.golfland_task) {
                const newTask = changes.golfland_task.newValue;
                if (newTask && newTask.isRunning) {
                    const overlay = document.getElementById('progressOverlay');
                    if (!overlay || overlay.style.display !== 'flex') {
                        showProgressModal(newTask.totalCount || newTask.items?.length, 'golfland');
                    }
                    const curItem = newTask.items ? newTask.items[newTask.currentIndex] : null;
                    if (curItem) {
                        updateProgress(newTask.currentIndex + 1, newTask.totalCount || newTask.items.length, curItem.golf, curItem.date, curItem.time);
                    }
                    document.getElementById('btnHeaderStop')?.classList.add('active');
                } else if (!newTask) {
                    const overlay = document.getElementById('progressOverlay');
                    if (overlay && overlay.style.display === 'flex') {
                        overlay.style.display = 'none';
                    }
                    document.getElementById('btnHeaderStop')?.classList.remove('active');
                }
            }
            if (area === 'local' && changes.golftop_task) {
                const newTask = changes.golftop_task.newValue;
                if (newTask && newTask.isRunning) {
                    const overlay = document.getElementById('progressOverlay');
                    if (!overlay || overlay.style.display !== 'flex') {
                        showProgressModal(newTask.totalCount || newTask.items?.length, 'golftop');
                    }
                    const curItem = newTask.items ? newTask.items[newTask.currentIndex] : null;
                    if (curItem) {
                        updateProgress(newTask.currentIndex + 1, newTask.totalCount || newTask.items.length, curItem.golf, curItem.date, curItem.time);
                    }
                    document.getElementById('btnHeaderStop')?.classList.add('active');
                } else if (!newTask) {
                    const overlay = document.getElementById('progressOverlay');
                    if (overlay && overlay.style.display === 'flex') {
                        overlay.style.display = 'none';
                    }
                    document.getElementById('btnHeaderStop')?.classList.remove('active');
                }
            }
        });
    }

    // 등록 이력 로드 (New GolfTee82 가격 변동 감지용)
    loadRegisteredHistory();

    // 활성 공지 규칙 및 특정구장 가격변경 규칙 로드
    initNoticeRulesActive();
    initCoursePriceRulesActive();
    loadActiveNoticeRules();
    renderActiveNoticeChips();
    loadCoursePriceAdjustments();
    loadSpecialTargetCourses();
    initAutoSelectPriority();

    // chrome.storage.local 비동기 동기화 복원 (창 분리/재실행 시 영구 유지)
    try {
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.get(['v2_activeNoticeRules', 'v2_coursePriceAdjustments', 'v2_specialTargetCourses', 'v2_isNoticeRulesActive', 'v2_isCoursePriceRulesActive', 'v2_labModeActive', 'v2_updateActionsActive', 'v2_priceUpdateActive', 'v2_replacePostActive', 'v2_dateResetActive', 'v2_noticeFeatureActive', 'v2_notice_custom_courses', 'v2_autoSelectPriority', 'v2_confirmCourseMismatch', 'v2_allowF12', 'v2_smartPrependOnPaste', 'v2_stepDelayPreset', 'v2_randomDelayPreset'], (res) => {
                if (typeof res?.v2_stepDelayPreset === 'string' && res.v2_stepDelayPreset) {
                    try { localStorage.setItem('v2_stepDelayPreset', res.v2_stepDelayPreset); } catch(e) {}
                    const selStep = document.getElementById('selStepDelay');
                    if (selStep) {
                        if (Array.from(selStep.options).some(o => o.value === res.v2_stepDelayPreset)) {
                            selStep.value = res.v2_stepDelayPreset;
                        } else if (res.v2_stepDelayPreset === 'turbo' && isCurrentUserAdmin()) {
                            updateSpeedOptionsUI(true);
                        }
                    }
                }
                if (typeof res?.v2_randomDelayPreset === 'string' && res.v2_randomDelayPreset) {
                    try { localStorage.setItem('v2_randomDelayPreset', res.v2_randomDelayPreset); } catch(e) {}
                    const selRandom = document.getElementById('selRandomDelay');
                    if (selRandom) {
                        if (Array.from(selRandom.options).some(o => o.value === res.v2_randomDelayPreset)) {
                            selRandom.value = res.v2_randomDelayPreset;
                        } else if (res.v2_randomDelayPreset === 'turbo' && isCurrentUserAdmin()) {
                            updateSpeedOptionsUI(true);
                        }
                    }
                }
                if (typeof res?.v2_smartPrependOnPaste === 'boolean') {
                    const chkSmart = document.getElementById('chkSmartPrependOnPaste');
                    if (chkSmart) chkSmart.checked = res.v2_smartPrependOnPaste;
                    try { localStorage.setItem('v2_smartPrependOnPaste', res.v2_smartPrependOnPaste ? 'true' : 'false'); } catch(e) {}
                    updateSelectedBadge();
                }
                if (Array.isArray(res?.v2_specialTargetCourses)) {
                    specialTargetCourses = res.v2_specialTargetCourses.map(s => String(s || '').trim()).filter(Boolean);
                    try { localStorage.setItem('v2_specialTargetCourses', JSON.stringify(specialTargetCourses)); } catch(e) {}
                    updateSpecialMacroBtnTooltip();
                }
                if (typeof res?.v2_confirmCourseMismatch === 'boolean') {
                    const chkMis = document.getElementById('chkConfirmCourseMismatch');
                    if (chkMis) chkMis.checked = res.v2_confirmCourseMismatch;
                    try { localStorage.setItem('v2_confirmCourseMismatch', res.v2_confirmCourseMismatch ? 'true' : 'false'); } catch(e) {}
                }
                if (typeof res?.v2_autoSelectPriority === 'string') {
                    setAutoSelectPriority(res.v2_autoSelectPriority, false);
                }
                if (typeof res?.v2_isNoticeRulesActive === 'boolean' && res.v2_isNoticeRulesActive !== isNoticeRulesActive) {
                    setNoticeRulesActive(res.v2_isNoticeRulesActive, false);
                }
                if (typeof res?.v2_isCoursePriceRulesActive === 'boolean' && res.v2_isCoursePriceRulesActive !== isCoursePriceRulesActive) {
                    setCoursePriceRulesActive(res.v2_isCoursePriceRulesActive, false);
                }
                if (typeof res?.v2_labModeActive === 'boolean') {
                    const isAdmin = isCurrentUserAdmin();
                    const isLab = isAdmin && res.v2_labModeActive;
                    const chkLab = document.getElementById('chkLabMode');
                    const labPanel = document.getElementById('labSettingsPanel');
                    if (chkLab) chkLab.checked = isLab;
                    if (labPanel) labPanel.style.display = isLab ? 'block' : 'none';
                    try { localStorage.setItem('v2_labModeActive', isLab ? 'true' : 'false'); } catch(e) {}
                }
                if (typeof res?.v2_updateActionsActive === 'boolean' || typeof res?.v2_priceUpdateActive === 'boolean' || typeof res?.v2_replacePostActive === 'boolean') {
                    const isSaved = res.v2_updateActionsActive ?? (res.v2_priceUpdateActive || res.v2_replacePostActive);
                    const chkAct = document.getElementById('chkOpenUpdateActions');
                    const isLab = localStorage.getItem('v2_labModeActive') === 'true';
                    if (chkAct) chkAct.checked = isSaved && isLab;
                    try {
                        localStorage.setItem('v2_updateActionsActive', isSaved ? 'true' : 'false');
                        localStorage.setItem('v2_priceUpdateActive', isSaved ? 'true' : 'false');
                        localStorage.setItem('v2_replacePostActive', isSaved ? 'true' : 'false');
                    } catch(e) {}
                    updateLabFeaturesUI(isLab);
                }
                if (typeof res?.v2_dateResetActive === 'boolean') {
                    const chkReset = document.getElementById('chkOpenDateReset');
                    const isLab = localStorage.getItem('v2_labModeActive') === 'true';
                    if (chkReset) chkReset.checked = res.v2_dateResetActive && isLab;
                    try { localStorage.setItem('v2_dateResetActive', res.v2_dateResetActive ? 'true' : 'false'); } catch(e) {}
                    updateLabFeaturesUI(isLab);
                }
                if (typeof res?.v2_noticeFeatureActive === 'boolean') {
                    const chkNotice = document.getElementById('chkOpenNoticeFeature');
                    const isLab = localStorage.getItem('v2_labModeActive') === 'true';
                    const hasNotice = typeof hasUserFeature === 'function' ? (hasUserFeature('notice') || hasUserFeature('공지') || hasUserFeature('공지등록')) : false;
                    if (chkNotice) chkNotice.checked = hasNotice || (res.v2_noticeFeatureActive && isLab);
                    try { localStorage.setItem('v2_noticeFeatureActive', res.v2_noticeFeatureActive ? 'true' : 'false'); } catch(e) {}
                    updateLabFeaturesUI(isLab);
                }
                if (typeof res?.v2_allowF12 === 'boolean') {
                    const chkF12 = document.getElementById('chkAllowF12');
                    const isLab = localStorage.getItem('v2_labModeActive') === 'true';
                    const hasF12 = typeof hasUserFeature === 'function' ? (hasUserFeature('f12') || hasUserFeature('devtools') || hasUserFeature('f12해제')) : false;
                    if (chkF12) chkF12.checked = hasF12 || (res.v2_allowF12 && isLab);
                    try { localStorage.setItem('v2_allowF12', res.v2_allowF12 ? 'true' : 'false'); } catch(e) {}
                    updateLabFeaturesUI(isLab);
                }
                if (typeof res?.v2_soldOutFeatureActive === 'boolean') {
                    const chkSoldOut = document.getElementById('chkOpenSoldOutFeature');
                    const isLab = localStorage.getItem('v2_labModeActive') === 'true';
                    if (chkSoldOut) chkSoldOut.checked = res.v2_soldOutFeatureActive && isLab;
                    try { localStorage.setItem('v2_soldOutFeatureActive', res.v2_soldOutFeatureActive ? 'true' : 'false'); } catch(e) {}
                    updateLabFeaturesUI(isLab);
                }

                if (Array.isArray(res?.v2_notice_custom_courses)) {
                    customNoticeCourses = res.v2_notice_custom_courses;
                    try { localStorage.setItem('v2_notice_custom_courses', JSON.stringify(customNoticeCourses)); } catch(e) {}
                }
                let shouldUpdateNoticeFees = false;
                if (res && Array.isArray(res.v2_activeNoticeRules) && res.v2_activeNoticeRules.length > 0) {
                    if (!activeNoticeRules || activeNoticeRules.length === 0) {
                        const localDeleted = getLocallyDeletedNoticeCourses();
                        activeNoticeRules = res.v2_activeNoticeRules.filter(r => !isCourseLocallyDeleted(r?.course, r?.receivedTimestamp, localDeleted));
                        pruneExpiredNoticeRules();
                        renderActiveNoticeChips();
                        shouldUpdateNoticeFees = true;
                    }
                }
                if (res && Array.isArray(res.v2_coursePriceAdjustments) && res.v2_coursePriceAdjustments.length > 0) {
                    if (!customCoursePriceAdjustments || customCoursePriceAdjustments.length === 0) {
                        customCoursePriceAdjustments = res.v2_coursePriceAdjustments
                            .map(item => normalizeCoursePriceAdjustmentItem(item))
                            .filter(Boolean);
                        updateCoursePriceBadgeUI();
                        shouldUpdateNoticeFees = true;
                    }
                }
                if (shouldUpdateNoticeFees) {
                    updateLivePrepaidFees();
                }
            });
        }
    } catch(e) {}

    // 초기 상태 복원 (저장된 테이블 복원, 없으면 빈 상태 카드 렌더링)
    if (!restoreSavedTableState()) {
        renderCardList();
    } else {
        updateLivePrepaidFees();
    }
    updateSortBarUI();
    // 부제(1부/2부/3부) 우선선택 UI 초기화
    initPreferredPartsUI();
    // 🚫 문자 붙여넣기 원클릭 글마감/삭제 모달 초기화
    initSoldOutTextModal();
    // ★ [사용자 요청] 개별 티타임 가격/인원 간편 수정 모달 초기화
    initEditItemModal();
    // 이전에 완료된 항목이 있다면 체크 해제 동기화
    checkAndUncheckCompletedFromStorage();
    // 툴바 아이콘 렌더링 (UI 오픈 지연 방지를 위해 백그라운드 지연 실행)
    setTimeout(applyToolbarIconFromPopup, 1200);
    // 프로그램 버전 UI 동기화
    updateAppVersionUI();

    // 팝업 시작 1.2초 후 조용히 클라우드 공지 동기화 (관리자의 공지 등록/삭제 실시간 자동 감지)
    setTimeout(() => {
        if (typeof syncNoticesWithCloud === 'function') {
            syncNoticesWithCloud(false, true);
        }
    }, 1200);

    // 전체 인원 공지 자동 동기화 타이머 (3~5분 주기 + ±30초 무작위 지터로 부하 분산)
    function scheduleNextNoticeSync() {
        const baseSeconds = 240; // 4분
        const jitterSeconds = (Math.random() * 60) - 30; // ±30초 무작위 분산
        setTimeout(() => {
            if (typeof syncNoticesWithCloud === 'function') {
                syncNoticesWithCloud(false, true);
            }
            scheduleNextNoticeSync();
        }, Math.round((baseSeconds + jitterSeconds) * 1000));
    }
    scheduleNextNoticeSync();

    // 진행 중인 등록 작업(골마켓/골프락/골프랜드/골프탑) 복원 및 진행상황 창 표시
    try {
        chrome.storage.local.get(['golmarket_task', 'golfrock_task', 'golfland_task', 'golftop_task', 'isRegistrationRunning'], (res) => {
            const task = res?.golmarket_task || res?.golfrock_task || res?.golfland_task || res?.golftop_task;
            if (task && task.isRunning && task.items && task.items.length > 0) {
                let modeKey = 'join';
                if (task.platform === 'golftop') modeKey = 'golftop';
                else if (task.platform === 'golfland') modeKey = 'golfland';
                else if (task.platform === 'golfrock') modeKey = 'golfrock';
                else modeKey = task.isTransferMode ? 'golmarket_transfer' : 'golmarket';
                showProgressModal(task.totalCount || task.items.length, modeKey);
                const curItem = task.items[task.currentIndex];
                if (curItem) {
                    updateProgress(task.currentIndex + 1, task.totalCount || task.items.length, curItem.golf, curItem.date, curItem.time);
                }
                document.getElementById('btnHeaderStop')?.classList.add('active');
            }
        });
    } catch(e) {}
}

// 브라우저 로딩 상태에 따른 안전한 초기화 실행 (interactive / complete 즉시 실행)
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMainApp);
} else {
    initMainApp();
}

// 팝업 로드 시 툴바 아이콘 이중 보장 적용 함수 (정적 매니페스트 아이콘 기반으로 캔버스 연산 부하 제거)
async function applyToolbarIconFromPopup() {
    return;
}

// ========================================================
// 골프몬 매크로 실행 중 페이지 이동("... 주소로 이동했습니다") 시 사이드패널 이중 감시 및 자동 복구 감독기
// ========================================================
let _activeGolfmonSupervision = null;

function startGolfmonMacroSupervision(cfg) {
    _activeGolfmonSupervision = {
        active: true,
        tabId: cfg.tabId,
        macroType: cfg.macroType || 'POST_REPLACE',
        forceAllEdit: Boolean(cfg.forceAllEdit),
        allItems: Array.isArray(cfg.items) ? [...cfg.items] : [],
        completedRegIds: new Set(),
        currentIndex: 0,
        successCount: 0,
        filterType: cfg.filterType || '',
        delayPreset: cfg.delayPreset || 'safe',
        stepPreset: cfg.stepPreset || 'human',
        customMemo: cfg.customMemo || '',
        confirmMismatch: cfg.confirmMismatch !== false,
        mode: cfg.mode || 'join',
        lastActivityAt: Date.now()
    };
}

function clearGolfmonMacroSupervision() {
    _activeGolfmonSupervision = null;
}

if (typeof chrome !== 'undefined' && chrome.tabs && chrome.tabs.onUpdated) {
    chrome.tabs.onUpdated.addListener((tabId, changeInfo, tab) => {
        if (!_activeGolfmonSupervision || !_activeGolfmonSupervision.active) return;
        if (tabId !== _activeGolfmonSupervision.tabId) return;
        if (changeInfo.status !== 'complete') return;

        // 페이지가 새로 로드된 후 content_script 자체 자동복구(600~1700ms)가 먼저 작동할 시간을 주고,
        // 만약 스크립트 미주입/BFCache 등으로 멈춰 있다면 사이드패널이 직접 뒤로가기 1회 및 중단된 타임부터 재개를 지시!
        setTimeout(() => {
            if (!_activeGolfmonSupervision || !_activeGolfmonSupervision.active || tabId !== _activeGolfmonSupervision.tabId) return;

            chrome.tabs.sendMessage(tabId, { action: 'CHECK_STATUS' }, (res) => {
                if (!_activeGolfmonSupervision || !_activeGolfmonSupervision.active) return;
                const isStillRunning = !chrome.runtime.lastError && res && res.isRunning === true;
                if (isStillRunning) return;

                const sup = _activeGolfmonSupervision;
                const remaining = sup.allItems.slice(sup.currentIndex).filter(it => !it.regId || !sup.completedRegIds.has(it.regId));
                if (remaining.length === 0) {
                    clearGolfmonMacroSupervision();
                    return;
                }

                const resumeState = {
                    macroType: sup.macroType,
                    forceAllEdit: Boolean(sup.forceAllEdit),
                    remainingItems: remaining,
                    totalOverallCount: sup.allItems.length,
                    globalIndexOffset: sup.currentIndex,
                    successCount: sup.successCount,
                    delayPreset: sup.delayPreset,
                    stepPreset: sup.stepPreset,
                    filterType: sup.filterType,
                    customMemo: sup.customMemo,
                    confirmMismatch: sup.confirmMismatch,
                    mode: sup.mode,
                    needsHistoryBack: true,
                    interruptedItemLabel: `${remaining[0].golf} (${remaining[0].date} ${remaining[0].time})`
                };

                const triggerResume = () => {
                    chrome.tabs.sendMessage(tabId, {
                        action: 'FORCE_BACK_AND_RESUME',
                        isAdmin: isCurrentUserAdmin(),
                        resumeState: resumeState
                    }, () => {
                        if (chrome.runtime.lastError && chrome.scripting && chrome.scripting.executeScript) {
                            chrome.scripting.executeScript({
                                target: { tabId: tabId },
                                files: ['content_script.js']
                            }, () => {
                                setTimeout(() => {
                                    chrome.tabs.sendMessage(tabId, {
                                        action: 'FORCE_BACK_AND_RESUME',
                                        isAdmin: isCurrentUserAdmin(),
                                        resumeState: resumeState
                                    });
                                }, 300);
                            });
                        }
                    });
                };

                console.log(`🔄 [Tee82 자동복구 감독기] 골프몬 탭 페이지 이동 감지 -> 뒤로가기 후 [${sup.currentIndex + 1}/${sup.allItems.length}] ${ resumeState.interruptedItemLabel } 부터 이어서 재개합니다.`);
                triggerResume();
            });
        }, 2200);
    });
}

chrome.runtime.onMessage.addListener((msg) => {
    if (msg.type === 'ITEM_REGISTER_SUCCESS' || msg.type === 'ITEM_GOLFTOP_SUCCESS') {
        if (_activeGolfmonSupervision && msg.type === 'ITEM_REGISTER_SUCCESS') {
            _activeGolfmonSupervision.lastActivityAt = Date.now();
            _activeGolfmonSupervision.successCount++;
            if (msg.regId) _activeGolfmonSupervision.completedRegIds.add(msg.regId);
        }
        if (msg.item) recordRegisteredItem(msg.item);
        uncheckItem(msg.regId, msg.item);
        const pName = msg.platform || (msg.type === 'ITEM_GOLFTOP_SUCCESS' ? 'golftop' : 'golfmon');
        recordDailyStat(pName, '등록', msg.item?.golf || msg.item?.rawGolf, 1);
    } else if (msg.type === 'ITEM_PRICE_UPDATE_SUCCESS') {
        if (_activeGolfmonSupervision) {
            _activeGolfmonSupervision.lastActivityAt = Date.now();
            _activeGolfmonSupervision.successCount++;
            if (msg.regId) _activeGolfmonSupervision.completedRegIds.add(msg.regId);
        }
        if (msg.item) recordRegisteredItem(msg.item);
        uncheckItem(msg.regId, msg.item);
        recordDailyStat('golfmon', '수정', msg.item?.golf || msg.item?.rawGolf, 1);
    } else if (msg.type === 'ITEM_POST_REPLACE_SUCCESS') {
        if (_activeGolfmonSupervision) {
            _activeGolfmonSupervision.lastActivityAt = Date.now();
            _activeGolfmonSupervision.successCount++;
            if (msg.regId) _activeGolfmonSupervision.completedRegIds.add(msg.regId);
        }
        if (msg.item) recordRegisteredItem(msg.item);
        uncheckItem(msg.regId, msg.item);
        recordDailyStat('golfmon', '수정', msg.item?.golf || msg.item?.rawGolf, 1);
    } else if (msg.type === 'ITEM_RESET_SUCCESS') {
        if (_activeGolfmonSupervision) {
            _activeGolfmonSupervision.lastActivityAt = Date.now();
            _activeGolfmonSupervision.successCount++;
            if (msg.regId) _activeGolfmonSupervision.completedRegIds.add(msg.regId);
        }
        if (msg.item) recordRegisteredItem(msg.item);
        // ★ 선택리셋은 주기 반복 및 지속적인 끌어올리기를 위해 완료 후에도 체크 상태를 100% 그대로 유지합니다!
        // (사용자가 직접 체크를 풀거나 새로 체크할 때만 타임이 변경됩니다)
        recordDailyStat('golfmon', '선택리셋', msg.item?.golf || msg.item?.rawGolf, 1);
    } else if (msg.type === 'PRICE_UPDATE_PROGRESS') {
        if (_activeGolfmonSupervision && typeof msg.current === 'number') {
            _activeGolfmonSupervision.currentIndex = Math.max(0, msg.current - 1);
            _activeGolfmonSupervision.lastActivityAt = Date.now();
        }
        updateProgress(msg.current, msg.total, msg.golf, msg.date, msg.time, msg.fee, msg.regId, msg.rawGolf);
        document.getElementById('btnHeaderStop')?.classList.add('active');
    } else if (msg.type === 'POST_REPLACE_PROGRESS') {
        if (_activeGolfmonSupervision && typeof msg.current === 'number') {
            _activeGolfmonSupervision.currentIndex = Math.max(0, msg.current - 1);
            _activeGolfmonSupervision.lastActivityAt = Date.now();
        }
        updateProgress(msg.current, msg.total, msg.golf, msg.date, msg.time, msg.fee, msg.regId, msg.rawGolf);
        document.getElementById('btnHeaderStop')?.classList.add('active');
    } else if (msg.type === 'DATE_RESET_PROGRESS') {
        const cycleLabel = (resetRepeatTarget > 1 || resetRepeatTarget === Infinity)
            ? ` (${currentResetCycle}/${resetRepeatTarget === Infinity ? '무제한' : resetRepeatTarget}회차)`
            : '';
        const pTitle = document.getElementById('progressTitle');
        if (pTitle) pTitle.innerText = `골프몬 날짜별 전체리셋 진행 중${cycleLabel}`;
        updateProgress(msg.current, msg.total, msg.golf, msg.date, msg.time, '__RESET__', msg.regId, msg.rawGolf);
        document.getElementById('btnHeaderStop')?.classList.add('active');
    } else if (msg.type === 'POST_REPLACE_SKIPPED') {
        showToast(`[${msg.golf} ${msg.time}] ${msg.reason || '골프몬 2건 등록 제한으로 추가 등록 차단'}`);
    } else if (msg.type === 'COURSE_MAPPING_UPDATED') {
        if (msg.rawGolf && msg.golfmonName) {
            const raw = msg.rawGolf.trim();
            const gm = msg.golfmonName.trim();
            const norm = normalizeDictEntry(dictionary[raw] || {}, raw);
            norm.golfmon = gm;
            norm.name = gm;
            dictionary[raw] = norm;
            saveDictionary();
            updateDictStats();
            showToast(`📖 [${raw} -> ${gm}] 매핑사전에 저장되었습니다.`);
        }
    } else if (msg.type === 'PRICE_UPDATE_COMPLETED') {
        clearGolfmonMacroSupervision();
        const sc = typeof msg.successCount === 'number' ? msg.successCount : msg.total;
        if (sc === 0) {
            const overlay = document.getElementById('progressOverlay');
            if (overlay) overlay.style.display = 'none';
            showToast('일치하는 글을 찾지 못했거나 수정을 완료하지 못했습니다. (콘솔 및 화면 확인)');
        } else {
            finishProgress(sc);
            showToast(`총 ${sc}건 변동수정 완료!`);
        }
        checkAndUncheckCompletedFromStorage();
        document.getElementById('btnHeaderStop')?.classList.remove('active');
        try { chrome.storage.local.set({ isRegistrationRunning: false }); } catch(e) {}
    } else if (msg.type === 'POST_REPLACE_COMPLETED') {
        clearGolfmonMacroSupervision();
        const sc = typeof msg.successCount === 'number' ? msg.successCount : msg.total;
        if (sc === 0) {
            const overlay = document.getElementById('progressOverlay');
            if (overlay) overlay.style.display = 'none';
            showToast('기존 등록글을 찾지 못했거나 교체수정을 완료하지 못했습니다. (신규등록 필요)');
        } else {
            finishProgress(sc);
            showToast(`총 ${sc}건 골프몬 교체수정 완료!`);
        }
        checkAndUncheckCompletedFromStorage();
        document.getElementById('btnHeaderStop')?.classList.remove('active');
        try { chrome.storage.local.set({ isRegistrationRunning: false }); } catch(e) {}
    } else if (msg.type === 'PRICE_UPDATE_STOPPED') {
        clearGolfmonMacroSupervision();
        document.getElementById('progressOverlay').style.display = 'none';
        checkAndUncheckCompletedFromStorage();
        document.getElementById('btnHeaderStop')?.classList.remove('active');
        try { chrome.storage.local.set({ isRegistrationRunning: false }); } catch(e) {}
        showToast('변동수정이 중단되었습니다. (완료된 항목 체크 해제됨)');
    } else if (msg.type === 'POST_REPLACE_STOPPED') {
        clearGolfmonMacroSupervision();
        document.getElementById('progressOverlay').style.display = 'none';
        checkAndUncheckCompletedFromStorage();
        document.getElementById('btnHeaderStop')?.classList.remove('active');
        try { chrome.storage.local.set({ isRegistrationRunning: false }); } catch(e) {}
        showToast('교체수정이 중단되었습니다. (완료된 항목 체크 해제됨)');
    } else if (msg.type === 'DATE_RESET_COMPLETED' || msg.type === 'SELECTED_RESET_COMPLETED') {
        const isSelected = (msg.type === 'SELECTED_RESET_COMPLETED');
        const modeLabel = isSelected ? '선택리셋' : '전체리셋';
        const sc = typeof msg.successCount === 'number' ? msg.successCount : msg.total;

        finishProgress(sc);
        recordDailyStat('golfmon', isSelected ? '선택리셋' : '리셋', msg.targetDate || modeLabel, sc);
        recordLastBumpTime();
        document.getElementById('btnHeaderStop')?.classList.remove('active');
        try { chrome.storage.local.set({ isRegistrationRunning: false }); } catch(e) {}

        // 리셋 자동 반복 스케줄 등록
        if (isResetRepeatingActive && resetIntervalMinutes > 0) {
            const intervalLabel = resetIntervalMinutes >= 60 && (resetIntervalMinutes % 60 === 0)
                ? `${resetIntervalMinutes / 60}시간`
                : `${resetIntervalMinutes}분`;
            const delayMs = resetIntervalMinutes * 60 * 1000;
            scheduleNextResetRun(delayMs, resetIntervalMinutes);

            showToast(`[${modeLabel}] ${currentResetCycle}회차 완료! (${sc}건)\n${intervalLabel} 후 자동으로 다음 리셋을 실행합니다.`);
            return;
        }

        // 1회 실행 완료 (반복 없음)
        stopResetIntervalTimer(false);

        if (sc === 0 && currentResetCycle === 1) {
            const overlay = document.getElementById('progressOverlay');
            if (overlay) overlay.style.display = 'none';
            showToast(msg.reason || `골프몬에서 등록된 글을 찾지 못했거나 리셋을 완료하지 못했습니다.`);
        } else {
            const totalNotice = isSelected
                ? `[선택리셋] 총 ${sc}건 리셋(내용 유지 수정) 완료!`
                : `[${msg.targetDate || ''}] 총 ${sc}건 전체리셋(내용 유지 수정) 완료!`;
            showToast(totalNotice);
        }
    } else if (msg.type === 'DATE_RESET_STOPPED' || msg.type === 'SELECTED_RESET_STOPPED') {
        const modeLabel = (msg.type === 'SELECTED_RESET_STOPPED') ? '선택리셋' : '전체리셋';
        stopResetIntervalTimer(false);
        const overlay = document.getElementById('progressOverlay');
        if (overlay) overlay.style.display = 'none';
        document.getElementById('btnHeaderStop')?.classList.remove('active');
        try { chrome.storage.local.set({ isRegistrationRunning: false }); } catch(e) {}
        showToast(`${modeLabel}이 중단되었습니다. (${msg.successCount || 0}건 완료)`);
    } else if (msg.type === 'REGISTER_PROGRESS' || msg.type === 'GOLFMON_PROGRESS' || msg.type === 'GOLFTOP_PROGRESS' || msg.type === 'GOLMARKET_PROGRESS' || msg.type === 'GOLFROCK_PROGRESS' || msg.type === 'GOLFLAND_PROGRESS') {
        const isGolfmon = (msg.type === 'REGISTER_PROGRESS' || msg.type === 'GOLFMON_PROGRESS');
        if (isGolfmon && _activeGolfmonSupervision && typeof msg.current === 'number') {
            _activeGolfmonSupervision.currentIndex = Math.max(0, msg.current - 1);
            _activeGolfmonSupervision.lastActivityAt = Date.now();
        }
        updateProgress(msg.current, msg.total, msg.golf, msg.date, msg.time, msg.fee || '', msg.regId, msg.rawGolf);
        document.getElementById('btnHeaderStop')?.classList.add('active');
    } else if (msg.type === 'REGISTER_WAITING' || msg.type === 'GOLFMON_WAITING' || msg.type === 'GOLMARKET_WAITING' || msg.type === 'GOLFROCK_WAITING' || msg.type === 'GOLFLAND_WAITING') {
        const desc = document.getElementById('progressDesc');
        if (desc) desc.innerText = `⏳ 사람처럼 대기 중... [${msg.nextGolf}] 준비 (${msg.waitSec}초 지연)`;
        document.getElementById('btnHeaderStop')?.classList.add('active');
    } else if (msg.type === 'REGISTER_COMPLETED' || msg.type === 'GOLFMON_COMPLETED') {
        clearGolfmonMacroSupervision();
        activeConcurrentPlatforms.delete('golfmon');
        checkAndUncheckCompletedFromStorage();
        try { chrome.storage.local.set({ golfmon_isRegistrationRunning: false }); } catch(e) {}
        if (activeConcurrentPlatforms.size === 0) {
            finishProgress(msg.total);
            document.getElementById('btnHeaderStop')?.classList.remove('active');
            try { chrome.storage.local.set({ isRegistrationRunning: false }); } catch(e) {}
            showToast('골프몬 자동등록 완료!');
        } else {
            showToast('골프몬 자동등록 완료! (다른 플랫폼 계속 진행 중...)');
        }
    } else if (msg.type === 'REGISTER_STOPPED' || msg.type === 'GOLFMON_STOPPED') {
        clearGolfmonMacroSupervision();
        activeConcurrentPlatforms.delete('golfmon');
        checkAndUncheckCompletedFromStorage();
        try { chrome.storage.local.set({ golfmon_isRegistrationRunning: false }); } catch(e) {}
        if (activeConcurrentPlatforms.size === 0) {
            document.getElementById('progressOverlay').style.display = 'none';
            document.getElementById('btnHeaderStop')?.classList.remove('active');
            try { chrome.storage.local.set({ isRegistrationRunning: false }); } catch(e) {}
            showToast('골프몬 등록이 중단되었습니다. (완료된 항목 체크 해제됨)');
        } else {
            showToast('골프몬 등록이 중단되었습니다.');
        }
    } else if (msg.type === 'GOLFTOP_COMPLETED') {
        const sc = typeof msg.successCount === 'number' ? msg.successCount : msg.total;
        activeConcurrentPlatforms.delete('golftop');
        checkAndUncheckCompletedFromStorage();
        try { chrome.storage.local.set({ golftop_isRegistrationRunning: false }); } catch(e) {}
        if (activeConcurrentPlatforms.size === 0) {
            finishProgress(sc);
            document.getElementById('btnHeaderStop')?.classList.remove('active');
            try { chrome.storage.local.set({ isRegistrationRunning: false }); } catch(e) {}
            showToast(`총 ${sc}건 골프탑 홍보 등록 완료!`);
        } else {
            showToast(`골프탑 홍보 등록 완료! (다른 플랫폼 계속 진행 중...)`);
        }
    } else if (msg.type === 'GOLFTOP_STOPPED') {
        activeConcurrentPlatforms.delete('golftop');
        checkAndUncheckCompletedFromStorage();
        try { chrome.storage.local.set({ golftop_isRegistrationRunning: false }); } catch(e) {}
        if (activeConcurrentPlatforms.size === 0) {
            const overlay = document.getElementById('progressOverlay');
            if (overlay) overlay.style.display = 'none';
            document.getElementById('btnHeaderStop')?.classList.remove('active');
            try { chrome.storage.local.set({ isRegistrationRunning: false }); } catch(e) {}
            showToast(`골프탑 등록이 중단되었습니다. (${msg.successCount || 0}건 완료)`);
        } else {
            showToast('골프탑 등록이 중단되었습니다.');
        }
    } else if (msg.type === 'GOLMARKET_COMPLETED') {
        const sc = msg.total || 0;
        activeConcurrentPlatforms.delete('golmarket');
        checkAndUncheckCompletedFromStorage();
        try { chrome.storage.local.set({ golmarket_isRegistrationRunning: false }); } catch(e) {}
        if (activeConcurrentPlatforms.size === 0) {
            finishProgress(sc);
            document.getElementById('btnHeaderStop')?.classList.remove('active');
            try { chrome.storage.local.set({ isRegistrationRunning: false }); } catch(e) {}
            showToast(`총 ${sc}건 골마켓 등록 완료!`);
        } else {
            showToast(`골마켓 등록 완료! (다른 플랫폼 계속 진행 중...)`);
        }
    } else if (msg.type === 'GOLMARKET_STOPPED') {
        activeConcurrentPlatforms.delete('golmarket');
        checkAndUncheckCompletedFromStorage();
        try { chrome.storage.local.set({ golmarket_isRegistrationRunning: false }); } catch(e) {}
        if (activeConcurrentPlatforms.size === 0) {
            const overlay = document.getElementById('progressOverlay');
            if (overlay) overlay.style.display = 'none';
            document.getElementById('btnHeaderStop')?.classList.remove('active');
            try { chrome.storage.local.set({ isRegistrationRunning: false }); } catch(e) {}
            showToast('골마켓 등록이 중단되었습니다.');
        } else {
            showToast('골마켓 등록이 중단되었습니다.');
        }
    } else if (msg.type === 'GOLFROCK_COMPLETED') {
        const sc = msg.total || 0;
        activeConcurrentPlatforms.delete('golfrock');
        checkAndUncheckCompletedFromStorage();
        try { chrome.storage.local.set({ golfrock_isRegistrationRunning: false }); } catch(e) {}
        if (activeConcurrentPlatforms.size === 0) {
            finishProgress(sc);
            document.getElementById('btnHeaderStop')?.classList.remove('active');
            try { chrome.storage.local.set({ isRegistrationRunning: false }); } catch(e) {}
            showToast(`총 ${sc}건 골프락 등록 완료!`);
        } else {
            showToast(`골프락 등록 완료! (다른 플랫폼 계속 진행 중...)`);
        }
    } else if (msg.type === 'GOLFROCK_STOPPED') {
        activeConcurrentPlatforms.delete('golfrock');
        checkAndUncheckCompletedFromStorage();
        try { chrome.storage.local.set({ golfrock_isRegistrationRunning: false }); } catch(e) {}
        if (activeConcurrentPlatforms.size === 0) {
            const overlay = document.getElementById('progressOverlay');
            if (overlay) overlay.style.display = 'none';
            document.getElementById('btnHeaderStop')?.classList.remove('active');
            try { chrome.storage.local.set({ isRegistrationRunning: false }); } catch(e) {}
            showToast('골프락 등록이 중단되었습니다.');
        } else {
            showToast('골프락 등록이 중단되었습니다.');
        }
    } else if (msg.type === 'GOLFLAND_COMPLETED') {
        const sc = msg.total || 0;
        activeConcurrentPlatforms.delete('golfland');
        checkAndUncheckCompletedFromStorage();
        try { chrome.storage.local.set({ golfland_isRegistrationRunning: false }); } catch(e) {}
        if (activeConcurrentPlatforms.size === 0) {
            finishProgress(sc);
            document.getElementById('btnHeaderStop')?.classList.remove('active');
            try { chrome.storage.local.set({ isRegistrationRunning: false }); } catch(e) {}
            showToast(`총 ${sc}건 골프랜드 등록 완료!`);
        } else {
            showToast(`골프랜드 등록 완료! (다른 플랫폼 계속 진행 중...)`);
        }
    } else if (msg.type === 'GOLFLAND_STOPPED') {
        activeConcurrentPlatforms.delete('golfland');
        checkAndUncheckCompletedFromStorage();
        try { chrome.storage.local.set({ golfland_isRegistrationRunning: false }); } catch(e) {}
        if (activeConcurrentPlatforms.size === 0) {
            const overlay = document.getElementById('progressOverlay');
