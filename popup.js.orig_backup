const noCaddys = ["빅토리아", "락가든", "루이힐스", "스프링베일"];
// 3부 야간 시간대별 자동 노캐디 변환 비활성화 (원문 텍스트 기준 엄격 변환)

// 선입금은 원본 데이터의 텍스트(예: [현장17만+선입1만], [21.9만 / 1만])에서 자동으로 추출되어 공지가 변환 시 가산됩니다.

// 특정구장 가격 일괄 가감 설정 상태 및 헬퍼 함수
// 특정구장 가격 일괄 가감 설정 상태 및 헬퍼 함수
// 구조: [ { course: string, diff: number, hasPart1: boolean, hasPart2: boolean, hasPart3: boolean } ]
let customCoursePriceAdjustments = [];

function normalizeCoursePriceAdjustmentItem(item) {
    if (!item) return null;
    const course = String(item.course || '').trim();
    const diff = parseFloat(item.diff) || 0;
    if (!course || isNaN(diff) || diff === 0) return null;

    const hasP1 = item.hasPart1 ?? true;
    const hasP2 = item.hasPart2 ?? true;
    const hasP3 = item.hasPart3 ?? true;
    const all = (!hasP1 && !hasP2 && !hasP3);

    return {
        course: course,
        diff: diff,
        hasPart1: all ? true : Boolean(hasP1),
        hasPart2: all ? true : Boolean(hasP2),
        hasPart3: all ? true : Boolean(hasP3)
    };
}

function getCourseAdjPartDesc(item) {
    const p1 = item.hasPart1 !== false;
    const p2 = item.hasPart2 !== false;
    const p3 = item.hasPart3 !== false;

    if (p1 && p2 && p3) return '전부';
    if (p1 && p2 && !p3) return '1~2부';
    if (!p1 && p2 && p3) return '2~3부';
    if (p1 && !p2 && p3) return '1,3부';
    if (p1 && !p2 && !p3) return '1부';
    if (!p1 && p2 && !p3) return '2부';
    if (!p1 && !p2 && p3) return '3부';
    return '전부';
}

function formatCoursePriceRuleToText(item) {
    if (!item || !item.course) return '';
    const p1 = item.hasPart1 !== false;
    const p2 = item.hasPart2 !== false;
    const p3 = item.hasPart3 !== false;
    const all = (p1 && p2 && p3) || (!p1 && !p2 && !p3);
    const sign = item.diff > 0 ? `+${item.diff}` : `${item.diff}`;
    if (all) {
        return `${item.course} ${sign}`;
    }
    if (p1 && p2 && !p3) return `${item.course} 1~2부 ${sign}`;
    if (!p1 && p2 && p3) return `${item.course} 2~3부 ${sign}`;
    if (p1 && !p2 && p3) return `${item.course} 1,3부 ${sign}`;
    if (p1 && !p2 && !p3) return `${item.course} 1부 ${sign}`;
    if (!p1 && p2 && !p3) return `${item.course} 2부 ${sign}`;
    if (!p1 && !p2 && p3) return `${item.course} 3부 ${sign}`;
    return `${item.course} ${sign}`;
}

/**
 * 티타임 시간(문자열 또는 분)을 기준으로 부제(1부, 2부, 3부) 번호(1, 2, 3) 반환
 * - 1부: 오전 05시부터 09시대까지 (10시 이전: < 600분)
 * - 2부: 10시부터 16시대 이전까지 (600분 <= mins < 960분)
 * - 3부: 16시부터 21시대까지 (16시 이후: >= 960분)
 */
function getTimePartNumber(timeStrOrMins) {
    const mins = typeof timeStrOrMins === 'number' ? timeStrOrMins : timeToMinutes(timeStrOrMins);
    if (mins < 10 * 60) return 1;
    if (mins < 16 * 60) return 2;
    return 3;
}

function loadCoursePriceAdjustments() {
    try {
        const saved = localStorage.getItem('v2_coursePriceAdjustments');
        if (saved) {
            const parsed = JSON.parse(saved);
            if (Array.isArray(parsed)) {
                customCoursePriceAdjustments = parsed
                    .map(item => normalizeCoursePriceAdjustmentItem(item))
                    .filter(Boolean);
            }
        }
    } catch (e) {
        customCoursePriceAdjustments = [];
    }
    updateCoursePriceBadgeUI();
}

function saveCoursePriceAdjustments() {
    try {
        localStorage.setItem('v2_coursePriceAdjustments', JSON.stringify(customCoursePriceAdjustments));
    } catch (e) {}
    try {
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.set({ v2_coursePriceAdjustments: customCoursePriceAdjustments });
        }
    } catch (e) {}
    updateCoursePriceBadgeUI();
}

function updateCoursePriceBadgeUI() {
    const badge = document.getElementById('coursePriceBadge');
    const wrapper = document.getElementById('coursePriceCountWrapper');
    const modalCount = document.getElementById('coursePriceModalCountText');
    const count = customCoursePriceAdjustments.length;

    if (badge) badge.textContent = count.toString();
    if (wrapper) wrapper.style.display = count > 0 ? 'inline' : 'none';
    if (modalCount) modalCount.textContent = count.toString();
    updateCoursePriceHeaderUI();
}

// 특정구장 가격변경 적용 여부 전역 토글 (체크박스 상태: 기본 true)
let isCoursePriceRulesActive = true;

function initCoursePriceRulesActive() {
    try {
        const saved = localStorage.getItem('v2_isCoursePriceRulesActive');
        if (saved !== null) {
            isCoursePriceRulesActive = (saved === 'true');
        }
    } catch(e) {}
    const chk = document.getElementById('chkEnableCoursePriceRules');
    if (chk) chk.checked = isCoursePriceRulesActive;
    updateCoursePriceHeaderUI();
}

function updateCoursePriceHeaderUI() {
    const group = document.getElementById('coursePriceHeaderBtnGroup');
    const chk = document.getElementById('chkEnableCoursePriceRules');
    const badgeWrapper = document.getElementById('coursePriceCountWrapper');
    const isChecked = chk ? chk.checked : isCoursePriceRulesActive;

    if (group) {
        group.classList.toggle('disabled-course-price', !isChecked);
    }
    if (badgeWrapper) {
        badgeWrapper.style.color = isChecked ? '#2563EB' : '#94A3B8';
    }
}

function setCoursePriceRulesActive(active, notify = true) {
    isCoursePriceRulesActive = active;
    try {
        localStorage.setItem('v2_isCoursePriceRulesActive', active ? 'true' : 'false');
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.set({ v2_isCoursePriceRulesActive: active });
        }
    } catch(e) {}
    const chk = document.getElementById('chkEnableCoursePriceRules');
    if (chk) chk.checked = active;
    updateCoursePriceHeaderUI();
    applyAllActiveNoticeRules();
    if (notify) {
        if (active) {
            showToast('특정구장 가격변경 적용이 활성화되었습니다.');
        } else {
            showToast('특정구장 가격변경 적용이 비활성화되었습니다. (원래 금액으로 표시)');
        }
    }
}

// 특정구장 가격변경 전용 구장명 엄격/정확 매칭 함수 (클럽72 vs 클럽72(오션) 완벽 분리 + 양도 구장 괄호 표기 호환)
function isCoursePriceExactMatch(adjCourse, golfName, rawGolfName = '', golfmonGolfName = '') {
    if (!adjCourse) return false;

    // 0. 약어 사전 변환 (예: 클오 -> 클럽72(오션), 클아 -> 클럽72, 서남서 -> 떼제베(서남), 동북동 -> 떼제베(동북))
    let normAdjCourse = String(adjCourse).trim();
    if (typeof NOTICE_COURSE_SHORT_MAP !== 'undefined' && NOTICE_COURSE_SHORT_MAP[normAdjCourse]) {
        normAdjCourse = NOTICE_COURSE_SHORT_MAP[normAdjCourse];
    }

    // 비교 대상 후보 구장명들
    const targets = [golfName, rawGolfName, golfmonGolfName].filter(Boolean);
    if (targets.length === 0) return false;

    // 실제 구분이 필요한 세부 코스 목록
    const REAL_SUB_COURSES = ['오션', '하늘', '레이크', '클래식', '서남', '동북', '회원제', '대중제', '듄스', '누리', '가람', '한울', '마루', '챌린저', '챔피언'];

    // 세부 코스/괄호 태그 추출 헬퍼 (예: "클럽72(오션)" -> "오션", "떼제베(서남)" -> "서남")
    function extractSubCourseTag(name) {
        const s = String(name).trim();
        const isClub72 = /클럽\s*72|스카이\s*72/i.test(s);

        const m = s.match(/[(\[](.*?)[)\]]/);
        if (m) {
            const tag = m[1].replace(/[\s\-_]/g, '').toLowerCase();
            // 1) 홀수/퍼블릭 표기(9홀, 9홀x2, P, P9, P10 등) 및 구명칭(구.선산 등)은 서브코스가 아니므로 제외
            if (/^\d+홀?(?:[x*]\d+)?$/i.test(tag) || /^p(?:\d+(?:홀?(?:[x*]\d+)?)?)?$/i.test(tag) || /^구[\.\s]?/i.test(m[1].trim())) {
                return '';
            }
            // 2) 클럽72의 기본 코스인 (레이크/클래식), (클래식/레이크), (레이크), (클래식), (아일랜드)는 기본 '클럽72'와 동일 취급
            if (isClub72 && /^(?:레이크\/?클래식|클래식\/?레이크|레이크|클래식|레\/?클|아일랜드)$/i.test(tag)) {
                return '';
            }
            // 3) 실제 세부 코스 키워드가 포함된 경우에만 서브코스 태그로 인정 (아트밸리, 제일풍경채 등 부연설명은 제외)
            for (const sw of REAL_SUB_COURSES) {
                if (tag.includes(sw)) {
                    if (isClub72 && (sw === '레이크' || sw === '클래식')) return '';
                    return sw;
                }
            }
            return '';
        }
        // 괄호 없이 띄어쓰기로 적힌 경우 (예: "클럽72 오션" -> "오션", "떼제베 서남" -> "서남")
        for (const sw of REAL_SUB_COURSES) {
            const re = new RegExp('(?:\\s+|^)' + sw + '(?:\\s+|$|[(\\[])', 'i');
            if (re.test(s)) {
                if (isClub72 && (sw === '레이크' || sw === '클래식')) return '';
                return sw;
            }
        }
        return '';
    }

    const adjSubTag = extractSubCourseTag(normAdjCourse);

    // 구장명 정규화 헬퍼 (홀수, 퍼블릭(P), cc/gc 접미사, 공백/기호 제거)
    function normalizeCourse(name, stripSubTag = false) {
        let s = String(name).trim();
        s = s.replace(/\(?p?\d+\s*홀(?:\s*[x*]\s*\d+)?\)?|\(?p\d*\)?/gi, '');
        if (stripSubTag) {
            s = s.replace(/[(\[].*?[)\]]/g, '');
            s = s.replace(/\s+(?:오션|하늘|레이크|클래식|서남|동북|회원제|대중제|듄스|누리|가람|한울|마루|챌린저|챔피언)\b/gi, '');
        }
        s = s.replace(/(?:cc|gc|골프장|골프클럽|컨트리클럽|컨트리|c\.c|g\.c)$/gi, '');
        return s.replace(/[\s\-_()\[\]]/g, '').toLowerCase();
    }

    const adjNormFull = normalizeCourse(normAdjCourse, false);
    const adjNormBase = normalizeCourse(normAdjCourse, true);
    const adjDigits = adjNormBase.match(/\d+/g)?.join('') || '';
    const isAdjClub72 = adjNormBase.includes('클럽72') || adjNormBase.includes('스카이72');

    for (const target of targets) {
        let normTarget = String(target).trim();
        if (typeof NOTICE_COURSE_SHORT_MAP !== 'undefined' && NOTICE_COURSE_SHORT_MAP[normTarget]) {
            normTarget = NOTICE_COURSE_SHORT_MAP[normTarget];
        }

        const targetSubTag = extractSubCourseTag(normTarget);

        // ★ [핵심 1] 서브 코스(오션, 하늘, 서남 등) 일치 여부 검사
        // 1) 등록 구장명에 서브코스가 지정된 경우(예: 클럽72(오션), 떼제베(서남)) -> 대상도 반드시 동일한 서브코스여야 함!
        if (adjSubTag && (!targetSubTag || adjSubTag !== targetSubTag)) {
            continue;
        }
        // 2) 등록 구장명에 서브코스가 없는 경우:
        //    - 클럽72(기본=레이크/클래식)는 클럽72(오션), 클럽72(하늘)과 별개 구장이므로 철저히 분리!
        //    - 그 외 일반 구장(예: 등록 '떼제베' vs 양도타임 '떼제베(동북)', '떼제베(서남)')은 기본 구장명 등록 시 모든 세부코스에 적용 허용!
        if (!adjSubTag && targetSubTag && isAdjClub72) {
            continue;
        }

        const targetNormFull = normalizeCourse(normTarget, false);
        const targetNormBase = normalizeCourse(normTarget, true);
        const targetDigits = targetNormBase.match(/\d+/g)?.join('') || '';

        // ★ [핵심 2] 숫자 포함 구장(클럽72, 알펜시아700, 루트52 등) 일치 필수 검사
        if (adjDigits || targetDigits) {
            if (adjDigits !== targetDigits) continue;
        }

        // ★ [핵심 3] 서브코스 포함 풀네임 완전 일치 검사
        if (adjNormFull === targetNormFull) {
            return true;
        }

        // ★ [핵심 4] 기본 구장명 완전 일치 검사 (서브코스 조건 통과 상태)
        if (adjNormBase === targetNormBase) {
            return true;
        }
    }

    return false;
}

function getCoursePriceAdjustment(golfName, rawGolfName = '', golfmonGolfName = '', rowTime = '') {
    if (!isCoursePriceRulesActive) return 0;
    if (!customCoursePriceAdjustments || customCoursePriceAdjustments.length === 0) return 0;

    const partNum = rowTime ? getTimePartNumber(rowTime) : 0;

    const matchedAdjs = [];
    for (const adj of customCoursePriceAdjustments) {
        if (!adj.course) continue;
        // 특정구장 가격변경에서는 정확히 매칭되는 구장만 변동 (클럽72 vs 클럽72(오션) 완벽 분리)
        const matched = isCoursePriceExactMatch(adj.course, golfName, rawGolfName, golfmonGolfName);
        if (matched) {
            matchedAdjs.push(adj);
        }
    }

    if (matchedAdjs.length === 0) return 0;

    // 세부코스까지 명시한 규칙(예: 떼제베(서남))이 기본 구장명 규칙(예: 떼제베)보다 우선 적용되도록 정렬 헬퍼
    const hasExplicitSubCourse = (courseStr) => /[(\[]/.test(String(courseStr || '')) || /\s+(?:오션|하늘|서남|동북|회원제|대중제|듄스)\b/i.test(String(courseStr || ''));

    if (partNum > 0) {
        const partMatchedAdjs = matchedAdjs.filter(adj => {
            const hasP1 = adj.hasPart1 !== false;
            const hasP2 = adj.hasPart2 !== false;
            const hasP3 = adj.hasPart3 !== false;
            if (partNum === 1) return hasP1;
            if (partNum === 2) return hasP2;
            if (partNum === 3) return hasP3;
            return true;
        });

        if (partMatchedAdjs.length > 0) {
            // 1순위: 세부코스 명시 규칙 우선, 2순위: 더 구체적인(체크된 부제 개수가 적은) 규칙 우선
            partMatchedAdjs.sort((a, b) => {
                const subA = hasExplicitSubCourse(a.course) ? 0 : 1;
                const subB = hasExplicitSubCourse(b.course) ? 0 : 1;
                if (subA !== subB) return subA - subB;
                const countA = (a.hasPart1 ? 1 : 0) + (a.hasPart2 ? 1 : 0) + (a.hasPart3 ? 1 : 0);
                const countB = (b.hasPart1 ? 1 : 0) + (b.hasPart2 ? 1 : 0) + (b.hasPart3 ? 1 : 0);
                return countA - countB;
            });
            return partMatchedAdjs[0].diff;
        }
        return 0; // 해당 부제에 맞는 규칙이 지정되어 있지 않으면 가감 적용 안 함
    }

    matchedAdjs.sort((a, b) => (hasExplicitSubCourse(a.course) ? 0 : 1) - (hasExplicitSubCourse(b.course) ? 0 : 1));
    return matchedAdjs[0].diff;
}

function parseDiffValue(valStr) {
    if (!valStr) return null;
    const clean = valStr.toString().trim().replace(/만원|만/g, '').replace(/\s+/g, '');
    const val = parseFloat(clean);
    if (isNaN(val) || val === 0) return null;
    return val;
}

function parsePartsFromText(text) {
    if (!text) return null;
    let hasP1 = false, hasP2 = false, hasP3 = false;
    let hasExplicit = false;

    // 1~2부, 1-2부, 1,2부, 1+2부, 1/2부, 1부2부
    if (/1\s*[-~,+/]\s*2\s*부|1부\s*[,+/~-]?\s*2부/.test(text)) {
        hasP1 = true;
        hasP2 = true;
        hasExplicit = true;
    }
    // 2~3부, 2-3부, 2,3부, 2+3부, 2/3부
    if (/2\s*[-~,+/]\s*3\s*부|2부\s*[,+/~-]?\s*3부/.test(text)) {
        hasP2 = true;
        hasP3 = true;
        hasExplicit = true;
    }
    // 1~3부, 1-3부, 전부, 전타임, 전체 (범위 지정)
    if (/1\s*[-~]\s*3\s*부|전부|전타임|전체/.test(text)) {
        hasP1 = true;
        hasP2 = true;
        hasP3 = true;
        hasExplicit = true;
    }
    // 1,3부, 1부,3부, 1부 3부 (1부와 3부만 해당, 2부 제외)
    if (/1\s*[,+/]\s*3\s*부|1부\s*[,+/]?\s*3부/.test(text)) {
        hasP1 = true;
        hasP3 = true;
        hasExplicit = true;
    }

    if (!hasExplicit) {
        if (/1부/.test(text)) { hasP1 = true; hasExplicit = true; }
        if (/2부/.test(text)) { hasP2 = true; hasExplicit = true; }
        if (/3부/.test(text)) { hasP3 = true; hasExplicit = true; }
    } else {
        if (/3부/.test(text) && !hasP3) hasP3 = true;
        if (/1부/.test(text) && !hasP1) hasP1 = true;
        if (/2부/.test(text) && !hasP2) hasP2 = true;
    }

    return hasExplicit ? { hasPart1: hasP1, hasPart2: hasP2, hasPart3: hasP3 } : null;
}

function parseCoursePriceAdjustmentLine(line, fallbackCourse = '') {
    if (!line || !line.trim()) return null;
    const trimmed = line.trim();

    // 부제(1부, 2부, 3부) 감지
    const partsInfo = parsePartsFromText(trimmed);
    const hasPart1 = partsInfo ? partsInfo.hasPart1 : true;
    const hasPart2 = partsInfo ? partsInfo.hasPart2 : true;
    const hasPart3 = partsInfo ? partsInfo.hasPart3 : true;

    // 금액(가감) 추출 (예: -2만, -2, +1만, +1, 2)
    const diffMatch = trimmed.match(/(?:[:=,]|\s|^)\s*([+-]?\s*\d+(?:\.\d+)?)\s*(?:만|만원)?(?:\s*$|\s*[)\]])/);
    if (!diffMatch) return null;

    const diffVal = parseFloat(diffMatch[1].replace(/\s+/g, ''));
    if (isNaN(diffVal) || diffVal === 0) return null;

    // 구장명 추출
    let courseCand = trimmed
        .replace(diffMatch[0], '')
        .replace(/1\s*[-~,+/]\s*[23]\s*부|2\s*[-~,+/]\s*3\s*부|[1-3]부|전부|전타임|전체/g, '')
        .replace(/^[●■□★◆▶▷*#•\-\s]+/g, '')
        .replace(/(?:연동가|연동|할인|인하|특가|요금|단가|그린피|적용|추가|가감)/g, '');

    // 감싸는 [ ], ( ) 는 제거하되 구장명 내부 괄호(예: 클럽72(오션), 클럽72(레이크/클래식))는 온전히 보존
    courseCand = courseCand.trim();
    if ((courseCand.startsWith('[') && courseCand.endsWith(']')) ||
        (courseCand.startsWith('(') && courseCand.endsWith(')'))) {
        courseCand = courseCand.slice(1, -1).trim();
    }
    courseCand = courseCand.replace(/^[:=\-\s]+|[:=\-\s]+$/g, '').trim();

    const course = courseCand || fallbackCourse;
    if (!course) return null;

    return {
        course,
        diff: diffVal,
        hasPart1,
        hasPart2,
        hasPart3
    };
}

// 토스트 메시지
function showToast(msg) {
    const toast = document.getElementById('toast');
    if (!toast) return;
    toast.innerText = msg;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 2000);
}

// 특정 골프장 전용 등록문구 메모리 캐시 및 스마트 우선순위 반환 함수
let customCourseMemos = {}; // { [courseName]: memoText }

function resolveItemRegistrationMemo(golfName) {
    const defaultMemo = document.getElementById('golftopMemo')?.value 
                     || document.getElementById('golfrockMemo')?.value 
                     || '';
    if (!golfName || typeof golfName !== 'string') return defaultMemo;

    const cleanTarget = golfName.trim().replace(/\s+/g, '').toLowerCase();
    for (const [cName, memo] of Object.entries(customCourseMemos || {})) {
        if (!cName || !memo) continue;
        const cleanName = cName.trim().replace(/\s+/g, '').toLowerCase();
        if (cleanName === cleanTarget || cleanTarget.includes(cleanName) || cleanName.includes(cleanTarget)) {
            return memo;
        }
    }
    return defaultMemo;
}

/**
 * 골프장명을 기반으로 9대 표준 지역 추론
 */
function inferRegionFromGolfName(golfName = '') {
    if (!golfName || typeof golfName !== 'string') return '';
    const name = golfName.trim();
    if (!name) return '';

    // 경기동부 구장
    if (name.match(/해솔리아|써닝포인트|이포|양지파인|캐슬렉스|블랙스톤|루트52/i)) return '경기동부';

    // 인천경인 구장
    if (name.match(/인천경인|인천|경인|영종|강화|시흥|아세코|베르힐|솔트베이|드림파크|클럽72|유니아일랜드|인서울|더헤븐|오렌지듄스|김포비공개|골프존.*송도|베어즈베스트/i)) return '인천경인';

    // 경기북부 구장
    if (name.match(/경기북부|파주|포천|양주|동두천|가평|연천|구리|남양주|고양|일산|스마트|한림광릉|광릉|포레스트힐|리앤리|베어크리크|서원밸리|서원힐스|송추|타이거|자유로|참밸리|몽베르|일동레이크|필로스|락가든|레이크우드|샴발라|아도니스|푸른솔포천|티클라우드/i)) return '경기북부';

    // 충청 구장
    if (name.match(/충청|충남|충북|대전|세종|진천|음성|감곡|화랑|천안|아산|당진|서산|태안|보령|공주|논산|청주|충주|제천|단양|괴산|로얄링스|솔라고|대영베이스|대영힐스|플라밍고|세일|중원|임페리얼|킹스데일|속리산|떼제베|그랜드|백제|우정힐스|버디원|아름다운|골프존.*(?:진천|화랑|천안)|클럽디보은|클럽디속리산|마론뉴데이|골든베이|프린세스/i)) return '충청';

    // 강원 구장
    if (name.match(/강원|춘천|원주|강릉|홍천|횡성|벨라스톤|로드힐스|라비에벨|스프링베일|클럽모우|샤인데일|카스카디아|남춘천|라데나|더플레이어스|파가니카|휘슬링락|옥스필드|센추리21|오크밸리|오크크릭|성문안|하이원|블랙밸리|파인리즈|알펜시아|용평|버치힐|샌드파인|메이플비치|설악썬밸리|플라자설악/i)) return '강원';

    // 전라 구장
    if (name.match(/전라|전남|전북|익산|군산|전주|나주|순천|여수|목포|담양|화순|스톤비치|골프존.*순천/i)) return '전라';

    // 경상 구장
    if (name.match(/경상|경남|경북|부산|대구|울산|창원|포항|구미|경주|김천|안동|엠스클럽|클럽디거창/i)) return '경상';

    // 제주 구장
    if (name.match(/제주|서귀포|라온|엘리시안제주|블랙스톤제주|테디밸리|세인트포|핀크스/i)) return '제주';

    // 경기남부 구장 (위 구장들 제외한 나머지 경기권 구장들)
    if (name.match(/경기남부|여주|안성|이천|용인|화성|오산|평택|수원|성남|광주|양평|과천|의왕|군포|안산|안양|세라지오|아리지|사우스스프링스|소피아그린|세현|한원|지산|태광|남여주|자유|리베라|기흥|코리아|골드|골프존.*안성|안성Q|안성W|안성베네스트|360도|신안|화성상록|아시아나|은화삼|비에이비스타|뉴스프링빌|이천마이다스|웰링턴|페럼|금강|솔모로|더반|빅토리아|발리오스|한림용인|플라자용인|진양밸리|윈체스트/i)) return '경기남부';

    return '';
}

// 지역 추출 함수 (매핑사전 1순위, 9대 표준 지역 엄격 보장)
function getRegion(regionCandidate, golfName = '') {
    // 1. 전달받은 지역 후보 정규화 시도
    if (regionCandidate) {
        const std = toStandardRegion(String(regionCandidate));
        if (std && VALID_STANDARD_REGIONS.includes(std)) {
            return std;
        }
    }

    // 2. 골프장명에서 표준 지역 추론 시도
    if (golfName) {
        const inferred = inferRegionFromGolfName(String(golfName));
        if (inferred && VALID_STANDARD_REGIONS.includes(inferred)) {
            return inferred;
        }
    }

    // 3. 만약 후보 텍스트에 일부 키워드가 남아있을 경우 fallback 검사
    if (regionCandidate) {
        const reg = String(regionCandidate);
        if (reg.includes('동부')) return '경기동부';
        if (reg.includes('경인') || reg.includes('인천')) return '인천경인';
        if (reg.includes('북부') || reg.includes('북')) return '경기북부';
        if (reg.includes('남부') || reg.includes('남') || reg.includes('경기')) return '경기남부';
        if (reg.includes('충청') || reg.includes('충')) return '충청';
        if (reg.includes('강원')) return '강원';
        if (reg.includes('전라') || reg.includes('전')) return '전라';
        if (reg.includes('경상') || reg.includes('경')) return '경상';
        if (reg.includes('제주')) return '제주';
    }

    // 4. 최종 기본값은 '경기남부' (9대 표준 지역 외의 값 절대 반환 금지)
    return '경기남부';
}

function getMappedName(originalName, site = 'golfmon') {
    if (!originalName) {
        return { name: '', region: '', golfmon: '', golfpang: '', golmarket: '', golfrock: '', golfland: '', golftop: '', mapped: false };
    }
    let cleanOrig = String(originalName).trim();

    // 단축어 / 약어 사전 즉시 치환 (예: '오션' -> '클럽72(오션)', '클오' -> '클럽72(오션)', '서남' -> '떼제베(서남)' 등)
    if (typeof NOTICE_COURSE_SHORT_MAP !== 'undefined' && NOTICE_COURSE_SHORT_MAP[cleanOrig]) {
        cleanOrig = NOTICE_COURSE_SHORT_MAP[cleanOrig];
    }

    // ★ [클럽72 계열 구장명 특급 우선 매핑: 오션/하늘/레이크/클래식 완벽 분리]
    const normOrigSimple = cleanOrig.replace(/[\s\-_()\[\]\/.,]/g, '').toLowerCase();
    if (normOrigSimple.includes('클럽72') || normOrigSimple.includes('club72') || normOrigSimple === '레클' || normOrigSimple === '레이크클래식') {
        let targetKey = '클럽72(레이크/클래식)';
        if (normOrigSimple.includes('오션') || normOrigSimple.includes('ocean')) {
            targetKey = '클럽72(오션)';
        } else if (normOrigSimple.includes('하늘') || normOrigSimple.includes('haneul') || normOrigSimple.includes('sky')) {
            targetKey = '클럽72(하늘)';
        }
        if (dictionary && dictionary[targetKey]) {
            const item = normalizeDictEntry(dictionary[targetKey], targetKey);
            let siteName = item.golfmon;
            if (site === 'golmarket') siteName = item.golmarket;
            else if (site === 'golfpang') siteName = item.golfpang;
            else if (site === 'golfrock') siteName = item.golfrock || GOLFROCK_OFFICIAL_NAMES[targetKey] || targetKey;
            else if (site === 'golfland') siteName = item.golfland;
            else if (site === 'golftop') siteName = item.golftop;
            return {
                name: siteName || item.name || targetKey,
                region: item.region || '인천경인',
                golfmon: item.golfmon || targetKey,
                golfpang: item.golfpang || targetKey,
                golmarket: item.golmarket || (targetKey === '클럽72(레이크/클래식)' ? '클럽72(클래식/레이크)' : targetKey),
                golfrock: item.golfrock || '클럽72',
                golfland: item.golfland || '클럽72',
                golftop: item.golftop || '클럽72',
                mapped: true
            };
        }
    }

    // ★ [떼제베 계열 구장명 특급 우선 매핑: 서남 vs 동북 완벽 분리]
    if (normOrigSimple.includes('떼제베') || normOrigSimple.includes('서남') || normOrigSimple.includes('동북') || normOrigSimple.includes('누리가람') || normOrigSimple.includes('한울마루')) {
        let tjKey = null;
        if (normOrigSimple.includes('서남') || normOrigSimple.includes('누리') || normOrigSimple.includes('가람')) {
            tjKey = '떼제베(서남)';
        } else if (normOrigSimple.includes('동북') || normOrigSimple.includes('한울') || normOrigSimple.includes('마루')) {
            tjKey = '떼제베(동북)';
        }
        if (tjKey) {
            return {
                name: tjKey,
                region: '충청',
                golfmon: tjKey,
                golfpang: '떼제베',
                golmarket: tjKey,
                golfrock: tjKey,
                golfland: tjKey,
                golftop: tjKey,
                mapped: true
            };
        }
    }

    // 1. 완전 일치 (Exact Match)
    let matchedKey = null;
    if (dictionary && dictionary[cleanOrig]) {
        matchedKey = cleanOrig;
    }

    // 2. 공백/특수문자/괄호 제거 정규화 일치
    if (!matchedKey && dictionary && typeof dictionary === 'object') {
        const normOrig = cleanOrig.replace(/[\s\-_()\[\]\/.,]/g, '').toLowerCase();
        const noParenOrig = cleanOrig.replace(/\(.*?\)|\[.*?\]/g, '').replace(/[\s\-_]/g, '').toLowerCase();
        const noParenNoCcOrig = noParenOrig.replace(/(?:cc|gc|골프클럽|골프장)$/i, '');
        const origCourseTokens = (cleanOrig.match(/\((.*?)\)/)?.[1] || '').split(/[\/.,+~_|\s]+/).map(s => s.trim().toLowerCase()).filter(Boolean);

        // 2-1. 공백 및 특수기호(/, ., 등) 제거 후 완전 일치
        for (const k of Object.keys(dictionary)) {
            const normK = k.replace(/[\s\-_()\[\]\/.,]/g, '').toLowerCase();
            if (normK === normOrig) {
                matchedKey = k;
                break;
            }
        }

        // 2-1-b. 동일 구장 내 코스 세부 일치 (예: '떼제베(한울)' -> '떼제베(한울/마루)', '클럽72(하늘)' -> '클럽72(하늘/원더)')
        if (!matchedKey && normOrig.length >= 3) {
            for (const k of Object.keys(dictionary)) {
                const normK = k.replace(/[\s\-_()\[\]\/.,]/g, '').toLowerCase();
                const noParenNoCcK = k.replace(/\(.*?\)|\[.*?\]/g, '').replace(/[\s\-_]/g, '').replace(/(?:cc|gc|골프클럽|골프장)$/i, '').toLowerCase();
                if (noParenNoCcK && noParenNoCcOrig && (noParenNoCcK === noParenNoCcOrig || noParenNoCcK.startsWith(noParenNoCcOrig) || noParenNoCcOrig.startsWith(noParenNoCcK))) {
                    if (normK.includes(normOrig) || normOrig.includes(normK)) {
                        matchedKey = k;
                        break;
                    }
                }
            }
        }

        // 2-2. 괄호 및 cc 제거 후 일치 (예: '알펜시아700' <=> '알펜시아700(대관령)', '남양주cc' <=> '남양주(9홀)')
        // 단, 원문에 명시적인 세부 코스가 있는 경우 다른 세부 코스(예: '한울/마루' vs '누리/가람')로 오매칭되는 것 절대 방지!
        if (!matchedKey) {
            for (const k of Object.keys(dictionary)) {
                // 서브코스(오션, 하늘 등) 불일치 가드
                const normK = k.replace(/[\s\-_()\[\]\/.,]/g, '').toLowerCase();
                if (!normOrig.includes('오션') && normK.includes('오션')) continue;
                if (!normOrig.includes('하늘') && normK.includes('하늘')) continue;
                if (normOrig.includes('오션') && !normK.includes('오션')) continue;
                if (normOrig.includes('하늘') && !normK.includes('하늘')) continue;

                const kCourseTokens = (k.match(/\((.*?)\)/)?.[1] || '').split(/[\/.,+~_|\s]+/).map(s => s.trim().toLowerCase()).filter(Boolean);
                if (origCourseTokens.length > 0 && kCourseTokens.length > 0) {
                    const hasCommon = origCourseTokens.some(ot => kCourseTokens.some(kt => kt.includes(ot) || ot.includes(kt)));
                    if (!hasCommon) continue; // 서로 다른 세부 코스는 매칭 제외!
                }
                const noParenK = k.replace(/\(.*?\)|\[.*?\]/g, '').replace(/[\s\-_]/g, '').toLowerCase();
                const noParenNoCcK = noParenK.replace(/(?:cc|gc|골프클럽|골프장)$/i, '');
                // 숫자 포함 구장(알펜시아700, 클럽72 등) 숫자 불일치 가드
                const kDigits2 = (noParenNoCcK.match(/\d+/g) || []).join('');
                const origDigits2 = (noParenNoCcOrig.match(/\d+/g) || []).join('');
                if ((kDigits2 || origDigits2) && kDigits2 !== origDigits2) continue;

                if (noParenNoCcK && noParenNoCcOrig && (noParenNoCcK === noParenNoCcOrig || noParenK === noParenOrig)) {
                    matchedKey = k;
                    break;
                }
            }
        }

        // 2-3. 전방 일치 또는 포함 일치 (예: '클럽72' in '클럽72(하늘/원더/바다/클래식)', '엠스클럽 의성' in '엠스클럽의성')
        if (!matchedKey && noParenNoCcOrig.length >= 2) {
            for (const k of Object.keys(dictionary)) {
                // 서브코스(오션, 하늘 등) 불일치 가드
                const normK = k.replace(/[\s\-_()\[\]\/.,]/g, '').toLowerCase();
                if (!normOrig.includes('오션') && normK.includes('오션')) continue;
                if (!normOrig.includes('하늘') && normK.includes('하늘')) continue;
                if (normOrig.includes('오션') && !normK.includes('오션')) continue;
                if (normOrig.includes('하늘') && !normK.includes('하늘')) continue;

                const kCourseTokens = (k.match(/\((.*?)\)/)?.[1] || '').split(/[\/.,+~_|\s]+/).map(s => s.trim().toLowerCase()).filter(Boolean);
                if (origCourseTokens.length > 0 && kCourseTokens.length > 0) {
                    const hasCommon = origCourseTokens.some(ot => kCourseTokens.some(kt => kt.includes(ot) || ot.includes(kt)));
                    if (!hasCommon) continue;
                }
                const noParenNoCcK = k.replace(/\(.*?\)|\[.*?\]/g, '').replace(/[\s\-_]/g, '').replace(/(?:cc|gc|골프클럽|골프장)$/i, '').toLowerCase();
                // 숫자 포함 구장(알펜시아700, 클럽72 등) 숫자 불일치 가드
                const kDigits3 = (noParenNoCcK.match(/\d+/g) || []).join('');
                const origDigits3 = (noParenNoCcOrig.match(/\d+/g) || []).join('');
                if ((kDigits3 || origDigits3) && kDigits3 !== origDigits3) continue;

                if (noParenNoCcK && (noParenNoCcK.startsWith(noParenNoCcOrig) || noParenNoCcOrig.startsWith(noParenNoCcK) || noParenNoCcK.includes(noParenNoCcOrig) || noParenNoCcOrig.includes(noParenNoCcK))) {
                    matchedKey = k;
                    break;
                }
            }
        }
    }

    if (matchedKey && dictionary[matchedKey]) {
        const item = normalizeDictEntry(dictionary[matchedKey], matchedKey);
        let siteName = item.golfmon;
        if (site === 'golmarket') siteName = item.golmarket;
        else if (site === 'golfpang') siteName = item.golfpang;
        else if (site === 'golfrock') siteName = item.golfrock || GOLFROCK_OFFICIAL_NAMES[matchedKey] || GOLFROCK_OFFICIAL_NAMES[cleanOrig] || cleanOrig;
        else if (site === 'golfland') siteName = item.golfland;
        else if (site === 'golftop') siteName = item.golftop;

        const effectiveRegion = (site === 'golfrock')
            ? (item.golfrockRegion || GOLFROCK_REGIONS[matchedKey] || GOLFROCK_REGIONS[cleanOrig] || GOLFROCK_REGIONS[item.golfrock] || (item.region ? toGolfrockRegion(item.region) : ''))
            : item.region;

        return {
            name: siteName || item.name || cleanOrig,
            region: effectiveRegion || '',
            golfrockRegion: item.golfrockRegion || GOLFROCK_REGIONS[matchedKey] || GOLFROCK_REGIONS[cleanOrig] || '',
            golfmon: item.golfmon || cleanOrig,
            golfpang: item.golfpang || cleanOrig,
            golmarket: item.golmarket || getGolmarketGolfName(cleanOrig) || cleanOrig,
            golfrock: item.golfrock || GOLFROCK_OFFICIAL_NAMES[matchedKey] || GOLFROCK_OFFICIAL_NAMES[cleanOrig] || cleanOrig,
            golfland: item.golfland || cleanOrig,
            golftop: item.golftop || cleanOrig,
            mapped: true
        };
    }

    const defGolmarket = getGolmarketGolfName(cleanOrig) || cleanOrig;
    const defGolfrock = GOLFROCK_OFFICIAL_NAMES[cleanOrig] || cleanOrig;
    const defRockReg = GOLFROCK_REGIONS[cleanOrig] || GOLFROCK_REGIONS[defGolfrock] || '';
    let siteName = cleanOrig;
    if (site === 'golmarket') siteName = defGolmarket;
    else if (site === 'golfrock') siteName = defGolfrock;
    else if (site === 'golftop') siteName = cleanOrig;
    return {
        name: siteName,
        region: site === 'golfrock' ? defRockReg : '',
        golfrockRegion: defRockReg,
        golfmon: cleanOrig,
        golfpang: cleanOrig,
        golmarket: defGolmarket,
        golfrock: defGolfrock,
        golfland: cleanOrig,
        golftop: cleanOrig,
        mapped: false
    };
}

// 🔄 중단 후 새 타임 추가 시 미체크 삭제 및 상단 우선 이어붙이기 옵션 활성 여부
function isSmartPrependActive() {
    const saved = localStorage.getItem('v2_smartPrependOnPaste');
    if (saved === null || saved === undefined) return true; // 기본값: 활성(true)
    return saved === 'true';
}

// 선택 항목 카운트 및 AdGuard 스타일 히어로 갱신
function updateSelectedBadge() {
    const trs = Array.from(document.querySelectorAll('#dataTable tbody tr'));
    const selectedTrs = trs.filter(tr => tr.classList.contains('selected'));
    const totalCount = trs.length;
    const selCount = selectedTrs.length;
    
    const badge = document.getElementById('selectedCountBadge');
    if (badge) badge.innerText = `${selCount}건`;

    const heroSel = document.getElementById('heroSelectedCount');
    const heroStatus = document.getElementById('heroStatusText');
    const heroTotal = document.getElementById('heroTotalCountText');
    const tabCount = document.getElementById('tabCount');

    if (heroSel) heroSel.innerText = selCount;
    if (heroStatus) {
        if (totalCount === 0) {
            heroStatus.innerHTML = `대기 중: <span class="count-num">0</span>개`;
        } else {
            heroStatus.innerHTML = `선택: <span class="count-num">${selCount}</span>개`;
        }
    }
    if (heroTotal) {
        if (totalCount === 0) {
            heroTotal.innerText = '';
            heroTotal.style.display = 'none';
        } else {
            const selTransfers = selectedTrs.filter(tr => tr.dataset.roomType === '양도').length;
            const selJoins = selCount - selTransfers;
            if (selTransfers > 0 && selJoins > 0) {
                heroTotal.innerText = `총 ${totalCount}개 중 ${selCount}개 선택 (조인 ${selJoins}, 양도 ${selTransfers})`;
            } else {
                heroTotal.innerText = `총 ${totalCount}개 중 ${selCount}개 선택됨`;
            }
            heroTotal.style.display = '';
        }
    }
    if (tabCount) tabCount.innerText = totalCount;

    // 전체선택 / 전체해제 마스터 체크박스 동기화
    const chkSelectAll = document.getElementById('chkSelectAll');
    const textCheckAll = document.getElementById('textCheckAll');
    if (chkSelectAll) {
        chkSelectAll.checked = (totalCount > 0 && selCount === totalCount);
        chkSelectAll.indeterminate = (selCount > 0 && selCount < totalCount);
    }
    if (textCheckAll) {
        textCheckAll.innerText = (selCount === totalCount && totalCount > 0) ? '전체해제' : '전체선택';
    }

    // 인하건 개수 및 가격수정 버튼 카운트 업데이트
    const priceDroppedTrs = trs.filter(tr => tr.dataset.isPriceDropped === 'true');
    const priceDropCount = priceDroppedTrs.length;

    const badgePriceDropCount = document.getElementById('badgePriceDropCount');
    if (badgePriceDropCount) {
        badgePriceDropCount.textContent = priceDropCount;
    }

    const priceEditCount = document.getElementById('priceEditCount');
    if (priceEditCount) {
        let activePriceTrs = selCount > 0 ? selectedTrs : priceDroppedTrs;
        priceEditCount.textContent = activePriceTrs.length;
    }

    const replaceEditCount = document.getElementById('replaceEditCount');
    if (replaceEditCount) {
        let activeReplaceTrs = selectedTrs;
        replaceEditCount.textContent = activeReplaceTrs.length;
    }

    // 중단 후 이어붙이기 알림 스트립 UI 동기화
    const stripResume = document.getElementById('stripResumeNotice');
    const spanResumeCount = document.getElementById('spanResumeCheckedCount');
    if (stripResume && spanResumeCount) {
        if (selCount > 0 && isSmartPrependActive()) {
            stripResume.style.display = 'flex';
            spanResumeCount.textContent = selCount;
        } else {
            stripResume.style.display = 'none';
        }
    }

    // 선티 일괄 토글 체크박스 및 텍스트 상태 동기화
    const chkBatchSeontiAll = document.getElementById('chkBatchSeontiAll');
    const textBatchSeonti = document.getElementById('textBatchSeonti');
    const btnBatchToggleSeonti = document.getElementById('btnBatchToggleSeonti');
    if (chkBatchSeontiAll) {
        const seontiTrs = trs.filter(tr => (
            tr.dataset.isSeontiOrDaegi === 'true' ||
            (tr.dataset.roomType || '').includes('선티') ||
            tr.dataset.manualSeonti === 'true'
        ));
        const seontiCount = seontiTrs.length;
        const allSeonti = (totalCount > 0 && seontiCount === totalCount);
        const someSeonti = (seontiCount > 0 && seontiCount < totalCount);

        chkBatchSeontiAll.checked = allSeonti;
        chkBatchSeontiAll.indeterminate = someSeonti;

        if (btnBatchToggleSeonti) {
            btnBatchToggleSeonti.classList.toggle('active', allSeonti);
        }
        if (textBatchSeonti) {
            textBatchSeonti.textContent = (allSeonti && totalCount > 0) ? '선티 전체해제' : '선택 선티지정';
        }
    }

    // 골마켓 등록 버튼 라벨 동적 갱신 (조인 vs 양도 vs 혼합)
    const btnGolfmarket = document.getElementById('btnRegisterToGolfmarket');
    if (btnGolfmarket) {
        const hasTransfer = selectedTrs.some(tr => tr.dataset.roomType === '양도');
        const hasJoin = selectedTrs.some(tr => tr.dataset.roomType !== '양도');
        const spanEl = btnGolfmarket.querySelector('span');
        if (spanEl) {
            let gmLabel = '골마켓 자동등록';
            if (totalCount > 0) {
                if (hasTransfer && hasJoin) gmLabel = '골마켓 조인·양도등록';
                else if (hasTransfer) gmLabel = '골마켓 부킹등록';
                else gmLabel = '골마켓 조인등록';
            }
            spanEl.innerText = gmLabel;
        }
    }

    // 골프락 등록 버튼 라벨 동적 갱신 (조인 vs 양도 vs 혼합)
    const btnGolfrock = document.getElementById('btnRegisterToGolfrock');
    if (btnGolfrock) {
        const hasTransfer = selectedTrs.some(tr => tr.dataset.roomType === '양도');
        const hasJoin = selectedTrs.some(tr => tr.dataset.roomType !== '양도');
        const spanEl = btnGolfrock.querySelector('span');
        if (spanEl) {
            let grLabel = '골프락 자동등록';
            if (totalCount > 0) {
                if (hasTransfer && hasJoin) grLabel = '골프락 조인·양도등록';
                else if (hasTransfer) grLabel = '골프락 양도등록';
                else grLabel = '골프락 조인등록';
            }
            spanEl.innerText = grLabel;
        }
    }

    // 골프탑 등록 버튼 라벨 동적 갱신
    const btnGolftop = document.getElementById('btnRegisterToGolftop');
    if (btnGolftop) {
        const spanEl = btnGolftop.querySelector('span');
        if (spanEl) {
            spanEl.innerText = totalCount === 0 ? '골프탑 자동등록' : `골프탑 자동등록 (${selCount}건)`;
        }
    }

    // 골프랜드 등록 버튼 라벨 동적 갱신 (조인 vs 양도 vs 혼합)
    const btnGolfland = document.getElementById('btnRegisterToGolfland');
    if (btnGolfland) {
        const hasTransfer = selectedTrs.some(tr => tr.dataset.roomType === '양도');
        const hasJoin = selectedTrs.some(tr => tr.dataset.roomType !== '양도');
        const spanEl = btnGolfland.querySelector('span');
        if (spanEl) {
            let gldLabel = totalCount === 0 ? '골프랜드 자동등록' : `골프랜드 자동등록 (${selCount}건)`;
            if (totalCount > 0) {
                if (hasTransfer && hasJoin) gldLabel = `골프랜드 조인·양도등록 (${selCount}건)`;
                else if (hasTransfer) gldLabel = `골프랜드 양도등록 (${selCount}건)`;
                else gldLabel = `골프랜드 조인등록 (${selCount}건)`;
            }
            spanEl.innerText = gldLabel;
        }
    }
}

// 전체체크 / 전체해제 토글 함수
function handleToggleSelectAll() {
    const trs = Array.from(document.querySelectorAll('#dataTable tbody tr'));
    if (trs.length === 0) {
        showToast('선택할 티타임이 없습니다.');
        return;
    }
    const selectedCount = document.querySelectorAll('#dataTable tbody tr.selected').length;
    // 1개라도 선택되어 있으면 전체 해제, 모두 해제되어 있으면 전체 선택
    const targetState = (selectedCount === 0);

    trs.forEach(tr => {
        tr.classList.toggle('selected', targetState);
    });

    syncCardsSelection();
    updateSelectedBadge();
    saveCurrentTableState();

    if (targetState) {
        showToast(`전체 ${trs.length}건이 선택되었습니다.`);
    } else {
        showToast('전체 선택이 해제되었습니다.');
    }
}

// ==========================================
// 비-골프 라인 및 비-그린피 식음/이벤트 공지 필터링 함수군
// ==========================================

// HTML 속성 인젝션 방지 및 특수문자 안전 인코딩
function escapeAttr(str) {
    if (!str) return '';
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
}

// 매핑사전에 잘못 등록된 비정상/쓰레기 키 판별 함수 (-, ■, (공지), 【2부】, 13:35분 등)
function isJunkDictKey(key) {
    if (!key || typeof key !== 'string') return true;
    const s = key.trim();
    if (!s) return true;
    // 1. 단일 특수기호 또는 기호만으로 이루어진 경우 (예: "-", "■", "□", "★", "●", "◆", "▶", "·", "#")
    if (/^[-*•·■□▲▼▶▷★●◆#※~_=:;\/\\|+.,!?@^&`'"()[\]{}]+$/.test(s)) return true;
    // 2. 시간 형식만 있는 경우 (예: "13:35분", "13:35", "07:00")
    if (/^\d{1,2}:\d{2}(?:분)?$/.test(s)) return true;
    // 3. 단독 공지/안내/부제 태그 (예: "(공지)", "[공지]", "【2부】", "【1부】", "[3부]")
    if (/^[(\[【{<](?:공지|안내|필독|알림|전체|1부|2부|3부|주중|주말)[)\]】}>]$/i.test(s)) return true;
    // 4. 일반적인 비-골프 안내 라인
    if (isNonGolfLine(s)) return true;
    return false;
}

// 골프 티타임 데이터가 아닌 공지/이벤트/인사말/식음 안내 라인 판별
function isNonGolfLine(line) {
    if (!line || typeof line !== 'string') return false;
    const s = line.trim();
    if (!s) return false;

    // 0. 단일 특수기호 또는 기호만으로 이루어진 경우 (예: "-", "■", "□", "★", "●", "◆", "▶", "·", "#", "♣", "♧", "♥", "♡", "♠", "♤")
    if (/^[-*•·■□▲▼▶▷★☆●○◆◇◈▣♣♧♥♡♠♤#※~_=:;\/\\|+.,!?@^&`'"()[\]{}]+$/.test(s)) {
        return true;
    }

    // 0-1. 단독 공지/안내/부제 괄호 태그 (예: "(공지)", "[공지]", "【2부】", "【1부】", "[3부]" 등)
    if (/^[(\[【{<](?:공지|안내|필독|알림|전체|1부|2부|3부|주중|주말)[)\]】}>]$/i.test(s)) {
        return true;
    }

    // 0-2. 시간만 단독으로 있는 경우 (예: "13:35분", "13:35")
    if (/^\d{1,2}:\d{2}(?:분)?$/.test(s)) {
        return true;
    }

    // 0-3. 구장명 + 지역 대괄호 패턴이 포함된 라인(예: "-신안(회원제) [경기 안성]", "-그린힐 [경기 광주]")은 절대 비-골프 라인이 아님
    if (/\[(?:경기|강원|충청|경상|전라|제주|인천|서울|동부|서부|남부|북부|충북|충남|경북|경남|전북|전남|[가-힣]{2,4}\s*[가-힣]{2,4})\s*\]/i.test(s)) {
        return false;
    }

    // 0-4. 기호 및 대괄호를 제거한 텍스트가 매핑사전, 단축어사전 또는 공인 구장명인 경우 무조건 비-골프 라인이 아님 (예: "신안(회원제)", "신안", "오션")
    const candCourse = s.replace(/\[.*?\]/g, '').replace(/^[-*•·■□▲▼▶▷★☆●○◆◇◈▣♣♧♥♡♠♤#※~_=:;\/\\|+.,!?@^&`'"()[\]{}<>\s]+/g, '').replace(/[-*•·■□▲▼▶▷★☆●○◆◇◈▣♣♧♥♡♠♤#※~_=:;\/\\|+.,!?@^&`'"()[\]{}<>\s]+$/g, '').trim();
    if (candCourse && typeof NOTICE_COURSE_SHORT_MAP !== 'undefined' && NOTICE_COURSE_SHORT_MAP[candCourse]) {
        return false;
    }
    if (candCourse && (typeof isRecognizedGolfCourse === 'function' && isRecognizedGolfCourse(candCourse))) {
        return false;
    }
    if (candCourse && typeof dictionary !== 'undefined' && dictionary && (dictionary[candCourse] || dictionary[candCourse.replace(/[\s\-_()\[\]]/g, '')])) {
        return false;
    }

    // 1. 단독 요일/시간대 단어 (주중, 주말, 평일, 공휴일 등은 구장명이 아님)
    if (/^(?:주중|주말|평일|공휴일)$/i.test(s)) {
        return true;
    }

    // 2. 인사말 및 알림/종결 표현
    if (/^(?:안녕|반갑|감사|수고|좋은\s*하루|공지|안내|필독|알림|전달)/i.test(s) || 
        /(?:안녕하세요|안녕하십니까|반갑습니다|감사합니다|수고하세요|부탁드립니다|진행합니다|안내드립니다|환영합니다|바랍니다)[!~.]*$/i.test(s)) {
        return true;
    }

    // 3. 이벤트 / 식음 / 패키지 안내 문구 (단, 식사포함/조식제공 등 공지 조건이나 별도공지 등은 제외하지 않음)
    if (/(?:식사\s*포함|조식\s*포함|중식\s*포함|석식\s*포함|식사\s*제공|조식\s*제공|식음\s*제공|모닝식사|식포\b)/i.test(s) && !/(?:식사\s*불가|식사\s*미포함|식사\s*별도)/i.test(s)) {
        return false;
    }
    if (/(?:별도\s*공지|추후\s*공지|별도\s*안내|상시\s*적용)/i.test(s)) {
        return false;
    }
    if (/(?:브런치\s*박스|모닝\s*박스|브런치|모닝박스|샌드위치|베이커리|토스트|커피\s*리필|음료\s*제공|사은품|경품|기념품)/i.test(s)) {
        return true;
    }

    // 4. 안내 조건 / 주의사항 / 비고 라인 (※, *, #, •, · 등으로 시작하거나 특수 안내 문구)
    if (/^[※*#•·\-]/.test(s)) {
        if (/내장|티업|한정|필수|별도|중복|변경|제외|적용|우천|기예약|비고|회원(?!제)|비회원|운영|카트피|캐디피|그린피|메뉴|구성/i.test(s)) {
            return true;
        }
    }

    // 5. 이벤트 패키지 가격 / 구성 라인 (예: "그린피 + 브런치 박스", "브런치박스 구성 : 샌드위치 + 커피", "1인 150,000원")
    if (/그린피\s*\+\s*/i.test(s) || /구성\s*:\s*/i.test(s) || /^1인\s*([0-9.,]+)\s*(?:만|만원|원)?$/i.test(s)) {
        return true;
    }

    // 6. 날짜 기간 범위 (예: "10/26(월)~10/29(목)", "10/18 ~ 10/22", "기간: 10/18 ~ 10/22") - 단일 티타임 날짜가 아닌 기간
    if (/(\d{1,2})[./\-](\d{1,2}).*?[~-].*?(\d{1,2})[./\-](\d{1,2})/.test(s)) {
        return true;
    }

    // 7. 티업 조건 문구 (예: "주중 07:30 이전 티업 고객", "07:30 이전 내장객", "07:30 이전 티업")
    if (/\d{1,2}:\d{2}\s*(?:이전|이후|경|쯤|대)\s*(?:티업|내장|고객|예약)/i.test(s) || 
        /(?:티업\s*고객|내장객\s*한정|내장\s*필수|이벤트\s*중복)/i.test(s)) {
        return true;
    }

    // 8. 코스 컨디션 / 잔디 상태 / 그린 스피드 안내 문구 (예: "코스 컨디션 최상", "그린피 스피드 3,2 이상")
    if (/(?:코스\s*컨디션|그린\s*컨디션|컨디션\s*최상|그린피?\s*스피드|스피드\s*[\d,.]+|잔디\s*상태|코스\s*상태)/i.test(s)) {
        return true;
    }

    // 9. 홍보 / 모객 / 현장가 가산 안내 문구 (예: "▶ 골프몬 현장가 +1만(선입별도)", "빠른 모객 부탁드립니다", "현장가 +1만")
    if (/(?:골프몬\s*현장가|현장가\s*\+|선입\s*별도|빠른\s*모객|모객\s*부탁|모객|예약\s*부탁)/i.test(s)) {
        return true;
    }

    return false;
}

// 그린피와 무관한 식음/브런치/모닝박스/이벤트 공지인지 판별 (식사포함 공지는 정상 파싱 허용)
function isNonGreenFeeEventNotice(text) {
    if (!text || typeof text !== 'string') return false;

    // ★ [사용자 핵심 기능]: 특정 기간 또는 별도 공지시까지 "식사포함 / 조식포함 / 식사제공" 공지 허용!
    const isExplicitMealNotice = /(?:식사\s*포함|조식\s*포함|중식\s*포함|석식\s*포함|식사\s*제공|조식\s*제공|식음\s*제공|모닝박스\s*(?:포함|제공)?|모닝식사|식포\b)/i.test(text);
    if (isExplicitMealNotice && !/(?:식사\s*불가|식사\s*미포함|식사\s*별도)/i.test(text)) {
        return false; // 유효한 식사포함 공지이므로 제외하지 않고 정상 파싱 허용!
    }

    // ★ [매우 중요]: 시간대별 그린피 요금(예: 6시대 8만, 11시~12시대 12만, 1부(식사제공) 등)이 포함되어 있다면
    // 식사/이벤트 단어가 있더라도 절대 제외하지 않고 정상 그린피 공지로 파싱!
    if (/(?:\d{1,2}\s*시대?|\d{1,2}:\d{2}|\b[123]부\b).{0,25}\d+(?:\.\d+)?\s*만(?:원)?/i.test(text)) {
        return false;
    }

    // 1. 식음 / 식사 / 음료 / 패키지 / 기념품 / 이벤트 관련 대표 키워드
    const eventMealKeywords = /(?:브런치|모닝박스|샌드위치|베이커리|토스트|조식|식음|식사|중식|석식|커피\s*리필|커피\s*(?:제공|증정|무료)|음료\s*(?:제공|증정|무료)|생맥주|안주|치킨|피자|레스토랑|그늘집|사은품|경품|기념품|선물\s*증정|골프공\s*증정|볼\s*증정|홀인원\s*이벤트|모닝박스\s*이벤트|식음\s*이벤트|패키지\s*이벤트|이벤트\s*진행)/i;

    if (!eventMealKeywords.test(text)) return false;

    // 2. 실제 그린피 할인/인하(시간대별/기간별 할인)가 명시되어 있는지 확인
    const hasRealGreenFeeCut = /(?:금액\s*인하|부분선결제\s*금액\s*인하|추가\s*\d+만?\s*할인|\d+만\s*(?:원)?\s*(?:추가\s*)?할인|\d+만\s*DC|\b\d{1,2}:\d{2}\s*(?:~|-)\s*\d{1,2}:\d{2}\s*[-:=])/i.test(text);

    // 실제 그린피 인하/할인 규정이 없는 순수 식음/이벤트/패키지 공지인 경우 제외
    if (!hasRealGreenFeeCut) {
        return true;
    }

    // 만약 "그린피 + 브런치" 형태의 단순 패키지 가격 제시이고, 실제 할인(인하/DC) 단어가 없는 경우
    if (/그린피\s*\+\s*(?:브런치|식사|조식|모닝박스)/i.test(text) && !/할인|인하|DC/i.test(text)) {
        return true;
    }

    return false;
}

// ==========================================
// 구장 공지 금액 자동 조정 관련 함수군
// ==========================================

// 구장명이 될 수 없는 부제, 마감, 날짜, 요일, 일반 명사 필터
function isNonCourseWord(word) {
    if (!word || typeof word !== 'string') return true;
    const s = word.replace(/[\[\]\(\)\*#※■□▣◆◇▲▼▶▷◀◁●○★☆【】<>~_=\-]/g, '').trim();
    if (!s) return true;

    // 1. 부제 관련 (1부, 2부, 3부, 4부, 전부, 전타임, 1부제, 2부제, 3부제, 1부타임 등)
    if (/^[1-4]부(?:제|타임)?$/i.test(s) || /^(?:전부|전타임|야간|주간|새벽|오전|오후|주중|주말|평일|공휴일)$/i.test(s) || /[1-4]부/i.test(s)) {
        return true;
    }

    // 2. 당일 / 마감 / 종료 / 임박 / 특가 관련 (예: "당일3부 마감", "당일마감", "특가")
    if (/^(?:당일|마감|종료|완료|임박|특가|특가요금|할인|인하|잔여|잔여타임|잔여마감|당일마감)$/i.test(s) ||
        /당일\s*[1-4]부/i.test(s) || /.*마감$/i.test(s) || /(?:마감|종료|특가)/i.test(s)) {
        return true;
    }

    // 3. 날짜 및 요일 패턴 (예: "22화", "22(화)", "22일", "10/18", "10.18", "18일", "월요일", "화", "수")
    if (/^\d{1,2}\s*(?:일|일자)?\s*(?:\([가-힣\w]+\)|[월화수목금토일])?$/i.test(s) ||
        /^\d{1,2}\s*[./\-]\s*\d{1,2}/.test(s) ||
        /^\d{1,2}\s*[월화수목금토일]$/i.test(s) ||
        /^(?:월|화|수|목|금|토|일)(?:요일)?$/i.test(s)) {
        return true;
    }

    // 4. 시간 패턴 (예: "6시대", "6시", "07:04", "13:35분")
    if (/^\d{1,2}\s*(?:시대|시\s*대|시타임|시)$/i.test(s) || /^\d{1,2}:\d{2}/.test(s)) {
        return true;
    }

    // 5. 금액 패턴 (예: "8만", "8만원", "70000", "70,000", "12만")
    if (/^[0-9.,]+\s*(?:만|만원|원)?$/i.test(s)) {
        return true;
    }

    // 6. 카카오톡/안내/일반 명사 (예: 댓글, 사진, 스타, 스타트, 대리, 팀장 등)
    if (/^(?:댓글|사진|동영상|파일|안현희대리|대리|팀장|매니저|실장|담당자|골프락|공지|안내|필독|알림|전송|발송|작성|문의|요청|진행|감사|부탁|예약|취소|모집|확정|스타|스타트)$/i.test(s) ||
        /(?:골프락|안현희대리|안현희|대리에게|댓글|사진|동영상|첨부파일|카카오톡)/i.test(s)) {
        return true;
    }

    // 7. 인원/조인 관련 (예: 1인, 대기, 조인, 선입, 현장 등)
    if (/^(?:\d+인|대기|대기중|조인|양도|선입|선입금|선결제|현장|현장결제|그린피|카트피|캐디피|노캐디)$/i.test(s)) {
        return true;
    }

    // 8. 인사말 및 공지 일반 문구
    if (/(?:안녕하세요|반갑습니다|감사합니다|부탁드립니다|확인바랍니다)/i.test(s)) {
        return true;
    }

    return false;
}

// 매핑사전 또는 현재 테이블에 실제 등록된 공인 골프장인지 확인
function isRecognizedGolfCourse(name) {
    if (!name || isNonCourseWord(name)) return false;
    const clean = String(name).trim();
    if (/(?:cc|gc|골프장|골프클럽|컨트리클럽|컨트리|c\.c|g\.c)$/i.test(clean)) return true;
    const norm = clean.replace(/[\s\-_\[\]\(\)]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();
    if (!norm || norm.length < 2) return false;

    // 1. 매핑사전 검사
    const dictSource = (typeof dictionary !== 'undefined' && dictionary && Object.keys(dictionary).length > 0)
        ? dictionary
        : (typeof defaultDict !== 'undefined' ? defaultDict : {});
    for (const [k, v] of Object.entries(dictSource)) {
        const nk = k.replace(/[\s\-_\[\]\(\)]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();
        const nt = (typeof v === 'string' ? v : (v?.name || v?.golfmon || '')).replace(/[\s\-_\[\]\(\)]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();
        if (norm === nk || norm === nt || nk.includes(norm) || nt.includes(norm)) return true;
    }

    // 2. 현재 테이블 검사
    const tableRows = document.querySelectorAll('#dataTable tbody tr');
    for (const tr of tableRows) {
        const g = tr.cells[2]?.textContent.trim();
        const ng = (g || '').replace(/[\s\-_\[\]\(\)]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();
        if (ng && (norm === ng || ng.includes(norm))) return true;
    }

    // 3. 공지 구장 카탈로그 및 사용자 추가 구장 검사
    if (typeof DEFAULT_NOTICE_COURSE_CATALOG !== 'undefined') {
        for (const reg in DEFAULT_NOTICE_COURSE_CATALOG) {
            for (const c of DEFAULT_NOTICE_COURSE_CATALOG[reg]) {
                const nc = c.replace(/[\s\-_\[\]\(\)]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();
                if (norm === nc || nc.includes(norm) || norm.includes(nc)) return true;
            }
        }
    }
    if (typeof customNoticeCourses !== 'undefined' && Array.isArray(customNoticeCourses)) {
        for (const item of customNoticeCourses) {
            const nc = (item?.name || '').replace(/[\s\-_\[\]\(\)]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();
            if (nc && (norm === nc || nc.includes(norm) || norm.includes(nc))) return true;
        }
    }

    return false;
}

// HH:MM 형식 또는 한국어 시간("7시", "7시30분", "18시30분", "1시"), "첫팀"(05:00), "막팀"(23:00) 또는 4자리(0546)/3자리 숫자 형식 시간을 분(0~1440) 단위 정수로 변환
function timeToMinutes(tStr) {
    if (!tStr) return 0;
    const s = String(tStr).trim();
    if (/첫\s*(?:팀|티)/.test(s)) return 300; // 첫 팀 = 05:00 (300분)
    if (/막\s*(?:팀|티)|마지막\s*(?:팀|티)/.test(s)) return 1380; // 막 팀 = 23:00 (1380분)
    if (s.includes(':')) {
        const parts = s.split(':');
        let h = parseInt(parts[0], 10) || 0;
        const m = parseInt(parts[1], 10) || 0;
        // 골프 티타임 특성상 1~4시는 새벽이 없으므로 오후 13~16시로 자동 보정 (예: 1:30 -> 13:30)
        if (h >= 1 && h <= 4) h += 12;
        return h * 60 + m;
    }
    // "7시 30분", "7시30분", "7시", "18시30분", "1시", "1시30분"
    const mKor = s.match(/(\d{1,2})\s*시(?:\s*(\d{1,2})\s*분?)?/);
    if (mKor) {
        let h = parseInt(mKor[1], 10) || 0;
        const m = mKor[2] ? (parseInt(mKor[2], 10) || 0) : 0;
        // 골프 티타임 특성상 1~4시는 새벽이 없으므로 오후 13~16시로 자동 보정 (예: 1시 -> 13:00)
        if (h >= 1 && h <= 4) h += 12;
        return h * 60 + m;
    }
    const digits = s.replace(/\D/g, '');
    if (digits.length === 4) {
        let h = parseInt(digits.substring(0, 2), 10) || 0;
        const m = parseInt(digits.substring(2, 4), 10) || 0;
        if (h >= 1 && h <= 4) h += 12;
        return h * 60 + m;
    } else if (digits.length === 3) {
        let h = parseInt(digits.substring(0, 1), 10) || 0;
        const m = parseInt(digits.substring(1, 3), 10) || 0;
        if (h >= 1 && h <= 4) h += 12;
        return h * 60 + m;
    } else if (digits.length > 0 && digits.length <= 2) {
        let h = parseInt(digits, 10) || 0;
        if (h >= 1 && h <= 4) h += 12;
        if (h <= 24) return h * 60;
    }
    return 0;
}

// 시간 입력 문자열(단일 시간 "11:27", 범위 "11:00~12:00", "17-18시대", "19시대", "2부 전체", "전체")을 시작/종료 분(0~1439)으로 변환
function parseTimeInputToMinutes(timeStr) {
    if (!timeStr) return { startMins: 0, endMins: 1439, isAll: true };
    const raw = String(timeStr).trim();
    if (!raw || raw === '전체' || raw === '전체시간' || raw === '전부' || raw === '전타임' || raw === 'all' || raw === 'ALL') {
        return { startMins: 0, endMins: 1439, isAll: true };
    }

    // 0. 부제 전체 입력 (예: "1부", "1부 전체", "2부", "2부 전체", "3부", "3부 전체")
    const partMatch = raw.match(/^([123])부(?:\s*(?:전체|잔여|전타임))?$/);
    if (partMatch) {
        const pNum = parseInt(partMatch[1], 10);
        if (pNum === 1) return { startMins: 0, endMins: 659, isAll: false };
        if (pNum === 2) return { startMins: 660, endMins: 959, isAll: false };
        if (pNum === 3) return { startMins: 960, endMins: 1439, isAll: false };
    }

    // 1. 범위 검사 (~ 또는 -)
    if (raw.includes('~') || (raw.includes('-') && !raw.startsWith('-'))) {
        const sep = raw.includes('~') ? '~' : '-';
        const parts = raw.split(sep);
        const sPart = parts[0].trim();
        const ePart = parts[1].trim();

        // 17-18시대 같은 경우
        const sMatchH = sPart.match(/^(\d{1,2})\s*(?:시대|시)?$/);
        const eMatchH = ePart.match(/^(\d{1,2})\s*(?:시대|시)?$/);
        if (sMatchH && eMatchH) {
            const sh = parseInt(sMatchH[1], 10);
            const eh = parseInt(eMatchH[1], 10);
            if (sh <= 24 && eh <= 24) {
                return {
                    startMins: sh * 60,
                    endMins: eh * 60 + 59,
                    isAll: false
                };
            }
        }

        const sM = timeToMinutes(sPart);
        const eM = timeToMinutes(ePart);
        let finalEnd = eM;
        if (!ePart.includes(':') && !/\d{1,2}\s*분/.test(ePart) && ePart.length <= 4) {
            const digits = ePart.replace(/\D/g, '');
            if (digits.length <= 2) {
                finalEnd = eM + 59;
            }
        }
        return {
            startMins: Math.min(sM, finalEnd),
            endMins: Math.max(sM, finalEnd),
            isAll: false
        };
    }

    // 2. "19시대", "19시 대", "19시타임", "1시대"
    const mSlot = raw.match(/^(\d{1,2})\s*(?:시대|시\s*대|시타임|시\s*타임)$/);
    if (mSlot) {
        let h = parseInt(mSlot[1], 10);
        if (h >= 1 && h <= 4) h += 12; // 1~4시대 -> 13~16시대로 자동 변환!
        if (h <= 24) {
            return { startMins: h * 60, endMins: h * 60 + 59, isAll: false };
        }
    }

    // 3. 단일 시간 (11:27, 7시, 7시30분, 1935 등)
    const tM = timeToMinutes(raw);
    const isHourOnly = !raw.includes(':') && !/\d{1,2}\s*분/.test(raw) && (raw.replace(/\D/g, '').length <= 2 || /시$/.test(raw));
    const endM = isHourOnly ? (tM + 59) : tM;
    return {
        startMins: tM,
        endMins: endM,
        isAll: false
    };
}

// 시작/종료 분을 사람이 보기 편한 시간 문자열("11:27", "11:00~12:00", "전체")로 변환
function formatMinutesToTime(startMins, endMins) {
    if (startMins === 0 && (endMins >= 1439 || endMins === undefined)) return '전체';
    const sH = Math.floor(startMins / 60);
    const sM = startMins % 60;
    const sStr = `${String(sH).padStart(2, '0')}:${String(sM).padStart(2, '0')}`;
    if (startMins === endMins || endMins === undefined) return sStr;
    const eH = Math.floor(endMins / 60);
    const eM = endMins % 60;
    const eStr = `${String(eH).padStart(2, '0')}:${String(eM).padStart(2, '0')}`;
    return `${sStr}~${eStr}`;
}

// 공지 금액 문자열(10.9, 10.9만, 109,000, 109000, 10, "잔여타임 10만" 등)을 만 단위 float 숫자로 정규화
function normalizeNoticePrice(str) {
    if (!str) return null;
    let s = str.toString().replace(/[,원만!~:]/g, ' ').trim();
    const numMatch = s.match(/([0-9]+(?:\.[0-9]+)?)/);
    if (!numMatch) return null;
    let val = parseFloat(numMatch[1]);
    if (isNaN(val)) return null;
    // 10000원 이상(예: 109000 -> 10.9)으로 입력된 경우 만 단위로 자동 환산
    if (val >= 10000) {
        val = Math.round((val / 10000) * 100) / 100;
    }
    return val;
}

// 공지 날짜 상세 파싱 (연도, 월, 일 포함 객체 반환)
function parseNoticeDateDetail(line, fallbackMonth = null) {
    if (!line) return null;
    let m = line.match(/(?:(\d{4}|\d{2})\s*년\s*)?(\d{1,2})\s*월\s*(\d{1,2})\s*일?/);
    if (m) {
        const y = m[1] ? (m[1].length === 2 ? 2000 + parseInt(m[1], 10) : parseInt(m[1], 10)) : null;
        const month = parseInt(m[2], 10);
        const day = parseInt(m[3], 10);
        return {
            dateStr: `${month}.${day}`,
            year: y,
            month,
            day
        };
    }
    m = line.match(/(?:^|[^\d])(?:(\d{4}|\d{2})\s*[./\-]\s*)?(\d{1,2})[./\-](\d{1,2})(?!\d)(?!\s*(?:시대|시\s*대|시타임|시\b|분\b|만|만원|원))(?:$|[^\d])/);
    if (m) {
        const y = m[1] ? (m[1].length === 2 ? 2000 + parseInt(m[1], 10) : parseInt(m[1], 10)) : null;
        const month = parseInt(m[2], 10);
        const day = parseInt(m[3], 10);
        if (month >= 1 && month <= 12 && day >= 1 && day <= 31) {
            return {
                dateStr: `${month}.${day}`,
                year: y,
                month,
                day
            };
        }
    }
    // "당일", "오늘" 단독 라인 대응
    if (/(?:^|[^\w가-힣])(?:당일|오늘)(?:$|[^\w가-힣])/i.test(line) && !line.includes(':')) {
        const now = new Date();
        return {
            dateStr: `${now.getMonth() + 1}.${now.getDate()}`,
            year: now.getFullYear(),
            month: now.getMonth() + 1,
            day: now.getDate()
        };
    }
    // "22화", "22(화)", "22일(화)", "18일" 등 일자+요일 단독 라인 대응
    const mDayOnly = line.trim().match(/^[-*•▶▷□■▣★☆◆◇▲▼\s]*(\d{1,2})\s*(?:일)?\s*(?:\(([월화수목금토일])\)|([월화수목금토일]))?(?:요일)?\s*$/);
    if (mDayOnly) {
        const day = parseInt(mDayOnly[1], 10);
        if (day >= 1 && day <= 31) {
            const now = new Date();
            const month = fallbackMonth || (now.getMonth() + 1);
            return {
                dateStr: `${month}.${day}`,
                year: now.getFullYear(),
                month,
                day
            };
        }
    }
    return null;
}

/// 공지 텍스트 내 단일 날짜 감지 (예: "10월 18일(일)", "10/18", "10.18", "10-18") -> "10.18"
function parseNoticeDate(line) {
    const detail = parseNoticeDateDetail(line);
    return detail ? detail.dateStr : null;
}

// 공지 텍스트 내 기간 범위 감지 (예: "기간: 10/18(일) ~ 10/22(목) [5일간]", "10.18 ~ 10.22", "10월 18일 ~ 10월 22일", "2026.10.18 ~ 2026.10.22")
function parseNoticeDateRange(line) {
    if (!line) return null;
    // 1. 양쪽 모두 월/일이 있는 경우: "11/03 ~ 11/04", "11월 3일 ~ 11월 4일", "10.18 ~ 10.22", "2026.10.18 ~ 2026.10.22"
    const m1 = line.match(/(?:(\d{4}|\d{2})\s*[년./\-]\s*)?(\d{1,2})\s*[월./\-]\s*(\d{1,2})\s*(?:일)?(?:\([가-힣\w]+\))?\s*(?:~|-|부터|,)\s*(?:(\d{4}|\d{2})\s*[년./\-]\s*)?(\d{1,2})\s*[월./\-]\s*(\d{1,2})\s*(?:일)?(?:\([가-힣\w]+\))?/);
    if (m1) {
        const startY = m1[1] ? (m1[1].length === 2 ? 2000 + parseInt(m1[1], 10) : parseInt(m1[1], 10)) : null;
        const startM = parseInt(m1[2], 10);
        const startD = parseInt(m1[3], 10);
        const endY = m1[4] ? (m1[4].length === 2 ? 2000 + parseInt(m1[4], 10) : parseInt(m1[4], 10)) : startY;
        const endM = parseInt(m1[5], 10);
        const endD = parseInt(m1[6], 10);
        if (startM >= 1 && startM <= 12 && startD >= 1 && startD <= 31 && endM >= 1 && endM <= 12 && endD >= 1 && endD <= 31) {
            return {
                startDate: `${startM}.${startD}`,
                endDate: `${endM}.${endD}`,
                startYear: startY,
                endYear: endY,
                startM, startD, endM, endD,
                text: `${startM}.${startD}~${endM}.${endD}`,
                rawMatch: m1[0]
            };
        }
    }
    // 2. 시작일에만 월이 있고 종료일은 일자만 있는 경우: "11/03~4일(화)", "11/3~4일", "11/03~4일", "11.3~4", "11월 3일~4일", "11/3-4일"
    const m2 = line.match(/(?:(\d{4}|\d{2})\s*[년./\-]\s*)?(\d{1,2})\s*[월./\-]\s*(\d{1,2})\s*(?:일)?(?:\([가-힣\w]+\))?\s*(?:~|-|부터|,)\s*(\d{1,2})\s*(?:일)?(?:\([가-힣\w]+\))?/);
    if (m2) {
        const y = m2[1] ? (m2[1].length === 2 ? 2000 + parseInt(m2[1], 10) : parseInt(m2[1], 10)) : null;
        const startM = parseInt(m2[2], 10);
        const startD = parseInt(m2[3], 10);
        const endD = parseInt(m2[4], 10);
        if (startM >= 1 && startM <= 12 && startD >= 1 && startD <= 31 && endD >= 1 && endD <= 31) {
            return {
                startDate: `${startM}.${startD}`,
                endDate: `${startM}.${endD}`,
                startYear: y,
                endYear: y,
                startM, startD, endM: startM, endD,
                text: `${startM}.${startD}~${startM}.${endD}`,
                rawMatch: m2[0]
            };
        }
    }
    return null;
}

// 특정 티타임 날짜가 공지 날짜 범위에 포함되는지 검사
function isDateInRange(rowDate, dateRange) {
    if (!dateRange) return true;
    const m = String(rowDate || '').match(/(\d{1,2})[./월\-\s](\d{1,2})/);
    if (!m) return false;
    const rowM = parseInt(m[1], 10);
    const rowD = parseInt(m[2], 10);
    if (isNaN(rowM) || isNaN(rowD)) return false;

    const rowVal = rowM * 100 + rowD;
    const startVal = dateRange.startM * 100 + dateRange.startD;
    const endVal = dateRange.endM * 100 + dateRange.endD;

    if (startVal <= endVal) {
        return rowVal >= startVal && rowVal <= endVal;
    } else {
        // 연말/연초 걸침 (예: 12.28 ~ 1.5)
        return rowVal >= startVal || rowVal <= endVal;
    }
}

// 공지 텍스트 내 할인 금액 파싱 (예: "혜택: 잔여타임 추가 2만 할인", "2만원 할인", "2만 DC")
function parseNoticeDiscount(line) {
    if (!line) return null;
    if (!/할인|인하|차감|DC|혜택|지원|금액\s*인하/i.test(line)) return null;
    if (line.startsWith('*') || line.startsWith('※') || line.includes('비회원') || line.includes('조건부')) return null;

    const m = line.match(/(?:추가\s*)?([0-9.,]+)\s*(?:만|만원|원)?\s*(?:추가\s*)?(?:할인|인하|차감|DC|혜택|지원)/i) ||
              line.match(/(?:할인|인하|혜택|지원)\s*[:=\-]?\s*(?:추가\s*)?([0-9.,]+)\s*(?:만|만원|원)?/i);
    if (m) {
        const val = normalizeNoticePrice(m[1]);
        if (val !== null && val > 0) return val;
    }
    return null;
}

// 공지 텍스트 내 부제(1부, 2부, 3부) 파싱 (예: "[1부+2부] [4인필수]", "1부, 2부")
function parseNoticeParts(line) {
    if (!line) return null;
    if (!/1부|2부|3부|전부|전타임/.test(line)) return null;

    const hasPart1 = /1부|1\s*,\s*2|1\s*\+\s*2|전부|전타임/.test(line);
    const hasPart2 = /2부|1\s*,\s*2|1\s*\+\s*2|전부|전타임/.test(line);
    const hasPart3 = /3부|전부|전타임/.test(line);

    if (hasPart1 || hasPart2 || hasPart3) {
        return {
            hasPart1,
            hasPart2,
            hasPart3,
            desc: [hasPart1 ? '1부' : '', hasPart2 ? '2부' : '', hasPart3 ? '3부' : ''].filter(Boolean).join('+')
        };
    }
    return null;
}

// 티타임 시간이 해당 부제에 속하는지 판별
// 1부: 오전 11시 이전 (< 11:00, < 660분)
// 2부: 오전 11시 ~ 오후 4시 이전 (11:00 <= time < 16:00, 660 <= mins < 960)
// 3부: 오후 4시 이후 (>= 16:00, >= 960분)
function isTimeInPart(timeMins, parts) {
    if (!parts) return true;
    if (!parts.hasPart1 && !parts.hasPart2 && !parts.hasPart3) return true;

    if (timeMins < 660) {
        return Boolean(parts.hasPart1);
    } else if (timeMins < 960) {
        return Boolean(parts.hasPart2);
    } else {
        return Boolean(parts.hasPart3);
    }
}

