        golmarket: '한림안성(9홀)', golfland: '한림안성(P9)', golftop: '한림안성(P9)',
        name: '한림안성(P9)', region: '경기남부'
    };
    for (const k of ['한림안성', '한림안성(9홀)', '한림안성(p9)', '한림안성(P9)']) {
        dict[k] = Object.assign({}, dict[k] || {}, hanlimAnseongEntry);
    }

    // 8. 스프링베일
    const springvaleEntry = {
        golfmon: '스프링베일gc(P9)', golfpang: '스프링베일gc(P9)', golfrock: '스프링베일(9홀)',
        golmarket: '스프링베일(9홀)', golfland: '스프링베일gc(P9)', golftop: '스프링베일gc(P9)',
        name: '스프링베일gc(P9)', region: '경기동부'
    };
    for (const k of ['스프링베일', '스프링베일(9홀)', '스프링베일gc', '스프링베일gc(P9)']) {
        dict[k] = Object.assign({}, dict[k] || {}, springvaleEntry);
    }

    // 9. 글렌로스
    const glenrossEntry = {
        golfmon: '글렌로스(9홀)', golfpang: '글렌로스(9홀)', golfrock: '글렌로스(9홀)',
        golmarket: '글렌로스(9홀)', golfland: '글렌로스(9홀)', golftop: '글렌로스(9홀)',
        name: '글렌로스(9홀)', region: '경기남부'
    };
    for (const k of ['글렌로스', '글렌로스(9홀)', '글렌로스cc']) {
        dict[k] = Object.assign({}, dict[k] || {}, glenrossEntry);
    }

    // 10. 동서울 / 레스피아
    const dongseoulEntry = {
        golfmon: '동서울CC[구 레스피아(p10)]', golfpang: '동서울CC[구 레스피아(p10)]', golfrock: '동서울(9홀)',
        golmarket: '동서울(9홀)', golfland: '동서울CC[구 레스피아(p10)]', golftop: '동서울CC[구 레스피아(p10)]',
        name: '동서울CC[구 레스피아(p10)]', region: '강원'
    };
    for (const k of ['동서울', '동서울(9홀)', '동서울cc', '동서울CC[구 레스피아(p10)]', '레스피아']) {
        dict[k] = Object.assign({}, dict[k] || {}, dongseoulEntry);
    }

    // 11. 코브스윙 / 참밸리
    const cobbswingEntry = {
        golfmon: '코브스윙(구 참밸리CC)', golfpang: '코브스윙(구 참밸리CC)', golfrock: '참밸리',
        golmarket: '참밸리', golfland: '코브스윙(구 참밸리CC)', golftop: '코브스윙(구 참밸리CC)',
        name: '코브스윙(구 참밸리CC)', region: '경기북부'
    };
    for (const k of ['참밸리', '참밸리cc', '코브스윙', '코브스윙(구 참밸리CC)', '코브스윙(구:참밸리)']) {
        dict[k] = Object.assign({}, dict[k] || {}, cobbswingEntry);
    }

    // 12. 모카 / 세일
    const mokaEntry = {
        golfmon: '모카cc(구.세일)', golfpang: '모카cc(구.세일)', golfrock: '모카(구:세일)',
        golmarket: '모카(구:세일)', golfland: '모카cc(구.세일)', golftop: '모카cc(구.세일)',
        name: '모카cc(구.세일)', region: '충청'
    };
    for (const k of ['모카', '모카cc', '세일', '세일cc', '모카(구:세일)', '모카cc(구세일)', '모카cc(구.세일)']) {
        dict[k] = Object.assign({}, dict[k] || {}, mokaEntry);
    }

    // 13. 아세코밸리
    const asecoEntry = {
        golfmon: '아세코(시흥)gc', golfpang: '아세코(시흥)gc', golfrock: '아세코밸리(9홀)',
        golmarket: '아세코밸리(9홀)', golfland: '아세코(시흥)gc', golftop: '아세코(시흥)gc',
        name: '아세코(시흥)gc', region: '인천경인'
    };
    for (const k of ['아세코', '아세코밸리', '아세코밸리(9홀)', '아세코(시흥)gc']) {
        dict[k] = Object.assign({}, dict[k] || {}, asecoEntry);
    }
}

    saveDictionary();

    // chrome.storage.local 비동기 동기화 (기기간/창간 영구 보존)
    try {
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.get(['v2_golfDict'], (res) => {
                if (res && res.v2_golfDict && typeof res.v2_golfDict === 'object' && Object.keys(res.v2_golfDict).length > 0) {
                    for (const [k, v] of Object.entries(res.v2_golfDict)) {
                        if (!dictionary[k]) {
                            dictionary[k] = normalizeDictEntry(v, k);
                        }
                        if (defaultDict[k]) {
                            dictionary[k].region = defaultDict[k].region || dictionary[k].region;
                            dictionary[k].golfmon = defaultDict[k].golfmon || dictionary[k].golfmon;
                            dictionary[k].golfpang = defaultDict[k].golfpang || dictionary[k].golfpang;
                            dictionary[k].golmarket = defaultDict[k].golmarket || dictionary[k].golmarket;
                            dictionary[k].golfland = defaultDict[k].golfland || dictionary[k].golfland;
                            dictionary[k].golftop = defaultDict[k].golftop || dictionary[k].golftop;
                            dictionary[k].name = defaultDict[k].name || dictionary[k].name;
                        }
                    }
                    for (const [k, rockName] of Object.entries(GOLFROCK_OFFICIAL_NAMES)) {
                        if (dictionary[k]) {
                            dictionary[k].golfrock = rockName;
                            const rockRegion = GOLFROCK_REGIONS[k] || GOLFROCK_REGIONS[rockName] || '';
                            if (rockRegion) {
                                dictionary[k].golfrockRegion = rockRegion;
                            }
                            if (defaultDict[k] && defaultDict[k].region) {
                                dictionary[k].region = defaultDict[k].region;
                            }
                        }
                    }

                    // 비동기 동기화 완료 후에도 특수 구장 매핑 확실히 유지
                    applySpecialCourseMappings(dictionary);

                    saveDictionary();
                }
            });
        }
    } catch(e) {}
}

initDictionary();

// 상태 영구 저장 (팝업 닫았다 열어도 변환 내용 유지)
function saveCurrentTableState() {
    try {
        const trs = Array.from(document.querySelectorAll('#dataTable tbody tr'));
        // 브라우저 localStorage 5MB 한도 보호: 최대 1,000건 저장 및 에러 시 축소 저장
        const data = trs.slice(0, 1000).map(tr => {
            const cells = tr.querySelectorAll('td');
            return {
                date: cells[0]?.textContent || '',
                region: cells[1]?.textContent || '',
                golf: cells[2]?.textContent || '',
                time: cells[3]?.textContent || '',
                fee: cells[4]?.textContent || '',
                fieldFee: tr.dataset.fieldFee || '',
                prepaidFee: tr.dataset.prepaidFee || '',
                totalFee: tr.dataset.totalFee || '',
                origFieldFee: tr.dataset.origFieldFee || '',
                origPrepaidFee: tr.dataset.origPrepaidFee || '',
                origTotalFee: tr.dataset.origTotalFee || '',
                baseFee: tr.dataset.baseFee || cells[4]?.textContent || '',
                origBaseFee: tr.dataset.origBaseFee || '',
                cady: cells[5]?.textContent || '',
                condition: cells[6]?.textContent || '',
                sizenum: cells[7]?.textContent || '',
                roomType: tr.dataset.roomType || '',
                origRoomType: tr.dataset.origRoomType || tr.dataset.roomType || '',
                manualSeonti: tr.dataset.manualSeonti === 'true',
                isConfirmed: tr.dataset.isConfirmed === 'true',
                isDaegi: tr.dataset.isDaegi === 'true',
                fullRawText: tr.dataset.fullRawText || '',
                isPrepaid: tr.dataset.isPrepaid === 'true',
                isMeal: tr.dataset.isMeal === 'true',
                isSeontiOrDaegi: tr.dataset.isSeontiOrDaegi === 'true' || tr.dataset.roomType === '선티방' || tr.dataset.roomType === '대기방',
                isMapped: tr.dataset.isMapped !== 'false',
                rawGolf: tr.dataset.rawGolf || '',
                golfmonGolf: tr.dataset.golfmonGolf || '',
                golfpangGolf: tr.dataset.golfpangGolf || '',
                golmarketGolf: tr.dataset.golmarketGolf || '',
                golfrockGolf: tr.dataset.golfrockGolf || '',
                golflandGolf: tr.dataset.golflandGolf || '',
                golftopGolf: tr.dataset.golftopGolf || '',
                hasSlashFee: tr.dataset.hasSlashFee === 'true',
                slashFrontVal: tr.dataset.slashFrontVal || '',
                slashBackVal: tr.dataset.slashBackVal || '',
                origSlashFrontVal: tr.dataset.origSlashFrontVal || '',
                prepaidAmount: tr.dataset.prepaidAmount || '0',
                noticeAdjusted: tr.dataset.noticeAdjusted === 'true',
                noticePrice: tr.dataset.noticePrice || '',
                noticeDiscount: tr.dataset.noticeDiscount || '',
                noticeTagDesc: tr.dataset.noticeTagDesc || '',
                noticeType: tr.dataset.noticeType || '',
                coursePriceAdj: tr.dataset.coursePriceAdj || '',
                waitGender: tr.dataset.waitGender || '',
                waitPax: tr.dataset.waitPax || '',
                sizenum: tr.dataset.sizenum || cells[7]?.textContent?.trim() || '',
                source: tr.dataset.source || 'golfrock',
                selected: tr.classList.contains('selected')
            };
        });
        try {
            localStorage.setItem('v2_savedTableData', JSON.stringify(data));
        } catch (quotaErr) {
            console.warn('localStorage quota exceeded, storing subset:', quotaErr);
            try {
                localStorage.setItem('v2_savedTableData', JSON.stringify(data.slice(0, 200)));
            } catch (e) {
                console.warn('Cannot save table data to localStorage:', e);
            }
        }
    } catch (e) {
        console.warn('saveCurrentTableState failed safely:', e);
    }
}

// 저장된 상태 복원
function restoreSavedTableState() {
    try {
        const savedJson = localStorage.getItem('v2_savedTableData');
        if (!savedJson) return false;
        const data = JSON.parse(savedJson);
        if (!Array.isArray(data) || data.length === 0) return false;

        const tbody = document.getElementById('tableBody');
        if (!tbody) return false;
        tbody.innerHTML = '';

        data.forEach(item => {
            const tr = document.createElement('tr');
            tr.dataset.roomType = item.roomType || '미표시';
            if (item.origRoomType) tr.dataset.origRoomType = item.origRoomType;
            if (item.manualSeonti) tr.dataset.manualSeonti = 'true';
            if (item.isConfirmed) tr.dataset.isConfirmed = 'true';
            if (item.isDaegi) tr.dataset.isDaegi = 'true';
            if (item.fullRawText) tr.dataset.fullRawText = item.fullRawText;
            tr.dataset.isPrepaid = item.isPrepaid ? 'true' : 'false';
            tr.dataset.isMeal = item.isMeal ? 'true' : 'false';
            if (item.isSeontiOrDaegi) tr.dataset.isSeontiOrDaegi = 'true';
            tr.dataset.isMapped = item.isMapped === false ? 'false' : 'true';
            tr.dataset.rawGolf = item.rawGolf || '';
            tr.dataset.baseFee = item.baseFee !== undefined ? item.baseFee : (item.fee || '');
            if (item.origBaseFee) tr.dataset.origBaseFee = item.origBaseFee;
            if (item.fieldFee) tr.dataset.fieldFee = item.fieldFee;
            if (item.prepaidFee) tr.dataset.prepaidFee = item.prepaidFee;
            if (item.totalFee) tr.dataset.totalFee = item.totalFee;
            if (item.origFieldFee) tr.dataset.origFieldFee = item.origFieldFee;
            if (item.origPrepaidFee) tr.dataset.origPrepaidFee = item.origPrepaidFee;
            if (item.origTotalFee) tr.dataset.origTotalFee = item.origTotalFee;
            tr.dataset.golfmonGolf = item.golfmonGolf || item.golf || '';
            tr.dataset.golfpangGolf = item.golfpangGolf || item.golf || '';
            tr.dataset.golmarketGolf = item.golmarketGolf || getGolmarketGolfName(item.rawGolf || item.golf) || item.golf || '';
            tr.dataset.golfrockGolf = item.golfrockGolf || item.golf || '';
            tr.dataset.golflandGolf = item.golflandGolf || item.golf || '';
            tr.dataset.golftopGolf = item.golftopGolf || item.golf || '';
            if (item.hasSlashFee) tr.dataset.hasSlashFee = 'true';
            if (item.slashFrontVal) tr.dataset.slashFrontVal = item.slashFrontVal;
            if (item.slashBackVal) tr.dataset.slashBackVal = item.slashBackVal;
            if (item.origSlashFrontVal) tr.dataset.origSlashFrontVal = item.origSlashFrontVal;
            if (item.prepaidAmount) tr.dataset.prepaidAmount = item.prepaidAmount;
            if (item.noticeAdjusted) tr.dataset.noticeAdjusted = 'true';
            if (item.noticePrice) tr.dataset.noticePrice = item.noticePrice;
            if (item.noticeDiscount) tr.dataset.noticeDiscount = item.noticeDiscount;
            if (item.noticeTagDesc) tr.dataset.noticeTagDesc = item.noticeTagDesc;
            if (item.noticeType) tr.dataset.noticeType = item.noticeType;
            if (item.coursePriceAdj) tr.dataset.coursePriceAdj = item.coursePriceAdj;
            if (item.waitGender) tr.dataset.waitGender = item.waitGender;
            if (item.waitPax) tr.dataset.waitPax = item.waitPax;
            if (item.sizenum) tr.dataset.sizenum = item.sizenum;
            tr.dataset.source = item.source || 'golfrock';
            if (item.selected) tr.classList.add('selected');
            const stdRegion = getRegion(item.region, (item.rawGolf || '') + ' ' + (item.golf || ''));
            item.region = stdRegion;

            tr.innerHTML = `
                <td>${item.date}</td>
                <td>${stdRegion}</td>
                <td>${item.golf}</td>
                <td>${item.time}</td>
                <td>${item.fee}</td>
                <td>${item.cady}</td>
                <td>${item.condition}</td>
                <td>${item.sizenum}</td>
            `;
            tbody.appendChild(tr);
        });

        renderCardList();
        return true;
    } catch(e) {
        console.error("Failed to restore saved table state:", e);
        return false;
    }
}

