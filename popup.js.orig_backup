    '골프존카운티송도': '골프존카운티 송도',
    '골프존카운티천안': '골프존카운티 천안',
    '골프존안성H': '골프존카운티 안성H',
    '골프존안성W': '골프존카운티 안성W'
};

// 순수 그린피 만원 단위 숫자 추출 도우미 (총금액 최우선 추출: '11 / 1 (합 12)' -> '12', '12만[현장11+선입1만]' -> '12')
function extractPureFeeMan(feeVal) {
    if (!feeVal) return '';
    let str = feeVal.toString().trim();
    // 1) (합 12) 형태 최우선 추출
    const sumMatch = str.match(/\(합\s*([0-9.]+)\s*만?\)/);
    if (sumMatch) return sumMatch[1];
    // 2) 12만[현장11+선입1] 형태 -> 총금액 12 추출
    const bracketMatch = str.match(/^([0-9.]+)\s*만?\s*\[/);
    if (bracketMatch) return bracketMatch[1];
    // 3) 현장11+선입1 형태에서 앞뒤 숫자의 합산
    const plusMatch = str.match(/현장\s*([0-9.]+)\s*\+\s*선입\s*([0-9.]+)/);
    if (plusMatch) {
        const f = parseFloat(plusMatch[1]) || 0;
        const p = parseFloat(plusMatch[2]) || 0;
        return String(f + p);
    }
    // 4) 11 / 1 형태 (슬래시 분리) -> 합산
    const slashMatch = str.match(/^([0-9.]+)\s*\/\s*([0-9.]+)/);
    if (slashMatch) {
        const f = parseFloat(slashMatch[1]) || 0;
        const p = parseFloat(slashMatch[2]) || 0;
        return String(f + p);
    }
    // 5) 쉼표 제거 (120,000 -> 120000)
    str = str.replace(/,/g, '');
    // 6) 일반 숫자 추출
    const matchNum = str.match(/([0-9]+(?:\.[0-9]+)?)/);
    if (matchNum) {
        let n = parseFloat(matchNum[1]);
        if (n >= 1000) n = Math.round((n / 10000) * 10) / 10;
        return String(n);
    }
    return '';
}

function getGolmarketGolfName(golfName) {
    if (!golfName) return '';
    const clean = String(golfName).trim();
    if (GOLMARKET_GOLF_NAME_MAP[clean]) return GOLMARKET_GOLF_NAME_MAP[clean];
    const noSpace = clean.replace(/[\s\-_]/g, '');
    for (const [k, v] of Object.entries(GOLMARKET_GOLF_NAME_MAP)) {
        if (k.replace(/[\s\-_]/g, '') === noSpace) return v;
    }
    if (/골프존.*진천/i.test(clean)) return '골프존카운티 진천';
    if (/골프존.*화랑/i.test(clean)) return '골프존카운티 화랑';
    if (/골프존.*송도/i.test(clean)) return '골프존카운티 송도';
    if (/골프존.*천안/i.test(clean)) return '골프존카운티 천안';
    return clean;
}

