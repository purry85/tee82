            document.getElementById('btnHeaderStop')?.classList.remove('active');
            try { chrome.storage.local.set({ isRegistrationRunning: false }); } catch(e) {}
            showToast('골프랜드 등록이 중단되었습니다.');
        } else {
            showToast('골프랜드 등록이 중단되었습니다.');
        }
    }
});

// ========================================================
// 회원제 인증 시스템 (구글 스프레드시트 Web App 연동)
// ========================================================
const CURRENT_AUTH_API_VERSION = '20261112_v4_sites_token'; // 최신 서버 버전 식별자 (변경 시 모든 컴퓨터 자동 강제 갱신)
const DEFAULT_AUTH_API_URL = 'https://script.google.com/macros/s/AKfycbw9BUEoZFUSIZ8jj1CqyxxZoKVdzel7vfc7DnIaEmtREOon4wN_Pmdc9ukhLsaOz81iFQ/exec'; // 최신 인증 & 공지 동기화 웹 앱 URL
var currentAuthUser = currentAuthUser || null;
let currentAuthApiUrl = DEFAULT_AUTH_API_URL;

// ==========================================
// 자체 라이선스 키 (오프라인/간편인증) 알고리즘
// ==========================================
function generateLicenseKey(name, expireDate) {
    const cleanName = (name || '').trim();
    const cleanDate = (expireDate || '').replace(/[^0-9]/g, ''); // YYYYMMDD
    const raw = `GOLFTEE82_V2_SALT_${cleanName}_${cleanDate}_SECRET`;
    let hash = 0;
    for (let i = 0; i < raw.length; i++) {
        hash = ((hash << 5) - hash) + raw.charCodeAt(i);
        hash |= 0;
    }
    const sig = Math.abs(hash).toString(16).toUpperCase().padStart(8, '0');
    return `GT82-${cleanName}-${cleanDate}-${sig}`;
}

function verifyLicenseKey(name, key) {
    if (!key || typeof key !== 'string') return { valid: false, message: '라이선스 키를 입력해주세요.' };
    const cleanKey = key.trim();
    const parts = cleanKey.split('-');
    if (parts.length < 4 || parts[0] !== 'GT82') {
        return { valid: false, message: '올바른 GolfTee82 라이선스 키 형식이 아닙니다.' };
    }
    const keyName = parts[1];
    const keyDateStr = parts[2]; // YYYYMMDD

    if (name && name.trim() && name.trim() !== keyName) {
        return { valid: false, message: `이 키는 [${keyName}] 회원 전용 라이선스입니다.` };
    }

    const expectedKey = generateLicenseKey(keyName, keyDateStr);
    if (cleanKey.toUpperCase() !== expectedKey.toUpperCase()) {
        return { valid: false, message: '유효하지 않거나 변조된 라이선스 키입니다.' };
    }

    if (keyDateStr.length !== 8) {
        return { valid: false, message: '라이선스 날짜 정보가 올바르지 않습니다.' };
    }

    const y = parseInt(keyDateStr.substring(0, 4), 10);
    const m = parseInt(keyDateStr.substring(4, 6), 10) - 1;
    const d = parseInt(keyDateStr.substring(6, 8), 10);
    const expDate = new Date(y, m, d, 23, 59, 59, 999);
    const now = new Date();

    const formattedExp = `${y}-${String(m + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
    const diffMs = expDate.getTime() - now.getTime();
    const daysLeft = Math.ceil(diffMs / (1000 * 60 * 60 * 24));

    if (diffMs < 0) {
        return { valid: false, isExpired: true, expireDate: formattedExp, message: `사용 기간이 만료된 키입니다. (${formattedExp} 만료)` };
    }

    return {
        valid: true,
        name: keyName,
        expireDate: formattedExp,
        daysLeft: daysLeft,
        licenseKey: cleanKey
    };
}

function cleanGoogleWebAppUrl(url) {
    if (!url) return '';
    let clean = url.trim();
    clean = clean.split('?')[0].split('#')[0].trim();
    clean = clean.replace(/\/+$/, '');
    if (clean.endsWith('/edit')) {
        clean = clean.replace(/\/edit$/, '/exec');
    }
    if (!clean.endsWith('/exec') && clean.includes('/macros/s/')) {
        clean = clean + '/exec';
    }
    return clean;
}

function isLegacyAuthUrl(url) {
    if (!url) return true;
    const clean = cleanGoogleWebAppUrl(url);
    if (!clean.includes('/macros/s/') || !clean.includes('script.google.com')) return true;
    return clean.includes('AKfycbyeNHNTsHaP0GIqXEBqADf3aFeGOOPeyg8JETtv04p_084TpQ-90k9tUa1x4S64RaQrWg') ||
           clean.includes('AKfycbxktW6QuRvq5i1rl-B5yFlyOqDeZ_4O3XkW04JOmMQwaMi-OiejXOYK64lIYH2YZGMhEw');
}

function getAuthApiUrl() {
    try {
        const savedVer = localStorage.getItem('v2_auth_api_version');
        const saved = localStorage.getItem('v2_auth_api_url');
        // 버전이 다르거나, 구버전 URL이면 무조건 최신 공식 URL로 강제 자동 교체
        if (savedVer !== CURRENT_AUTH_API_VERSION || !saved || isLegacyAuthUrl(saved)) {
            setAuthApiUrl(DEFAULT_AUTH_API_URL);
            return DEFAULT_AUTH_API_URL;
        }
        return cleanGoogleWebAppUrl(saved);
    } catch(e) {}
    return DEFAULT_AUTH_API_URL;
}

function setAuthApiUrl(url) {
    currentAuthApiUrl = (url || DEFAULT_AUTH_API_URL).trim();
    try {
        localStorage.setItem('v2_auth_api_url', currentAuthApiUrl);
        localStorage.setItem('v2_auth_api_version', CURRENT_AUTH_API_VERSION);
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.set({ 
                v2_auth_api_url: currentAuthApiUrl,
                v2_auth_api_version: CURRENT_AUTH_API_VERSION
            });
        }
    } catch(e) {}
}

function isUserAuthenticated() {
    if (!currentAuthUser || !currentAuthUser.isLoggedIn) return false;
    if (currentAuthUser.expireDate) {
        const now = new Date();
        const exp = new Date(currentAuthUser.expireDate + 'T23:59:59');
        if (now.getTime() > exp.getTime()) return false;
    }
    return true;
}

function showAuthAlert(msg, type = 'error') {
    const alertBox = document.getElementById('authAlertBox');
    if (!alertBox) return;
    alertBox.innerText = msg;
    alertBox.className = `auth-alert ${type}`;
    alertBox.style.display = 'block';
}

function hideAuthAlert() {
    const alertBox = document.getElementById('authAlertBox');
    if (alertBox) alertBox.style.display = 'none';
}

// ==========================================
// 🔑 비밀번호 저장 & 자동 완성 관리자
// ==========================================
function getSavedCredentials() {
    try {
        const raw = localStorage.getItem('v2_auth_saved_credentials');
        if (raw) {
            const parsed = JSON.parse(raw);
            if (parsed && parsed.id && parsed.pw) return parsed;
        }
    } catch(e) {}
    return null;
}

function saveSavedCredentials(id, pw) {
    try {
        const data = { id: (id || '').trim(), pw: (pw || '').trim(), savedAt: Date.now() };
        localStorage.setItem('v2_auth_saved_credentials', JSON.stringify(data));
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.set({ v2_auth_saved_credentials: data });
        }
    } catch(e) {}
}

function clearSavedCredentials() {
    try {
        localStorage.removeItem('v2_auth_saved_credentials');
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.remove(['v2_auth_saved_credentials']);
        }
    } catch(e) {}
}

function applySavedCredentialsToInputs() {
    const creds = getSavedCredentials();
    const idInput = document.getElementById('authInputId');
    const pwInput = document.getElementById('authInputPw');
    const chkSave = document.getElementById('chkAuthAutoLogin');

    if (creds && creds.id && creds.pw) {
        if (idInput) idInput.value = creds.id;
        if (pwInput) pwInput.value = creds.pw;
        if (chkSave) chkSave.checked = true;
    } else if (creds && creds.id) {
        if (idInput) idInput.value = creds.id;
        if (chkSave) chkSave.checked = false;
    }
}

function showAuthOverlay(msg = '', type = 'error') {
    const overlay = document.getElementById('authOverlay');
    if (overlay) {
        overlay.style.display = 'flex';
    }
    const pill = document.getElementById('userMembershipPill');
    if (pill) pill.style.display = 'none';

    applySavedCredentialsToInputs();

    if (msg) {
        showAuthAlert(msg, type);
    } else {
        hideAuthAlert();
    }
}

function hideAuthOverlay() {
    const overlay = document.getElementById('authOverlay');
    if (overlay) {
        overlay.style.display = 'none';
    }
    hideAuthAlert();
}

function updateAuthUI(user) {
    const pill = document.getElementById('userMembershipPill');
    const nameEl = document.getElementById('pillUserName');
    const badgeEl = document.getElementById('pillExpireDays');

    if (!user || !user.isLoggedIn) {
        if (pill) pill.style.display = 'none';
        return;
    }

    if (nameEl) nameEl.innerText = user.name || user.id || '회원';
    if (badgeEl && user.expireDate) {
        const now = new Date();
        const exp = new Date(user.expireDate + 'T23:59:59');
        const diffMs = exp.getTime() - now.getTime();
        const days = Math.ceil(diffMs / (1000 * 60 * 60 * 24));
        badgeEl.innerText = days >= 0 ? `D-${days}` : '만료됨';
        badgeEl.className = 'expire-badge';
        if (days <= 3) badgeEl.classList.add('danger');
        else if (days <= 7) badgeEl.classList.add('warning');
        const siteLabel = user.sites ? ` / 권한 사이트: ${user.sites}` : '';
        pill.title = `회원: ${user.name || user.id} (만료일: ${user.expireDate}${siteLabel})`;
    }

    if (pill) pill.style.display = 'inline-flex';
}

// ==========================================
// 🛡️ PC/기기 식별자(Device ID) 획득 모듈
// - 동일 PC: Chrome, Edge, Brave, Whale 등 어떤 브라우저에서든 100% 동일한 PC ID 공유
// - 다른 PC / 모바일: 완전히 다른 고유 Device ID 생성 -> 다른 기기 로그인 시 기존 기기 세션 즉시 만료
// ==========================================
let _cachedDeviceId = null;

async function getStoredMachineFileId() {
    try {
        if (typeof chrome !== 'undefined' && chrome.runtime?.getURL) {
            const url = chrome.runtime.getURL('machine.json');
            const res = await fetch(url);
            if (res.ok) {
                const data = await res.json();
                if (data && data.machineId) {
                    return String(data.machineId).trim();
                }
            }
        }
    } catch (e) {}
    return null;
}

function generateHardwareFingerprintId() {
    try {
        const parts = [];
        parts.push(navigator.platform || 'Win32');
        parts.push(navigator.hardwareConcurrency || '4');
        parts.push(navigator.deviceMemory || '8');
        parts.push(`${screen.width}x${screen.height}x${screen.colorDepth}`);
        parts.push(Intl.DateTimeFormat().resolvedOptions().timeZone || 'Asia/Seoul');

        // WebGL GPU Renderer/Vendor (Chromium on Windows uses Direct3D11 via ANGLE, identical across Chrome, Edge, Brave, Whale)
        try {
            const canvas = document.createElement('canvas');
            const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
            if (gl) {
                const ext = gl.getContext('webgl')?.getExtension('WEBGL_debug_renderer_info') || gl.getExtension('WEBGL_debug_renderer_info');
                if (ext) {
                    parts.push(gl.getParameter(ext.UNMASKED_VENDOR_WEBGL) || '');
                    parts.push(gl.getParameter(ext.UNMASKED_RENDERER_WEBGL) || '');
                }
            }
        } catch (e) {}

        const raw = parts.join('||');
        let hash = 0;
        for (let i = 0; i < raw.length; i++) {
            hash = ((hash << 5) - hash) + raw.charCodeAt(i);
            hash |= 0;
        }
        return 'PC_FP_' + Math.abs(hash).toString(36) + '_' + (screen.width + 'x' + screen.height);
    } catch (e) {
        return 'PC_DEFAULT';
    }
}

async function getDeviceId() {
    if (_cachedDeviceId) return _cachedDeviceId;

    const isMobile = /Android|iPhone|iPad|iPod|Lemur/i.test(navigator.userAgent || '');
    if (isMobile) {
        let mobId = localStorage.getItem('v2_device_id_mob');
        if (!mobId && typeof chrome !== 'undefined' && chrome.storage?.local) {
            try {
                const s = await chrome.storage.local.get(['v2_device_id_mob']);
                mobId = s?.v2_device_id_mob;
            } catch (e) {}
        }
        if (!mobId) {
            mobId = 'MOB_' + (Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 10)).toUpperCase();
            try { localStorage.setItem('v2_device_id_mob', mobId); } catch (e) {}
            if (typeof chrome !== 'undefined' && chrome.storage?.local) {
                try { chrome.storage.local.set({ v2_device_id_mob: mobId }); } catch (e) {}
            }
        }
        _cachedDeviceId = mobId;
        return mobId;
    }

    // PC 1순위: 확장프로그램 루트의 machine.json (설치기/업데이트기가 Windows MachineGuid 기반으로 생성)
    let pcId = await getStoredMachineFileId();
    if (pcId) {
        _cachedDeviceId = pcId;
        return pcId;
    }

    // PC 2순위: 하드웨어 고유 핑거프린트 (GPU 모델 + CPU 코어 + 화면 해상도 + 메모리 + 타임존)
    pcId = generateHardwareFingerprintId();
    _cachedDeviceId = pcId;
    return pcId;
}

async function verifyAuthWithServer(id, pw, silent = true, isExplicitLogin = false) {
    let apiUrl = getAuthApiUrl();
    if (!apiUrl) {
        if (!silent) {
            showAuthAlert('관리자 인증서버 URL이 설정되지 않았습니다. [⚙️ 관리자 인증서버 설정]을 먼저 진행해주세요.', 'error');
        }
        return { success: false, message: '인증서버 URL 미설정' };
    }

    try {
        const cleanUrl = cleanGoogleWebAppUrl(apiUrl);
        const currentToken = currentAuthUser?.sessionToken || localStorage.getItem('v2_auth_session_token') || '';
        const deviceId = await getDeviceId();
        let targetUrl = cleanUrl + '?action=verify&id=' + encodeURIComponent(id) + '&password=' + encodeURIComponent(pw) + '&deviceId=' + encodeURIComponent(deviceId) + '&_t=' + Date.now();
        if (isExplicitLogin) {
            targetUrl += '&newLogin=true';
        } else if (currentToken) {
            targetUrl += '&sessionToken=' + encodeURIComponent(currentToken);
        }

        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 12000);

        let response = await fetch(targetUrl, {
            method: 'GET',
            redirect: 'follow',
            signal: controller.signal
        });
        clearTimeout(timeoutId);

        let text = await response.text();
        // GET 응답이 HTML일 경우 POST로 자동 재시도
        if (!text.trim().startsWith('{')) {
            try {
                const postPayload = {
                    action: 'verify',
                    id: id,
                    password: pw,
                    deviceId: deviceId,
                    newLogin: isExplicitLogin
                };
                if (!isExplicitLogin && currentToken) postPayload.sessionToken = currentToken;
                const postResponse = await fetch(cleanUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify(postPayload),
                    redirect: 'follow'
                });
                const postText = await postResponse.text();
                if (postText.trim().startsWith('{')) {
                    text = postText;
                }
            } catch(e) {}
        }

        let data = null;
        try {
            data = JSON.parse(text);
        } catch(e) {
            throw new Error('서버 응답 오류 (구글 스크립트 권한 승인 필요)');
        }

        // ★ 동시 접속 감지 처리 (관리자는 모든 중복 로그인 100% 무제한 허용, 일반 회원만 동시 접속 차단!)
        const targetId = String(data?.id || id || '').trim().toLowerCase();
        const targetName = String(data?.name || '').trim().toLowerCase();
        const targetFeatures = String(data?.features || '').trim().toLowerCase();
        const targetTokens = targetFeatures.split(/[,+\/\s|;]+/).map(s => s.trim()).filter(Boolean);
        const adminTokens = ['관리자', 'admin', '마스터', 'master', '최고관리자', '개발자'];
        const isAdminUser = (data && data.isAdmin === true) ||
                            (typeof isCurrentUserAdmin === 'function' && isCurrentUserAdmin()) ||
                            (localStorage.getItem('v2_isAdmin') === 'true') ||
                            (targetId === 'admin' || targetId === 'administrator' || targetId === 'golfmon_admin' || targetId === 'purry' || targetId === 'purry85' || targetId === 'yebba' || targetId.includes('admin') || targetId.includes('master')) ||
                            (targetName === '관리자' || targetName === '최고관리자' || targetName.includes('관리자')) ||
                            targetTokens.some(t => adminTokens.includes(t));

        if (!isAdminUser && data && (data.code === 'CONCURRENT_LOGIN' || data.isConcurrentLogin)) {
            if (typeof stopRegistration === 'function') stopRegistration();
            logoutUser(false);
            showAuthOverlay('⚠️ 동시 접속 감지: 다른 컴퓨터(또는 모바일)에서 동일 아이디로 로그인되어 현재 세션이 종료되었습니다.\n다시 로그인해주세요.', 'error');
            return { success: false, code: 'CONCURRENT_LOGIN', message: data.message };
        }

        if (data && data.success) {
            if (data.latestRelease && data.latestRelease.version) {
                window.__latestRemoteRelease = data.latestRelease;
            }
            const newSessionToken = data.sessionToken || currentToken || ('GT_' + Date.now() + '_' + Math.random().toString(36).substring(2, 8));
            currentAuthUser = {
                id: data.id || id,
                pw: pw,
                name: data.name || id,
                phone: data.phone || (currentAuthUser ? currentAuthUser.phone : '') || '',
                isAdmin: isAdminUser,
                expireDate: data.expireDate,
                daysLeft: data.daysLeft,
                features: data.features || (currentAuthUser ? currentAuthUser.features : '') || '',
                sites: (data.sites !== undefined ? data.sites : (currentAuthUser ? currentAuthUser.sites : '')) || '',
                sessionToken: newSessionToken,
                deviceId: deviceId,
                isLoggedIn: true,
                lastVerifiedAt: Date.now()
            };
            try { localStorage.setItem('v2_auth_session_token', newSessionToken); } catch(e) {}
            if (isAdminUser) {
                try { localStorage.setItem('v2_isAdmin', 'true'); } catch(e) {}
            } else {
                try {
                    localStorage.removeItem('v2_isAdmin');
                    if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
                        chrome.storage.local.remove(['v2_isAdmin']);
                    }
                } catch(e) {}
            }
            saveAuthUserSession(currentAuthUser);
            updateAuthUI(currentAuthUser);
            applyUserPermissionsUI();
            hideAuthOverlay();

            // ★ 로그인/인증 성공 즉시 최신 버전 업데이트 검사
            if (typeof window.checkForRemoteAppUpdate === 'function') {
                setTimeout(() => {
                    window.checkForRemoteAppUpdate(false);
                }, 300);
            }

            return { success: true, user: currentAuthUser };
        } else {
            const errMsg = data?.message || '인증에 실패했습니다.';
            logoutUser(false);
            showAuthOverlay(errMsg, 'error');
            return { success: false, message: errMsg };
        }
    } catch(err) {
        console.warn('[Tee82 Auth] 서버 연결 오류:', err);
        // 네트워크 오프라인 시: 이전 인증 세션이 있고 만료일이 지나지 않았다면 오프라인 임시 허용 (24시간 이내)
        if (silent && currentAuthUser && currentAuthUser.isLoggedIn) {
            const exp = new Date(currentAuthUser.expireDate + 'T23:59:59');
            const now = new Date();
            if (now.getTime() <= exp.getTime()) {
                console.log('[Tee82 Auth] 오프라인 캐시 인증 유지');
                updateAuthUI(currentAuthUser);
                applyUserPermissionsUI();
                hideAuthOverlay();
                return { success: true, user: currentAuthUser };
            } else {
                logoutUser(false);
                showAuthOverlay('사용 기간이 만료되었습니다. 관리자에게 연장을 요청하세요.', 'error');
                return { success: false, message: '기간 만료' };
            }
        }
        if (!silent) {
            showAuthAlert('인증 서버에 연결할 수 없습니다. 인터넷 상태 및 URL을 확인해주세요.', 'error');
        }
        return { success: false, message: '연결 실패' };
    }
}

function getCurrentAuthAppVersion() {
    try {
        if (typeof chrome !== 'undefined' && chrome.runtime?.getManifest?.()?.version) {
            return chrome.runtime.getManifest().version;
        }
    } catch (e) {}
    return '';
}

function saveAuthUserSession(user) {
    try {
        const curAppVer = getCurrentAuthAppVersion();
        if (user && typeof user === 'object') {
            if (curAppVer) user.appVersion = curAppVer;
            const now = Date.now();
            if (!user.loggedInAt) user.loggedInAt = now;
            user.savedAt = now;
            user._sig = computeSessionSignature(user);
        }
        localStorage.setItem('v2_auth_user', JSON.stringify(user));
        if (curAppVer) localStorage.setItem('v2_auth_app_version', curAppVer);
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.set({ v2_auth_user: user });
            chrome.storage.local.remove(['v2_auth_invalidated_at']);
        }
    } catch(e) {}
}

function logoutUser(notify = true, preserveSavedPassword = true) {
    currentAuthUser = null;
    try {
        sessionStorage.removeItem('v2_update_dismissed');
        localStorage.removeItem('v2_auth_user');
        localStorage.removeItem('v2_auth_app_version');
        localStorage.removeItem('v2_auth_session_token');
        localStorage.removeItem('v2_labModeActive');
        localStorage.removeItem('v2_isAdmin');
        localStorage.removeItem('v2_multiFeatureActive');
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.remove(['v2_auth_user', 'v2_labModeActive', 'v2_isAdmin', 'v2_multiFeatureActive', 'v2_auth_session_token']);
        }
    } catch(e) {}
    const pwInput = document.getElementById('authInputPw');
    const idInput = document.getElementById('authInputId');
    const saved = getSavedCredentials();
    if (preserveSavedPassword && saved && saved.id && saved.pw) {
        if (idInput) idInput.value = saved.id;
        if (pwInput) pwInput.value = saved.pw;
        const chkSave = document.getElementById('chkAuthAutoLogin');
        if (chkSave) chkSave.checked = true;
    } else {
        if (pwInput) pwInput.value = '';
    }
    const pill = document.getElementById('userMembershipPill');
    if (pill) pill.style.display = 'none';
    applyUserPermissionsUI();
    showAuthOverlay();
    if (notify) {
        showToast('로그아웃되었습니다.');
    }
}

async function changePasswordWithServer(id, oldPw, newPw) {
    let apiUrl = getAuthApiUrl();
    if (!apiUrl) {
        return { success: false, message: '인증서버 URL이 설정되지 않았습니다.' };
    }

    try {
        const cleanUrl = cleanGoogleWebAppUrl(apiUrl);
        const targetUrl = cleanUrl + '?action=changePassword&id=' + encodeURIComponent(id) + 
                          '&password=' + encodeURIComponent(oldPw) + 
                          '&newPassword=' + encodeURIComponent(newPw) + 
                          '&_t=' + Date.now();

        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 12000);

        let response = await fetch(targetUrl, {
            method: 'GET',
            redirect: 'follow',
            signal: controller.signal
        });
        clearTimeout(timeoutId);

        let text = await response.text();
        if (!text.trim().startsWith('{')) {
            try {
                const postResponse = await fetch(cleanUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify({ action: 'changePassword', id: id, password: oldPw, newPassword: newPw }),
                    redirect: 'follow'
                });
                const postText = await postResponse.text();
                if (postText.trim().startsWith('{')) {
                    text = postText;
                }
            } catch(e) {}
        }

        let data = null;
        try {
            data = JSON.parse(text);
        } catch(e) {
            throw new Error('서버 응답 오류 (구글 스크립트 최신 버전 배포 필요)');
        }
        return data || { success: false, message: '서버 응답 없음' };
    } catch(err) {
        console.warn('[Tee82 Auth] 비밀번호 변경 오류:', err);
        return { success: false, message: err.message || '인증 서버 연결 실패' };
    }
}

function openChangePwModal() {
    const modal = document.getElementById('authChangePwModal');
    const inputId = document.getElementById('inputChangePwId');
    const inputOld = document.getElementById('inputChangePwOld');
    const inputNew = document.getElementById('inputChangePwNew');
    const inputConfirm = document.getElementById('inputChangePwConfirm');
    const statusBox = document.getElementById('changePwStatusBox');

    if (!modal) return;
    if (statusBox) statusBox.style.display = 'none';
    if (inputOld) inputOld.value = '';
    if (inputNew) inputNew.value = '';
    if (inputConfirm) inputConfirm.value = '';

    if (currentAuthUser && currentAuthUser.id) {
        if (inputId) {
            inputId.value = currentAuthUser.id;
            inputId.readOnly = true;
            inputId.style.backgroundColor = '#F1F5F9';
        }
        setTimeout(() => inputOld?.focus(), 100);
    } else {
        const loginId = document.getElementById('authInputId')?.value?.trim();
        if (inputId) {
            inputId.value = loginId || '';
            inputId.readOnly = false;
            inputId.style.backgroundColor = '#FFFFFF';
        }
        setTimeout(() => {
            if (loginId) inputOld?.focus();
            else inputId?.focus();
        }, 100);
    }

    modal.style.display = 'flex';
}

function closeChangePwModal() {
    const modal = document.getElementById('authChangePwModal');
    if (modal) modal.style.display = 'none';
}

async function handleChangePwSubmit() {
    const inputId = document.getElementById('inputChangePwId');
    const inputOld = document.getElementById('inputChangePwOld');
    const inputNew = document.getElementById('inputChangePwNew');
    const inputConfirm = document.getElementById('inputChangePwConfirm');
    const statusBox = document.getElementById('changePwStatusBox');
    const btnSubmit = document.getElementById('btnSubmitChangePw');

    const id = inputId?.value?.trim();
    const oldPw = inputOld?.value?.trim();
    const newPw = inputNew?.value?.trim();
    const confirmPw = inputConfirm?.value?.trim();

    const showStatus = (msg, isSuccess = false) => {
        if (!statusBox) return;
        statusBox.className = 'auth-admin-status ' + (isSuccess ? 'success' : 'error');
        statusBox.innerText = msg;
        statusBox.style.display = 'block';
    };

    if (!id) {
        showStatus('아이디를 입력해주세요.');
        inputId?.focus();
        return;
    }
    if (!oldPw) {
        showStatus('현재 비밀번호를 입력해주세요.');
        inputOld?.focus();
        return;
    }
    if (!newPw) {
        showStatus('새 비밀번호를 입력해주세요.');
        inputNew?.focus();
        return;
    }
    if (newPw.length < 2) {
        showStatus('새 비밀번호를 2자 이상 입력해주세요.');
        inputNew?.focus();
        return;
    }
    if (oldPw === newPw) {
        showStatus('새 비밀번호가 현재 비밀번호와 동일합니다.');
        inputNew?.focus();
        return;
    }
    if (newPw !== confirmPw) {
        showStatus('새 비밀번호가 일치하지 않습니다. 다시 확인해주세요.');
        inputConfirm?.focus();
        return;
    }

    if (btnSubmit) {
        btnSubmit.disabled = true;
        btnSubmit.innerText = '변경 중...';
    }
    if (statusBox) statusBox.style.display = 'none';

    try {
        const result = await changePasswordWithServer(id, oldPw, newPw);
        if (result && result.success && (result.action === 'changePassword' || (result.message && result.message.includes('비밀번호')))) {
            showStatus('🟢 비밀번호가 성공적으로 변경되었습니다! 스프레드시트에 자동 반영되었습니다.', true);
            showToast('비밀번호가 성공적으로 변경되었습니다!');
            if (currentAuthUser && currentAuthUser.id === id) {
                currentAuthUser.pw = newPw;
                saveAuthUserSession(currentAuthUser);
            }
            const authInputPw = document.getElementById('authInputPw');
            if (authInputPw) authInputPw.value = newPw;

            setTimeout(() => {
                closeChangePwModal();
            }, 1200);
        } else if (result && result.success && result.message && result.message.includes('인증 성공')) {
            const currentCallingUrl = getAuthApiUrl();
            const shortUrl = currentCallingUrl.length > 50 ? currentCallingUrl.slice(0, 38) + '...' + currentCallingUrl.slice(-15) : currentCallingUrl;
            showStatus('⚠️ 구글 Apps Script가 이전 버전으로 응답했습니다.\n(현재 호출 중인 주소: ' + shortUrl + ')\n\n💡 구글에서 [새 배포] 후 화면에 나온 새 웹 앱 URL을 복사하여 채팅창에 알려주시거나, [⚙️ 관리자 인증서버 설정]에 저장해주세요!', false);
        } else {
            showStatus(result?.message || '비밀번호 변경에 실패했습니다.');
        }
    } catch(err) {
        showStatus('오류가 발생했습니다: ' + (err.message || err));
    } finally {
        if (btnSubmit) {
            btnSubmit.disabled = false;
            btnSubmit.innerText = '변경하기';
        }
    }
}

async function registerUserWithServer(id, pw, name, phone, referral = '') {
    let apiUrl = getAuthApiUrl();
    if (!apiUrl) {
        return { success: false, message: '인증서버 URL이 설정되지 않았습니다. 관리자에게 문의해주세요.' };
    }

    try {
        const cleanUrl = cleanGoogleWebAppUrl(apiUrl);
        const targetUrl = cleanUrl + '?action=register&id=' + encodeURIComponent(id) + 
                          '&password=' + encodeURIComponent(pw) + 
                          '&name=' + encodeURIComponent(name || '') + 
                          '&phone=' + encodeURIComponent(phone || '') + 
                          '&referral=' + encodeURIComponent(referral || '') + 
                          '&_t=' + Date.now();

        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 12000);

        let response = await fetch(targetUrl, {
            method: 'GET',
            redirect: 'follow',
            signal: controller.signal
        });
        clearTimeout(timeoutId);

        let text = await response.text();
        if (!text.trim().startsWith('{')) {
            try {
                const postResponse = await fetch(cleanUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify({ action: 'register', id: id, password: pw, name: name, phone: phone, referral: referral }),
                    redirect: 'follow'
                });
                const postText = await postResponse.text();
                if (postText.trim().startsWith('{')) {
                    text = postText;
                }
            } catch(e) {}
        }

        let data = null;
        try {
            data = JSON.parse(text);
        } catch(e) {
            throw new Error('서버 응답 오류 (구글 스크립트 최신 버전 배포 필요)');
        }
        return data || { success: false, message: '서버 응답 없음' };
    } catch(err) {
        console.warn('[AutomaTee Auth] 회원가입 오류:', err);
        return { success: false, message: err.message || '인증 서버 연결 실패' };
    }
}

function openRegisterModal() {
    const modal = document.getElementById('authRegisterModal');
    const inputId = document.getElementById('inputRegisterId');
    const inputPw = document.getElementById('inputRegisterPw');
    const inputConfirm = document.getElementById('inputRegisterConfirm');
    const inputName = document.getElementById('inputRegisterName');
    const inputPhone = document.getElementById('inputRegisterPhone');
    const inputReferral = document.getElementById('inputRegisterReferral');
    const statusBox = document.getElementById('registerStatusBox');
    const btnSubmit = document.getElementById('btnSubmitRegister');

    if (!modal) return;
    if (statusBox) statusBox.style.display = 'none';
    if (btnSubmit) {
        btnSubmit.disabled = false;
        btnSubmit.innerText = '가입 신청하기';
    }
    if (inputPw) inputPw.value = '';
    if (inputConfirm) inputConfirm.value = '';
    if (inputName) inputName.value = '';
    if (inputPhone) inputPhone.value = '';
    if (inputReferral) inputReferral.value = '';

    const loginId = document.getElementById('authInputId')?.value?.trim();
    if (inputId) {
        inputId.value = loginId || '';
    }
    modal.style.display = 'flex';
    setTimeout(() => {
        if (loginId) inputPw?.focus();
        else inputId?.focus();
    }, 100);
}

function closeRegisterModal() {
    const modal = document.getElementById('authRegisterModal');
    if (modal) modal.style.display = 'none';
}

async function handleRegisterSubmit() {
    const inputId = document.getElementById('inputRegisterId');
    const inputPw = document.getElementById('inputRegisterPw');
    const inputConfirm = document.getElementById('inputRegisterConfirm');
    const inputName = document.getElementById('inputRegisterName');
    const inputPhone = document.getElementById('inputRegisterPhone');
    const inputReferral = document.getElementById('inputRegisterReferral');
    const statusBox = document.getElementById('registerStatusBox');
    const btnSubmit = document.getElementById('btnSubmitRegister');

    const id = inputId?.value?.trim();
    const pw = inputPw?.value?.trim();
    const confirmPw = inputConfirm?.value?.trim();
    const name = inputName?.value?.trim();
    const phone = inputPhone?.value?.trim();
    const referral = inputReferral?.value?.trim() || '';

    const showRegisterStatus = (msg, isSuccess = false) => {
        if (!statusBox) return;
        statusBox.className = 'auth-admin-status ' + (isSuccess ? 'success' : 'error');
        if (isSuccess) {
            statusBox.innerHTML = `
                <div style="font-size: 12px; font-weight: 800; color: #065F46; margin-bottom: 6px;">가입 신청이 완료되었습니다!</div>
                <div style="font-size: 11px; line-height: 1.5; color: #047857;">관리자에게 신청 내역이 즉시 전달되었습니다.<br>관리자 승인 후 바로 이용하실 수 있습니다.</div>
            `;
        } else {
            statusBox.innerText = msg;
        }
        statusBox.style.display = 'block';
    };

    if (!id) {
        showRegisterStatus('아이디를 입력해주세요.');
        inputId?.focus();
        return;
    }
    if (id.length < 3) {
        showRegisterStatus('아이디를 3자 이상 입력해주세요.');
        inputId?.focus();
        return;
    }
    if (!pw) {
        showRegisterStatus('비밀번호를 입력해주세요.');
        inputPw?.focus();
        return;
    }
    if (pw.length < 2) {
        showRegisterStatus('비밀번호를 2자 이상 입력해주세요.');
        inputPw?.focus();
        return;
    }
    if (pw !== confirmPw) {
        showRegisterStatus('비밀번호 확인이 일치하지 않습니다.');
        inputConfirm?.focus();
        return;
    }
    if (!name) {
        showRegisterStatus('이름을 입력해주세요.');
        inputName?.focus();
        return;
    }
    if (!phone) {
        showRegisterStatus('연락처(휴대폰 번호)를 입력해주세요.');
        inputPhone?.focus();
        return;
    }
    const cleanPhone = phone.replace(/[^0-9]/g, '');
    if (cleanPhone.length < 9) {
        showRegisterStatus('올바른 연락처 번호를 입력해주세요.');
        inputPhone?.focus();
        return;
    }

    if (btnSubmit) {
        btnSubmit.disabled = true;
        btnSubmit.innerText = '신청 중...';
    }
    if (statusBox) statusBox.style.display = 'none';

    try {
        const result = await registerUserWithServer(id, pw, name, phone, referral);
        if (result && result.success) {
            showRegisterStatus('', true);
            if (referral) {
                showToast('가입신청 완료! (추천인 혜택 +15일이 적용되었습니다)');
            } else {
                showToast('가입신청 완료! 관리자 승인 후 사용하실 수 있습니다.');
            }
            const authInputId = document.getElementById('authInputId');
            const authInputPw = document.getElementById('authInputPw');
            if (authInputId) authInputId.value = id;
            if (authInputPw) authInputPw.value = pw;

            if (btnSubmit) {
                btnSubmit.disabled = true;
                btnSubmit.innerText = '신청 완료';
            }

            setTimeout(() => {
                closeRegisterModal();
            }, 3000);
        } else {
            showRegisterStatus(result?.message || '회원가입 신청에 실패했습니다.');
            if (btnSubmit) {
                btnSubmit.disabled = false;
                btnSubmit.innerText = '가입 신청하기';
            }
        }
    } catch(err) {
        showRegisterStatus('오류가 발생했습니다: ' + (err.message || err));
        if (btnSubmit) {
            btnSubmit.disabled = false;
            btnSubmit.innerText = '가입 신청하기';
        }
    }
}

async function handleAuthLoginSubmit() {
    const idInput = document.getElementById('authInputId');
    const pwInput = document.getElementById('authInputPw');
    const btnSubmit = document.getElementById('btnAuthSubmit');
    const spinner = document.getElementById('btnAuthSubmitSpinner');
    const btnText = document.getElementById('btnAuthSubmitText');

    const id = idInput?.value?.trim();
    const pw = pwInput?.value?.trim();

    if (!id || !pw) {
        showAuthAlert('아이디와 비밀번호를 모두 입력해주세요.', 'error');
        return;
    }

    if (isLockoutActive('login')) {
        const rem = getLockoutRemainingSeconds('login');
        showAuthAlert(`⛔ 로그인 연속 5회 실패로 1분간 잠겼습니다. (${rem}초 후 재시도)`, 'error');
        return;
    }

    if (btnSubmit) btnSubmit.disabled = true;
    if (spinner) spinner.style.display = 'inline-block';
    if (btnText) btnText.innerText = '로그인 중...';
    hideAuthAlert();

    try {
        const result = await verifyAuthWithServer(id, pw, false, true); // 신규 로그인 (새 세션 토큰 발급 및 기존 동시접속 자동 세션 종료)
        if (result && result.success) {
            resetLockoutAttempts('login');

            // [비밀번호 저장 체크박스 상태에 따른 저장/삭제 처리]
            const chkSave = document.getElementById('chkAuthAutoLogin');
            if (chkSave && chkSave.checked) {
                saveSavedCredentials(id, pw);
            } else {
                clearSavedCredentials();
            }

            showToast(`로그인 완료! (${result.user.name || result.user.id}님 / 만료일: ${result.user.expireDate})`);

            // ★ [로그인 직후 최신 버전 업데이트 즉시 검사]
            try {
                sessionStorage.removeItem('v2_update_dismissed'); // 로그인 시 새 버전 알림 활성화
                if (typeof window.checkForRemoteAppUpdate === 'function') {
                    setTimeout(() => {
                        window.checkForRemoteAppUpdate(false, true); // 재로그인 시 새 버전 즉시 모달 노출 (forceShow: true)
                    }, 300);
                }
            } catch(e) {}
        } else {
            recordFailedAttempt('login');
            if (isLockoutActive('login')) {
                const rem = getLockoutRemainingSeconds('login');
                showAuthAlert(`⛔ 비밀번호 5회 실패로 1분간 로그인이 잠겼습니다. (${rem}초 대기)`, 'error');
            }
        }
    } finally {
        if (btnSubmit) btnSubmit.disabled = false;
        if (spinner) spinner.style.display = 'none';
        if (btnText) btnText.innerText = '로그인';
    }
}

function initAuth() {
    initAntiInspection();
    startAuthHeartbeat();
    applySavedCredentialsToInputs();

    // 1. 저장된 API URL 로드 및 최신 서버 URL로 자동 강제 마이그레이션
    try {
        const savedVer = localStorage.getItem('v2_auth_api_version');
        const savedUrl = localStorage.getItem('v2_auth_api_url');
        if (savedVer !== CURRENT_AUTH_API_VERSION || !savedUrl || isLegacyAuthUrl(savedUrl)) {
            setAuthApiUrl(DEFAULT_AUTH_API_URL);
        } else {
            currentAuthApiUrl = savedUrl.trim();
        }
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.get(['v2_auth_api_url', 'v2_auth_api_version', 'v2_auth_user', 'v2_auth_invalidated_at', 'v2_auth_saved_credentials'], (res) => {
                if (res && res.v2_auth_saved_credentials) {
                    const sc = res.v2_auth_saved_credentials;
                    if (sc && sc.id && sc.pw) {
                        try { localStorage.setItem('v2_auth_saved_credentials', JSON.stringify(sc)); } catch(e) {}
                        applySavedCredentialsToInputs();
                    }
                }
                if (!res || res.v2_auth_api_version !== CURRENT_AUTH_API_VERSION || !res.v2_auth_api_url || isLegacyAuthUrl(res.v2_auth_api_url)) {
                    setAuthApiUrl(DEFAULT_AUTH_API_URL);
                } else {
                    currentAuthApiUrl = res.v2_auth_api_url.trim();
                }
                if (res && res.v2_auth_invalidated_at) {
                    if (typeof isCurrentUserAdmin === 'function' && isCurrentUserAdmin()) {
                        console.log('[AutomaTee Auth] 프로그램 업데이트 감지되었으나 관리자 세션이므로 로그인 유지');
                        try { chrome.storage.local.remove(['v2_auth_invalidated_at']); } catch(e) {}
                    } else {
                        console.log('[AutomaTee Auth] 프로그램 업데이트 감지 -> 로그인 유지 해제');
                        logoutUser(false);
                        try { chrome.storage.local.remove(['v2_auth_invalidated_at']); } catch(e) {}
                        return;
                    }
                }
                if (res && res.v2_auth_user) {
                    processLoadedAuthUser(res.v2_auth_user);
                }
            });
        }
    } catch(e) {}

    // 2. 저장된 회원 세션 로드 (버전 변경 시 일반 회원은 로그인 유지 자동 해제, 관리자는 유지)
    let savedUser = null;
    try {
        const curManifestVer = getCurrentAuthAppVersion();
        const savedAuthVer = localStorage.getItem('v2_auth_app_version');
        if (curManifestVer && savedAuthVer !== curManifestVer) {
            if (typeof isCurrentUserAdmin === 'function' && isCurrentUserAdmin()) {
                console.log(`[AutomaTee Auth] 버전 업데이트 감지 (${savedAuthVer || '이전'} -> ${curManifestVer}) -> 관리자 계정이므로 세션 유지`);
                localStorage.setItem('v2_auth_app_version', curManifestVer);
                const str = localStorage.getItem('v2_auth_user');
                if (str) savedUser = JSON.parse(str);
            } else {
                console.log(`[AutomaTee Auth] 버전 업데이트 감지 (${savedAuthVer || '이전'} -> ${curManifestVer}) -> 로그인 세션 초기화`);
                logoutUser(false);
                localStorage.setItem('v2_auth_app_version', curManifestVer);
            }
        } else {
            const str = localStorage.getItem('v2_auth_user');
            if (str) savedUser = JSON.parse(str);
        }
    } catch(e) {}

    processLoadedAuthUser(savedUser);

    // 3. UI 이벤트 바인딩
    // [로그인 폼]
    const loginForm = document.getElementById('authLoginForm');
    if (loginForm) {
        loginForm.addEventListener('submit', (e) => {
            e.preventDefault();
            handleAuthLoginSubmit();
        });
    }

    const btnLogout = document.getElementById('btnPillLogout');
    if (btnLogout) {
        btnLogout.addEventListener('click', (e) => {
            e.stopPropagation();
            if (confirm('로그아웃 하시겠습니까?')) {
                logoutUser(true);
            }
        });
    }

    // 회원가입 신청 모달 바인딩
    const btnOpenRegister = document.getElementById('btnOpenRegisterModal');
    const btnCloseRegister = document.getElementById('btnCloseRegisterModal');
    const btnCancelRegister = document.getElementById('btnCancelRegister');
    const btnSubmitRegister = document.getElementById('btnSubmitRegister');
    const formRegister = document.getElementById('formRegister');
    const registerModal = document.getElementById('authRegisterModal');
    const btnToggleRegisterPw = document.getElementById('btnToggleRegisterPw');
    const inputRegisterPw = document.getElementById('inputRegisterPw');

    if (btnOpenRegister) {
        btnOpenRegister.addEventListener('click', () => {
            openRegisterModal();
        });
    }
    if (btnCloseRegister) {
        btnCloseRegister.addEventListener('click', closeRegisterModal);
    }
    if (btnCancelRegister) {
        btnCancelRegister.addEventListener('click', closeRegisterModal);
    }
    if (btnSubmitRegister) {
        btnSubmitRegister.addEventListener('click', handleRegisterSubmit);
    }
    if (formRegister) {
        formRegister.addEventListener('submit', (e) => {
            e.preventDefault();
            handleRegisterSubmit();
        });
    }
    if (registerModal) {
        registerModal.addEventListener('click', (e) => {
            if (e.target === registerModal) {
                closeRegisterModal();
            }
        });
    }
    if (btnToggleRegisterPw && inputRegisterPw) {
        btnToggleRegisterPw.addEventListener('click', () => {
            const isPw = inputRegisterPw.type === 'password';
            inputRegisterPw.type = isPw ? 'text' : 'password';
            btnToggleRegisterPw.innerText = isPw ? '🙈' : '👁️';
        });
    }

    // 비밀번호 변경 모달 바인딩
    const btnPillChangePw = document.getElementById('btnPillChangePw');
    const btnOpenChangePw = document.getElementById('btnOpenChangePwModal');
    const btnCloseChangePw = document.getElementById('btnCloseChangePwModal');
    const btnCancelChangePw = document.getElementById('btnCancelChangePw');
    const btnSubmitChangePw = document.getElementById('btnSubmitChangePw');
    const formChangePw = document.getElementById('formChangePw');
    const changePwModal = document.getElementById('authChangePwModal');

    if (btnPillChangePw) {
        btnPillChangePw.addEventListener('click', (e) => {
            e.stopPropagation();
            openChangePwModal();
        });
    }
    if (btnOpenChangePw) {
        btnOpenChangePw.addEventListener('click', () => {
            openChangePwModal();
        });
    }
    if (btnCloseChangePw) {
        btnCloseChangePw.addEventListener('click', closeChangePwModal);
    }
    if (btnCancelChangePw) {
        btnCancelChangePw.addEventListener('click', closeChangePwModal);
    }
    if (btnSubmitChangePw) {
        btnSubmitChangePw.addEventListener('click', handleChangePwSubmit);
    }
    if (formChangePw) {
        formChangePw.addEventListener('submit', (e) => {
            e.preventDefault();
            handleChangePwSubmit();
        });
    }
    if (changePwModal) {
        changePwModal.addEventListener('click', (e) => {
            if (e.target === changePwModal) {
                closeChangePwModal();
            }
        });
    }

    const btnTogglePw = document.getElementById('btnToggleAuthPw');
    const inputPw = document.getElementById('authInputPw');
    const inputId = document.getElementById('authInputId');
    if (btnTogglePw && inputPw) {
        btnTogglePw.addEventListener('click', () => {
            const isPw = inputPw.type === 'password';
            inputPw.type = isPw ? 'text' : 'password';
            btnTogglePw.innerText = isPw ? '🙈' : '👁️';
        });
    }

    // ★ 모바일(갤럭시 폴드 등) 사이드패널에서 아이디/비밀번호 터치 시 팝업 키보드가 올라왔다가 바로 닫히는 현상 완벽 방어 + 내장 화면키패드 지원
    (function initMobileAuthInputStabilizer() {
        const authInputs = [inputId, inputPw].filter(Boolean);
        let activeTargetInput = inputId || inputPw || null;
        let lastTouchTs = 0;
        let vkbShift = false;
        const vkbPanel = document.getElementById('authVirtualKeypad');
        const btnToggleVkb = document.getElementById('btnToggleAuthVkb');

        function highlightActiveInput() {
            authInputs.forEach(inp => {
                if (inp === activeTargetInput) {
                    inp.style.borderColor = '#10B981';
                    inp.style.boxShadow = '0 0 0 2px rgba(16, 185, 129, 0.28)';
                } else {
                    inp.style.borderColor = '';
                    inp.style.boxShadow = '';
                }
            });
        }

        function renderVirtualKeypad() {
            if (!vkbPanel) return;
            vkbPanel.innerHTML = '';

            const rows = vkbShift
                ? [
                    ['!', '@', '#', '$', '%', '^', '&', '*', '_', '-'],
                    ['Q', 'W', 'E', 'R', 'T', 'Y', 'U', 'I', 'O', 'P'],
                    ['A', 'S', 'D', 'F', 'G', 'H', 'J', 'K', 'L', '.'],
                    ['SHIFT', 'Z', 'X', 'C', 'V', 'B', 'N', 'M', '⌫']
                ]
                : [
                    ['1', '2', '3', '4', '5', '6', '7', '8', '9', '0'],
                    ['q', 'w', 'e', 'r', 't', 'y', 'u', 'i', 'o', 'p'],
                    ['a', 's', 'd', 'f', 'g', 'h', 'j', 'k', 'l', '_'],
                    ['SHIFT', 'z', 'x', 'c', 'v', 'b', 'n', 'm', '⌫']
                ];

            const topBar = document.createElement('div');
            topBar.className = 'auth-vkb-row';
            topBar.style.marginBottom = '2px';

            const btnTargetId = document.createElement('button');
            btnTargetId.type = 'button';
            btnTargetId.className = 'auth-vkb-key fn-key';
            btnTargetId.style.background = activeTargetInput === inputId ? '#059669' : 'rgba(255,255,255,0.08)';
            btnTargetId.innerText = '아이디 입력중';
            btnTargetId.addEventListener('click', (e) => {
                e.preventDefault();
                activeTargetInput = inputId;
                highlightActiveInput();
                renderVirtualKeypad();
            });

            const btnTargetPw = document.createElement('button');
            btnTargetPw.type = 'button';
            btnTargetPw.className = 'auth-vkb-key fn-key';
            btnTargetPw.style.background = activeTargetInput === inputPw ? '#059669' : 'rgba(255,255,255,0.08)';
            btnTargetPw.innerText = '비밀번호 입력중';
            btnTargetPw.addEventListener('click', (e) => {
                e.preventDefault();
                activeTargetInput = inputPw;
                highlightActiveInput();
                renderVirtualKeypad();
            });

            const btnClear = document.createElement('button');
            btnClear.type = 'button';
            btnClear.className = 'auth-vkb-key del-key';
            btnClear.innerText = '전체지움';
            btnClear.addEventListener('click', (e) => {
                e.preventDefault();
                if (activeTargetInput) {
                    activeTargetInput.value = '';
                    activeTargetInput.dispatchEvent(new Event('input', { bubbles: true }));
                }
            });

            topBar.appendChild(btnTargetId);
            topBar.appendChild(btnTargetPw);
            topBar.appendChild(btnClear);
            vkbPanel.appendChild(topBar);

            rows.forEach(r => {
                const rowEl = document.createElement('div');
                rowEl.className = 'auth-vkb-row';
                r.forEach(k => {
                    const keyBtn = document.createElement('button');
                    keyBtn.type = 'button';
                    keyBtn.className = 'auth-vkb-key';
                    if (k === 'SHIFT') {
                        keyBtn.classList.add('fn-key');
                        keyBtn.innerText = vkbShift ? '소문자/숫자' : '대문자/기호';
                    } else if (k === '⌫') {
                        keyBtn.classList.add('del-key');
                        keyBtn.innerText = '← 지움';
                    } else {
                        keyBtn.innerText = k;
                    }
                    keyBtn.addEventListener('click', (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        if (!activeTargetInput) activeTargetInput = inputId || inputPw;
                        if (k === 'SHIFT') {
                            vkbShift = !vkbShift;
                            renderVirtualKeypad();
                            return;
                        }
                        if (k === '⌫') {
                            activeTargetInput.value = String(activeTargetInput.value || '').slice(0, -1);
                        } else {
                            activeTargetInput.value = String(activeTargetInput.value || '') + k;
                        }
                        activeTargetInput.dispatchEvent(new Event('input', { bubbles: true }));
                    });
                    rowEl.appendChild(keyBtn);
                });
                vkbPanel.appendChild(rowEl);
            });
        }

        if (btnToggleVkb && vkbPanel) {
            btnToggleVkb.addEventListener('click', (e) => {
                e.preventDefault();
                const isOpen = vkbPanel.style.display === 'flex';
                vkbPanel.style.display = isOpen ? 'none' : 'flex';
                if (!isOpen) {
                    if (!activeTargetInput) activeTargetInput = inputId || inputPw;
                    highlightActiveInput();
                    renderVirtualKeypad();
                }
            });
        }

        authInputs.forEach(inp => {
            inp.addEventListener('touchstart', () => {
                lastTouchTs = Date.now();
                activeTargetInput = inp;
                document.body.classList.add('kb-open');
                highlightActiveInput();
                if (vkbPanel && vkbPanel.style.display === 'flex') renderVirtualKeypad();
            }, { passive: true });

            inp.addEventListener('focus', () => {
                activeTargetInput = inp;
                document.body.classList.add('kb-open');
                highlightActiveInput();
                if (vkbPanel && vkbPanel.style.display === 'flex') renderVirtualKeypad();
            });

            inp.addEventListener('blur', () => {
                const elapsed = Date.now() - lastTouchTs;
                // 터치 후 600ms 이내에 비정상적으로 포커스가 풀리면(모바일 키보드 올라오다 닫히는 현상) 즉시 포커스 복구 및 화면키패드 자동 활성화
                if (elapsed >= 0 && elapsed < 600) {
                    setTimeout(() => {
                        if (document.activeElement !== inputId && document.activeElement !== inputPw) {
                            try { inp.focus({ preventScroll: true }); } catch (err) { try { inp.focus(); } catch (e2) {} }
                            if (vkbPanel && vkbPanel.style.display !== 'flex') {
                                vkbPanel.style.display = 'flex';
                                renderVirtualKeypad();
                            }
                        }
                    }, 30);
                }
            });
        });
    })();

    // 카카오톡 비즈니스 채널 (오토매티 솔루션) 1:1 채팅 연동
    const KAKAO_CHAT_URL = 'http://pf.kakao.com/_RxbSNX/chat';
    const handleOpenKakao = (e) => {
        if (e && e.preventDefault) e.preventDefault();
        try {
            if (typeof chrome !== 'undefined' && chrome.tabs && chrome.tabs.create) {
                chrome.tabs.create({ url: KAKAO_CHAT_URL });
            } else {
                window.open(KAKAO_CHAT_URL, '_blank');
            }
        } catch(err) {
            window.open(KAKAO_CHAT_URL, '_blank');
        }
    };

    const btnFooterKakao = document.getElementById('btnFooterKakao');
    if (btnFooterKakao) btnFooterKakao.addEventListener('click', handleOpenKakao);

    // 관리자 구글 시트 모달 바인딩 (비밀번호 보호)
    const btnOpenAdmin = document.getElementById('btnOpenAuthAdminModal');
    const adminModal = document.getElementById('authAdminModal');
    const btnCloseAdmin = document.getElementById('btnCloseAuthAdminModal');
    const adminModalTitle = document.getElementById('authAdminModalTitle');
    const adminPwStep = document.getElementById('adminPwStep');
    const adminMainStep = document.getElementById('adminMainStep');
    const inputAdminMasterPw = document.getElementById('inputAdminMasterPw');
    const adminMasterPwError = document.getElementById('adminMasterPwError');
    const btnVerifyAdminPw = document.getElementById('btnVerifyAdminPw');

    const btnSaveAdmin = document.getElementById('btnSaveAuthAdminUrl');
    const btnTestAdmin = document.getElementById('btnTestAuthAdminUrl');
    const inputAdminUrl = document.getElementById('inputAuthAdminUrl');
    const statusBox = document.getElementById('authAdminStatusBox');

    function resetAdminModalState() {
        if (adminPwStep) adminPwStep.style.display = 'block';
        if (adminMainStep) adminMainStep.style.display = 'none';
        if (adminModalTitle) adminModalTitle.innerText = '관리자 인증';
        if (inputAdminMasterPw) inputAdminMasterPw.value = '';
        if (adminMasterPwError) adminMasterPwError.style.display = 'none';
        if (statusBox) statusBox.style.display = 'none';
    }

    if (btnOpenAdmin && adminModal) {
        btnOpenAdmin.addEventListener('click', () => {
            resetAdminModalState();
            adminModal.style.display = 'flex';
            setTimeout(() => {
                inputAdminMasterPw?.focus();
            }, 100);
        });
    }

    function verifyAdminPassword() {
        if (isLockoutActive('admin')) {
            const rem = getLockoutRemainingSeconds('admin');
            if (adminMasterPwError) {
                adminMasterPwError.innerText = `⛔ 5회 실패로 1분간 잠겼습니다. (${rem}초 대기)`;
                adminMasterPwError.style.display = 'block';
            }
            return;
        }

        const entered = inputAdminMasterPw?.value || '';
        if (timingSafeEqual(entered, _0xad)) {
            resetLockoutAttempts('admin');
            if (adminPwStep) adminPwStep.style.display = 'none';
            if (adminMainStep) adminMainStep.style.display = 'block';
            if (adminModalTitle) adminModalTitle.innerText = '⚙️ 구글 스프레드시트 인증 서버 설정';
            if (inputAdminUrl) inputAdminUrl.value = getAuthApiUrl();
            if (statusBox) statusBox.style.display = 'none';
        } else {
            recordFailedAttempt('admin');
            if (adminMasterPwError) {
                if (isLockoutActive('admin')) {
                    const rem = getLockoutRemainingSeconds('admin');
                    adminMasterPwError.innerText = `⛔ 비밀번호 5회 실패로 1분간 잠겼습니다. (${rem}초 대기)`;
                } else {
                    const fails = getFailedAttempts('admin');
                    adminMasterPwError.innerText = `비밀번호가 올바르지 않습니다. (${fails}/5회 실패)`;
                }
                adminMasterPwError.style.display = 'block';
            }
            if (inputAdminMasterPw) {
                inputAdminMasterPw.value = '';
                inputAdminMasterPw.focus();
            }
        }
    }

    if (btnVerifyAdminPw) {
        btnVerifyAdminPw.addEventListener('click', verifyAdminPassword);
    }

    if (inputAdminMasterPw) {
        inputAdminMasterPw.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                verifyAdminPassword();
            }
        });
    }

    if (btnCloseAdmin && adminModal) {
        btnCloseAdmin.addEventListener('click', () => {
            adminModal.style.display = 'none';
            resetAdminModalState();
        });
    }

    if (btnSaveAdmin) {
        btnSaveAdmin.addEventListener('click', () => {
            let rawUrl = inputAdminUrl?.value?.trim() || '';
            const newUrl = cleanGoogleWebAppUrl(rawUrl);
            if (inputAdminUrl) inputAdminUrl.value = newUrl;

            if (newUrl.includes('/macros/s/') && newUrl.length < 80) {
                if (statusBox) {
                    statusBox.innerText = '⚠️ 웹 앱 URL 주소가 중간에 잘린 것 같습니다!\n\n현재 주소: ' + newUrl + '\n\n💡 정상 주소는 85~105자 정도입니다.\n크롬 주소창에서 정상 작동했던 주소를 전체 복사하여 붙여넣어 주세요!';
                    statusBox.className = 'auth-admin-status error';
                    statusBox.style.display = 'block';
                }
                return;
            }
            setAuthApiUrl(newUrl);
            if (statusBox) {
                statusBox.innerText = '인증서버 URL이 성공적으로 저장되었습니다.';
                statusBox.className = 'auth-admin-status success';
                statusBox.style.display = 'block';
            }
            showToast('인증서버 URL 저장 완료');
            setTimeout(() => {
                if (adminModal) adminModal.style.display = 'none';
                hideAuthAlert();
            }, 1000);
        });
    }

    if (btnTestAdmin) {
        btnTestAdmin.addEventListener('click', async () => {
            let rawUrl = inputAdminUrl?.value?.trim();
            if (!rawUrl) {
                if (statusBox) {
                    statusBox.innerText = 'URL을 입력해주세요.';
                    statusBox.className = 'auth-admin-status error';
                    statusBox.style.display = 'block';
                }
                return;
            }

            const testUrl = cleanGoogleWebAppUrl(rawUrl);
            if (inputAdminUrl) inputAdminUrl.value = testUrl;

            // URL 길이 검증
            if (testUrl.includes('/macros/s/') && testUrl.length < 80) {
                if (statusBox) {
                    statusBox.innerText = '⚠️ 웹 앱 URL 주소가 중간에 잘린 것 같습니다!\n\n현재 주소: ' + testUrl + '\n\n💡 정상 주소는 85~105자 정도입니다.\n크롬 주소창에서 정상 작동했던 주소를 전체 복사하여 붙여넣어 주세요!';
                    statusBox.className = 'auth-admin-status error';
                    statusBox.style.display = 'block';
                }
                return;
            }

            btnTestAdmin.disabled = true;
            btnTestAdmin.innerText = '테스트 중...';
            try {
                // 1. 브라우저에서 검증된 GET 방식으로 먼저 확인
                const pingUrl = testUrl + '?action=ping';
                let resp = await fetch(pingUrl, { method: 'GET', redirect: 'follow' });
                let text = await resp.text();

                // 2. 만약 GET 응답이 HTML일 경우, POST 방식으로 자동 재시도
                if (!text.trim().startsWith('{')) {
                    try {
                        const postResp = await fetch(testUrl, {
                            method: 'POST',
                            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                            body: JSON.stringify({ action: 'ping' }),
                            redirect: 'follow'
                        });
                        const postText = await postResp.text();
                        if (postText.trim().startsWith('{')) {
                            text = postText;
                        }
                    } catch(err) {}
                }

                let json = null;
                try {
                    json = JSON.parse(text);
                } catch(parseErr) {
                    let title = '';
                    const titleMatch = text.match(/<title>([^<]+)<\/title>/i);
                    if (titleMatch) title = titleMatch[1].trim();
                    let cleanSnippet = text.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 160);

                    throw new Error(`구글 서버에서 JSON 데이터 대신 웹페이지(HTML)가 응답되었습니다.\n\n[페이지 제목: ${title || '구글 로그인/오류'}]\n${cleanSnippet}\n\n💡 해결 방법:\n1. 구글 Apps Script 편집기 상단의 [▶️ 실행] 버튼을 눌러 [권한 검토 → 고급 → 허용] 승인을 완료하세요.\n2. 상단 [배포] → [새 배포]를 눌러 새로 배포해 주세요!`);
                }

                if (json && (json.success || json.message)) {
                    if (statusBox) {
                        statusBox.innerText = '🟢 연결 성공! 구글 스프레드시트 서버가 정상 응답합니다. [저장하기]를 누르세요.';
                        statusBox.className = 'auth-admin-status success';
                        statusBox.style.display = 'block';
                    }
                } else {
                    throw new Error(json?.message || '비정상 응답');
                }
            } catch(e) {
                if (statusBox) {
                    const errStr = e.message || String(e);
                    let tip = '';
                    if (errStr.includes('Failed to fetch') || errStr.includes('NetworkError')) {
                        tip = '\n\n💡 해결 방법:\n1. 크롬 주소창에 chrome://extensions 접속\n2. GolfTee82 카드의 [새로고침 🔄] 아이콘 클릭\n(새 권한 반영을 위해 최초 1회 필수입니다!)';
                    }
                    statusBox.innerText = `🔴 연결 실패:\n${errStr}${tip}`;
                    statusBox.className = 'auth-admin-status error';
                    statusBox.style.display = 'block';
                }
            } finally {
                btnTestAdmin.disabled = false;
                btnTestAdmin.innerText = '연결 테스트';
            }
        });
    }
}

function processLoadedAuthUser(user) {
    if (!user || !user.isLoggedIn) {
        applySavedCredentialsToInputs();
        showAuthOverlay();
        applyUserPermissionsUI();
        return;
    }

    // 🔄 프로그램 업데이트(버전 변경) 시 로그인 유지 자동 해제
    const curManifestVer = getCurrentAuthAppVersion();
    if (curManifestVer && user.appVersion !== curManifestVer) {
        console.log(`[AutomaTee Auth] 업데이트로 인한 버전 변경 감지 (${user.appVersion || '구버전'} -> ${curManifestVer}) -> 재로그인 요청`);
        logoutUser(false, true);
        try { localStorage.setItem('v2_auth_app_version', curManifestVer); } catch(e) {}
        applySavedCredentialsToInputs();
        showAuthOverlay();
        return;
    }

    // ⏰ [24시간(하루) 세션 유효기간 검사] 하루가 지나면 로그인 만료 (비밀번호 저장이 켜져 있으면 자동 입력된 상태로 대기)
    const ONE_DAY_MS = 24 * 60 * 60 * 1000;
    const loginTs = Number(user.loggedInAt) || Number(user.savedAt) || Number(user.lastVerifiedAt) || 0;
    const sessionAge = Date.now() - loginTs;
    if (!user.isAdmin && loginTs > 0 && sessionAge > ONE_DAY_MS) {
        console.log(`[AutomaTee Auth] 24시간 세션 유효기간 만료 (${Math.round(sessionAge / 3600000)}시간 경과) -> 로그아웃 및 재로그인 유도`);
        logoutUser(false, true);
        applySavedCredentialsToInputs();
        showAuthOverlay('⏰ 보안을 위해 로그인 후 24시간이 경과하여 세션이 만료되었습니다.\n[로그인] 버튼을 누르시면 바로 시작됩니다.', 'info');
        return;
    }

    // 🛡️ 세션 무결성 검증 (데이터 위변조 방어)
    if (!verifySessionIntegrity(user)) {
        console.warn('[Tee82 Security] 세션 무결성 훼손 또는 위변조 감지! 세션을 초기화합니다.');
        logoutUser(false, true);
        applySavedCredentialsToInputs();
        showAuthOverlay('인증 정보가 변조되었거나 유효하지 않습니다. 다시 로그인해주세요.', 'error');
        return;
    }

    currentAuthUser = user;
    try {
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.set({ v2_isAdmin: isCurrentUserAdmin() });
        }
    } catch(e) {}

    // 라이선스 키 회원인 경우 로컬 즉시 검증
    if (user.authType === 'license' && user.licenseKey) {
        const verify = verifyLicenseKey(user.name || user.id, user.licenseKey);
        if (!verify.valid) {
            logoutUser(false, true);
            applySavedCredentialsToInputs();
            showAuthOverlay(verify.message, 'error');
            return;
        }
        currentAuthUser.expireDate = verify.expireDate;
        currentAuthUser.daysLeft = verify.daysLeft;
        updateAuthUI(currentAuthUser);
        applyUserPermissionsUI();
        hideAuthOverlay();
        if (typeof window.checkForRemoteAppUpdate === 'function') {
            window.checkForRemoteAppUpdate(false);
        }
        return;
    }

    // 구글 시트 회원인 경우
    const idInput = document.getElementById('authInputId');
    const pwInput = document.getElementById('authInputPw');
    if (idInput && user.id) idInput.value = user.id;
    if (pwInput && user.pw) pwInput.value = user.pw;

    // 만료일 로컬 검증
    if (user.expireDate) {
        const now = new Date();
        const exp = new Date(user.expireDate + 'T23:59:59');
        if (now.getTime() > exp.getTime()) {
            logoutUser(false, true);
            applySavedCredentialsToInputs();
            showAuthOverlay(`사용 기간이 만료되었습니다. (${user.expireDate} 만료)\n관리자에게 연장을 요청하세요.`, 'error');
            return;
        }
    }

    // UI 먼저 표시 및 권한 적용
    updateAuthUI(user);
    applyUserPermissionsUI();
    hideAuthOverlay();

    // 백그라운드에서 구글 시트와 실시간 대조 (관리자가 차단했거나 만료일 변경 시 즉각 반영)
    if (user.id && user.pw) {
        verifyAuthWithServer(user.id, user.pw, true).then(() => {
            if (typeof window.checkForRemoteAppUpdate === 'function') {
                window.checkForRemoteAppUpdate(false);
            }
        });
    }

    // ⏱️ 자동 끌어올리기 타이머 초기화
    try {
        initBumpTimer();
    } catch(e) {
        console.warn('타이머 모듈 초기화 에러:', e);
    }
}

// ==========================================
// ⏱️ 자동 끌어올리기 타이머 모듈
// ==========================================
let bumpTimerIntervalId = null;
let bumpTimerSecondsLeft = 30 * 60;
let bumpTimerConfig = {
    enabled: false,
    intervalMin: 30,
    mode: 'smart' // 'smart' (스마트수정), 'full' (전체수정), 'multi' (동시등록)
};

function loadBumpTimerConfig() {
    try {
        const saved = localStorage.getItem('v2_bump_timer_config');
        if (saved) {
            const parsed = JSON.parse(saved);
            bumpTimerConfig = Object.assign(bumpTimerConfig, parsed);
        }
    } catch(e) {}
}

function saveBumpTimerConfig() {
    try {
        localStorage.setItem('v2_bump_timer_config', JSON.stringify(bumpTimerConfig));
    } catch(e) {}
}

function formatTimerSeconds(sec) {
    const m = Math.floor(sec / 60);
    const s = sec % 60;
    return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
}

function updateBumpTimerBannerUI() {
    const banner = document.getElementById('refreshTimerActiveBar');
    const countdownEl = document.getElementById('refreshTimerCountdown');
    const modeBadgeEl = document.getElementById('refreshTimerModeBadge');
    if (!banner) return;

    if (!bumpTimerConfig.enabled) {
        banner.style.display = 'none';
        return;
    }

    banner.style.display = 'flex';
    if (countdownEl) countdownEl.textContent = formatTimerSeconds(bumpTimerSecondsLeft);
    if (modeBadgeEl) {
        if (bumpTimerConfig.mode === 'full') modeBadgeEl.textContent = '[전체수정]';
        else if (bumpTimerConfig.mode === 'multi') modeBadgeEl.textContent = '[6대동시]';
        else modeBadgeEl.textContent = '[스마트수정]';
    }
}

function startBumpTimer() {
    stopBumpTimer(false);
    bumpTimerConfig.enabled = true;
    saveBumpTimerConfig();

    const intervalMinutes = parseInt(bumpTimerConfig.intervalMin, 10) || 30;
    bumpTimerSecondsLeft = intervalMinutes * 60;
    updateBumpTimerBannerUI();

    bumpTimerIntervalId = setInterval(() => {
        bumpTimerSecondsLeft--;
        if (bumpTimerSecondsLeft <= 0) {
            executeBumpAction();
            const resetMinutes = parseInt(bumpTimerConfig.intervalMin, 10) || 30;
            bumpTimerSecondsLeft = resetMinutes * 60;
        }
        updateBumpTimerBannerUI();
    }, 1000);
}

function stopBumpTimer(disable = true) {
    if (bumpTimerIntervalId) {
        clearInterval(bumpTimerIntervalId);
        bumpTimerIntervalId = null;
    }
    if (disable) {
        bumpTimerConfig.enabled = false;
        saveBumpTimerConfig();
        const banner = document.getElementById('refreshTimerActiveBar');
        if (banner) banner.style.display = 'none';
    }
}

function executeBumpAction() {
    const trs = document.querySelectorAll('#dataTable tbody tr');
    if (trs.length === 0) {
        showToast('⏱️ [자동 끌어올리기] 대기 중인 티타임이 없어 실행을 건너뜁니다.');
        return;
    }

    const mode = bumpTimerConfig.mode || 'smart';
    if (mode === 'smart') {
        showToast('⏱️ [자동 끌어올리기] 골프몬 스마트수정으로 최상단 갱신을 시작합니다.');
        if (typeof startGolfmonPostReplacement === 'function') {
            startGolfmonPostReplacement(false);
        }
    } else if (mode === 'full') {
        showToast('⏱️ [자동 끌어올리기] 골프몬 전체수정(강제갱신)을 시작합니다.');
        if (typeof startGolfmonPostReplacement === 'function') {
            startGolfmonPostReplacement(true);
        }
    } else if (mode === 'multi') {
        showToast('⏱️ [자동 끌어올리기] 6대 플랫폼 동시등록을 시작합니다.');
        const btnMulti = document.getElementById('btnRegisterMultiPlatform');
        if (btnMulti) btnMulti.click();
    }
}

function openBumpTimerModal() {
    loadBumpTimerConfig();
    const modal = document.getElementById('refreshTimerModal');
    const chkEnable = document.getElementById('chkTimerEnable');
    const selInterval = document.getElementById('selectTimerInterval');
    const selAction = document.getElementById('selectTimerAction');
    const textStatus = document.getElementById('textTimerModalStatus');

    if (chkEnable) chkEnable.checked = bumpTimerConfig.enabled;
    if (selInterval) selInterval.value = String(bumpTimerConfig.intervalMin || 30);
    if (selAction) selAction.value = bumpTimerConfig.mode || 'smart';
    if (textStatus) {
        if (bumpTimerConfig.enabled) {
            textStatus.textContent = `동작 중 (${bumpTimerConfig.intervalMin}분 주기)`;
            textStatus.style.color = '#10B981';
        } else {
            textStatus.textContent = '정지됨';
            textStatus.style.color = '#64748B';
        }
    }

    if (modal) modal.style.display = 'flex';
}

function closeBumpTimerModal() {
    const modal = document.getElementById('refreshTimerModal');
    if (modal) modal.style.display = 'none';
}

function handleSaveBumpTimerModal() {
    const chkEnable = document.getElementById('chkTimerEnable');
    const selInterval = document.getElementById('selectTimerInterval');
    const selAction = document.getElementById('selectTimerAction');

    bumpTimerConfig.intervalMin = parseInt(selInterval?.value, 10) || 30;
    bumpTimerConfig.mode = selAction?.value || 'smart';

    if (chkEnable && chkEnable.checked) {
        startBumpTimer();
        showToast(`⏱️ 자동 끌어올리기 타이머가 시작되었습니다! (${bumpTimerConfig.intervalMin}분 주기)`);
    } else {
        stopBumpTimer(true);
        showToast('⏱️ 자동 끌어올리기 타이머가 중지되었습니다.');
    }
    closeBumpTimerModal();
}

function initBumpTimer() {
    loadBumpTimerConfig();
    const isBumpTimerOpen = isCurrentUserAdmin() && localStorage.getItem('v2_labModeActive') === 'true' && localStorage.getItem('v2_bumpTimerFeatureActive') === 'true';
    if (isBumpTimerOpen && bumpTimerConfig.enabled) {
        startBumpTimer();
    }

    document.getElementById('btnOpenRefreshTimer')?.addEventListener('click', openBumpTimerModal);
    document.getElementById('btnCloseRefreshTimerModal')?.addEventListener('click', closeBumpTimerModal);
    document.getElementById('btnCancelTimerModal')?.addEventListener('click', closeBumpTimerModal);
    document.getElementById('btnSaveTimerModal')?.addEventListener('click', handleSaveBumpTimerModal);

    document.getElementById('btnTimerRunNow')?.addEventListener('click', () => {
        executeBumpAction();
        bumpTimerSecondsLeft = (parseInt(bumpTimerConfig.intervalMin, 10) || 30) * 60;
        updateBumpTimerBannerUI();
    });

    document.getElementById('btnTimerStopBar')?.addEventListener('click', () => {
        stopBumpTimer(true);
        showToast('⏱️ 자동 끌어올리기 타이머가 중지되었습니다.');
    });

    const modal = document.getElementById('refreshTimerModal');
    if (modal) {
        modal.addEventListener('click', (e) => {
            if (e.target === modal) closeBumpTimerModal();
        });
    }
}

