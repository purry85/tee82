    document.getElementById('btnOpenGolfrock')?.addEventListener('click', () => chrome.tabs.create({ url: "https://m.golfrock.co.kr/join_new_sub.asp" }));
    document.getElementById('btnOpenGolfland')?.addEventListener('click', () => chrome.tabs.create({ url: "https://golfland.co.kr/web/booking/bookingMain.php" }));
    document.getElementById('btnOpenGolftop')?.addEventListener('click', () => chrome.tabs.create({ url: "https://intra.golftop.kr/Manage/Main" }));
    const btnOpenNewTab = document.getElementById('btnOpenNewTab');
    if (btnOpenNewTab) btnOpenNewTab.addEventListener('click', () => chrome.tabs.create({ url: chrome.runtime.getURL('popup.html') }));
    
    // 등록문구 설정 토글 (열기 ↔ 닫기)
    const toggleMemoDrawer = () => {
        const drawer = document.getElementById('memoDrawer');
        if (!drawer) return;
        const isOpen = drawer.style.display === 'block';
        if (isOpen) {
            drawer.style.display = 'none';
        } else {
            drawer.style.display = 'block';
            updateCourseMemoDatalist();
            drawer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    };

    document.getElementById('btnToggleMemo')?.addEventListener('click', toggleMemoDrawer);
    document.getElementById('btnToggleMemoRock')?.addEventListener('click', toggleMemoDrawer);
    document.getElementById('btnToggleMemoTop')?.addEventListener('click', toggleMemoDrawer);

    // 사이트 바로가기 서브 메뉴 토글 (개별 사이트 선택)
    const btnToggleSiteShortcuts = document.getElementById('btnToggleSiteShortcuts');
    const siteShortcutsSublist = document.getElementById('siteShortcutsSublist');
    const siteShortcutsArrow = document.getElementById('siteShortcutsArrow');
    if (btnToggleSiteShortcuts && siteShortcutsSublist) {
        btnToggleSiteShortcuts.addEventListener('click', (e) => {
            e.stopPropagation();
            const isHidden = siteShortcutsSublist.style.display === 'none' || !siteShortcutsSublist.style.display;
            siteShortcutsSublist.style.display = isHidden ? 'block' : 'none';
