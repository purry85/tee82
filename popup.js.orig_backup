        golmarket: '더반', golfland: '더반cc(P9)', golftop: '더반cc(P9)',
        name: '더반cc(P9)', region: '경기남부'
    };
    for (const k of ['더반', '더반cc', '더반(p9)', '더반cc(p9)', '더반cc(P9)']) {
