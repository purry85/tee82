        updateProgress(1, items.length, items[0].golf, items[0].date, items[0].time);
    }

    const targetUrl = 'https://intra.golftop.kr/Manage/Main';

    // 골프탑 탭 탐색 및 실행
    chrome.tabs.query({ url: ["*://*.golftop.kr/*", "https://golftop.kr/*", "http://golftop.kr/*", "*://intra.golftop.kr/*", "https://intra.golftop.kr/*", "http://intra.golftop.kr/*"] }, (tabs) => {
        if (tabs && tabs.length > 0) {
            const golftopTab = tabs[0];
            const currentTabUrl = golftopTab.url || '';
            const isAlreadyOnMain = currentTabUrl.includes('Manage/Main');

            if (isAlreadyOnMain) {
                chrome.tabs.update(golftopTab.id, { active: true }, () => {
                    const startPayload = {
                        action: 'START_GOLFTOP_REGISTRATION',
                        isAdmin: isCurrentUserAdmin(),
                        items: items,
                        memo: memo,
                        mode: mode,
                        delayPreset: delayPreset,
                        stepPreset: stepPreset
                    };

                    const sendStartMsg = () => {
                        chrome.tabs.sendMessage(golftopTab.id, startPayload, (response) => {
                            if (chrome.runtime.lastError) {
                                console.error("[Tee82] 골프탑 스크립트 응답 없음:", chrome.runtime.lastError.message);
                                showToast("골프탑 페이지(intra.golftop.kr)를 새로고침(F5) 후 다시 실행해주세요.");
                            } else {
                                console.log("[Tee82] 골프탑 등록 시작 성공:", response);
                            }
                        });
                    };

                    if (chrome.scripting && chrome.scripting.executeScript) {
                        chrome.scripting.executeScript({
                            target: { tabId: golftopTab.id },
                            files: ['golftop_content.js']
                        }, () => {
                            // executeScript 에러 여부와 무관하게 최신 리스너로 메시지 전송
                            void chrome.runtime.lastError;
                            setTimeout(sendStartMsg, 120);
                        });
                    } else {
                        sendStartMsg();
                    }
                });
            } else {
                chrome.tabs.update(golftopTab.id, { url: targetUrl, active: true }, () => {
                    console.log("[Tee82] 골프탑 관리 페이지로 이동:", targetUrl);
                });
            }
        } else {
            if (confirm("열려 있는 골프탑(intra.golftop.kr) 탭이 없습니다.\n골프탑 관리 페이지를 새 탭으로 여시겠습니까?")) {
                chrome.tabs.create({ url: targetUrl });
            }
        }
    });
}

// 진행상황 모달 표시 및 제어
function showProgressModal(total, mode = 'join', cycleInfo = '') {
    const overlay = document.getElementById('progressOverlay');
    const fill = document.getElementById('progressBarFill');
    const count = document.getElementById('progressCount');
    const desc = document.getElementById('progressDesc');
    const title = document.getElementById('progressTitle');
    
    if (title) {
        if (mode === 'date_reset') title.innerText = `골프몬 날짜별 전체리셋 진행 중${cycleInfo || ''}`;
        else if (mode === 'selected_reset') title.innerText = `골프몬 선택리셋 진행 중${cycleInfo || ''}`;
        else if (mode === 'post_replace_all') title.innerText = '골프몬 전체수정 진행 중';
        else if (mode === 'post_replace') title.innerText = '골프몬 스마트수정 진행 중';
        else if (mode === 'price_update') title.innerText = '골프몬 내글 변동수정 진행 중';
        else if (mode === 'golmarket_transfer') title.innerText = '골마켓 부킹(양도) 등록 진행 중';
        else if (mode === 'golmarket') title.innerText = '골마켓 조인 등록 진행 중';
        else if (mode === 'golfrock') title.innerText = '골프락 자동 등록 진행 중';
        else if (mode === 'golfland') title.innerText = '골프랜드 자동 등록 진행 중';
        else if (mode === 'golftop') title.innerText = '골프탑 홍보 자동등록 진행 중';
        else if (mode === 'both') title.innerText = '골프몬 조인·양도 통합 등록 진행 중';
        else if (mode === 'transfer') title.innerText = '골프몬 양도 등록 진행 중';
        else title.innerText = '골프몬 조인 등록 진행 중';
    }
    if (overlay) overlay.style.display = 'none';
    if (fill) fill.style.width = '0%';
    if (count) count.innerText = total > 0 ? `0 / ${total}건 완료` : `대상 글 탐색 중...`;
    if (desc) {
        if (mode === 'date_reset') desc.innerText = '지정한 날짜의 등록글을 내용 변경 없이 모두 순차적으로 리셋(수정)합니다...';
        else if (mode === 'selected_reset') desc.innerText = '선택한 티타임을 골프몬에서 찾아 내용 변경 없이 순차적으로 리셋(수정)합니다...';
        else if (mode === 'post_replace') desc.innerText = '골프몬 기존 글을 새 타임(시간+가격+인원)으로 교체 수정을 시작합니다...';
        else if (mode === 'price_update') desc.innerText = '골프몬 등록 상품 가격/인원 변동수정을 시작합니다...';
        else if (mode === 'golmarket_transfer') desc.innerText = '골마켓 부킹(양도) 자동 등록을 시작합니다...';
        else if (mode === 'golmarket') desc.innerText = '골마켓 조인 자동 등록을 시작합니다...';
        else if (mode === 'golfrock') desc.innerText = '골프락 자동 등록을 시작합니다...';
        else if (mode === 'golfland') desc.innerText = '골프랜드 자동 등록을 시작합니다...';
        else if (mode === 'golftop') desc.innerText = '골프탑 홍보 자동 등록을 시작합니다...';
        else desc.innerText = '골프몬 자동 등록을 시작합니다...';
    }
}

function clearActiveProgressHighlight() {
    try {
        document.querySelectorAll('.tee-card.processing-active, #dataTable tr.processing-active').forEach(el => {
            el.classList.remove('processing-active');
        });
    } catch(e) {}
}

function scrollToActiveProgressItem(golf, date, time, regId = '', rawGolf = '', current = 0) {
    try {
        const cardContainer = document.getElementById('cardList');
        const tableWrap = document.querySelector('.table-view-wrap') || document.querySelector('#tabTable');

        clearActiveProgressHighlight();

        let matchedCard = null;
        let matchedTr = null;

        // 1차: regId 기준 정확한 1:1 매칭
        if (regId) {
            if (cardContainer) matchedCard = cardContainer.querySelector(`.tee-card[data-reg-id="${regId}"]`);
            matchedTr = document.querySelector(`#dataTable tbody tr[data-reg-id="${regId}"]`);
        }

        const cards = cardContainer ? Array.from(cardContainer.querySelectorAll('.tee-card')) : [];
        const trs = Array.from(document.querySelectorAll('#dataTable tbody tr'));

        // 2차: 시간 + 날짜 + 구장명 정규화 매칭
        if (!matchedCard) {
            const normTime = (t) => (t || '').toString().replace(/[^\d]/g, '').padStart(4, '0');
            const normDate = (d) => {
                const m = (d || '').toString().match(/(\d{1,2})[./\-](\d{1,2})/);
                return m ? `${parseInt(m[1], 10)}.${parseInt(m[2], 10)}` : '';
            };
            const normGolf = (g) => (g || '').toString().toLowerCase().replace(/\s+/g, '').replace(/cc|gc|골프장|컨트리클럽/g, '');

            const targetT = normTime(time);
            const targetD = normDate(date);
            const targetG1 = normGolf(golf);
            const targetG2 = normGolf(rawGolf);

            for (let i = 0; i < cards.length; i++) {
                const c = cards[i];
                const cT = normTime(c.dataset.time);
                const cD = normDate(c.dataset.date);
                const cG1 = normGolf(c.dataset.golf);
                const cG2 = normGolf(c.dataset.rawGolf);

                const timeMatches = Boolean(targetT && cT && (targetT === cT || targetT.endsWith(cT) || cT.endsWith(targetT)));
                const dateMatches = Boolean(!targetD || !cD || targetD === cD);
                const golfMatches = Boolean(
                    (targetG1 && (cG1 === targetG1 || cG2 === targetG1 || cG1.includes(targetG1) || targetG1.includes(cG1))) ||
                    (targetG2 && (cG1 === targetG2 || cG2 === targetG2 || cG1.includes(targetG2) || targetG2.includes(cG1)))
                );

                if (timeMatches && dateMatches && golfMatches) {
                    matchedCard = c;
                    matchedTr = trs[i] || null;
                    break;
                }
            }
        }

        // 3차: 시간 + 구장명 단독 매칭 (날짜 형식 차이 대비)
        if (!matchedCard) {
            const normTime = (t) => (t || '').toString().replace(/[^\d]/g, '').padStart(4, '0');
            const normGolf = (g) => (g || '').toString().toLowerCase().replace(/\s+/g, '').replace(/cc|gc|골프장|컨트리클럽/g, '');
            const targetT = normTime(time);
            const targetG1 = normGolf(golf);
            const targetG2 = normGolf(rawGolf);

            for (let i = 0; i < cards.length; i++) {
                const c = cards[i];
                const cT = normTime(c.dataset.time);
                const cG1 = normGolf(c.dataset.golf);
                const cG2 = normGolf(c.dataset.rawGolf);

                const timeMatches = Boolean(targetT && cT && targetT === cT);
                const golfMatches = Boolean(
                    (targetG1 && (cG1.includes(targetG1) || targetG1.includes(cG1))) ||
                    (targetG2 && (cG2.includes(targetG2) || targetG2.includes(cG2)))
                );

                if (timeMatches && golfMatches) {
                    matchedCard = c;
                    matchedTr = trs[i] || null;
                    break;
                }
            }
        }

        // 4차 fallback: 선택된 카드 중 진행 순번(current - 1) 기준 매칭
        if (!matchedCard && current > 0) {
            const selectedCards = cards.filter(c => c.classList.contains('selected'));
            if (selectedCards.length > 0 && current <= selectedCards.length) {
                matchedCard = selectedCards[current - 1];
                const idx = parseInt(matchedCard.dataset.index, 10);
                if (!isNaN(idx) && trs[idx]) matchedTr = trs[idx];
            }
        }

        // 카드 뷰 하이라이트 & 부드러운 자동 스크롤
        if (matchedCard && cardContainer) {
            matchedCard.classList.add('processing-active');
            const cardTop = matchedCard.offsetTop;
            const cardHeight = matchedCard.offsetHeight;
            const containerHeight = cardContainer.clientHeight;
            const targetScrollTop = cardTop - (containerHeight / 2) + (cardHeight / 2);
            cardContainer.scrollTo({
                top: Math.max(0, targetScrollTop),
                behavior: 'smooth'
            });
            try {
                matchedCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } catch(e) {}
        }

        // 표 보기(테이블) 모드 하이라이트 & 자동 스크롤
        if (matchedTr) {
            matchedTr.classList.add('processing-active');
            if (tableWrap) {
                const trTop = matchedTr.offsetTop;
                const trHeight = matchedTr.offsetHeight;
                const wrapHeight = tableWrap.clientHeight;
                const targetScrollTop = trTop - (wrapHeight / 2) + (trHeight / 2);
                tableWrap.scrollTo({
                    top: Math.max(0, targetScrollTop),
                    behavior: 'smooth'
                });
            }
        }
    } catch(err) {
        console.warn('[스크롤 이동] 오류 무시:', err);
    }
}

function updateProgress(current, total, golf, date, time, fee = '', regId = '', rawGolf = '') {
    const fill = document.getElementById('progressBarFill');
    const count = document.getElementById('progressCount');
    const desc = document.getElementById('progressDesc');

    const pct = total > 0 ? Math.min(100, Math.round((current / total) * 100)) : 50;
    if (fill) fill.style.width = `${pct}%`;
    if (count) count.innerText = total > 0 ? `${current} / ${total}건 진행 중 (${pct}%)` : `${current}건 진행 중`;
    if (desc) {
        if (fee === '__RESET__') {
            desc.innerText = `[${current}/${total || '?'}] ${golf} (${date} ${time}) 내용 유지 리셋(수정) 중...`;
        } else if (fee) {
            desc.innerText = `[${current}/${total}] ${golf} (${date} ${time}) -> ${fee}만 가격수정 중...`;
        } else {
            desc.innerText = `[${current}/${total}] ${golf} (${date} ${time}) 등록 중...`;
        }
    }

    // ★ [사용자 핵심 요구사항]: 진행 중인 해당 타임으로 스크롤 이동 및 시각적 강조 표시
    scrollToActiveProgressItem(golf, date, time, regId, rawGolf, current);
}

function finishProgress(total) {
    clearActiveProgressHighlight();
    const desc = document.getElementById('progressDesc');
    const fill = document.getElementById('progressBarFill');
    if (desc) desc.innerText = `총 ${total}건의 등록이 모두 완료되었습니다!`;
    if (fill) fill.style.width = '100%';
    setTimeout(() => {
        const overlay = document.getElementById('progressOverlay');
        if (overlay) overlay.style.display = 'none';
        showToast(`등록 완료 (${total}건)`);
    }, 1500);
}

// ========================================================
// 🛡️ GolfTee82 5대 보안 강화 코어
// (비밀번호 난독화/해시, 세션 위변조 방지 전자서명, 무차별 대입 락아웃, 보안 방화벽)
// ========================================================
var _0xad = String.fromCharCode(72, 121, 117, 110, 107, 121, 117, 49, 50, 33); // 관리자 마스터 PW
var _0xlb = String.fromCharCode(100, 108, 103, 117, 115, 119, 111); // 실험실 PW

function timingSafeEqual(a, b) {
    if (typeof a !== 'string' || typeof b !== 'string') return false;
    if (a.length !== b.length) return false;
    var mismatch = 0;
    for (var i = 0; i < a.length; i++) {
        mismatch |= (a.charCodeAt(i) ^ b.charCodeAt(i));
    }
    return mismatch === 0;
}

// 🛡️ 무차별 대입 공격(Brute-force) 방지 락아웃 시스템
var _LOCKOUT_MAX_FAILS = 5;
var _LOCKOUT_DURATION_MS = 60 * 1000; // 60초(1분) 잠금
var _failedAttempts = { login: 0, admin: 0, lab: 0 };
var _lockoutExpiry = { login: 0, admin: 0, lab: 0 };

function isLockoutActive(key) {
    var now = Date.now();
    if (_lockoutExpiry[key] && now < _lockoutExpiry[key]) {
        return true;
    }
    if (_lockoutExpiry[key] && now >= _lockoutExpiry[key]) {
        _lockoutExpiry[key] = 0;
        _failedAttempts[key] = 0;
    }
    return false;
}

function getLockoutRemainingSeconds(key) {
    var remMs = (_lockoutExpiry[key] || 0) - Date.now();
    return Math.max(1, Math.ceil(remMs / 1000));
}

function recordFailedAttempt(key) {
    _failedAttempts[key] = (_failedAttempts[key] || 0) + 1;
    if (_failedAttempts[key] >= _LOCKOUT_MAX_FAILS) {
        _lockoutExpiry[key] = Date.now() + _LOCKOUT_DURATION_MS;
    }
}

function resetLockoutAttempts(key) {
    _failedAttempts[key] = 0;
    _lockoutExpiry[key] = 0;
}

function getFailedAttempts(key) {
    return _failedAttempts[key] || 0;
}

// 🛡️ 세션 무결성 디지털 서명 (Tamper-Proof Session Signature)
function computeSessionSignature(user) {
    if (!user || typeof user !== 'object') return '';
    var id = String(user.id || '').trim();
    var name = String(user.name || '').trim();
    var exp = String(user.expireDate || '').trim();
    var feat = String(user.features || '').trim();
    var sites = String(user.sites || '').trim();
    var pw = String(user.pw || '').trim();
    var salt = 'GT82_SIGN_2026_x7F9qK#';
    var payload = salt + '::' + id + '::' + name + '::' + exp + '::' + feat + '::' + sites + '::' + pw + '::' + salt;

    var h1 = 0xdeadbeef ^ 12345;
    var h2 = 0x41c6ce57 ^ 67890;
    for (var i = 0; i < payload.length; i++) {
        var c = payload.charCodeAt(i);
        h1 = Math.imul(h1 ^ c, 2654435761);
        h2 = Math.imul(h2 ^ c, 1597334677);
    }
    h1 ^= h1 >>> 16; h1 = Math.imul(h1, 2246822507); h1 ^= h1 >>> 13;
    h2 ^= h2 >>> 16; h2 = Math.imul(h2, 3266489909); h2 ^= h2 >>> 13;
    return (h1 >>> 0).toString(16).padStart(8, '0') + (h2 >>> 0).toString(16).padStart(8, '0');
}

function verifySessionIntegrity(user) {
    if (!user || typeof user !== 'object') return false;
    if (user._sig) {
        var expected = computeSessionSignature(user);
        if (timingSafeEqual(user._sig, expected)) return true;
        // 하위 호환: sites 필드 추가 전 레거시 서명 검증
        var legacyPayload = 'GT82_SIGN_2026_x7F9qK#::' + String(user.id || '').trim() + '::' + String(user.name || '').trim() + '::' + String(user.expireDate || '').trim() + '::' + String(user.features || '').trim() + '::' + String(user.pw || '').trim() + '::GT82_SIGN_2026_x7F9qK#';
        var lh1 = 0xdeadbeef ^ 12345;
        var lh2 = 0x41c6ce57 ^ 67890;
        for (var i = 0; i < legacyPayload.length; i++) {
            var c = legacyPayload.charCodeAt(i);
            lh1 = Math.imul(lh1 ^ c, 2654435761);
            lh2 = Math.imul(lh2 ^ c, 1597334677);
        }
        lh1 ^= lh1 >>> 16; lh1 = Math.imul(lh1, 2246822507); lh1 ^= lh1 >>> 13;
        lh2 ^= lh2 >>> 16; lh2 = Math.imul(lh2, 3266489909); lh2 ^= lh2 >>> 13;
        var legacySig = (lh1 >>> 0).toString(16).padStart(8, '0') + (lh2 >>> 0).toString(16).padStart(8, '0');
        return timingSafeEqual(user._sig, legacySig);
    }
    return Boolean(user.id && user.pw);
}

// 🛡️ 사이트별 표시명 반환
function getSiteDisplayName(siteKeyOrName) {
    const s = String(siteKeyOrName || '').trim();
    if (s === '몬' || s === 'mon' || s.includes('골프몬')) return '골프몬';
    if (s === '팡' || s === 'pang' || s.includes('골팡')) return '골팡';
    if (s === '마켓' || s === 'market' || s.includes('골마켓')) return '골마켓';
    if (s === '락' || s === 'rock' || s.includes('골프락')) return '골프락';
    if (s === '랜드' || s === 'land' || s.includes('골프랜드')) return '골프랜드';
    if (s === '탑' || s === 'top' || s.includes('골프탑')) return '골프탑';
    return s || '해당 사이트';
}

// 🛡️ 사이트 권한 확인 (몬, 팡, 마켓, 락, 랜드, 탑)
function hasSitePermission(siteKeyOrName) {
    if (isCurrentUserAdmin()) return true;
    if (!currentAuthUser) return false;
    const sitesStr = String(currentAuthUser.sites || '').trim();
    if (!sitesStr) return false;
    if (sitesStr.includes('전체') || sitesStr.toLowerCase().includes('all')) return true;

    const normTarget = String(siteKeyOrName || '').trim().toLowerCase();
    const tokens = sitesStr.split(/[\s,+/|;]+/).map(t => t.trim().toLowerCase()).filter(Boolean);

    return tokens.some(tok => {
        if (!tok) return false;
        if (tok === '전체' || tok === 'all') return true;
        if (normTarget === '몬' || normTarget === 'mon' || normTarget.includes('골프몬')) {
            return tok === '몬' || tok.includes('골프몬') || tok === 'mon';
        }
        if (normTarget === '팡' || normTarget === 'pang' || normTarget.includes('골팡')) {
            return tok === '팡' || tok.includes('골팡') || tok === 'pang';
        }
        if (normTarget === '마켓' || normTarget === 'market' || normTarget.includes('골마켓')) {
            return tok === '마켓' || tok.includes('골마켓') || tok === 'market';
        }
        if (normTarget === '락' || normTarget === 'rock' || normTarget.includes('골프락')) {
            return tok === '락' || tok.includes('골프락') || tok === 'rock';
        }
        if (normTarget === '랜드' || normTarget === 'land' || normTarget.includes('골프랜드')) {
            return tok === '랜드' || tok.includes('골프랜드') || tok === 'land';
        }
        if (normTarget === '탑' || normTarget === 'top' || normTarget.includes('골프탑')) {
            return tok === '탑' || tok.includes('골프탑') || tok === 'top';
        }
        return normTarget.includes(tok) || tok.includes(normTarget);
    });
}

// 🛡️ 작업 실행 전 통합 인증/보안 검증 가드 (특정 사이트 권한 검증 포함)
function checkAuthSecurityGuard(targetSite) {
    if (typeof isUserAuthenticated === 'function' && !isUserAuthenticated()) {
        showToast('회원 로그인이 필요합니다.');
        if (typeof showAuthOverlay === 'function') showAuthOverlay();
        return false;
    }
    if (currentAuthUser && !verifySessionIntegrity(currentAuthUser)) {
        logoutUser(false);
        showAuthOverlay('인증 정보가 변조되었거나 유효하지 않습니다. 다시 로그인해주세요.', 'error');
        return false;
    }
    if (targetSite && !hasSitePermission(targetSite)) {
        const siteTitle = getSiteDisplayName(targetSite);
        showToast(`해당 사이트([${siteTitle}]) 이용 권한이 없습니다.\n관리자에게 문의하세요.`);
        return false;
    }
    return true;
}

// 🛡️ 개발자 도구 및 소스코드 보기 단축키/우클릭 허용 여부 판별 (부여기능 'f12' 또는 관리자/실험실 해제 시 허용)
function isF12Allowed() {
    if (typeof isCurrentUserAdmin === 'function' && isCurrentUserAdmin()) return true;
    if (typeof hasUserFeature === 'function' && (hasUserFeature('f12') || hasUserFeature('devtools') || hasUserFeature('f12해제') || hasUserFeature('개발자'))) return true;
    if (localStorage.getItem('v2_allowF12') === 'true') return true;
    return false;
}

// 🛡️ 개발자 도구 및 소스코드 보기 단축키/우클릭 방지 (보안 방화벽)
function initAntiInspection() {
    // 1. 우클릭 방지 (단, 텍스트 입력 칸/textarea는 복사/붙여넣기를 위해 정상 허용, F12 허용 시 전체 허용)
    document.addEventListener('contextmenu', function(e) {
        if (isF12Allowed()) return;
        var t = e.target;
        if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA')) {
            return;
        }
        e.preventDefault();
        return false;
    }, true);

    // 2. 단축키 방지 (F12, Ctrl+Shift+I, Ctrl+Shift+J, Ctrl+Shift+C, Ctrl+U)
    document.addEventListener('keydown', function(e) {
        if (isF12Allowed()) return;
        if (e.key === 'F12' || e.keyCode === 123) {
            e.preventDefault();
            e.stopPropagation();
            return false;
        }
        if (e.ctrlKey && e.shiftKey && (['I', 'i', 'J', 'j', 'C', 'c'].indexOf(e.key) !== -1 || [73, 74, 67].indexOf(e.keyCode) !== -1)) {
            e.preventDefault();
            e.stopPropagation();
            return false;
        }
        if (e.ctrlKey && (e.key === 'u' || e.key === 'U' || e.keyCode === 85)) {
            e.preventDefault();
            e.stopPropagation();
            return false;
        }
    }, true);
}

// 🛡️ 백그라운드 실시간 킬스위치 & 동시접속 감지 (3~5분 주기 + ±30초 무작위 지터 분산)
// 수백 명의 동시 접속자가 같은 초(Second)에 구글 시트 API를 찌르는 스파이크 부하를 완벽히 평탄화
function startAuthHeartbeat() {
    function getNextHeartbeatDelay() {
        // 기준 주기 4분(240초)에 ±30초 무작위 지터 적용 (210초 ~ 270초, 3.5분~4.5분)
        const baseSeconds = 240;
        const jitterSeconds = (Math.random() * 60) - 30; // -30초 ~ +30초
        return Math.round((baseSeconds + jitterSeconds) * 1000);
    }

    async function runHeartbeat() {
        try {
            if (currentAuthUser && currentAuthUser.id && currentAuthUser.pw && currentAuthUser.isLoggedIn) {
                await verifyAuthWithServer(currentAuthUser.id, currentAuthUser.pw, true, false);
            }
            if (typeof checkForRemoteAppUpdate === 'function') {
                checkForRemoteAppUpdate(false);
            }
        } catch(e) {
            console.warn('[Heartbeat] 실행 오류 (다음 주기 재시도):', e);
        } finally {
            // 다음 하트비트 주기를 무작위 지터와 함께 예약
            const nextDelay = getNextHeartbeatDelay();
            setTimeout(runHeartbeat, nextDelay);
        }
    }

    // 첫 실행: 팝업 시작 후 즉시 폭주하지 않도록 10~30초 무작위 지터 후 첫 주기 시작
    const initialDelay = Math.round((10 + Math.random() * 20) * 1000);
    setTimeout(runHeartbeat, initialDelay);
}

// ========================================================
// 회원별 기능 권한 및 관리자 전용 실험실 제어
// ========================================================
function isCurrentUserAdmin() {
    // currentAuthUser가 일시적으로 비어있을 경우 저장소에서 즉시 복원
    let user = currentAuthUser;
    if (!user) {
        try {
            const savedStr = localStorage.getItem('v2_auth_user');
            if (savedStr) user = JSON.parse(savedStr);
        } catch(e) {}
    }

    if (!user || !user.isLoggedIn) {
        // 비로그인 상태: 저장소에 남은 관리자 플래그 확인
        if (localStorage.getItem('v2_isAdmin') === 'true') return true;
        return false;
    }

    const id = String(user.id || '').trim().toLowerCase();
    const name = String(user.name || '').trim().toLowerCase();
    const rawFeatures = String(user.features || '').trim().toLowerCase();
    const tokens = rawFeatures.split(/[,+\/\s|;]+/).map(s => s.trim()).filter(Boolean);

    // 1. 아이디 또는 이름이 관리자인 경우 (대소문자 무관)
    const isAdminId = (id === 'admin' || id === 'administrator' || id === 'golfmon_admin' || id === 'purry' || id === 'purry85' || id === 'yebba' || id.includes('admin') || id.includes('master'));
    const isAdminName = (name === '관리자' || name === '최고관리자' || name === 'admin' || name === '마스터' || name.includes('관리자'));

    // 2. 권한 컬럼에 관리자 관련 명시 토큰이 포함된 경우 ('전체', 'all' 등 일반 기능 권한은 절대 관리자가 아님!)
    const adminTokens = ['관리자', 'admin', '마스터', 'master', '최고관리자', '개발자'];
    const isAdminToken = tokens.some(t => adminTokens.includes(t));
    const isExplicitAdmin = (user.isAdmin === true);

    // 로그인된 회원이 있는 경우: 실제 관리자 조건(아이디/이름/관리자토큰/서버isAdmin)을 만족해야만 관리자!
    const isAdmin = isExplicitAdmin || isAdminId || isAdminName || isAdminToken;

    try {
        if (isAdmin) {
            localStorage.setItem('v2_isAdmin', 'true');
            if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
                chrome.storage.local.set({ v2_isAdmin: true });
            }
        } else {
            localStorage.removeItem('v2_isAdmin');
            if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
                chrome.storage.local.remove(['v2_isAdmin']);
            }
        }
    } catch(e) {}

    return isAdmin;
}

function hasUserFeature(featureKey) {
    if (!currentAuthUser) return false;
    const features = String(currentAuthUser.features || '').trim().toLowerCase();
    const tokens = features.split(/[,+\/\s|;]+/).map(s => s.trim()).filter(Boolean);

    // ⚠️ 1등 끌어올리기(BUMP) 및 원클릭 마감은 실험실 기능(기본 숨김)이므로 관리자 프리패스 제외 (실험실 토글 또는 시트 개별 권한 부여 시만 동작)
    const isLabRestrictedFeature = (featureKey === '1등' || featureKey === 'bump' || featureKey === '끌어올리기' || featureKey === '1등끌어올리기' || featureKey === 'soldout' || featureKey === '마감');

    // 1. 관리자이거나 부여기능 컬럼에 '전체', 'all', '풀옵션', '모두'가 포함된 경우 모든 기능(동시등록, 공지적용, 수정, 리셋 등) 상시 허용 (실험실 전용 제한 기능 제외)
    if (!isLabRestrictedFeature && (isCurrentUserAdmin() || tokens.includes('전체') || tokens.includes('all') || tokens.includes('풀옵션') || tokens.includes('모두'))) {
        return true;
    }

    // 2. 🌐 플랫폼 동시등록: 부여기능에 '동시등록' (또는 '동시', 'multi', '플랫폼동시등록')이 명시적으로 부여된 회원에게 허용
    if (featureKey === 'multi' || featureKey === '동시등록' || featureKey === '동시' || featureKey === '플랫폼동시등록') {
        return tokens.includes('동시등록') || tokens.includes('동시') || tokens.includes('multi') || tokens.includes('플랫폼동시등록') || features.includes('동시등록');
    }

    // 3. 속도 조절
    if (featureKey === 'speed') {
        return features.includes('속도') || features.includes('speed') || features.includes('빠른손') || features.includes('초고속') || features.includes('fast');
    }

    // 4. 전체 리셋
    if (featureKey === 'reset') {
        return features.includes('리셋') || features.includes('reset');
    }

    // 5. 변동/스마트 수정
    if (featureKey === 'update' || featureKey === '수정' || featureKey === '변동수정' || featureKey === '스마트수정') {
        return features.includes('수정') || features.includes('변동수정') || features.includes('스마트수정') || features.includes('update') || features.includes('변동') || features.includes('교체');
    }

    // 6. 공지 적용/등록
    if (featureKey === 'notice' || featureKey === '공지' || featureKey === '공지등록') {
        return features.includes('공지') || features.includes('notice') || features.includes('공지적용') || features.includes('공지등록');
    }

    // 7. F12 개발자 도구 해제
    if (featureKey === 'f12' || featureKey === 'devtools' || featureKey === 'f12해제' || featureKey === '개발자') {
        return features.includes('f12') || features.includes('개발자') || features.includes('디버그') || features.includes('검사') || features.includes('devtools');
    }

    // 8. 내 글 전체 1등 끌어올리기 (부여기능: 1등)
    if (featureKey === '1등' || featureKey === 'bump' || featureKey === '끌어올리기' || featureKey === '1등끌어올리기') {
        return features.includes('1등') || features.includes('bump') || features.includes('끌어올리기') || tokens.includes('1등');
    }

    return false;
}

// 🛡️ 사이트별 등록 버튼 및 플랫폼 동시등록 체크박스 UI 제어 (몬, 팡, 마켓, 락, 랜드, 탑)
function applySitePermissionsUI() {
    const SITE_CONFIGS = [
        {
            key: '몬',
            name: '골프몬',
            btnIds: ['btnRegisterToGolfmon', 'btnFullEditGolfmonPosts', 'btnReplaceGolfmonPosts'],
            chkId: 'chkMultiGolfmon'
        },
        {
            key: '팡',
            name: '골팡',
            btnIds: ['btnRegisterToGolfpang'],
            chkId: null
        },
        {
            key: '마켓',
            name: '골마켓',
            btnIds: ['btnRegisterToGolfmarket'],
            chkId: 'chkMultiGolfmarket'
        },
        {
            key: '락',
            name: '골프락',
            btnIds: ['btnRegisterToGolfrock'],
            chkId: 'chkMultiGolfrock'
        },
        {
            key: '랜드',
            name: '골프랜드',
            btnIds: ['btnRegisterToGolfland'],
            chkId: 'chkMultiGolfland'
        },
        {
            key: '탑',
            name: '골프탑',
            btnIds: ['btnRegisterToGolftop'],
            chkId: 'chkMultiGolftop'
        }
    ];

    SITE_CONFIGS.forEach(site => {
        const allowed = hasSitePermission(site.key);
        site.btnIds.forEach(btnId => {
            const btn = document.getElementById(btnId);
            if (!btn) return;
            if (allowed) {
                btn.style.opacity = '1';
                btn.style.filter = 'none';
                btn.style.cursor = 'pointer';
                btn.dataset.sitePermitted = 'true';
                const orig = btn.getAttribute('data-original-title');
                if (orig) btn.title = orig;
            } else {
                if (!btn.getAttribute('data-original-title')) {
                    btn.setAttribute('data-original-title', btn.title || '');
                }
                btn.style.opacity = '0.35';
                btn.style.filter = 'grayscale(70%)';
                btn.style.cursor = 'not-allowed';
                btn.dataset.sitePermitted = 'false';
                btn.title = `[권한없음] ${site.name} 이용 권한이 없습니다. (관리자에게 문의)`;
            }
        });

        if (site.chkId) {
            const chk = document.getElementById(site.chkId);
            if (chk) {
                if (allowed) {
                    chk.disabled = false;
                } else {
                    chk.checked = false;
                    chk.disabled = true;
                }
            }
        }
    });
}

function applyUserPermissionsUI() {
    const isAdmin = isCurrentUserAdmin();
    const isF12 = hasUserFeature('f12') || isAdmin || (localStorage.getItem('v2_allowF12') === 'true');
    try {
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.set({ v2_isAdmin: isAdmin, v2_allowF12: isF12 });
        }
    } catch(e) {}
    const rowLabMode = document.getElementById('rowLabMode');
    const labPanel = document.getElementById('labSettingsPanel');
    const chkLabMode = document.getElementById('chkLabMode');

    // 1. 실험실 설정 행 및 패널은 사용자 요청으로 UI에서 완전 숨김 (기능은 상시 활성화 유지)
    if (rowLabMode) rowLabMode.style.display = 'none';
    if (labPanel) labPanel.style.display = 'none';
    if (chkLabMode) chkLabMode.checked = false;

    // 2. 권한에 맞춰 속도 옵션 UI 동기화 (기본: 빠른손/빠른진행 허용, 관리자: 초고속 추가 허용)
    updateSpeedOptionsUI(isAdmin);

    // 3. 실험실 기타 기능 동기화 (변동/교체수정, 전체리셋, 공지등록, 플랫폼 동시등록)
    const isLabActive = isAdmin && localStorage.getItem('v2_labModeActive') === 'true';
    updateLabFeaturesUI(isLabActive);

    // 4. 모바일 최신 ZIP 다운로드 카드는 최신업데이트 모달에서 상시 노출 (모바일 사용자 필수)
    const cardMobileUpdate = document.getElementById('cardMobileUpdate');
    if (cardMobileUpdate) {
        cardMobileUpdate.style.setProperty('display', 'flex', 'important');
    }

    // 5. 사이트별 권한 동기화 (몬, 팡, 마켓, 락, 랜드, 탑)
    applySitePermissionsUI();

    // 6. 최신 업데이트 모달 내 관리자 공지 발행기 동기화
    if (typeof initAdminReleasePublisher === 'function') {
        initAdminReleasePublisher();
    }
}

// ========================================================
// 속도 설정 제어 (기본: 신중한사람/특급위장, 초고속: 관리자 전용)
// ========================================================
const STEP_DELAY_OPTIONS = {
    standard: [
        { value: 'slow', text: '신중한 사람 (0.8~1.8초 여유)' },
        { value: 'fast', text: '빠른 손 (0.2~0.5초 신속)' }
    ],
    admin: [
        { value: 'turbo', text: '초고속 (0.08~0.2초 즉시)' }
    ]
};

const RANDOM_DELAY_OPTIONS = {
    standard: [
        { value: 'stealth', text: '특급 위장 (3.5~7.5초 불규칙)' },
        { value: 'fast', text: '빠른 진행 (1.2~2.6초 단축)' }
    ],
    admin: [
        { value: 'turbo', text: '초고속 (0.6~1.2초 즉시)' }
    ]
};

function updateSpeedOptionsUI(isAdminParam) {
    const isAdmin = (typeof isAdminParam === 'boolean') ? isAdminParam : (typeof isCurrentUserAdmin === 'function' ? isCurrentUserAdmin() : false);
    const selStepDelay = document.getElementById('selStepDelay');
    const selRandomDelay = document.getElementById('selRandomDelay');
    if (!selStepDelay || !selRandomDelay) return;

    // 사용자 요청: 기본속도를 "빠른 손(0.2~0.5초)" 및 "빠른 진행(1.2~2.6초)"으로 마이그레이션 적용
    if (localStorage.getItem('v2_defaultSpeedFastApplied') !== 'true') {
        localStorage.setItem('v2_stepDelayPreset', 'fast');
        localStorage.setItem('v2_randomDelayPreset', 'fast');
        localStorage.setItem('v2_defaultSpeedFastApplied', 'true');
    }

    // 1. 단계별 속도 드롭다운 재구성 (기본: 신중한사람/빠른손, 관리자만 초고속 포함)
    const stepList = isAdmin
        ? [...STEP_DELAY_OPTIONS.standard, ...STEP_DELAY_OPTIONS.admin]
        : STEP_DELAY_OPTIONS.standard;

    selStepDelay.innerHTML = '';
    stepList.forEach(opt => {
        const optionEl = document.createElement('option');
        optionEl.value = opt.value;
        optionEl.textContent = opt.text;
        selStepDelay.appendChild(optionEl);
    });

    // 저장된 설정값 우선 복원 (기본값: fast)
    let savedStep = localStorage.getItem('v2_stepDelayPreset');
    if (savedStep === 'human') savedStep = 'slow';
    if (!savedStep) savedStep = 'fast';

    let targetStep = savedStep;
    if (targetStep === 'turbo' && !isAdmin) {
        targetStep = 'fast';
    }
    if (!stepList.some(opt => opt.value === targetStep)) {
        targetStep = 'fast';
    }

    selStepDelay.value = targetStep;
    localStorage.setItem('v2_stepDelayPreset', targetStep);
    try { chrome.storage.local.set({ v2_stepDelayPreset: targetStep }); } catch(e) {}

    // 2. 타임 간 대기 드롭다운 재구성 (기본: 특급위장/빠른진행, 관리자만 초고속 포함)
    const randomList = isAdmin
        ? [...RANDOM_DELAY_OPTIONS.standard, ...RANDOM_DELAY_OPTIONS.admin]
        : RANDOM_DELAY_OPTIONS.standard;

    selRandomDelay.innerHTML = '';
    randomList.forEach(opt => {
        const optionEl = document.createElement('option');
        optionEl.value = opt.value;
        optionEl.textContent = opt.text;
        selRandomDelay.appendChild(optionEl);
    });

    let savedRandom = localStorage.getItem('v2_randomDelayPreset');
    if (savedRandom === 'safe') savedRandom = 'stealth';
    if (!savedRandom) savedRandom = 'fast';

    let targetRandom = savedRandom;
    if (targetRandom === 'turbo' && !isAdmin) {
        targetRandom = 'fast';
    }
    if (!randomList.some(opt => opt.value === targetRandom)) {
        targetRandom = 'fast';
    }

    selRandomDelay.value = targetRandom;
    localStorage.setItem('v2_randomDelayPreset', targetRandom);
    try { chrome.storage.local.set({ v2_randomDelayPreset: targetRandom }); } catch(e) {}
}

function updateLabFeaturesUI(isLabActiveParam) {
    try {
        const isAdmin = isCurrentUserAdmin();
        const labPanel = document.getElementById('labSettingsPanel');
        const chkLab = document.getElementById('chkLabMode');
        const rowLab = document.getElementById('rowLabMode');
        if (chkLab) chkLab.checked = false;
        if (labPanel) labPanel.style.display = 'none';
        if (rowLab) rowLab.style.display = 'none';

        // 사용자 요청: 실험실 제거 및 모든 핵심 기능 상시 100% 활성화!
        const isUpdateActionsOpen = true; // 골프몬 스마트수정 (↻) 항상 노출
        const isDateResetOpen = true;     // 전체리셋 바 항상 노출
        const isNoticeOpen = true;        // 공지등록 헤더 버튼 항상 노출
        const isMultiOpen = true;         // 플랫폼 동시 등록 버튼 항상 노출
        const isF12Open = true;           // F12 개발자 도구 항상 허용
        const isSoldOutOpen = true;       // 원클릭 마감/삭제 항상 노출

        const chkOpenUpdateActions = document.getElementById('chkOpenUpdateActions');
        if (chkOpenUpdateActions) chkOpenUpdateActions.checked = isUpdateActionsOpen;

        const chkOpenDateReset = document.getElementById('chkOpenDateReset');
        if (chkOpenDateReset) chkOpenDateReset.checked = isDateResetOpen;

        const chkOpenNoticeFeature = document.getElementById('chkOpenNoticeFeature');
        if (chkOpenNoticeFeature) chkOpenNoticeFeature.checked = isNoticeOpen;

        const chkOpenMultiFeature = document.getElementById('chkOpenMultiFeature');
        if (chkOpenMultiFeature) chkOpenMultiFeature.checked = isMultiOpen;

        const chkAllowF12 = document.getElementById('chkAllowF12');
        if (chkAllowF12) chkAllowF12.checked = isF12Open;

        const chkOpenSoldOutFeature = document.getElementById('chkOpenSoldOutFeature');
        if (chkOpenSoldOutFeature) chkOpenSoldOutFeature.checked = isSoldOutOpen;

        // 1. 메인 화면 [골프몬 등록 우측 수정 아이콘들(전체수정, 스마트수정)] 제어 (부여기능 '수정' 부여 시만 노출)
        const btnReplace = document.getElementById('btnReplaceGolfmonPosts');
        const btnFullEdit = document.getElementById('btnFullEditGolfmonPosts');
        const btnRegisterGolfmon = document.getElementById('btnRegisterToGolfmon');
        if (btnReplace) {
            btnReplace.style.display = isUpdateActionsOpen ? 'flex' : 'none';
        }
        if (btnFullEdit) {
            btnFullEdit.style.display = isUpdateActionsOpen ? 'flex' : 'none';
        }
        if (btnRegisterGolfmon) {
            btnRegisterGolfmon.style.padding = '0 6px';
        }

        // 2. 메인 화면 [골프몬 전체리셋] 바 제어
        const resetActionsBar = document.getElementById('resetActionsBar');
        if (resetActionsBar) {
            resetActionsBar.style.display = isDateResetOpen ? 'flex' : 'none';
        }

        // 3. 메인 상단 헤더 [공지적용] 버튼 제어 (실험실 기능: 기본 숨김, 부여기능 '공지등록' 사용자 또는 실험실 오픈 시 표시)
        const noticeHeaderGroup = document.getElementById('noticeHeaderBtnGroup');
        if (noticeHeaderGroup) {
            noticeHeaderGroup.style.display = isNoticeOpen ? 'inline-flex' : 'none';
        }

        // 4. 골프랜드는 항상 오픈 (메인 화면 버튼 및 매핑사전 탭 상시 노출)
        const btnGolfland = document.getElementById('btnRegisterToGolfland');
        if (btnGolfland) {
            btnGolfland.style.display = 'flex';
        }
        const tabGolfland = document.getElementById('siteTabGolfland');
        if (tabGolfland) {
            tabGolfland.style.display = 'inline-flex';
        }

        // 5. 플랫폼 동시 등록 배너 제어 (부여기능 '동시등록' 보유 회원에게만 노출)
        const multiBanners = document.querySelectorAll('.multi-platform-banner');
        multiBanners.forEach(banner => {
            banner.style.setProperty('display', isMultiOpen ? 'flex' : 'none', 'important');
        });
        const multiBox = document.getElementById('multiPlatformSelectBox');
        if (!isMultiOpen && multiBox) {
            multiBox.style.setProperty('display', 'none', 'important');
        }

        // 6. 원클릭 마감/삭제 제어 (실험실 기능: 기본 숨김)
        const btnBatchSoldOut = document.getElementById('btnBatchSoldOut');
        if (btnBatchSoldOut) {
            btnBatchSoldOut.style.display = isSoldOutOpen ? 'inline-flex' : 'none';
        }
        if (document.body) {
            document.body.classList.toggle('lab-soldout-active', isSoldOutOpen);
        }


    } catch(err) {
        console.error('[updateLabFeaturesUI error]', err);
    }
}

function openLabPasswordModal() {
    const modal = document.getElementById('labPasswordModal');
    const input = document.getElementById('labPasswordInput');
    const err = document.getElementById('labPasswordError');
    if (!modal) return;
    if (input) input.value = '';
    if (err) err.innerText = '';
    modal.style.display = 'flex';
    setTimeout(() => {
        input?.focus();
    }, 50);
}

function closeLabPasswordModal() {
    const modal = document.getElementById('labPasswordModal');
    if (modal) modal.style.display = 'none';
    const chkLabMode = document.getElementById('chkLabMode');
    const labPanel = document.getElementById('labSettingsPanel');
    const isLabActive = localStorage.getItem('v2_labModeActive') === 'true';
    if (chkLabMode) chkLabMode.checked = isLabActive;
    if (labPanel) labPanel.style.display = isLabActive ? 'block' : 'none';
}

function verifyLabPassword() {
    if (!isCurrentUserAdmin()) {
        showToast('실험실 모드는 관리자 전용 기능입니다.');
        closeLabPasswordModal();
        return;
    }
    const err = document.getElementById('labPasswordError');
    if (isLockoutActive('lab')) {
        const rem = getLockoutRemainingSeconds('lab');
        if (err) err.innerText = `⛔ 5회 실패로 1분간 잠겼습니다. (${rem}초 대기)`;
        return;
    }

    const input = document.getElementById('labPasswordInput');
    const val = input ? input.value.trim() : '';

    if (timingSafeEqual(val, _0xlb)) {
        resetLockoutAttempts('lab');
        const modal = document.getElementById('labPasswordModal');
        if (modal) modal.style.display = 'none';

        const chkLabMode = document.getElementById('chkLabMode');
        const labPanel = document.getElementById('labSettingsPanel');
        if (chkLabMode) chkLabMode.checked = true;
        if (labPanel) labPanel.style.display = 'block';

        localStorage.setItem('v2_labModeActive', 'true');
        try {
            chrome.storage.local.set({ v2_labModeActive: true });
        } catch(e) {}
        updateLabFeaturesUI(true);
        showToast('🧪 실험실 모드가 활성화되었습니다.');
    } else {
        recordFailedAttempt('lab');
        if (err) {
            if (isLockoutActive('lab')) {
                const rem = getLockoutRemainingSeconds('lab');
                err.innerText = `⛔ 비밀번호 5회 실패로 1분간 잠겼습니다. (${rem}초 대기)`;
            } else {
                const fails = getFailedAttempts('lab');
                err.innerText = `비밀번호가 올바르지 않습니다. (${fails}/5회 실패)`;
            }
        }
        if (input) {
            input.focus();
            input.select();
        }
    }
}

// 이벤트 리스너 등록 및 앱 초기화 함수
function initMainApp() {
    // 독립창 모드로 열렸을 때 전용 클래스 적용
    if (window.location.search.includes('mode=window')) {
        document.body.classList.add('popout-mode');
        document.documentElement.classList.add('popout-mode');
    }

    // 사이드패널 모드 감지 (sidepanel.html 자체 또는 mode=sidepanel 파라미터)
    const isSidePanel = window.location.pathname.includes('sidepanel') || window.location.search.includes('mode=sidepanel');
    if (isSidePanel) {
        document.body.classList.add('sidepanel-mode');
        document.documentElement.classList.add('sidepanel-mode');
    }

    // 세그먼트 탭 전환 (AdGuard 스타일)
    document.querySelectorAll('.tab-segmented-control .tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.tab-segmented-control .tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            const targetId = btn.dataset.tab;
            const targetPanel = document.getElementById(targetId);
            if (targetPanel) {
                targetPanel.classList.add('active');
                if (targetId === 'tabSettings' && typeof updateCourseMemoDatalist === 'function') {
                    updateCourseMemoDatalist();
                }
            }
        });
    });

    // ----------------------------------------------------
    // 속도 설정 및 실험실(Lab) 모드 초기화 (회원별 권한 반영)
    // ----------------------------------------------------
    try {
        applyUserPermissionsUI();
    } catch(e) {
        console.error('[applyUserPermissionsUI error]', e);
    }

    // 타임간 대기(쿨다운) 프리셋 저장 이벤트 리스너 바인딩
    const selRandomDelay = document.getElementById('selRandomDelay');
    if (selRandomDelay && !selRandomDelay.dataset.listenerBound) {
        selRandomDelay.dataset.listenerBound = 'true';
        selRandomDelay.addEventListener('change', function() {
            localStorage.setItem('v2_randomDelayPreset', this.value);
            try { chrome.storage.local.set({ v2_randomDelayPreset: this.value }); } catch(e) {}
            showToast('타임 간 쿨다운 설정이 저장되었습니다.');
        });
    }

    // 단계별 반응 지연 프리셋 저장 이벤트 리스너 바인딩
    const selStepDelay = document.getElementById('selStepDelay');
    if (selStepDelay && !selStepDelay.dataset.listenerBound) {
        selStepDelay.dataset.listenerBound = 'true';
        selStepDelay.addEventListener('change', function() {
            localStorage.setItem('v2_stepDelayPreset', this.value);
            try { chrome.storage.local.set({ v2_stepDelayPreset: this.value }); } catch(e) {}
            showToast('단계별 반응 속도가 저장되었습니다.');
        });
    }

    // 구장 매칭 안전확인 (불일치 시 확인창 띄우기) 프리셋 복원 및 저장
    const chkConfirmMismatchEl = document.getElementById('chkConfirmCourseMismatch');
    if (chkConfirmMismatchEl) {
        const savedMismatch = localStorage.getItem('v2_confirmCourseMismatch');
        if (savedMismatch !== null) {
            chkConfirmMismatchEl.checked = savedMismatch === 'true';
        } else {
            chkConfirmMismatchEl.checked = true;
        }
        chkConfirmMismatchEl.addEventListener('change', function() {
            localStorage.setItem('v2_confirmCourseMismatch', this.checked ? 'true' : 'false');
            try {
                chrome.storage.local.set({ v2_confirmCourseMismatch: this.checked });
            } catch(e) {}
            showToast(this.checked ? '🛡️ 수정 시 구장 불일치 안전확인 창이 활성화되었습니다.' : '구장 불일치 안전확인이 비활성화되었습니다.');
        });
    }

    // 중단 후 타임 추가 시: 미체크 삭제 및 신규 타임 상단 우선 추가 (이어붙이기)
    const chkSmartPrependEl = document.getElementById('chkSmartPrependOnPaste');
    if (chkSmartPrependEl) {
        chkSmartPrependEl.checked = isSmartPrependActive();
        chkSmartPrependEl.addEventListener('change', function() {
            const isActive = this.checked;
            localStorage.setItem('v2_smartPrependOnPaste', isActive ? 'true' : 'false');
            try {
                chrome.storage.local.set({ v2_smartPrependOnPaste: isActive });
            } catch(e) {}
            updateSelectedBadge();
            showToast(isActive ? '🔄 중단 후 타임 추가 시 상단 우선 이어붙이기 활성화' : '타임 추가 시 기존 목록 전체 초기화 모드로 변경');
        });
    }

    // 인라인 대기 목록 비우기 버튼 (새로 시작)
    const btnResumeClearEl = document.getElementById('btnResumeClearInline');
    if (btnResumeClearEl) {
        btnResumeClearEl.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            const tbody = document.getElementById('tableBody');
            if (tbody) tbody.innerHTML = '';
            localStorage.removeItem('v2_savedTableData');
            renderCardList();
            updateSelectedBadge();
            showToast('대기 중인 티타임 목록이 초기화되었습니다. 새로 입력할 수 있습니다.');
        });
    }

    // 실험실 모드 체크박스 클릭 리스너 (관리자 전용)
    const chkLabMode = document.getElementById('chkLabMode');
    const labPanel = document.getElementById('labSettingsPanel');
    if (chkLabMode) {
        chkLabMode.addEventListener('click', function() {
            const currentLabPanel = document.getElementById('labSettingsPanel');
            if (!isCurrentUserAdmin()) {
                this.checked = false;
                if (currentLabPanel) currentLabPanel.style.display = 'none';
                showToast('실험실 모드는 관리자 전용 기능입니다.');
                return;
            }
            if (this.checked) {
                // 체크를 누르면 바로 켜지지 않고 비밀번호 모달 오픈 (성공 전까지는 꺼진 상태)
                this.checked = false;
                if (currentLabPanel) currentLabPanel.style.display = 'none';
                openLabPasswordModal();
            } else {
                // 체크 해제 시 실험실 패널 닫기 및 기능 원복
                if (currentLabPanel) currentLabPanel.style.display = 'none';
                const chkOpenUpdateActionsEl = document.getElementById('chkOpenUpdateActions');
                if (chkOpenUpdateActionsEl) chkOpenUpdateActionsEl.checked = false;
                const chkOpenDateResetEl = document.getElementById('chkOpenDateReset');
                if (chkOpenDateResetEl) chkOpenDateResetEl.checked = true;
                const chkOpenNoticeFeatureEl = document.getElementById('chkOpenNoticeFeature');
                if (chkOpenNoticeFeatureEl) chkOpenNoticeFeatureEl.checked = true;
                const chkOpenSoldOutFeatureEl = document.getElementById('chkOpenSoldOutFeature');
                if (chkOpenSoldOutFeatureEl) chkOpenSoldOutFeatureEl.checked = false;
                const chkAllowF12El = document.getElementById('chkAllowF12');
                const hasF12 = typeof hasUserFeature === 'function' ? hasUserFeature('f12') : false;
                if (chkAllowF12El) chkAllowF12El.checked = hasF12;
                if (!hasF12) {
                    localStorage.setItem('v2_allowF12', 'false');
                    try { chrome.storage.local.set({ v2_allowF12: false }); } catch(e) {}
                }
                localStorage.setItem('v2_labModeActive', 'false');
                localStorage.setItem('v2_updateActionsActive', 'false');
                localStorage.setItem('v2_priceUpdateActive', 'false');
                localStorage.setItem('v2_replacePostActive', 'false');
                localStorage.setItem('v2_dateResetActive', 'true');
                localStorage.setItem('v2_noticeFeatureActive', 'true');
                localStorage.setItem('v2_soldOutFeatureActive', 'false');
                localStorage.setItem('v2_bumpFeatureActive', 'false');
                localStorage.setItem('v2_bumpTimerFeatureActive', 'false');
                try {
                    chrome.storage.local.set({ 
                        v2_labModeActive: false, 
                        v2_updateActionsActive: false, 
                        v2_priceUpdateActive: false, 
                        v2_replacePostActive: false, 
                        v2_dateResetActive: true, 
                        v2_noticeFeatureActive: true, 
                        v2_soldOutFeatureActive: false, 
                        v2_bumpFeatureActive: false, 
                        v2_bumpTimerFeatureActive: false 
                    });
                } catch(e) {}
                updateLabFeaturesUI(false);
                updateLivePrepaidFees();
                showToast('실험실 모드가 비활성화되었습니다.');
            }
        });
    }

    // 골프몬 변동수정 & 교체수정 오픈 체크박스 체인지 리스너 (실험실)
    const chkOpenUpdateActions = document.getElementById('chkOpenUpdateActions');
    if (chkOpenUpdateActions) {
        chkOpenUpdateActions.addEventListener('change', function() {
            const isOpened = this.checked;
            localStorage.setItem('v2_updateActionsActive', isOpened ? 'true' : 'false');
            localStorage.setItem('v2_priceUpdateActive', isOpened ? 'true' : 'false');
            localStorage.setItem('v2_replacePostActive', isOpened ? 'true' : 'false');
            try {
                chrome.storage.local.set({ v2_updateActionsActive: isOpened, v2_priceUpdateActive: isOpened, v2_replacePostActive: isOpened });
            } catch(e) {}
            const isLabActive = localStorage.getItem('v2_labModeActive') === 'true';
            updateLabFeaturesUI(isLabActive);
            if (isOpened) {
                showToast('골프몬 수정(⟳) 아이콘이 오픈되었습니다.');
            } else {
                showToast('골프몬 수정(⟳) 아이콘이 숨김 처리되었습니다.');
            }
        });
    }

    // 골프몬 전체리셋 오픈 체크박스 체인지 리스너 (실험실)
    const chkOpenDateReset = document.getElementById('chkOpenDateReset');
    if (chkOpenDateReset) {
        chkOpenDateReset.addEventListener('change', function() {
            const isOpened = this.checked;
            localStorage.setItem('v2_dateResetActive', isOpened ? 'true' : 'false');
            try {
                chrome.storage.local.set({ v2_dateResetActive: isOpened });
            } catch(e) {}
            const isLabActive = localStorage.getItem('v2_labModeActive') === 'true';
            updateLabFeaturesUI(isLabActive);
            if (isOpened) {
                showToast('골프몬 전체리셋 바가 메인 화면에 오픈되었습니다.');
            } else {
                showToast('골프몬 전체리셋 바가 숨김 처리되었습니다.');
            }
        });
    }

    // 공지등록 기능 오픈 체크박스 체인지 리스너 (실험실)
    const chkOpenNoticeFeature = document.getElementById('chkOpenNoticeFeature');
    if (chkOpenNoticeFeature) {
        chkOpenNoticeFeature.addEventListener('change', function() {
            const isOpened = this.checked;
            localStorage.setItem('v2_noticeFeatureActive', isOpened ? 'true' : 'false');
            try {
                chrome.storage.local.set({ v2_noticeFeatureActive: isOpened });
            } catch(e) {}
            const isLabActive = localStorage.getItem('v2_labModeActive') === 'true';
            updateLabFeaturesUI(isLabActive);
            updateLivePrepaidFees();
            if (isOpened) {
                showToast('공지적용 버튼이 상단 헤더에 오픈되었습니다.');
            } else {
                showToast('공지적용 버튼이 숨김 처리되었습니다.');
            }
        });
    }

    // 플랫폼 동시 등록 기능 오픈 체크박스 체인지 리스너 (실험실)
    const chkOpenMultiFeature = document.getElementById('chkOpenMultiFeature');
    if (chkOpenMultiFeature) {
        chkOpenMultiFeature.addEventListener('change', function() {
            const isOpened = this.checked;
            localStorage.setItem('v2_multiFeatureActive', isOpened ? 'true' : 'false');
            try {
                chrome.storage.local.set({ v2_multiFeatureActive: isOpened });
            } catch(e) {}
            const isLabActive = localStorage.getItem('v2_labModeActive') === 'true';
            updateLabFeaturesUI(isLabActive);
            if (isOpened) {
                showToast('🌐 플랫폼 동시 등록 버튼이 오픈되었습니다.');
            } else {
                showToast('플랫폼 동시 등록 버튼이 숨김 처리되었습니다.');
            }
        });
    }

    // F12 / 개발자 도구 차단 해제 체크박스 체인지 리스너 (실험실/부여기능)
    const chkAllowF12 = document.getElementById('chkAllowF12');
    if (chkAllowF12) {
        chkAllowF12.addEventListener('change', function() {
            const isOpened = this.checked;
            localStorage.setItem('v2_allowF12', isOpened ? 'true' : 'false');
            try {
                chrome.storage.local.set({ v2_allowF12: isOpened });
            } catch(e) {}
            const isLabActive = localStorage.getItem('v2_labModeActive') === 'true';
            updateLabFeaturesUI(isLabActive);
            if (isOpened) {
                showToast('🔓 F12 및 개발자 도구 차단이 해제되었습니다.');
            } else {
                showToast('F12 및 개발자 도구 차단이 다시 활성화되었습니다.');
            }
        });
    }

    // 원클릭 마감/삭제 기능 오픈 체크박스 체인지 리스너 (실험실)
    const chkOpenSoldOutFeature = document.getElementById('chkOpenSoldOutFeature');
    if (chkOpenSoldOutFeature) {
        chkOpenSoldOutFeature.addEventListener('change', function() {
            const isOpened = this.checked;
            localStorage.setItem('v2_soldOutFeatureActive', isOpened ? 'true' : 'false');
            try {
                chrome.storage.local.set({ v2_soldOutFeatureActive: isOpened });
            } catch(e) {}
            const isLabActive = localStorage.getItem('v2_labModeActive') === 'true';
            updateLabFeaturesUI(isLabActive);
            if (isOpened) {
                showToast('🚫 원클릭 마감/삭제 기능이 오픈되었습니다.');
            } else {
                showToast('원클릭 마감/삭제 기능이 숨김 처리되었습니다.');
            }
        });
    }



    // 실험실 비밀번호 모달 제어 이벤트 바인딩
    const btnConfirmLabPassword = document.getElementById('btnConfirmLabPassword');
    const btnCancelLabPassword = document.getElementById('btnCancelLabPassword');
    const btnCloseLabPasswordModalX = document.getElementById('btnCloseLabPasswordModalX');
    const labPasswordInput = document.getElementById('labPasswordInput');
    const labPasswordModal = document.getElementById('labPasswordModal');

    if (btnConfirmLabPassword) {
        btnConfirmLabPassword.addEventListener('click', verifyLabPassword);
    }
    if (btnCancelLabPassword) {
        btnCancelLabPassword.addEventListener('click', closeLabPasswordModal);
    }
    if (btnCloseLabPasswordModalX) {
        btnCloseLabPasswordModalX.addEventListener('click', closeLabPasswordModal);
    }
    if (labPasswordInput) {
        labPasswordInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                verifyLabPassword();
            } else if (e.key === 'Escape') {
                closeLabPasswordModal();
            }
        });
    }
    if (labPasswordModal) {
        labPasswordModal.addEventListener('click', (e) => {
            if (e.target === labPasswordModal) {
                closeLabPasswordModal();
            }
        });
    }

    // 입력 텍스트 복원 및 자동 저장
    const inputEl = document.getElementById('inputText');
    if (inputEl) {
        const savedText = localStorage.getItem('v2_savedInputText');
        if (savedText) inputEl.value = savedText;
        inputEl.addEventListener('input', function() {
            localStorage.setItem('v2_savedInputText', this.value);
        });
        inputEl.addEventListener('paste', function() {
            setTimeout(() => {
                const checkedCount = document.querySelectorAll('#dataTable tbody tr.selected').length;
                if (checkedCount > 0 && isSmartPrependActive()) {
                    showToast(`💡 기존 체크된 타임 ${checkedCount}건 대기 중입니다. [원클릭] 실행 시 미체크 항목은 자동 삭제되고 신규 타임이 상단에 추가됩니다.`);
                }
            }, 80);
        });
    }

    // 등록문구 복원 및 실시간 영구 저장 (기본 등록문구 + 특정 골프장 전용 문구)
    const topMemoEl = document.getElementById('golftopMemo');
    const rockMemoEl = document.getElementById('golfrockMemo');
    const legacyMemoEl = document.getElementById('golfmonMemo');

    const DEFAULT_TOP_MEMO = "";
    const LEGACY_SAMPLE_MEMOS = [
        "골프탑 지원 혜택가\n가장 빠르고 신속하게 모십니다\n타구장상담까지 한번에\n현재실장입니다!!",
        "골프락 지원 혜택가\n가장 빠르고 신속하게 모십니다\n타구장상담까지 한번에\n현재실장입니다!!"
    ];

    function isLegacySampleMemo(val) {
        if (!val || typeof val !== 'string') return false;
        const norm = val.replace(/\r\n/g, '\n').trim();
        return LEGACY_SAMPLE_MEMOS.includes(norm);
    }

    if (topMemoEl) {
        let savedTop = localStorage.getItem('v2_savedGolftopMemo') ?? localStorage.getItem('v2_savedGolfrockMemo') ?? localStorage.getItem('v2_savedGolfmonMemo');
        if (isLegacySampleMemo(savedTop)) {
            savedTop = '';
            try {
                localStorage.setItem('v2_savedGolftopMemo', '');
                localStorage.setItem('v2_savedGolfrockMemo', '');
                localStorage.setItem('v2_savedGolfmonMemo', '');
            } catch(e) {}
        }
        if (savedTop !== null && savedTop !== undefined) {
            topMemoEl.value = savedTop;
        } else {
            topMemoEl.value = DEFAULT_TOP_MEMO;
        }
        if (rockMemoEl) rockMemoEl.value = topMemoEl.value;
        if (legacyMemoEl) legacyMemoEl.value = topMemoEl.value;

        function saveMainMemo(showNotice = false) {
            const val = topMemoEl.value;
            try {
                localStorage.setItem('v2_savedGolftopMemo', val);
                localStorage.setItem('v2_savedGolfrockMemo', val);
                localStorage.setItem('v2_savedGolfmonMemo', val);
            } catch(e) {}
            try {
                if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
                    chrome.storage.local.set({ 
                        v2_savedGolftopMemo: val,
                        v2_savedGolfrockMemo: val,
                        v2_savedGolfmonMemo: val
                    });
                }
            } catch(e) {}
            if (rockMemoEl) rockMemoEl.value = val;
            if (legacyMemoEl) legacyMemoEl.value = val;
            if (showNotice) showToast('등록문구가 저장되었습니다.');
        }

        topMemoEl.addEventListener('input', () => saveMainMemo(false));
        topMemoEl.addEventListener('change', () => saveMainMemo(true));
        topMemoEl.addEventListener('blur', () => saveMainMemo(false));
    }

    // chrome.storage.local 비동기 동기화 복원
    try {
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.get(['v2_savedGolftopMemo', 'v2_savedGolfrockMemo', 'v2_savedGolfmonMemo'], (res) => {
                if (res) {
                    let saved = res.v2_savedGolftopMemo ?? res.v2_savedGolfrockMemo ?? res.v2_savedGolfmonMemo;
                    if (isLegacySampleMemo(saved)) {
                        saved = '';
                        try {
                            chrome.storage.local.set({
                                v2_savedGolftopMemo: '',
                                v2_savedGolfrockMemo: '',
                                v2_savedGolfmonMemo: ''
                            });
                        } catch(e) {}
                    }
                    if (saved !== undefined && saved !== null && topMemoEl) {
                        topMemoEl.value = saved;
                        if (rockMemoEl) rockMemoEl.value = saved;
                        if (legacyMemoEl) legacyMemoEl.value = saved;
                    }
                }
            });
        }
    } catch(e) {}

    // ========================================================
    // 특정 골프장 전용 등록문구 관리
    // ========================================================
    function updateCourseMemoDatalist() {
        const dl = document.getElementById('courseMemoDatalist');
        if (!dl) return;
        dl.innerHTML = '';
        const names = new Set();
        if (typeof dictionary === 'object' && dictionary) {
            Object.keys(dictionary).forEach(k => names.add(k.trim()));
        }
        document.querySelectorAll('#dataTable tbody tr').forEach(tr => {
            const raw = tr.dataset.rawGolf || tr.querySelectorAll('td')[2]?.textContent.trim();
            if (raw) names.add(raw);
        });
        names.forEach(name => {
            if (!name) return;
            const opt = document.createElement('option');
            opt.value = name;
            dl.appendChild(opt);
        });
    }

    function loadCustomCourseMemos(callback) {
        try {
            const localData = localStorage.getItem('custom_course_memos');
            if (localData) {
                customCourseMemos = JSON.parse(localData) || {};
            }
        } catch(e) {}
        try {
            if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
                chrome.storage.local.get(['custom_course_memos'], (res) => {
                    if (res && res.custom_course_memos && typeof res.custom_course_memos === 'object') {
                        customCourseMemos = res.custom_course_memos;
                    }
                    renderCustomCourseMemos();
                    if (callback) callback();
                });
                return;
            }
        } catch(e) {}
        renderCustomCourseMemos();
        if (callback) callback();
    }

    function saveCustomCourseMemos(showNotice = false) {
        try {
            localStorage.setItem('custom_course_memos', JSON.stringify(customCourseMemos));
        } catch(e) {}
        try {
            if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
                chrome.storage.local.set({ custom_course_memos: customCourseMemos });
            }
        } catch(e) {}
        renderCustomCourseMemos();
        if (showNotice) showToast('특정 구장 등록문구가 저장되었습니다.');
    }

    function renderCustomCourseMemos() {
        const container = document.getElementById('courseMemoListContainer');
        const badge = document.getElementById('courseMemoCountBadge');
        if (!container) return;

        container.innerHTML = '';
        const entries = Object.entries(customCourseMemos || {});
        if (badge) badge.textContent = `${entries.length}개 설정됨`;

        if (entries.length === 0) {
            container.innerHTML = '<div style="font-size: 10px; color: #94A3B8; text-align: center; padding: 7px 0; background: #FFFFFF; border: 1px dashed #E2E8F0; border-radius: 4px;">지정된 특정 구장 등록문구가 없습니다.<br>[+ 구장 추가]를 눌러 골프장 전용 문구를 등록하세요.</div>';
            return;
        }

        entries.forEach(([courseName, memoText]) => {
            const card = document.createElement('div');
            card.style.cssText = 'background: #FFFFFF; border: 1px solid #CBD5E1; border-radius: 4px; padding: 5px 6px; display: flex; flex-direction: column; gap: 3px; box-shadow: 0 1px 2px rgba(0,0,0,0.03);';

            const header = document.createElement('div');
            header.style.cssText = 'display: flex; justify-content: space-between; align-items: center;';

            const titleSpan = document.createElement('span');
            titleSpan.style.cssText = 'font-size: 10.5px; font-weight: 700; color: #065F46; display: flex; align-items: center; gap: 4px;';
            titleSpan.innerHTML = `<span style="font-size: 9px; background: #D1FAE5; color: #047857; padding: 1px 4px; border-radius: 3px; font-weight: 800;">구장</span>`;
            const nameTextNode = document.createTextNode(courseName);
            titleSpan.appendChild(nameTextNode);

            const delBtn = document.createElement('button');
            delBtn.type = 'button';
            delBtn.style.cssText = 'border: none; background: none; color: #EF4444; font-size: 11px; cursor: pointer; padding: 0 3px;';
            delBtn.title = '이 구장 전용 문구 삭제';
            delBtn.textContent = '🗑️';
            delBtn.addEventListener('click', () => {
                if (confirm(`[${courseName}] 전용 등록문구를 삭제하시겠습니까?`)) {
                    delete customCourseMemos[courseName];
                    saveCustomCourseMemos(true);
                }
            });

            header.appendChild(titleSpan);
            header.appendChild(delBtn);

            const textarea = document.createElement('textarea');
            textarea.rows = 2;
            textarea.value = memoText;
            textarea.style.cssText = 'width: 100%; box-sizing: border-box; font-size: 10px; padding: 4px; border: 1px solid #E2E8F0; border-radius: 3px; resize: vertical; line-height: 1.3; font-family: inherit; background: #F8FAFC;';
            textarea.placeholder = `${courseName} 전용 등록문구`;

            textarea.addEventListener('change', () => {
                customCourseMemos[courseName] = textarea.value.trim();
                saveCustomCourseMemos(true);
            });

            card.appendChild(header);
            card.appendChild(textarea);
            container.appendChild(card);
        });
    }

    function initCourseMemoUI() {
        const btnAdd = document.getElementById('btnAddCourseMemoRow');
        const addBox = document.getElementById('courseMemoAddBox');
        const btnSave = document.getElementById('btnSaveNewCourseMemo');
        const btnCancel = document.getElementById('btnCancelNewCourseMemo');
        const inputName = document.getElementById('inputNewCourseMemoName');
        const inputText = document.getElementById('inputNewCourseMemoText');

        if (btnAdd && addBox) {
            btnAdd.addEventListener('click', () => {
                addBox.style.display = 'block';
                updateCourseMemoDatalist();
                if (inputName) inputName.focus();
            });
        }

        if (btnCancel && addBox) {
            btnCancel.addEventListener('click', () => {
                addBox.style.display = 'none';
                if (inputName) inputName.value = '';
                if (inputText) inputText.value = '';
            });
        }

        if (btnSave && inputName && inputText) {
            btnSave.addEventListener('click', () => {
                const cName = inputName.value.trim();
                const text = inputText.value.trim();
                if (!cName) {
                    alert('골프장명을 입력해주세요.');
                    inputName.focus();
                    return;
                }
                if (!text) {
                    alert('등록문구를 입력해주세요.');
                    inputText.focus();
                    return;
                }
                customCourseMemos[cName] = text;
                saveCustomCourseMemos(true);
                inputName.value = '';
                inputText.value = '';
                if (addBox) addBox.style.display = 'none';
            });
        }
    }

    loadCustomCourseMemos();
    initCourseMemoUI();

    // 옵션 필드(시간 앞당김, 특정구장, 제외구장) 복원 및 자동 저장
    const timeAdjustEl = document.getElementById('timeAdjust');
    if (timeAdjustEl) {
        const saved = localStorage.getItem('v2_savedTimeAdjust');
        if (saved !== null) timeAdjustEl.value = saved;
        timeAdjustEl.addEventListener('input', function() {
            localStorage.setItem('v2_savedTimeAdjust', this.value);
        });
        const lblTimeAdjustIcon = document.getElementById('lblTimeAdjustIcon');
        if (lblTimeAdjustIcon) {
            lblTimeAdjustIcon.addEventListener('click', function() {
                timeAdjustEl.focus();
                timeAdjustEl.select();
            });
        }
    }
    const targetGolfsEl = document.getElementById('targetGolfs');
    if (targetGolfsEl) {
        const saved = localStorage.getItem('v2_savedTargetGolfs');
        if (saved !== null) targetGolfsEl.value = saved;
        targetGolfsEl.addEventListener('input', function() {
            localStorage.setItem('v2_savedTargetGolfs', this.value);
        });
    }
    const excludeGolfsEl = document.getElementById('excludeGolfs');
    if (excludeGolfsEl) {
        const saved = localStorage.getItem('v2_savedExcludeGolfs');
        if (saved !== null) excludeGolfsEl.value = saved;
        excludeGolfsEl.addEventListener('input', function() {
            localStorage.setItem('v2_savedExcludeGolfs', this.value);
        });
    }

    // 특정구장 가격 변경 (일괄 가감) 모달 로직
    const coursePriceModal = document.getElementById('coursePriceModal');
    const btnOpenCoursePriceModal = document.getElementById('btnOpenCoursePriceModal');
    const btnCloseCoursePriceModalX = document.getElementById('btnCloseCoursePriceModalX');
    const btnCancelCoursePriceModal = document.getElementById('btnCancelCoursePriceModal');
    const btnSaveCoursePriceModal = document.getElementById('btnSaveCoursePriceModal');
    const btnClearCoursePriceAll = document.getElementById('btnClearCoursePriceAll');
    const btnAddCoursePriceDiff = document.getElementById('btnAddCoursePriceDiff');
    const inputNewCourseName = document.getElementById('inputNewCourseName');
    const inputNewCourseDiff = document.getElementById('inputNewCourseDiff');
    const btnToggleBatchCoursePrice = document.getElementById('btnToggleBatchCoursePrice');
    const batchCoursePriceWrap = document.getElementById('batchCoursePriceWrap');
    const textBatchCoursePrice = document.getElementById('textBatchCoursePrice');
    const btnApplyBatchCoursePrice = document.getElementById('btnApplyBatchCoursePrice');
    const btnReplaceBatchCoursePrice = document.getElementById('btnReplaceBatchCoursePrice');
    const btnQuickCopyCoursePrice = document.getElementById('btnQuickCopyCoursePrice');
    const btnCopyAllCoursePriceRules = document.getElementById('btnCopyAllCoursePriceRules');
    const btnPasteClipboardBatch = document.getElementById('btnPasteClipboardBatch');
    const btnClearBatchText = document.getElementById('btnClearBatchText');
    const coursePriceChipContainer = document.getElementById('coursePriceChipContainer');

    let tempCoursePriceAdjustments = [];

    function copyTextToClipboard(text) {
        if (!text) return Promise.resolve(false);
        if (navigator.clipboard && navigator.clipboard.writeText) {
            return navigator.clipboard.writeText(text).then(() => true).catch(() => fallbackCopyText(text));
        }
        return Promise.resolve(fallbackCopyText(text));
    }

    function fallbackCopyText(text) {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.top = '-9999px';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        let ok = false;
        try {
            ok = document.execCommand('copy');
        } catch (e) {
            ok = false;
        }
        document.body.removeChild(ta);
        return ok;
    }

    function handleCopyAllCoursePriceRules() {
        const listToExport = (tempCoursePriceAdjustments && tempCoursePriceAdjustments.length > 0)
            ? tempCoursePriceAdjustments
            : (customCoursePriceAdjustments || []);

        if (!listToExport || listToExport.length === 0) {
            showToast('복사할 등록된 구장 가격 규칙이 없습니다.');
            return;
        }

        const formattedLines = listToExport
            .map(formatCoursePriceRuleToText)
            .filter(Boolean);

        const fullExportText = formattedLines.join('\n');

        // 클립보드 복사
        copyTextToClipboard(fullExportText);

        // 일괄 입력 텍스트창도 펼치고 내용 채우기
        if (batchCoursePriceWrap) {
            batchCoursePriceWrap.style.display = 'block';
            if (btnToggleBatchCoursePrice) btnToggleBatchCoursePrice.innerText = '접기 ▲';
        }
        if (textBatchCoursePrice) {
            textBatchCoursePrice.value = fullExportText;
            textBatchCoursePrice.focus();
            textBatchCoursePrice.select();
        }

        showToast(`${listToExport.length}개 구장 가격변경 목록이 복사되었습니다!\n다른 창이나 PC에서 붙여넣어(Ctrl+V) 일괄 등록하세요.`);
    }

    function renderCoursePriceChips() {
        if (!coursePriceChipContainer) return;
        coursePriceChipContainer.innerHTML = '';
        const modalCount = document.getElementById('coursePriceModalCountText');
        if (modalCount) modalCount.innerText = tempCoursePriceAdjustments.length;

        if (tempCoursePriceAdjustments.length === 0) {
            coursePriceChipContainer.innerHTML = `
                <div class="prepaid-empty-notice">
                    등록된 구장별 가격 변경 규칙이 없습니다.<br>
                    (구장명과 가격 가감 수치[-2, -1, +1, +2], 부제를 선택하여 입력하세요)
                </div>
            `;
            return;
        }

        tempCoursePriceAdjustments.forEach((item, idx) => {
            const chip = document.createElement('div');
            chip.className = 'course-price-chip';
            const signStr = item.diff > 0 ? `+${item.diff}만` : `${item.diff}만`;
            const valClass = item.diff > 0 ? 'adj-val-plus' : 'adj-val-minus';
            const partDesc = getCourseAdjPartDesc(item);
            const partBadge = `<span style="font-size: 9px; background: #EEF2FF; color: #4338CA; border: 1px solid #C7D2FE; padding: 1px 4px; border-radius: 4px; font-weight: 700; margin-left: 3px;">${partDesc}</span>`;

            chip.innerHTML = `
                <span><strong>${escapeHtml(item.course)}</strong> ${partBadge}: <span class="${valClass}">${signStr}</span></span>
                <button type="button" class="prepaid-chip-del" data-idx="${idx}" title="삭제">✕</button>
            `;
            coursePriceChipContainer.appendChild(chip);
        });

        coursePriceChipContainer.querySelectorAll('.prepaid-chip-del').forEach(btn => {
            btn.addEventListener('click', () => {
                const idx = parseInt(btn.dataset.idx, 10);
                if (!isNaN(idx) && idx >= 0 && idx < tempCoursePriceAdjustments.length) {
                    tempCoursePriceAdjustments.splice(idx, 1);
                    renderCoursePriceChips();
                }
            });
        });
    }

    function addCoursePriceDiffFromInputs() {
        if (!inputNewCourseName || !inputNewCourseDiff) return;
        const rawName = inputNewCourseName.value.trim();
        const rawDiff = inputNewCourseDiff.value.trim();
        if (!rawName) {
            showToast('구장명을 입력해주세요.');
            inputNewCourseName.focus();
            return;
        }
        const diffVal = parseDiffValue(rawDiff);
        if (diffVal === null || isNaN(diffVal) || diffVal === 0) {
            showToast('가감할 금액을 숫자로 입력해주세요 (예: -2, -1, +1, +2)');
            inputNewCourseDiff.focus();
            return;
        }

        const chk1 = document.getElementById('chkCoursePart1')?.checked ?? true;
        const chk2 = document.getElementById('chkCoursePart2')?.checked ?? true;
        const chk3 = document.getElementById('chkCoursePart3')?.checked ?? true;

        if (!chk1 && !chk2 && !chk3) {
            showToast('적용할 부제(1부, 2부, 3부)를 최소 1개 이상 체크해주세요.');
            return;
        }

        const cleanNew = rawName.replace(/[\s\-_()\[\]]/g, '').toLowerCase();
        const existingIdx = tempCoursePriceAdjustments.findIndex(item => {
            const isSame = item.course.replace(/[\s\-_()\[\]]/g, '').toLowerCase() === cleanNew;
            const isSameParts = (item.hasPart1 === chk1) && (item.hasPart2 === chk2) && (item.hasPart3 === chk3);
            return isSame && isSameParts;
        });

        const newRule = { course: rawName, diff: diffVal, hasPart1: chk1, hasPart2: chk2, hasPart3: chk3 };
        const partDesc = getCourseAdjPartDesc(newRule);

        if (existingIdx >= 0) {
            tempCoursePriceAdjustments[existingIdx] = newRule;
            showToast(`'${rawName}' [${partDesc}] 금액 변경 규칙이 갱신되었습니다.`);
        } else {
            tempCoursePriceAdjustments.push(newRule);
            showToast(`'${rawName}' [${partDesc}] (${diffVal > 0 ? `+${diffVal}` : diffVal}만) 추가되었습니다.`);
        }

        inputNewCourseDiff.value = '';
        renderCoursePriceChips();
        inputNewCourseName.focus();
    }

    function addBatchCoursePriceFromTextarea() {
        if (!textBatchCoursePrice) return;
        const text = textBatchCoursePrice.value.trim();
        if (!text) {
            showToast('붙여넣을 텍스트가 없습니다.');
            return;
        }
        const lines = text.split('\n');
        let addedCount = 0;
        let lastCourse = '';

        lines.forEach(line => {
            const trimmed = line.trim();
            if (!trimmed) return;

            // 라인 자체에 구장명만 단독으로 있는 경우 (예: "남양주cc", "[남양주cc]")
            if (!/\d+(?:\.\d+)?\s*(?:만|만원)?/.test(trimmed) && !/[-+]\d+/.test(trimmed)) {
                const pureName = trimmed.replace(/^[●■□★◆▶▷*#•\-\s]+|[\(\)\[\]]/g, '').trim();
                if (pureName && !isNonGolfLine(pureName) && !isNonCourseWord(pureName)) {
                    lastCourse = pureName;
                    return;
                }
            }

            const parsed = parseCoursePriceAdjustmentLine(trimmed, lastCourse);
            if (parsed) {
                if (parsed.course) lastCourse = parsed.course;
                const cleanNew = parsed.course.replace(/[\s\-_()\[\]]/g, '').toLowerCase();
                const existingIdx = tempCoursePriceAdjustments.findIndex(item => {
                    const isSame = item.course.replace(/[\s\-_()\[\]]/g, '').toLowerCase() === cleanNew;
                    const isSameParts = (item.hasPart1 === parsed.hasPart1) && (item.hasPart2 === parsed.hasPart2) && (item.hasPart3 === parsed.hasPart3);
                    return isSame && isSameParts;
                });
                if (existingIdx >= 0) {
                    tempCoursePriceAdjustments[existingIdx] = parsed;
                } else {
                    tempCoursePriceAdjustments.push(parsed);
                }
                addedCount++;
            }
        });

        textBatchCoursePrice.value = '';
        renderCoursePriceChips();
        if (addedCount > 0) {
            showToast(`${addedCount}개 구장/부제별 가격변경 규칙이 등록되었습니다.`);
        } else {
            showToast('인식 가능한 구장명 및 금액 형식이 없습니다. (예: 남양주cc 1~2부 -2)');
        }
    }

    function openCoursePriceModal() {
        tempCoursePriceAdjustments = JSON.parse(JSON.stringify(customCoursePriceAdjustments || []));
        if (inputNewCourseName) inputNewCourseName.value = '';
        if (inputNewCourseDiff) inputNewCourseDiff.value = '';
        const chk1 = document.getElementById('chkCoursePart1');
        const chk2 = document.getElementById('chkCoursePart2');
        const chk3 = document.getElementById('chkCoursePart3');
        if (chk1) chk1.checked = true;
        if (chk2) chk2.checked = true;
        if (chk3) chk3.checked = true;
        if (textBatchCoursePrice) textBatchCoursePrice.value = '';
        if (batchCoursePriceWrap) batchCoursePriceWrap.style.display = 'none';
        if (btnToggleBatchCoursePrice) btnToggleBatchCoursePrice.innerText = '펼치기 ▼';
        renderCoursePriceChips();
        if (coursePriceModal) {
            coursePriceModal.style.display = 'flex';
            setTimeout(() => inputNewCourseName?.focus(), 50);
        }
    }

    function closeCoursePriceModal() {
        if (coursePriceModal) coursePriceModal.style.display = 'none';
        tempCoursePriceAdjustments = [];
    }

    if (btnOpenCoursePriceModal) btnOpenCoursePriceModal.addEventListener('click', openCoursePriceModal);

    // 특정구장 가격변경 적용/미적용 체크박스 이벤트 연결
    const chkEnableCoursePriceRules = document.getElementById('chkEnableCoursePriceRules');
    if (chkEnableCoursePriceRules) {
        chkEnableCoursePriceRules.addEventListener('change', (e) => {
            setCoursePriceRulesActive(e.target.checked, true);
        });
    }
    if (btnCloseCoursePriceModalX) btnCloseCoursePriceModalX.addEventListener('click', closeCoursePriceModal);
    if (btnCancelCoursePriceModal) btnCancelCoursePriceModal.addEventListener('click', closeCoursePriceModal);

    if (coursePriceModal) {
        coursePriceModal.addEventListener('click', (e) => {
            if (e.target === coursePriceModal) {
                closeCoursePriceModal();
            }
        });
    }

    if (btnAddCoursePriceDiff) {
        btnAddCoursePriceDiff.addEventListener('click', addCoursePriceDiffFromInputs);
    }
    if (inputNewCourseName) {
        inputNewCourseName.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                if (inputNewCourseDiff && !inputNewCourseDiff.value.trim()) {
                    inputNewCourseDiff.focus();
                } else {
                    addCoursePriceDiffFromInputs();
                }
            }
        });
    }
    if (inputNewCourseDiff) {
        inputNewCourseDiff.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                addCoursePriceDiffFromInputs();
            }
        });
    }

    if (btnToggleBatchCoursePrice && batchCoursePriceWrap) {
        btnToggleBatchCoursePrice.addEventListener('click', () => {
            const isHidden = batchCoursePriceWrap.style.display === 'none';
            batchCoursePriceWrap.style.display = isHidden ? 'block' : 'none';
            btnToggleBatchCoursePrice.innerText = isHidden ? '접기 ▲' : '펼치기 ▼';
            if (isHidden && textBatchCoursePrice) {
                setTimeout(() => textBatchCoursePrice.focus(), 50);
            }
        });
    }

    if (btnApplyBatchCoursePrice) {
        btnApplyBatchCoursePrice.addEventListener('click', addBatchCoursePriceFromTextarea);
    }

    if (btnReplaceBatchCoursePrice) {
        btnReplaceBatchCoursePrice.addEventListener('click', () => {
            if (!textBatchCoursePrice || !textBatchCoursePrice.value.trim()) {
                showToast('붙여넣을 텍스트가 없습니다.');
                return;
            }
            if (tempCoursePriceAdjustments.length > 0) {
                if (!confirm(`기존에 등록된 ${tempCoursePriceAdjustments.length}개 규칙을 모두 지우고, 입력창의 내용으로 새로 등록하시겠습니까?`)) {
                    return;
                }
            }
            tempCoursePriceAdjustments = [];
            addBatchCoursePriceFromTextarea();
        });
    }

    if (btnQuickCopyCoursePrice) {
        btnQuickCopyCoursePrice.addEventListener('click', handleCopyAllCoursePriceRules);
    }

    if (btnCopyAllCoursePriceRules) {
        btnCopyAllCoursePriceRules.addEventListener('click', handleCopyAllCoursePriceRules);
    }

    if (btnPasteClipboardBatch) {
        btnPasteClipboardBatch.addEventListener('click', async () => {
            try {
                if (navigator.clipboard && navigator.clipboard.readText) {
                    const clipText = await navigator.clipboard.readText();
                    if (clipText && clipText.trim()) {
                        if (textBatchCoursePrice) {
                            textBatchCoursePrice.value = clipText.trim();
                            textBatchCoursePrice.focus();
                        }
                        showToast('클립보드 내용을 붙여넣었습니다. [텍스트 일괄 등록] 또는 [기존목록 교체]를 누르세요.');
                        return;
                    }
                }
            } catch (err) {}
            if (textBatchCoursePrice) {
                textBatchCoursePrice.focus();
            }
            showToast('입력창에 직접 Ctrl+V로 붙여넣어 주세요.');
        });
    }

    if (btnClearBatchText) {
        btnClearBatchText.addEventListener('click', () => {
            if (textBatchCoursePrice) {
                textBatchCoursePrice.value = '';
                textBatchCoursePrice.focus();
            }
        });
    }

    if (btnClearCoursePriceAll) {
        btnClearCoursePriceAll.addEventListener('click', () => {
            if (tempCoursePriceAdjustments.length === 0) return;
            if (confirm('등록된 모든 특정구장 가격변경 규칙을 삭제하시겠습니까?')) {
                tempCoursePriceAdjustments = [];
                renderCoursePriceChips();
            }
        });
    }

    if (btnSaveCoursePriceModal) {
        btnSaveCoursePriceModal.addEventListener('click', () => {
            if (inputNewCourseName && inputNewCourseDiff && inputNewCourseName.value.trim() && inputNewCourseDiff.value.trim()) {
                const dVal = parseDiffValue(inputNewCourseDiff.value);
                if (dVal !== null) {
                    const cName = inputNewCourseName.value.trim();
                    const chk1 = document.getElementById('chkCoursePart1')?.checked ?? true;
                    const chk2 = document.getElementById('chkCoursePart2')?.checked ?? true;
                    const chk3 = document.getElementById('chkCoursePart3')?.checked ?? true;
                    if (chk1 || chk2 || chk3) {
                        const cleanNew = cName.replace(/[\s\-_()\[\]]/g, '').toLowerCase();
                        const existingIdx = tempCoursePriceAdjustments.findIndex(item => {
                            const isSame = item.course.replace(/[\s\-_()\[\]]/g, '').toLowerCase() === cleanNew;
                            const isSameParts = (item.hasPart1 === chk1) && (item.hasPart2 === chk2) && (item.hasPart3 === chk3);
                            return isSame && isSameParts;
                        });
                        const newRule = { course: cName, diff: dVal, hasPart1: chk1, hasPart2: chk2, hasPart3: chk3 };
                        if (existingIdx >= 0) {
                            tempCoursePriceAdjustments[existingIdx] = newRule;
                        } else {
                            tempCoursePriceAdjustments.push(newRule);
                        }
                    }
                }
            }
            customCoursePriceAdjustments = [...tempCoursePriceAdjustments];
            saveCoursePriceAdjustments();
            updateLivePrepaidFees();
            closeCoursePriceModal();
            showToast(`특정구장 가격변경 ${customCoursePriceAdjustments.length}건이 저장 및 반영되었습니다.`);
        });
    }

    // 특정구장 전용 변환 대상 구장 설정 모달 이벤트 연결
    const specialCoursesModal = document.getElementById('specialCoursesModal');
    const btnOpenSpecialCoursesModal = document.getElementById('btnOpenSpecialCoursesModal');
    const btnCloseSpecialCoursesModalX = document.getElementById('btnCloseSpecialCoursesModalX');
    const btnCancelSpecialCoursesModal = document.getElementById('btnCancelSpecialCoursesModal');
    const btnSaveSpecialCoursesModal = document.getElementById('btnSaveSpecialCoursesModal');
    const btnResetSpecialCourses = document.getElementById('btnResetSpecialCourses');
    const btnClearSpecialCourses = document.getElementById('btnClearSpecialCourses');
    const btnAddSpecialCourse = document.getElementById('btnAddSpecialCourse');
    const inputNewSpecialCourse = document.getElementById('inputNewSpecialCourse');
    const specialCoursesChipContainer = document.getElementById('specialCoursesChipContainer');
    const specialCoursesCountText = document.getElementById('specialCoursesCountText');

    let tempSpecialCourses = [];

    function renderSpecialCoursesChips() {
        if (!specialCoursesChipContainer) return;
        specialCoursesChipContainer.innerHTML = '';
        if (specialCoursesCountText) {
            specialCoursesCountText.textContent = tempSpecialCourses.length.toString();
        }

        if (tempSpecialCourses.length === 0) {
            specialCoursesChipContainer.innerHTML = `
                <div class="prepaid-empty-notice">
                    지정된 특정구장이 없습니다.<br>
                    위 입력창에 구장명을 입력하고 [+ 구장 추가]를 눌러주세요.
                </div>
            `;
            return;
        }

        tempSpecialCourses.forEach((courseName, idx) => {
            const chip = document.createElement('div');
            chip.className = 'course-price-chip';
            chip.style.borderColor = '#FDE68A';
            chip.style.background = '#FFFBEB';
            chip.innerHTML = `
                <span><strong style="color: #92400E;">${escapeHtml(courseName)}</strong></span>
                <button type="button" class="prepaid-chip-del" data-idx="${idx}" title="삭제">✕</button>
            `;
            specialCoursesChipContainer.appendChild(chip);
        });

        specialCoursesChipContainer.querySelectorAll('.prepaid-chip-del').forEach(btn => {
            btn.addEventListener('click', () => {
                const idx = parseInt(btn.dataset.idx, 10);
                if (!isNaN(idx) && idx >= 0 && idx < tempSpecialCourses.length) {
                    tempSpecialCourses.splice(idx, 1);
                    renderSpecialCoursesChips();
                }
            });
        });
    }

    function addSpecialCourseFromInput() {
        if (!inputNewSpecialCourse) return;
        const raw = inputNewSpecialCourse.value.trim();
        if (!raw) {
            showToast('추가할 구장명을 입력해주세요.');
            inputNewSpecialCourse.focus();
            return;
        }
        const parts = raw.split(/[,/\n]+/).map(s => s.trim()).filter(Boolean);
        let added = 0;
        parts.forEach(p => {
            const exists = tempSpecialCourses.some(c => c.replace(/\s+/g, '').toLowerCase() === p.replace(/\s+/g, '').toLowerCase());
            if (!exists) {
                tempSpecialCourses.push(p);
                added++;
            }
        });
        inputNewSpecialCourse.value = '';
        renderSpecialCoursesChips();
        inputNewSpecialCourse.focus();
        if (added > 0) {
            showToast(`${added}개 구장이 목록에 추가되었습니다.`);
        } else {
            showToast('이미 목록에 있는 구장입니다.');
        }
    }

    function openSpecialCoursesModal() {
        tempSpecialCourses = [...(specialTargetCourses || DEFAULT_SPECIAL_COURSES)];
        if (inputNewSpecialCourse) inputNewSpecialCourse.value = '';
        renderSpecialCoursesChips();
        if (specialCoursesModal) {
            specialCoursesModal.style.display = 'flex';
            setTimeout(() => inputNewSpecialCourse?.focus(), 50);
        }
    }

    function closeSpecialCoursesModal() {
        if (specialCoursesModal) specialCoursesModal.style.display = 'none';
    }

    if (btnOpenSpecialCoursesModal) {
        btnOpenSpecialCoursesModal.addEventListener('click', openSpecialCoursesModal);
    }
    if (btnCloseSpecialCoursesModalX) {
        btnCloseSpecialCoursesModalX.addEventListener('click', closeSpecialCoursesModal);
    }
    if (btnCancelSpecialCoursesModal) {
        btnCancelSpecialCoursesModal.addEventListener('click', closeSpecialCoursesModal);
    }
    if (specialCoursesModal) {
        specialCoursesModal.addEventListener('click', (e) => {
            if (e.target === specialCoursesModal) closeSpecialCoursesModal();
        });
    }
    if (btnAddSpecialCourse) {
        btnAddSpecialCourse.addEventListener('click', addSpecialCourseFromInput);
    }
    if (inputNewSpecialCourse) {
        inputNewSpecialCourse.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                addSpecialCourseFromInput();
            }
        });
    }
    if (btnResetSpecialCourses) {
        btnResetSpecialCourses.addEventListener('click', () => {
            tempSpecialCourses = [...DEFAULT_SPECIAL_COURSES];
            renderSpecialCoursesChips();
            showToast('기본 4구장(클럽72, 비에이비스타, 비에이비스타(P), 클럽72(오션))으로 복원되었습니다.');
        });
    }
    if (btnClearSpecialCourses) {
        btnClearSpecialCourses.addEventListener('click', () => {
            tempSpecialCourses = [];
            renderSpecialCoursesChips();
        });
    }
    if (btnSaveSpecialCoursesModal) {
        btnSaveSpecialCoursesModal.addEventListener('click', () => {
            // 입력창에 미추가 텍스트가 남아 있으면 함께 추가
            if (inputNewSpecialCourse && inputNewSpecialCourse.value.trim()) {
                const parts = inputNewSpecialCourse.value.trim().split(/[,/\n]+/).map(s => s.trim()).filter(Boolean);
                parts.forEach(p => {
                    const exists = tempSpecialCourses.some(c => c.replace(/\s+/g, '').toLowerCase() === p.replace(/\s+/g, '').toLowerCase());
                    if (!exists) tempSpecialCourses.push(p);
                });
                inputNewSpecialCourse.value = '';
            }
            specialTargetCourses = [...tempSpecialCourses];
            saveSpecialTargetCourses();
            closeSpecialCoursesModal();
            showToast(`특정구장 변환 대상(${specialTargetCourses.length}개 구장)이 저장되었습니다.`);
        });
    }

    const selPriorityMain = document.getElementById('selAutoSelectPriority');
    if (selPriorityMain) {
        selPriorityMain.addEventListener('change', (e) => {
            setAutoSelectPriority(e.target.value, true);
        });
    }

    const selPrioritySettings = document.getElementById('selAutoSelectPrioritySettings');
    if (selPrioritySettings) {
        selPrioritySettings.addEventListener('change', (e) => {
            setAutoSelectPriority(e.target.value, true);
        });
    }

    // 공지 적용 모달 이벤트 연결
    const noticeModal = document.getElementById('noticeModal');
    const btnOpenNoticeModal = document.getElementById('btnOpenNoticeModal');
    const btnCloseNoticeModalX = document.getElementById('btnCloseNoticeModalX');
    const btnCancelNoticeModal = document.getElementById('btnCancelNoticeModal');
    const btnApplyNotice = document.getElementById('btnApplyNotice');
    const btnRevertNotice = document.getElementById('btnRevertNotice');
    const noticeInputText = document.getElementById('noticeInputText');

    function openNoticeModal() {
        if (noticeModal) {
            loadActiveNoticeRules();
            renderActiveNoticeChips();
            loadCustomNoticeCourses();
            populateNoticeSuggestions();
            closeNoticeCourseDropdown();

            if (noticeInputText && noticeInputText.value.trim()) {
                syncParsedNoticeToManualInputs(noticeInputText.value.trim());
            } else {
                currentParsedNoticeRules = [];
                renderParsedNoticeRules();
                updateManualNoticeHint();
            }
            noticeModal.style.display = 'flex';
            setTimeout(() => {
                const manualPrice = document.getElementById('manualNoticePrice');
                const manualCourse = document.getElementById('manualNoticeCourse');
                if (manualCourse && manualCourse.value.trim() && manualPrice) {
                    manualPrice.focus();
                } else if (noticeInputText) {
                    noticeInputText.focus();
                }
            }, 60);
        }
    }

    function closeNoticeModal() {
        closeNoticeCourseDropdown();
        if (noticeModal) {
            noticeModal.style.display = 'none';
        }
    }

    if (btnOpenNoticeModal) btnOpenNoticeModal.addEventListener('click', openNoticeModal);

    // 골프탑 공지방 [검색] 버튼 클릭 이벤트 연결 (사용자가 원할 때만 1회성 가볍게 실행)
    const btnSearchKakaoNotice = document.getElementById('btnSearchKakaoNotice');
    if (btnSearchKakaoNotice) {
        btnSearchKakaoNotice.addEventListener('click', (e) => {
            e.preventDefault();
            searchAndApplyKakaoNotices();
        });
    }

    // 상단 헤더 공지 동기화(새로고침 🔄 아이콘) 클릭 이벤트 연결
    const btnHeaderNoticeSync = document.getElementById('btnHeaderNoticeSync');
    if (btnHeaderNoticeSync) {
        btnHeaderNoticeSync.addEventListener('click', (e) => {
            e.stopPropagation(); // 공지 모달 열림 방지
            syncNoticesWithCloud();
        });
    }

    // 공지가격 적용/미적용 체크박스 이벤트 연결 (하위 호환)
    const chkEnableNoticeRules = document.getElementById('chkEnableNoticeRules');
    if (chkEnableNoticeRules) {
        chkEnableNoticeRules.addEventListener('change', (e) => {
            setNoticeRulesActive(e.target.checked, true);
        });
    }

    if (btnCloseNoticeModalX) btnCloseNoticeModalX.addEventListener('click', closeNoticeModal);
    if (btnCancelNoticeModal) btnCancelNoticeModal.addEventListener('click', closeNoticeModal);

    const btnClearAllNotices = document.getElementById('btnClearAllNotices');
    if (btnClearAllNotices) {
        btnClearAllNotices.addEventListener('click', () => {
            clearAllNotices();
        });
    }

    if (noticeModal) {
        noticeModal.addEventListener('click', (e) => {
            if (e.target === noticeModal) {
                closeNoticeModal();
            }
        });
    }

    const btnPasteNoticeClipboard = document.getElementById('btnPasteNoticeClipboard');
    if (btnPasteNoticeClipboard) {
        btnPasteNoticeClipboard.addEventListener('click', async () => {
            try {
                const text = await navigator.clipboard.readText();
                if (text && text.trim()) {
                    const cleanText = text.trim();
                    if (noticeInputText) {
                        noticeInputText.value = cleanText;
                    }
                    syncParsedNoticeToManualInputs(cleanText);
                    showToast('공지 텍스트를 붙여넣고 아래 적용 내용을 자동 인식했습니다.');
                } else {
                    showToast('클립보드에 복사된 텍스트가 없습니다.');
                }
            } catch(e) {
                showToast('클립보드 읽기 권한이 필요합니다. (직접 붙여넣기는 Ctrl+V)');
            }
        });
    }

    if (noticeInputText) {
        noticeInputText.addEventListener('input', function() {
            syncParsedNoticeToManualInputs(this.value);
        });
        noticeInputText.addEventListener('paste', function() {
            setTimeout(() => {
                syncParsedNoticeToManualInputs(this.value);
            }, 50);
        });
    }

    if (btnApplyNotice) {
        btnApplyNotice.addEventListener('click', () => {
            const raw = noticeInputText ? noticeInputText.value.trim() : '';
            const manualCourse = document.getElementById('manualNoticeCourse')?.value.trim();
            const manualDate = document.getElementById('manualNoticeDate')?.value.trim();
            const manualPrice = document.getElementById('manualNoticePrice')?.value.trim();

            // 1. currentParsedNoticeRules에 1개 이상의 규칙이 등록되어 있는 경우 -> 일괄 적용
            if (currentParsedNoticeRules && currentParsedNoticeRules.length > 0) {
                if (!isNoticeRulesActive) {
                    setNoticeRulesActive(true, false);
                }

                const now = new Date();
                const nowTs = Date.now();
                const receivedAtStr = formatNoticeReceivedTime(now, nowTs);

                // 등록하려는 구장들의 로컬 삭제 이력(Tombstone) 해제
                const distinctRegisteredCourses = [...new Set(currentParsedNoticeRules.map(r => normalizeNoticeCourseName(r.course || manualCourse || '')).filter(Boolean))];
                distinctRegisteredCourses.forEach(cName => removeLocallyDeletedNoticeCourse(cName));

                // 새 규칙 속성 정규화
                currentParsedNoticeRules.forEach(r => {
                    r.course = normalizeNoticeCourseName(r.course || manualCourse || '');
                    if ((!r.date || r.date === '전체') && manualDate && manualDate !== '전체' && !manualDate.includes('복수') && manualDate !== '별도공지전까지') {
                        r.date = manualDate;
                    }
                    if (!r.dateRange && r.date) {
                        const parsedR = parseNoticeDateRange(r.date);
                        if (parsedR) r.dateRange = parsedR;
                    }
                    r.receivedAt = receivedAtStr;
                    r.receivedTimestamp = nowTs;
                    if (!r.fullNoticeText) {
                        r.fullNoticeText = raw || `■ ${r.course || '공지'}\n시간: ${r.timeText || '전체'}\n금액: ${r.price || r.discount}만`;
                    }
                });

                // ★ [사용자 핵심 요구사항] 날짜/시간대가 다른 기존 공지는 지우지 않고 병합(보존)!
                // 동일 구장 + 동일 도메인(가격/식사) + 동일 날짜 + 겹치는 시간대 슬롯인 경우에만 최신 공지로 대체 갱신
                activeNoticeRules = activeNoticeRules.filter(existing => {
                    if (!existing || !existing.course) return false;
                    const hasConflict = currentParsedNoticeRules.some(incoming => isNoticeRuleSlotConflict(existing, incoming));
                    return !hasConflict;
                });
                activeNoticeRules.push(...currentParsedNoticeRules);

                // 해당 구장의 규칙 중 원문 전문이 비어있는 경우 보정
                distinctRegisteredCourses.forEach(cName => {
                    activeNoticeRules.forEach(ar => {
                        if (isCourseMatch(cName, ar.course) && !ar.fullNoticeText && raw) {
                            ar.fullNoticeText = raw;
                        }
                    });
                });

                saveActiveNoticeRules();
                const appliedCount = applyAllActiveNoticeRules();
                renderActiveNoticeChips();

                const courseTitle = distinctRegisteredCourses.length > 1
                    ? `${distinctRegisteredCourses[0]} 외 ${distinctRegisteredCourses.length - 1}개 구장`
                    : (distinctRegisteredCourses[0] || manualCourse || '공지');
                showToast(`[${courseTitle}] 총 ${currentParsedNoticeRules.length}개 타임 규칙이 일괄 적용되었습니다! (${appliedCount}건 반영)`);
                if (noticeInputText) noticeInputText.value = '';
                currentParsedNoticeRules = [];
                renderParsedNoticeRules();
                closeNoticeModal();
                try { syncNoticesWithCloud(false, true); } catch(e) {}
                return;
            }

            // 2. 파싱 목록은 비어있으나 하단 입력창에 구장과 금액이 직접 입력된 경우
            if (manualCourse && manualPrice) {
                addManualNoticeRule();
                if (currentParsedNoticeRules.length > 0) {
                    btnApplyNotice.click();
                    return;
                }
            }

            // 3. 원문 텍스트만 있고 파싱되지 않았던 경우 기존 텍스트 일괄 파서 호출
            if (raw) {
                if (!isNoticeRulesActive) {
                    setNoticeRulesActive(true, false);
                }
                applyNoticeFromText(raw);
                if (noticeInputText) noticeInputText.value = '';
                closeNoticeModal();
                try { syncNoticesWithCloud(false, true); } catch(e) {}
                return;
            }

            alert('공지 텍스트를 입력하거나 아래에서 시간/금액을 추가해주세요.');
        });
    }

    // 수동 공지 직접 추가 이벤트 바인딩
    const btnAddManualNoticeRule = document.getElementById('btnAddManualNoticeRule');
    if (btnAddManualNoticeRule) {
        btnAddManualNoticeRule.addEventListener('click', addManualNoticeRule);
    }
    const manualNoticeCourse = document.getElementById('manualNoticeCourse');
    const manualNoticeDate = document.getElementById('manualNoticeDate');
    const manualNoticeTime = document.getElementById('manualNoticeTime');
    const manualNoticePrice = document.getElementById('manualNoticePrice');
    const chkManualNoticePart1 = document.getElementById('chkManualNoticePart1');
    const chkManualNoticePart2 = document.getElementById('chkManualNoticePart2');
    const chkManualNoticePart3 = document.getElementById('chkManualNoticePart3');
    const btnToggleCourseDropdown = document.getElementById('btnToggleCourseDropdown');
    const noticeCourseDropdownMenu = document.getElementById('noticeCourseDropdownMenu');
    const btnAddNewCourseToCatalog = document.getElementById('btnAddNewCourseToCatalog');
    const inputNewNoticeCourseName = document.getElementById('inputNewNoticeCourseName');
    const selNewCourseRegion = document.getElementById('selNewCourseRegion');
    const noticeCourseDirectAddPrompt = document.getElementById('noticeCourseDirectAddPrompt');
    const btnQuickRegisterPrompt = document.getElementById('btnQuickRegisterPrompt');

    if (manualNoticeCourse) {
        manualNoticeCourse.addEventListener('focus', openNoticeCourseDropdown);
        manualNoticeCourse.addEventListener('click', openNoticeCourseDropdown);
        manualNoticeCourse.addEventListener('input', function() {
            markManualNoticeModified();
            openNoticeCourseDropdown();
            renderNoticeCourseDropdown(this.value.trim(), currentNoticeFilterRegion);
        });
        manualNoticeCourse.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeNoticeCourseDropdown();
            } else if (e.key === 'Enter') {
                e.preventDefault();
                closeNoticeCourseDropdown();
                manualNoticeDate ? manualNoticeDate.focus() : (manualNoticeTime ? manualNoticeTime.focus() : manualNoticePrice?.focus());
            }
        });
    }

    if (manualNoticeDate) {
        manualNoticeDate.addEventListener('input', (e) => {
            markManualNoticeModified();
            const newVal = e.target.value.trim();
            if (newVal && currentParsedNoticeRules && currentParsedNoticeRules.length > 0) {
                currentParsedNoticeRules.forEach(r => {
                    if (!r.date || r.date === '전체') {
                        r.date = newVal;
                    }
                });
                renderParsedNoticeRules();
            }
        });
        manualNoticeDate.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                manualNoticeTime ? manualNoticeTime.focus() : manualNoticePrice?.focus();
            }
        });
    }

    if (manualNoticeTime) {
        manualNoticeTime.addEventListener('input', function() {
            markManualNoticeModified();
            const timeVal = this.value.trim();
            if (timeVal) {
                const parsedT = parseTimeInputToMinutes(timeVal);
                if (!parsedT.isAll) {
                    const sM = parsedT.startMins;
                    const eM = parsedT.endMins;
                    const hasP1 = (sM < 660);
                    const hasP2 = (sM < 960 && eM >= 660);
                    const hasP3 = (eM >= 960);
                    if (chkManualNoticePart1) chkManualNoticePart1.checked = hasP1;
                    if (chkManualNoticePart2) chkManualNoticePart2.checked = hasP2;
                    if (chkManualNoticePart3) chkManualNoticePart3.checked = hasP3;
                }
            }
        });
        manualNoticeTime.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                manualNoticePrice?.focus();
            }
        });
    }

    if (manualNoticePrice) {
        manualNoticePrice.addEventListener('input', markManualNoticeModified);
        manualNoticePrice.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                addManualNoticeRule();
            }
        });
    }
    if (chkManualNoticePart1) chkManualNoticePart1.addEventListener('change', markManualNoticeModified);
    if (chkManualNoticePart2) chkManualNoticePart2.addEventListener('change', markManualNoticeModified);
    if (chkManualNoticePart3) chkManualNoticePart3.addEventListener('change', markManualNoticeModified);

