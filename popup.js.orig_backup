// 골프락 전용 지역 정규화 함수 (골프락은 인천/동부 없음 -> 경기남부로 통합 매핑)
function toGolfrockRegion(str) {
    if (!str || typeof str !== 'string') return '';
    const clean = str.replace(/[\[\]()]/g, '').trim();
    if (!clean) return '';
    if (clean.includes('북부')) return '경기북부';
    if (clean.includes('남부')) return '경기남부';
    if (clean.includes('인천') || clean.includes('경인')) return '경기남부';
    if (clean.includes('동부')) return '경기남부';
    if (clean.includes('충청') || clean.includes('충북') || clean.includes('충남') || clean.includes('대전') || clean.includes('세종')) return '충청도';
    if (clean.includes('강원')) return '강원도';
    if (clean.includes('전라') || clean.includes('전북') || clean.includes('전남') || clean.includes('광주')) return '전라도';
    if (clean.includes('경상') || clean.includes('경북') || clean.includes('경남') || clean.includes('대구') || clean.includes('부산') || clean.includes('울산')) return '경상도';
    if (clean.includes('경기')) return '경기남부';
    return clean;
}

// 9대 표준 지역 목록 (매핑사전 및 골프몬 등록 엄격 준수)
const VALID_STANDARD_REGIONS = [
    '경기남부',
    '경기북부',
    '충청',
    '전라',
    '경상',
    '인천경인',
    '경기동부',
    '강원',
    '제주'
];

/**
 * 임의의 지역 문자열을 9대 표준 지역 중 하나로 정규화
 * (경기안성, 경기용인, 경기여주 -> 경기남부 / 경기포천 -> 경기북부 / 강원도 -> 강원 등)
 */
function toStandardRegion(str) {
    if (!str || typeof str !== 'string') return '';
    const clean = str.replace(/[\[\]()]/g, '').trim();
    if (!clean) return '';

    // 1. 이미 9대 표준 지역인 경우 즉시 반환
    if (VALID_STANDARD_REGIONS.includes(clean)) return clean;

    // 2. '경기동부' 우선 검사 (동부 구장 분리)
    if (clean.includes('경기동부') || clean === '동부') return '경기동부';

    // 3. '인천경인'
    if (clean.includes('인천경인') || clean.includes('경인') || clean.includes('인천') || clean.includes('영종') || clean.includes('강화')) return '인천경인';

    // 4. '경기북부' 및 북부 지자체/지역명
    if (clean.includes('경기북부') || clean.includes('경기북') || clean === '북부' ||
        /경기.*(?:포천|파주|양주|동두천|가평|연천|구리|남양주|고양|일산)/.test(clean) ||
        /^(?:포천|파주|양주|동두천|가평|연천|구리|남양주|고양|일산)$/.test(clean)) {
        return '경기북부';
    }

    // 5. '경기남부' 및 남부 지자체/지역명 (경기안성, 경기용인, 경기여주, 경기이천, 경기화성, 안성, 용인, 여주, 이천 등)
    if (clean.includes('경기남부') || clean.includes('경기남') || clean === '남부' || clean === '경기' ||
        /경기.*(?:안성|용인|여주|이천|화성|평택|오산|수원|성남|광주|양평|과천|의왕|군포|안산|안양)/.test(clean) ||
        /^(?:안성|용인|여주|이천|화성|평택|오산|수원|성남|양평|과천|의왕|군포|안산|안양)$/.test(clean)) {
        return '경기남부';
    }

    // 6. '충청' (충남, 충북, 대전, 세종, 진천, 음성, 천안, 아산, 충주, 청주 등)
    if (/충청|충남|충북|대전|세종/.test(clean) ||
        /^(?:진천|음성|감곡|화랑|천안|아산|당진|서산|태안|보령|공주|논산|청주|충주|제천|단양|괴산)$/.test(clean)) {
        return '충청';
    }

    // 7. '강원' (강원도, 춘천, 원주, 강릉, 홍천, 횡성, 평창, 철원 등)
    if (/강원/.test(clean) ||
        /^(?:춘천|원주|강릉|홍천|횡성|평창|속초|삼척|태백|정선|고성|양양|철원|화천|양구|인제)$/.test(clean)) {
        return '강원';
    }

    // 8. '전라' (전남, 전북, 광주광역시, 순천, 여수, 익산, 전주, 군산, 목포, 나주 등)
    if (/전라|전남|전북/.test(clean) ||
        /^(?:순천|여수|목포|나주|익산|군산|전주|담양|화순|무안|영암|해남|광양|정읍|남원)$/.test(clean)) {
        return '전라';
    }

    // 9. '경상' (경남, 경북, 부산, 대구, 울산, 창원, 포항, 구미, 경주, 김천, 안동 등)
    if (/경상|경남|경북|부산|대구|울산/.test(clean) ||
        /^(?:창원|포항|구미|경주|김천|안동|진주|김해|양산|밀양|거제|통영|영천|상주|문경|경산)$/.test(clean)) {
        return '경상';
    }

    // 10. '제주' (제주도, 서귀포)
    if (/제주|서귀포/.test(clean)) {
        return '제주';
    }

    return '';
}

// 사이트별(골프몬, 골팡, 골마켓, 골프락, 골프랜드, 골프탑) 매핑 객체 표준화 함수
function normalizeDictEntry(entry, key = '') {
    if (!entry) {
        const grk = GOLFROCK_OFFICIAL_NAMES[key] || key;
        const grkReg = GOLFROCK_REGIONS[key] || GOLFROCK_REGIONS[grk] || '';
        return {
            region: '',
            golfrockRegion: grkReg,
            golfmon: key,
            golfpang: key,
            golmarket: getGolmarketGolfName(key) || key,
            golfrock: grk,
            golfland: key,
            golftop: key,
            name: key
        };
    }
    if (typeof entry === 'string') {
        const gm = getGolmarketGolfName(entry) || getGolmarketGolfName(key) || entry;
        const grk = GOLFROCK_OFFICIAL_NAMES[entry] || GOLFROCK_OFFICIAL_NAMES[key] || entry;
        const grkReg = GOLFROCK_REGIONS[entry] || GOLFROCK_REGIONS[key] || GOLFROCK_REGIONS[grk] || '';
        return {
            region: '',
            golfrockRegion: grkReg,
            golfmon: entry,
            golfpang: entry,
            golmarket: gm,
            golfrock: grk,
            golfland: entry,
            golftop: entry,
            name: entry
        };
    }
    const baseName = entry.name || entry.golfmon || key;
    const golfmon = entry.golfmon || baseName;
    const golfpang = entry.golfpang || baseName;
    const golmarket = entry.golmarket || getGolmarketGolfName(key) || getGolmarketGolfName(baseName) || baseName;
    const golfrock = entry.golfrock || GOLFROCK_OFFICIAL_NAMES[key] || GOLFROCK_OFFICIAL_NAMES[baseName] || baseName;
    const golfland = entry.golfland || baseName;
    const golftop = entry.golftop || baseName;
    const rawReg = entry.region || '';
    const stdRegion = toStandardRegion(rawReg) || rawReg;
    const golfrockRegion = entry.golfrockRegion || GOLFROCK_REGIONS[key] || GOLFROCK_REGIONS[baseName] || GOLFROCK_REGIONS[golfrock] || (stdRegion ? toGolfrockRegion(stdRegion) : '');
    return {
        region: stdRegion,
        golfrockRegion: golfrockRegion,
        golfmon: golfmon,
        golfpang: golfpang,
        golmarket: golmarket,
        golfrock: golfrock,
        golfland: golfland,
        golftop: golftop,
        name: baseName
    };
}

// 통합 영구 저장 함수: localStorage 와 chrome.storage.local 동시 실시간 저장
let dictionary = {};

function saveDictionary() {
    try {
        localStorage.setItem('v2_golfDict', JSON.stringify(dictionary));
    } catch(e) {}
    try {
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.set({ v2_golfDict: dictionary });
        }
    } catch(e) {}
}


// 사용자 커스텀 사전이 '그대로' 보존되도록 로드 및 사이트별 필드 정규화
function initDictionary() {
    let saved = null;
    try {
        const str = localStorage.getItem('v2_golfDict');
        if (str) saved = JSON.parse(str);
    } catch(e) {}

    if (saved && typeof saved === 'object' && Object.keys(saved).length > 0) {
        dictionary = {};
        for (const [k, v] of Object.entries(saved)) {
            dictionary[k] = normalizeDictEntry(v, k);
            // 기본 사전에 원래 있던 구장인 경우, 사용자의 요청대로 다른 필드(region, 타 사이트명 등)는 원래 기본값으로 복원
            if (defaultDict[k]) {
                dictionary[k].region = defaultDict[k].region || dictionary[k].region;
                dictionary[k].golfmon = defaultDict[k].golfmon || dictionary[k].golfmon;
                dictionary[k].golfpang = defaultDict[k].golfpang || dictionary[k].golfpang;
                dictionary[k].golmarket = defaultDict[k].golmarket || dictionary[k].golmarket;
                dictionary[k].golfland = defaultDict[k].golfland || dictionary[k].golfland;
                dictionary[k].golftop = defaultDict[k].golftop || dictionary[k].golftop;
                dictionary[k].name = defaultDict[k].name || dictionary[k].name;
            }
        }
        // 기본 사전(defaultDict)에 새로 추가된 구장들도 dictionary에 자동으로 머지
        for (const [k, v] of Object.entries(defaultDict)) {
            if (!dictionary[k]) {
                dictionary[k] = normalizeDictEntry(v, k);
            }
        }
    } else {
        // 저장된 사전이 없을 때만 기본값으로 최초 초기화
        dictionary = {};
        for (const [k, v] of Object.entries(defaultDict)) {
            dictionary[k] = normalizeDictEntry(v, k);
        }
    }

    // Golfrock 144개 골프장 변환명 및 지역만 골프락 사전에 반영 (타 필드는 절대 변경 금지)
    for (const [k, rockName] of Object.entries(GOLFROCK_OFFICIAL_NAMES)) {
        const rockRegion = GOLFROCK_REGIONS[k] || GOLFROCK_REGIONS[rockName] || '';
        if (!dictionary[k]) {
            dictionary[k] = {
                region: (defaultDict[k] && defaultDict[k].region) ? defaultDict[k].region : '',
                golfrockRegion: rockRegion,
                golfmon: (defaultDict[k] && defaultDict[k].golfmon) ? defaultDict[k].golfmon : k,
                golfpang: (defaultDict[k] && defaultDict[k].golfpang) ? defaultDict[k].golfpang : k,
                golmarket: (defaultDict[k] && defaultDict[k].golmarket) ? defaultDict[k].golmarket : (getGolmarketGolfName(k) || k),
                golfrock: rockName,
                golfland: (defaultDict[k] && defaultDict[k].golfland) ? defaultDict[k].golfland : k,
                golftop: (defaultDict[k] && defaultDict[k].golftop) ? defaultDict[k].golftop : k,
                name: (defaultDict[k] && defaultDict[k].name) ? defaultDict[k].name : k
            };
        } else {
            dictionary[k].golfrock = rockName;
            if (rockRegion) {
                dictionary[k].golfrockRegion = rockRegion;
            }
            if (defaultDict[k] && defaultDict[k].region) {
                dictionary[k].region = defaultDict[k].region;
            }
        }
    }

    // ★ [클럽72 공식 명칭 및 매핑 보장]
    // 클럽72, 클럽72(레이크/클래식), 레/클 등은 골프몬 공식명 '클럽72(레이크/클래식)'으로 정확히 매핑 (오션으로 오변환 원천 차단)
    const club72LakeClassicEntry = {
        golfmon: '클럽72(레이크/클래식)',
        golfpang: '클럽72(레이크/클래식)',
        golfrock: '클럽72',
        golmarket: '클럽72(클래식/레이크)',
        golfland: '클럽72',
        golftop: '클럽72',
        name: '클럽72(레이크/클래식)',
        region: '인천경인'
    };
    const club72OceanEntry = {
        golfmon: '클럽72(오션)',
        golfpang: '클럽72(오션)',
        golfrock: '클럽72(오션)',
        golmarket: '클럽72(오션)',
        golfland: '클럽72(오션)',
        golftop: '클럽72(오션)',
        name: '클럽72(오션)',
        region: '인천경인'
    };
    const club72HaneulEntry = {
        golfmon: '클럽72(하늘)',
        golfpang: '클럽72(하늘)',
        golfrock: '클럽72(하늘)',
        golmarket: '클럽72(하늘)',
        golfland: '클럽72(하늘)',
        golftop: '클럽72(하늘)',
        name: '클럽72(하늘)',
        region: '인천경인'
    };

function applySpecialCourseMappings(dict) {
    if (!dict || typeof dict !== 'object') return;

    // 1. 클럽72
    const club72LakeClassicEntry = {
        golfmon: '클럽72(레이크/클래식)', golfpang: '클럽72', golfrock: '클럽72',
        golmarket: '클럽72(클래식/레이크)', golfland: '클럽72', golftop: '클럽72',
        name: '클럽72(레이크/클래식)', region: '인천경인'
    };
    const club72OceanEntry = {
        golfmon: '클럽72(오션)', golfpang: '클럽72(오션)', golfrock: '클럽72(오션)',
        golmarket: '클럽72(오션)', golfland: '클럽72(오션)', golftop: '클럽72(오션)',
        name: '클럽72(오션)', region: '인천경인'
    };
    const club72HaneulEntry = {
        golfmon: '클럽72(하늘)', golfpang: '클럽72(하늘)', golfrock: '클럽72(하늘)',
        golmarket: '클럽72(하늘)', golfland: '클럽72(하늘)', golftop: '클럽72(하늘)',
        name: '클럽72(하늘)', region: '인천경인'
    };
    for (const k of ['클럽72', '클럽72(레이크/클래식)', '클럽72(클래식/레이크)', '클럽72(레이크)', '클럽72(클래식)', '레/클', '레이크/클래식']) {
        dict[k] = Object.assign({}, dict[k] || {}, club72LakeClassicEntry);
    }
    dict['클럽72(오션)'] = Object.assign({}, dict['클럽72(오션)'] || {}, club72OceanEntry);
    dict['클럽72(하늘)'] = Object.assign({}, dict['클럽72(하늘)'] || {}, club72HaneulEntry);

    // 2. 남양주
    const namyangjuEntry = {
        golfmon: '남양주cc(P9)', golfpang: '남양주cc(P9)', golfrock: '남양주(9홀)',
        golmarket: '남양주(9홀)', golfland: '남양주cc(P9)', golftop: '남양주cc(P9)',
        name: '남양주cc(P9)', region: '경기북부'
    };
    for (const k of ['남양주', '남양주cc', '남양주cc(9홀x2)', '남양주cc (9홀x2)', '남양주(9홀x2)', '남양주 (9홀x2)', '남양주(9홀)', '남양주(p9)', '남양주cc(p9)', '남양주cc(P9)']) {
        dict[k] = Object.assign({}, dict[k] || {}, namyangjuEntry);
    }

    // 3. 보령베이스
    const boryeongEntry = {
        golfmon: '보령베이스cc (P9)', golfpang: '보령베이스cc (P9)', golfrock: '보령베이스(9홀)',
        golmarket: '보령베이스(9홀)', golfland: '보령베이스cc (P9)', golftop: '보령베이스cc (P9)',
        name: '보령베이스cc (P9)', region: '충청'
    };
    for (const k of ['보령베이스', '보령베이스cc', '보령베이스 (9홀x2)', '보령베이스(9홀x2)', '보령(9홀x2)', '보령 (9홀x2)', '보령베이스(9홀)', '보령베이스(p9)', '보령베이스cc (P9)', '보령베이스cc(P9)', '보령']) {
