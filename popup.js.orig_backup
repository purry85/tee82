    const btnSkipUnmapped = document.getElementById('btnSkipUnmapped');
    const btnCloseUnmappedModal = document.getElementById('btnCloseUnmappedModal');

    if (btnSaveUnmapped) {
        btnSaveUnmapped.addEventListener('click', () => {
            const rows = document.querySelectorAll('#unmappedListContainer .unmapped-item-row');
            let savedCount = 0;
            rows.forEach(row => {
                const raw = row.dataset.raw;
                if (!raw) return;
                const regInp = row.querySelector('.unmapped-reg-input');
                const gmInp = row.querySelector('.unmapped-gm-input');
                const gpInp = row.querySelector('.unmapped-gp-input');
                const gmkInp = row.querySelector('.unmapped-gmk-input');
                const grkInp = row.querySelector('.unmapped-grk-input');
                const gldInp = row.querySelector('.unmapped-gld-input');

                const rawReg = regInp ? regInp.value.trim() : '';
                const regVal = toStandardRegion(rawReg) || rawReg;
                const gmVal = (gmInp && gmInp.value.trim()) ? gmInp.value.trim() : raw;
                const gpVal = (gpInp && gpInp.value.trim()) ? gpInp.value.trim() : raw;
                const gmkVal = (gmkInp && gmkInp.value.trim()) ? gmkInp.value.trim() : (getGolmarketGolfName(raw) || raw);
                const grkVal = (grkInp && grkInp.value.trim()) ? grkInp.value.trim() : raw;
                const gldVal = (gldInp && gldInp.value.trim()) ? gldInp.value.trim() : raw;

                dictionary[raw] = {
                    region: regVal,
                    golfmon: gmVal,
                    golfpang: gpVal,
                    golmarket: gmkVal,
                    golfrock: grkVal,
                    golfland: gldVal,
                    name: gmVal
                };
                savedCount++;
            });

            if (savedCount > 0) {
                saveDictionary();
                updateDictStats();
                showToast(`${savedCount}개 구장이 매핑사전에 등록되었습니다.`);
            }
            closeUnmappedModal(true);
        });
    }

