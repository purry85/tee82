function showOcrLoading(statusText = 'AI / OCR 엔진이 티타임 표와 텍스트를 판독하고 있습니다...') {
    const modal = document.getElementById('ocrLoadingModal');
    const statusEl = document.getElementById('ocrLoadingStatus');
    if (statusEl) statusEl.textContent = statusText;
    if (modal) modal.style.display = 'flex';
}

function hideOcrLoading() {
    const modal = document.getElementById('ocrLoadingModal');
    if (modal) modal.style.display = 'none';
}

function playSuccessChime() {
    try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const freqs = [523.25, 659.25, 783.99, 1046.50]; // C - E - G - High C
        let now = ctx.currentTime;
        freqs.forEach((f) => {
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(f, now);
            gain.gain.setValueAtTime(0.15, now);
            gain.gain.exponentialRampToValueAtTime(0.01, now + 0.14);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(now);
            osc.stop(now + 0.16);
            now += 0.08;
        });
    } catch(e) {}
}

async function resizeImageForOcr(file, maxDimension = 1200) {
    return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = (e) => {
            const img = new Image();
            img.onload = () => {
                let w = img.width;
                let h = img.height;
                if (w > maxDimension || h > maxDimension) {
                    if (w > h) {
                        h = Math.round((h * maxDimension) / w);
                        w = maxDimension;
                    } else {
                        w = Math.round((w * maxDimension) / h);
                        h = maxDimension;
                    }
                }
                const canvas = document.createElement('canvas');
                canvas.width = w;
                canvas.height = h;
                const ctx = canvas.getContext('2d');
                ctx.fillStyle = '#FFFFFF';
                ctx.fillRect(0, 0, w, h);
                ctx.drawImage(img, 0, 0, w, h);
                // 네트워크 전송 속도 극대화 및 고선명 텍스트 유지를 위해 최적화된 JPEG 포맷 사용 (용량 95% 절감)
                const dataUrl = canvas.toDataURL('image/jpeg', 0.88);
                resolve({ dataUrl, base64: dataUrl.split(',')[1], mimeType: 'image/jpeg' });
            };
            img.onerror = reject;
            img.src = e.target.result;
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
    });
}

const DEFAULT_GEMINI_API_KEY = (typeof atob === 'function')
    ? atob('QVEuQWI4Uk42SWlwanlVeWpkaGhHOXdQNUxCSnIwaVIxclNibkJHLVRsNEwyWno4SXJ5eVE=')
    : '';

// Google AI Studio 공식 cURL 규격 직결 호출 헬퍼 (X-goog-api-key 헤더 단독 전송)
async function sendGeminiPost(baseUrl, payload, apiKey) {
    const cleanKey = (apiKey || DEFAULT_GEMINI_API_KEY || '').trim();
    
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), 15000); // 15초 초과 방지

    try {
        const resp = await fetch(baseUrl, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-goog-api-key': cleanKey
            },
            body: JSON.stringify(payload),
            signal: controller.signal
        });
        clearTimeout(timer);

        if (resp.ok) return await resp.json();

        const errTxt = await resp.text();
        let errMsg = `구글 HTTP ${resp.status}`;
        try {
            const ej = JSON.parse(errTxt);
            if (ej.error && ej.error.message) errMsg = `[구글 ${resp.status}] ${ej.error.message}`;
        } catch(e) { errMsg = `[구글 ${resp.status}] ${errTxt.slice(0, 120)}`; }

        throw new Error(errMsg);
    } catch(err) {
        clearTimeout(timer);
        if (err.name === 'AbortError') {
            throw new Error('구글 AI 서버 응답 시간 초과 (15초)');
        }
        throw err;
    }
}

async function requestGeminiOcr(apiKey, base64Data, mimeType = 'image/jpeg') {
    const keyToUse = (apiKey || DEFAULT_GEMINI_API_KEY || '').trim();
    if (!keyToUse) throw new Error('API 키가 없습니다.');

    const payload = {
        contents: [{
            parts: [
                {
                    text: "이 골프장 요금표 이미지에서 구장명과 요금표를 판독해줘.\n" +
                          "★ 필수 요구사항: 표에 [주중]과 [주말](또는 특정 날짜) 구분이 나뉘어 있다면, 반드시 '주중'과 '주말'을 각각 단독 줄 헤더로 명시하고 그 아래에 해당 시간대와 금액을 출력해줘.\n" +
                          "카포와 일반 그린피가 나란히 있다면 기본 그린피 금액을 우선 추출하고, 각 시간대와 금액을 '시간대 금액' 형식으로 줄바꿈 출력해줘.\n" +
                          "출력 예시:\n" +
                          "구장명\n" +
                          "주중\n" +
                          "6시대 90,000\n" +
                          "7시대 100,000\n" +
                          "8시대 110,000\n" +
                          "11:50~13:29 120,000\n" +
                          "13:30~ 110,000\n" +
                          "3부 80,000\n\n" +
                          "주말\n" +
                          "6시대 100,000\n" +
                          "7시대 110,000\n" +
                          "8시대 120,000\n" +
                          "11:50~13:29 140,000\n" +
                          "13:30~ 140,000\n" +
                          "3부 100,000\n" +
                          "마크다운 기호(###, **)나 설명 없이 오직 위 형식의 텍스트만 출력해줘."
                },
                {
                    inlineData: {
                        mimeType: mimeType || "image/jpeg",
                        data: base64Data
                    }
                }
            ]
        }]
    };

    // 구글 AI 서버가 직접 지정 안내한 공식 표/문서 파싱 모델 (3.5 Flash-Lite 최우선)
    const models = [
        'gemini-3.5-flash-lite',
        'gemini-3.8-flash',
        'gemini-2.5-flash'
    ];

    let lastError = null;
    for (const m of models) {
        try {
            showOcrLoading(`🤖 Google Gemini [${m}] AI 분석 중...`);
            const url = `https://generativelanguage.googleapis.com/v1beta/models/${m}:generateContent`;
            const data = await sendGeminiPost(url, payload, keyToUse);
            const candidateParts = data.candidates?.[0]?.content?.parts || [];
            // thought(사고 과정) 블록 제외하고 최종 텍스트만 결합
            const textParts = candidateParts.filter(p => !p.thought && p.type !== 'thought');
            const candidateText = (textParts.length > 0 ? textParts : candidateParts)
                .map(p => p.text || '')
                .filter(Boolean)
                .join('\n');
            if (candidateText && candidateText.trim()) {
                showToast(`🤖 Google Gemini (${m}) 분석 완료!`, 2000);
                return candidateText.trim();
            }
        } catch(e) {
            lastError = e;
            console.warn(`[Gemini ${m}] 실패:`, e.message);
            // 오류 발생 시 즉시 다음 안정 모델로 페일오버
            continue;
        }
    }

    throw lastError || new Error('구글 Gemini AI 분석 실패');
}

async function requestOcrSpace(dataUrl, apiKey = 'K87420617888957') {
    const formData = new FormData();
    formData.append('base64Image', dataUrl);
    formData.append('base64image', dataUrl);
    formData.append('filetype', 'PNG');
    formData.append('language', 'kor');
    formData.append('isOverlayRequired', 'false');
    formData.append('OCREngine', '1'); // 한글(kor)은 OCREngine 1 필수 (2는 영문/라틴 전용)
    formData.append('isTable', 'true');
    formData.append('scale', 'true');
    formData.append('detectOrientation', 'true');
    formData.append('apikey', apiKey || 'K87420617888957');

    const resp = await fetch('https://api.ocr.space/parse/image', {
        method: 'POST',
        body: formData
    });
    if (!resp.ok) throw new Error(`OCR Space API Error: ${resp.status}`);
    const data = await resp.json();
    if (data.IsErroredOnProcessing) {
        const errMsg = Array.isArray(data.ErrorMessage) ? data.ErrorMessage.join(', ') : (data.ErrorMessage || 'OCR 처리 오류');
        throw new Error(errMsg);
    }
    const text = data.ParsedResults?.[0]?.ParsedText || '';
    return text.trim();
}

function cleanOcrExtractedText(text) {
    if (!text) return '';
    let t = text.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
    t = t.split('\n').map(line => line.trim()).filter(Boolean).join('\n');
    t = t.replace(/\bO(\d):/g, '0$1:')
         .replace(/(\d)\s*만\s*원/g, '$1만원')
         .replace(/(\d)\s*만\s*\[/g, '$1만[');
    return t;
}

// OCR 판독 텍스트 내에서 매핑사전 또는 공통 구장명 자동 감지
function detectGolfCourseInText(text) {
    if (!text) return '';
    const clean = text.replace(/[\s\-_\[\]\(\)]/g, '').toLowerCase();

    // 1. 매핑사전(dictionary) 내의 등록 구장명 전수 대조 (긴 명칭 우선)
    if (typeof dictionary !== 'undefined' && dictionary) {
        const sortedKeys = Object.keys(dictionary).sort((a, b) => b.length - a.length);
        for (const key of sortedKeys) {
            const normKey = key.replace(/[\s\-_\[\]\(\)]/g, '').toLowerCase();
            if (normKey.length >= 2 && clean.includes(normKey)) {
                return dictionary[key].name || key;
            }
        }
    }

    // 2. 자주 사용되는 주요 구장명 대조
    const commonCourses = [
        '양평TPC', '비에이비스타(P)', '비에이비스타', '보령베이스cc', '보령베이스', '속리산CC', '속리산',
        '올데이cc', '올데이', '로얄포레cc', '로얄포레', '옥스필드cc', '옥스필드', '플라밍고cc', '플라밍고',
        '임페리얼레이크cc', '임페리얼', '엠스클럽의성', '엠스클럽', '대영힐스cc', '대영힐스', '일렌시아',
        '남양주cc', '남양주', '클럽72', '루트52', '스마트KU', '안성Q', '캐슬파인', '신안'
    ];
    for (const c of commonCourses) {
        const norm = c.replace(/[\s\-_\[\]\(\)]/g, '').toLowerCase();
        if (clean.includes(norm)) {
            return c;
        }
    }
    return '';
}

// OCR 판독 텍스트 내 날짜(MM.DD, MM/DD 또는 주중/주말) 자동 감지
function detectDateInText(text) {
    if (!text) return '';
    if (/(?:^|[^\w가-힣])(?:주중|평일|월\s*[-~]\s*금)(?:$|[^\w가-힣])/i.test(text)) {
        return '주중';
    }
    if (/(?:^|[^\w가-힣])(?:주말|토\s*[-~,/]\s*일|휴일|공휴일)(?:$|[^\w가-힣])/i.test(text)) {
        return '주말';
    }
    const mYear = text.match(/202\d[./-](\d{1,2})[./-](\d{1,2})/);
    if (mYear) {
        return `${parseInt(mYear[1], 10)}.${parseInt(mYear[2], 10)}`;
    }
    const mDate = text.match(/(\d{1,2})[./\-](\d{1,2})(?:\([월화수목금토일]\))?/);
    if (mDate) {
        const m = parseInt(mDate[1], 10);
        const d = parseInt(mDate[2], 10);
        if (m >= 1 && m <= 12 && d >= 1 && d <= 31) {
            return `${m}.${d}`;
        }
    }
    return '';
}

// OCR 판독 텍스트에서 시간, 금액, 비고 행 목록 추출
// OCR 판독 텍스트에서 [주중], [주말] 및 특정 날짜별 섹션 자동 분리
function extractNoticeSectionsFromOcrText(text) {
    if (!text) return [];
    const lines = text.split('\n').map(l => l.trim()).filter(Boolean);
    const timeRegex = /(\d{1,2}:\d{2}(?:\s*~\s*\d{1,2}:\d{2})?|\d{1,2}\s*시(?:대|대별|타임|\s*대)?(?:\s*~\s*\d{1,2}\s*시(?:대)?)?|\d{1,2}:\d{2}\s*~|[123]부|\b\d{4}\b)/i;

    let currentSectionDate = '';
    const sections = [];
    let currentItems = [];

    function flushCurrentSection() {
        if (currentItems.length > 0) {
            sections.push({
                date: currentSectionDate || '주중',
                items: currentItems
            });
            currentItems = [];
        }
    }

    for (let i = 0; i < lines.length; i++) {
        let line = lines[i];

        // 1. 헤더 감지: 주중 / 평일 / 월~금
        if (/^(?:[-*•▶▷□■▣★☆◆◇▲▼\s])*([(\[<【]?(?:주중|평일|월\s*[-~]\s*금)[)\]>】]?)(?:[가-힣\s]*)$/i.test(line) && !line.includes(':') && !/\d{1,2}\s*시대/.test(line)) {
            flushCurrentSection();
            currentSectionDate = '주중';
            continue;
        }

        // 2. 헤더 감지: 주말 / 휴일 / 토~일 / 공휴일
        if (/^(?:[-*•▶▷□■▣★☆◆◇▲▼\s])*([(\[<【]?(?:주말|휴일|토\s*[-~,/]\s*일|공휴일)[)\]>】]?)(?:[가-힣\s]*)$/i.test(line) && !line.includes(':') && !/\d{1,2}\s*시대/.test(line)) {
            flushCurrentSection();
            currentSectionDate = '주말';
            continue;
        }

        // 3. 헤더 감지: 특정 날짜 (예: "11.4", "11/5(수)", "10월 28일", "♣오늘♣ 11/11(수) 3부 재공지")
        const dDetail = (typeof parseNoticeDateDetail === 'function') ? parseNoticeDateDetail(line) : null;
        const dateMatch = line.match(/^[-*•▶▷□■▣★☆◆◇▲▼\s]*([(\[<【]?\d{1,2}\s*[./월\-]\s*\d{1,2}(?:\s*\([가-힣]\))?[)\]>】]?)(?:[가-힣\s]*)$/);
        if ((dDetail || dateMatch) && !line.includes(':') && !/\d{1,2}\s*시대/.test(line)) {
            flushCurrentSection();
            currentSectionDate = dDetail ? dDetail.dateStr : (dateMatch ? dateMatch[1].replace(/[\[\]\(\)<>【】]/g, '').trim() : '');
            continue;
        }

        // 비-골프 라인이나 표 헤더(구분, 카포 등) 스킵
        if (/^(?:구분|카포|그린피|시간대?)\b/i.test(line) && !/\d{3,}/.test(line)) continue;
        if (typeof isNonGolfLine === 'function' && isNonGolfLine(line)) continue;

        // 시간대 매칭
        const tMatch = line.match(timeRegex);
        if (!tMatch) continue;
        const timePart = tMatch[1].trim();
        const afterTime = line.substring(line.indexOf(timePart) + timePart.length).trim();

        // 금액 추출 (첫 번째 금액을 기본 그린피 요금으로 추출)
        const feeMatch = afterTime.match(/([0-9]{1,3}(?:,[0-9]{3})+|[0-9]+(?:\.[0-9]+)?)\s*(?:만|만원|원)?/);
        let feeVal = '';
        if (feeMatch) {
            let rawNum = feeMatch[1].replace(/,/g, '');
            let n = parseFloat(rawNum);
            if (!isNaN(n)) {
                if (n >= 1000) n = Math.round((n / 10000) * 10) / 10;
                feeVal = n + '만';
            }
        }

        if (timePart) {
            if (!currentSectionDate) {
                currentSectionDate = detectDateInText(text) || '주중';
            }
            currentItems.push({
                time: timePart,
                fee: feeVal
            });
        }
    }

    flushCurrentSection();

    // 만약 섹션이 전혀 안 생겼는데 items가 있다면 텍스트 분석 기반 단일 섹션 구성
    if (sections.length === 0 && currentItems.length > 0) {
        sections.push({
            date: detectDateInText(text) || '주중',
            items: currentItems
        });
    }

    return sections;
}

// 하위 호환용: 평면 items 배열 반환
function extractTimeFeeItemsFromOcrText(text) {
    const sections = extractNoticeSectionsFromOcrText(text);
    const flat = [];
    sections.forEach(s => flat.push(...s.items));
    return flat;
}

// OCR 판독 검토 모달 섹션별 렌더링 (주중/주말 구역별 카드 시각화)
function renderOcrReviewSections(sections = []) {
    const container = document.getElementById('ocrRowsContainer');
    const countEl = document.getElementById('ocrItemsCount');
    if (!container) return;
    container.innerHTML = '';

    const list = (sections && sections.length > 0) ? sections : [
        { date: '주중', items: [{ time: '', fee: '' }, { time: '', fee: '' }] }
    ];

    let totalCount = 0;

    list.forEach(sec => {
        const isWeekend = /주말|휴일|토|일/.test(sec.date);
        const cardBg = isWeekend ? '#FEF2F2' : '#EFF6FF';
        const cardBorder = isWeekend ? '#FECACA' : '#BFDBFE';
        const titleColor = isWeekend ? '#DC2626' : '#1D4ED8';
        const badgeText = isWeekend ? '주말(토-일)' : (/주중|평일/.test(sec.date) ? '주중(월-금)' : sec.date);

        const card = document.createElement('div');
        card.className = 'ocr-section-card';
        card.style.cssText = `background: ${cardBg}; border: 1px solid ${cardBorder}; border-radius: 6px; padding: 7px 8px; margin-bottom: 8px;`;

        // 카드 상단 헤더
        const headerDiv = document.createElement('div');
        headerDiv.style.cssText = `display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; padding-bottom: 4px; border-bottom: 1px dashed ${cardBorder};`;
        headerDiv.innerHTML = `
            <div style="display: flex; align-items: center; gap: 6px;">
                <span style="font-size: 11px; font-weight: 700; color: ${titleColor};">📅 적용 구분:</span>
                <input type="text" class="ocr-section-date" value="${sec.date || ''}" placeholder="예: 주중 또는 주말" style="width: 75px; height: 23px; font-size: 11px; font-weight: 700; color: ${titleColor}; background: #FFF; border: 1px solid ${cardBorder}; border-radius: 4px; padding: 0 5px; box-sizing: border-box;">
                <span style="font-size: 10px; color: #64748B; font-weight: 600;">(${badgeText})</span>
            </div>
            <div style="display: flex; gap: 4px; align-items: center;">
                <button type="button" class="btn-ocr-add-sec-row" style="font-size: 10px; font-weight: 600; padding: 2px 7px; background: #FFF; color: ${titleColor}; border: 1px solid ${cardBorder}; border-radius: 3px; cursor: pointer;">+ 행 추가</button>
                ${list.length > 1 ? '<button type="button" class="btn-ocr-del-sec" title="이 구역 전체 삭제" style="font-size: 11px; padding: 1px 5px; background: #FEE2E2; color: #DC2626; border: 1px solid #FECACA; border-radius: 3px; cursor: pointer; font-weight: bold;">✕</button>' : ''}
            </div>
        `;
        card.appendChild(headerDiv);

        // 카드 내부 행 컨테이너
        const rowsWrap = document.createElement('div');
        rowsWrap.className = 'ocr-section-rows';

        const items = (sec.items && sec.items.length > 0) ? sec.items : [{ time: '', fee: '' }];
        items.forEach(it => {
            totalCount++;
            const row = document.createElement('div');
            row.className = 'ocr-item-row';
            row.style.cssText = 'display: flex; gap: 5px; align-items: center; margin-bottom: 4px;';
            row.innerHTML = `
                <input type="text" class="ocr-item-time" value="${it.time || ''}" placeholder="시간 (예: 6시대, 11:50~13:29)" style="flex: 1.5; height: 24px; font-size: 11px; border: 1px solid #CBD5E1; border-radius: 4px; padding: 0 5px; background: #FFF; box-sizing: border-box;">
                <input type="text" class="ocr-item-fee" value="${it.fee || ''}" placeholder="금액 (예: 9만, 10만)" style="flex: 1.2; height: 24px; font-size: 11px; border: 1px solid #CBD5E1; border-radius: 4px; padding: 0 5px; background: #FFF; box-sizing: border-box;">
                <button type="button" class="btn-ocr-del-row" title="행 삭제" style="width: 22px; height: 24px; background: #FFF; color: #DC2626; border: 1px solid #FECACA; border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: bold; line-height: 1;">&times;</button>
            `;
            rowsWrap.appendChild(row);
        });

        card.appendChild(rowsWrap);
        container.appendChild(card);
    });

    if (countEl) countEl.innerText = totalCount;
}

// OCR 판독 검토 및 공지 요금표 등록 모달 열기
function openOcrReviewModal(ocrData = {}) {
    const modal = document.getElementById('ocrReviewModal');
    if (!modal) return;

    // 1. 구장명 자동완성 datalist 채우기
    const datalist = document.getElementById('ocrCourseDatalist');
    if (datalist && typeof dictionary !== 'undefined') {
        datalist.innerHTML = Object.keys(dictionary)
            .map(k => `<option value="${k}"></option>`)
            .join('');
    }

    // 2. 감지된 골프장명 설정
    const inpCourse = document.getElementById('ocrInputCourse');
    if (inpCourse) {
        inpCourse.value = ocrData.course || '';
    }

    // 3. 섹션 목록 파싱 및 구성
    let sections = ocrData.sections;
    if (!sections || sections.length === 0) {
        sections = extractNoticeSectionsFromOcrText(ocrData.rawText || '');
    }
    if (!sections || sections.length === 0) {
        const items = ocrData.items || [];
        sections = [{ date: ocrData.date || '주중', items: items }];
    }

    // 4. 감지된 날짜 요약 설정
    const inpDate = document.getElementById('ocrInputDate');
    if (inpDate) {
        if (sections.length === 1) {
            inpDate.value = sections[0].date;
        } else {
            inpDate.value = sections.map(s => s.date).join(', ');
        }
    }

    // 5. 원본 텍스트 설정
    const rawEl = document.getElementById('ocrRawText');
    if (rawEl) {
        rawEl.value = ocrData.rawText || '';
    }

    // 6. 구역별 섹션 렌더링
    renderOcrReviewSections(sections);

    // 7. 공지 요금표 등록 버튼 활성화
    const btnNotice = document.getElementById('btnOcrApplyNotice');
    if (btnNotice) {
        btnNotice.style.display = 'inline-block';
    }

    modal.style.display = 'flex';

    setTimeout(() => {
        if (inpCourse && !inpCourse.value) {
            inpCourse.focus();
        } else if (inpDate && !inpDate.value) {
            inpDate.focus();
        }
    }, 100);
}

function closeOcrReviewModal() {
    const modal = document.getElementById('ocrReviewModal');
    if (modal) modal.style.display = 'none';
}

function initOcrReviewHandlers() {
    document.getElementById('btnCloseOcrReviewModalX')?.addEventListener('click', closeOcrReviewModal);
    document.getElementById('btnCancelOcrReview')?.addEventListener('click', closeOcrReviewModal);

    // 날짜 빠른 선택 버튼: 첫 번째 섹션 또는 상단 날짜 필드 변경
    document.getElementById('btnOcrQuickToday')?.addEventListener('click', () => {
        const now = new Date();
        const dStr = `${now.getMonth() + 1}.${now.getDate()}`;
        const inp = document.getElementById('ocrInputDate');
        if (inp) inp.value = dStr;
        const firstSecDate = document.querySelector('#ocrRowsContainer .ocr-section-date');
        if (firstSecDate) firstSecDate.value = dStr;
    });
    document.getElementById('btnOcrQuickTomorrow')?.addEventListener('click', () => {
        const tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        const dStr = `${tomorrow.getMonth() + 1}.${tomorrow.getDate()}`;
        const inp = document.getElementById('ocrInputDate');
        if (inp) inp.value = dStr;
        const firstSecDate = document.querySelector('#ocrRowsContainer .ocr-section-date');
        if (firstSecDate) firstSecDate.value = dStr;
    });
    document.getElementById('btnOcrQuickWeekday')?.addEventListener('click', () => {
        const inp = document.getElementById('ocrInputDate');
        if (inp) inp.value = '주중';
        const firstSecDate = document.querySelector('#ocrRowsContainer .ocr-section-date');
        if (firstSecDate) firstSecDate.value = '주중';
    });
    document.getElementById('btnOcrQuickWeekend')?.addEventListener('click', () => {
        const inp = document.getElementById('ocrInputDate');
        if (inp) inp.value = '주말';
        const firstSecDate = document.querySelector('#ocrRowsContainer .ocr-section-date');
        if (firstSecDate) firstSecDate.value = '주말';
    });
    document.getElementById('btnOcrQuickAll')?.addEventListener('click', () => {
        const inp = document.getElementById('ocrInputDate');
        if (inp) inp.value = '전체';
        const firstSecDate = document.querySelector('#ocrRowsContainer .ocr-section-date');
        if (firstSecDate) firstSecDate.value = '전체';
    });

    // 상단 [+ 행 추가] 버튼: 마지막 섹션에 행 추가 (섹션 없으면 새 섹션 생성)
    document.getElementById('btnOcrAddRow')?.addEventListener('click', () => {
        const container = document.getElementById('ocrRowsContainer');
        if (!container) return;
        let lastCard = container.querySelector('.ocr-section-card:last-child');
        if (!lastCard) {
            renderOcrReviewSections([{ date: '주중', items: [{ time: '', fee: '' }] }]);
            return;
        }
        const rowsWrap = lastCard.querySelector('.ocr-section-rows');
        if (!rowsWrap) return;
        const row = document.createElement('div');
        row.className = 'ocr-item-row';
        row.style.cssText = 'display: flex; gap: 5px; align-items: center; margin-bottom: 4px;';
        row.innerHTML = `
            <input type="text" class="ocr-item-time" placeholder="시간 (예: 6시대, 11:50~13:29)" style="flex: 1.5; height: 24px; font-size: 11px; border: 1px solid #CBD5E1; border-radius: 4px; padding: 0 5px; background: #FFF; box-sizing: border-box;">
            <input type="text" class="ocr-item-fee" placeholder="금액 (예: 9만, 10만)" style="flex: 1.2; height: 24px; font-size: 11px; border: 1px solid #CBD5E1; border-radius: 4px; padding: 0 5px; background: #FFF; box-sizing: border-box;">
            <button type="button" class="btn-ocr-del-row" title="행 삭제" style="width: 22px; height: 24px; background: #FFF; color: #DC2626; border: 1px solid #FECACA; border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: bold; line-height: 1;">&times;</button>
        `;
        rowsWrap.appendChild(row);
        const countEl = document.getElementById('ocrItemsCount');
        if (countEl) countEl.innerText = container.querySelectorAll('.ocr-item-row').length;
        row.querySelector('.ocr-item-time')?.focus();
    });

    // 섹션 내부 이벤트 위임: 행 추가, 행 삭제, 섹션 삭제
    document.getElementById('ocrRowsContainer')?.addEventListener('click', (e) => {
        const container = document.getElementById('ocrRowsContainer');

        // 1. 섹션 내 [+ 행 추가]
        const addSecRowBtn = e.target.closest('.btn-ocr-add-sec-row');
        if (addSecRowBtn) {
            const card = addSecRowBtn.closest('.ocr-section-card');
            const rowsWrap = card?.querySelector('.ocr-section-rows');
            if (rowsWrap) {
                const row = document.createElement('div');
                row.className = 'ocr-item-row';
                row.style.cssText = 'display: flex; gap: 5px; align-items: center; margin-bottom: 4px;';
                row.innerHTML = `
                    <input type="text" class="ocr-item-time" placeholder="시간 (예: 6시대, 11:50~13:29)" style="flex: 1.5; height: 24px; font-size: 11px; border: 1px solid #CBD5E1; border-radius: 4px; padding: 0 5px; background: #FFF; box-sizing: border-box;">
                    <input type="text" class="ocr-item-fee" placeholder="금액 (예: 9만, 10만)" style="flex: 1.2; height: 24px; font-size: 11px; border: 1px solid #CBD5E1; border-radius: 4px; padding: 0 5px; background: #FFF; box-sizing: border-box;">
                    <button type="button" class="btn-ocr-del-row" title="행 삭제" style="width: 22px; height: 24px; background: #FFF; color: #DC2626; border: 1px solid #FECACA; border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: bold; line-height: 1;">&times;</button>
                `;
                rowsWrap.appendChild(row);
                const countEl = document.getElementById('ocrItemsCount');
                if (countEl && container) countEl.innerText = container.querySelectorAll('.ocr-item-row').length;
                row.querySelector('.ocr-item-time')?.focus();
            }
            return;
        }

        // 2. 단일 행 삭제
        const delRowBtn = e.target.closest('.btn-ocr-del-row');
        if (delRowBtn) {
            const row = delRowBtn.closest('.ocr-item-row');
            if (row) {
                row.remove();
                const countEl = document.getElementById('ocrItemsCount');
                if (countEl && container) countEl.innerText = container.querySelectorAll('.ocr-item-row').length;
            }
            return;
        }

        // 3. 섹션 전체 삭제
        const delSecBtn = e.target.closest('.btn-ocr-del-sec');
        if (delSecBtn) {
            const card = delSecBtn.closest('.ocr-section-card');
            if (card) {
                card.remove();
                const countEl = document.getElementById('ocrItemsCount');
                if (countEl && container) countEl.innerText = container.querySelectorAll('.ocr-item-row').length;
            }
            return;
        }
    });

    // 📢 공지 요금표로 등록 버튼 -> 섹션별(주중, 주말 등) 날짜를 각각 분리하여 일괄 즉시 등록 & 적용!
    document.getElementById('btnOcrApplyNotice')?.addEventListener('click', () => {
        const course = (document.getElementById('ocrInputCourse')?.value || '').trim();
        if (!course) {
            alert('골프장명을 입력하거나 선택해주세요.');
            document.getElementById('ocrInputCourse')?.focus();
            return;
        }

        const cards = Array.from(document.querySelectorAll('#ocrRowsContainer .ocr-section-card'));
        const noticeLines = [];
        let validCount = 0;

        if (cards.length > 0) {
            cards.forEach(card => {
                const secDate = (card.querySelector('.ocr-section-date')?.value || '').trim() || '주중';
                const rows = Array.from(card.querySelectorAll('.ocr-item-row'));
                const secItems = [];
                rows.forEach(r => {
                    const t = (r.querySelector('.ocr-item-time')?.value || '').trim();
                    let f = (r.querySelector('.ocr-item-fee')?.value || '').trim();
                    if (t && f) {
                        if (!/만|원/.test(f) && parseFloat(f) < 1000) f += '만';
                        secItems.push(`${t} 현장 ${f}`);
                        validCount++;
                    }
                });
                if (secItems.length > 0) {
                    if (noticeLines.length > 0) noticeLines.push(''); // 블록 구분 빈 줄
                    noticeLines.push(secDate);
                    noticeLines.push(...secItems);
                }
            });
        } else {
            // 섹션 카드가 없는 경우 fallback
            let dateStr = (document.getElementById('ocrInputDate')?.value || '').trim() || '주중';
            const rowEls = Array.from(document.querySelectorAll('#ocrRowsContainer .ocr-item-row'));
            const secItems = [];
            rowEls.forEach(r => {
                const t = (r.querySelector('.ocr-item-time')?.value || '').trim();
                let f = (r.querySelector('.ocr-item-fee')?.value || '').trim();
                if (t && f) {
                    if (!/만|원/.test(f) && parseFloat(f) < 1000) f += '만';
                    secItems.push(`${t} 현장 ${f}`);
                    validCount++;
                }
            });
            if (secItems.length > 0) {
                noticeLines.push(dateStr);
                noticeLines.push(...secItems);
            }
        }

        if (validCount === 0) {
            alert('최소 1개 이상의 유효한 시간대와 금액을 입력해주세요.');
            return;
        }

        if (course) noticeLines.push(course);

        const noticeFullText = noticeLines.join('\n');
        closeOcrReviewModal();

        // 1. 공지 입력창에 저장 및 동기화
        const noticeInput = document.getElementById('noticeInputText');
        if (noticeInput) {
            noticeInput.value = noticeFullText;
            if (typeof syncParsedNoticeToManualInputs === 'function') {
                syncParsedNoticeToManualInputs(noticeFullText);
            }
        }

        // 2. 티타임 테이블에 즉시 적용 / 누적 실행!
        if (typeof applyNoticeFromText === 'function') {
            applyNoticeFromText(noticeFullText, false, new Date());
            playSuccessChime();
            showToast(`[${course}] (${cards.length}개 구역 요금표)가 즉시 적용되었습니다!`);
            try { syncNoticesWithCloud(false, true); } catch(e) {}
        } else {
            showToast(`[${course}] 공지 요금표가 등록되었습니다.`);
        }
    });
}

// 드래그앤드롭 데이터에서 이미지 파일 안전 추출 (카카오톡, 윈도우 탐색기, 웹 이미지 등)
async function extractImageFileFromDataTransfer(dataTransfer) {
    if (!dataTransfer) return null;

    // 1. files 배열 확인 (크롬에 파일 또는 Blob으로 전달된 경우)
    if (dataTransfer.files && dataTransfer.files.length > 0) {
        for (let i = 0; i < dataTransfer.files.length; i++) {
            const f = dataTransfer.files[i];
            if (!f) continue;
            if ((f.type && f.type.startsWith('image/')) || 
                /\.(png|jpe?g|gif|webp|bmp|jfif|tiff?)$/i.test(f.name) ||
                (f.size > 0 && (!f.type || f.type === 'application/octet-stream'))) {
                return f;
            }
        }
    }

    // 2. items 리스트 확인 (DataTransferItem)
    if (dataTransfer.items && dataTransfer.items.length > 0) {
        for (let i = 0; i < dataTransfer.items.length; i++) {
            const item = dataTransfer.items[i];
            if (item.kind === 'file') {
                const f = item.getAsFile();
                if (f && (f.size > 0 || (f.type && f.type.startsWith('image/')))) {
                    return f;
                }
            }
        }
    }

    // 3. text/html 에서 <img> 태그 추출 (웹/앱에서 이미지 요소로 끌려온 경우)
    try {
        const html = dataTransfer.getData('text/html');
        if (html) {
            const match = html.match(/<img[^>]+src=["']([^"']+)["']/i);
            if (match && match[1]) {
                const src = match[1];
                if (src.startsWith('data:image/')) {
                    const blob = await (await fetch(src)).blob();
                    return new File([blob], 'dragged_image.png', { type: blob.type || 'image/png' });
                } else if (src.startsWith('http') || src.startsWith('blob:')) {
                    try {
                        const resp = await fetch(src);
                        const blob = await resp.blob();
                        return new File([blob], 'dragged_image.png', { type: blob.type || 'image/png' });
                    } catch(e) {}
                }
            }
        }
    } catch(e) {}

    // 4. text/uri-list 또는 text/plain 에서 URL/Base64 추출
    try {
        const uri = dataTransfer.getData('text/uri-list') || dataTransfer.getData('text/plain');
        if (uri && (uri.startsWith('data:image/') || /\.(png|jpe?g|gif|webp|bmp)$/i.test(uri.trim()))) {
            if (uri.startsWith('data:image/')) {
                const blob = await (await fetch(uri)).blob();
                return new File([blob], 'dragged_image.png', { type: blob.type || 'image/png' });
            }
        }
    } catch(e) {}

    return null;
}

// 공지 모달 전용 이미지 OCR 판독 및 공지 자동 주입 함수
async function processOcrNoticeImage(file) {
    if (!file) return;
    showOcrLoading('🤖 Google Gemini AI로 공지 요금표 분석 중...');

    try {
        const { dataUrl, base64, mimeType } = await resizeImageForOcr(file);
        let extractedText = '';

        const geminiKey = (localStorage.getItem('gemini_api_key') || DEFAULT_GEMINI_API_KEY || '').trim();
        let geminiError = null;
        try {
            extractedText = await requestGeminiOcr(geminiKey, base64, mimeType);
        } catch(e) {
            geminiError = e;
            console.error('[OCR Notice] Gemini 호출 실패:', e);
        }

        extractedText = cleanOcrExtractedText(extractedText);
        hideOcrLoading();

        if (!extractedText) {
            let errMsg = '공지 이미지 판독 실패';
            if (geminiError) {
                errMsg = `⚠️ ${geminiError.message || String(geminiError)}`;
            }
            showToast(errMsg, 8000);
            return;
        }

        playSuccessChime();

        const detectedCourse = detectGolfCourseInText(extractedText);
        const sections = extractNoticeSectionsFromOcrText(extractedText);

        // 1. 공지 텍스트 조립 (주중/주말/날짜 블록별 분리)
        const noticeLines = [];
        let totalItemsCount = 0;
        sections.forEach(sec => {
            if (sec.items && sec.items.length > 0) {
                if (noticeLines.length > 0) noticeLines.push('');
                noticeLines.push(sec.date);
                sec.items.forEach(it => {
                    let f = it.fee || '';
                    if (f && !/만|원/.test(f) && parseFloat(f) < 1000) f += '만';
                    noticeLines.push(`${it.time} 현장 ${f}`);
                    totalItemsCount++;
                });
            }
        });
        if (detectedCourse) noticeLines.push(detectedCourse);

        const noticeFullText = noticeLines.join('\n');

        // 2. 공지 모달 내 textarea 및 규칙 자동 파싱 반영
        const noticeInput = document.getElementById('noticeInputText');
        if (noticeInput) {
            noticeInput.value = noticeFullText;
            if (typeof syncParsedNoticeToManualInputs === 'function') {
                syncParsedNoticeToManualInputs(noticeFullText);
            }
        }

        // 3. 검토 모달 오픈하여 사용자가 시간/금액 최종 확인 가능하도록 지원
        openOcrReviewModal({
            course: detectedCourse,
            sections: sections,
            rawText: extractedText
        });

        const secSummary = sections.map(s => s.date).join(', ');
        showToast(`[${detectedCourse || '공지 요금표'}] ${secSummary} ${totalItemsCount}개 시간대 요금이 자동 분리 인식되었습니다.`);

    } catch(err) {
        hideOcrLoading();
        console.error('[OCR Notice Error]', err);
        showToast(`공지 이미지 분석 오류: ${err.message || '판독 실패'}`);
    }
}

async function processOcrImage(file) {
    if (!file) return;
    // 공지용으로만 사용: 모든 이미지 입력을 공지 요금표 판독 및 자동 적용으로 일원화
    await processOcrNoticeImage(file);
}

function initOcrHandlers() {
    initOcrReviewHandlers();

    // 1. 클립보드 붙여넣기 (Ctrl + V) - 창 전체 및 모달 어디서든 동작
    window.addEventListener('paste', async (e) => {
        const items = (e.clipboardData || window.clipboardData)?.items;
        if (!items) return;
        for (let i = 0; i < items.length; i++) {
            const item = items[i];
            if (item.type && item.type.startsWith('image/')) {
                const file = item.getAsFile();
                if (file) {
                    e.preventDefault();
                    console.log('[TEE82] 클립보드 캡처 이미지 감지! OCR 분석 시작...');
                    const noticeModal = document.getElementById('noticeModal');
                    if (noticeModal && noticeModal.style.display !== 'none') {
                        await processOcrNoticeImage(file);
                    } else {
                        await processOcrImage(file);
                    }
                    break;
                }
            }
        }
    });

    // 2. 카카오톡 / 파일 드래그앤드롭 이벤트 리스너 (전체 화면 & 오버레이 연동)
    let dragCounter = 0;
    const overlay = document.getElementById('ocrDragOverlay');

    const showOverlay = (e) => {
        e.preventDefault();
        if (overlay) overlay.style.display = 'none';
    };

    window.addEventListener('dragenter', (e) => {
        e.preventDefault();
        dragCounter++;
        if (overlay) overlay.style.display = 'none';
    }, true);

    window.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (e.dataTransfer) {
            e.dataTransfer.dropEffect = 'copy';
        }
    }, true);

    window.addEventListener('dragleave', (e) => {
        e.preventDefault();
        dragCounter--;
        if (dragCounter <= 0) {
            dragCounter = 0;
            if (overlay) overlay.style.display = 'none';
        }
    }, true);

    const handleUniversalDrop = async (e) => {
        e.preventDefault();
        e.stopPropagation();
        dragCounter = 0;
        if (overlay) overlay.style.display = 'none';

        const file = await extractImageFileFromDataTransfer(e.dataTransfer);
        if (file) {
            console.log('[TEE82] 📥 카카오톡 / 파일 드래그앤드롭 이미지 감지:', file.name, file.type);
            const noticeModal = document.getElementById('noticeModal');
            if (noticeModal && noticeModal.style.display !== 'none') {
                await processOcrNoticeImage(file);
            } else {
                await processOcrImage(file);
            }
        } else {
            const text = e.dataTransfer?.getData('text/plain');
            if (text) {
                const noticeModal = document.getElementById('noticeModal');
                if (noticeModal && noticeModal.style.display !== 'none') {
                    const noticeInput = document.getElementById('noticeInputText');
                    if (noticeInput) {
                        noticeInput.value = text;
                        if (typeof syncParsedNoticeToManualInputs === 'function') syncParsedNoticeToManualInputs(text);
                    }
                } else {
                    const inputEl = document.getElementById('inputText');
                    if (inputEl) {
                        inputEl.value = text;
                        if (typeof processData === 'function') processData('join');
                    }
                }
            }
        }
    };

    window.addEventListener('drop', handleUniversalDrop, true);

    if (overlay) {
        overlay.addEventListener('dragover', (e) => {
            e.preventDefault();
            if (e.dataTransfer) e.dataTransfer.dropEffect = 'copy';
        });
        overlay.addEventListener('drop', handleUniversalDrop);
    }

    // 3. 공지 모달 내 textarea 전용 드래그 & 붙여넣기 리스너
    const noticeInput = document.getElementById('noticeInputText');
    if (noticeInput) {
        noticeInput.addEventListener('dragover', (e) => {
            e.preventDefault();
            if (e.dataTransfer) e.dataTransfer.dropEffect = 'copy';
            noticeInput.style.borderColor = '#8B5CF6';
            noticeInput.style.background = '#F5F3FF';
        });
        noticeInput.addEventListener('dragleave', () => {
            noticeInput.style.borderColor = '';
            noticeInput.style.background = '';
        });
        noticeInput.addEventListener('drop', async (e) => {
            noticeInput.style.borderColor = '';
            noticeInput.style.background = '';
            const file = await extractImageFileFromDataTransfer(e.dataTransfer);
            if (file) {
                e.preventDefault();
                e.stopPropagation();
                await processOcrNoticeImage(file);
            }
        });
        noticeInput.addEventListener('paste', async (e) => {
            const items = (e.clipboardData || window.clipboardData)?.items;
            if (!items) return;
            for (let i = 0; i < items.length; i++) {
                const item = items[i];
                if (item.type && item.type.startsWith('image/')) {
                    const file = item.getAsFile();
                    if (file) {
                        e.preventDefault();
                        e.stopPropagation();
                        await processOcrNoticeImage(file);
                        return;
                    }
                }
            }
        });
    }

    // 4. 공지 모달 내 [이미지 공지 판독] 버튼 및 파일 인풋
    const btnNoticeOcr = document.getElementById('btnNoticeOcrImage');
    const inputNoticeOcr = document.getElementById('inputNoticeOcrImageFile');
    if (btnNoticeOcr && inputNoticeOcr) {
        btnNoticeOcr.addEventListener('click', () => {
            inputNoticeOcr.click();
        });
        inputNoticeOcr.addEventListener('change', async (e) => {
            const file = e.target.files && e.target.files[0];
            if (file) {
                await processOcrNoticeImage(file);
                e.target.value = '';
            }
        });
    }

    // 5. 일반 파일 선택 인풋
    const fileInput = document.getElementById('inputOcrImageFile');
    if (fileInput) {
        fileInput.addEventListener('change', async (e) => {
            const file = e.target.files && e.target.files[0];
            if (file) {
                await processOcrImage(file);
                e.target.value = '';
            }
        });
    }

    // 최신 Google Gemini API 키 강제 동기화 등록
    localStorage.setItem('gemini_api_key', DEFAULT_GEMINI_API_KEY);

    const geminiInput = document.getElementById('inputGeminiApiKey');
    if (geminiInput) {
        geminiInput.value = localStorage.getItem('gemini_api_key') || DEFAULT_GEMINI_API_KEY;
        geminiInput.addEventListener('change', () => {
            const v = geminiInput.value.trim() || DEFAULT_GEMINI_API_KEY;
            localStorage.setItem('gemini_api_key', v);
            showToast('Gemini API 키가 저장되었습니다.');
        });
    }

    // 원클릭 AI 키 등록 팝업 (존재 시만 바인딩)
    const promptGeminiKey = () => {
        const cur = localStorage.getItem('gemini_api_key') || DEFAULT_GEMINI_API_KEY;
        const key = prompt('Google AI Studio(aistudio.google.com)에서 발급받은 Gemini API 키를 입력하세요.\n(기본 제공 키가 자동 등록되어 있습니다):', cur);
        if (key !== null) {
            const trimmed = key.trim() || DEFAULT_GEMINI_API_KEY;
            localStorage.setItem('gemini_api_key', trimmed);
            if (geminiInput) geminiInput.value = trimmed;
            showToast('Gemini AI 키가 설정되었습니다.');
        }
    };
    document.getElementById('btnNoticeGeminiKey')?.addEventListener('click', promptGeminiKey);
    document.getElementById('btnMainGeminiKey')?.addEventListener('click', promptGeminiKey);

    chrome.runtime.onMessage.addListener((msg) => {
        if (msg.type === 'GOLFMON_SESSION_EXPIRED') {
            showToast('[골프몬 세션 만료] ' + msg.message, 10000);
            const desc = document.getElementById('progressDesc');
            if (desc) {
                desc.innerHTML = '<span style="color:#DC2626; font-weight:800;">[일시정지] 골프몬 로그인이 만료되었습니다.<br>골프몬 탭에서 로그인하시면 자동으로 이어서 진행합니다.</span>';
            }
            try {
                if (chrome.notifications && chrome.notifications.create) {
                    chrome.notifications.create({
                        type: 'basic',
                        iconUrl: 'icon128.png',
                        title: '[GolfTee82] 골프몬 세션 만료 감지',
                        message: '골프몬 로그인이 끊겨 매크로가 안전하게 일시정지되었습니다. 로그인 시 바로 재개됩니다.',
                        priority: 2
                    });
                }
            } catch(e) {}
            try {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (AudioCtx) {
                    const ctx = new AudioCtx();
                    [800, 600, 800].forEach((freq, idx) => {
                        const osc = ctx.createOscillator();
                        osc.type = 'sawtooth';
                        osc.frequency.setValueAtTime(freq, ctx.currentTime + idx * 0.22);
                        osc.connect(ctx.destination);
                        osc.start(ctx.currentTime + idx * 0.22);
                        osc.stop(ctx.currentTime + idx * 0.22 + 0.16);
                    });
                }
            } catch(e) {}
        }
    });
}

// ========================================================
// 📊 일일 작업 통계 대시보드 리포트 모듈
// ========================================================
function getTodayDateKey() {
    const d = new Date();
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
}

function recordDailyStat(platform, actionType, courseName, count = 1) {
    if (!count || count <= 0) return;
    const today = getTodayDateKey();
    chrome.storage.local.get(['daily_macro_stats'], (res) => {
        let stats = res?.daily_macro_stats;
        if (!stats || stats.date !== today) {
            stats = {
                date: today,
                total: 0,
                register: 0,
                modify: 0,
                byPlatform: {},
                byCourse: {}
            };
        }
        stats.total = (stats.total || 0) + count;
        if (actionType === '등록') stats.register = (stats.register || 0) + count;
        else stats.modify = (stats.modify || 0) + count;

        const pKey = platform || '기타';
        stats.byPlatform[pKey] = (stats.byPlatform[pKey] || 0) + count;

        if (courseName && courseName !== '기타' && courseName !== '전체리셋') {
            const cleanCourse = courseName.replace(/\s+/g, '');
            stats.byCourse[cleanCourse] = (stats.byCourse[cleanCourse] || 0) + count;
        }

        chrome.storage.local.set({ daily_macro_stats: stats }, () => {
            updateStatsBadge(stats.total);
        });
    });
}

function updateStatsBadge(totalCount) {
    const btnStats = document.getElementById('btnOpenStats');
    if (!btnStats) return;
    if (typeof totalCount === 'number' && totalCount > 0) {
        btnStats.title = `오늘의 작업 통계 (총 ${totalCount}건 처리 완료)`;
    }
}

function renderDailyStatsModal() {
    const today = getTodayDateKey();
    const modal = document.getElementById('dailyStatsModal');
    if (!modal) return;

    chrome.storage.local.get(['daily_macro_stats'], (res) => {
        let stats = res?.daily_macro_stats;
        if (!stats || stats.date !== today) {
            stats = {
                date: today,
                total: 0,
                register: 0,
                modify: 0,
                byPlatform: {},
                byCourse: {}
            };
        }

        const dateBadge = document.getElementById('statsDateBadge');
        if (dateBadge) dateBadge.textContent = stats.date;
        const totalEl = document.getElementById('statTotalCount');
        if (totalEl) totalEl.textContent = `${stats.total || 0}건`;
        const regEl = document.getElementById('statRegisterCount');
        if (regEl) regEl.textContent = `${stats.register || 0}건`;
        const modEl = document.getElementById('statModifyCount');
        if (modEl) modEl.textContent = `${stats.modify || 0}건`;

        // 플랫폼별 뱃지
        const pContainer = document.getElementById('statsPlatformBadges');
        if (pContainer) {
            pContainer.innerHTML = '';
            const platformMap = {
                golfmon: '골프몬',
                golmarket: '골마켓',
                golfrock: '골프락',
                golftop: '골프탑',
                golfland: '골프랜드',
                golfpang: '골팡'
            };
            const allPlatforms = ['golfmon', 'golmarket', 'golfrock', 'golftop', 'golfland'];
            let hasPlatformStat = false;
            allPlatforms.forEach(pKey => {
                const pCount = stats.byPlatform[pKey] || stats.byPlatform[platformMap[pKey]] || 0;
                if (pCount > 0) hasPlatformStat = true;
                const badge = document.createElement('div');
                badge.style.cssText = `
                    font-size: 11px; padding: 3px 8px; border-radius: 6px;
                    background: ${pCount > 0 ? '#EEF2FF' : '#F1F5F9'};
                    color: ${pCount > 0 ? '#4338CA' : '#94A3B8'};
                    border: 1px solid ${pCount > 0 ? '#C7D2FE' : '#E2E8F0'};
                    font-weight: ${pCount > 0 ? '700' : '500'};
                `;
                badge.innerHTML = `${platformMap[pKey] || pKey}: <b>${pCount}건</b>`;
                pContainer.appendChild(badge);
            });
            if (!hasPlatformStat && stats.total === 0) {
                pContainer.innerHTML = '<span style="font-size: 11px; color: #94A3B8;">오늘 처리된 실적이 아직 없습니다.</span>';
            }
        }

        // 구장별 순위 바 리스트
        const courseContainer = document.getElementById('statsCourseList');
        if (courseContainer) {
            courseContainer.innerHTML = '';
            const courses = Object.entries(stats.byCourse || {}).sort((a, b) => b[1] - a[1]);
            const courseTotalEl = document.getElementById('statsCourseTotalCount');
            if (courseTotalEl) courseTotalEl.textContent = `총 ${courses.length}개 구장`;

            if (courses.length === 0) {
                courseContainer.innerHTML = '<div style="font-size: 11px; color: #94A3B8; text-align: center; padding: 16px 0;">아직 처리된 구장 내역이 없습니다.</div>';
            } else {
                const maxVal = Math.max(...courses.map(c => c[1]), 1);
                courses.forEach(([cName, cnt], idx) => {
                    const pct = Math.round((cnt / maxVal) * 100);
                    const row = document.createElement('div');
                    row.style.cssText = 'display: flex; flex-direction: column; gap: 2px;';
                    row.innerHTML = `
                        <div style="display: flex; justify-content: space-between; font-size: 11px; color: #334155;">
                            <span><b style="color: ${idx < 3 ? '#2563EB' : '#64748B'};">${idx + 1}.</b> ${cName}</span>
                            <span style="font-weight: 700; color: #1E293B;">${cnt}건</span>
                        </div>
                        <div style="width: 100%; height: 6px; background: #F1F5F9; border-radius: 3px; overflow: hidden;">
                            <div style="width: ${pct}%; height: 100%; background: linear-gradient(90deg, #3B82F6, #6366F1); border-radius: 3px;"></div>
                        </div>
                    `;
                    courseContainer.appendChild(row);
                });
            }
        }

        modal.style.display = 'flex';
    });
}

function copyDailyStatsSummary() {
    const today = getTodayDateKey();
    chrome.storage.local.get(['daily_macro_stats'], (res) => {
        const stats = res?.daily_macro_stats || { date: today, total: 0, register: 0, modify: 0, byPlatform: {}, byCourse: {} };
        const courses = Object.entries(stats.byCourse || {}).sort((a, b) => b[1] - a[1]);
        const platformMap = { golfmon: '골프몬', golmarket: '골마켓', golfrock: '골프락', golftop: '골프탑', golfland: '골프랜드', golfpang: '골팡' };

        let lines = [];
        lines.push(`[GolfTee82 일일 작업 리포트]`);
        lines.push(`📅 일자: ${stats.date || today}`);
        lines.push(`총 처리: ${stats.total || 0}건 (신규등록: ${stats.register || 0}건 / 수정: ${stats.modify || 0}건)`);
        lines.push(``);
        lines.push(`구장별 실적:`);
        if (courses.length === 0) {
            lines.push(`- 처리 내역 없음`);
        } else {
            courses.forEach(([c, cnt]) => lines.push(`- ${c}: ${cnt}건`));
        }
        lines.push(``);
        lines.push(`🌐 플랫폼별 실적:`);
        const pEntries = Object.entries(stats.byPlatform || {});
        if (pEntries.length === 0) {
            lines.push(`- 처리 내역 없음`);
        } else {
            pEntries.forEach(([p, cnt]) => lines.push(`- ${platformMap[p] || p}: ${cnt}건`));
        }

        const fullText = lines.join('\n');
        navigator.clipboard.writeText(fullText).then(() => {
            showToast('일일 통계 요약이 클립보드에 복사되었습니다! (카톡/밴드 붙여넣기 가능)');
        }).catch(() => {
            showToast('복사에 실패했습니다. 권한을 확인해주세요.');
        });
    });
}

function resetDailyStatsConfirm() {
    if (!confirm("오늘의 누적 통계를 모두 0건으로 초기화하시겠습니까?")) return;
    const today = getTodayDateKey();
    const emptyStats = {
        date: today,
        total: 0,
        register: 0,
        modify: 0,
        byPlatform: {},
        byCourse: {}
    };
    chrome.storage.local.set({ daily_macro_stats: emptyStats }, () => {
        renderDailyStatsModal();
        updateStatsBadge(0);
        showToast('오늘의 작업 통계가 초기화되었습니다.');
    });
}

// ========================================================
// 🌐 플랫폼 동시 등록 모듈 (모달 선택 & 완전 독립 병렬 동시 실행)
// ========================================================
function openMultiPlatformModal() {
    if (!checkAuthSecurityGuard()) return;

    const hasMulti = typeof hasUserFeature === 'function' ? hasUserFeature('동시등록') : false;
    const isLabActive = isCurrentUserAdmin() && localStorage.getItem('v2_labModeActive') === 'true' && localStorage.getItem('v2_multiFeatureActive') === 'true';
    if (!hasMulti && !isLabActive) {
        alert("이 기능은 부여기능 '동시등록' 권한이 부여된 회원 전용 기능입니다.\n관리자에게 문의해주세요.");
        return;
    }

    const selectedTrs = Array.from(document.querySelectorAll('#dataTable tbody tr.selected'));
    if (selectedTrs.length === 0) {
        alert("플랫폼 동시 등록할 항목이 선택되지 않았습니다.\n목록에서 카드를 클릭하거나 [원클릭]을 먼저 실행해주세요.");
        return;
    }

    const countEl = document.getElementById('multiModalItemCount');
    if (countEl) countEl.innerText = String(selectedTrs.length);

    // 권한 체크 및 체크박스 상태 설정
    const siteConfig = [
        { id: 'chkModalMultiGolfmon', lbl: 'lblMultiGolfmon', site: '몬', key: 'golfmon' },
        { id: 'chkModalMultiGolftop', lbl: 'lblMultiGolftop', site: '탑', key: 'golftop' },
        { id: 'chkModalMultiGolmarket', lbl: 'lblMultiGolmarket', site: '마켓', key: 'golmarket' },
        { id: 'chkModalMultiGolfrock', lbl: 'lblMultiGolfrock', site: '락', key: 'golfrock' },
        { id: 'chkModalMultiGolfland', lbl: 'lblMultiGolfland', site: '랜드', key: 'golfland' }
    ];

    chrome.storage.local.get(['multi_platform_targets_v2'], (res) => {
        const saved = res?.multi_platform_targets_v2 || {};
        siteConfig.forEach(cfg => {
            const chk = document.getElementById(cfg.id);
            const lbl = document.getElementById(cfg.lbl);
            const permitted = hasSitePermission(cfg.site);

            if (!permitted) {
                if (chk) { chk.checked = false; chk.disabled = true; }
                if (lbl) { lbl.style.opacity = '0.45'; lbl.style.pointerEvents = 'none'; }
            } else {
                if (chk) {
                    chk.disabled = false;
                    chk.checked = typeof saved[cfg.key] === 'boolean' ? saved[cfg.key] : true;
                }
                if (lbl) { lbl.style.opacity = '1'; lbl.style.pointerEvents = 'auto'; }
            }
        });

        const modal = document.getElementById('multiPlatformModal');
        if (modal) modal.style.display = 'flex';
    });
}

function closeMultiPlatformModal() {
    const modal = document.getElementById('multiPlatformModal');
    if (modal) modal.style.display = 'none';
}

function executeMultiPlatformRegistration() {
    const selectedTrs = Array.from(document.querySelectorAll('#dataTable tbody tr.selected'));
    if (selectedTrs.length === 0) {
        alert("등록할 항목이 선택되지 않았습니다.");
        closeMultiPlatformModal();
        return;
    }

    const targets = {
        golfmon: (document.getElementById('chkModalMultiGolfmon')?.checked !== false) && hasSitePermission('몬'),
        golftop: (document.getElementById('chkModalMultiGolftop')?.checked !== false) && hasSitePermission('탑'),
        golmarket: (document.getElementById('chkModalMultiGolmarket')?.checked !== false) && hasSitePermission('마켓'),
        golfrock: (document.getElementById('chkModalMultiGolfrock')?.checked !== false) && hasSitePermission('락'),
        golfland: (document.getElementById('chkModalMultiGolfland')?.checked !== false) && hasSitePermission('랜드')
    };

    const targetList = Object.entries(targets).filter(([_, enabled]) => enabled).map(([k]) => k);
    if (targetList.length === 0) {
        alert("최소 1개 이상의 플랫폼을 선택해 주세요.");
        return;
    }

    // 선택 상태 영구 저장
    chrome.storage.local.set({ multi_platform_targets_v2: targets });

    closeMultiPlatformModal();

    const platformLabels = {
        golfmon: '골프몬',
        golftop: '골프탑',
        golmarket: '골마켓',
        golfrock: '골프락',
        golfland: '골프랜드'
    };
    const targetNames = targetList.map(k => platformLabels[k]).join(', ');

    showToast(`🌐 [${targetNames}] 플랫폼 동시 등록을 시작합니다...`);

    // 동시 실행 트래커 초기화 및 공용 completedItems 초기화 (1회만)
    activeConcurrentPlatforms.clear();
    targetList.forEach(k => activeConcurrentPlatforms.add(k));

    try {
        chrome.storage.local.set({
            completedItems: [],
            isRegistrationRunning: true
        });
    } catch(e) {}

    // 활성 플랫폼 순차적으로 트리거 (0ms, 250ms, 500ms... 지연으로 탭 충돌 방지)
    let delay = 0;
    if (targets.golfmon) {
        setTimeout(() => startGolfmonRegistration(true), delay);
        delay += 250;
    }
    if (targets.golftop) {
        setTimeout(() => startGolftopRegistration(true), delay);
        delay += 250;
    }
    if (targets.golmarket) {
        setTimeout(() => startGolfmarketRegistration(true), delay);
        delay += 250;
    }
    if (targets.golfrock) {
        setTimeout(() => startGolfrockRegistration(true), delay);
        delay += 250;
    }
    if (targets.golfland) {
        setTimeout(() => startGolflandRegistration(true), delay);
        delay += 250;
    }
}

// 신규 기능 이벤트 리스너 바인딩
function initFeatureExtensions() {
    // 1. 통계 대시보드
    document.getElementById('btnOpenStats')?.addEventListener('click', renderDailyStatsModal);
    document.getElementById('btnCloseStatsModalX')?.addEventListener('click', () => {
        const m = document.getElementById('dailyStatsModal');
        if (m) m.style.display = 'none';
    });
    document.getElementById('btnCloseDailyStatsModal')?.addEventListener('click', () => {
        const m = document.getElementById('dailyStatsModal');
        if (m) m.style.display = 'none';
    });
    document.getElementById('btnCopyDailyStatsText')?.addEventListener('click', copyDailyStatsSummary);
    document.getElementById('btnResetDailyStats')?.addEventListener('click', resetDailyStatsConfirm);

    // 초기 통계 배지 반영
    chrome.storage.local.get(['daily_macro_stats'], (res) => {
        const stats = res?.daily_macro_stats;
        if (stats && stats.date === getTodayDateKey()) {
            updateStatsBadge(stats.total);
        }
    });

    // 2. 멀티 플랫폼 동시 등록 모달 & 버튼 바인딩
    document.getElementById('btnRegisterMultiPlatform')?.addEventListener('click', openMultiPlatformModal);
    document.getElementById('btnCloseMultiPlatformModalX')?.addEventListener('click', closeMultiPlatformModal);
    document.getElementById('btnCancelMultiPlatformModal')?.addEventListener('click', closeMultiPlatformModal);
    document.getElementById('btnConfirmMultiPlatformStart')?.addEventListener('click', executeMultiPlatformRegistration);

    // 전체 선택 / 전체 해제
    document.getElementById('btnMultiSelectAll')?.addEventListener('click', () => {
        const siteConfig = ['chkModalMultiGolfmon', 'chkModalMultiGolftop', 'chkModalMultiGolmarket', 'chkModalMultiGolfrock', 'chkModalMultiGolfland'];
        siteConfig.forEach(id => {
            const chk = document.getElementById(id);
            if (chk && !chk.disabled) chk.checked = true;
        });
    });
    document.getElementById('btnMultiDeselectAll')?.addEventListener('click', () => {
        const siteConfig = ['chkModalMultiGolfmon', 'chkModalMultiGolftop', 'chkModalMultiGolmarket', 'chkModalMultiGolfrock', 'chkModalMultiGolfland'];
        siteConfig.forEach(id => {
            const chk = document.getElementById(id);
            if (chk && !chk.disabled) chk.checked = false;
        });
    });

    // 바깥 클릭 시 닫기
    document.getElementById('multiPlatformModal')?.addEventListener('click', (e) => {
        if (e.target.id === 'multiPlatformModal') closeMultiPlatformModal();
    });
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
        initOcrHandlers();
        initFeatureExtensions();
    });
} else {
    initOcrHandlers();
    initFeatureExtensions();
}
