    }

    // 5. 빅토리아
    const victoriaEntry = {
        golfmon: '빅토리아cc(P9)', golfpang: '빅토리아cc(P9)', golfrock: '빅토리아(9홀)',
        golmarket: '빅토리아(9홀)', golfland: '빅토리아cc(P9)', golftop: '빅토리아cc(P9)',
        name: '빅토리아cc(P9)', region: '경기남부'
    };
    for (const k of ['빅토리아', '빅토리아cc', '빅토리아(9홀)', '빅토리아(p9)', '빅토리아cc(p9)', '빅토리아cc(P9)']) {
        dict[k] = Object.assign({}, dict[k] || {}, victoriaEntry);
    }

    // 6. 링크나인
    const linknineEntry = {
        golfmon: '링크나인cc(P9)', golfpang: '링크나인cc(P9)', golfrock: '링크나인(9홀)',
        golmarket: '링크나인(9홀)', golfland: '링크나인cc(P9)', golftop: '링크나인cc(P9)',
        name: '링크나인cc(P9)', region: '경기남부'
    };
    for (const k of ['링크나인', '링크나인cc', '링크나인(9홀)', '링크나인(p9)', '링크나인cc(p9)', '링크나인cc(P9)']) {
        dict[k] = Object.assign({}, dict[k] || {}, linknineEntry);
    }

    // 7. 한림안성
    const hanlimAnseongEntry = {
