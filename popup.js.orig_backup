    // 전체리셋 날짜(시작일 ~ 종료일) 및 구분 필터 초기값 설정 / 복원
    const inputResetTargetDate = document.getElementById('inputResetTargetDate');
    const inputResetEndDate = document.getElementById('inputResetEndDate');
    if (inputResetTargetDate) {
        const now = new Date();
        const yyyy = now.getFullYear();
        const mm = String(now.getMonth() + 1).padStart(2, '0');
        const dd = String(now.getDate()).padStart(2, '0');
        const todayStr = `${yyyy}-${mm}-${dd}`;
        const savedDate = localStorage.getItem('v2_savedResetTargetDate');
        const initStart = (savedDate && savedDate >= todayStr) ? savedDate : todayStr;
        inputResetTargetDate.value = initStart;

        if (inputResetEndDate) {
            const savedEnd = localStorage.getItem('v2_savedResetEndDate');
            inputResetEndDate.value = (savedEnd && savedEnd >= initStart) ? savedEnd : initStart;
            inputResetEndDate.addEventListener('change', () => {
                if (inputResetTargetDate.value && inputResetEndDate.value && inputResetEndDate.value < inputResetTargetDate.value) {
                    inputResetTargetDate.value = inputResetEndDate.value;
                    try { localStorage.setItem('v2_savedResetTargetDate', inputResetTargetDate.value); } catch(e) {}
                }
                try { localStorage.setItem('v2_savedResetEndDate', inputResetEndDate.value); } catch(e) {}
            });
        }

        inputResetTargetDate.addEventListener('change', () => {
            try { localStorage.setItem('v2_savedResetTargetDate', inputResetTargetDate.value); } catch(e) {}
            if (inputResetEndDate && inputResetTargetDate.value && (!inputResetEndDate.value || inputResetEndDate.value < inputResetTargetDate.value)) {
                inputResetEndDate.value = inputResetTargetDate.value;
                try { localStorage.setItem('v2_savedResetEndDate', inputResetEndDate.value); } catch(e) {}
            }
        });
    }
    const selResetFilterType = document.getElementById('selResetFilterType');
    if (selResetFilterType) {
        const savedFilter = localStorage.getItem('v2_savedResetFilterType');
        if (savedFilter && ['전체', '조인', '양도'].includes(savedFilter)) {
            selResetFilterType.value = savedFilter;
        }
        selResetFilterType.addEventListener('change', () => {
