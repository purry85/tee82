        e.preventDefault();
        startGolfmonPostReplacement(false); // 스마트수정: 동일 타임·금액은 0초 자동통과 & 변동 타임만 고속 수정
    });
    document.getElementById('btnResetGolfmonDatePosts')?.addEventListener('click', () => startGolfmonDateReset(false));
    document.getElementById('btnResetGolfmonSelectedPosts')?.addEventListener('click', () => startGolfmonSelectedReset(false));
    initResetIntervalRadios();
