            const isAlreadyOnBookingMain = currentTabUrl.includes('bookingMain.php');

            if (isAlreadyOnBookingMain) {
                chrome.tabs.update(golflandTab.id, { active: true }, () => {
                    chrome.tabs.sendMessage(golflandTab.id, {
                        action: 'START_GOLFLAND_REGISTRATION',
                        isAdmin: isCurrentUserAdmin(),
                        items: items,
                        memo: memo,
                        mode: mode,
                        delayPreset: delayPreset,
                        stepPreset: stepPreset
                    }, (response) => {
                        if (chrome.runtime.lastError) {
                            console.log("[Tee82] 골프랜드 탭 활성화 완료:", golflandTab.url);
                        }
                    });
                });
            } else {
                chrome.tabs.update(golflandTab.id, { url: targetUrl, active: true }, () => {
                    console.log("[Tee82] 골프랜드 부킹프라자로 페이지 이동:", targetUrl);
                });
            }
        } else {
            if (confirm("열려 있는 골프랜드(golfland.co.kr) 탭이 없습니다.\n골프랜드 부킹프라자 페이지를 새 탭으로 여시겠습니까?")) {
                chrome.tabs.create({ url: targetUrl });
            }
        }
    });
}

