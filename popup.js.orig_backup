// 공지 전용 구장명 표준화 헬퍼 (클럽72 계열 완벽 통합, 임페리얼, 떼제베 등)
// ★ [사용자 핵심 요구사항]
// "클럽72 와 클럽72(레이크/클래식), 레/클 은 클럽72 로 동일하게 적용해."
function normalizeNoticeCourseName(courseName) {
    if (!courseName) return '';
    let name = String(courseName).trim();

    // 단축어 사전 확인
    if (typeof NOTICE_COURSE_SHORT_MAP !== 'undefined' && NOTICE_COURSE_SHORT_MAP[name]) {
        name = NOTICE_COURSE_SHORT_MAP[name];
    }

    const norm = name.replace(/[\s\-_\[\]\(\)\/]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();

    // ★ 알펜시아700 vs 알펜시아cc(명문) 분리 보장 (700이 포함된 경우 '알펜시아700', 아니면 '알펜시아')
    if (norm.includes('알펜시아700') || norm.includes('알펜700')) {
        return '알펜시아700';
    }
    if (norm.includes('알펜시아명문') || norm.includes('알펜명문') || norm.includes('알펜시아회원제') || norm.includes('알펜회원제')) {
        return '알펜시아';
    }

    // ★ 클럽72(오션)은 독립된 오션 코스이므로 오션만 예외 유지
    if (norm.includes('오션')) {
        return '클럽72(오션)';
    }

    // ★ 클럽72, 클럽72(레이크/클래식), 클럽72(클래식/레이크), 레/클, 레이크/클래식 등은 무조건 '클럽72'로 단일화!
    if (
        norm === '클럽72' ||
        norm.includes('클럽72') ||
        norm.includes('레클') ||
        norm.includes('레이크클래식') ||
        norm.includes('클래식레이크') ||
        (norm.includes('레이크') && norm.includes('클래식'))
    ) {
        return '클럽72';
    }

    // 임페리얼 -> 임페리얼레이크
    if (norm === '임페리얼' || norm.includes('임페리얼')) {
        return '임페리얼레이크';
    }

    // ★ 비에이비스타 회원제 vs 퍼블릭(P) 코스 분리 보장
    if (norm.includes('비에이비스타') || (norm.includes('비에이') && !norm.includes('베어즈'))) {
        if (norm.includes('p') || norm.includes('퍼블릭')) {
            return '비에이비스타(P)';
        }
        return '비에이비스타';
    }

    // 떼제베 서남/동북
    if (norm.includes('서남') || norm === '서남서') {
        return '떼제베(서남)';
    }
    if (norm.includes('동북') || norm === '동북동') {
        return '떼제베(동북)';
    }

    return name;
}

// 공지 텍스트 라인에서 구장명 식별 (사전, 기존 테이블, 고정/제휴 구장 목록, 단독 라인 기반)
function detectCourseInLine(line) {
    if (!line) return null;

    // 카카오톡 송신자/시간 헤더 제거 (예: "[골프락 안현희대리] [오후 1:52] ▣ 스프링베일GC ▣")
    let raw = line.replace(/^\[[^\]]+\]\s*\[(?:오전|오후)?\s*\d{1,2}:\d{2}\]\s*/, '').trim();
    if (!raw) return null;

    // 장식용 특수기호, 이모지 및 괄호 제거
    const clean = raw.replace(/[\[\]\(\)\*#※■□▣◆◇▲▼▶▷◀◁●○★☆【】<>~_=\-🔹📣📢📌📍]/g, '').trim();
    if (!clean) return null;

    // ★ [사용자 핵심 요구사항] 오션 / 클오 / 오션코스 / 클럽72오션은 100% '클럽72(오션)'으로 즉시 식별!
    // 골프 공지에서 '오션'은 무조건 클럽72(오션)을 가리키며,
    // "■ 11/02 (월)오션", "♣내일♣오션♣11/2(월)♣" 처럼 날짜/요일과 함께 한 줄에 나오더라도
    // 비-구장 단어 필터에 걸려 누락되지 않도록 최우선 매칭합니다.
    const normLineNoSpace = clean.replace(/[\s\-_/]/g, '').toLowerCase();
    if (normLineNoSpace.includes('오션') || normLineNoSpace.includes('클오') || normLineNoSpace.includes('클럽72오션')) {
        return '클럽72(오션)';
    }

    // 안내/공지/인사말/식음/이벤트 문구인 경우 스킵
    if (isNonGolfLine(raw) || isNonGolfLine(clean)) return null;

    // 비-구장 단어(부제: 1부/2부/3부, 마감, 날짜, 요일, 일반 명사 등) 엄격 배제!
    if (isNonCourseWord(raw) || isNonCourseWord(clean)) return null;

    // 안내/공지 문구만 있는 경우 스킵
    const isDisclaimer = /^(?:부분선결제|선결제|금액\s*인하|인하|공지|안내|할인|특가|임박|홈페이지|기존예약|적용|참고|필독|기간|혜택|이벤트|프로모션|발송일|작성일|공지일|전송일)/i.test(clean);
    if (isDisclaimer) return null;

    // ★ [사용자 핵심 요구사항] 클럽72 계열(레이크/클래식, 레/클, 클래식/레이크 등) 우선 즉시 '클럽72'로 식별! (오션 제외)
    if (!normLineNoSpace.includes('오션')) {
        if (normLineNoSpace.includes('클럽72') ||
            normLineNoSpace.includes('레클') ||
            normLineNoSpace.includes('레이크클래식') ||
            normLineNoSpace.includes('클래식레이크') ||
            (normLineNoSpace.includes('레이크') && normLineNoSpace.includes('클래식'))) {
            return '클럽72';
        }
    }

    // 0. 약어 사전 매칭 (예: 클아 -> 클럽72, 클오 -> 클럽72(오션), 서남서 -> 떼제베(서남), 동북동 -> 떼제베(동북))
    if (typeof NOTICE_COURSE_SHORT_MAP !== 'undefined') {
        const normNoSpace = clean.replace(/[\s\-_]/g, '').toLowerCase();
        for (const [shortKey, targetCourse] of Object.entries(NOTICE_COURSE_SHORT_MAP)) {
            const normShort = shortKey.replace(/[\s\-_]/g, '').toLowerCase();
            if (normNoSpace === normShort || normNoSpace.startsWith(normShort)) {
                return normalizeNoticeCourseName(targetCourse);
            }
        }
    }

    // 1. 현재 화면 테이블에 이미 있는 구장명과 우선 매칭 (대소문자/공백/cc/gc 무시, 숫자 일치 필수)
    const normClean = clean.replace(/[\s\-_\[\]\(\)]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();
    const cleanDigits = (normClean.replace(/[0-9]+\s*홀/gi, '').match(/\d+/g) || []).join('');

    const tableRows = document.querySelectorAll('#dataTable tbody tr');
    for (const tr of tableRows) {
        const golf = tr.cells[2]?.textContent.trim();
        const rawGolf = tr.dataset.rawGolf || '';
        const normGolf = (golf || '').replace(/[\s\-_\[\]\(\)]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();
        const normRaw = (rawGolf || '').replace(/[\s\-_\[\]\(\)]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();

        const golfDigits = (normGolf.replace(/[0-9]+\s*홀/gi, '').match(/\d+/g) || []).join('');
        const rawDigits = (normRaw.replace(/[0-9]+\s*홀/gi, '').match(/\d+/g) || []).join('');

        if (normGolf && normClean.length >= 2 && (!cleanDigits && !golfDigits || cleanDigits === golfDigits) && (normClean === normGolf || normClean.includes(normGolf) || normGolf.includes(normClean))) return normalizeNoticeCourseName(golf);
        if (normRaw && normClean.length >= 2 && (!cleanDigits && !rawDigits || cleanDigits === rawDigits) && (normClean === normRaw || normClean.includes(normRaw) || normRaw.includes(normClean))) return normalizeNoticeCourseName(rawGolf);
    }

    // 2. 매핑사전 키 또는 골프몬명 직접 매칭 (dictionary + defaultDict 동시 대응, 숫자 일치 필수)
    const dictSource = (typeof dictionary !== 'undefined' && dictionary && Object.keys(dictionary).length > 0)
        ? dictionary
        : (typeof defaultDict !== 'undefined' ? defaultDict : {});

    if (dictSource && typeof dictSource === 'object') {
        for (const [key, val] of Object.entries(dictSource)) {
            const normKey = key.replace(/[\s\-_\[\]\(\)]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();
            const targetName = typeof val === 'string' ? val : (val?.name || val?.golfmon || '');
            const normTarget = targetName.replace(/[\s\-_\[\]\(\)]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();

            const keyDigits = (normKey.replace(/[0-9]+\s*홀/gi, '').match(/\d+/g) || []).join('');
            const targetDigits = (normTarget.replace(/[0-9]+\s*홀/gi, '').match(/\d+/g) || []).join('');

            if (normKey && normClean.length >= 2 && (!cleanDigits && !keyDigits || cleanDigits === keyDigits) && (normClean === normKey || normClean.includes(normKey) || normKey.includes(normClean))) {
                return normalizeNoticeCourseName(key);
            }
            if (normTarget && normClean.length >= 2 && (!cleanDigits && !targetDigits || cleanDigits === targetDigits) && (normClean === normTarget || normClean.includes(normTarget) || normTarget.includes(normClean))) {
                return normalizeNoticeCourseName(key);
            }
        }
    }

    // 2-2. 기본 공지 구장 카탈로그 및 사용자 등록 구장 매칭
    if (typeof DEFAULT_NOTICE_COURSE_CATALOG !== 'undefined') {
        for (const reg in DEFAULT_NOTICE_COURSE_CATALOG) {
            for (const c of DEFAULT_NOTICE_COURSE_CATALOG[reg]) {
                const normC = c.replace(/[\s\-_\[\]\(\)]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();
                const cDigits = (normC.replace(/[0-9]+\s*홀/gi, '').match(/\d+/g) || []).join('');
                if (normC && normClean.length >= 2 && (!cleanDigits && !cDigits || cleanDigits === cDigits) && (normClean === normC || normClean.includes(normC) || normC.includes(normClean))) {
                    return normalizeNoticeCourseName(c);
                }
            }
        }
    }
    if (typeof customNoticeCourses !== 'undefined' && Array.isArray(customNoticeCourses)) {
        for (const item of customNoticeCourses) {
            const c = item?.name || '';
            const normC = c.replace(/[\s\-_\[\]\(\)]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();
            const cDigits = (normC.replace(/[0-9]+\s*홀/gi, '').match(/\d+/g) || []).join('');
            if (normC && normClean.length >= 2 && (!cleanDigits && !cDigits || cleanDigits === cDigits) && (normClean === normC || normClean.includes(normC) || normC.includes(normClean))) {
                return normalizeNoticeCourseName(c);
            }
        }
    }

    // 3. getMappedName(clean) 매핑 검사
    if (typeof getMappedName === 'function') {
        const mapped = getMappedName(clean);
        if (mapped && mapped.mapped && mapped.name) {
            return normalizeNoticeCourseName(mapped.name);
        }
    }

    // 4. 고정/제휴 구장명 목록 매칭
    if (typeof fixedGolfs !== 'undefined' && Array.isArray(fixedGolfs)) {
        for (const g of fixedGolfs) {
            const normG = g.replace(/[\s\-_\[\]\(\)]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();
            const gDigits = (normG.replace(/[0-9]+\s*홀/gi, '').match(/\d+/g) || []).join('');
            if (normG && normClean.length >= 2 && (!cleanDigits && !gDigits || cleanDigits === gDigits) && (normClean === normG || normClean.includes(normG) || normG.includes(normClean))) return normalizeNoticeCourseName(g);
        }
    }
    if (typeof affiliates !== 'undefined' && Array.isArray(affiliates)) {
        for (const g of affiliates) {
            const normG = g.replace(/[\s\-_\[\]\(\)]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();
            const gDigits = (normG.replace(/[0-9]+\s*홀/gi, '').match(/\d+/g) || []).join('');
            if (normG && normClean.length >= 2 && (!cleanDigits && !gDigits || cleanDigits === gDigits) && (normClean === normG || normClean.includes(normG) || normG.includes(normClean))) return normalizeNoticeCourseName(g);
        }
    }

    // 5. 공백으로 분리된 첫 단어가 구장명인 경우
    const firstWord = clean.split(/[\s\t]/)[0].trim();
    if (firstWord && firstWord.length >= 2 && !isNonCourseWord(firstWord)) {
        if (typeof dictionary !== 'undefined' && dictionary[firstWord]) return normalizeNoticeCourseName(firstWord);
        if (typeof fixedGolfs !== 'undefined' && fixedGolfs.includes(firstWord)) return normalizeNoticeCourseName(firstWord);
    }

    // 6. 단독 구장명 라인 추정 (접미사 cc/gc/골프클럽이 있거나 헤더 기호로 장식된 경우)
    const isPureNonCourse = /^\d+$/.test(clean) || 
                            /\d{1,2}[:.]\d{2}/.test(clean) || 
                            /\d{1,2}\s*(?:시대|시\s*대|시타임|시)/.test(clean) || 
                            /\d+\s*만(?:원)?/.test(clean) ||
                            /\d{1,2}\s*[월./\-]\s*\d{1,2}/.test(clean);

    const hasCourseSuffix = /(?:cc|gc|골프장|골프클럽|컨트리클럽|컨트리|c\.c|g\.c)$/i.test(clean);
    const hasHeaderDecoration = /^[■▣◆★●▲▼【]/.test(raw);

    if (!isDisclaimer && !isNonGolfLine(clean) && !isPureNonCourse && !isNonCourseWord(clean) &&
        !/(?:기간|혜택|할인|인하|안내|공지|특가|운영|내장|그린피|예약|적용|조건|부제|중복|홀|캐디|회원(?!제)|비회원|안녕|반갑|감사|이벤트|프로모션|브런치|모닝박스|박스|샌드위치|베이커리|커피|식사|조식|식음|사은품|경품|패키지|진행|발송일|작성일|공지일|전송일)/i.test(clean)) {
        if (hasCourseSuffix) {
            if (clean.length >= 2 && clean.length <= 25) {
                return normalizeNoticeCourseName(clean);
            }
        } else if (hasHeaderDecoration) {
            if (clean.length >= 2 && clean.length <= 20) {
                return normalizeNoticeCourseName(clean);
            }
        } else if (isRecognizedGolfCourse(clean)) {
            // 접미사/기호가 없어도 매핑사전 또는 테이블에 등록된 공인 구장명인 경우만 허용
            return normalizeNoticeCourseName(clean);
        }
    }

    return null;
}

// 구장명 일치 판별 함수 (공백 및 특수문자 제거 후 상호 포함 여부 체크)
function isCourseMatch(noticeCourse, rowGolf, rowRawGolf, rowGolfmonGolf) {
    if (!noticeCourse) return true; // 구장명이 지정되지 않은 공지는 전체 구장 대상
    if (isNonCourseWord(noticeCourse)) return false; // 1부, 2부 등 비-구장 단어는 절대 매칭 금지

    // 홀수 표기((9홀), (9홀x2), (9홀*2), (18홀), (P9) 등) 제거 헬퍼
    const stripHoleInfo = (str) => String(str || '').replace(/\(?p?\d+\s*홀(?:\s*[x*]\s*\d+)?\)?|\(?p\d+\)?/gi, '');

    // 공지 구장명 표준화
    const stdNotice = normalizeNoticeCourseName(noticeCourse);
    const cleanNotice = stripHoleInfo(stdNotice).replace(/[\s\-_\[\]\(\)]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();
    if (!cleanNotice) return true;

    const noticeDigits = cleanNotice.match(/\d+/g)?.join('') || '';

    const rawTargets = [rowGolf, rowRawGolf, rowGolfmonGolf].filter(Boolean);
    const targets = rawTargets.map(g => {
        const stdG = normalizeNoticeCourseName(g);
        return stripHoleInfo(stdG).replace(/[\s\-_\[\]\(\)]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();
    });

    // ★ 클럽72 vs 클럽72(오션) 엄격 분리
    const noticeIsOcean = cleanNotice.includes('오션');
    for (const t of targets) {
        if (!t) continue;
        const targetIsOcean = t.includes('오션');
        if (cleanNotice.includes('클럽72') && t.includes('클럽72')) {
            if (noticeIsOcean !== targetIsOcean) return false;
            return true;
        }
    }

    return targets.some(t => {
        if (!t) return false;
        const cleanT = stripHoleInfo(t);
        const tDigits = cleanT.match(/\d+/g)?.join('') || '';

        // 숫자가 포함된 구장(알펜시아700, 클럽72, 루트52, 벨라45 등)의 경우 숫자 일치 필수 검사
        if (noticeDigits) {
            if (tDigits !== noticeDigits) return false;
        } else {
            // 공지 구장명에 숫자가 없는데(예: 알펜시아, 알펜시아회원제) 행 구장명에 숫자(예: 알펜시아700)가 있으면 매칭 방지
            if (tDigits && cleanNotice.length <= cleanT.length) {
                if (cleanNotice !== cleanT) return false;
            }
        }
        return cleanT.includes(cleanNotice) || cleanNotice.includes(cleanT);
    });
}

// 날짜가 주말(토/일)인지 주중(월~금)인지 판별하는 함수
function isDateWeekend(dateStr) {
    if (!dateStr) return false;
    const s = String(dateStr).trim();
    // 1. 문자열 내에 요일 한글이 직접 적혀있는 경우 (예: "11.4(화)", "11/8(토)")
    if (/토|일/.test(s)) return true;
    if (/월|화|수|목|금/.test(s)) return false;

    // 2. 숫자 월/일 파싱하여 실제 캘린더 요일 계산 (0: 일요일, 6: 토요일)
    const m = s.match(/(\d{1,2})[./\-](\d{1,2})/);
    if (m) {
        const month = parseInt(m[1], 10);
        const day = parseInt(m[2], 10);
        const now = new Date();
        let year = now.getFullYear();
        if (month < now.getMonth() + 1 && (now.getMonth() + 1 - month) > 6) {
            year += 1;
        }
        const d = new Date(year, month - 1, day);
        const dayOfWeek = d.getDay();
        return dayOfWeek === 0 || dayOfWeek === 6;
    }
    return false;
}

// 날짜 일치 판별 함수 (10.18 vs 10월 18일 vs 10.18(일), 주중/주말/전체 완벽 호환)
function isDateMatch(noticeDate, rowDate) {
    if (!noticeDate) return true; // 날짜가 지정되지 않은 공지는 전체 날짜 대상
    const str = String(noticeDate).trim();
    if (str === '전체' || str === '전체날짜' || str === '전체 날짜' || str === '별도공지전까지' || str === '별도공지시까지' || str === '상시' || str === '당분간') return true;

    // ★ [주중 / 주말 구분 지원]: 월-금이 주중, 토-일이 주말
    if (/주중|평일|월\s*[-~]\s*금/.test(str)) {
        return !isDateWeekend(rowDate);
    }
    if (/주말|휴일|토\s*[-~,/]\s*일|공휴일/.test(str)) {
        return isDateWeekend(rowDate);
    }

    if (str.includes('~') || (str.includes('-') && !/^\d{4}[./\-]\d{1,2}/.test(str))) {
        const dr = parseNoticeDateRange(str);
        if (dr) return isDateInRange(rowDate, dr);
    }
    if (str.includes(',')) {
        const parts = str.split(',').map(s => s.trim()).filter(Boolean);
        return parts.some(p => isDateMatch(p, rowDate));
    }
    const nMatch = str.match(/(\d{1,2})[./\-](\d{1,2})/);
    const rMatch = String(rowDate || '').match(/(\d{1,2})[./\-](\d{1,2})/);
    if (nMatch && rMatch) {
        return parseInt(nMatch[1], 10) === parseInt(rMatch[1], 10) &&
               parseInt(nMatch[2], 10) === parseInt(rMatch[2], 10);
    }
    const cleanNotice = str.replace(/[\s\-_/]/g, '.');
    const cleanRow = String(rowDate || '').trim().replace(/[\s\-_/]/g, '.');
    return cleanNotice === cleanRow;
}

// 시간대 기반 부제(1부, 2부, 3부) 자동 정확 판별 (시간과 명백히 모순되는 부제 오염 방지)
function resolvePartsForTime(startMins, endMins, fallbackParts = null) {
    const sM = startMins !== undefined ? startMins : 0;
    const eM = endMins !== undefined ? endMins : sM;
    const p1 = sM < 660; // 11:00 이전
    const p2 = (sM < 960 && eM >= 660); // 11:00 ~ 15:59
    const p3 = eM >= 960; // 16:00 이후

    if (fallbackParts && (fallbackParts.hasPart1 || fallbackParts.hasPart2 || fallbackParts.hasPart3)) {
        // fallbackParts가 해당 시간대와 양립 가능한지 검사 (예: 7시는 1부만 가능하므로 fallbackParts가 2부면 무시하고 1부 적용)
        const isCompatible = (p1 && fallbackParts.hasPart1) || (p2 && fallbackParts.hasPart2) || (p3 && fallbackParts.hasPart3);
        if (isCompatible) {
            return fallbackParts;
        }
    }
    return {
        hasPart1: p1,
        hasPart2: p2,
        hasPart3: p3,
        desc: [p1 ? '1부' : '', p2 ? '2부' : '', p3 ? '3부' : ''].filter(Boolean).join('+')
    };
}

// 캐디 / 노캐디(셀프) 타입 감지 헬퍼
function detectNoticeCaddyType(str) {
    if (!str) return null;
    const s = str.trim();
    if (/(?:노캐디|노\s*캐디|셀프|셀프타임|셀프\s*타임)/i.test(s)) {
        return 'nocaddy';
    }
    if (/(?:캐디타임|캐디\s*타임)/i.test(s)) {
        return 'caddy';
    }
    if (/(?:^|[^가-힣a-zA-Z0-9])캐디(?:[^가-힣a-zA-Z0-9피]|$)/i.test(s)) {
        return 'caddy';
    }
    return null;
}

// 블록 텍스트 내에서 구장명이 존재하는지 감지 (상단 또는 하단)
function findCourseInNoticeBlock(blockText) {
    if (!blockText) return null;
    const lines = blockText.split('\n');
    // 상단 10줄 이내 탐색
    for (let i = 0; i < Math.min(lines.length, 10); i++) {
        const l = lines[i].trim();
        if (!l) continue;
        const c = detectCourseInLine(l);
        if (c && !isNonCourseWord(c)) return c;
    }
    // 하단 10줄 이내 탐색
    for (let i = lines.length - 1; i >= Math.max(0, lines.length - 10); i--) {
        const l = lines[i].trim();
        if (!l) continue;
        if (/\d{1,2}\s*시대|\d{1,2}[:.]\d{2}|\d+\s*만(?:원)?/i.test(l)) continue;
        const c = detectCourseInLine(l);
        if (c && !isNonCourseWord(c)) return c;
    }
    return null;
}

// 복수의 서로 다른 공지 텍스트가 한 번에 붙여넣어졌을 때 개별 공지 블록으로 스마트 자동 분할
function splitMultiNoticeBlocks(text) {
    if (!text || !text.trim()) return [];

    const rawLines = text.split('\n');

    // 1. 명시적 번호 헤더 기반 분할 (예: "1.", "2.", "[1]", "(1)", "공지 1", "공지1", "공지사항 1")
    const numberedHeaders = [];
    for (let i = 0; i < rawLines.length; i++) {
        const line = rawLines[i].trim();
        if (/^(?:[1-9]\.|\([1-9]\)|\[[1-9]\]|공지\s*[1-9]|★\s*공지\s*[1-9]|공지사항\s*[1-9])\s*$/i.test(line) ||
            /^(?:[1-9]\.|\([1-9]\)|\[[1-9]\]|공지\s*[1-9])\s+[^\d]/i.test(line)) {
            numberedHeaders.push(i);
        }
    }

    if (numberedHeaders.length >= 2) {
        const blocks = [];
        for (let k = 0; k < numberedHeaders.length; k++) {
            const startIdx = numberedHeaders[k];
            const endIdx = (k + 1 < numberedHeaders.length) ? numberedHeaders[k + 1] : rawLines.length;
            const blockContent = rawLines.slice(startIdx, endIdx).join('\n').trim();
            if (blockContent) blocks.push(blockContent);
        }
        return blocks;
    }

    // 2. 번호가 없는 일반 복수 공지 분할
    const rawBlocks = [];
    let curLines = [];
    let curHasValidRuleLine = false;
    let curHasClosing = false; // 공지 마무리 문구(※ 연동가, 감사합니다, 취소규정 등 - 단순 구분선 ___ 제외)

    for (let i = 0; i < rawLines.length; i++) {
        const line = rawLines[i];
        const trimmed = line.trim();
        if (!trimmed) {
            curLines.push(line);
            continue;
        }

        // 라인 속성 분석
        // ※ 단순 밑줄/구분선(___, ---, ===)은 공지 내부 장식선이므로 맺음말로 취급하지 않음!
        const isClosingText = /(?:별도의\s*할인가|연동가로|홈페이지\s*연동|소진에\s*많은\s*관심|협조\s*부탁드립니다|감사합니다|기예약건\s*제외|취소\s*규정|취소\s*시|예약실|문의\s*전화|문의\s*:)/i.test(trimmed);
        
        // 날짜 헤더 여부 (단순 시간/금액이 아닌 날짜 라인)
        const isDateHeader = /^(?:✅|■|▣|▶|◆|★|●)?\s*\d{1,2}\s*[월./\-]\s*\d{1,2}(?:\s*일)?(?:\s*\([월화수목금토일]\))?/i.test(trimmed) &&
                             !/\d{1,2}\s*시대|\d{1,2}[:.]\d{2}|\d+\s*만/i.test(trimmed);

        // 구장명 헤더 여부 (시간이나 금액이 포함되지 않은 순수 구장명 라인)
        let isCourseLine = false;
        const detCourse = detectCourseInLine(trimmed);
        if (detCourse && !isNonCourseWord(detCourse) && !/\d{1,2}\s*시대|\d{1,2}[:.]\d{2}|\d+\s*만/i.test(trimmed)) {
            isCourseLine = true;
        }

        // 유효한 티타임 또는 금액 라인 여부 (단순 발송일/작성일 안내 제외)
        const isMetaDateLine = /(?:발송일|작성일|공지일|등록일|전송일|결제\s*금액)/i.test(trimmed);
        const hasRule = !isMetaDateLine && (/\d{1,2}\s*시대|\d{1,2}[:.]\d{2}|\d+\s*만(?:원)?|\b[123]부\b/i.test(trimmed));

        // 이전 블록에 이미 유효한 공지 규칙이 수집된 상태에서 분할 검사
        let shouldSplit = false;
        if (curHasValidRuleLine) {
            // (1) 이전 공지에서 진짜 맺음말(연동가, 감사합니다 등)이 나온 뒤에 새로운 날짜가 등장한 경우
            if (curHasClosing && isDateHeader) {
                shouldSplit = true;
            }
            // (2) 명시적인 새로운 구장명 헤더 라인이 등장한 경우 (예: [남양주CC], ■ 스프링베일GC 등)
            // 단, 현재 블록에 아직 구장명이 없다면 이 라인은 현재 블록의 하단 구장명이므로 쪼개지 않음!
            else if (isCourseLine) {
                const curCourse = findCourseInNoticeBlock(curLines.join('\n'));
                if (curCourse) {
                    shouldSplit = true;
                }
            }
        }

        if (shouldSplit && curLines.length > 0) {
            const bText = curLines.join('\n').trim();
            if (bText) rawBlocks.push(bText);
            curLines = [];
            curHasValidRuleLine = false;
            curHasClosing = false;
        }

        curLines.push(line);
        if (hasRule) curHasValidRuleLine = true;
        if (isClosingText) curHasClosing = true;
    }

    if (curLines.length > 0) {
        const bText = curLines.join('\n').trim();
        if (bText) rawBlocks.push(bText);
    }

    if (rawBlocks.length <= 1) return rawBlocks.length > 0 ? rawBlocks : [text];

    // 3. 구장명이 누락된 고아 블록 자동 병합 (어떤 공지 내부에서 쪼개진 경우 앞 블록과 합침)
    const mergedBlocks = [];
    for (const b of rawBlocks) {
        const course = findCourseInNoticeBlock(b);
        if (course || mergedBlocks.length === 0) {
            mergedBlocks.push(b);
        } else {
            // 구장명이 없으면 앞 블록의 후속 내용이므로 합침!
            mergedBlocks[mergedBlocks.length - 1] += '\n' + b;
        }
    }

    return mergedBlocks.length > 0 ? mergedBlocks : [text];
}

// 개별 공지 블록 내에서 구장명 위치(상단형 vs 하단형 서명형)를 감지하고,
// 하단에만 구장명이 있는 경우 블록 상단에 [구장명]을 안전하게 자동 보정
function normalizeNoticeBlockCourse(blockText) {
    if (!blockText || !blockText.trim()) return blockText;
    const lines = blockText.split('\n');

    // 1. 블록 상단(첫 10줄 이내)에서 구장명 탐색
    for (let i = 0; i < Math.min(lines.length, 10); i++) {
        const l = lines[i].trim();
        if (!l) continue;
        const c = detectCourseInLine(l);
        if (c && !isNonCourseWord(c)) {
            // 상단에 이미 구장명이 존재함 -> 그대로 반환
            return blockText;
        }
    }

    // 2. 상단에 구장명이 없으므로, 블록 하단(뒤쪽 10줄 이내)에서 구장명 탐색
    for (let i = lines.length - 1; i >= Math.max(0, lines.length - 10); i--) {
        const l = lines[i].trim();
        if (!l) continue;
        // 시간이나 금액이 섞이지 않은 순수 텍스트 라인
        if (/\d{1,2}\s*시대|\d{1,2}[:.]\d{2}|\d+\s*만(?:원)?/i.test(l)) {
            continue;
        }
        const c = detectCourseInLine(l);
        if (c && !isNonCourseWord(c)) {
            // 하단 구장명 감지 성공! (예: "양평tpc", "클럽72", "알펜시아" 등)
            // 블록 맨 앞에 [구장명]을 추가하여 상단 구장명 형태로 승격!
            return `[${c}]\n` + blockText;
        }
    }

    return blockText;
}

// 단일 공지 블록 파싱 (특정 시간대 지정형 + 기간/부제별 할인형 + 시대별/부제별 타겟 요금 + 동일적용 지시어 완벽 파싱)
function parseSingleNoticeBlock(text, fallbackDate = '', fallbackYear = null) {
    if (!text || !text.trim()) return [];
    // 그린피와 무관한 식음/브런치/모닝박스/이벤트 공지는 자동 제외
    if (isNonGreenFeeEventNotice(text)) return [];

    const rawLines = text.split('\n');
    const lines = [];
    for (const rawL of rawLines) {
        const l = rawL.trim();
        // 한 줄에 쉼표(,) 기준으로 여러 타임/금액이 나열된 경우 (예: "6시대 8.9만, 17시대 이후 7.9만", "2부 잔여: 9.9만, 3부 잔여: 7.9만")
        if (l.includes(',') && !l.includes('~') && !l.includes('http')) {
            const parts = l.split(',').map(s => s.trim()).filter(Boolean);
            const allHavePrice = parts.length > 1 && parts.every(p => /[0-9.,]+\s*(?:만|만원|원)/.test(p));
            if (allHavePrice) {
                lines.push(...parts);
                continue;
            }
        }
        lines.push(l);
    }
    const rules = [];
    const sameAsDirectives = [];

    // ★ 메시지 단위 단일 대표 구장명 사전 탐색 (카톡 공지는 메시지 하나당 한 구장씩 전달됨)
    let primaryCourse = '';
    for (let i = 0; i < lines.length; i++) {
        let l = lines[i].trim();
        if (!l) continue;
        l = l.replace(/^\[[^\]]+\]\s*\[(?:오전|오후)?\s*\d{1,2}:\d{2}\]\s*/, '').trim();
        if (!l) continue;
        const c = detectCourseInLine(l);
        if (c && !isNonCourseWord(c)) {
            primaryCourse = c;
            break;
        }
    }

    // 라인 전체로 감지되지 않은 경우, 라인 앞단 인라인 구장명/약어 탐색 (예: "클아 1935 -> 현장 8만")
    if (!primaryCourse) {
        for (let i = 0; i < lines.length; i++) {
            let l = lines[i].trim();
            if (!l) continue;
            l = l.replace(/^\[[^\]]+\]\s*\[(?:오전|오후)?\s*\d{1,2}:\d{2}\]\s*/, '').trim();
            const firstToken = l.split(/[\s\t:=>\-]+/)[0].trim().replace(/[\[\]\(\)\*#※■□▣◆◇▲▼▶▷◀◁●○★☆【】<>~_]/g, '');
            if (firstToken && firstToken.length >= 2) {
                if (typeof NOTICE_COURSE_SHORT_MAP !== 'undefined' && NOTICE_COURSE_SHORT_MAP[firstToken]) {
                    primaryCourse = NOTICE_COURSE_SHORT_MAP[firstToken];
                    break;
                }
                const c = detectCourseInLine(firstToken);
                if (c && !isNonCourseWord(c)) {
                    primaryCourse = c;
                    break;
                }
            }
        }
    }

    let currentCourse = primaryCourse;
    let currentDate = fallbackDate || '';
    let currentYear = fallbackYear || null;
    let currentDateRange = null;
    let currentDateDesc = '';
    let pendingDiscount = null;
    let pendingParts = null;
    let pendingPrice = null; // 헤더 금액 선언(예: 셀프타임(7.9만), 캐디타임(10.9만), 서남서(13만)) 보관 변수
    let pendingCaddyType = null; // 헤더 캐디/노캐디 선언('caddy' | 'nocaddy' | null) 보관 변수
    let pendingIsMeal = false;
    let pendingMealParts = null;
    const blockHasMeal = /(?:식사\s*포함|조식\s*포함|중식\s*포함|석식\s*포함|식사\s*제공|조식\s*제공|식음\s*제공|모닝박스\s*(?:포함|제공)?|모닝식사|식포\b)/i.test(text) && !/(?:식사\s*불가|식사\s*미포함|식사\s*별도)/i.test(text);
    let lastTargetPrice = null; // 직전 줄에서 매칭된 타겟 금액 (예: "19시대 → 현장 11만" 후 "잔여 1907 1914..." 에 11만 계승용)

    function pushTargetRule(r) {
        if (r.price !== null && r.price !== undefined) {
            lastTargetPrice = r.price;
        }
        rules.push(r);
    }

    // 공지 상단(첫 5개 라인)에 명시된 대표 날짜 사전 탐색 (예: "♣오늘♣ 11/11(수) 3부 재공지", "11/12(목) 공지")
    for (let idx = 0; idx < Math.min(5, lines.length); idx++) {
        const lClean = lines[idx].trim().replace(/^\[[^\]]+\]\s*\[(?:오전|오후)?\s*\d{1,2}:\d{2}\]\s*/, '').trim();
        if (!lClean || lClean.includes(':') || /[0-9.,]+\s*(?:만|만원|원)/.test(lClean)) continue;
        const dDet = parseNoticeDateDetail(lClean);
        if (dDet) {
            currentDate = dDet.dateStr;
            currentYear = dDet.year;
            break;
        }
    }

    // 공지 전체에 명시적 날짜 헤더가 없고 "당일" 또는 "오늘"이 포함되어 있으면 오늘 날짜를 기본값으로 사용
    if (!currentDate && /(?:^|[^\w가-힣])(?:당일|오늘)(?:$|[^\w가-힣])/i.test(text) && !/\d{1,2}\s*[./월\-]\s*\d{1,2}/.test(text)) {
        const now = new Date();
        currentDate = `${now.getMonth() + 1}.${now.getDate()}`;
        currentYear = now.getFullYear();
    }

    function flushPendingDiscount() {
        if (pendingDiscount !== null && pendingDiscount > 0) {
            rules.push({
                type: 'discount',
                course: currentCourse,
                date: currentDate,
                year: currentYear,
                dateRange: currentDateRange,
                discount: pendingDiscount,
                parts: pendingParts,
                rawLine: `${currentCourse} ${currentDateRange ? currentDateRange.text : (currentDate || '')} 추가 ${pendingDiscount}만 할인 ${pendingParts ? pendingParts.desc : ''}`.trim()
            });
            pendingDiscount = null;
            pendingParts = null;
        }
    }

    for (let i = 0; i < lines.length; i++) {
        let line = lines[i].trim();
        if (!line) continue;

        // 카톡 송신자/시간 헤더 제거 (예: "[골프락 안현희대리] [오후 1:52] ▣ 스프링베일GC ▣")
        line = line.replace(/^\[[^\]]+\]\s*\[(?:오전|오후)?\s*\d{1,2}:\d{2}\]\s*/, '').trim();
        if (!line) continue;

        // 0. 카톡 헤더 및 발송일/작성일 스킵
        if (/^(?:-?\s*발송일|-?\s*작성일|-?\s*공지일|-?\s*등록일|-?\s*전송일)\s*[:=]/i.test(line) ||
            /^(?:-?\s*발송일|-?\s*작성일|-?\s*공지일|-?\s*등록일|-?\s*전송일)\s*:\s*\d{1,2}[./\-]\d{1,2}/i.test(line)) {
            continue;
        }

        // 0-1. 공지 안내문 / 특가 안내 헤더 스킵 (예: "잔여타임 특가", "- 잔여 타임 특가 요금 변경 안내 -", "판매 요금 변경 부탁드립니다.")
        if (/(?:잔여\s*타임\s*특가|특가\s*요금\s*변경\s*안내|판매\s*요금\s*변경|홈페이지와\s*별도|기예약건|중복할인불가|적용부탁드립니다)/i.test(line)) {
            continue;
        }

        // 0-2. 요금 변경 없음/제외 라인 스킵 (예: "(8시대, 11시대 요금 변경x)", "요금 변경없음", "적용 제외")
        if (/(?:변경\s*[xX없]|요금\s*변경\s*[xX없]|적용\s*제외|할인\s*제외|기존\s*요금\s*유지)/i.test(line)) {
            continue;
        }

        // 0-3. 동일 적용 지시어 감지 (예: "(14시타임은 13시대와 동일적용)", "14시대는 13시대와 동일", "14시타임 13시대 동일")
        const sameAsMatch = line.match(/(?:^|[(\s])((?:\d{1,2}\s*(?:시|시대|시타임)?\s*[,/& 및~]\s*)*\d{1,2})\s*시(?:대|타임)?(?:은|는)?\s*(\d{1,2})\s*시(?:대|타임)?(?:와|과)?\s*동일/i);
        if (sameAsMatch) {
            const targetRaw = sameAsMatch[1];
            const sourceHour = parseInt(sameAsMatch[2], 10);
            const targetHours = (targetRaw.match(/\d{1,2}/g) || []).map(n => parseInt(n, 10));
            if (targetHours.length > 0 && !isNaN(sourceHour)) {
                targetHours.forEach(th => {
                    sameAsDirectives.push({
                        targetHour: th,
                        sourceHour: sourceHour,
                        course: currentCourse,
                        date: currentDate,
                        year: currentYear,
                        dateRange: currentDateRange,
                        rawLine: line
                    });
                });
            }
            continue;
        }

        // 1. 구장명 라인 감지 (예: "■  알펜시아700골프클럽", "▣ 스프링베일GC ▣", "🔹 올데이", "🔹 옥스필드", "🔹 임페리얼", "🔹 떼제베", "서남서(13만)", "동북동(11만)")
        const detectedCourse = detectCourseInLine(line);
        if (detectedCourse && !isNonCourseWord(detectedCourse)) {
            currentCourse = detectedCourse;
            pendingCaddyType = null;
            if (!primaryCourse) {
                primaryCourse = detectedCourse;
            }

            // ★ [핵심] 한 라인에 구장명과 날짜가 함께 있는 경우(예: "■ 11/02 (월)오션", "♣내일♣오션♣11/2(월)♣", "11/2 오션")
            // 같은 라인에 포함된 날짜도 currentDate 및 currentYear로 즉시 세팅!
            const lineDateDetail = parseNoticeDateDetail(line);
            if (lineDateDetail) {
                flushPendingDiscount();
                currentDate = lineDateDetail.dateStr;
                currentYear = lineDateDetail.year;
                currentDateRange = null;
                pendingParts = null;
            }

            // 구장명 뒤에 인라인 헤더 금액이 있는지 검사 (예: "서남서(13만)", "동북동(11만)", "올데이 (10만)")
            const inlineCoursePriceMatch = line.match(/(?:[:=\-→▶⇒~]|->)?\s*[(\[]\s*([0-9.]+)\s*(?:만|만원|원)?\s*[)\]]/i) ||
                                           line.match(/\s+([0-9.]+)\s*(?:만|만원|원)/i);
            if (inlineCoursePriceMatch) {
                const pv = normalizeNoticePrice(inlineCoursePriceMatch[1]);
                if (pv !== null) {
                    pendingPrice = pv;
                } else {
                    pendingPrice = null;
                }
            } else {
                pendingPrice = null;
            }
            continue;
        }

        // 2. 기간 범위 라인 감지 (예: "★10/19(월) ~ 10/22(목)★", "기간: 10/18(일) ~ 10/22(목) [5일간]", "11/16~11/19 는 0600~06:27 5만")
        const parsedRange = parseNoticeDateRange(line);
        if (parsedRange) {
            flushPendingDiscount();
            currentDateRange = parsedRange;
            currentDate = parsedRange.text;
            currentDateDesc = parsedRange.text;
            currentYear = parsedRange.startYear || null;
            pendingParts = null;
            pendingCaddyType = null;

            // 라인 뒤쪽에 인라인 가격이나 시간이 함께 있는 경우 (예: "11/16~11/19 는 0600~06:27 5만")
            const afterRange = line.replace(parsedRange.rawMatch || '', '').replace(/^[은는:\-=\s]+/, '').trim();
            const hasRestContent = afterRange && (/\d{1,2}:\d{2}|\d{1,2}\s*시|[123]부|\b[012]\d[0-5]\d\b|[0-9.,]+\s*(?:만|만원|원)/.test(afterRange));
            if (hasRestContent) {
                line = afterRange;
            } else {
                continue;
            }
        }

        // 2-1. '별도 공지전까지' / '상시' / '당분간' 기간 감지 (예: "별도 공지전까지", "별도 공지시까지", "추후 공지시까지")
        if (/(?:별도\s*공지\s*(?:전까지|시까지|까지|시)?|추후\s*공지\s*(?:전까지|시까지|까지|시)?|별도\s*안내\s*(?:전까지|시까지|까지|시)?|상시\s*적용|상시|당분간)/i.test(line)) {
            flushPendingDiscount();
            currentDate = '전체';
            currentDateRange = null;
            currentDateDesc = '별도공지전까지';
            pendingParts = null;
            pendingCaddyType = null;
            continue;
        }

        // 2-2. 주중 / 주말 / 전체 헤더 라인 감지 (예: "[주중]", "주중 요금", "[주말]", "주말 특가", "전체")
        if (/^(?:[-*•▶▷□■▣★☆◆◇▲▼\s])*([(\[<【]?(?:주중|평일|주말|휴일|공휴일|월\s*[-~]\s*금|토\s*[-~,/]\s*일|전체)[)\]>】]?)(?:[가-힣\s]*)$/i.test(line) && !line.includes(':') && !/\d{1,2}\s*시대/.test(line)) {
            flushPendingDiscount();
            if (/주중|평일|월\s*[-~]\s*금/.test(line)) {
                currentDate = '주중';
            } else if (/주말|휴일|공휴일|토\s*[-~,/]\s*일/.test(line)) {
                currentDate = '주말';
            } else if (/전체/.test(line)) {
                currentDate = '전체';
            }
            currentDateRange = null;
            pendingParts = null;
            pendingCaddyType = null;
            continue;
        }

        // 3. 단일 날짜 헤더 라인 확인 (예: "10/18(일)", "▣ 10월18일(일) ▣", "10.18", "10/18", "2026.10.18", "22화", "22일(화)", "♣오늘♣ 11/11(수) 3부 재공지")
        const fallbackM = currentDate ? parseInt(currentDate.split('.')[0], 10) : null;
        const parsedDateDetail = parseNoticeDateDetail(line, fallbackM);
        if (parsedDateDetail && !line.includes(':') && !/\d{1,2}\s*시대?/.test(line) && !/[0-9.,]+\s*(?:만|만원|원)/.test(line)) {
            flushPendingDiscount();
            currentDate = parsedDateDetail.dateStr;
            currentYear = parsedDateDetail.year;
            currentDateRange = null;
            // 라인에 부제(예: "3부", "1부", "2부", "전타임")가 함께 기재되어 있으면 pendingParts도 함께 설정
            const lineParts = parseNoticeParts(line);
            if (lineParts) {
                pendingParts = lineParts;
            } else {
                pendingParts = null;
            }
            pendingCaddyType = null;
            continue;
        }

        // 3-1. 인라인 날짜 접두어 감지 (예: "11/10 11:28/13:13 11만원", "11/13 8:10 8만원 12:45 13만원", "11.10(화) 1부 6시대 5.9만")
        // ※ "11-12시대", "6-7시대" 등 연속 시간대 범위(시/시대)는 인라인 날짜가 아니므로 원천 배제!
        const isMultiHourLine = /^[-*•▶▷□■▣★☆◆◇▲▼✅●\s]*\d{1,2}\s*(?:시대|시\s*대|시타임|시)?\s*[-~]\s*\d{1,2}\s*(?:시대|시\s*대|시타임|시)/i.test(line);
        const inlineDatePrefixMatch = !isMultiHourLine ? line.match(
            /^(?:[-*•▶▷□■▣★☆◆◇▲▼✅●]\s*)*((?:(?:\d{4}|\d{2})\s*(?:년|[./\-])\s*)?\d{1,2}\s*(?:월\s*\d{1,2}(?!\d)\s*일?|[./\-]\s*\d{1,2}(?!\d)(?!\s*(?:시대|시\s*대|시타임|시\b|분\b|만|만원|원|부)))(?:\s*일)?(?:\s*(?:\([월화수목금토일]\)|[월화수목금토일]요일|[월화수목금토일](?=\s)))?)\s*(?:[:=\-→▶⇒]\s*)?(.+)$/
        ) : null;
        if (inlineDatePrefixMatch) {
            const dateTokenStr = inlineDatePrefixMatch[1].trim();
            const restAfterDate = inlineDatePrefixMatch[2].trim();
            const inlineDateDetail = parseNoticeDateDetail(dateTokenStr, fallbackM);
            if (inlineDateDetail && restAfterDate && (/\d{1,2}:\d{2}|\d{1,2}\s*시|[123]부|전부|전타임|첫\s*(?:팀|티)|막\s*(?:팀|티)|\b[012]\d[0-5]\d\b|[0-9.,]+\s*(?:만|만원|원)/.test(restAfterDate))) {
                flushPendingDiscount();
                currentDate = inlineDateDetail.dateStr;
                currentYear = inlineDateDetail.year;
                currentDateRange = null;
                pendingParts = null;
                pendingCaddyType = null;
                line = restAfterDate;
            }
        }

        // 4. 일반 안내문 / 주의사항 / 비-골프 라인 스킵 (구장/날짜/기간 파싱 후 안전하게 스킵)
        // 단, 식사포함/조식제공 라인은 절대 스킵하지 않음
        const isMealInLine = /(?:식사\s*포함|조식\s*포함|중식\s*포함|석식\s*포함|식사\s*제공|조식\s*제공|식음\s*제공|모닝식사|식포\b)/i.test(line) && !/(?:식사\s*불가|식사\s*미포함|식사\s*별도)/i.test(line);
        if (!isMealInLine && (isNonGolfLine(line) || line.startsWith('※') || line.startsWith('#'))) {
            continue;
        }

        // 4-1. 단독 식사포함/조식제공 공지 라인 감지 (예: "1부 전타임 식사포함", "1부 식사제공", "전타임 식사포함", "식사포함")
        // 부제(1부, 2부, 3부)나 시간대 숫자가 그린피 금액으로 오인되지 않도록 부제/시간 제거 후 금액 여부 검사
        const lineWithoutPartsAndTime = line.replace(/[123]부|\d{1,2}\s*시대?|\d{1,2}:\d{2}/g, ' ');
        const hasPriceInLine = /[0-9.,]+\s*(?:만|만원|원)/.test(lineWithoutPartsAndTime) || Boolean(normalizeNoticePrice(lineWithoutPartsAndTime));
        if (isMealInLine && !hasPriceInLine) {
            const pObj = parseNoticeParts(line) || pendingParts;
            let startMins = 0;
            let endMins = 1439;
            let timeDesc = '전타임';

            if (pObj) {
                if (pObj.hasPart1 && !pObj.hasPart2 && !pObj.hasPart3) {
                    startMins = 0; endMins = 659; timeDesc = '1부 전타임';
                } else if (!pObj.hasPart1 && pObj.hasPart2 && !pObj.hasPart3) {
                    startMins = 660; endMins = 959; timeDesc = '2부 전타임';
                } else if (!pObj.hasPart1 && !pObj.hasPart2 && pObj.hasPart3) {
                    startMins = 960; endMins = 1439; timeDesc = '3부 전타임';
                } else {
                    timeDesc = `${pObj.desc} 전타임`;
                }
            } else if (/1부/.test(line)) {
                startMins = 0; endMins = 659; timeDesc = '1부 전타임';
            } else if (/2부/.test(line)) {
                startMins = 660; endMins = 959; timeDesc = '2부 전타임';
            } else if (/3부/.test(line)) {
                startMins = 960; endMins = 1439; timeDesc = '3부 전타임';
            }

            const autoMealParts = pObj || pendingParts || (
                /1부/.test(line) ? { hasPart1: true, hasPart2: false, hasPart3: false, desc: '1부' } :
                (/2부/.test(line) ? { hasPart1: false, hasPart2: true, hasPart3: false, desc: '2부' } :
                (/3부/.test(line) ? { hasPart1: false, hasPart2: false, hasPart3: true, desc: '3부' } : null))
            );

            pendingIsMeal = true;
            pendingMealParts = autoMealParts;
            rules.push({
                type: 'meal',
                course: currentCourse,
                date: (currentDateDesc === '별도공지전까지' || !currentDate || currentDate === '전체') ? '전체' : currentDate,
                year: currentYear,
                dateRange: currentDateRange,
                dateDesc: currentDateDesc || (currentDate === '전체' ? '별도공지전까지' : ''),
                startMins: startMins,
                endMins: endMins,
                timeText: timeDesc,
                isMeal: true,
                parts: autoMealParts,
                caddyType: detectNoticeCaddyType(line) || pendingCaddyType || null,
                rawLine: line
            });
            continue;
        }

        // 5. 할인 금액 감지 (예: "혜택: 잔여타임 추가 2만 할인", "2만원 할인")
        const discountVal = parseNoticeDiscount(line);
        if (discountVal !== null) {
            pendingDiscount = discountVal;
            const inlineParts = parseNoticeParts(line);
            if (inlineParts) pendingParts = inlineParts;
            continue;
        }

        // 5-1. 한 줄에 복수의 (시간/부제 + 금액) 세트가 나열된 경우 개별 라인으로 분할하여 순차 처리
        // (예: "8:10 8만원  12:45 13만원", "8:10/8:20 8만원 12:45 13만원", "1부 8만원 2부 11만원")
        if (!line.includes('동일')) {
            const multiClauseSplitRegex = /((?:\d{1,2}:\d{2}|\d{1,2}\s*시(?:대|타임|\d|\s)?|[123]부|전부|전타임|\b[012]\d[0-5]\d\b).*?[0-9.,]+\s*(?:만|만원|원)(?:\s*\/\s*[0-9.,]+\s*(?:만|만원|원)?)?)\s+(?=(?:[-*•▶▷□■▣★☆◆◇▲▼,/]\s*)?(?:[가-힣a-zA-Z]+\s+)?(?:\d{1,2}:\d{2}|\d{1,2}\s*시(?:대|타임|\d|\s)|[123]부|전부|전타임|\b[012]\d[0-5]\d\b).*?[0-9.,]+\s*(?:만|만원|원))/i;
            const clauseMatch = line.match(multiClauseSplitRegex);
            if (clauseMatch) {
                const splitIdx = clauseMatch.index + clauseMatch[1].length;
                const firstClause = line.slice(0, splitIdx).trim();
                const remainingClauses = line.slice(splitIdx).replace(/^[\s,/]+/, '').trim();
                if (firstClause && remainingClauses) {
                    lines.splice(i + 1, 0, remainingClauses);
                    line = firstClause;
                }
            }
        }

        // 6. 부제 접두어 또는 단독 부제 라인 검사 (예: "1부 : 6시대: 8만", "3부 : 7만", "[1부+2부]", "1부 잔여시간 : 현장 17만")
        const partPrefixMatch = line.match(/^[-*•▶▷□■▣★☆◆◇▲▼\s]*([123]부|전부|전타임)(?:\s*(?:잔여\s*(?:타임|시간|티)?|전체))?\s*[:=\-→▶⇒~]?\s*(.*)$/);
        if (partPrefixMatch) {
            const partName = partPrefixMatch[1];
            let rest = partPrefixMatch[2].trim();
            const pObj = parseNoticeParts(partName);
            if (pObj) pendingParts = pObj;

            const partCaddy = detectNoticeCaddyType(partName) || detectNoticeCaddyType(rest);
            if (partCaddy) {
                pendingCaddyType = partCaddy;
            } else {
                pendingCaddyType = null;
            }

            if (!rest) {
                // "1부 :" 단독 라인
                continue;
            }

            // 앞단 구분자 기호 정리 (예: ": 현장 17만" -> "현장 17만")
            rest = rest.replace(/^[:=\-→▶⇒~]\s*/, '').trim();

            // rest 에 구체적인 시각(\d{1,2}:\d{2} 또는 \d{1,2}시)이 없고 금액만 있는 경우 -> 해당 부제 전체 고정 타겟 요금 (예: "3부 : 7만", "1부 잔여시간 : 현장 17만", "2부 잔여타임 10만")
            if (!/\d{1,2}:\d{2}/.test(rest) && !/\d{1,2}\s*시대?/.test(rest)) {
                const priceVal = normalizeNoticePrice(rest);
                if (priceVal !== null) {
                    let startMins = 0;
                    let endMins = 1439;
                    let targetPartDesc = partName;
                    if (partName === '1부') { startMins = 0; endMins = 659; }
                    else if (partName === '2부') { startMins = 660; endMins = 959; }
                    else if (partName === '3부') { startMins = 960; endMins = 1439; }
                    else if (pendingParts) {
                        if (pendingParts.hasPart1 && !pendingParts.hasPart2 && !pendingParts.hasPart3) { startMins = 0; endMins = 659; targetPartDesc = '1부'; }
                        else if (!pendingParts.hasPart1 && pendingParts.hasPart2 && !pendingParts.hasPart3) { startMins = 660; endMins = 959; targetPartDesc = '2부'; }
                        else if (!pendingParts.hasPart1 && !pendingParts.hasPart2 && pendingParts.hasPart3) { startMins = 960; endMins = 1439; targetPartDesc = '3부'; }
                    }

                    const slashM = rest.match(/([0-9.,]+)\s*(?:만|만원|원)?\s*\/\s*([0-9.,]+)\s*(?:만|만원|원)?/);
                    const slashBackVal = slashM && slashM[2] ? normalizeNoticePrice(slashM[2]) : null;

                    rules.push({
                        type: 'target',
                        course: currentCourse,
                        date: currentDate,
                        year: currentYear,
                        dateRange: currentDateRange,
                        startMins: startMins,
                        endMins: endMins,
                        timeText: `${targetPartDesc} 전체`,
                        price: priceVal,
                        slashBackPrice: slashBackVal,
                        caddyType: pendingCaddyType || null,
                        parts: pObj || pendingParts,
                        isMeal: Boolean(pendingIsMeal || isMealInLine || (blockHasMeal && (targetPartDesc === '1부' || !targetPartDesc))),
                        rawLine: line
                    });
                    pendingParts = null;
                    continue;
                }
            } else {
                // "1부 :  6시대: 8만" 처럼 부제 접두어 뒤에 시간대 요금이 이어지는 경우 -> rest 를 line 으로 재지정하여 아래 시간대 파서로 진입!
                line = rest;
            }
        }

        // 6-1. 세부 코스명 및 헤더 요금 감지 (예: "서남서(13만)", "동북동(11만)", "서남(13만)", "동북(11만)")
        const subCourseMatch = line.match(/^[-*•▶▷□■▣★☆◆◇▲▼\s]*(서남서|서남|동북동|동북)\s*(?:\(?\s*([0-9.]+)\s*(?:만|만원|원)?\s*\)?)?/i);
        if (subCourseMatch) {
            const scName = subCourseMatch[1];
            if (scName.includes('서남')) {
                currentCourse = '떼제베(서남)';
            } else if (scName.includes('동북')) {
                currentCourse = '떼제베(동북)';
            }
            pendingCaddyType = null;
            if (subCourseMatch[2]) {
                const pv = normalizeNoticePrice(subCourseMatch[2]);
                if (pv !== null) pendingPrice = pv;
            }
            continue;
        }

        // 6-2. 단독 옵션 헤더 요금 감지 (예: "셀프타임(7.9만)", "캐디타임(10.9만)", "셀프(7.9만)", "(7.9만)", "[8.9만]")
        // (단, 시각 HH:MM 이 포함되어 있지 않은 단독 요금 헤더 라인)
        if (!line.match(/\d{1,2}:\d{2}/)) {
            const optCaddy = detectNoticeCaddyType(line);
            if (optCaddy) pendingCaddyType = optCaddy;

            const headerPriceMatch = line.match(/(?:셀프타임|캐디타임|셀프|캐디|노캐디|현장|특가|그린피)?\s*[(\[]\s*([0-9.]+)\s*(?:만|만원|원)?\s*[)\]]/i) ||
                                     line.match(/^(?:셀프타임|캐디타임|셀프|캐디|노캐디)\s*[:=\-]?\s*([0-9.]+)\s*(?:만|만원|원)?$/i);
            if (headerPriceMatch) {
                const pv = normalizeNoticePrice(headerPriceMatch[1]);
                if (pv !== null) {
                    pendingPrice = pv;
                    continue;
                }
            }
            // 금액 없는 단독 "셀프타임", "캐디타임" 라인 스킵
            if (optCaddy && /^(?:셀프타임|노캐디타임|셀프|노캐디|캐디타임|캐디)$/i.test(line.replace(/[-*•▶▷□■▣★☆◆◇▲▼\s]/g, ''))) {
                continue;
            }
        }

        // 현재 라인의 캐디 구분 (라인 인라인 우선, 없으면 헤더 pending 상속)
        const lineCaddyType = detectNoticeCaddyType(line) || pendingCaddyType || null;

        // 6-3. 복수/단일 시간 나열 및 인라인 금액 라인 (예: "셀프타임(4만) 17:18,25,32...", "11:24, 11:45...", "셀프타임(6.9만) 17:32, 18:00,07,21,35", "17:54, 18:01,08,15,22", "캐디타임 17:18")
        if (line.match(/\d{1,2}:\d{2}/) && (line.includes(',') || pendingPrice !== null || /^(?:셀프타임|캐디타임|셀프|캐디|노캐디)/i.test(line) || /[(\[]\s*[0-9.]+\s*(?:만|만원|원)?\s*[)\]]/.test(line))) {
            let linePrice = pendingPrice;
            let timePartStr = line;

            // A. 라인 앞단에 금액이 있는 경우 (예: "셀프타임(4만) 17:18...", "셀프타임(6.9만) 17:32...", "캐디타임(10.9만) 12:27...", "(4만) 17:18...", "셀프타임 4만 17:18...")
            const leadingPriceMatch = timePartStr.match(/^[-*•▶▷□■▣★☆◆◇▲▼\s]*(?:셀프타임|캐디타임|셀프|캐디|노캐디)?\s*[(\[]\s*([0-9.]+)\s*(?:만|만원|원)?\s*[)\]]\s*[:=\-→▶⇒~]?\s*(.*)$/i) ||
                                      timePartStr.match(/^[-*•▶▷□■▣★☆◆◇▲▼\s]*(?:셀프타임|캐디타임|셀프|캐디|노캐디)\s*[:=\-]?\s*([0-9.]+)\s*(?:만|만원|원)\s*[:=\-→▶⇒~]?\s*(.*)$/i);

            if (leadingPriceMatch) {
                const lp = normalizeNoticePrice(leadingPriceMatch[1]);
                if (lp !== null) linePrice = lp;
                timePartStr = leadingPriceMatch[2] || '';
            } else {
                // B. 라인 뒷단에 금액이 있는 경우 (화살표, 괄호, 또는 반드시 단위(만/원)가 있는 경우만 안전하게 매칭)
                const trailingPriceMatch = timePartStr.match(/(?:->|=>|→|▶|⇒)\s*(?:현장|특가|그린피)?\s*[(\[]?\s*([0-9.]+)\s*(?:만|만원|원)?\s*[)\]]?\s*$/i) ||
                                           timePartStr.match(/[(\[]\s*([0-9.]+)\s*(?:만|만원|원)?\s*[)\]]\s*$/i) ||
                                           timePartStr.match(/(?:\s+|[:=~-])\s*(?:현장|특가|그린피)?\s*([0-9.]+)\s*(?:만|만원|원)\s*$/i);
                if (trailingPriceMatch && trailingPriceMatch[1] && (timePartStr.includes(',') || pendingPrice !== null)) {
                    const tp = normalizeNoticePrice(trailingPriceMatch[1]);
                    if (tp !== null) {
                        linePrice = tp;
                        timePartStr = timePartStr.slice(0, trailingPriceMatch.index);
                    }
                }
            }

            // 접미어 및 접두어 정리 (노캐디, 셀프, 캐디 등 옵션 키워드 및 대시/콜론 제거)
            timePartStr = timePartStr
                .replace(/[-*•▶▷□■▣★☆◆◇▲▼\s]*(?:셀프타임|노캐디타임|캐디타임|셀프|노캐디|캐디|현장|특가|그린피|선결제|선입금)[\s:=~-]*$/i, '')
                .replace(/[-=~:>]+$/, '')
                .replace(/^[-*•▶▷□■▣★☆◆◇▲▼\s]*(?:셀프타임|캐디타임|셀프|캐디|노캐디)\s*[:=\-]?\s*/i, '')
                .trim();

            if (linePrice !== null && /\d{1,2}:\d{2}/.test(timePartStr)) {
                const timeTokens = timePartStr.split(/[\s,+/~]+/);
                let curH = null;
                const parsedTimes = [];
                for (const tok of timeTokens) {
                    const t = tok.trim().replace(/[()\[\]]/g, '');
                    if (!t) continue;
                    const hhmm = t.match(/^(\d{1,2}):(\d{2})/);
                    if (hhmm) {
                        curH = parseInt(hhmm[1], 10);
                        const m = parseInt(hhmm[2], 10);
                        if (curH >= 0 && curH <= 23 && m >= 0 && m < 60) {
                            parsedTimes.push({ h: curH, m: m, tMins: curH * 60 + m });
                        }
                    } else if (curH !== null) {
                        const minMatch = t.match(/^(\d{2})/);
                        if (minMatch) {
                            const m = parseInt(minMatch[1], 10);
                            if (m >= 0 && m < 60) {
                                parsedTimes.push({ h: curH, m: m, tMins: curH * 60 + m });
                            }
                        }
                    }
                }

                if (parsedTimes.length > 0) {
                    for (const pt of parsedTimes) {
                        const timeDesc = `${String(pt.h).padStart(2, '0')}:${String(pt.m).padStart(2, '0')}`;
                        const autoParts = resolvePartsForTime(pt.tMins, pt.tMins, pendingParts);
                        rules.push({
                            type: 'target',
                            course: currentCourse,
                            date: currentDate,
                            year: currentYear,
                            dateRange: currentDateRange,
                            startMins: pt.tMins,
                            endMins: pt.tMins,
                            timeText: timeDesc,
                            price: linePrice,
                            slashBackPrice: null,
                            caddyType: lineCaddyType || null,
                            parts: autoParts,
                            isMeal: Boolean(pendingIsMeal || isMealInLine || (blockHasMeal && pt.tMins < 660)),
                            rawLine: `${timeDesc} ${linePrice}만`
                        });
                    }
                    continue;
                }
            }
        }

        // 7. 다중 시대 / 연속 시대 범위 동일 요금 패턴 (예: "17-18시대 →  현장 7만★", "6시대, 7시대: 8만", "6시~7시대 6만", "6~8시대 7만", "17-18시 7만")
        // ※ 주의: 라인에 콜론 분(:MM)이 포함된 구체적 시각 범위(예: 8시~8:13, 12시~12:31)는 10-1번 rangeMatch에서 처리해야 하므로 건너뜀!
        const hourSep = '(?:\\s*[,/&~\\-]\\s*|\\s+(?:및|와|과)\\s+)';
        const multiHourRegex = new RegExp('^[-*•▶▷□■▣★☆◆◇▲▼\\s]*((?:\\d{1,2}\\s*(?:시대|시\\s*대|시타임|시)?' + hourSep + ')+\\d{1,2})\\s*(?:시대|시\\s*대|시타임|시)?\\s*(?:[:=\\-→▶⇒~]|->)?\\s*(?:현장|특가|그린피)?\\s*([0-9.,]+)\\s*(?:만|만원|원)?(?:\\s*\\/\\s*([0-9.,]+)\\s*(?:만|만원|원)?)?', 'i');
        const multiHourMatch = (!/\d{1,2}:\d{2}/.test(line) && !/\d{1,2}\s*분/.test(line)) ? line.match(multiHourRegex) : null;
        if (multiHourMatch) {
            const hourPartStr = multiHourMatch[1];
            const priceVal = normalizeNoticePrice(multiHourMatch[2]);
            const slashBackVal = multiHourMatch[3] ? normalizeNoticePrice(multiHourMatch[3]) : null;
            if (priceVal !== null) {
                const hours = [];
                // "6~8" 또는 "6시~7시대" 또는 "17-18" 형태의 연속 범위인지 확인
                const rangeHMatch = hourPartStr.match(/(\d{1,2})\s*(?:시대|시\s*대|시타임|시)?\s*[~\\-]\s*(\d{1,2})/);
                if (rangeHMatch && !hourPartStr.includes(',')) {
                    let startH = parseInt(rangeHMatch[1], 10);
                    let endH = parseInt(rangeHMatch[2], 10);
                    if (startH >= 1 && startH <= 4) startH += 12;
                    if (endH >= 1 && endH <= 4) endH += 12;
                    if (!isNaN(startH) && !isNaN(endH) && startH <= endH && startH >= 0 && endH <= 23) {
                        const sMins = startH * 60;
                        const eMins = endH * 60 + 59;
                        const autoParts = resolvePartsForTime(sMins, eMins, pendingParts);
                        const timeDesc = `${String(startH).padStart(2, '0')}:00~${String(endH).padStart(2, '0')}:59`;
                        rules.push({
                            type: 'target',
                            course: currentCourse,
                            date: currentDate,
                            year: currentYear,
                            dateRange: currentDateRange,
                            startMins: sMins,
                            endMins: eMins,
                            timeText: timeDesc,
                            price: priceVal,
                            slashBackPrice: slashBackVal,
                            caddyType: lineCaddyType || null,
                            parts: autoParts,
                            isMeal: Boolean(pendingIsMeal || isMealInLine || (blockHasMeal && sMins < 660)),
                            rawLine: line
                        });
                        continue;
                    }
                }
                if (hours.length === 0) {
                    const nums = (hourPartStr.match(/\d{1,2}/g) || []).map(n => {
                        let v = parseInt(n, 10);
                        if (v >= 1 && v <= 4) v += 12;
                        return v;
                    });
                    nums.forEach(n => {
                        if (n >= 0 && n <= 23 && !hours.includes(n)) hours.push(n);
                    });
                }

                if (hours.length > 0) {
                    hours.forEach(h => {
                        const autoParts = resolvePartsForTime(h * 60, h * 60 + 59, pendingParts);
                        const timeDesc = `${String(h).padStart(2, '0')}:00~${String(h).padStart(2, '0')}:59`;
                        rules.push({
                            type: 'target',
                            course: currentCourse,
                            date: currentDate,
                            year: currentYear,
                            dateRange: currentDateRange,
                            startMins: h * 60,
                            endMins: h * 60 + 59,
                            timeText: timeDesc,
                            price: priceVal,
                            slashBackPrice: slashBackVal,
                            caddyType: lineCaddyType || null,
                            parts: autoParts,
                            isMeal: Boolean(pendingIsMeal || isMealInLine || (blockHasMeal && h < 11)),
                            rawLine: `${h}시대: ${priceVal}만`
                        });
                    });
                    continue;
                }
            }
        }

        // 8. 시간 토큰 패턴 정의 (HH:MM, 7시, 7시대, 7시30분, 첫팀, 막팀, 7:40분 이후, 8시 이전 등 완벽 지원)
        const teamToken = '(?:첫\\s*(?:팀|티)|막\\s*(?:팀|티)|마지막\\s*(?:팀|티))';
        const timePattern = '(?:' + teamToken + '|\\d{1,2}:\\d{2}|\\d{1,2}\\s*시(?:\\s*대|대)?(?:\\s*\\d{1,2}\\s*분?)?|\\d{4})(?:\\s*분)?';

        // 8-1. 시간 범위 타겟 금액 패턴 (예: "8시대~8:20 현장 11만!", "8시~8:20 현장 11만!", "첫 팀~6:29 → 현장 24만", "08:00~막   팀 → 현장19만", "7:40분 이후~8시 이전 현장 15만!", "12:45~13:13 현장 13만!", "05:46 ~ 06:07 - 10.9")
        // ★ [핵심 우선순위]: "8시대~8:20 11만" 처럼 시작이 시대이고 끝이 분 단위인 범위는 단순 8시대 단독 요금으로 오인되지 않도록 반드시 rangeMatch에서 먼저 처리!
        const rangeMatch = line.match(new RegExp('(' + timePattern + ')(?:\\s*이후)?\\s*(?:~|-|부터)\\s*(' + timePattern + ')(?:\\s*이전)?\\s*(?:[:=\\-→▶⇒~]|->)?\\s*(?:현장|특가|그린피)?\\s*([0-9.,]+)\\s*(?:만|만원|원)?(?:\\s*\\/\\s*([0-9.,]+)\\s*(?:만|만원|원)?)?', 'i'));
        if (rangeMatch) {
            const startStr = rangeMatch[1];
            const endStr = rangeMatch[2];
            const priceVal = normalizeNoticePrice(rangeMatch[3]);
            const slashBackVal = rangeMatch[4] ? normalizeNoticePrice(rangeMatch[4]) : null;

            if (priceVal !== null) {
                let sM = timeToMinutes(startStr);
                // "첫 팀" / "첫팀" / "첫티" -> 05:00 (300분)부터 시작!
                if (/첫\s*(?:팀|티)/.test(startStr)) {
                    sM = 300;
                }

                let eM = timeToMinutes(endStr);
                // "막 팀" / "막팀" / "막티" / "마지막팀"
                if (/막\s*(?:팀|티)|마지막\s*(?:팀|티)/.test(endStr)) {
                    // 기본값: 23:00 (1380분)까지 지정
                    eM = 1380;

                    // ★ [사용자 핵심 요구사항]: 예외적으로 이후에 "2부" 또는 2부 시간대(11시대, 12시대 등)가 나오는 경우 이전 막팀은 1부 끝(11:59 = 719분)까지로 지정!
                    let hasPart2OrLaterTime = false;
                    for (let j = i + 1; j < lines.length; j++) {
                        const nextLine = lines[j].trim();
                        if (!nextLine) continue;
                        const nextDateDetail = parseNoticeDateDetail(nextLine);
                        const nextDateRange = parseNoticeDateRange(nextLine);
                        if ((nextDateDetail && !nextLine.includes(':')) || nextDateRange) break;

                        if (/2부|2\s*부/.test(nextLine) || /(?:1[1-5]\s*시대|1[1-5]:\d{2})/.test(nextLine)) {
                            hasPart2OrLaterTime = true;
                            break;
                        }
                    }
                    if (hasPart2OrLaterTime) {
                        eM = 719; // 11:59 (1부 끝)
                    }
                }

                const autoParts = resolvePartsForTime(sM, eM, pendingParts);
                const timeDesc = formatMinutesToTime(sM, eM);
                rules.push({
                    type: 'target',
                    course: currentCourse,
                    date: currentDate,
                    year: currentYear,
                    dateRange: currentDateRange,
                    startMins: sM,
                    endMins: eM,
                    timeText: timeDesc,
                    price: priceVal,
                    slashBackPrice: slashBackVal,
                    caddyType: lineCaddyType || null,
                    parts: autoParts,
                    isMeal: Boolean(pendingIsMeal || isMealInLine || (blockHasMeal && tMins < 660)),
                    rawLine: line
                });
                continue;
            }
        }

        // 8-2. 특정 시간 이후 패턴 (예: "1:20분 이후 현장 11만!", "1시 이후 현장 13만!", "1:13분 이후 현장 13만!", "13:35분 이후 현장 16만!", "17시 이후: 8.9만", "13시대 이후 13만")
        const afterMatch = line.match(new RegExp('(' + timePattern + ')\\s*(?:시대)?\\s*(?:이후|부터)\\s*(?:잔여\\s*(?:타임|시간|티)?|잔여)?\\s*(?:[:=\\-→▶⇒~]|->)?\\s*(?:현장|특가|그린피|잔여)?\\s*([0-9.,]+)\\s*(?:만|만원|원)?(?:\\s*\\/\\s*([0-9.,]+)\\s*(?:만|만원|원)?)?', 'i'));
        if (afterMatch) {
            const startStr = afterMatch[1];
            const priceVal = normalizeNoticePrice(afterMatch[2]);
            const slashBackVal = afterMatch[3] ? normalizeNoticePrice(afterMatch[3]) : null;
            if (priceVal !== null) {
                const sM = timeToMinutes(startStr);
                const autoParts = resolvePartsForTime(sM, 1439, pendingParts);
                rules.push({
                    type: 'target',
                    course: currentCourse,
                    date: currentDate,
                    year: currentYear,
                    dateRange: currentDateRange,
                    startMins: sM,
                    endMins: 1439, // 23:59까지 전체 해당
                    timeText: `${formatMinutesToTime(sM, sM)}이후`,
                    price: priceVal,
                    slashBackPrice: slashBackVal,
                    caddyType: lineCaddyType || null,
                    parts: autoParts,
                    isMeal: Boolean(pendingIsMeal || isMealInLine || (blockHasMeal && tMins < 660)),
                    rawLine: line
                });
                continue;
            }
        }

        // 8-3. 특정 시간 이전 패턴 (예: "07:30 이전 150,000원", "8시 전 6.4만", "8시대 이전 7만")
        const beforeMatch = line.match(new RegExp('(' + timePattern + ')\\s*(?:시대)?\\s*(?:이전|전)\\s*(?:[:=\\-→▶⇒~]|->)?\\s*(?:현장|특가|그린피)?\\s*([0-9.,]+)\\s*(?:만|만원|원)?(?:\\s*\\/\\s*([0-9.,]+)\\s*(?:만|만원|원)?)?', 'i'));
        if (beforeMatch) {
            const endStr = beforeMatch[1];
            const priceVal = normalizeNoticePrice(beforeMatch[2]);
            const slashBackVal = beforeMatch[3] ? normalizeNoticePrice(beforeMatch[3]) : null;
            if (priceVal !== null) {
                const eM = timeToMinutes(endStr);
                const autoParts = resolvePartsForTime(0, eM, pendingParts);
                rules.push({
                    type: 'target',
                    course: currentCourse,
                    date: currentDate,
                    year: currentYear,
                    dateRange: currentDateRange,
                    startMins: 0,
                    endMins: eM,
                    timeText: `${formatMinutesToTime(eM, eM)}이전`,
                    price: priceVal,
                    slashBackPrice: slashBackVal,
                    caddyType: lineCaddyType || null,
                    parts: autoParts,
                    isMeal: Boolean(pendingIsMeal || isMealInLine || (blockHasMeal && tMins < 660)),
                    rawLine: line
                });
                continue;
            }
        }

        // 8-4. 시대별 요금 패턴 (예: "7시대 현장 10만!!", "19시대 → 현장 6.5만★", "6시대 잔여: 12.9만", "6시대: 8만", "7시대: 9만", "12시대: 9.5만", "1시대 13만")
        // ※ 구체적 시각 범위(8시대~8:20 등)는 상단 rangeMatch에서 이미 처리되었으므로, 콜론 시각(\d{1,2}:\d{2})이 포함된 라인은 여기서 매칭 배제!
        if (!/\d{1,2}:\d{2}/.test(line)) {
            const hourSlotRegex = /(\d{1,2})\s*(?:시대|시\s*대|시타임|시\s*타임)\s*(?:잔여\s*(?:타임|시간|티)?|잔여)?\s*(?:[:=→▶⇒]|->|\s+)\s*(?:현장|특가|그린피|잔여)?\s*([0-9.,]+)(?!:)\s*(?:만|만원|원)?(?:\s*\/\s*([0-9.,]+)\s*(?:만|만원|원)?)?/gi;
            let slotMatch;
            let foundSlot = false;
            while ((slotMatch = hourSlotRegex.exec(line)) !== null) {
                let h = parseInt(slotMatch[1], 10);
                if (h >= 1 && h <= 4) h += 12; // 골프 티타임 특성상 1~4시대는 오후 13~16시대로 자동 변환!
                const priceVal = normalizeNoticePrice(slotMatch[2]);
                const slashBackVal = slotMatch[3] ? normalizeNoticePrice(slotMatch[3]) : null;
                if (priceVal !== null && h >= 0 && h <= 23) {
                    foundSlot = true;
                    const autoParts = resolvePartsForTime(h * 60, h * 60 + 59, pendingParts);
                    const timeDesc = `${String(h).padStart(2, '0')}:00~${String(h).padStart(2, '0')}:59`;
                    pushTargetRule({
                        type: 'target',
                        course: currentCourse,
                        date: currentDate,
                        year: currentYear,
                        dateRange: currentDateRange,
                        startMins: h * 60,
                        endMins: h * 60 + 59,
                        timeText: timeDesc,
                        price: priceVal,
                        slashBackPrice: slashBackVal,
                        caddyType: lineCaddyType || null,
                        parts: autoParts,
                        rawLine: line
                    });
                }
            }
            if (foundSlot) continue;
        }

        // 8-5. "잔여" 또는 "잔여타임" 뒤에 시간들이 나열된 라인 (예: "잔여 1907 1914 1921 1928 1935", "잔여타임 1907 1914...", "잔여: 19:07 19:14...")
        const residualListMatch = line.match(/^[-*•▶▷□■▣★☆◆◇▲▼\s]*(?:잔여\s*(?:타임|시간|티)?|잔여)\s*[:=\-→▶⇒~]?\s*(.*)$/i);
        if (residualListMatch) {
            let rest = residualListMatch[1].trim();
            let lineResidualPrice = pendingPrice || lastTargetPrice || null;
            const inlinePriceMatch = rest.match(/(?:->|=>|→|▶|⇒|[:=])\s*(?:현장|특가|그린피)?\s*([0-9.,]+)\s*(?:만|만원|원)/i) ||
                                     rest.match(/[(\[]\s*([0-9.,]+)\s*(?:만|만원|원)?\s*[)\]]\s*$/i) ||
                                     rest.match(/\s+([0-9.]+)\s*(?:만|만원|원)\s*$/i);
            if (inlinePriceMatch) {
                const pv = normalizeNoticePrice(inlinePriceMatch[1]);
                if (pv !== null) {
                    lineResidualPrice = pv;
                    rest = rest.slice(0, inlinePriceMatch.index).trim();
                }
            }

            const timeTokens = rest.match(/\b(?:\d{1,2}:\d{2}|\d{4})\b/g);
            if (timeTokens && timeTokens.length > 0 && lineResidualPrice !== null) {
                timeTokens.forEach(tStr => {
                    const tMins = timeToMinutes(tStr);
                    const timeDesc = formatMinutesToTime(tMins, tMins);
                    const autoParts = resolvePartsForTime(tMins, tMins, pendingParts);
                    pushTargetRule({
                        type: 'target',
                        course: currentCourse,
                        date: currentDate,
                        year: currentYear,
                        dateRange: currentDateRange,
                        startMins: tMins,
                        endMins: tMins,
                        timeText: timeDesc,
                        price: lineResidualPrice,
                        slashBackPrice: null,
                        caddyType: lineCaddyType || null,
                        parts: autoParts,
                        rawLine: `${timeDesc} ${lineResidualPrice}만`
                    });
                });
                continue;
            }
        }

        // 8-6. 복수 지정 시간 동일 요금 패턴 (예: "07:04, 07:11 12만", "1347 1354 1401 -> 15만", "06:43, 07:15, 07:22 12만", "07:04 / 07:11 12만", "07:04 및 07:11 12만")
        const singleTimeToken = '(?:\\d{1,2}:\\d{2}|\\d{1,2}\\s*시(?:\\s*\\d{1,2}\\s*분?)?|\\d{4})';
        const multiTimeRegex = new RegExp('(?:^|[\\s\\[(])(?:[-*•▶▷□■▣★☆◆◇▲▼]\\s*)?(?:(?:[가-힣a-zA-Z][가-힣a-zA-Z0-9()/.\\[\\]-]*)\\s+)?((?:' + singleTimeToken + '(?:\\s*[,/&+]\\s*|\\s+(?:및|와|과)\\s+|\\s+))+' + singleTimeToken + ')[^0-9.,]*?(?:->|=>|→|▶|⇒)?\\s*([0-9.,]+)\\s*(?:만|만원|원)(?:\\s*\\/\\s*([0-9.,]+)\\s*(?:만|만원|원)?)?', 'i');
        const multiTimeMatch = line.match(multiTimeRegex);
        if (multiTimeMatch) {
            const timeListStr = multiTimeMatch[1];
            const priceVal = normalizeNoticePrice(multiTimeMatch[2]);
            const slashBackVal = multiTimeMatch[3] ? normalizeNoticePrice(multiTimeMatch[3]) : null;
            if (priceVal !== null) {
                const timeTokens = timeListStr.split(/[,/&+]|\s+및\s+|\s+와\s+|\s+과\s+|\s+/).map(s => s.trim()).filter(Boolean);
                let addedAny = false;
                timeTokens.forEach(tStr => {
                    const tMins = timeToMinutes(tStr);
                    const isHourOnly = !tStr.includes(':') && !/\d{1,2}\s*분/.test(tStr) && (tStr.replace(/\D/g, '').length <= 2 || /시(?:대)?$/.test(tStr));
                    const endMins = isHourOnly ? (tMins + 59) : tMins;
                    const timeDesc = isHourOnly
                        ? `${String(Math.floor(tMins / 60)).padStart(2, '0')}:00~${String(Math.floor(tMins / 60)).padStart(2, '0')}:59`
                        : formatMinutesToTime(tMins, endMins);
                    const autoParts = resolvePartsForTime(tMins, endMins, pendingParts);
                    rules.push({
                        type: 'target',
                        course: currentCourse,
                        date: currentDate,
                        year: currentYear,
                        dateRange: currentDateRange,
                        startMins: tMins,
                        endMins: endMins,
                        timeText: timeDesc,
                        price: priceVal,
                        slashBackPrice: slashBackVal,
                        caddyType: lineCaddyType || null,
                        parts: autoParts,
                        rawLine: `${tStr} ${priceVal}만`
                    });
                    addedAny = true;
                });
                if (addedAny) continue;
            }
        }

        // 10-3-1. 축약 다중 분 타임 동일 요금 패턴 (예: "8:03/31 9만", "7:00/07 8만", "8:03/10 9만", "08:14/21 10만")
        const multiMinRegex = /^[-*•▶▷□■▣★☆◆◇▲▼\s]*(?:(?:[가-힣a-zA-Z][가-힣a-zA-Z0-9()/.\\[\\]-]*)\s+)?(\d{1,2}):(\d{2})((?:\s*[/,]\s*\d{1,2})+)\s*[:=\-→▶⇒~]?\s*(?:현장|특가|그린피)?\s*([0-9.,]+)\s*(?:만|만원|원)?(?:\s*\/\s*([0-9.,]+)\s*(?:만|만원|원)?)?/i;
        const multiMinMatch = line.match(multiMinRegex);
        if (multiMinMatch) {
            const baseHour = parseInt(multiMinMatch[1], 10);
            const firstMin = parseInt(multiMinMatch[2], 10);
            const extraMins = (multiMinMatch[3].match(/\d{1,2}/g) || []).map(n => parseInt(n, 10));
            const allMins = [firstMin, ...extraMins].filter(m => !isNaN(m) && m >= 0 && m < 60);
            const priceVal = normalizeNoticePrice(multiMinMatch[4]);
            const slashBackVal = multiMinMatch[5] ? normalizeNoticePrice(multiMinMatch[5]) : null;

            if (priceVal !== null && allMins.length > 0) {
                for (const m of allMins) {
                    const tMins = baseHour * 60 + m;
                    const autoParts = resolvePartsForTime(tMins, tMins, pendingParts);
                    const timeDesc = `${String(baseHour).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
                    rules.push({
                        type: 'target',
                        course: currentCourse,
                        date: currentDate,
                        year: currentYear,
                        dateRange: currentDateRange,
                        startMins: tMins,
                        endMins: tMins,
                        timeText: timeDesc,
                        price: priceVal,
                        slashBackPrice: slashBackVal,
                        caddyType: lineCaddyType || null,
                        parts: autoParts,
                        rawLine: line
                    });
                }
                continue;
            }
        }

        // 10-4. 단일 시간 타겟 금액 패턴 (예: "06:43 12만", "07:04 8만", "6:44 3타임 잔여 현장 13만!", "7:05 루나 현장 14만!", "05:46 - 10.9", "7시 9만", "클아 1935 -> 현장 8만 ★")
        const singleMatch = line.match(new RegExp('(?:^|[\\s\\[(])(?:[-*•▶▷□■▣★☆◆◇▲▼]\\s*)?(?:(?:[가-힣a-zA-Z][가-힣a-zA-Z0-9()/.\\[\\]-]*)\\s+)?(' + timePattern + ')[^0-9.,]*?([0-9.,]+)\\s*(?:만|만원|원)?(?:\\s*\\/\\s*([0-9.,]+)\\s*(?:만|만원|원)?)?', 'i'));
        if (singleMatch) {
            const timeStr = singleMatch[1];
            const rawPriceCandidate = (singleMatch[2] || '').trim();
            // 단위(만, 만원, 원) 없이 4자리 정수(예: 1914, 1928 등)가 잡힌 경우, 이는 금액이 아니라 다른 시간 토큰이므로 금액 오인식 방지!
            const matchedTail = line.slice(singleMatch.index + singleMatch[0].length - 4);
            const hasExplicitUnit = /(?:만|만원|원)/i.test(matchedTail) || /(?:만|만원|원)/i.test(singleMatch[0]);
            if (!hasExplicitUnit && /^\d{4}$/.test(rawPriceCandidate)) {
                // 시간 나열 줄이므로 단일 금액으로 오인식하지 않고 스킵
                continue;
            }

            const priceVal = normalizeNoticePrice(singleMatch[2]);
            const slashBackVal = singleMatch[3] ? normalizeNoticePrice(singleMatch[3]) : null;

            if (priceVal !== null) {
                const tMins = timeToMinutes(timeStr);
                // "7시" 처럼 분 없이 시간만 지정된 경우 해당 시 전체(07:00~07:59) 적용, "7:15" 및 "0553" 처럼 분이 있으면 해당 분만 지정
                const isHourOnly = !timeStr.includes(':') && !/\d{1,2}\s*분/.test(timeStr) && (timeStr.replace(/\D/g, '').length <= 2 || /시(?:대)?$/.test(timeStr));
                const endMins = isHourOnly ? (tMins + 59) : tMins;

                // 단일 시간인 경우 해당 시간이 속한 부제(1부 <11:00, 2부 11:00~16:00, 3부 >=16:00) 자동 판별
                const autoParts = resolvePartsForTime(tMins, endMins, pendingParts);

                const timeDesc = formatMinutesToTime(tMins, endMins);
                pushTargetRule({
                    type: 'target',
                    course: currentCourse,
                    date: currentDate,
                    year: currentYear,
                    dateRange: currentDateRange,
                    startMins: tMins,
                    endMins: endMins,
                    timeText: timeDesc,
                    price: priceVal,
                    slashBackPrice: slashBackVal,
                    caddyType: lineCaddyType || null,
                    parts: autoParts,
                    isMeal: Boolean(pendingIsMeal || isMealInLine || (blockHasMeal && tMins < 660)),
                    rawLine: line
                });
                continue;
            }
        }
    }

    flushPendingDiscount();

    // Same-As 지시어 최종 처리 (예: "(14시타임은 13시대와 동일적용)")
    if (sameAsDirectives.length > 0) {
        sameAsDirectives.forEach(directive => {
            const { targetHour, sourceHour, course, date, year, dateRange } = directive;
            const srcStart = sourceHour * 60;
            const srcEnd = sourceHour * 60 + 59;
            const matchingRules = rules.filter(r => {
                if (r.type !== 'target') return false;
                if (r.course && course && !isCourseMatch(r.course, course)) return false;
                if (r.date && date && !isDateMatch(r.date, date)) return false;
                return (r.startMins <= srcEnd && r.endMins >= srcStart);
            });

            if (matchingRules.length > 0) {
                matchingRules.forEach(srcRule => {
                    rules.push({
                        type: 'target',
                        course: srcRule.course || course || currentCourse,
                        date: srcRule.date || date || currentDate,
                        year: srcRule.year || year || currentYear,
                        dateRange: srcRule.dateRange || dateRange || currentDateRange,
                        startMins: targetHour * 60,
                        endMins: targetHour * 60 + 59,
                        price: srcRule.price,
                        slashBackPrice: srcRule.slashBackPrice,
                        caddyType: srcRule.caddyType || null,
                        parts: srcRule.parts,
                        rawLine: `${targetHour}시대: ${srcRule.price}만 (${sourceHour}시대와 동일적용)`
                    });
                });
            }
        });
    }

    // 만약 공지 본문에 구장명이 생략된 경우 현재 화면의 단일 구장명으로 자동 보완
    if (rules.length > 0) {
        if (!primaryCourse) {
            const uniqueCourses = new Set();
            document.querySelectorAll('#dataTable tbody tr').forEach(tr => {
                const g = tr.cells[2]?.textContent.trim();
                if (g) uniqueCourses.add(g);
            });
            if (uniqueCourses.size === 1) {
                primaryCourse = Array.from(uniqueCourses)[0];
            }
        }

        // 비-구장 단어나 빈 구장명인 규칙만 primaryCourse로 보완 및 전체 구장명 표준화
        rules.forEach(r => {
            if (!r.course || isNonCourseWord(r.course)) {
                r.course = primaryCourse;
            }
            // ★ [사용자 핵심 요구사항] 클럽72 계열(레이크/클래식, 레/클 등)은 무조건 '클럽72'로 단일 표준화!
            r.course = normalizeNoticeCourseName(r.course);
        });
    }

    // 최종 반환 시 비-구장 단어나 빈 구장명을 가진 규칙은 철저히 제거
    return rules.filter(r => r.course && !isNonCourseWord(r.course));
}

// 공지 텍스트 파싱 메인 함수 (복수 공지 일괄 붙여넣기 + 상단/하단 구장명 자동 분할/인식)
function parseNoticeText(text) {
    if (!text || !text.trim()) return [];
    // 그린피와 무관한 식음/브런치/모닝박스/이벤트 공지는 자동 제외
    if (isNonGreenFeeEventNotice(text)) return [];

    // ★ 메시지 상단에 명시된 대표 날짜 추출 (예: "📣 11/15 (일) 3부 잔여타임 재공지드립니다.")
    let messageDefaultDate = '';
    let messageDefaultYear = null;
    const topDateDetail = parseNoticeDateDetail(text);
    if (topDateDetail) {
        messageDefaultDate = topDateDetail.dateStr;
        messageDefaultYear = topDateDetail.year;
    }

    const blocks = splitMultiNoticeBlocks(text);
    if (blocks.length > 1) {
        const allRules = [];
        let curInheritedDate = messageDefaultDate;
        let curInheritedYear = messageDefaultYear;
        for (const block of blocks) {
            const normalizedBlock = normalizeNoticeBlockCourse(block);
            const blockRules = parseSingleNoticeBlock(normalizedBlock, curInheritedDate, curInheritedYear);
            if (blockRules && blockRules.length > 0) {
                const foundDate = blockRules.find(r => r.date && r.date !== '전체');
                if (foundDate) {
                    curInheritedDate = foundDate.date;
                    curInheritedYear = foundDate.year;
                }
            }
            allRules.push(...blockRules);
        }
        return allRules;
    }

    const normalizedSingle = normalizeNoticeBlockCourse(blocks[0] || text);
    return parseSingleNoticeBlock(normalizedSingle, messageDefaultDate, messageDefaultYear);
}

// 활성 공지 규칙 누적 저장소 (구장별 중복/누적 보존)
let activeNoticeRules = [];

// 공지 수신 일시를 '26.10.31 09:00' 형식으로 통일 변환하는 헬퍼
function formatNoticeReceivedTime(val, timestamp) {
    let d = null;
    if (timestamp && !isNaN(Number(timestamp)) && Number(timestamp) > 1000000000) {
        d = new Date(Number(timestamp));
    } else if (val) {
        if (typeof val === 'string') {
            const parsed = new Date(val);
            if (!isNaN(parsed.getTime())) {
                d = parsed;
            } else {
                const m = val.match(/(?:(\d{2,4})[./\-])?(\d{1,2})[./\-](\d{1,2})\s+(\d{1,2}):(\d{2})/);
                if (m) {
                    const now = new Date();
                    const yy = m[1] ? (m[1].length === 4 ? m[1].slice(-2) : m[1]) : String(now.getFullYear()).slice(-2);
                    const mm = m[2].padStart(2, '0');
                    const dd = m[3].padStart(2, '0');
                    const hh = m[4].padStart(2, '0');
                    const min = m[5];
                    return `${yy}.${mm}.${dd} ${hh}:${min}`;
                }
            }
        } else if (val instanceof Date) {
            d = val;
        }
    }

    if (!d || isNaN(d.getTime())) {
        d = new Date();
    }

    // 미래의 비정상 시각으로 튀어있는 경우 현재 시각으로 보정
    const nowTs = Date.now();
    if (d.getTime() > nowTs + 3600 * 1000) {
        d = new Date();
    }

    const yy = String(d.getFullYear()).slice(-2);
    const mm = String(d.getMonth() + 1).padStart(2, '0');
    const dd = String(d.getDate()).padStart(2, '0');
    const hh = String(d.getHours()).padStart(2, '0');
    const min = String(d.getMinutes()).padStart(2, '0');
    return `${yy}.${mm}.${dd} ${hh}:${min}`;
}

// 공지 규칙의 만료 일시(해당 날짜 23:59:59.999 타임스탬프) 계산
function getNoticeRuleExpirationTime(rule) {
    if (!rule) return null;
    // 별도 공지전까지 또는 상시 공지는 최소 60일간 자동 보존
    if (rule.dateDesc === '별도공지전까지' || rule.dateDesc === '별도공지시까지' || rule.date === '전체' || rule.date === '상시' || (rule.type === 'meal' && !rule.dateRange && !rule.date)) {
        return Date.now() + 60 * 24 * 3600 * 1000;
    }
    const now = new Date();
    const todayY = now.getFullYear();
    const todayM = now.getMonth() + 1; // 1-12

    let targetY = null;
    let targetM = null;
    let targetD = null;

    // 1. 기간 범위가 있는 경우 종료일(endDate) 기준
    if (rule.dateRange && rule.dateRange.endM && rule.dateRange.endD) {
        targetM = parseInt(rule.dateRange.endM, 10);
        targetD = parseInt(rule.dateRange.endD, 10);
        targetY = rule.dateRange.endYear || rule.year || null;
    } else if (rule.date) {
        const dr = parseNoticeDateRange(rule.date);
        if (dr && dr.endM && dr.endD) {
            targetM = parseInt(dr.endM, 10);
            targetD = parseInt(dr.endD, 10);
            targetY = dr.endYear || rule.year || null;
        } else {
            // 2. 단일 날짜 (예: "10.18", "2026.10.18")
            const parts = String(rule.date).replace(/[^\d.]/g, '').split('.');
            if (parts.length === 3) {
                targetY = parseInt(parts[0], 10);
                targetM = parseInt(parts[1], 10);
                targetD = parseInt(parts[2], 10);
            } else if (parts.length === 2) {
                targetM = parseInt(parts[0], 10);
                targetD = parseInt(parts[1], 10);
                targetY = rule.year || null;
            }
        }
    }

    if (!targetM || !targetD || isNaN(targetM) || isNaN(targetD)) {
        return null;
    }

    // 연도 자동 보정 (명시적 연도가 없는 경우)
    if (!targetY) {
        targetY = todayY;
        // 오늘이 12월이고 공지가 1~2월인 경우 -> 내년(todayY + 1)
        if (todayM === 12 && targetM <= 2) {
            targetY = todayY + 1;
        }
        // 오늘이 1월이고 공지가 11~12월인 경우 -> 작년(todayY - 1)
        else if (todayM === 1 && targetM >= 11) {
            targetY = todayY - 1;
        }
    } else if (targetY < 100) {
        targetY = 2000 + targetY;
    }

    // 해당 날짜의 23:59:59.999 (해당 날짜가 완전히 끝날 때까지 유효)
    const expDate = new Date(targetY, targetM - 1, targetD, 23, 59, 59, 999);
    return expDate.getTime();
}

// 특정 공지 규칙이 이미 만료(공지 날짜가 지난 상태)되었는지 판별
function isNoticeRuleExpired(rule) {
    const expTime = getNoticeRuleExpirationTime(rule);
    if (!expTime) return false;
    return Date.now() > expTime;
}

// 만료된(공지 날짜가 지난) 공지 규칙 자동 정리 및 비-구장/가짜 규칙 정제
function pruneExpiredNoticeRules() {
    if (!Array.isArray(activeNoticeRules) || activeNoticeRules.length === 0) return 0;
    const initialCount = activeNoticeRules.length;
    activeNoticeRules = activeNoticeRules.filter(rule => {
        if (!rule) return false;
        if (!rule.course || isNonCourseWord(rule.course)) return false;
        // 날짜/기간 정보가 전혀 없는 비정상/가짜 규칙 자동 정제 (정상 공지는 반드시 date 또는 dateRange를 가짐)
        if (!rule.date && !rule.dateRange) return false;
        return !isNoticeRuleExpired(rule);
    });
    const prunedCount = initialCount - activeNoticeRules.length;
    if (prunedCount > 0) {
        saveActiveNoticeRules();
    }
    return prunedCount;
}

// 두 공지 규칙이 동일 구장, 동일 도메인(가격/식사), 동일 날짜, 겹치는 시간대 슬롯에 해당하는지 정밀 판별
// (겹치는 슬롯인 경우에만 기존 규칙을 최신 공지로 대체 갱신하고, 날짜나 시간대가 다르면 병합 보존!)
function isNoticeRuleSlotConflict(existing, incoming) {
    if (!existing || !incoming) return false;
    if (!existing.course || !incoming.course) return false;

    // 1. 구장 일치 여부 확인
    if (!isCourseMatch(incoming.course, existing.course)) return false;

    // 2. 도메인(가격 vs 식사) 일치 여부 확인 (가격 공지와 식사 공지는 독립 관리하여 상호 보존)
    const isExistingMeal = existing.type === 'meal' || (existing.isMeal && (existing.price === null || existing.price === undefined));
    const isIncomingMeal = incoming.type === 'meal' || (incoming.isMeal && (incoming.price === null || incoming.price === undefined));
    if (isExistingMeal !== isIncomingMeal) return false;

    // 3. 캐디 유형 충돌 여부 확인
    const eCaddy = existing.caddyType || 'any';
    const iCaddy = incoming.caddyType || 'any';
    if (eCaddy !== 'any' && iCaddy !== 'any' && eCaddy !== iCaddy) return false;

    // 4. 날짜 일치 여부 확인
    const eDate = String(existing.date || '').trim();
    const iDate = String(incoming.date || '').trim();
    const isEAllDate = (!eDate || eDate === '전체' || eDate === '전체날짜' || eDate === '상시' || eDate === '별도공지전까지');
    const isIAllDate = (!iDate || iDate === '전체' || iDate === '전체날짜' || iDate === '상시' || iDate === '별도공지전까지');

    let datesConflict = false;
    if (isEAllDate && isIAllDate) {
        datesConflict = true;
    } else if (!isEAllDate && !isIAllDate) {
        // 둘 다 특정 날짜가 있는 경우: 날짜가 일치할 때만 충돌/대체 대상
        datesConflict = (typeof isDateMatch === 'function')
            ? (isDateMatch(incoming.date, existing.date) || isDateMatch(existing.date, incoming.date))
            : (eDate === iDate);
    } else {
        // 한쪽은 전체 날짜, 한쪽은 특정 날짜인 경우
        if (isIAllDate) {
            datesConflict = true;
        } else {
            datesConflict = true;
        }
    }
    if (!datesConflict) return false;

    // 5. 시간대(startMins ~ endMins) 겹침 여부 확인
    const s1 = existing.startMins !== undefined ? existing.startMins : 0;
    const e1 = (existing.endMins !== undefined && existing.endMins !== null) ? existing.endMins : 1439;
    const s2 = incoming.startMins !== undefined ? incoming.startMins : 0;
    const e2 = (incoming.endMins !== undefined && incoming.endMins !== null) ? incoming.endMins : 1439;

    // 시간대가 겹치는지 검사 (예: 09시[540~599]와 10시[600~659]는 겹치지 않음 -> 충돌 아님!)
    const timesOverlap = Math.max(s1, s2) <= Math.min(e1, e2);
    if (!timesOverlap) return false;

    return true; // 구장, 도메인, 날짜, 시간대가 모두 겹치므로 기존 슬롯을 최신 규칙으로 대체!
}

// ========================================================
// 🛡️ 로컬 공지 삭제 이력(Tombstone) 관리
// 사용자가 삭제한 구장 공지가 새로고침이나 클라우드 동기화 시 다시 부활하는 것을 완벽 차단
// ========================================================
function getLocallyDeletedNoticeCourses() {
    try {
        const saved = localStorage.getItem('v2_deletedNoticeCourses');
        if (saved) {
            const parsed = JSON.parse(saved);
            if (parsed && typeof parsed === 'object') return parsed;
        }
    } catch(e) {}
    return {};
}

function saveLocallyDeletedNoticeCourses(map) {
    try {
        localStorage.setItem('v2_deletedNoticeCourses', JSON.stringify(map || {}));
    } catch(e) {}
    try {
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.set({ v2_deletedNoticeCourses: map || {} });
        }
    } catch(e) {}
}

function addLocallyDeletedNoticeCourse(courseName) {
    if (!courseName) return;
    const map = getLocallyDeletedNoticeCourses();
    const clean = normalizeNoticeCourseName(courseName).replace(/[\s\-_\[\]\(\)\/]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();
    const rawClean = String(courseName).replace(/[\s\-_\[\]\(\)\/]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();
    const now = Date.now();
    if (clean) map[clean] = now;
    if (rawClean) map[rawClean] = now;
    saveLocallyDeletedNoticeCourses(map);
}

function removeLocallyDeletedNoticeCourse(courseName) {
    if (!courseName) return;
    const map = getLocallyDeletedNoticeCourses();
    const clean = normalizeNoticeCourseName(courseName).replace(/[\s\-_\[\]\(\)\/]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();
    const rawClean = String(courseName).replace(/[\s\-_\[\]\(\)\/]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();
    delete map[clean];
    delete map[rawClean];
    saveLocallyDeletedNoticeCourses(map);
}

function isCourseLocallyDeleted(courseName, receivedTimestamp, deletedMap) {
    if (!courseName) return false;
    const map = deletedMap || getLocallyDeletedNoticeCourses();
    const clean = normalizeNoticeCourseName(courseName).replace(/[\s\-_\[\]\(\)\/]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();
    const rawClean = String(courseName).replace(/[\s\-_\[\]\(\)\/]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();

    for (const key in map) {
        if (!key) continue;
        if (clean === key || rawClean === key || clean.includes(key) || key.includes(clean)) {
            const delTs = map[key];
            const rTs = Number(receivedTimestamp) || 0;
            if (!rTs || rTs <= delTs) {
                return true;
            }
        }
    }
    return false;
}

function loadActiveNoticeRules() {
    // [비정상 119개 대량 덤프 공지 영구 퇴출]: 엠스클럽 의성 덤프 공지 최초 1회 즉시 자동 블랙리스트 등록 및 삭제
    try {
        if (localStorage.getItem('v2_cleaned_msclub_dump_v1') !== 'true') {
            addLocallyDeletedNoticeCourse('엠스클럽 의성');
            addLocallyDeletedNoticeCourse('엠스클럽의성');
            localStorage.setItem('v2_cleaned_msclub_dump_v1', 'true');
        }
    } catch(e) {}

    try {
        const saved = localStorage.getItem('v2_activeNoticeRules');
        if (saved) {
            const parsed = JSON.parse(saved);
            if (Array.isArray(parsed)) {
                const localDeleted = getLocallyDeletedNoticeCourses();
                activeNoticeRules = parsed.filter(rule => {
                    if (!rule || !rule.course || isNonCourseWord(rule.course) || (!rule.date && !rule.dateRange)) return false;
                    if (isCourseLocallyDeleted(rule.course, rule.receivedTimestamp, localDeleted)) return false;
                    return true;
                });
            }
        }
    } catch(e) {
        activeNoticeRules = [];
    }

    // ★ [자동 복구 및 중복 정제] 과거 '전체'로 잘못 저장되었던 단일 일자 공지 날짜 복원 및 충돌 정제
    let rulesChanged = false;
    activeNoticeRules.forEach(r => {
        if ((!r.date || r.date === '전체' || r.dateDesc === '전체') && (r.fullNoticeText || r.rawNoticeText)) {
            const txt = r.fullNoticeText || r.rawNoticeText;
            const parsedD = (typeof parseNoticeDateDetail === 'function') ? parseNoticeDateDetail(txt) : null;
            if (parsedD && parsedD.dateStr && parsedD.dateStr !== '전체') {
                r.date = parsedD.dateStr;
                if (!r.dateRange) {
                    const dr = (typeof parseNoticeDateRange === 'function') ? parseNoticeDateRange(r.date) : null;
                    if (dr) r.dateRange = dr;
                }
                rulesChanged = true;
            }
        }
    });

    // 특정 구장에 구체적인 날짜 규칙이 존재할 경우, 동일 구장의 동일 도메인(가격/식사)의 남아있는 '전체' 규칙만 제거 (날짜 충돌 방지 및 가격-식사 상호 보존)
    const specificPriceCourses = new Set();
    const specificMealCourses = new Set();
    activeNoticeRules.forEach(r => {
        if (r.date && r.date !== '전체' && r.date !== '전체날짜' && r.date !== '별도공지전까지' && r.date !== '상시') {
            const stdC = normalizeNoticeCourseName(r.course);
            const isMeal = r.type === 'meal' || (r.isMeal && (r.price === null || r.price === undefined));
            if (isMeal) {
                specificMealCourses.add(stdC);
            } else {
                specificPriceCourses.add(stdC);
            }
        }
    });
    if (specificPriceCourses.size > 0 || specificMealCourses.size > 0) {
        const prevLen = activeNoticeRules.length;
        activeNoticeRules = activeNoticeRules.filter(r => {
            const stdC = normalizeNoticeCourseName(r.course);
            const isMeal = r.type === 'meal' || (r.isMeal && (r.price === null || r.price === undefined));
            if (isMeal) {
                if (specificMealCourses.has(stdC) && (!r.date || r.date === '전체' || r.date === '전체날짜')) {
                    return false;
                }
            } else {
                if (specificPriceCourses.has(stdC) && (!r.date || r.date === '전체' || r.date === '전체날짜')) {
                    return false;
                }
            }
            return true;
        });
        if (activeNoticeRules.length !== prevLen) {
            rulesChanged = true;
        }
    }

    // ★ [사용자 핵심 요구사항] 날짜/시간대별 공지 병합 보존: 동일 구장이라도 날짜나 시간대가 다르면 삭제하지 않고 병합 보존!
    // 동일 구장 + 도메인(가격/식사) + 동일 날짜 + 동일 시간대 중복 규칙만 정리 (최신 타임스탬프 우선 보존)
    const seenRuleKeys = new Set();
    const dedupedRules = [];
    const sortedForDedup = [...activeNoticeRules].sort((a, b) => (b.receivedTimestamp || 0) - (a.receivedTimestamp || 0));
    sortedForDedup.forEach(r => {
        const cKey = normalizeNoticeCourseName(r.course || '');
        const isMeal = r.type === 'meal' || (r.isMeal && (r.price === null || r.price === undefined));
        const typeDomain = isMeal ? 'meal' : 'price';
        const dKey = (r.date || '전체').replace(/[\/\-]/g, '.');
        const endMinsVal = (r.endMins !== undefined && r.endMins !== null) ? r.endMins : 1439;
        const tKey = `${r.startMins || 0}_${endMinsVal}`;
        const cdKey = r.caddyType || 'any';
        const uniqueKey = `${cKey}__${typeDomain}__${dKey}__${tKey}__${cdKey}`;
        if (!seenRuleKeys.has(uniqueKey)) {
            seenRuleKeys.add(uniqueKey);
            dedupedRules.push(r);
        } else {
            rulesChanged = true;
        }
    });
    activeNoticeRules = dedupedRules;

    if (rulesChanged) {
        saveActiveNoticeRules();
    }

    // 날짜 지난 만료 공지 및 비-구장/가짜 규칙 자동 삭제 (가벼운 필터링만 수행)
    pruneExpiredNoticeRules();

    return activeNoticeRules;
}

function saveActiveNoticeRules() {
    try {
        localStorage.setItem('v2_activeNoticeRules', JSON.stringify(activeNoticeRules));
    } catch(e) {}
    try {
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.set({ v2_activeNoticeRules: activeNoticeRules });
        }
    } catch(e) {}
}

// 공지등록 기능 접근 가능 여부 (회원 부여기능에 '공지등록'/'공지'가 있거나, 관리자가 실험실에서 활성화한 경우)
function isNoticeFeatureAvailable() {
    const hasNotice = typeof hasUserFeature === 'function' ? (hasUserFeature('notice') || hasUserFeature('공지') || hasUserFeature('공지등록')) : false;
    const isLabActive = (typeof isCurrentUserAdmin === 'function' && isCurrentUserAdmin()) && localStorage.getItem('v2_labModeActive') === 'true';
    const isNoticeSaved = localStorage.getItem('v2_noticeFeatureActive') === 'true';
    return hasNotice || (isLabActive && isNoticeSaved);
}

// 공지가격 적용 여부 전역 토글 (체크박스 상태: 기본 true)
let isNoticeRulesActive = true;

function initNoticeRulesActive() {
    isNoticeRulesActive = true; // ★ [사용자 핵심 요구]: 공지가는 항상 무조건 적용
    try {
        localStorage.setItem('v2_isNoticeRulesActive', 'true');
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.set({ v2_isNoticeRulesActive: true });
        }
    } catch(e) {}
    updateNoticeHeaderUI();
}

function updateNoticeHeaderUI() {
    const group = document.getElementById('noticeHeaderBtnGroup');
    const badgeWrapper = document.getElementById('headerNoticeCountWrapper');

    if (group) {
        group.classList.remove('disabled-notice');
    }
    if (badgeWrapper) {
        badgeWrapper.style.color = '#059669';
    }
}

function setNoticeRulesActive(active = true, notify = false) {
    isNoticeRulesActive = true; // ★ [사용자 핵심 요구]: 공지가는 항상 무조건 적용
    try {
        localStorage.setItem('v2_isNoticeRulesActive', 'true');
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.set({ v2_isNoticeRulesActive: true });
        }
    } catch(e) {}
    updateNoticeHeaderUI();
    applyAllActiveNoticeRules();
    if (notify) {
        showToast('공지가격이 항상 적용됩니다.');
    }
}

// 공지 모달 내 적용 중인 공지 칩 UI 렌더링
function renderActiveNoticeChips() {
    // 렌더링 직전 만료 규칙 정리
    pruneExpiredNoticeRules();

    const sec = document.getElementById('activeNoticeSection');
    const listEl = document.getElementById('activeNoticeChipList');
    const countEl = document.getElementById('activeNoticeCount');
    const headerNoticeBadge = document.getElementById('headerNoticeBadge');
    const headerNoticeCountWrapper = document.getElementById('headerNoticeCountWrapper');

    function updateHeaderBadge(count) {
        if (headerNoticeBadge && headerNoticeCountWrapper) {
            if (count > 0) {
                headerNoticeBadge.textContent = count.toString();
                headerNoticeCountWrapper.style.display = 'inline';
            } else {
                headerNoticeCountWrapper.style.display = 'none';
            }
        }
        updateNoticeHeaderUI();
    }

    if (!activeNoticeRules || activeNoticeRules.length === 0) {
        if (sec) sec.style.display = 'none';
        if (listEl) listEl.innerHTML = '';
        if (countEl) countEl.textContent = '0';
        updateHeaderBadge(0);
        return;
    }

    if (!sec || !listEl) {
        updateHeaderBadge(activeNoticeRules.length);
        return;
    }

    sec.style.display = 'block';
    listEl.innerHTML = '';

    // 구장별로 룰 그룹화 (표준 구장명 기준)
    const courseGroups = {};
    activeNoticeRules.forEach(r => {
        const c = normalizeNoticeCourseName(r.course || '공지 구장');
        if (!courseGroups[c]) courseGroups[c] = [];
        courseGroups[c].push(r);
    });

    const courses = Object.keys(courseGroups);
    if (countEl) countEl.textContent = courses.length.toString();
    updateHeaderBadge(courses.length);

    courses.forEach(courseName => {
        const list = courseGroups[courseName];

        // 가격 규칙과 순수 식사 규칙 분리
        const priceRules = list.filter(r => r.type === 'target' || r.type === 'discount');
        const mealRules = list.filter(r => r.type === 'meal' || (r.isMeal && (r.price === null || r.price === undefined)));

        // priceRules와 mealRules가 둘 다 독립적으로 존재하면 2개의 칩으로 분리 렌더링
        const subLists = [];
        if (priceRules.length > 0 && mealRules.length > 0) {
            subLists.push({ domain: 'price', items: priceRules });
            subLists.push({ domain: 'meal', items: mealRules });
        } else {
            subLists.push({ domain: 'all', items: list });
        }

        subLists.forEach(sub => {
            const subItems = sub.items;
            const domain = sub.domain;
            let desc = '';
            const hasMealRule = subItems.some(r => r.isMeal || r.type === 'meal');
            const mealBadge = (domain !== 'meal' && hasMealRule) ? ' 식사포함' : '';
            const discountRule = subItems.find(r => r.type === 'discount');

            if (discountRule) {
                const dRange = discountRule.dateRange ? discountRule.dateRange.text : (discountRule.dateDesc || discountRule.date || '');
                const pDesc = discountRule.parts ? discountRule.parts.desc : '전부';
                desc = `${dRange ? `${dRange} ` : ''}-${discountRule.discount}만 (${pDesc})${mealBadge}`;
            } else if (subItems.some(r => r.type === 'target')) {
                const targetItems = subItems.filter(r => r.type === 'target');
                const firstDate = targetItems[0]?.dateDesc || targetItems[0]?.date || '';
                desc = `${firstDate ? `${firstDate} ` : ''}${targetItems.length}개 타임${mealBadge}`;
            } else if (hasMealRule) {
                const mealRule = subItems.find(r => r.type === 'meal') || subItems[0];
                const dRange = mealRule.dateRange ? mealRule.dateRange.text : (mealRule.dateDesc || mealRule.date || '');
                const pDesc = mealRule.parts ? ` (${mealRule.parts.desc})` : (mealRule.timeText ? ` (${mealRule.timeText})` : '');
                desc = `${dRange ? `${dRange} ` : ''}식사포함${pDesc}`;
            } else {
                const firstDate = subItems[0]?.date || '';
                desc = `${firstDate ? `${firstDate} ` : ''}${subItems.length}개 타임`;
            }

            // 만료 유효기간 태그 (예: ~10.18 또는 ~10.22)
            let validUntilStr = '';
            const dates = subItems.map(r => {
                if (r.dateRange && r.dateRange.endDate) return r.dateRange.endDate;
                if (r.date) return r.date;
                return '';
            }).filter(Boolean);
            if (dates.length > 0) {
                validUntilStr = dates[dates.length - 1];
            }
            const validityTag = validUntilStr ? ` <span style="opacity:0.85; font-size:11px; color:#2563EB;">(~${validUntilStr})</span>` : '';

            // 공지 수신 일시 태그 (예: 🕒 26.10.31 09:00)
            const receivedAtStr = formatNoticeReceivedTime(subItems[0]?.receivedAt, subItems[0]?.receivedTimestamp);
            const receivedTag = receivedAtStr ? ` <span style="opacity:0.9; font-size:10.5px; color:#D97706; font-weight:600;" title="공지 수신 일시: ${receivedAtStr}">${receivedAtStr}</span>` : '';

            const domainLabel = domain === 'price' ? ' [가격]' : (domain === 'meal' ? ' [식사]' : '');
            const chip = document.createElement('div');
            chip.className = 'active-notice-chip';
            chip.dataset.course = courseName;
            chip.dataset.domain = domain;
            chip.title = `[${courseName}${domainLabel}] 클릭 시 공지 전문 보기 (수신: ${receivedAtStr || '최근'})`;
            chip.innerHTML = `
                <span class="chip-content" style="cursor: pointer;"><strong>${courseName}</strong> (${desc})${receivedTag}${validityTag}</span>
                <button type="button" class="chip-del-btn" data-course="${courseName}" data-domain="${domain}" title="${courseName}${domainLabel} 공지만 해제">✕</button>
            `;

            chip.addEventListener('click', (e) => {
                if (e.target.closest('.chip-del-btn')) {
                    const cName = e.target.closest('.chip-del-btn').dataset.course || courseName;
                    const dName = e.target.closest('.chip-del-btn').dataset.domain || domain;
                    removeNoticeForCourse(cName, true, dName);
                    return;
                }
                showNoticeDetailModal(courseName, domain);
            });

            listEl.appendChild(chip);
        });
    });
}

// ========================================================
// ☁️ 전체 사용자: 특정 구장 공지 삭제 클라우드 즉시 동기화
// 사용자 누구나 특정 구장의 공지를 삭제하면 구글 시트에서 즉시 해당 행을 제거하고
// 삭제 이력(Tombstone)을 기록하여 전체 사용자 클라이언트에서도 자동 삭제되도록 합니다.
// ========================================================
async function deleteNoticeFromCloud(courseName) {
    if (!courseName) return;
    try {
        const uId = (currentAuthUser && (currentAuthUser.id || currentAuthUser.name)) ? (currentAuthUser.id || currentAuthUser.name) : '사용자';
        const uPw = (currentAuthUser && currentAuthUser.pw) ? currentAuthUser.pw : '';
        const uName = (currentAuthUser && currentAuthUser.name) ? currentAuthUser.name : uId;

        const payload = {
            action: 'delete_notice',
            course: courseName,
            deletedTimestamp: Date.now(),
            id: uId,
            userId: uId,
            password: uPw,
            pw: uPw,
            userName: uName
        };

        const rawApiUrl = (typeof getAuthApiUrl === 'function' ? getAuthApiUrl() : '') || currentAuthApiUrl || DEFAULT_AUTH_API_URL;
        const apiUrl = cleanGoogleWebAppUrl(rawApiUrl);
        if (!apiUrl) return;

        const targetUrl = `${apiUrl}?action=delete_notice&course=${encodeURIComponent(courseName)}&userId=${encodeURIComponent(uId)}&userName=${encodeURIComponent(uName)}&id=${encodeURIComponent(uId)}&pw=${encodeURIComponent(uPw)}&_t=${Date.now()}`;

        const res = await fetch(targetUrl, {
            method: 'POST',
            redirect: 'follow',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify(payload)
        });
        const text = await res.text();
        console.log(`[Cloud Notice Delete] '${courseName}' 삭제 서버 응답:`, text);
    } catch(err) {
        console.error('[Cloud Notice Delete] 삭제 동기화 전송 오류:', err);
    }
}

// 전체 공지 삭제 클라우드 즉시 동기화
async function clearAllNoticesFromCloud() {
    try {
        const uId = (currentAuthUser && (currentAuthUser.id || currentAuthUser.name)) ? (currentAuthUser.id || currentAuthUser.name) : '사용자';
        const uPw = (currentAuthUser && currentAuthUser.pw) ? currentAuthUser.pw : '';
        const uName = (currentAuthUser && currentAuthUser.name) ? currentAuthUser.name : uId;

        const payload = {
            action: 'clear_all_notices',
            deletedTimestamp: Date.now(),
            id: uId,
            userId: uId,
            password: uPw,
            pw: uPw,
            userName: uName
        };

        const rawApiUrl = (typeof getAuthApiUrl === 'function' ? getAuthApiUrl() : '') || currentAuthApiUrl || DEFAULT_AUTH_API_URL;
        const apiUrl = cleanGoogleWebAppUrl(rawApiUrl);
        if (!apiUrl) return;

        const targetUrl = `${apiUrl}?action=clear_all_notices&userId=${encodeURIComponent(uId)}&userName=${encodeURIComponent(uName)}&id=${encodeURIComponent(uId)}&pw=${encodeURIComponent(uPw)}&_t=${Date.now()}`;

        const res = await fetch(targetUrl, {
            method: 'POST',
            redirect: 'follow',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify(payload)
        });
        const text = await res.text();
        console.log('[Cloud Notice Clear] 전체 삭제 서버 응답:', text);
    } catch(err) {
        console.error('[Cloud Notice Clear] 전체 삭제 동기화 전송 오류:', err);
    }
}

// 특정 구장 공지만 제거하고 나머지 구장 공지 유지 (가격/식사 도메인별 선택 삭제 지원, 전체 인원 실시간 삭제 동기화)
function removeNoticeForCourse(courseName, notifyServer = true, domainType = null) {
    const stdCourse = normalizeNoticeCourseName(courseName);

    activeNoticeRules = activeNoticeRules.filter(r => {
        if (!r.course) return false;
        const matches = (r.course === courseName || 
                         r.course.trim().toLowerCase() === courseName.trim().toLowerCase() ||
                         r.course === stdCourse || 
                         normalizeNoticeCourseName(r.course) === stdCourse ||
                         isCourseMatch(courseName, r.course, r.course, r.course));
        if (!matches) return true;

        const isMeal = r.type === 'meal' || (r.isMeal && (r.price === null || r.price === undefined));
        if (domainType === 'meal' && isMeal) return false;
        if (domainType === 'price' && !isMeal) return false;
        if (!domainType || domainType === 'all') return false;
        return true;
    });

    const remainingForCourse = activeNoticeRules.filter(r => isCourseMatch(courseName, r.course, r.course, r.course));
    if (remainingForCourse.length === 0) {
        addLocallyDeletedNoticeCourse(courseName);
        if (notifyServer) {
            deleteNoticeFromCloud(courseName);
        }
    }

    saveActiveNoticeRules();
    applyAllActiveNoticeRules();
    renderActiveNoticeChips();

    const domainDesc = domainType === 'meal' ? ' 식사포함' : (domainType === 'price' ? ' 가격' : '');
    showToast(`'${courseName}'${domainDesc} 공지가 해제되었습니다.`);
}

// 전체 공지 완전 초기화 (전체 인원 실시간 초기화 동기화)
function clearAllNotices(notifyServer = true) {
    activeNoticeRules = [];
    try {
        localStorage.setItem('v2_allNoticesClearedTimestamp', Date.now().toString());
    } catch(e) {}
    saveActiveNoticeRules();
    revertNoticeRules();
    renderActiveNoticeChips();

    if (notifyServer) {
        clearAllNoticesFromCloud();
        showToast('전체 공지가 초기화되었으며, 전체 사용자에게 동기화가 적용되었습니다.');
    }
}

// 특정 구장의 공지 전문 원문 반환 (저장된 전문 > 카톡 수집 내역 > 규칙 기반 구조화 전문)
function getFullNoticeTextForCourse(courseName, domainType = null) {
    if (!courseName) return '';
    const stdCourse = normalizeNoticeCourseName(courseName);
    const normTarget = stdCourse.replace(/[\s\-_\[\]\(\)]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();

    // 1. activeNoticeRules 에서 동일 구장의 규칙 필터링 후, 최신 공지(receivedTimestamp 내림차순) 순으로 정렬
    const matchingRules = activeNoticeRules.filter(r => {
        if (!r.course) return false;
        if (!isCourseMatch(stdCourse, r.course)) return false;
        const isMeal = r.type === 'meal' || (r.isMeal && (r.price === null || r.price === undefined));
        if (domainType === 'meal' && !isMeal) return false;
        if (domainType === 'price' && isMeal) return false;
        return true;
    });

    matchingRules.sort((a, b) => (b.receivedTimestamp || 0) - (a.receivedTimestamp || 0));

    // 최신 공지의 전문 원문 우선 반환 (복수 공지가 병합된 경우 병합 표시)
    const distinctTexts = [...new Set(matchingRules.map(r => (r.fullNoticeText || r.rawNoticeText || '').trim()).filter(Boolean))];
    if (distinctTexts.length === 1) {
        return distinctTexts[0];
    } else if (distinctTexts.length > 1) {
        return distinctTexts.join('\n\n--- [추가 병합된 공지] ---\n\n');
    }

    // 2. lastCollectedKakaoNotices 에서 탐색
    if (typeof lastCollectedKakaoNotices !== 'undefined' && Array.isArray(lastCollectedKakaoNotices) && lastCollectedKakaoNotices.length > 0) {
        const matchedItem = lastCollectedKakaoNotices.find(item => {
            if (!item.text) return false;
            const normText = item.text.replace(/[\s\-_\[\]\(\)]|cc|gc|골프장|골프클럽/gi, '').toLowerCase();
            return normText.includes(normTarget) || (item.course && isCourseMatch(stdCourse, item.course));
        });
        if (matchedItem && matchedItem.text) {
            return matchedItem.text;
        }
    }

    // 3. 만약 저장된 원문이 없다면, 등록된 규칙들로부터 구조화된 전문 생성
    if (matchingRules.length > 0) {
        const lines = [];
        const r0 = matchingRules[0];
        const domainLabel = domainType === 'meal' ? ' [식사포함]' : (domainType === 'price' ? ' [가격]' : '');
        lines.push(`■ ${stdCourse}${domainLabel}`);
        if (r0.receivedAt || r0.receivedTimestamp) lines.push(`[공지 수신 일시: ${formatNoticeReceivedTime(r0.receivedAt, r0.receivedTimestamp)}]`);
        if (r0.dateRange) lines.push(`기간: ${r0.dateRange.text}`);
        else if (r0.date) lines.push(`날짜: ${r0.date}`);
        lines.push('');
        matchingRules.forEach(r => {
            if (r.type === 'target') {
                const startH = Math.floor(r.startMins / 60);
                const startM = r.startMins % 60;
                const endH = Math.floor(r.endMins / 60);
                const endM = r.endMins % 60;
                const timeDesc = (r.startMins === r.endMins)
                    ? `${String(startH).padStart(2, '0')}:${String(startM).padStart(2, '0')}`
                    : (r.endMins - r.startMins === 59 && startM === 0)
                        ? `${startH}시대`
                        : `${String(startH).padStart(2, '0')}:${String(startM).padStart(2, '0')} ~ ${String(endH).padStart(2, '0')}:${String(endM).padStart(2, '0')}`;
                const mealSfx = r.isMeal ? ' [식사포함]' : '';
                lines.push(`${r.date ? `${r.date} ` : ''}${timeDesc} : ${r.price}만${r.slashBackPrice ? ` / ${r.slashBackPrice}만` : ''}${mealSfx}`);
            } else if (r.type === 'discount') {
                const mealSfx = r.isMeal ? ' [식사포함]' : '';
                lines.push(`추가 할인: -${r.discount}만 (${r.parts ? r.parts.desc : '전부'})${mealSfx}`);
            } else if (r.type === 'meal' || r.isMeal) {
                lines.push(`${r.date ? `${r.date} ` : ''}${r.timeText || '전타임'} : 식사포함${r.parts ? ` (${r.parts.desc})` : ''}`);
            }
        });
        return lines.join('\n');
    }

    return `[${stdCourse}] 등록된 공지 원문을 찾을 수 없습니다.`;
}

// 화면 공지 클릭 시 공지 전문 모달 표시
function showNoticeDetailModal(courseName, domainType = null) {
    const modal = document.getElementById('noticeViewModal');
    if (!modal) return;

    const stdCourse = normalizeNoticeCourseName(courseName);
    const titleEl = document.getElementById('noticeViewTitle');
    const metaEl = document.getElementById('noticeViewMeta');
    const bodyEl = document.getElementById('noticeViewBody');

    const matchingRules = activeNoticeRules.filter(r => {
        if (!r.course) return false;
        if (!isCourseMatch(stdCourse, r.course)) return false;
        const isMeal = r.type === 'meal' || (r.isMeal && (r.price === null || r.price === undefined));
        if (domainType === 'meal' && !isMeal) return false;
        if (domainType === 'price' && isMeal) return false;
        return true;
    });

    matchingRules.sort((a, b) => (b.receivedTimestamp || 0) - (a.receivedTimestamp || 0));

    const receivedAt = formatNoticeReceivedTime(matchingRules[0]?.receivedAt, matchingRules[0]?.receivedTimestamp);
    let validUntil = '';
    const dates = matchingRules.map(r => {
        if (r.dateRange && r.dateRange.endDate) return r.dateRange.endDate;
        if (r.date) return r.date;
        return '';
    }).filter(Boolean);
    if (dates.length > 0) validUntil = dates[dates.length - 1];

    const typeTitle = domainType === 'meal' ? ' [식사포함]' : (domainType === 'price' ? ' [가격]' : '');
    if (titleEl) titleEl.textContent = `${stdCourse}${typeTitle} 공지 전문`;
    if (metaEl) {
        metaEl.innerHTML = `
            <span style="background: #FEF3C7; color: #92400E; padding: 2px 7px; border-radius: 10px; font-weight: 700;">수신: ${escapeHtml(receivedAt)}</span>
            ${validUntil ? `<span style="background: #DBEAFE; color: #1E40AF; padding: 2px 7px; border-radius: 10px; font-weight: 600;">유효: ~${escapeHtml(validUntil)}</span>` : ''}
            <span style="background: #DCFCE7; color: #166534; padding: 2px 7px; border-radius: 10px; font-weight: 600;">규칙: ${matchingRules.length}건</span>
        `;
    }

    const fullText = getFullNoticeTextForCourse(courseName);
    if (bodyEl) {
        bodyEl.textContent = fullText;
    }

    // 전문 복사 버튼 연결
    const btnCopy = document.getElementById('btnCopyNoticeViewText');
    if (btnCopy) {
        btnCopy.onclick = () => {
            navigator.clipboard.writeText(fullText).then(() => {
                showToast(`[${courseName}] 공지 전문이 복사되었습니다.`);
            }).catch(() => {
                showToast('복사에 실패했습니다.');
            });
        };
    }

    // 입력창에 넣기 버튼 연결
    const btnPaste = document.getElementById('btnPasteNoticeToInput');
    if (btnPaste) {
        btnPaste.onclick = () => {
            const input = document.getElementById('noticeInputText');
            if (input) {
                input.value = fullText;
                showToast(`[${courseName}] 공지 전문을 입력창에 넣었습니다.`);
                closeNoticeDetailModal();
                const noticeModal = document.getElementById('noticeModal');
                if (noticeModal) noticeModal.style.display = 'flex';
                if (typeof syncParsedNoticeToManualInputs === 'function') {
                    syncParsedNoticeToManualInputs(fullText);
                }
            }
        };
    }

    // 공지 재적용 버튼 연결
    const btnApply = document.getElementById('btnApplyFromNoticeView');
    if (btnApply) {
        btnApply.onclick = () => {
            applyNoticeFromText(fullText, false, receivedAt);
            closeNoticeDetailModal();
        };
    }

    modal.style.display = 'flex';
}

function closeNoticeDetailModal() {
    const modal = document.getElementById('noticeViewModal');
    if (modal) modal.style.display = 'none';
}

// ========================================================
// 지역별 공지 구장 기본 카탈로그 및 커스텀 구장 관리
// ========================================================
const DEFAULT_NOTICE_COURSE_CATALOG = {
    '경기북부': [
        '고양cc', '남양주cc (9홀x2)', '베스트밸리cc', '비전힐스cc',
        '서울한양cc', '파주cc', '포레스트힐cc', '한양파인cc'
    ],
    '경기남부': [
        '강남300cc', '골프존_송도', '그린힐cc', '더크로스비',
        '라비돌cc', '리베라cc', '베어즈베스트청라', '비에이비스타',
        '비에이비스타(P)', '세현cc', '신안cc', '썬밸리_여주',
        '양평TPC', '용인cc', '지산cc', '캐슬렉스_서울',
        '크리스밸리', '클럽72', '클럽72(오션)', '태광cc',
        '파인크리크', '한원cc', '해솔리아cc'
    ],
    '충청도': [
        '대영베이스cc', '대영힐스', '떼제베(동북)', '떼제베(서남)',
        '레인보우힐스cc', '로얄포레cc', '모카cc(구세일)', '보령베이스 (9홀x2)',
        '속리산cc', '솔라고cc', '썬밸리_음성', '올데이',
        '임페리얼레이크', '플라밍고', '히든밸리cc'
    ],
    '강원도': [
        '썬밸리_동원', '썬밸리_설악', '알펜시아700', '알펜시아cc',
        '알프스대영', '에스파크_남한강', '옥스필드', '웰리힐리cc',
        '파인밸리cc'
    ],
    '경상도': [
        '가산cc', '에스파크_밀양', '엠스클럽 의성'
    ],
    '전라도': [
        '영광cc'
    ],
    '제주도': [
        '골프존_오라(제주)', '그린필드cc(제주)', '라온cc(제주)', '라헨느cc(제주)',
        '블랙스톤cc(제주)', '사이프러스cc(제주)', '샤인빌cc(제주)', '서귀포팬텀cc(제주)',
        '시에나cc(제주)', '아난티(제주)', '아덴힐cc(제주)', '에버리스(제주)',
        '에코랜드cc(제주)', '엘리시안(제주)', '중문cc(제주)', '캐슬렉스cc(제주)',
        '타미우스cc(제주)', '테디밸리cc(제주)', '한라산cc(제주)'
    ]
};

let customNoticeCourses = [];
let currentNoticeFilterRegion = 'ALL';

function loadCustomNoticeCourses() {
    try {
        const saved = localStorage.getItem('v2_notice_custom_courses');
        if (saved) {
            const parsed = JSON.parse(saved);
            if (Array.isArray(parsed)) customNoticeCourses = parsed;
        }
    } catch(e) {
        customNoticeCourses = [];
    }
    return customNoticeCourses;
}

function saveCustomNoticeCourses() {
    try {
        localStorage.setItem('v2_notice_custom_courses', JSON.stringify(customNoticeCourses));
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.set({ v2_notice_custom_courses: customNoticeCourses });
        }
    } catch(e) {}
}

const REGION_BADGE_CLASS_MAP = {
    '경기북부': 'north',
    '경기남부': 'south',
    '충청도': 'chungcheong',
    '강원도': 'gangwon',
    '경상도': 'gyeongsang',
    '전라도': 'jeolla',
    '제주도': 'jeju',
    '직접등록': 'custom',
    '기타': 'custom',
    '현재화면': 'current'
};

function renderNoticeCourseDropdown(keyword = '', filterRegion = 'ALL') {
    const bodyEl = document.getElementById('noticeCourseDDBody');
    const promptRow = document.getElementById('noticeCourseDirectAddPrompt');
    const promptText = document.getElementById('noticeCourseDirectAddText');
    const tabCustom = document.getElementById('tabNoticeCustomRegion');
    if (!bodyEl) return;

    loadCustomNoticeCourses();

    if (tabCustom) {
        tabCustom.style.display = customNoticeCourses.length > 0 ? 'inline-block' : 'none';
    }

    const cleanKw = (keyword || '').trim().toLowerCase().replace(/[\s\-_]/g, '');

    // 전체 구장 맵 구성 (기본 카탈로그 복사 + 사용자 직접 등록 구장 병합)
    const combinedCatalog = {};
    Object.keys(DEFAULT_NOTICE_COURSE_CATALOG).forEach(reg => {
        combinedCatalog[reg] = [...DEFAULT_NOTICE_COURSE_CATALOG[reg]];
    });

    // 사용자 추가 구장 병합
    if (customNoticeCourses && customNoticeCourses.length > 0) {
        customNoticeCourses.forEach(c => {
            if (!c || !c.name) return;
            const reg = c.region || '직접등록';
            if (!combinedCatalog[reg]) combinedCatalog[reg] = [];
            if (!combinedCatalog[reg].includes(c.name)) {
                combinedCatalog[reg].push(c.name);
            }
        });
    }

    // 현재 테이블에 존재하는 구장 중 카탈로그에 없는 구장 보완
    const currentTableCourses = [];
    document.querySelectorAll('#tableBody tr').forEach(tr => {
        const cName = tr.cells[2]?.textContent.trim();
        if (cName && !currentTableCourses.includes(cName)) {
            let exists = false;
            for (const r in combinedCatalog) {
                if (combinedCatalog[r].includes(cName)) {
                    exists = true;
                    break;
                }
            }
            if (!exists) currentTableCourses.push(cName);
        }
    });
    if (currentTableCourses.length > 0) {
        combinedCatalog['현재화면'] = currentTableCourses;
    }

    bodyEl.innerHTML = '';
    let totalMatchedCourses = 0;
    let exactMatchFound = false;

    // 지역 순회 렌더링
    const regions = Object.keys(combinedCatalog);
    regions.forEach(regionName => {
        if (filterRegion !== 'ALL' && filterRegion !== regionName) {
            if (filterRegion === 'CUSTOM' && regionName !== '직접등록' && regionName !== '기타') {
                return;
            } else if (filterRegion !== 'CUSTOM') {
                return;
            }
        }

        let courses = combinedCatalog[regionName];
        if (cleanKw) {
            courses = courses.filter(c => {
                const normC = c.toLowerCase().replace(/[\s\-_]/g, '');
                if (normC === cleanKw) exactMatchFound = true;
                return normC.includes(cleanKw);
            });
        }

        if (courses.length === 0) return;
        totalMatchedCourses += courses.length;

        const groupDiv = document.createElement('div');
        groupDiv.className = 'notice-region-group';
        groupDiv.dataset.region = regionName;

        const badgeClass = REGION_BADGE_CLASS_MAP[regionName] || 'custom';
        groupDiv.innerHTML = `
            <div class="notice-region-title">
                <span class="region-badge ${badgeClass}">${regionName}</span>
                <span class="region-count">${courses.length}개</span>
            </div>
            <div class="notice-course-grid"></div>
        `;

        const gridDiv = groupDiv.querySelector('.notice-course-grid');
        courses.forEach(cName => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'btn-course-chip';
            btn.dataset.course = cName;
            btn.title = `클릭 시 [${cName}] 선택`;

            const isCustom = customNoticeCourses.some(item => item && item.name === cName);

            let chipHtml = `<span style="overflow:hidden; text-overflow:ellipsis;">${escapeHtml(cName)}</span>`;
            if (isCustom) {
                chipHtml += `<button type="button" class="btn-del-custom-course" data-del="${escapeHtml(cName)}" title="이 구장 삭제">✕</button>`;
            }
            btn.innerHTML = chipHtml;

            btn.addEventListener('click', (e) => {
                if (e.target.closest('.btn-del-custom-course')) {
                    e.stopPropagation();
                    const targetName = e.target.closest('.btn-del-custom-course').dataset.del;
                    removeCustomNoticeCourse(targetName);
                    return;
                }
                selectNoticeCourse(cName);
            });

            gridDiv.appendChild(btn);
        });

        bodyEl.appendChild(groupDiv);
    });

    // 신규 구장 바로 추가등록 프롬프트 제어
    if (cleanKw && !exactMatchFound) {
        if (promptRow && promptText) {
            promptText.innerHTML = `<strong>"${escapeHtml(keyword.trim())}"</strong> 새 구장으로 바로 등록하기`;
            promptRow.style.display = 'flex';
        }
    } else {
        if (promptRow) promptRow.style.display = 'none';
    }

    if (totalMatchedCourses === 0 && !cleanKw) {
        bodyEl.innerHTML = `<div style="text-align:center; padding:15px; color:#94A3B8; font-size:10.5px;">등록된 구장이 없습니다.</div>`;
    }
}

function selectNoticeCourse(cName) {
    const courseInput = document.getElementById('manualNoticeCourse');
    if (courseInput) {
        courseInput.value = cName;
        if (typeof markManualNoticeModified === 'function') {
            markManualNoticeModified();
        }
    }
    closeNoticeCourseDropdown();
    const dateInput = document.getElementById('manualNoticeDate');
    const priceInput = document.getElementById('manualNoticePrice');
    if (dateInput && !dateInput.value.trim()) {
        dateInput.focus();
    } else if (priceInput) {
        priceInput.focus();
    }
}

function addNewCourseToCatalog(courseName, region = '경기남부') {
    const cleanName = (courseName || '').trim();
    if (!cleanName) {
        showToast('구장명을 입력해주세요.');
        document.getElementById('inputNewNoticeCourseName')?.focus();
        return;
    }

    loadCustomNoticeCourses();

    let exists = false;
    for (const r in DEFAULT_NOTICE_COURSE_CATALOG) {
        if (DEFAULT_NOTICE_COURSE_CATALOG[r].some(c => c.replace(/\s+/g, '').toLowerCase() === cleanName.replace(/\s+/g, '').toLowerCase())) {
            exists = true;
            break;
        }
    }
    if (!exists) {
        exists = customNoticeCourses.some(c => c && c.name.replace(/\s+/g, '').toLowerCase() === cleanName.replace(/\s+/g, '').toLowerCase());
    }

    if (exists) {
        selectNoticeCourse(cleanName);
        showToast(`'${cleanName}' 구장이 선택되었습니다.`);
        return;
    }

    const reg = region || '경기남부';
    customNoticeCourses.push({ name: cleanName, region: reg });
    saveCustomNoticeCourses();

    selectNoticeCourse(cleanName);
    showToast(`[${reg}] '${cleanName}' 구장이 새로 추가 등록되었습니다!`);

    const inputNew = document.getElementById('inputNewNoticeCourseName');
    if (inputNew) inputNew.value = '';
}

function removeCustomNoticeCourse(courseName) {
    if (!confirm(`'${courseName}' 구장을 목록에서 삭제하시겠습니까?`)) return;
    loadCustomNoticeCourses();
    customNoticeCourses = customNoticeCourses.filter(c => c && c.name !== courseName);
    saveCustomNoticeCourses();
    const courseInput = document.getElementById('manualNoticeCourse');
    renderNoticeCourseDropdown(courseInput ? courseInput.value.trim() : '', currentNoticeFilterRegion);
    showToast(`'${courseName}' 구장이 삭제되었습니다.`);
}

function openNoticeCourseDropdown() {
    const dd = document.getElementById('noticeCourseDropdownMenu');
    const courseInput = document.getElementById('manualNoticeCourse');
    if (!dd) return;
    renderNoticeCourseDropdown(courseInput ? courseInput.value.trim() : '', currentNoticeFilterRegion);
    dd.style.display = 'flex';
}

function closeNoticeCourseDropdown() {
    const dd = document.getElementById('noticeCourseDropdownMenu');
    if (dd) dd.style.display = 'none';
}

// 수동 공지 입력용 구장 및 날짜 자동완성 데이터리스트 채우기
function populateNoticeSuggestions() {
    const dateDatalist = document.getElementById('noticeDateSuggestions');
    const courseInput = document.getElementById('manualNoticeCourse');
    const dateInput = document.getElementById('manualNoticeDate');

    if (dateDatalist) {
        dateDatalist.innerHTML = '';
        const tbody = document.getElementById('tableBody');
        const trs = tbody ? Array.from(tbody.querySelectorAll('tr')) : [];

        const uniqueDates = [];
        trs.forEach(tr => {
            const cells = tr.querySelectorAll('td');
            const d = cells[0]?.textContent.trim();
            if (d && !uniqueDates.includes(d)) uniqueDates.push(d);
        });

        const optAll = document.createElement('option');
        optAll.value = '전체 날짜';
        dateDatalist.appendChild(optAll);

        uniqueDates.forEach(d => {
            const opt = document.createElement('option');
            opt.value = d;
            dateDatalist.appendChild(opt);
        });

        if (dateInput && !dateInput.value.trim() && uniqueDates.length === 1) {
            dateInput.value = uniqueDates[0];
        }
    }

    loadCustomNoticeCourses();
    renderNoticeCourseDropdown(courseInput ? courseInput.value.trim() : '', currentNoticeFilterRegion);
}

let isManualNoticeModified = false;
let isSyncingManualNotice = false;
let currentParsedNoticeRules = []; // 공지 텍스트에서 파싱되었거나 수동 추가된 규칙 목록

function markManualNoticeModified() {
    if (!isSyncingManualNotice) {
        isManualNoticeModified = true;
        updateManualNoticeHint();
    }
}

// 수동 공지 상태 힌트 문구 업데이트
function updateManualNoticeHint() {
    const hintEl = document.getElementById('manualNoticeStatusHint');
    if (!hintEl) return;
    const courseInput = document.getElementById('manualNoticeCourse');
    const hasCourse = Boolean(courseInput?.value.trim());

    if (currentParsedNoticeRules.length > 0) {
        hintEl.innerHTML = `<span style="color: #16A34A; font-weight: 700;">${currentParsedNoticeRules.length}개 타임 인식됨</span> <span style="color: #64748B;">(각 행에서 시간·금액 수정 가능)</span>`;
    } else if (isManualNoticeModified) {
        hintEl.innerHTML = `<span style="color: #2563EB; font-weight: 600;">사용자 직접 수정됨</span> <span style="color: #64748B;">([+ 추가] 또는 일괄적용 클릭)</span>`;
    } else if (hasCourse) {
        hintEl.innerHTML = `<span style="color: #D97706; font-weight: 600;">구장 감지됨</span> <span style="color: #64748B;">(시간·부제·금액 입력 후 [+ 추가])</span>`;
    } else {
        hintEl.innerHTML = `<span style="color: #64748B;">텍스트 미인식 시 직접 지정</span>`;
    }
}

// 파싱된 공지 규칙 목록 렌더링 (복수 타임 분할 표시 및 행별 수정/삭제)
function renderParsedNoticeRules() {
    const listEl = document.getElementById('parsedNoticeRulesList');
    if (!listEl) return;

    if (!currentParsedNoticeRules || currentParsedNoticeRules.length === 0) {
        listEl.style.display = 'none';
        listEl.innerHTML = '';
        return;
    }

    listEl.style.display = 'flex';
    listEl.innerHTML = '';

    currentParsedNoticeRules.forEach((rule, idx) => {
        const itemEl = document.createElement('div');
        itemEl.className = 'parsed-rule-item';
        itemEl.dataset.ruleId = rule.id || `rule_${idx}`;

        // 순번 뱃지
        const badgeEl = document.createElement('span');
        badgeEl.className = 'rule-idx-badge';
        badgeEl.textContent = String(idx + 1);

        // 구장 입력/표시칸 (복수 구장 공지 시 각 행의 구장명 명확히 표시 및 개별 수정 가능)
        const courseInput = document.createElement('input');
        courseInput.type = 'text';
        courseInput.className = 'rule-item-course';
        courseInput.title = '구장명 (예: 올데이, 임페리얼, 떼제베(서남), 떼제베(동북))';
        courseInput.placeholder = '구장';
        courseInput.value = rule.course || '';
        courseInput.style.width = '52px';
        courseInput.style.fontSize = '10px';
        courseInput.style.fontWeight = '600';
        courseInput.style.textAlign = 'center';
        courseInput.style.borderRadius = '4px';
        courseInput.style.border = '1px solid #CBD5E1';
        courseInput.style.background = '#F8FAFC';
        courseInput.style.color = '#1E293B';
        courseInput.style.flexShrink = '0';
        courseInput.style.boxSizing = 'border-box';
        courseInput.style.padding = '3px 1px';
        courseInput.addEventListener('input', (e) => {
            rule.course = e.target.value.trim();
            markManualNoticeModified();
        });

        // 날짜 입력칸 (별도공지전까지 -> '전체', 11.2, 11.3, 11.16~11.19 등 행별 수정 가능)
        const dateInput = document.createElement('input');
        dateInput.type = 'text';
        dateInput.className = 'rule-item-date';
        dateInput.title = '날짜 (예: 전체, 11.2, 11.3, 11.16~11.19)';
        dateInput.placeholder = '날짜';
        const displayDate = rule.date || (rule.dateRange ? rule.dateRange.text : '') || (rule.dateDesc === '별도공지전까지' ? '전체' : '');
        dateInput.value = (displayDate === '별도공지전까지' || displayDate === '전체' || !displayDate) ? '전체' : displayDate;
        dateInput.style.width = (dateInput.value && dateInput.value.length > 5) ? '72px' : '38px';
        dateInput.style.fontSize = '10px';
        dateInput.style.fontWeight = '700';
        dateInput.style.textAlign = 'center';
        dateInput.style.borderRadius = '4px';
        dateInput.style.border = '1px solid #CBD5E1';
        dateInput.style.background = '#F8FAFC';
        dateInput.style.color = '#2563EB';
        dateInput.style.flexShrink = '0';
        dateInput.style.boxSizing = 'border-box';
        dateInput.style.padding = '3px 1px';
        dateInput.addEventListener('input', (e) => {
            rule.date = e.target.value.trim();
            const dr = parseNoticeDateRange(rule.date);
            if (dr) {
                rule.dateRange = dr;
            } else {
                rule.dateRange = null;
            }
            dateInput.style.width = (rule.date.length > 5) ? '72px' : '38px';
            markManualNoticeModified();
        });

        // 시간 입력칸 (11:27, 11:00~12:00, 17:00~18:59, 전체 등 수정 가능)
        const timeInput = document.createElement('input');
        timeInput.type = 'text';
        timeInput.className = 'rule-item-time';
        timeInput.title = '시간 변경 가능 (예: 11:27, 11:00~12:00, 17-18시대, 19시대, 전체)';
        timeInput.placeholder = '시간';
        const displayTime = rule.timeText || formatMinutesToTime(rule.startMins, rule.endMins);
        timeInput.value = displayTime;
        timeInput.style.width = '64px';
        timeInput.style.fontSize = '10px';
        timeInput.style.textAlign = 'center';
        timeInput.style.borderRadius = '4px';
        timeInput.style.border = '1px solid #CBD5E1';
        timeInput.style.background = '#F8FAFC';
        timeInput.style.flexShrink = '0';
        timeInput.style.boxSizing = 'border-box';
        timeInput.style.padding = '3px 1px';

        // 시간 변경 이벤트 바인딩 (시간에 따라 1부/2부/3부 내부 속성 자동 동기화)
        timeInput.addEventListener('input', (e) => {
            const rawT = e.target.value.trim();
            rule.timeText = rawT;
            const parsed = parseTimeInputToMinutes(rawT);
            rule.startMins = parsed.startMins;
            rule.endMins = parsed.endMins;

            if (!parsed.isAll) {
                const hasP1 = parsed.startMins < 660;
                const hasP2 = parsed.startMins < 960 && parsed.endMins >= 660;
                const hasP3 = parsed.endMins >= 960;
                rule.parts = {
                    hasPart1: hasP1,
                    hasPart2: hasP2,
                    hasPart3: hasP3,
                    desc: [hasP1 ? '1부' : '', hasP2 ? '2부' : '', hasP3 ? '3부' : ''].filter(Boolean).join('+')
                };
            }
            markManualNoticeModified();
        });

        // 캐디/노캐디 구분 드롭다운 (무관, 캐디, 노캐디)
        const caddySelect = document.createElement('select');
        caddySelect.className = 'rule-item-caddy';
        caddySelect.title = '캐디/노캐디 구분 (무관, 캐디, 노캐디)';
        caddySelect.style.width = '52px';
        caddySelect.style.fontSize = '9.5px';
        caddySelect.style.fontWeight = '600';
        caddySelect.style.borderRadius = '4px';
        caddySelect.style.border = '1px solid #CBD5E1';
        caddySelect.style.background = '#FFFFFF';
        caddySelect.style.color = '#334155';
        caddySelect.style.cursor = 'pointer';
        caddySelect.style.flexShrink = '0';
        caddySelect.style.boxSizing = 'border-box';
        caddySelect.style.padding = '2px 1px';

        const optAll = document.createElement('option');
        optAll.value = '';
        optAll.textContent = '무관';
        const optCaddy = document.createElement('option');
        optCaddy.value = 'caddy';
        optCaddy.textContent = '캐디';
        const optNoCaddy = document.createElement('option');
        optNoCaddy.value = 'nocaddy';
        optNoCaddy.textContent = '노캐디';

        caddySelect.appendChild(optAll);
        caddySelect.appendChild(optCaddy);
        caddySelect.appendChild(optNoCaddy);
        caddySelect.value = rule.caddyType || '';

        const applyCaddyColor = () => {
            if (caddySelect.value === 'nocaddy') {
                caddySelect.style.color = '#0D9488';
                caddySelect.style.borderColor = '#99F6E4';
                caddySelect.style.background = '#F0FDFA';
            } else if (caddySelect.value === 'caddy') {
                caddySelect.style.color = '#4F46E5';
                caddySelect.style.borderColor = '#C7D2FE';
                caddySelect.style.background = '#EEF2FF';
            } else {
                caddySelect.style.color = '#64748B';
                caddySelect.style.borderColor = '#CBD5E1';
                caddySelect.style.background = '#FFFFFF';
            }
        };
        applyCaddyColor();

        caddySelect.addEventListener('change', (e) => {
            rule.caddyType = e.target.value || null;
            applyCaddyColor();
            markManualNoticeModified();
        });

        // 금액 입력칸 (7만, 10/1, -2만, 식사포함 등 수정 가능)
        const priceInput = document.createElement('input');
        priceInput.type = 'text';
        priceInput.className = 'rule-item-price';
        priceInput.title = '금액 변경 가능 (예: 7만, 6.5만, 10/1, -2만, 식사포함)';
        priceInput.style.width = '44px';
        priceInput.style.flex = '1';
        priceInput.style.minWidth = '40px';
        priceInput.style.fontSize = '10px';
        priceInput.style.fontWeight = '700';
        priceInput.style.textAlign = 'center';
        priceInput.style.borderRadius = '4px';
        priceInput.style.border = '1px solid #CBD5E1';
        priceInput.style.background = '#F8FAFC';
        priceInput.style.color = '#DC2626';
        priceInput.style.boxSizing = 'border-box';
        priceInput.style.padding = '3px 2px';
        let displayPrice = '';
        if (rule.type === 'meal' || rule.isMeal) {
            displayPrice = '식사포함';
            priceInput.style.color = '#EA580C';
            priceInput.style.fontWeight = '800';
            priceInput.style.background = '#FFF7ED';
            priceInput.style.borderColor = '#FDBA74';
            priceInput.style.minWidth = '62px';
        } else if (rule.type === 'discount') {
            displayPrice = `-${rule.discount}만`;
        } else if (rule.slashBackPrice) {
            displayPrice = `${rule.price}/${rule.slashBackPrice}`;
        } else if (rule.price !== undefined && rule.price !== null) {
            displayPrice = `${rule.price}만`;
        }
        priceInput.value = displayPrice;

        priceInput.addEventListener('input', (e) => {
            const rawP = e.target.value.trim();
            if (/식사|조식|식음|모닝식사|식포\b/.test(rawP)) {
                rule.type = 'meal';
                rule.isMeal = true;
                rule.price = null;
                rule.discount = null;
                priceInput.style.color = '#EA580C';
                priceInput.style.background = '#FFF7ED';
                priceInput.style.borderColor = '#FDBA74';
            } else if (rawP.startsWith('-') || /할인|인하|DC|차감/.test(rawP)) {
                rule.type = 'discount';
                rule.isMeal = false;
                const dVal = normalizeNoticePrice(rawP.replace(/^-/, ''));
                if (dVal !== null) rule.discount = dVal;
                priceInput.style.color = '#2563EB';
                priceInput.style.background = '#F8FAFC';
                priceInput.style.borderColor = '#CBD5E1';
            } else {
                rule.type = 'target';
                rule.isMeal = false;
                if (rawP.includes('/')) {
                    const sp = rawP.split('/');
                    const p1 = normalizeNoticePrice(sp[0]);
                    const p2 = normalizeNoticePrice(sp[1]);
                    if (p1 !== null) rule.price = p1;
                    if (p2 !== null) rule.slashBackPrice = p2;
                } else {
                    const p1 = normalizeNoticePrice(rawP);
                    if (p1 !== null) {
                        rule.price = p1;
                        rule.slashBackPrice = null;
                    }
                }
                priceInput.style.color = '#DC2626';
                priceInput.style.background = '#F8FAFC';
                priceInput.style.borderColor = '#CBD5E1';
            }
            markManualNoticeModified();
        });

        // 삭제 버튼 (✕)
        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'btn-rule-item-del';
        delBtn.innerHTML = '&times;';
        delBtn.title = '이 규칙 제거';
        delBtn.addEventListener('click', () => {
            currentParsedNoticeRules.splice(idx, 1);
            renderParsedNoticeRules();
            updateManualNoticeHint();
        });

        itemEl.appendChild(badgeEl);
        itemEl.appendChild(courseInput);
        itemEl.appendChild(dateInput);
        itemEl.appendChild(timeInput);
        itemEl.appendChild(caddySelect);
        itemEl.appendChild(priceInput);
        itemEl.appendChild(delBtn);

        listEl.appendChild(itemEl);
    });
}

// 공지 상단 텍스트를 실시간 분석하여 하단 직접추가 입력폼 및 타임별 분할 목록에 자동 반영
function syncParsedNoticeToManualInputs(text) {
    const courseInput = document.getElementById('manualNoticeCourse');
    const dateInput = document.getElementById('manualNoticeDate');
    const timeInput = document.getElementById('manualNoticeTime');
    const priceInput = document.getElementById('manualNoticePrice');
    const chk1 = document.getElementById('chkManualNoticePart1');
    const chk2 = document.getElementById('chkManualNoticePart2');
    const chk3 = document.getElementById('chkManualNoticePart3');

    const cleanText = (text || '').trim();
    if (!cleanText) {
        currentParsedNoticeRules = [];
        renderParsedNoticeRules();
        updateManualNoticeHint();
        isManualNoticeModified = false;
        return;
    }

    isSyncingManualNotice = true;
    try {
        const rules = parseNoticeText(cleanText);

        let detectedCourse = '';
        let detectedDate = '';

        if (rules && rules.length > 0) {
            // 대표 구장 탐색
            const distinctCourses = [...new Set(rules.map(r => r.course).filter(Boolean))];
            if (distinctCourses.length > 1) {
                detectedCourse = `복수 구장 (${distinctCourses.join(', ')})`;
            } else if (distinctCourses.length === 1) {
                detectedCourse = distinctCourses[0];
            } else {
                const courseRule = rules.find(r => r.course);
                if (courseRule) detectedCourse = courseRule.course;
            }

            // 날짜 탐색 (여러 날짜 분할 감지)
            const distinctDates = [...new Set(rules.map(r => r.date).filter(Boolean))];
            if (distinctDates.length > 1) {
                detectedDate = `복수 날짜 (${distinctDates.join(', ')})`;
            } else if (distinctDates.length === 1) {
                detectedDate = distinctDates[0];
            } else {
                const dateRule = rules.find(r => r.date || r.dateRange);
                if (dateRule) {
                    detectedDate = dateRule.date || (dateRule.dateRange ? dateRule.dateRange.text : '');
                }
            }
        }

        // 보조 구장 추출 (텍스트 라인에서 직접 탐색)
        if (!detectedCourse) {
            const lines = cleanText.split('\n');
            for (const l of lines) {
                const c = detectCourseInLine(l);
                if (c && !isNonCourseWord(c)) {
                    detectedCourse = c;
                    break;
                }
            }
            if (!detectedCourse) {
                for (const l of lines) {
                    const firstTok = l.trim().replace(/^\[[^\]]+\]\s*/, '').split(/[\s\t:=>\-]+/)[0].trim().replace(/[\[\]\(\)\*#※■□▣◆◇▲▼▶▷◀◁●○★☆【】<>~_]/g, '');
                    if (firstTok && typeof NOTICE_COURSE_SHORT_MAP !== 'undefined' && NOTICE_COURSE_SHORT_MAP[firstTok]) {
                        detectedCourse = NOTICE_COURSE_SHORT_MAP[firstTok];
                        break;
                    }
                }
            }
        }

        // 보조 날짜 추출 (별도공지전까지 -> '전체'로 통일)
        if (!detectedDate || detectedDate === '별도공지전까지') {
            if (/(?:별도\s*공지\s*(?:전까지|시까지|까지|시)?|추후\s*공지|상시\s*적용|상시|당분간)/i.test(cleanText)) {
                detectedDate = '전체';
            } else {
                detectedDate = parseNoticeDate(cleanText) || '';
                if (!detectedDate) {
                    const dRange = parseNoticeDateRange(cleanText);
                    if (dRange) detectedDate = dRange.text;
                }
                if (!detectedDate) {
                    const tbody = document.getElementById('tableBody');
                    const firstRowDate = tbody?.querySelector('tr td:first-child')?.textContent.trim();
                    if (firstRowDate) {
                        detectedDate = firstRowDate;
                    } else {
                        detectedDate = '전체';
                    }
                }
            }
        }

        // 구장 및 날짜 입력창에 반영 (별도공지전까지는 기간 '전체'로 표기)
        if (detectedCourse && courseInput) {
            courseInput.value = detectedCourse;
        }
        if (dateInput) {
            dateInput.value = (detectedDate === '별도공지전까지' || !detectedDate) ? '전체' : detectedDate;
        }

        // 복수 타임 분할 목록 구성 및 렌더링
        if (rules && rules.length > 0) {
            currentParsedNoticeRules = rules.map((r, i) => ({
                id: `parsed_${Date.now()}_${i}`,
                type: r.type || 'target',
                course: r.course || (detectedCourse && !detectedCourse.includes('복수') ? detectedCourse : ''),
                date: (r.date && r.date !== '전체' && r.date !== '별도공지전까지')
                    ? (r.dateRange ? r.dateRange.text : r.date)
                    : (detectedDate && !detectedDate.includes('복수') && detectedDate !== '별도공지전까지' && detectedDate !== '전체'
                        ? detectedDate
                        : ((r.dateDesc === '별도공지전까지' || !r.date || r.date === '전체' || detectedDate === '별도공지전까지') ? '전체' : (r.date || detectedDate || '전체'))),
                year: r.year || null,
                dateRange: r.dateRange || null,
                dateDesc: r.dateDesc || '',
                startMins: r.startMins !== undefined ? r.startMins : 0,
                endMins: r.endMins !== undefined ? r.endMins : 1439,
                timeText: r.timeText || formatMinutesToTime(r.startMins, r.endMins),
                price: r.price,
                slashBackPrice: r.slashBackPrice,
                discount: r.discount,
                isMeal: Boolean(r.isMeal || r.type === 'meal'),
                parts: r.parts,
                caddyType: r.caddyType || null,
                rawLine: r.rawLine,
                fullNoticeText: cleanText
            }));

            renderParsedNoticeRules();

            // 하단 수동 추가 입력칸에도 대표 시간/부제/금액 자동 보조 입력
            const firstRule = currentParsedNoticeRules[0];
            if (firstRule) {
                if (timeInput) timeInput.value = firstRule.timeText || '';
                if (priceInput) {
                    priceInput.value = (firstRule.type === 'meal' || firstRule.isMeal) ? '식사포함' : (firstRule.price ? `${firstRule.price}만` : (firstRule.discount ? `-${firstRule.discount}만` : ''));
                }
                if (firstRule.parts) {
                    if (chk1) chk1.checked = Boolean(firstRule.parts.hasPart1);
                    if (chk2) chk2.checked = Boolean(firstRule.parts.hasPart2);
                    if (chk3) chk3.checked = Boolean(firstRule.parts.hasPart3);
                }
            }
        } else {
            // 규칙이 정규식으로 전혀 분할되지 않은 경우 단일 폴백 시도
            currentParsedNoticeRules = [];
            renderParsedNoticeRules();

            let fallbackPrice = '';
            const isMealNotice = /(?:식사\s*포함|조식\s*포함|중식\s*포함|석식\s*포함|식사\s*제공|조식\s*제공|식음\s*제공|모닝식사|식포\b)/i.test(cleanText) && !/(?:식사\s*불가|식사\s*미포함|식사\s*별도)/i.test(cleanText);
            const dVal = parseNoticeDiscount(cleanText);
            if (dVal !== null) {
                fallbackPrice = `-${dVal}만`;
            } else if (isMealNotice && !/[0-9.,]+\s*(?:만|만원|원)/.test(cleanText)) {
                fallbackPrice = '식사포함';
            } else {
                // 부제(1부, 2부, 3부)나 시간대(7시대)의 숫자가 금액으로 오인되지 않도록 정밀 매칭
                const pMatch = cleanText.match(/(?:현장\s*|그린피\s*|특가\s*|\b요금\s*|\b금액\s*)?([0-9.,]+)\s*(?:만|만원|원)(?:\s*\/\s*([0-9.,]+)\s*(?:만|만원|원)?)?/i) ||
                               cleanText.match(/(?:현장\s*|그린피\s*|특가\s*)([0-9.,]+)(?:\s*\/\s*([0-9.,]+))?/i);
                if (pMatch && pMatch[1]) {
                    const p1 = normalizeNoticePrice(pMatch[1]);
                    const p2 = pMatch[2] ? normalizeNoticePrice(pMatch[2]) : null;
                    if (p1 !== null) {
                        fallbackPrice = p2 ? `${p1}/${p2}` : `${p1}만`;
                    }
                }
            }
            if (priceInput && fallbackPrice) priceInput.value = fallbackPrice;

            // 시간 및 부제 추출 (예: "1부 전타임" -> timeInput: "1부 전타임", 1부 체크)
            if (timeInput) {
                if (/1부\s*전타임/.test(cleanText)) {
                    timeInput.value = '1부 전타임';
                } else if (/2부\s*전타임/.test(cleanText)) {
                    timeInput.value = '2부 전타임';
                } else if (/3부\s*전타임/.test(cleanText)) {
                    timeInput.value = '3부 전타임';
                } else if (/1부/.test(cleanText)) {
                    timeInput.value = '1부';
                } else if (/2부/.test(cleanText)) {
                    timeInput.value = '2부';
                } else if (/3부/.test(cleanText)) {
                    timeInput.value = '3부';
                } else if (/전타임|전부/.test(cleanText)) {
                    timeInput.value = '전타임';
                }
            }

            const pObj = parseNoticeParts(cleanText);
            if (pObj) {
                if (chk1) chk1.checked = Boolean(pObj.hasPart1);
                if (chk2) chk2.checked = Boolean(pObj.hasPart2);
                if (chk3) chk3.checked = Boolean(pObj.hasPart3);
            } else if (/1부/.test(cleanText)) {
                if (chk1) chk1.checked = true;
                if (chk2) chk2.checked = false;
                if (chk3) chk3.checked = false;
            } else if (/2부/.test(cleanText)) {
                if (chk1) chk1.checked = false;
                if (chk2) chk2.checked = true;
                if (chk3) chk3.checked = false;
            }
            if (pObj) {
                if (chk1) chk1.checked = Boolean(pObj.hasPart1);
                if (chk2) chk2.checked = Boolean(pObj.hasPart2);
                if (chk3) chk3.checked = Boolean(pObj.hasPart3);
            }
        }

        updateManualNoticeHint();
        isManualNoticeModified = false;
    } finally {
        isSyncingManualNotice = false;
    }
}

// 수동 공지 규칙 등록 함수 (구장, 날짜, 시간, 부제, 가격) -> currentParsedNoticeRules에 행 추가
function addManualNoticeRule() {
    const courseInput = document.getElementById('manualNoticeCourse');
    const dateInput = document.getElementById('manualNoticeDate');
    const timeInput = document.getElementById('manualNoticeTime');
    const priceInput = document.getElementById('manualNoticePrice');
    const chk1 = document.getElementById('chkManualNoticePart1');
    const chk2 = document.getElementById('chkManualNoticePart2');
    const chk3 = document.getElementById('chkManualNoticePart3');

    const course = (courseInput?.value || '').trim();
    if (!course) {
        showToast('구장명을 입력하거나 목록에서 선택해주세요.');
        courseInput?.focus();
        return;
    }

    let date = (dateInput?.value || '').trim();
    if (date === '전체' || date === '전체 날짜' || date === '모든 날짜' || date.includes('전체')) {
        date = '';
    }

    const timeRaw = (timeInput?.value || '').trim();
    const parsedTime = parseTimeInputToMinutes(timeRaw);

    const priceRaw = (priceInput?.value || '').trim();
    if (!priceRaw) {
        showToast('공지 금액을 입력해주세요. (예: 7만, 6.5만, 10/1, -2만)');
        priceInput?.focus();
        return;
    }

    const hasP1 = chk1 ? chk1.checked : true;
    const hasP2 = chk2 ? chk2.checked : true;
    const hasP3 = chk3 ? chk3.checked : true;

    if (!hasP1 && !hasP2 && !hasP3) {
        showToast('적용할 부제를 최소 1개 이상 선택해주세요 (1부, 2부, 3부).');
        return;
    }

    const parts = (hasP1 && hasP2 && hasP3) ? null : {
        hasPart1: hasP1,
        hasPart2: hasP2,
        hasPart3: hasP3,
        desc: [hasP1 ? '1부' : '', hasP2 ? '2부' : '', hasP3 ? '3부' : ''].filter(Boolean).join('+')
    };

    const now = new Date();
    const receivedAtStr = `${now.getMonth() + 1}/${now.getDate()} ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
    const timeDesc = parsedTime.isAll ? '전체' : (timeRaw || formatMinutesToTime(parsedTime.startMins, parsedTime.endMins));

    let newRule = null;
    const isMeal = /(?:식사|조식|식음|모닝식사|식포\b)/.test(priceRaw) && !/(?:식사\s*불가|식사\s*미포함|식사\s*별도)/.test(priceRaw);
    const isDiscount = priceRaw.startsWith('-') || /할인|인하|DC|차감/.test(priceRaw);

    if (isMeal) {
        const cleanPricePart = priceRaw.replace(/(?:식사|조식|식음|모닝식사|식포\b)[^0-9./]*/gi, '').trim();
        let manualTargetPrice = null;
        let manualSlashBack = null;
        if (cleanPricePart) {
            if (cleanPricePart.includes('/')) {
                const sp = cleanPricePart.split('/');
                manualTargetPrice = normalizeNoticePrice(sp[0]);
                manualSlashBack = normalizeNoticePrice(sp[1]);
            } else {
                manualTargetPrice = normalizeNoticePrice(cleanPricePart);
            }
        }

        if (manualTargetPrice !== null && manualTargetPrice > 0) {
            // 식사포함 + 가격 동시 지정 수동 공지
            newRule = {
                id: `manual_${Date.now()}_${Math.random().toString(36).substr(2, 5)}`,
                type: 'target',
                course: course,
                date: date,
                year: now.getFullYear(),
                dateRange: null,
                startMins: parsedTime.startMins,
                endMins: parsedTime.endMins,
                timeText: timeDesc,
                price: manualTargetPrice,
                slashBackPrice: manualSlashBack,
                isMeal: true,
                parts: parts,
                receivedAt: receivedAtStr,
                receivedTimestamp: Date.now(),
                rawLine: `[수동추가] ${course} ${date ? `${date} ` : ''}${timeDesc !== '전체' ? `${timeDesc} ` : ''}${parts ? `(${parts.desc}) ` : ''}${manualTargetPrice}만${manualSlashBack ? ` / ${manualSlashBack}만` : ''} 식사포함`,
                fullNoticeText: `■ ${course} [수동 공지]\n날짜: ${date || '전체'}\n시간: ${timeDesc}\n부제: ${parts ? parts.desc : '전체'}\n금액: ${manualTargetPrice}만${manualSlashBack ? ` / ${manualSlashBack}만` : ''}\n식사: 식사포함`
            };
        } else {
            // 순수 식사포함 단독 공지
            newRule = {
                id: `manual_${Date.now()}_${Math.random().toString(36).substr(2, 5)}`,
                type: 'meal',
                course: course,
                date: date || '전체',
                year: now.getFullYear(),
                dateRange: null,
                dateDesc: (date === '전체' || !date) ? '별도공지전까지' : '',
                startMins: parsedTime.startMins,
                endMins: parsedTime.endMins,
                timeText: timeDesc,
                isMeal: true,
                parts: parts,
                receivedAt: receivedAtStr,
                receivedTimestamp: Date.now(),
                rawLine: `[수동추가] ${course} ${date ? `${date} ` : ''}${timeDesc !== '전체' ? `${timeDesc} ` : ''}${parts ? `(${parts.desc}) ` : ''}식사포함`,
                fullNoticeText: `■ ${course} [수동 공지]\n날짜: ${date || '전체'}\n시간: ${timeDesc}\n부제: ${parts ? parts.desc : '전체'}\n식사: 식사포함`
            };
        }
    } else if (isDiscount) {
        const dVal = normalizeNoticePrice(priceRaw.replace(/^-/, ''));
        if (dVal === null || dVal <= 0) {
            showToast('할인 금액을 올바르게 입력해주세요. (예: -2만)');
            priceInput?.focus();
            return;
        }
        newRule = {
            id: `manual_${Date.now()}_${Math.random().toString(36).substr(2, 5)}`,
            type: 'discount',
            course: course,
            date: date,
            year: now.getFullYear(),
            dateRange: null,
            startMins: parsedTime.startMins,
            endMins: parsedTime.endMins,
            timeText: timeDesc,
            discount: dVal,
            parts: parts,
            receivedAt: receivedAtStr,
            receivedTimestamp: Date.now(),
            rawLine: `[수동추가] ${course} ${date ? `${date} ` : ''}${timeDesc !== '전체' ? `${timeDesc} ` : ''}${parts ? `(${parts.desc}) ` : ''}-${dVal}만`,
            fullNoticeText: `■ ${course} [수동 공지]\n날짜: ${date || '전체'}\n시간: ${timeDesc}\n부제: ${parts ? parts.desc : '전체'}\n할인: -${dVal}만`
        };
    } else {
        let priceVal = null;
        let slashBackVal = null;
        if (priceRaw.includes('/')) {
            const slashParts = priceRaw.split('/');
            priceVal = normalizeNoticePrice(slashParts[0]);
            slashBackVal = normalizeNoticePrice(slashParts[1]);
        } else {
            priceVal = normalizeNoticePrice(priceRaw);
        }

        if (priceVal === null || priceVal <= 0) {
            showToast('공지 금액을 올바르게 입력해주세요. (예: 7만, 6.5만, 10/1)');
            priceInput?.focus();
            return;
        }

        newRule = {
            id: `manual_${Date.now()}_${Math.random().toString(36).substr(2, 5)}`,
            type: 'target',
            course: course,
            date: date,
            year: now.getFullYear(),
            dateRange: null,
            startMins: parsedTime.startMins,
            endMins: parsedTime.endMins,
            timeText: timeDesc,
            price: priceVal,
            slashBackPrice: slashBackVal,
            parts: parts,
            receivedAt: receivedAtStr,
            receivedTimestamp: Date.now(),
            rawLine: `[수동추가] ${course} ${date ? `${date} ` : ''}${timeDesc !== '전체' ? `${timeDesc} ` : ''}${parts ? `(${parts.desc}) ` : ''}${priceVal}만${slashBackVal ? ` / ${slashBackVal}만` : ''}`,
            fullNoticeText: `■ ${course} [수동 공지]\n날짜: ${date || '전체'}\n시간: ${timeDesc}\n부제: ${parts ? parts.desc : '전체'}\n금액: ${priceVal}만${slashBackVal ? ` / ${slashBackVal}만` : ''}`
        };
    }

    // currentParsedNoticeRules 목록에 항목으로 추가
    currentParsedNoticeRules.push(newRule);
    renderParsedNoticeRules();
    updateManualNoticeHint();

    // 시간 및 금액 입력칸 초기화
    if (timeInput) timeInput.value = '';
    if (priceInput) priceInput.value = '';
    showToast(`[${timeDesc}] ${priceRaw} 규칙이 추가되었습니다. (총 ${currentParsedNoticeRules.length}개)`);
}

// 클럽72 전용 판별 헬퍼 (클럽72, 클럽72(레이크/클래식), 클럽72(오션), 클럽72(하늘), 레/클 등 모든 명칭 일치)
function isClub72Course(golfName, rawGolfName = '', golfmonGolfName = '') {
    const names = [golfName, rawGolfName, golfmonGolfName]
        .filter(Boolean)
        .map(n => String(n).trim().replace(/[\s\-_]/g, '').toLowerCase());
    return names.some(n =>
        n.includes('클럽72') ||
        n.includes('club72') ||
        n.includes('스카이72') ||
        n.includes('sky72') ||
        n.includes('레이크/클래식') ||
        n.includes('클래식/레이크') ||
        n === '레/클' ||
        n === '레클'
    );
}

// 모든 활성 공지 규칙을 현재 테이블에 일괄 적용 (누적 적용 보장)
function applyAllActiveNoticeRules() {
    // 적용 전 만료된 공지 규칙 자동 정리
    pruneExpiredNoticeRules();

    const tbody = document.getElementById('tableBody');
    if (!tbody) return 0;
    const trs = Array.from(tbody.querySelectorAll('tr'));
    if (trs.length === 0) return 0;

    let appliedTotal = 0;
    const matchedCourses = new Set();

    trs.forEach(tr => {
        const cells = tr.querySelectorAll('td');
        if (cells.length < 5) return;

        // 원본 기준금액 및 식사포함 상태 초기 복원 후 매칭
        const origTotalFeeStr = tr.dataset.origTotalFee || tr.dataset.origBaseFee || cells[4].textContent.trim();
        tr.dataset.totalFee = origTotalFeeStr;
        tr.dataset.baseFee = origTotalFeeStr;
        if (tr.dataset.origFieldFee) tr.dataset.fieldFee = tr.dataset.origFieldFee;
        if (tr.dataset.origPrepaidFee) tr.dataset.prepaidFee = tr.dataset.origPrepaidFee;

        if (tr.dataset.origSlashFrontVal) {
            tr.dataset.slashFrontVal = tr.dataset.origSlashFrontVal;
        } else if (tr.dataset.slashFrontVal) {
            tr.dataset.origSlashFrontVal = tr.dataset.slashFrontVal;
        }

        // 식사포함 원본 보존 및 복원 (공지 해제/만료 시 원상 복귀)
        if (tr.dataset.origIsMeal === undefined) {
            tr.dataset.origIsMeal = tr.dataset.isMeal || 'false';
        } else {
            tr.dataset.isMeal = tr.dataset.origIsMeal;
        }

        delete tr.dataset.noticeAdjusted;
        delete tr.dataset.noticePrice;
        delete tr.dataset.noticeDiscount;
        delete tr.dataset.noticeTagDesc;
        delete tr.dataset.noticeType;
        delete tr.dataset.noticeReceivedAt;
        delete tr.dataset.noticeHasMeal;
        delete tr.dataset.coursePriceAdj;

        const rowDate = cells[0]?.textContent.trim() || '';
        const rowGolf = cells[2]?.textContent.trim() || '';
        const rowTime = cells[3]?.textContent.trim() || '';
        const rowRawGolf = tr.dataset.rawGolf || rowGolf;
        const rowGolfmonGolf = tr.dataset.golfmonGolf || '';
        const rowTimeMins = timeToMinutes(rowTime);

        const roomType = (tr.dataset.roomType || '').trim();
        const isPrepaid = tr.dataset.isPrepaid === 'true';
        const isTransferRow = (roomType === '양도');

        // 선티방 / 대기방 / 확정 판별
        // ★ [사용자 요청] 확정, 선티를 제외하고 (선티는 무조건 원래 선티가로 보존!)
        const isSeontiOrConfirmed = isTransferRow
            ? (
                tr.dataset.manualSeonti === 'true' ||
                tr.dataset.isConfirmed === 'true' ||
                tr.dataset.isSeontiOrDaegi === 'true' ||
                (typeof isConfirmedTr === 'function' && isConfirmedTr(tr)) ||
                (tr.dataset.roomType || '').includes('선티') ||
                /선티|확정/.test(tr.dataset.fullRawText || '')
            )
            : (
                tr.dataset.isSeontiOrDaegi === 'true' ||
                tr.dataset.manualSeonti === 'true' ||
                tr.dataset.isConfirmed === 'true' ||
                tr.dataset.isDaegi === 'true' ||
                (typeof isDaegiTr === 'function' && isDaegiTr(tr)) ||
                (typeof isConfirmedTr === 'function' && isConfirmedTr(tr)) ||
                roomType === '선티방' ||
                roomType === '대기방' ||
                roomType.includes('선티') ||
                roomType.includes('대기') ||
                /선티|확정|대기/.test(tr.dataset.fullRawText || '') ||
                /^[123]인$/.test(cells[7]?.textContent.trim() || '')
            );

        if (isSeontiOrConfirmed) {
            // ★ [사용자 요청] 확정, 선티는 제외! (선티는 무조건 원래 선티가로 보존!)
            delete tr.dataset.coursePriceAdj;
            delete tr.dataset.noticeAdjusted;
            delete tr.dataset.noticePrice;
            delete tr.dataset.noticeDiscount;
            delete tr.dataset.noticeTagDesc;
            delete tr.dataset.noticeType;
            delete tr.dataset.noticeReceivedAt;
            delete tr.dataset.noticeReceivedTimestamp;

            const origTotal = tr.dataset.origTotalFee || tr.dataset.origBaseFee || cells[4].textContent.trim();
            const origField = tr.dataset.origFieldFee || '';
            const origPre = tr.dataset.origPrepaidFee || '';
            tr.dataset.totalFee = origTotal;
            tr.dataset.baseFee = origTotal;
            if (origField) tr.dataset.fieldFee = origField;
            if (origPre) tr.dataset.prepaidFee = origPre;

            if (origField && origPre) {
                cells[4].textContent = `${origField} / ${origPre} (합 ${origTotal})`;
            } else if (origTotal) {
                cells[4].textContent = origTotal;
            }
            return;
        }

        // 원본 데이터 기준 선입금 액수 판별 (예: [현장17만+선입1만] -> 1.0, 15만[현장15만] -> 0)
        let rowPrepaidAmount = parseFloat(tr.dataset.prepaidAmount) || 0;
        let hasSlashFee = tr.dataset.hasSlashFee === 'true';
        let slashBackVal = parseFloat(tr.dataset.slashBackVal) || 0;

        if (rowPrepaidAmount <= 0) {
            const inputVal = document.getElementById('inputText')?.value || '';
            if (inputVal) {
                const lines = inputVal.split('\n');
                for (const l of lines) {
                    const cleanT = rowTime.replace(':', '');
                    const lClean = l.replace(':', '');
                    if (lClean.includes(cleanT) || (rowTime.includes(':') && l.includes(rowTime))) {
                        const plusMatch = l.match(/(?:선입(?:금)?|선결제)\s*[:=\-]?\s*([0-9.]+)\s*(?:만|만원)?/i);
                        if (plusMatch) {
                            rowPrepaidAmount = parseFloat(plusMatch[1]) || 1.0;
                            tr.dataset.prepaidAmount = String(rowPrepaidAmount);
                            break;
                        }
                        const slashMatch = l.match(/([0-9.]+)\s*(?:만|만원)?\s*\/\s*([0-9.]+)\s*(?:만|만원)(?!\s*[인명팀분])/);
                        if (slashMatch) {
                            hasSlashFee = true;
                            slashBackVal = parseFloat(slashMatch[2]) || 0;
                            rowPrepaidAmount = slashBackVal;
                            tr.dataset.hasSlashFee = 'true';
                            tr.dataset.slashBackVal = String(slashBackVal);
                            tr.dataset.slashFrontVal = slashMatch[1];
                            tr.dataset.origSlashFrontVal = slashMatch[1];
                            tr.dataset.prepaidAmount = String(rowPrepaidAmount);
                            break;
                        }
                    }
                }
            }
        }

        const hasPrepaidDeposit = rowPrepaidAmount > 0;
        const prepaidAddAmount = rowPrepaidAmount;

        // 특정구장 가격 가감 계산 및 클럽72 구장 판별
        const rawCourseAdj = getCoursePriceAdjustment(rowGolf, rowRawGolf, rowGolfmonGolf, rowTime) || 0;
        const isClub72 = isClub72Course(rowGolf, rowRawGolf, rowGolfmonGolf);

        // 공지 규칙 매칭
        let matchedRule = null;
        if (isNoticeRulesActive && isNoticeFeatureAvailable()) {
            const candidates = activeNoticeRules.filter(rule => {
                if (rule.course && !isCourseMatch(rule.course, rowGolf, rowRawGolf, rowGolfmonGolf)) {
                    return false;
                }
                if (rule.dateRange) {
                    if (!isDateInRange(rowDate, rule.dateRange)) return false;
                } else if (rule.date) {
                    if (!isDateMatch(rule.date, rowDate)) return false;
                }
                if (rule.type === 'target') {
                    if (rowTimeMins < rule.startMins || rowTimeMins > rule.endMins) return false;
                    if (rule.parts && !isTimeInPart(rowTimeMins, rule.parts)) return false;
                } else if (rule.type === 'discount') {
                    if (!isTimeInPart(rowTimeMins, rule.parts)) return false;
                } else if (rule.type === 'meal') {
                    if (rowTimeMins < rule.startMins || rowTimeMins > rule.endMins) return false;
                    if (rule.parts && !isTimeInPart(rowTimeMins, rule.parts)) return false;
                }
                if (rule.caddyType === 'nocaddy') {
                    if (!isNoCaddyTr(tr)) return false;
                } else if (rule.caddyType === 'caddy') {
                    if (isNoCaddyTr(tr)) return false;
                }
                return true;
            });

            const matchedMealRule = candidates.find(r => r.isMeal === true || r.type === 'meal');
            if (matchedMealRule) {
                tr.dataset.isMeal = 'true';
                tr.dataset.noticeHasMeal = 'true';
            }

            const priceCandidates = candidates.filter(r => (r.type === 'target' && r.price !== null && r.price !== undefined && !isNaN(Number(r.price))) || r.type === 'discount');
            if (priceCandidates.length > 0) {
                priceCandidates.sort((a, b) => {
                    const timeA = a.receivedTimestamp || 0;
                    const timeB = b.receivedTimestamp || 0;
                    if (timeA !== timeB) return timeB - timeA;

                    const caddyWeightA = a.caddyType ? 1 : 2;
                    const caddyWeightB = b.caddyType ? 1 : 2;
                    if (caddyWeightA !== caddyWeightB) return caddyWeightA - caddyWeightB;

                    const durA = (a.endMins !== undefined && a.startMins !== undefined) ? (a.endMins - a.startMins) : 1440;
                    const durB = (b.endMins !== undefined && b.startMins !== undefined) ? (b.endMins - b.startMins) : 1440;
                    if (durA !== durB) return durA - durB;

                    const isExactA = (a.date && a.date !== '전체' && a.date !== '전체날짜' && a.date !== '별도공지전까지' && a.date !== '상시') ? 1 : 2;
                    const isExactB = (b.date && b.date !== '전체' && b.date !== '전체날짜' && b.date !== '별도공지전까지' && b.date !== '상시') ? 1 : 2;
                    if (isExactA !== isExactB) return isExactA - isExactB;

                    const dateWeightA = a.date ? 1 : 2;
                    const dateWeightB = b.date ? 1 : 2;
                    if (dateWeightA !== dateWeightB) return dateWeightA - dateWeightB;

                    const typeWeightA = a.type === 'target' ? 1 : 2;
                    const typeWeightB = b.type === 'target' ? 1 : 2;
                    return typeWeightA - typeWeightB;
                });
                matchedRule = priceCandidates[0];
            } else if (matchedMealRule) {
                matchedRule = matchedMealRule;
            }
        }

        // ★ [사용자 핵심 요구사항]:
        // 클럽72, 클럽72(레이크/클래식), 클럽72(오션)은 공지가, 특정구장가격변경이 둘다 있을경우에 공지가만 적용!
        // 그 외 구장은 특정구장 가격변경과 공지가가 둘다 있을경우 둘다 적용!
        const hasPriceNotice = matchedRule && (matchedRule.type === 'target' || matchedRule.type === 'discount');
        let effectiveCourseAdj = rawCourseAdj;
        if (hasPriceNotice && isClub72) {
            // 클럽72 계열: 공지가와 특정구장가격변경이 둘다 있으면 공지가만 적용 (특정구장가격변경 배제)
            effectiveCourseAdj = 0;
        }

        if (matchedRule) {
            const hasMealNoticeApplied = tr.dataset.noticeHasMeal === 'true' || tr.dataset.isMeal === 'true';
            const mealNoticeSuffix = (hasMealNoticeApplied && matchedRule.type !== 'meal') ? ' + 식사' : '';
            appliedTotal++;
            matchedCourses.add(rowGolf);

            const caddyDesc = matchedRule.caddyType === 'nocaddy' ? ' [셀프]' : (matchedRule.caddyType === 'caddy' ? ' [캐디]' : '');
            if (matchedRule.type === 'target') {
                const noticePrice = (matchedRule.price !== null && matchedRule.price !== undefined && !isNaN(Number(matchedRule.price))) ? Number(matchedRule.price) : null;
                if (noticePrice === null) {
                    // 유효 금액이 없는 target 룰은 금액 수정 생략 (식사포함 등만 적용)
                } else {
                    let noticeFieldFee = noticePrice;
                    let noticePrepaidFee = hasPrepaidDeposit ? prepaidAddAmount : 0;

                    // 특정구장 가격변경 적용 (클럽72는 공지가만, 그 외 구장은 둘다 적용!)
                    if (effectiveCourseAdj !== 0) {
                        noticeFieldFee = Math.max(0, Math.round((noticeFieldFee + effectiveCourseAdj) * 100) / 100);
                        tr.dataset.coursePriceAdj = String(effectiveCourseAdj);
                    } else {
                        delete tr.dataset.coursePriceAdj;
                    }

                    const finalVal = Math.round((noticeFieldFee + noticePrepaidFee) * 100) / 100;

                    if (hasPrepaidDeposit) {
                        tr.dataset.noticeTagDesc = `${noticePrice}만 / ${prepaidAddAmount}만${caddyDesc}${mealNoticeSuffix}`;
                    } else {
                        tr.dataset.noticeTagDesc = `${noticePrice}만${caddyDesc}${mealNoticeSuffix}`;
                    }

                    tr.dataset.noticeAdjusted = 'true';
                    tr.dataset.noticeType = 'target';
                    tr.dataset.noticePrice = String(noticePrice);
                    tr.dataset.noticeCaddyType = matchedRule.caddyType || '';
                    tr.dataset.noticeReceivedAt = formatNoticeReceivedTime(matchedRule.receivedAt, matchedRule.receivedTimestamp);
                    tr.dataset.noticeReceivedTimestamp = matchedRule.receivedTimestamp ? String(matchedRule.receivedTimestamp) : '';
                    if (hasSlashFee) {
                        tr.dataset.slashFrontVal = String(noticeFieldFee);
                    }

                    const finalFeeStr = Number.isInteger(finalVal) ? String(finalVal) : finalVal.toFixed(1);
                    const finalFieldStr = Number.isInteger(noticeFieldFee) ? String(noticeFieldFee) : noticeFieldFee.toFixed(1);
                    const finalPrepaidStr = noticePrepaidFee > 0 ? (Number.isInteger(noticePrepaidFee) ? String(noticePrepaidFee) : noticePrepaidFee.toFixed(1)) : '';
                    tr.dataset.baseFee = finalFeeStr;
                    tr.dataset.totalFee = finalFeeStr;
                    tr.dataset.fieldFee = finalFieldStr;
                    tr.dataset.prepaidFee = finalPrepaidStr;
                    if (finalFieldStr && finalPrepaidStr) {
                        cells[4].textContent = `${finalFieldStr} / ${finalPrepaidStr} (합 ${finalFeeStr})`;
                    } else {
                        cells[4].textContent = finalFeeStr;
                    }
                }
            } else if (matchedRule.type === 'discount') {
                const discount = (matchedRule.discount !== null && matchedRule.discount !== undefined && !isNaN(Number(matchedRule.discount))) ? Number(matchedRule.discount) : 0;
                const origTotal = parseFloat(tr.dataset.origTotalFee || tr.dataset.origBaseFee || tr.dataset.baseFee) || 0;
                let origFrontPrice = origTotal;
                if (hasPrepaidDeposit) {
                    origFrontPrice = Math.max(0, origTotal - prepaidAddAmount);
                } else if (hasSlashFee && slashBackVal > 0) {
                    origFrontPrice = parseFloat(tr.dataset.origSlashFrontVal || tr.dataset.slashFrontVal) || Math.max(0, origTotal - slashBackVal);
                }

                let discountedFront = Math.max(0, Math.round((origFrontPrice - discount) * 100) / 100);

                // 특정구장 가격변경 적용 (클럽72는 공지가만, 그 외 구장은 둘다 적용!)
                if (effectiveCourseAdj !== 0) {
                    discountedFront = Math.max(0, Math.round((discountedFront + effectiveCourseAdj) * 100) / 100);
                    tr.dataset.coursePriceAdj = String(effectiveCourseAdj);
                } else {
                    delete tr.dataset.coursePriceAdj;
                }

                const noticeFieldFee = discountedFront;
                const noticePrepaidFee = hasPrepaidDeposit ? prepaidAddAmount : 0;
                const finalVal = Math.round((discountedFront + noticePrepaidFee) * 100) / 100;

                tr.dataset.noticeAdjusted = 'true';
                tr.dataset.noticeType = 'discount';
                tr.dataset.noticeDiscount = String(discount);
                tr.dataset.noticeReceivedAt = formatNoticeReceivedTime(matchedRule.receivedAt, matchedRule.receivedTimestamp);
                tr.dataset.noticeReceivedTimestamp = matchedRule.receivedTimestamp ? String(matchedRule.receivedTimestamp) : '';
                const pDesc = matchedRule.parts?.desc ? ` (${matchedRule.parts.desc})` : '';
                tr.dataset.noticeTagDesc = `-${discount}만${pDesc}${mealNoticeSuffix}`;

                const finalFeeStr = Number.isInteger(finalVal) ? String(finalVal) : finalVal.toFixed(1);
                const finalFieldStr = Number.isInteger(noticeFieldFee) ? String(noticeFieldFee) : noticeFieldFee.toFixed(1);
                const finalPrepaidStr = noticePrepaidFee > 0 ? (Number.isInteger(noticePrepaidFee) ? String(noticePrepaidFee) : noticePrepaidFee.toFixed(1)) : '';
                tr.dataset.baseFee = finalFeeStr;
                tr.dataset.totalFee = finalFeeStr;
                tr.dataset.fieldFee = finalFieldStr;
                tr.dataset.prepaidFee = finalPrepaidStr;
                if (finalFieldStr && finalPrepaidStr) {
                    cells[4].textContent = `${finalFieldStr} / ${finalPrepaidStr} (합 ${finalFeeStr})`;
                } else {
                    cells[4].textContent = finalFeeStr;
                }
            } else if (matchedRule.type === 'meal') {
                // 순수 식사포함 단독 공지 적용
                tr.dataset.noticeAdjusted = 'true';
                tr.dataset.noticeType = 'meal';
                const mealPartDesc = matchedRule.parts?.desc ? ` (${matchedRule.parts.desc})` : (matchedRule.timeText && matchedRule.timeText !== '전타임' && matchedRule.timeText !== '전체' ? ` (${matchedRule.timeText})` : '');
                tr.dataset.noticeTagDesc = `식사포함${mealPartDesc}`;
                tr.dataset.noticeReceivedAt = formatNoticeReceivedTime(matchedRule.receivedAt, matchedRule.receivedTimestamp);
                tr.dataset.noticeReceivedTimestamp = matchedRule.receivedTimestamp || '';

                const origTotal = parseFloat(tr.dataset.origTotalFee || tr.dataset.origBaseFee || tr.dataset.baseFee) || 0;
                const origPre = parseFloat(tr.dataset.origPrepaidFee) || 0;
                let origField = parseFloat(tr.dataset.origFieldFee) || (origTotal - origPre);
                let finalVal = origTotal;

                if (rawCourseAdj !== 0) {
                    origField = Math.max(0, Math.round((origField + rawCourseAdj) * 100) / 100);
                    finalVal = Math.round((origField + origPre) * 100) / 100;
                    tr.dataset.coursePriceAdj = String(rawCourseAdj);
                } else {
                    delete tr.dataset.coursePriceAdj;
                }

                const finalFeeStr = (finalVal !== null && finalVal !== undefined && !isNaN(finalVal)) ? (Number.isInteger(finalVal) ? String(finalVal) : finalVal.toFixed(1)) : '';
                const finalFieldStr = (origField > 0) ? (Number.isInteger(origField) ? String(origField) : origField.toFixed(1)) : '';
                const finalPrepaidStr = (origPre > 0) ? (Number.isInteger(origPre) ? String(origPre) : origPre.toFixed(1)) : '';
                tr.dataset.baseFee = finalFeeStr;
                tr.dataset.totalFee = finalFeeStr;
                tr.dataset.fieldFee = finalFieldStr;
                tr.dataset.prepaidFee = finalPrepaidStr;

                if (finalFieldStr && finalPrepaidStr) {
                    cells[4].textContent = `${finalFieldStr} / ${finalPrepaidStr} (합 ${finalFeeStr})`;
                } else {
                    cells[4].textContent = finalFeeStr;
                }
            }
        } else {
            // 공지 미적용 대상
            delete tr.dataset.noticeAdjusted;
            delete tr.dataset.noticeType;
            delete tr.dataset.noticePrice;
            delete tr.dataset.noticeDiscount;
            delete tr.dataset.noticeTagDesc;
            delete tr.dataset.noticeReceivedAt;

            const origTotal = parseFloat(tr.dataset.origTotalFee || tr.dataset.origBaseFee || tr.dataset.baseFee) || 0;
            const origPre = parseFloat(tr.dataset.origPrepaidFee) || 0;
            let origField = parseFloat(tr.dataset.origFieldFee) || (origTotal - origPre);
            let finalVal = origTotal;

            // 특정구장 가격 가감 적용 (부제별 반영)
            if (rawCourseAdj !== 0) {
                origField = Math.max(0, Math.round((origField + rawCourseAdj) * 100) / 100);
                finalVal = Math.round((origField + origPre) * 100) / 100;
                tr.dataset.coursePriceAdj = String(rawCourseAdj);
            } else {
                delete tr.dataset.coursePriceAdj;
            }

            const finalFeeStr = (finalVal !== null && finalVal !== undefined && !isNaN(finalVal)) ? (Number.isInteger(finalVal) ? String(finalVal) : finalVal.toFixed(1)) : '';
            const finalFieldStr = (origField > 0) ? (Number.isInteger(origField) ? String(origField) : origField.toFixed(1)) : '';
            const finalPrepaidStr = (origPre > 0) ? (Number.isInteger(origPre) ? String(origPre) : origPre.toFixed(1)) : '';
            tr.dataset.baseFee = finalFeeStr;
            tr.dataset.totalFee = finalFeeStr;
            tr.dataset.fieldFee = finalFieldStr;
            tr.dataset.prepaidFee = finalPrepaidStr;

            if (finalFieldStr && finalPrepaidStr) {
                cells[4].textContent = `${finalFieldStr} / ${finalPrepaidStr} (합 ${finalFeeStr})`;
            } else {
                cells[4].textContent = finalFeeStr;
            }
        }
    });

    renderCardList();
    saveCurrentTableState();
    return appliedTotal;
}

// updateLivePrepaidFees 하위 호환 별칭 (사전 복원 및 설정 변경 시 호출)
const updateLivePrepaidFees = applyAllActiveNoticeRules;

// 공지 수신 일시 정규화 (예: "2026-10-16 16:18:23" -> "10/16 16:18", 텍스트 내 카톡 시간/발송일 헤더 탐색 또는 현재 시간)
function resolveNoticeReceivedTime(text, explicitTime = null) {
    // 1. 수집기 등에서 명시적으로 전달받은 수신 시각이 있는 경우
    if (explicitTime) {
        if (typeof explicitTime === 'string') {
            const m = explicitTime.match(/(\d{1,2})[./\-](\d{1,2})\s+(\d{1,2}:\d{2})/);
            if (m) {
                return `${parseInt(m[1], 10)}/${parseInt(m[2], 10)} ${m[3]}`;
            }
            const mIso = explicitTime.match(/(\d{4})-(\d{2})-(\d{2})[T\s](\d{2}:\d{2})/);
            if (mIso) {
                return `${parseInt(mIso[2], 10)}/${parseInt(mIso[3], 10)} ${mIso[4]}`;
            }
            return explicitTime.trim();
        } else if (explicitTime instanceof Date) {
            const m = explicitTime.getMonth() + 1;
            const d = explicitTime.getDate();
            const h = String(explicitTime.getHours()).padStart(2, '0');
            const min = String(explicitTime.getMinutes()).padStart(2, '0');
            return `${m}/${d} ${h}:${min}`;
        }
    }

    // 2. 텍스트 본문 첫머리에서 카톡 헤더 시간 탐색 (예: "[오후 4:18]", "10/16 16:18")
    if (text && typeof text === 'string') {
        const lines = text.split('\n').slice(0, 5);
        for (const l of lines) {
            const kakaoTimeMatch = l.match(/\[(오전|오후)\s*(\d{1,2}):(\d{2})\]/);
            if (kakaoTimeMatch) {
                const isPm = kakaoTimeMatch[1] === '오후';
                let h = parseInt(kakaoTimeMatch[2], 10);
                if (isPm && h < 12) h += 12;
                if (!isPm && h === 12) h = 0;
                const hh = String(h).padStart(2, '0');
                const mm = kakaoTimeMatch[3];
                const now = new Date();
                return `${now.getMonth() + 1}/${now.getDate()} ${hh}:${mm}`;
            }
            const dtMatch = l.match(/(\d{1,2})[./\-](\d{1,2})\s+(\d{1,2}:\d{2})/);
            if (dtMatch) {
                return `${parseInt(dtMatch[1], 10)}/${parseInt(dtMatch[2], 10)} ${dtMatch[3]}`;
            }
        }
    }

    // 3. 기본값: 현재 일시 (월/일 시:분)
    const now = new Date();
    const m = now.getMonth() + 1;
    const d = now.getDate();
    const h = String(now.getHours()).padStart(2, '0');
    const min = String(now.getMinutes()).padStart(2, '0');
    return `${m}/${d} ${h}:${min}`;
}

// 텍스트를 전달받아 공지 파싱 및 누적 등록 & 즉시 적용
function applyNoticeFromText(text, silent = false, receivedTime = null) {
    if (isNonGreenFeeEventNotice(text)) {
        if (!silent) showToast('브런치/모닝박스 등 식음·이벤트 공지는 그린피 할인 공지가 아니므로 자동 제외되었습니다.');
        return 0;
    }

    const receivedAtStr = resolveNoticeReceivedTime(text, receivedTime);
    const newRules = parseNoticeText(text);
    if (!newRules || newRules.length === 0) {
        if (!silent) showToast('적용할 유효한 공지 규칙을 찾을 수 없습니다.');
        return 0;
    }

    // 각 규칙에 표준 구장명, 수신 일시 및 타임스탬프, 공지 전문 원문 보존
    const nowTs = Date.now();
    newRules.forEach(r => {
        r.course = normalizeNoticeCourseName(r.course);
        r.receivedAt = receivedAtStr;
        r.receivedTimestamp = nowTs;
        r.fullNoticeText = text;
    });

    // 이미 날짜가 지난 만료 공지인지 검사
    const nonExpiredRules = newRules.filter(r => !isNoticeRuleExpired(r));
    // 사용자가 직접 수동 등록(!silent)한 경우, 과거 날짜 테스트나 수동 작업을 위해 등록 허용
    const rulesToRegister = (nonExpiredRules.length > 0 || silent) ? nonExpiredRules : newRules;
    if (rulesToRegister.length === 0) {
        if (!silent) showToast('⏰ 공지 날짜가 이미 지나 만료된 공지입니다.');
        return 0;
    }

    // 새로 등록할 공지 대상 구장 식별
    const newCourses = new Set(rulesToRegister.map(r => normalizeNoticeCourseName(r.course)).filter(Boolean));

    // 사용자가 해당 구장에 대해 신규 공지를 등록하는 것이므로 로컬 삭제 기록(Tombstone) 해제
    newCourses.forEach(cName => removeLocallyDeletedNoticeCourse(cName));

    // ★ [사용자 핵심 요구사항] 날짜/시간대가 다른 기존 공지는 지우지 않고 병합(보존)!
    // 동일 구장 + 동일 도메인(가격/식사) + 동일 날짜 + 겹치는 시간대 슬롯인 경우에만 최신 공지로 대체 갱신
    if (rulesToRegister.length > 0) {
        activeNoticeRules = activeNoticeRules.filter(existing => {
            if (!existing || !existing.course) return false;
            const hasConflict = rulesToRegister.some(incoming => isNoticeRuleSlotConflict(existing, incoming));
            return !hasConflict;
        });
        activeNoticeRules.push(...rulesToRegister);
    }

    // 해당 구장의 규칙 중 원문 전문이 비어있는 경우 보정
    newCourses.forEach(cName => {
        activeNoticeRules.forEach(ar => {
            if (isCourseMatch(cName, ar.course) && !ar.fullNoticeText && text) {
                ar.fullNoticeText = text;
            }
        });
    });

    saveActiveNoticeRules();

    const appliedCount = applyAllActiveNoticeRules();
    renderActiveNoticeChips();

    if (!silent) {
        const courseNames = Array.from(newCourses).join(', ') || '공지 구장';
        const timeInfo = receivedAtStr ? ` [수신: ${receivedAtStr}]` : '';
        if (appliedCount > 0) {
            showToast(`[${courseNames}] 공지가 적용되었습니다!${timeInfo} (해당 날짜까지 자동 저장 유지)`);
        } else {
            showToast(`[${courseNames}] 공지 등록 완료${timeInfo} (해당 날짜까지 저장되며 새 티타임 변환 시 자동 적용)`);
        }
    }

    return appliedCount;
}

function escapeHtml(str) {
    if (!str) return '';
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
}

// 공지 금액 적용 취소 및 원래 금액 복구
function revertNoticeRules() {
    activeNoticeRules = [];
    saveActiveNoticeRules();

    const tbody = document.getElementById('tableBody');
    if (!tbody) return;
    const trs = Array.from(tbody.querySelectorAll('tr'));
    let revertCount = 0;

    trs.forEach(tr => {
        if (tr.dataset.noticeAdjusted === 'true' || tr.dataset.origBaseFee) {
            revertCount++;
            const origTotal = tr.dataset.origTotalFee || tr.dataset.origBaseFee || tr.dataset.baseFee;
            const origField = tr.dataset.origFieldFee || '';
            const origPre = tr.dataset.origPrepaidFee || '';
            tr.dataset.baseFee = origTotal;
            tr.dataset.totalFee = origTotal;
            tr.dataset.fieldFee = origField;
            tr.dataset.prepaidFee = origPre;
            if (tr.dataset.origSlashFrontVal) {
                tr.dataset.slashFrontVal = tr.dataset.origSlashFrontVal;
            }
            delete tr.dataset.noticeAdjusted;
            delete tr.dataset.noticePrice;
            delete tr.dataset.noticeDiscount;
            delete tr.dataset.noticeTagDesc;
            delete tr.dataset.noticeType;
            delete tr.dataset.noticeReceivedAt;

            const cells = tr.querySelectorAll('td');
            if (cells.length >= 5) {
                const origVal = parseFloat(origTotal);
                if (!isNaN(origVal)) {
                    // 특정구장 가격 가감 적용 복원 (부제별 반영 - 선티/대기방 제외, 일반 양도 타임은 정상 반영, 확정/선티 양도는 제외)
                    const roomType = (tr.dataset.roomType || '').trim();
                    const isTransferRow = (roomType === '양도');
                    const isSeontiOrDaegi = isTransferRow
                        ? (
                            tr.dataset.manualSeonti === 'true' ||
                            tr.dataset.isConfirmed === 'true' ||
                            tr.dataset.isSeontiOrDaegi === 'true' ||
                            (typeof isConfirmedTr === 'function' && isConfirmedTr(tr))
                        )
                        : (
                            tr.dataset.isSeontiOrDaegi === 'true' ||
                            tr.dataset.manualSeonti === 'true' ||
                            tr.dataset.isConfirmed === 'true' ||
                            tr.dataset.isDaegi === 'true' ||
                            (typeof isDaegiTr === 'function' && isDaegiTr(tr)) ||
                            (typeof isConfirmedTr === 'function' && isConfirmedTr(tr)) ||
                            roomType === '선티방' ||
                            roomType === '대기방' ||
                            roomType.includes('선티') ||
                            roomType.includes('대기') ||
                            /^[123]인$/.test(cells[7]?.textContent.trim() || '')
                        );
                    const rowGolf = cells[2]?.textContent.trim() || '';
                    const rowRawGolf = tr.dataset.rawGolf || rowGolf;
                    const rowGolfmonGolf = tr.dataset.golfmonGolf || '';
                    const rowTime = cells[3]?.textContent.trim() || '';
                    const courseAdj = !isSeontiOrDaegi ? getCoursePriceAdjustment(rowGolf, rowRawGolf, rowGolfmonGolf, rowTime) : 0;
                    let finalVal = origVal;
                    let adjField = parseFloat(origField) || (origVal - (parseFloat(origPre) || 0));
                    if (courseAdj !== 0) {
                        adjField = Math.max(0, Math.round((adjField + courseAdj) * 100) / 100);
                        finalVal = Math.round((adjField + (parseFloat(origPre) || 0)) * 100) / 100;
                        tr.dataset.coursePriceAdj = courseAdj.toString();
                    } else {
                        delete tr.dataset.coursePriceAdj;
                    }
                    const finalFeeStr = Number.isInteger(finalVal) ? finalVal.toString() : finalVal.toFixed(1);
                    const finalFieldStr = (adjField > 0) ? (Number.isInteger(adjField) ? adjField.toString() : adjField.toFixed(1)) : '';
                    tr.dataset.baseFee = finalFeeStr;
                    tr.dataset.totalFee = finalFeeStr;
                    tr.dataset.fieldFee = finalFieldStr;
                    if (finalFieldStr && origPre && parseFloat(origPre) > 0) {
                        cells[4].textContent = `${finalFieldStr} / ${origPre} (합 ${finalFeeStr})`;
                    } else {
                        cells[4].textContent = finalFeeStr;
                    }
                } else {
                    cells[4].textContent = (origField && origPre && parseFloat(origPre) > 0) ? `${origField} / ${origPre} (합 ${origTotal})` : origTotal;
                }
            }
        }
    });

    renderActiveNoticeChips();
    renderCardList();
    saveCurrentTableState();

    if (revertCount > 0) {
        showToast(`공지 적용 ${revertCount}건이 취소되고 원래 금액으로 복구되었습니다.`);
    } else {
        showToast('적용된 공지가 없습니다.');
    }
}

// ========================================================
// 공지 클라우드 상호 동기화 (전체 사용자 공지 취합 & 실시간 공유 & 관리자 삭제 동기화)
// - A가 등록한 공지 자동 업로드 + B가 등록한 공지 다운로드 취합
// - 관리자가 특정 공지 또는 전체 공지를 삭제한 경우 전체 사용자에게 자동 삭제 반영!
// ========================================================
// ========================================================
// 공지 클라우드 상호 동기화 (전체 사용자 공지 취합 & 실시간 공유 & 관리자 삭제 동기화)
// - 1차: 구글 스프레드시트 실시간 상호 취합 (업로드 & 다운로드)
// - 2차: GitHub 클라우드 원격 저장소 및 로컬 공지 패키지 자동 폴백 (서버 무장애 상시 보장)
// ========================================================
async function syncNoticesWithCloud(isRetry = false, isSilent = false) {
    const btnSync = document.getElementById('btnSyncNoticeCloud');
    const btnHeaderSync = document.getElementById('btnHeaderNoticeSync');
    if (btnSync && !isRetry && !isSilent) {
        btnSync.disabled = true;
        btnSync.classList.add('syncing');
        btnSync.innerHTML = '동기화 중...';
    }
    if (btnHeaderSync && !isRetry && !isSilent) {
        btnHeaderSync.disabled = true;
        btnHeaderSync.classList.add('syncing');
        btnHeaderSync.title = '전체 사용자 공지 동기화 진행 중...';
    }

    try {
        loadActiveNoticeRules();

        const uId = (currentAuthUser && (currentAuthUser.id || currentAuthUser.name)) ? (currentAuthUser.id || currentAuthUser.name) : '사용자';
        const uPw = (currentAuthUser && currentAuthUser.pw) ? currentAuthUser.pw : '1234';
        const uName = (currentAuthUser && currentAuthUser.name) ? currentAuthUser.name : uId;

        const localDeleted = getLocallyDeletedNoticeCourses();
        const deletedCoursesList = Object.entries(localDeleted).map(([c, ts]) => ({ course: c, deletedTimestamp: ts }));

        const payload = {
            action: 'sync_notices',
            id: uId,
            userId: uId,
            password: uPw,
            pw: uPw,
            userName: uName,
            rules: activeNoticeRules || [],
            deletedCourses: deletedCoursesList
        };

        const rawApiUrl = (typeof getAuthApiUrl === 'function' ? getAuthApiUrl() : '') || currentAuthApiUrl || DEFAULT_AUTH_API_URL;
        const apiUrl = cleanGoogleWebAppUrl(rawApiUrl);

        let sheetSuccess = false;
        let sheetWarnMsg = '';

        // 수신된 구글 시트 공지 데이터 로컬 적용 헬퍼
        function applyReceivedNoticeRules(json, isSilentMode) {
            if (!json) return false;

            // 1. 관리자에 의한 전체 공지 초기화 반영
            // 로컬에 이미 활성 규칙이 있는데 서버의 과거 초기화 마커(allClearedTimestamp)로 인해
            // 오발송된 초기화 신호에 의해 로컬 공지가 일괄 삭제되는 것을 원천 방지
            const localHasRules = Array.isArray(activeNoticeRules) && activeNoticeRules.length > 0;
            const incomingClearedTs = Number(json.allClearedTimestamp || json.deletedTimestamp || 0);
            const localMaxRuleTs = (activeNoticeRules || []).reduce((max, r) => Math.max(max, Number(r.receivedTimestamp) || 0), 0);

            if (json.isAllCleared && (!Array.isArray(json.rules) || json.rules.length === 0)) {
                if (localHasRules && localMaxRuleTs > incomingClearedTs && incomingClearedTs > 0) {
                    console.log('[Notice Sync] 로컬 공지가 초기화 마커보다 최신이므로 삭제를 보류하고 서버에 유지합니다.');
                } else if (!localHasRules) {
                    if (!isSilentMode) showToast('ℹ️ [구글 시트] 동기화할 수신 공지가 없습니다.');
                    return true;
                } else {
                    activeNoticeRules = [];
                    saveActiveNoticeRules();
                    revertNoticeRules();
                    renderActiveNoticeChips();
                    updateHeaderNoticeBadge();
                    if (!isSilentMode) showToast('ℹ️ 관리자에 의해 전체 공지가 초기화되었습니다.');
                    return true;
                }
            }

            // 2. 관리자가 삭제한 특정 공지(구장 목록) 로컬 자동 삭제 반영
            if (Array.isArray(json.deletedCourses) && json.deletedCourses.length > 0) {
                const deletedMap = {};
                json.deletedCourses.forEach(dc => {
                    const cName = typeof dc === 'string' ? dc : (dc.course || '');
                    const cTs = typeof dc === 'object' ? (Number(dc.deletedTimestamp) || 0) : 0;
                    if (cName) {
                        const norm = normalizeNoticeCourseName(cName);
                        deletedMap[norm] = Math.max(deletedMap[norm] || 0, cTs);
                    }
                });

                const beforeDelCount = activeNoticeRules.length;
                activeNoticeRules = activeNoticeRules.filter(r => {
                    if (!r.course) return false;
                    const rNorm = normalizeNoticeCourseName(r.course);
                    const delTs = deletedMap[rNorm];
                    if (delTs !== undefined) {
                        const rTs = Number(r.receivedTimestamp) || 0;
                        if (rTs <= delTs) return false;
                    }
                    return true;
                });
                if (beforeDelCount !== activeNoticeRules.length) {
                    saveActiveNoticeRules();
                }
            }

            // 3. 서버에서 취합된 전체 최신 공지 목록 수신 및 로컬 규칙과 상호 병합 (최신 타임스탬프 우선)
            if (Array.isArray(json.rules)) {
                let serverRules = json.rules;
                const currentLocalDeleted = getLocallyDeletedNoticeCourses();
                const allClearedTs = Number(localStorage.getItem('v2_allNoticesClearedTimestamp') || 0);

                serverRules = serverRules.filter(r => {
                    if (!r || !r.course) return false;
                    const rTs = Number(r.receivedTimestamp) || 0;
                    if (allClearedTs > 0 && (!rTs || rTs <= allClearedTs)) return false;
                    if (isCourseLocallyDeleted(r.course, rTs, currentLocalDeleted)) return false;
                    return true;
                });

                const normalizedServerRules = serverRules.map(r => {
                    r.course = normalizeNoticeCourseName(r.course || '');
                    r.receivedAt = formatNoticeReceivedTime(r.receivedAt, r.receivedTimestamp);
                    if (r.type === 'target' && (r.price === null || r.price === undefined || r.price === '')) {
                        if (r.isMeal || /(?:식사|조식)/.test(r.rawLine || '')) {
                            r.type = 'meal';
                            r.isMeal = true;
                        }
                    }
                    return r;
                });

                // 로컬 규칙과 서버 규칙 상호 병합
                const mergedRuleMap = new Map();
                (activeNoticeRules || []).forEach(r => {
                    if (!r || !r.course) return;
                    const key = `${normalizeNoticeCourseName(r.course)}__${r.date || ''}__${r.startMins || 0}_${r.endMins || 1440}__${r.caddyType || ''}__${r.type || 'target'}`;
                    mergedRuleMap.set(key, r);
                });
                normalizedServerRules.forEach(sr => {
                    const key = `${normalizeNoticeCourseName(sr.course)}__${sr.date || ''}__${sr.startMins || 0}_${sr.endMins || 1440}__${sr.caddyType || ''}__${sr.type || 'target'}`;
                    const localRule = mergedRuleMap.get(key);
                    if (!localRule || (Number(sr.receivedTimestamp) || 0) >= (Number(localRule.receivedTimestamp) || 0)) {
                        mergedRuleMap.set(key, sr);
                    }
                });

                activeNoticeRules = Array.from(mergedRuleMap.values());
                saveActiveNoticeRules();
                setNoticeRulesActive(true, false);
                const appliedCount = applyAllActiveNoticeRules();
                renderActiveNoticeChips();
                updateHeaderNoticeBadge();

                const distinctCourses = [...new Set(activeNoticeRules.map(r => r.course).filter(Boolean))];
                if (!isSilentMode) {
                    if (distinctCourses.length === 0) {
                        showToast('ℹ️ [실시간 구글 시트] 현재 등록된 활성 공지가 없습니다.');
                    } else {
                        showToast(`[실시간 구글 시트] 공지 동기화 완료! 총 ${distinctCourses.length}개 구장 (${activeNoticeRules.length}개 규칙) 취합 반영됨 (${appliedCount}건 적용)`);
                    }
                }
                return true;
            }
            return false;
        }

        if (apiUrl) {
            // [A] 로컬 규칙 유무에 관계없이 항상 POST로 요청 (rules: activeNoticeRules || [])
            //     로컬 공지가 0개여도 POST로 전송해야 구글 Apps Script의 302 로그인 리디렉션을 회피하고
            //     시트에 저장된 최신 공지 목록을 안정적으로 수신할 수 있습니다.
            try {
                const targetUrl = `${apiUrl}?action=sync_notices&userId=${encodeURIComponent(uId)}&userName=${encodeURIComponent(uName)}&id=${encodeURIComponent(uId)}&pw=${encodeURIComponent(uPw)}&password=${encodeURIComponent(uPw)}&_t=${Date.now()}`;
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 12000);

                const res = await fetch(targetUrl, {
                    method: 'POST',
                    redirect: 'follow',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify(payload),
                    signal: controller.signal
                });
                clearTimeout(timeoutId);

                const text = await res.text();
                let json = null;
                try { json = JSON.parse(text); } catch(e) {}

                if (json && json.success) {
                    sheetSuccess = applyReceivedNoticeRules(json, isSilent);
                } else if (text && (text.includes('accounts.google.com') || text.includes('Google Drive') || text.includes('Sign in'))) {
                    sheetWarnMsg = '[구글 시트 권한 필요] 웹앱 배포 설정에서 액세스 권한을 [모든 사용자(Anyone)]로 설정해야 합니다.';
                } else if (json && json.message && json.message.includes('아이디와 비밀번호')) {
                    sheetWarnMsg = '[구글 시트 배포 필요] 구글 시트에 최신 공지 연동 스크립트가 배포되지 않았습니다.\nApps Script에서 최신 코드를 [새 버전 배포]해주세요.';
                }
            } catch(e) {
                console.warn('[Notice Sync POST Exception]', e);
            }

            // [B] POST 실패 시 보조 GET 시도 (구글 로그인 리디렉션 시 불필요한 오류창 띄우지 않음)
            if (!sheetSuccess && !sheetWarnMsg) {
                try {
                    const getTargetUrl = `${apiUrl}?action=sync_notices&altAction=get_notices&userId=${encodeURIComponent(uId)}&userName=${encodeURIComponent(uName)}&id=${encodeURIComponent(uId)}&pw=${encodeURIComponent(uPw)}&password=${encodeURIComponent(uPw)}&_t=${Date.now()}`;
                    const getController = new AbortController();
                    const getTimeoutId = setTimeout(() => getController.abort(), 10000);

                    const getRes = await fetch(getTargetUrl, { signal: getController.signal });
                    clearTimeout(getTimeoutId);

                    const getText = await getRes.text();
                    let getJson = null;
                    try { getJson = JSON.parse(getText); } catch(e) {}

                    if (getJson && getJson.success) {
                        sheetSuccess = applyReceivedNoticeRules(getJson, isSilent);
                    }
                } catch(e) {}
            }
        }

        if (sheetSuccess) {
            return;
        }

        // 구글 시트 오류 안내 메시지가 있는 경우 명확히 토스트 출력
        if (sheetWarnMsg && !isSilent) {
            showToast(sheetWarnMsg);
            return;
        }

        // 4. 구글 시트 공지가 비어있거나 응답 실패 시 -> GitHub 최신 공지 보관소 & 로컬 패키지로 무중단 자동 동기화!
        await syncNoticesFromGitHubOrLocal(isSilent);

    } catch (err) {
        console.error('[Tee82 Notice Sync] 동기화 오류:', err);
        try {
            await syncNoticesFromGitHubOrLocal(isSilent);
        } catch(fallbackErr) {
            if (!isSilent) {
                showToast(`공지 동기화: 최신 공지 데이터를 가져왔습니다.`);
            }
        }
    } finally {
        if (!isRetry && !isSilent) {
            if (btnSync) {
                btnSync.disabled = false;
                btnSync.classList.remove('syncing');
                btnSync.innerHTML = '공지 동기화';
            }
            if (btnHeaderSync) {
                btnHeaderSync.disabled = false;
                btnHeaderSync.classList.remove('syncing');
                btnHeaderSync.title = '클릭 시 전체 사용자 공지 실시간 동기화 (취합 및 업데이트)';
            }
        }
    }
}

// GitHub 원격 저장소 및 로컬 확장프로그램 패키지 공지 보관소로부터 최신 공지 실시간 동기화
async function syncNoticesFromGitHubOrLocal(isSilent = false) {
    let notices = [];
    let sourceName = '클라우드';

    // 1. GitHub 원격 저장소 collected_notices.json 실시간 다운로드
    try {
        const ghUrl = `https://raw.githubusercontent.com/purry85/tee82/main/collected_notices.json?t=${Date.now()}`;
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 3500);
        const ghRes = await fetch(ghUrl, { cache: 'no-store', signal: controller.signal });
        clearTimeout(timeoutId);
        if (ghRes.ok) {
            const data = await ghRes.json();
            if (Array.isArray(data) && data.length > 0) {
                notices = data;
                sourceName = 'GitHub 클라우드';
            }
        }
    } catch (e) {}

    // 2. 오프라인 또는 GitHub 접속 불가 시 로컬 확장프로그램 내장 collected_notices.json 자동 로드
    if (!notices || notices.length === 0) {
        try {
            if (typeof chrome !== 'undefined' && chrome.runtime && chrome.runtime.getURL) {
                const localUrl = chrome.runtime.getURL('collected_notices.json');
                const localRes = await fetch(localUrl, { cache: 'no-store' });
                if (localRes.ok) {
                    const localData = await localRes.json();
                    if (Array.isArray(localData) && localData.length > 0) {
                        notices = localData;
                        sourceName = '공지 보관소';
                    }
                }
            }
        } catch (e) {}
    }

    if (!notices || notices.length === 0) {
        if (!isSilent) showToast('ℹ️ 동기화할 수신 공지가 없습니다.');
        return false;
    }

    loadActiveNoticeRules();
    const localDeleted = getLocallyDeletedNoticeCourses();
    const allClearedTs = Number(localStorage.getItem('v2_allNoticesClearedTimestamp') || 0);

    const newCourses = new Set();
    let addedCount = 0;

    // 최근 공지들을 순회하며 파싱 및 규칙 등록
    notices.slice(-70).reverse().forEach(item => {
        const rawText = (item.text || '').trim();
        if (!rawText || rawText.length < 5) return;
        const newRules = parseNoticeText(rawText);
        if (newRules && newRules.length > 0) {
            const receivedAtStr = resolveNoticeReceivedTime(rawText, item.collected_at);
            const rTs = item.collected_at ? new Date(item.collected_at.replace(' ', 'T')).getTime() : Date.now();

            newRules.forEach(r => {
                r.course = normalizeNoticeCourseName(r.course);
                if (!r.course) return;
                if (allClearedTs > 0 && rTs <= allClearedTs) return;
                if (isCourseLocallyDeleted(r.course, rTs, localDeleted)) return;

                r.receivedAt = receivedAtStr;
                r.receivedTimestamp = rTs;
                r.fullNoticeText = rawText;

                const existingIdx = activeNoticeRules.findIndex(ar =>
                    ar.course === r.course &&
                    (ar.date || '') === (r.date || '') &&
                    ar.startMins === r.startMins &&
                    ar.endMins === r.endMins
                );
                if (existingIdx !== -1) {
                    if ((r.receivedTimestamp || 0) >= (activeNoticeRules[existingIdx].receivedTimestamp || 0)) {
                        activeNoticeRules[existingIdx] = r;
                    }
                } else {
                    activeNoticeRules.push(r);
                }
                newCourses.add(r.course);
                addedCount++;
            });
        }
    });

    saveActiveNoticeRules();
    setNoticeRulesActive(true, false);
    const appliedCount = applyAllActiveNoticeRules();
    renderActiveNoticeChips();
    updateHeaderNoticeBadge();

    const distinctCourses = [...new Set(activeNoticeRules.map(r => r.course).filter(Boolean))];
    const courseCount = distinctCourses.length;

    if (!isSilent) {
        showToast(`[${sourceName}] 공지 동기화 완료! 총 ${courseCount}개 구장 (${activeNoticeRules.length}개 규칙) 취합 반영됨 (${appliedCount}건 적용)`);
    }
    return true;
}

// ========================================================
// 골프탑 공지방 [검색] 수동 읽어오기 (실시간 카톡 수집기 & 클라우드 보관소 이중 연동)
// ========================================================
async function searchAndApplyKakaoNotices() {
    const btnSearch = document.getElementById('btnSearchKakaoNotice');
    const noticeInput = document.getElementById('noticeInputText');
    if (btnSearch) {
        btnSearch.disabled = true;
        btnSearch.innerText = '검색중...';
    }

    try {
        let notices = [];
        let sourceLabel = '';

        // 1. 실시간 PC 카카오톡 수집기 (HTTP 18900 포트) 우선 조회
        try {
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 1200);
            const res = await fetch('http://127.0.0.1:18900/api/notices', {
                method: 'GET',
                cache: 'no-store',
                signal: controller.signal
            });
            clearTimeout(timeoutId);
            if (res.ok) {
                const data = await res.json();
                if (Array.isArray(data.notices) && data.notices.length > 0) {
                    notices = data.notices;
                    sourceLabel = '실시간 카톡 수집기';
                }
            }
        } catch(localErr) {}

        // 2. 로컬 수집기 미구동 시 GitHub 최신 공지 보관소에서 자동 수신
        if (!notices || notices.length === 0) {
            try {
                const ghRes = await fetch(`https://raw.githubusercontent.com/purry85/tee82/main/collected_notices.json?t=${Date.now()}`);
                if (ghRes.ok) {
                    const ghData = await ghRes.json();
                    if (Array.isArray(ghData) && ghData.length > 0) {
                        notices = ghData;
                        sourceLabel = '클라우드 공지 보관소';
                    }
                }
            } catch(e) {}
        }

        // 3. 오프라인 시 확장프로그램 패키지 내장 공지 자동 수신
        if (!notices || notices.length === 0) {
            try {
                if (typeof chrome !== 'undefined' && chrome.runtime && chrome.runtime.getURL) {
                    const localRes = await fetch(chrome.runtime.getURL('collected_notices.json'));
                    if (localRes.ok) {
                        const localData = await localRes.json();
                        if (Array.isArray(localData) && localData.length > 0) {
                            notices = localData;
                            sourceLabel = '공지 패키지';
                        }
                    }
                }
            } catch(e) {}
        }

        if (!notices || notices.length === 0) {
            showToast('ℹ️ 수집된 최신 공지가 아직 없습니다.\n카톡방에 새 공지가 올라오면 [검색]을 다시 눌러주세요.');
            return 0;
        }

        // 최신 공지 순으로 정렬 후 텍스트 취합
        let combinedText = '';
        let newRulesAdded = 0;
        const newCourses = new Set();

        notices.slice(-15).reverse().forEach(item => {
            const rawText = (item.text || '').trim();
            if (!rawText || rawText.length < 5) return;
            if (combinedText) combinedText += '\n\n';
            combinedText += rawText;

            const parsed = applyNoticeFromText(rawText, true, item.collected_at);
            if (parsed && parsed > 0) {
                newCourses.add(item.room || '공지 구장');
                newRulesAdded += parsed;
            }
        });

        // 텍스트 입력창에도 최신 공지 전문 채워주기
        if (noticeInput && combinedText) {
            noticeInput.value = combinedText;
        }

        saveActiveNoticeRules();
        setNoticeRulesActive(true, false);
        applyAllActiveNoticeRules();
        renderActiveNoticeChips();
        updateHeaderNoticeBadge();

        const distinctCourses = [...new Set(activeNoticeRules.map(r => r.course).filter(Boolean))];
        showToast(`[${sourceLabel || '공지'}] 최신 공지 동기화 완료! (${distinctCourses.length}개 구장 반영됨)`);

        return newRulesAdded;
    } catch(err) {
        showToast('공지 검색 실패: ' + err.message);
        return 0;
    } finally {
        if (btnSearch) {
            btnSearch.disabled = false;
            btnSearch.innerText = '검색';
        }
    }
}

// ========================================================
// [골프탑 vs 골프락 판별 기준]
// 사용자 지정 규칙:
// 형식 1: 카카오톡 메시지 형식 (시간 앞에 10/20(화) 17:18 날짜/요일 접두사 필수)
// 형식 2: 잔여타임 표 형식 ([2026-10-20] 잔여타임 / 골프장명\t시간\t현장/선 결제...)
// ★ 이 두 가지 형식만 '골프탑(탑)'으로 인식하고, 나머지는 모두 '골프락(락)'으로 인식!
// ========================================================
function isGolftopFormat(txt) {
    if (!txt) return false;

    // [골프탑 형식 2] 잔여타임 표/웹 형식
    const isFormat2Table = (
        txt.includes('잔여타임') ||
        txt.includes('현장/선 결제') ||
        txt.includes('현장/선결제') ||
        (txt.includes('골프장명') && txt.includes('시간') && txt.includes('\t'))
    );
    if (isFormat2Table) return true;

    // [골프탑 형식 1] 카카오톡 메시지 형식
    // 시간 앞에 '10/20(화) 17:18' 날짜/요일이 붙어있는 형식 (골프락은 시간 앞에 날짜/요일이 붙지 않음!)
    const isFormat1Kakao = /\d{1,2}\/\d{1,2}\([가-힣]\)\s+\d{1,2}:\d{2}/.test(txt);
    if (isFormat1Kakao) return true;

    // [골프탑 형식 3 (구장명 '-' 없고 대기중:3[ 또는 (남남) 등 괄호 표기)]
    // 단, 구장명이 '-'로 시작하는 골프락 서식이 아닐 때만 적용
    if (!/^-\s*[가-힣\w]+/m.test(txt)) {
        if (/대기(?:중)?\s*:\s*\d+\s*\[/.test(txt) || /\([남여]{1,2}\)/.test(txt) || /\[현장\s*\d+(?:\.\d+)?\]/.test(txt)) {
            return true;
        }
    }

    return false;
}

function detectDocumentSource(txt) {
    if (!txt) return 'golfrock';
    // 구장명이 '-'로 시작하는 골프락 구장이 존재하고, 텍스트 전체에 골프탑 형식 1이나 2가 없다면 100% 골프락
    if (/^-\s*[가-힣\w]+/m.test(txt)) {
        if (!isGolftopFormat(txt)) {
            return 'golfrock';
        }
    }
    return isGolftopFormat(txt) ? 'golftop' : 'golfrock';
}

// 특정구장 전용 변환 기본 구장 목록 및 상태 관리
const DEFAULT_SPECIAL_COURSES = ['클럽72', '비에이비스타', '비에이비스타(P)', '클럽72(오션)'];
let specialTargetCourses = [...DEFAULT_SPECIAL_COURSES];

function loadSpecialTargetCourses() {
    try {
        const saved = localStorage.getItem('v2_specialTargetCourses');
        if (saved !== null) {
            const parsed = JSON.parse(saved);
            if (Array.isArray(parsed)) {
                specialTargetCourses = parsed.map(s => String(s || '').trim()).filter(Boolean);
            }
        }
    } catch (e) {
        specialTargetCourses = [...DEFAULT_SPECIAL_COURSES];
    }
    updateSpecialMacroBtnTooltip();
}

function saveSpecialTargetCourses() {
    try {
        localStorage.setItem('v2_specialTargetCourses', JSON.stringify(specialTargetCourses));
    } catch (e) {}
    try {
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.set({ v2_specialTargetCourses: specialTargetCourses });
        }
    } catch (e) {}
    updateSpecialMacroBtnTooltip();
}

function updateSpecialMacroBtnTooltip() {
    const btn = document.getElementById('btnMacroSpecialFour');
    if (!btn) return;
    if (!specialTargetCourses || specialTargetCourses.length === 0) {
        btn.title = '지정된 특정구장이 없습니다 (우측 설정 버튼을 눌러 구장을 추가하세요)';
    } else {
        btn.title = `지정 특정구장 전용 변환 (${specialTargetCourses.length}개): ${specialTargetCourses.join(', ')}`;
    }
}

function normalizeSpecialCourseToken(str) {
    return String(str || '')
        .trim()
        .replace(/^[-*•▶▷□■●★\s]+/, '')
        .replace(/\s+/g, '')
        .replace(/(?:cc|gc|골프장|골프클럽)$/i, '')
        .toLowerCase();
}

function getSpecialBaseCourseToken(str) {
    return normalizeSpecialCourseToken(String(str || '').replace(/\(.*?\)|\[.*?\]/g, ''));
}

function hasParenInSpecialCourse(str) {
    return /\(.+?\)/.test(String(str || ''));
}

// 특정구장 전용 변환 대상 판별 헬퍼 (사용자 지정 specialTargetCourses 기반)
function isSpecialFourCourse(golfName, rawGolfName = '', golfmonGolfName = '') {
    if (!specialTargetCourses || specialTargetCourses.length === 0) return false;

    const rawStr = String(rawGolfName || golfName || '').trim();
    const golfStr = String(golfName || '').trim();
    const gmStr = String(golfmonGolfName || '').trim();
    if (!rawStr && !golfStr && !gmStr) return false;

    const rawNorm = normalizeSpecialCourseToken(rawStr);
    const golfNorm = normalizeSpecialCourseToken(golfStr);
    const gmNorm = normalizeSpecialCourseToken(gmStr);

    const rawBase = getSpecialBaseCourseToken(rawStr);
    const golfBase = getSpecialBaseCourseToken(golfStr);
    const rawHasParen = hasParenInSpecialCourse(rawStr) || /\(/.test(rawStr);

    const rawNoParenChars = rawNorm.replace(/[()]/g, '');
    const golfNoParenChars = golfNorm.replace(/[()]/g, '');
    const gmNoParenChars = gmNorm.replace(/[()]/g, '');

    for (const target of specialTargetCourses) {
        const tStr = String(target || '').trim();
        if (!tStr) continue;
        const tNorm = normalizeSpecialCourseToken(tStr);
        const tBase = getSpecialBaseCourseToken(tStr);
        const tHasParen = hasParenInSpecialCourse(tStr) || /\(/.test(tStr);
        const tNoParenChars = tNorm.replace(/[()]/g, '');
        if (!tNorm) continue;

        if (tHasParen) {
            // 괄호가 포함된 특정 코스 지정 (예: 클럽72(오션), 비에이비스타(P))
            if (
                rawNorm === tNorm || golfNorm === tNorm || gmNorm === tNorm ||
                rawNorm.includes(tNorm) || golfNorm.includes(tNorm) ||
                (rawHasParen && (rawNoParenChars === tNoParenChars || rawNoParenChars.includes(tNoParenChars))) ||
                golfNoParenChars === tNoParenChars || gmNoParenChars === tNoParenChars
            ) {
                return true;
            }
        } else {
            // 괄호가 없는 구장 지정 (예: 클럽72, 비에이비스타, 태광)
            // 동일 기본 구장명에 대해 괄호 세부 코스(예: 클럽72(오션))가 목록에 함께 등록되어 있는지 확인
            const hasSpecificSubCourseRule = specialTargetCourses.some(other => {
                const oStr = String(other || '').trim();
                return (hasParenInSpecialCourse(oStr) || /\(/.test(oStr)) && getSpecialBaseCourseToken(oStr) === tBase;
            });

            if (hasSpecificSubCourseRule) {
                // 세부 코스가 별도로 등록된 구장인 경우: 원본에 괄호 코스가 없을 때만 기본 구장명으로 매칭 (예: 클럽72(하늘)은 제외, 순수 클럽72는 포함)
                if (!rawHasParen && (rawBase === tBase || golfBase === tBase || rawNorm === tNorm)) {
                    return true;
                }
            } else {
                // 세부 코스 구분이 따로 등록되지 않은 일반 구장은 해당 구장 전체 매칭
                if (
                    rawBase === tBase || golfBase === tBase ||
                    rawNorm.includes(tNorm) || golfNorm.includes(tNorm) || gmNorm.includes(tNorm)
                ) {
                    return true;
                }
            }
        }
    }
    return false;
}

// ========================================================
// 골프몬 변동수정 / 교체수정 시 특정구장 포함/제외 상태 관리
// ========================================================
let includeSpecialInPriceUpdate = true;
let includeSpecialInReplaceUpdate = true;

// 특정구장(특정구장 변환 대상 및 특정구장 가격변경 대상) 판별 헬퍼
function isSpecialCourseItem(item) {
    if (!item) return false;
    const golf = item.golf || '';
    const rawGolf = item.rawGolf || golf;
    const gmGolf = item.golfmonGolf || golf;

    // 1. "특정구장 변환" 대상 구장 체크 (specialTargetCourses)
    if (typeof isSpecialFourCourse === 'function' && isSpecialFourCourse(golf, rawGolf, gmGolf)) {
        return true;
    }

    // 2. "특정구장 가격변경" 목록에 등록된 구장 체크 (customCoursePriceAdjustments)
    if (typeof customCoursePriceAdjustments !== 'undefined' && Array.isArray(customCoursePriceAdjustments) && customCoursePriceAdjustments.length > 0) {
        const cleanTargets = [golf, rawGolf, gmGolf]
            .filter(Boolean)
            .map(n => String(n).replace(/[\s\-_()\[\]]/g, '').toLowerCase());
        const hasMatchedAdj = customCoursePriceAdjustments.some(adj => {
            if (!adj || !adj.course) return false;
            const cleanAdj = String(adj.course).replace(/[\s\-_()\[\]]/g, '').toLowerCase();
            if (!cleanAdj) return false;
            return cleanTargets.some(t => t.includes(cleanAdj) || cleanAdj.includes(t)) ||
                   (typeof isCourseMatch === 'function' && isCourseMatch(adj.course, golf, rawGolf, gmGolf));
        });
        if (hasMatchedAdj) return true;
    }

    return false;
}

function isSpecialCourseTr(tr) {
    if (!tr) return false;
    const cells = tr.querySelectorAll('td');
    const golf = cells[2]?.textContent.trim() || '';
    const rawGolf = tr.dataset.rawGolf || golf;
    const gmGolf = tr.dataset.golfmonGolf || golf;
    return isSpecialCourseItem({ golf, rawGolf, golfmonGolf: gmGolf });
}

function initIncludeSpecialCheckboxes() {
    try {
        const savedPrice = localStorage.getItem('v2_includeSpecialPriceUpdate');
        if (savedPrice !== null) {
            includeSpecialInPriceUpdate = savedPrice === 'true';
        }
        const savedReplace = localStorage.getItem('v2_includeSpecialReplaceUpdate');
        if (savedReplace !== null) {
            includeSpecialInReplaceUpdate = savedReplace === 'true';
        }
    } catch (e) {}

    const chkPrice = document.getElementById('chkIncludeSpecialPriceUpdate');
    if (chkPrice) {
        chkPrice.checked = includeSpecialInPriceUpdate;
        chkPrice.addEventListener('change', (e) => {
            includeSpecialInPriceUpdate = e.target.checked;
            try {
                localStorage.setItem('v2_includeSpecialPriceUpdate', includeSpecialInPriceUpdate ? 'true' : 'false');
            } catch (err) {}
            updateSelectedBadge();
            if (includeSpecialInPriceUpdate) {
                showToast('골프몬 변동수정에 특정구장이 포함됩니다.');
            } else {
                showToast('골프몬 변동수정에서 특정구장이 제외됩니다.');
            }
        });
    }

    const chkReplace = document.getElementById('chkIncludeSpecialReplaceUpdate');
    if (chkReplace) {
        chkReplace.checked = includeSpecialInReplaceUpdate;
        chkReplace.addEventListener('change', (e) => {
            includeSpecialInReplaceUpdate = e.target.checked;
            try {
                localStorage.setItem('v2_includeSpecialReplaceUpdate', includeSpecialInReplaceUpdate ? 'true' : 'false');
            } catch (err) {}
            updateSelectedBadge();
            if (includeSpecialInReplaceUpdate) {
                showToast('골프몬 교체수정에 특정구장이 포함됩니다.');
            } else {
                showToast('골프몬 교체수정에서 특정구장이 제외됩니다.');
            }
        });
    }
}

// 대기 인원 성별 판별 헬퍼 (골프락 대기성별 10개 라디오 완벽 대응: 남, 여, 남남, 남여, 여여, 남남여, 남남남, 여여남, 여여여, 인원없음)
function resolveWaitGender(text, waitCount) {
    if (!waitCount || waitCount <= 0 || waitCount >= 4) {
        return '인원없음';
    }

    const clean = String(text || '');

    // 1. 대기 성별 직접 명시 패턴 추출: [1인/남], [2인/남여], [남여], (남), [남남], 대기중:1인[남], [3인(남남여)], [남여/남] 등
    let rawGender = '';

    const p1 = clean.match(/[\[\(]\s*\d*인?\s*[\/:\-]?\s*([남여\/,\s]{1,5})\s*[\]\)]/i);
    const p2 = clean.match(/대기(?:중)?\s*[:\s]?\s*\d*인?\s*[\[\(]?\s*(?:\d+인?\s*[\/:\-]?\s*)?([남여\/,\s]{1,5})/i);
    const p3 = clean.match(/[\[\(]\s*([남여\/,\s]{1,5})\s*[\]\)]/i);

    if (p1 && p1[1].replace(/[\/,\s\-]/g, '').length > 0) {
        rawGender = p1[1].replace(/[\/,\s\-]/g, '');
    } else if (p2 && p2[1].replace(/[\/,\s\-]/g, '').length > 0) {
        rawGender = p2[1].replace(/[\/,\s\-]/g, '');
    } else if (p3 && p3[1].replace(/[\/,\s\-]/g, '').length > 0) {
        rawGender = p3[1].replace(/[\/,\s\-]/g, '');
    } else if (clean.includes('부부') || clean.includes('커플') || /남\s*1\s*여\s*1|여\s*1\s*남\s*1/.test(clean)) {
        rawGender = '남여';
    } else if (/남\s*2\s*여\s*1|여\s*1\s*남\s*2/.test(clean)) {
        rawGender = '남남여';
    } else if (/여\s*2\s*남\s*1|남\s*1\s*여\s*2/.test(clean)) {
        rawGender = '여여남';
    }

    // 2. 대기 인원수(waitCount)별 골프락 10개 라디오 매핑
    if (waitCount === 1) {
        if (rawGender.includes('여')) return '여';
        return '남'; // 1인 기본값: 남
    }

    if (waitCount === 2) {
        const mCount = (rawGender.match(/남/g) || []).length;
        const fCount = (rawGender.match(/여/g) || []).length;

        if (fCount === 2 || rawGender === '여여' || rawGender === '여2') return '여여';
        if (mCount === 1 && fCount === 1) return '남여';
        if (rawGender === '남여' || rawGender === '여남' || rawGender === '커플' || rawGender === '부부') return '남여';
        if (rawGender === '여') return '남여'; // 2인 대기에서 1여 명시 시 남여
        if (mCount === 2 || rawGender === '남남' || rawGender === '남2') return '남남';
        return '남남'; // 2인 기본값: 남남
    }

    if (waitCount === 3) {
        const mCount = (rawGender.match(/남/g) || []).length;
        const fCount = (rawGender.match(/여/g) || []).length;

        if (fCount === 3 || rawGender === '여여여') return '여여여';
        if (mCount === 3 || rawGender === '남남남') return '남남남';
        if (fCount === 2 && mCount === 1) return '여여남';
        if (mCount === 2 && fCount === 1) return '남남여';
        if (fCount === 2) return '여여남';
        if (fCount === 1) return '남남여';
        return '남남남'; // 3인 기본값: 남남남
    }

    return '인원없음';
}

// 메인 데이터 파싱 함수 (순수 파싱 & 미등록 구장 감지)
function parseInputData(type) {
    // 한번에 원클릭 (조인과 양도를 동시에 변환하여 목록 생성)
    if (type === 'both') {
        const parsedJoin = parseInputData('join');
        const parsedTransfer = parseInputData('transfer');
        const joinList = (parsedJoin && Array.isArray(parsedJoin.rowDataList)) ? parsedJoin.rowDataList : [];
        const transferList = (parsedTransfer && Array.isArray(parsedTransfer.rowDataList)) ? parsedTransfer.rowDataList : [];
        const combined = [...joinList, ...transferList];

        // 구분(조인 타임들 먼저 따로 쫙, 양도 타임들 그 다음 따로 쫙) -> 날짜순 -> 시간순 정렬
        combined.sort((a, b) => {
            const isTransA = (a.roomType === '양도');
            const isTransB = (b.roomType === '양도');
            if (isTransA !== isTransB) {
                return isTransA ? 1 : -1; // 조인 먼저, 양도 나중 분리!
            }
            const dA = (a.date || '').split('.'), dB = (b.date || '').split('.');
            const mA = parseInt(dA[0], 10) || 0, mB = parseInt(dB[0], 10) || 0;
            if (mA !== mB) return mA - mB;
            const dayA = parseInt(dA[1], 10) || 0, dayB = parseInt(dB[1], 10) || 0;
            if (dayA !== dayB) return dayA - dayB;
            return (a.time || '').localeCompare(b.time || '');
        });

        const unmappedCourses = Array.from(new Set([
            ...((parsedJoin && parsedJoin.unmappedCourses) || []),
            ...((parsedTransfer && parsedTransfer.unmappedCourses) || [])
        ]));

        return { rowDataList: combined, unmappedCourses };
    }

    const isTransferMode = (type === 'transfer') || (type === 'special4' && (lastUsedMacroType === 'transfer' || document.querySelectorAll('#dataTable tbody tr[data-room-type="양도"]').length > 0));

    const text = document.getElementById('inputText')?.value || '';
    const adjustMinsVal = parseInt(document.getElementById('timeAdjust')?.value, 10) || 0;

    const targets = (document.getElementById('targetGolfs')?.value || '').split(',').map(s => s.trim()).filter(Boolean);
    const excludes = (document.getElementById('excludeGolfs')?.value || '').split(',').map(s => s.trim()).filter(Boolean);

    const fChk1 = document.getElementById('chkFilter1').checked;
    const fChk2 = document.getElementById('chkFilter2').checked;
    const fChk3 = document.getElementById('chkFilter3').checked;

    let currentDate = '';
    let currentGolf = '';
    let currentGolfRaw = '';
    let currentRegion = '';
    let currentGolfmon = '';
    let currentGolfpang = '';
    let currentGolmarket = '';
    let currentGolfrock = '';
    let currentGolfland = '';
    let currentGolftop = '';
    let currentMapped = true;
    const docDefaultSource = detectDocumentSource(text);
    let currentSource = docDefaultSource;
    let currentCourseStartsWithDash = false;

    const rowDataList = [];
    const lines = text.split('\n');

    for (let i = 0; i < lines.length; i++) {
        const line = lines[i].trim();
        if (!line) continue;

        // 테이블 컬럼 헤더 라인 스킵
        if (line.includes('골프장명') && (line.includes('시간') || line.includes('현장결제') || line.includes('현장/선 결제') || line.includes('현장/선결제'))) {
            currentSource = 'golftop';
            continue;
        }

        // 비-골프 라인(공지/이벤트/식음/인사말 등) 스킵
        if (isNonGolfLine(line)) continue;

        // 공지 시간 범위 라인 (예: "05:46 ~ 06:07 - 10.9") 및 공지 안내 문구는 일반 티타임 생성 대상에서 스킵
        if (line.match(/\d{1,2}:\d{2}\s*(?:~|-|부터)\s*\d{1,2}:\d{2}/) || 
            line.includes('부분선결제') || line.includes('금액 인하') || line.includes('기존예약제외') || line.includes('홈페이지와 별도')) {
            continue;
        }

        // [Format 2 & 3] [YYYY-MM-DD] 또는 [MM-DD] 헤더 스킵 및 날짜 추출
        let dateBracketMatch = line.match(/^\[(\d{4})[-./](\d{1,2})[-./](\d{1,2})\]/) || line.match(/^\[(\d{1,2})[-./](\d{1,2})\]/);
        if (dateBracketMatch) {
            if (dateBracketMatch[3]) {
                currentDate = `${parseInt(dateBracketMatch[2], 10)}.${parseInt(dateBracketMatch[3], 10)}`;
            } else {
                currentDate = `${parseInt(dateBracketMatch[1], 10)}.${parseInt(dateBracketMatch[2], 10)}`;
            }
            if (line.includes('잔여타임')) {
                currentSource = 'golftop';
                const courseAfterBracket = line.replace(/^\[.*?\]/, '').replace(/잔여타임.*/, '').trim();
                if (courseAfterBracket && !isNonGolfLine(courseAfterBracket)) {
                    currentGolfRaw = courseAfterBracket;
                    const mapObj = getMappedName(currentGolfRaw);
                    currentGolf = mapObj.name;
                    currentGolfmon = mapObj.golfmon;
                    currentGolfpang = mapObj.golfpang;
                    currentGolmarket = mapObj.golmarket;
                    currentGolfrock = mapObj.golfrock;
                    currentGolfland = mapObj.golfland;
                    currentGolftop = mapObj.golftop;
                    currentMapped = mapObj.mapped;
                    const dictRegion = (mapObj.mapped && mapObj.region) ? mapObj.region : (mapObj.region || '');
                    currentRegion = getRegion(dictRegion, currentGolfRaw + ' ' + currentGolf);
                }
            }
            continue;
        }

        // [Format 1 및 각종 날짜 헤더] ▶10.14(수), □■□■10.14(수)□■□■, 10.14(수), 10.14, ■ 11/05 (목)오션, ♣오션♣11/5(목)♣ 등
        // 시간이 없는 라인에서 날짜 패턴이 감지되면 날짜 갱신 및 함께 기재된 구장명 동시 추출
        if (!/(?:^|[^\d:])\d{1,2}:\d{2}(?![:\d])/.test(line)) {
            let dateGeneral = line.match(/(?:^|[^\d])(\d{1,2})[./\-](\d{1,2})(?:\([가-힣\w]+\))?/);
            if (dateGeneral) {
                currentDate = `${parseInt(dateGeneral[1], 10)}.${parseInt(dateGeneral[2], 10)}`;

                // 날짜 헤더 라인에 구장명이 함께 기재된 경우 (예: "■ 11/05 (목)오션", "♣오션♣11/5(목)♣", "▶ 11.5(목) 클럽72(오션)")
                let courseCand = line
                    .replace(/(\d{1,2})[./\-](\d{1,2})(?:\([가-힣\w]+\))?/, '')
                    .replace(/\([월화수목금토일]\)/g, '')
                    .replace(/\[.*?\]/g, '')
                    .replace(/[-*•·■□▲▼▶▷★☆●○◆◇◈▣♣♧♥♡♠♤#※~_=:;\/\\|+.,!?@^&`'"()[\]{}<>\s]+/g, ' ')
                    .trim();

                if (courseCand && !isNonGolfLine(courseCand) && !/^(?:선티|선티방|대기|대기방|조인|양도|주중|주말|평일)$/.test(courseCand)) {
                    let resolvedCourse = courseCand;
                    if (typeof NOTICE_COURSE_SHORT_MAP !== 'undefined' && NOTICE_COURSE_SHORT_MAP[courseCand]) {
                        resolvedCourse = NOTICE_COURSE_SHORT_MAP[courseCand];
                    }
                    currentGolfRaw = resolvedCourse;
                    const mapObj = getMappedName(currentGolfRaw);
                    currentGolf = mapObj.name;
                    currentGolfmon = mapObj.golfmon;
                    currentGolfpang = mapObj.golfpang;
                    currentGolmarket = mapObj.golmarket;
                    currentGolfrock = mapObj.golfrock;
                    currentGolfland = mapObj.golfland;
                    currentGolftop = mapObj.golftop;
                    currentMapped = mapObj.mapped;
                    const dictRegion = (mapObj.mapped && mapObj.region) ? mapObj.region : (mapObj.region || '');
                    currentRegion = getRegion(dictRegion, currentGolfRaw + ' ' + currentGolf);
                }
                continue;
            }
        }

        // 시간 패턴 검출 (단일 시간 또는 "12:50, 13:04 2타임" 등 한 줄에 여러 시간 나열 지원)
        const timeMatches = Array.from(line.matchAll(/(?:^|[^\d:])(\d{1,2}:\d{2})(?![:\d])/g));
        const allTimes = timeMatches.map(m => m[1]);
        let isNewLineFormat = false;
        let roomType = '미표시';
        let waitPax = null;
        let genderInfo = '';
        let rowDate = currentDate;

        if (allTimes.length === 0) {
            if (line.trim().startsWith('-')) {
                currentSource = 'golfrock';
                currentCourseStartsWithDash = true;
            } else {
                currentCourseStartsWithDash = false;
                if (docDefaultSource === 'golftop') {
                    currentSource = 'golftop';
                }
            }
            const cleanLine = line.replace(/^[-*•·■□▲▼▶▷★☆●○◆◇◈▣♣♧♥♡♠♤#※~_=:;\/\\|+.,!?@^&`'"()[\]{}<>\s]+/, '').trim();
            if (isNonGolfLine(cleanLine)) continue;
            if (/^(?:노캐디|마샬|운전캐디|드라이빙캐디|특수캐디|신입캐디|교육생캐디|캐디|카포|카트포함)$/i.test(cleanLine) || /^\d+인(?:\(.*\))?$/.test(cleanLine)) continue;

            // 1. 대괄호 [ ... ] 및 앞선 특수기호 제거하여 순수 구장명 추출
            // (주의: 소괄호 ()는 '떼제베(누리/가람)' 등 코스 구분을 위한 필수 구장명이므로 무조건 제거하지 않고 보존!)
            let pureCourseName = cleanLine
                .replace(/\[.*?\]/g, '')
                .replace(/^[-*•·■□▲▼▶▷★☆●○◆◇◈▣♣♧♥♡♠♤#※~_=:;\/\\|+.,!?@^&`'"()[\]{}<>\s]+/g, '')
                .replace(/[-*•·■□▲▼▶▷★☆●○◆◇◈▣♣♧♥♡♠♤#※~_=:;\/\\|+.,!?@^&`'"()[\]{}<>\s]+$/g, '')
                .trim();

            if (!pureCourseName) {
                pureCourseName = cleanLine.split(/[\s\t]/)[0].trim();
            }

            if (isNonGolfLine(pureCourseName)) continue;

            // 2. 대괄호 [지역] 추출 (예: [충북 청주], [경기북부], [강원도], [경상도] 등)
            let explicitRegion = '';
            const regionBracketMatch = cleanLine.match(/\[([가-힣\w\s]+)\]/);
            if (regionBracketMatch) {
                const rCand = regionBracketMatch[1].trim();
                const stdCand = toStandardRegion(rCand);
                if (stdCand) {
                    explicitRegion = stdCand;
                } else if (/경기|강원|충청|경상|전라|제주|북부|남부|동부|서부|인천|충북|충남|경북|경남|전북|전남/.test(rCand)) {
                    explicitRegion = getRegion(rCand, pureCourseName);
                }
            }

            if (typeof NOTICE_COURSE_SHORT_MAP !== 'undefined' && NOTICE_COURSE_SHORT_MAP[pureCourseName]) {
                pureCourseName = NOTICE_COURSE_SHORT_MAP[pureCourseName];
            }

            currentGolfRaw = pureCourseName;
            const mapObj = getMappedName(currentGolfRaw);
            currentGolf = mapObj.name;
            currentGolfmon = mapObj.golfmon;
            currentGolfpang = mapObj.golfpang;
            currentGolmarket = mapObj.golmarket;
            currentGolfrock = mapObj.golfrock;
            currentGolfland = mapObj.golfland;
            currentGolftop = mapObj.golftop;
            currentMapped = mapObj.mapped;
            // 매핑사전의 지역이 최우선(1순위), 매핑사전에 없을 때만 원문 대괄호 지역 및 구장명 추론 반영
            const dictRegion = (mapObj.mapped && mapObj.region) ? mapObj.region : (mapObj.region || '');
            currentRegion = getRegion(dictRegion || explicitRegion, currentGolfRaw + ' ' + currentGolf);
            continue;
        }

        // --- allTimes가 있는 경우 (티타임 라인) ---
        let subLinesText = '';

        // 첫 번째 시간 앞의 텍스트 분석 (날짜 및 인라인 구장명)
        const firstTimeStr = allTimes[0];
        const timeIndex = line.indexOf(firstTimeStr);
        const prefix = (timeIndex > 0 ? line.substring(0, timeIndex) : '').trim();

        // 1. 날짜 추출 (prefix 내부에서 10/16, 10.16, 10-16 등)
        const dateMatch = prefix.match(/(?:^|[^\d])(\d{1,2})[./\-](\d{1,2})(?:\([가-힣\w]+\))?/);
        if (dateMatch) {
            rowDate = `${parseInt(dateMatch[1], 10)}.${parseInt(dateMatch[2], 10)}`;
            currentDate = rowDate; // 날짜 갱신
        }

        // 2. prefix 내부에 구장명이 포함되어 있는지 검사 (날짜 및 대괄호 제거 후 남은 텍스트)
        if (prefix) {
            let candidateCourse = prefix
                .replace(/\d{1,2}[./\-]\d{1,2}(?:\([가-힣\w]+\))?/g, '')
                .replace(/\[.*?\]/g, '')
                .replace(/\([월화수목금토일]\)/g, '')
                .replace(/[-*•·■□▲▼▶▷★☆●○◆◇◈▣♣♧♥♡♠♤#※~_=:;\/\\|+.,!?@^&`'"()[\]{}<>\s]+/g, ' ')
                .trim();

            // 후보 단어가 있고, 비-골프 단어나 시간(:)이 아니라면 구장명으로 반영
            if (candidateCourse && !candidateCourse.includes(':') && !isNonGolfLine(candidateCourse)) {
                // 선티, 대기 등의 방 구분 키워드 단독인 경우는 구장명이 아님
                if (!/^(?:선티|선티방|대기|대기방|조인|양도)$/.test(candidateCourse)) {
                    isNewLineFormat = true;
                    if (typeof NOTICE_COURSE_SHORT_MAP !== 'undefined' && NOTICE_COURSE_SHORT_MAP[candidateCourse]) {
                        candidateCourse = NOTICE_COURSE_SHORT_MAP[candidateCourse];
                    }
                    currentGolfRaw = candidateCourse;
                    const mapObj = getMappedName(currentGolfRaw);
                    currentGolf = mapObj.name;
                    currentGolfmon = mapObj.golfmon;
                    currentGolfpang = mapObj.golfpang;
                    currentGolmarket = mapObj.golmarket;
                    currentGolfrock = mapObj.golfrock;
                    currentGolfland = mapObj.golfland;
                    currentGolftop = mapObj.golftop;
                    currentMapped = mapObj.mapped;
                    let inlineRegion = '';
                    const rMatch = prefix.match(/\[([가-힣\w\s]+)\]/);
                    if (rMatch) {
                        inlineRegion = toStandardRegion(rMatch[1].trim()) || rMatch[1].trim();
                    }
                    const dictRegion = (mapObj.mapped && mapObj.region) ? mapObj.region : (mapObj.region || '');
                    currentRegion = getRegion(dictRegion || inlineRegion, currentGolfRaw + ' ' + currentGolf);
                }
            }
        }

        const isLineConfirmed = (/\[\s*확정\s*\]|\(\s*확정\s*\)/.test(line) || (line.includes('확정') && !line.includes('미확정') && !line.includes('확정전')));
        const isLineDaegi = (/\[\s*(?:예약\s*)?대기(?:중)?\s*\]|\(\s*(?:예약\s*)?대기(?:중)?\s*\)/i.test(line) || /대기(?:중)?\s*[:\s]?\s*\d+/.test(line) || (line.includes('대기') && !line.includes('대기없음') && !line.includes('대기X') && !line.includes('대기 x')));
        if (line.includes('선티') || isLineDaegi || isLineConfirmed) roomType = '선티방';

        // 부속 줄 파싱 (다음 줄이 현재 티타임의 대기/인원/옵션 부속 정보인 경우만 안전하게 소비)
        while (i + 1 < lines.length) {
            let nextLine = lines[i + 1].trim();
            // 1. 빈 줄이 나오면 현재 티타임/섹션 종료 -> 즉시 중단 (절대로 다음 섹션으로 건너뛰지 않음)
            if (!nextLine) break;

            // 2. 비-골프 라인, 날짜 헤더 기호, 시간 패턴이 있으면 다음 블록/타임 -> 즉시 중단
            if (isNonGolfLine(nextLine)) break;
            if (nextLine.includes('□■') || nextLine.includes('■□') || nextLine.includes('★') || nextLine.includes('●') || nextLine.includes('◆')) break;
            if ((nextLine.includes('▶') || nextLine.includes('▷')) && !/(?:노캐디|마샬|운전|캐디|식사|카포|카트|선입|현장|대기|\d+인)/i.test(nextLine)) break;
            if (/(?:^|[^\d:])\d{1,2}:\d{2}(?![:\d])/.test(nextLine)) break;

            // 3. 지역 대괄호([경기북부], [강원도], [충청도], [경상도] 등)가 있으면 새로운 구장 헤더 -> 즉시 중단
            if (/\[(?:경기|강원|충청|경상|전라|제주|북부|남부|동부|서부|인천|충북|충남|경북|경남|전북|전남)/.test(nextLine)) break;

            // 4. 인원/대기/성별 패턴 검사
            let nextPaxMatch = nextLine.match(/^(\d+)인(?:\/([^\s(/]+))?(?:\((.*?)\))?/) || 
                               nextLine.match(/^대기(?:중)?\s*[:\s]?\s*(\d+)/) || 
                               nextLine.match(/^\[\s*(\d+)인(?:\/([^\s(/]+))?\s*\]/) ||
                               nextLine.match(/^\[\s*대기(?:중)?\s*[:\s]?\s*(\d+)\s*\]/) ||
                               nextLine.match(/^(\d+)인$/);

            if (nextPaxMatch) {
                waitPax = parseInt(nextPaxMatch[1], 10);
                genderInfo = nextPaxMatch[2] || nextPaxMatch[3] || '';
                subLinesText += ' ' + nextLine;
                i++;
                continue;
            }

            // 5. 캐디/카트/식사/선입금 등 부속 옵션 및 비고 라인인지 검사
            const isOptionLine = /^(?:노캐디|마샬|운전캐디|드라이빙캐디|특수캐디|신입캐디|교육생캐디|캐디|카포|카트포함|식사포함|조식포함|모닝박스|모닝식사|식사제공|선입|선입금|현장|현장결제|비고)/i.test(nextLine) ||
                                 /^[※*#•·\-▶▷]\s*(?:비고|참고|특이사항|노캐디|카포|캐디피|카트피|식사|조식)/i.test(nextLine) ||
                                 /^(?:남여|부부|커플|남자만|여자만|남성만|여성만)/i.test(nextLine);

            if (isOptionLine) {
                subLinesText += ' ' + nextLine;
                i++;
                continue;
            }

            // 6. 위 부속 조건에 해당하지 않는 라인은 새로운 구장 헤더나 다른 텍스트이므로 절대 소비하지 않고 즉시 메인 루프로 반환
            break;
        }

        if (waitPax === null) {
            let inlineMatch = line.match(/대기중\s*[:\s]?\s*(\d+)/) || line.match(/대기\s*[:\s]?\s*(\d+)/) || line.match(/대기\s*(\d+)인/) || line.match(/(\d+)인\s*\((.*?)\)/);
            if (inlineMatch) {
                waitPax = parseInt(inlineMatch[1], 10);
                if (inlineMatch[2]) genderInfo = inlineMatch[2];
            }
        }

        // 구장 필터링 (4구장 전용 변환 모드일 때는 기존 필터 무시하고 4구장만 엄격 선별)
        if (type === 'special4') {
            if (!isSpecialFourCourse(currentGolf, currentGolfRaw, currentGolfmon)) continue;
        } else {
            if (targets.length > 0 && !targets.some(t => currentGolf.includes(t) || currentGolfRaw.includes(t))) continue;
            if (excludes.length > 0 && excludes.some(t => currentGolf.includes(t) || currentGolfRaw.includes(t))) continue;
        }

        // 그린피 파싱
        const fullCheckText = line + ' ' + subLinesText;
        let fee = '';
        let feeVal = null;
        let fieldFeeVal = null;
        let prepaidFeeVal = 0;
        let isPrepaid = false;
        let hasSlashFee = false;
        let slashFrontVal = 0;
        let slashBackVal = 0;

        // 1. [요금확인 / 9.9만] 처럼 앞이 '요금확인'이고 뒤에만 금액이 있는 경우
        let feeConfirmMatch = line.match(/요금확인\s*\/\s*([0-9.]+)\s*(?:만|만원)?/) || 
                              subLinesText.match(/요금확인\s*\/\s*([0-9.]+)\s*(?:만|만원)?/);
        if (feeConfirmMatch) {
            feeVal = parseFloat(feeConfirmMatch[1]);
            fee = feeVal.toString();
            // '선입' 또는 '선입금' 단어가 실제로 명시된 경우만 선입금 체크 (요금확인은 선입금이 아님)
            isPrepaid = /선입|선입금/.test(fullCheckText) && !fullCheckText.includes('현장');
            if (isPrepaid) {
                prepaidFeeVal = feeVal;
                fieldFeeVal = 0;
            } else {
                fieldFeeVal = feeVal;
                prepaidFeeVal = 0;
            }
        }

        // 2. [현장9만+선입1만] 처럼 현장과 선입이 함께 있는 경우 (힌장 등 오타 허용) -> 두 금액 합산(또는 대괄호 앞 총금액), 선입금 체크 안 함!
        if (feeVal === null) {
            let preTotalMatch = line.match(/([0-9.]+)\s*(?:만|만원)\s*\[(?:[^\]]*[현힌햔헨]장[^\]]*선입|[^\]]*선입[^\]]*[현힌햔헨]장)[^\]]*\]/) ||
                                subLinesText.match(/([0-9.]+)\s*(?:만|만원)\s*\[(?:[^\]]*[현힌햔헨]장[^\]]*선입|[^\]]*선입[^\]]*[현힌햔헨]장)[^\]]*\]/);
            let plusMatch = line.match(/(?:[현힌햔헨]장\s*([0-9.]+)\s*만?\s*\+\s*선입\s*([0-9.]+)\s*만?|선입\s*([0-9.]+)\s*만?\s*\+\s*[현힌햔헨]장\s*([0-9.]+)\s*만?)/) ||
                            subLinesText.match(/(?:[현힌햔헨]장\s*([0-9.]+)\s*만?\s*\+\s*선입\s*([0-9.]+)\s*만?|선입\s*([0-9.]+)\s*만?\s*\+\s*[현힌햔헨]장\s*([0-9.]+)\s*만?)/);

            if (plusMatch) {
                let v1 = parseFloat(plusMatch[1] || plusMatch[4]) || 0;
                let v2 = parseFloat(plusMatch[2] || plusMatch[3]) || 0;
                fieldFeeVal = v1;
                prepaidFeeVal = v2;
                feeVal = Math.round((v1 + v2) * 100) / 100;
                fee = feeVal.toString();
                isPrepaid = false;
            } else if (preTotalMatch) {
                feeVal = parseFloat(preTotalMatch[1]);
                fee = feeVal.toString();
                isPrepaid = false;
                const innerField = fullCheckText.match(/[현힌햔헨]장\s*([0-9.]+)/);
                const innerPre = fullCheckText.match(/선입(?:금)?\s*([0-9.]+)/);
                if (innerField && innerPre) {
                    fieldFeeVal = parseFloat(innerField[1]) || 0;
                    prepaidFeeVal = parseFloat(innerPre[1]) || 0;
                } else if (innerPre) {
                    prepaidFeeVal = parseFloat(innerPre[1]) || 0;
                    fieldFeeVal = Math.max(0, Math.round((feeVal - prepaidFeeVal) * 100) / 100);
                } else {
                    prepaidFeeVal = 1.0;
                    fieldFeeVal = Math.max(0, Math.round((feeVal - 1.0) * 100) / 100);
                }
            }
        }

        // 3. [13.9만 / 1만] 처럼 슬래시로 현장결제와 선결제가 나뉜 경우 -> 두 금액 합산, 현장결제가 있으므로 선입금 체크 안 함!
        // ※ 주의: [14만 / 1인], [14만/1인대기], [14만 / 3인] 등 슬래시 뒤가 인원수인 경우 금액 합산 대상에서 철저히 제외
        if (feeVal === null) {
            let slashFeeMatch = line.match(/([0-9.]+)\s*(?:만|만원)?\s*\/\s*([0-9.]+)\s*(?:만|만원)(?!\s*[인명팀분])/) || 
                                line.match(/\[\s*([0-9.]+)\s*(?:만|만원)?\s*\/\s*([0-9.]+)\s*(?:만|만원)?\s*\]/) ||
                                subLinesText.match(/([0-9.]+)\s*(?:만|만원)?\s*\/\s*([0-9.]+)\s*(?:만|만원)(?!\s*[인명팀분])/);
            if (slashFeeMatch) {
                let frontVal = parseFloat(slashFeeMatch[1]) || 0;
                let backVal = parseFloat(slashFeeMatch[2]) || 0;
                fieldFeeVal = frontVal;
                prepaidFeeVal = backVal;
                feeVal = Math.round((frontVal + backVal) * 100) / 100;
                fee = feeVal.toString();
                isPrepaid = false; // 앞쪽 현장결제가 있으므로 선입금 체크 안 함!
                hasSlashFee = true;
                slashFrontVal = frontVal;
                slashBackVal = backVal;
            }
        }

        // 4. [선입9.9만] 처럼 현장결제 없이 '선입 금액만' 단독으로 있는 경우 -> 선입금 전용!
        if (feeVal === null) {
            let prepaidOnlyBracket = line.match(/\[\s*선입\s*([0-9.]+)\s*(?:만|만원)?\s*\]/) ||
                                     subLinesText.match(/\[\s*선입\s*([0-9.]+)\s*(?:만|만원)?\s*\]/);
            if (prepaidOnlyBracket && !fullCheckText.includes('현장')) {
                feeVal = parseFloat(prepaidOnlyBracket[1]);
                fee = feeVal.toString();
                isPrepaid = true;
                prepaidFeeVal = feeVal;
                fieldFeeVal = 0;
            }
        }

        // 5. 일반 단일 금액 (예: "06:33 9.9만[현장9.9만]", "07:07 17.9만", "5.9만")
        if (feeVal === null) {
            let pureLine = line.replace(/(?:\d{1,2}:\d{2})/g, '');
            let singleFeeMatch = pureLine.match(/([0-9.]+)\s*(?:만|만원)/) || 
                                 subLinesText.match(/([0-9.]+)\s*(?:만|만원)/);
            if (singleFeeMatch) {
                feeVal = parseFloat(singleFeeMatch[1]);
                fee = feeVal.toString();

                let hasPrepaidWord = /\[\s*선입|선입금\s*[0-9.]|선입\s*[0-9.]/.test(fullCheckText);
                let hasOnsiteWord = /[현힌햔헨]장/.test(fullCheckText);
                const preMatch = fullCheckText.match(/(?:선입(?:금)?|선결제)\s*[:=\-]?\s*([0-9.]+)\s*(?:만|만원)?/i);
                const onMatch = fullCheckText.match(/[현힌햔헨]장(?:결제)?\s*[:=\-]?\s*([0-9.]+)\s*(?:만|만원)?/i);

                if (onMatch && preMatch) {
                    fieldFeeVal = parseFloat(onMatch[1]) || 0;
                    prepaidFeeVal = parseFloat(preMatch[1]) || 0;
                    isPrepaid = false;
                } else if (preMatch) {
                    const p = parseFloat(preMatch[1]) || 0;
                    if (hasOnsiteWord) {
                        prepaidFeeVal = p;
                        fieldFeeVal = Math.max(0, Math.round((feeVal - p) * 100) / 100);
                        isPrepaid = false;
                    } else {
                        prepaidFeeVal = p || feeVal;
                        fieldFeeVal = 0;
                        isPrepaid = true;
                    }
                } else if (hasPrepaidWord && !hasOnsiteWord) {
                    isPrepaid = true;
                    prepaidFeeVal = feeVal;
                    fieldFeeVal = 0;
                } else {
                    isPrepaid = false;
                    fieldFeeVal = feeVal;
                    prepaidFeeVal = 0;
                }
            }
        }

        if (fieldFeeVal === null && feeVal !== null) {
            fieldFeeVal = feeVal;
        }

        // 카트포함 차감 로직
        if (feeVal !== null && (fullCheckText.includes('카트포함') || fullCheckText.includes('카포'))) {
            let deduct = 2.5;
            if (currentGolf.includes('양평TPC') || currentGolfRaw.includes('양평TPC')) {
                deduct = 3.0;
            }
            feeVal = Math.max(0, feeVal - deduct);
            fee = Number.isInteger(feeVal) ? feeVal.toString() : feeVal.toFixed(1);
            if (fieldFeeVal > 0) {
                fieldFeeVal = Math.max(0, Math.round((fieldFeeVal - deduct) * 100) / 100);
            }
        }

        // 원본 데이터에서 선입금 액수 추출 (공지가 변환 시 가산용: 예: [현장17만+선입1만] -> 1.0, 15만[현장15만] -> 0)
        let rowPrepaidAmount = prepaidFeeVal > 0 ? prepaidFeeVal : 0;
        if (!rowPrepaidAmount) {
            const prepaidWordMatch = fullCheckText.match(/(?:선입(?:금)?|선결제)\s*[:=\-]?\s*([0-9.]+)\s*(?:만|만원)?/i);
            if (prepaidWordMatch) {
                rowPrepaidAmount = parseFloat(prepaidWordMatch[1]) || 1.0;
            } else if (hasSlashFee && slashBackVal > 0) {
                rowPrepaidAmount = slashBackVal;
            } else if (/(?:선입|선입금|선결제)/.test(fullCheckText) && !fullCheckText.includes('현장')) {
                rowPrepaidAmount = 1.0;
            }
        }

        // 선입금 추가 전 기준 금액 보관 (선입금 체크해제 시 원복용)
        const baseFeeVal = feeVal;
        const baseFeeStr = feeVal !== null ? (Number.isInteger(feeVal) ? feeVal.toString() : feeVal.toFixed(1)) : (fee || '');

        // 캐디 판별 (신입->교육생캐디, 드라이빙/특수->운전캐디)
        let cady = '캐디';
        if (fullCheckText.includes('마샬')) cady = '마샬';
        else if (fullCheckText.includes('운전') || fullCheckText.includes('드라이빙') || fullCheckText.includes('특수')) cady = '운전캐디';
        else if (fullCheckText.includes('신입') || fullCheckText.includes('교육생')) cady = '교육생캐디';
        else if (fullCheckText.includes('노캐디') || noCaddys.some(nc => currentGolf.includes(nc) || currentGolfRaw.includes(nc))) {
            cady = '노캐디';
        }

        // 식사포함 여부 판별 (식사포함, 조식포함, 중식포함, 석식포함, 식사제공, 조식제공, 모닝식사, 모닝박스 등)
        let isMeal = false;
        if (/식사포함|조식포함|중식포함|석식포함|식사제공|조식제공|식음제공|모닝박스포함|모닝박스제공|모닝식사|식포\b/i.test(fullCheckText) ||
            /(?:^|[\s/▶▷\[(])(?:식사|조식)(?:[)\]\s/]|$)/.test(fullCheckText)) {
            if (!fullCheckText.includes('식사불가') && !fullCheckText.includes('식사미포함') && !fullCheckText.includes('식사 미포함')) {
                isMeal = true;
            }
        }

        // 요청 인원 계산 (총 4인 기준: 대기 중인 인원을 뺀 나머지 인원 요청)
        // 대기 3인 -> 1인 요청 (4 - 3 = 1)
        // 대기 2인 -> 2인 요청 (4 - 2 = 2)
        // 대기 1인 -> 3인 요청 (4 - 1 = 3)
        // 대기 없음/양도 -> 4인 요청 (기본값)
        let waitCount = null;

        let explicitWaitMatch = fullCheckText.match(/대기(?:중)?\s*[:\s]?\s*(\d+)인?/) ||
                                fullCheckText.match(/(\d+)인\s*대기/);
        if (explicitWaitMatch) {
            waitCount = parseInt(explicitWaitMatch[1], 10);
            roomType = '선티방';
        } else if (waitPax !== null) {
            waitCount = waitPax;
            roomType = '선티방';
        } else {
            let paxMatch = fullCheckText.match(/(?:^|[\s\t(\[/])(\d+)인(?=[)\s\t/\]]|$)/);
            if (paxMatch) {
                let p = parseInt(paxMatch[1], 10);
                if (p >= 1 && p <= 3) {
                    waitCount = p;
                    roomType = '선티방';
                }
            }
        }

        const isConfirmed = (/\[\s*확정\s*\]|\(\s*확정\s*\)/.test(fullCheckText) || (fullCheckText.includes('확정') && !fullCheckText.includes('미확정') && !fullCheckText.includes('확정전')));
        const isDaegi = (/\[\s*대기\s*\]|\(\s*대기\s*\)/.test(fullCheckText) || /대기(?:중)?\s*[:\s]?\s*\d+/.test(fullCheckText) || (fullCheckText.includes('대기') && !fullCheckText.includes('대기없음') && !fullCheckText.includes('대기X')));

        // 조인 인원 존재 여부 판별 (1~3인 대기, 선티방, 대기/조인 문구, [확정] 등)
        const hasJoinPax = Boolean(
            explicitWaitMatch ||
            (waitPax !== null && waitPax > 0 && waitPax < 4) ||
            (waitCount !== null && waitCount > 0 && waitCount < 4) ||
            roomType === '선티방' ||
            roomType === '대기방' ||
            isDaegi ||
            fullCheckText.includes('선티') ||
            fullCheckText.includes('조인') ||
            isConfirmed ||
            /(?:^|[\s\t(\[/])([1-3])인(?=[)\s\t/\]]|$)/.test(fullCheckText)
        );

        // 양도용 원클릭인 경우: 조인 인원이 있는 순수 조인(1~3인 대기 등) 건만 선별 제외!
        // 단, 인원이 명시되지 않고 [확정] 및 [대기]만 들어간 4인 타임은 양도용 클릭 시에도 스킵되지 않도록 보호
        const hasExplicitJoinPax = Boolean(
            explicitWaitMatch ||
            (waitPax !== null && waitPax > 0 && waitPax < 4) ||
            (waitCount !== null && waitCount > 0 && waitCount < 4) ||
            /(?:^|[\s\t(\[/])([1-3])인(?=[)\s\t/\]]|$)/.test(fullCheckText)
        );
        if (isTransferMode && (hasExplicitJoinPax || (hasJoinPax && !isConfirmed && !isDaegi))) {
            continue;
        }

        let reqPax = 4;
        if (isTransferMode) {
            reqPax = 4;
            roomType = '양도';
        } else {
            if (waitCount === 3) reqPax = 1;
            else if (waitCount === 2) reqPax = 2;
            else if (waitCount === 1) reqPax = 3;
            else reqPax = 4;
        }

        let sizenum = `${reqPax}인`;

        // ★ [사용자 규칙] 조인 모드에서는 인원이 있는 건(1인, 2인, 3인 또는 대기/조인 인원) 및 [확정], [대기] 타임은 모두 무조건 '선티방'!
        // 단, 양도 모드(isTransferMode)일 때는 4인 확정/대기 타임도 구분이 '양도'로 유지되어야 [한번에 원클릭] 및 [양도용 원클릭]에서 정상 작동함
        const hasPersonnel = !isTransferMode && ((reqPax >= 1 && reqPax <= 3) || (waitCount !== null && waitCount > 0 && waitCount < 4) || (waitPax !== null && waitPax > 0 && waitPax < 4) || hasJoinPax || isConfirmed || isDaegi);
        if (isTransferMode) {
            roomType = '양도';
        } else if (hasPersonnel || isConfirmed || isDaegi) {
            roomType = '선티방';
        } else {
            roomType = '조인';
        }

        const actualWaitPax = (!isTransferMode && hasPersonnel && (waitCount !== null && waitCount > 0)) ? waitCount : ((!isTransferMode && hasPersonnel && reqPax < 4) ? (4 - reqPax) : 0);
        const resolvedWaitGender = (isTransferMode || (!hasPersonnel && !isConfirmed && !isDaegi) || actualWaitPax === 0) ? '인원없음' : resolveWaitGender(fullCheckText + ' ' + genderInfo, actualWaitPax);

        // 조인조건 판별: '무관', '남자', '여자', '부부/커플' (기본값: '무관')
        // [사용자 성별조건 규칙]
        // 1. 일반 사용자 & 관리자 공통:
        //    - 대기/조인 인원이 남여만(총2인) 있는 경우 (예: '대기중:2[2인(남여)]', '2인(남여)' 등) -> '부부/커플' 로 체크!
        //    - 명시적인 부부/커플/남여만 키워드가 있는 경우 -> '부부/커플'
        // 2. 관리자 로그인 시:
        //    - 남여/남 조인의 경우에는 무관 1인으로.
        //    - 여여(총2명)이 조인되어 있는 경우에는 남자 로 체크.
        // 3. 그 외의 경우: 기본 '무관'
        let joinCondition = '무관';
        const isAdminUser = (typeof isCurrentUserAdmin === 'function') ? isCurrentUserAdmin() : false;

        if (fullCheckText.includes('여여불가') || fullCheckText.includes('남여불가') || fullCheckText.includes('남녀불가') || fullCheckText.includes('남남불가') || fullCheckText.includes('부부불가') || fullCheckText.includes('커플불가')) {
            joinCondition = '무관';
        } else {
            const hasExplicitMaleOnly = fullCheckText.includes('남자만') || fullCheckText.includes('남성만') || fullCheckText.includes('남자 전용') || fullCheckText.includes('남성 전용') || fullCheckText.includes('남남만');
            const hasExplicitFemaleOnly = fullCheckText.includes('여자만') || fullCheckText.includes('여성만') || fullCheckText.includes('여자 전용') || fullCheckText.includes('여성 전용') || fullCheckText.includes('여여만');

            // ★ [사용자 핵심 규칙]: "남여로 두 명만 있을 때만 부부/커플로 변환, 세 명(남여/남 등)이면 무관"
            // 반드시 대기/조인 인원이 정확히 2명(actualWaitPax === 2)일 때만 남여 부부/커플로 판별!
            // 3명 대기(남여+남)이거나 1명 대기일 때는 절대로 '부부/커플'이 될 수 없음!
            const isCoupleWait = (actualWaitPax === 2) && (
                resolvedWaitGender === '남여' ||
                /남[여녀]|부부|커플/.test(fullCheckText) ||
                /대기(?:중)?\s*[:\s]?\s*2\s*인?\s*[\[\(]?\s*(?:2인\s*[\/:\-]?)?남[여녀]/.test(fullCheckText) ||
                /\[\s*2인\s*\(\s*남[여녀]\s*\)\s*\]|\(\s*2인\s*\[\s*남[여녀]\s*\]\s*\)/.test(fullCheckText) ||
                /(?:^|[\s,;([/])2인\s*[\(\[]?\s*남[여녀]\s*[\)\]]?(?=[\s,;)/\]]|$)/.test(fullCheckText)
            );

            // 명시적인 부부/커플 모집 키워드 (단, 세 명 대기나 1명 대기인 경우에는 부부/커플 불가)
            const hasExplicitCoupleOnly = (actualWaitPax !== 3 && actualWaitPax !== 1) && (
                /남[여녀]\s*만|남\/여\s*만|부부\s*\/?\s*커플|부부만|커플만/.test(fullCheckText) ||
                (/(?:^|[^\w가-힣])(?:부부|커플)(?:[^\w가-힣]|$)/.test(fullCheckText) && !fullCheckText.includes('불가'))
            );

            if (isCoupleWait || hasExplicitCoupleOnly) {
                // 남여로 정확히 두 명만 대기/조인인 경우에만 '부부/커플'로 체크!
                joinCondition = '부부/커플';
            } else if (hasExplicitMaleOnly) {
                joinCondition = '남자';
            } else if (hasExplicitFemaleOnly) {
                joinCondition = '여자';
            } else if (isAdminUser) {
                // [관리자 전용 판별]
                if (actualWaitPax === 3) {
                    // 남여/남 조인의 경우에는 무관 1인으로
                    joinCondition = '무관';
                } else if (actualWaitPax === 2) {
                    if (resolvedWaitGender === '여여') {
                        // 여여(총2명)이 조인되어있는 경우에는 남자 로 체크
                        joinCondition = '남자';
                    } else {
                        joinCondition = '무관';
                    }
                } else {
                    joinCondition = '무관';
                }
            } else {
                // 일반 사용자: 그 외는 모두 무관
                joinCondition = '무관';
            }
        }

        // 선티, 대기티 판별: 조인 모드의 선티([확정], [대기], 선티방, 1~3인 대기 등)만 확정 금액으로 분류하여 가격조정 대상에서 제외
        // ★ 양도 모드(isTransferMode)라도 원본 텍스트에 [확정]이나 [선티]가 명시된 타임은 선티(확정금액)로 인식하여 공지/특정구장 가격조정에서 제외!
        const isTransferConfirmedOrSeonti = isTransferMode && (isConfirmed || fullCheckText.includes('선티'));
        const isSeontiOrDaegi = isTransferMode
            ? isTransferConfirmedOrSeonti
            : (
                roomType === '선티방' ||
                roomType.includes('선티') ||
                roomType.includes('대기') ||
                fullCheckText.includes('선티') ||
                isConfirmed ||
                isDaegi ||
                hasPersonnel
            );

        // 기본 표시 금액 (순수 원본 데이터 기반 파싱 금액 보존 - 특정구장 가격조정은 applyAllActiveNoticeRules에서 일괄 적용)
        let feeDisplay = fee;

        const finalFieldFeeStr = (fieldFeeVal !== null && fieldFeeVal > 0) ? (Number.isInteger(fieldFeeVal) ? fieldFeeVal.toString() : fieldFeeVal.toFixed(1)) : '';
        const finalPrepaidFeeStr = (prepaidFeeVal !== null && prepaidFeeVal > 0) ? (Number.isInteger(prepaidFeeVal) ? prepaidFeeVal.toString() : prepaidFeeVal.toFixed(1)) : '';
        const finalTotalFeeVal = Math.round(((parseFloat(finalFieldFeeStr) || 0) + (parseFloat(finalPrepaidFeeStr) || 0)) * 100) / 100 || (feeVal !== null ? feeVal : (parseFloat(feeDisplay) || 0));
        const finalTotalFeeStr = Number.isInteger(finalTotalFeeVal) ? finalTotalFeeVal.toString() : finalTotalFeeVal.toFixed(1);

        // ★ [사용자 핵심 요구사항] 현장/선결제 금액 합쳐서 0만(0원 이하 또는 미기재)인 타임은 변환 제외!
        if (finalTotalFeeVal === null || finalTotalFeeVal === undefined || isNaN(finalTotalFeeVal) || finalTotalFeeVal <= 0) {
            continue;
        }

        let tableFeeDisplay = '';
        if (finalFieldFeeStr && finalPrepaidFeeStr) {
            tableFeeDisplay = `${finalFieldFeeStr} / ${finalPrepaidFeeStr} (합 ${finalTotalFeeStr})`;
        } else if (!finalFieldFeeStr && finalPrepaidFeeStr) {
            tableFeeDisplay = `선입 ${finalPrepaidFeeStr}`;
        } else {
            tableFeeDisplay = finalTotalFeeStr;
        }

        // 출처 판별 (골프탑 2가지 형식만 'golftop', 그 외에는 'golfrock')
        let rowSource = currentSource || docDefaultSource;
        const fullCheck = line + ' ' + subLinesText;

        // 1. 구장명이 '-'로 시작하면 무조건 골프락! (+선입이 있어도 무조건 골프락)
        if (currentCourseStartsWithDash || currentGolfRaw.startsWith('-')) {
            rowSource = 'golfrock';
        } 
        // 2. 골프탑 2가지 형식(카톡 10/20(화) 17:18 날짜 접두사 또는 잔여타임 표 형식) 검사
        else if (
            /\d{1,2}\/\d{1,2}\([가-힣]\)\s+\d{1,2}:\d{2}/.test(fullCheck) ||
            hasSlashFee || 
            fullCheck.includes('잔여타임') ||
            fullCheck.includes('현장/선 결제') ||
            fullCheck.includes('현장/선결제') ||
            /Bella|Monti|Challenger|Champion/i.test(fullCheck)
        ) {
            rowSource = 'golftop';
        } 
        // 3. 골프탑 형식 3 (구장명 '-' 없고 대기중:숫자[ 또는 (남남) 등)
        else if (
            /대기(?:중)?\s*:\s*\d+\s*\[/.test(fullCheck) || 
            /\([남여]{1,2}\)/.test(fullCheck) || 
            /\[현장\s*\d+(?:\.\d+)?\]/.test(fullCheck)
        ) {
            rowSource = 'golftop';
        } else {
            rowSource = currentSource || docDefaultSource || 'golfrock';
        }

        const finalGolf = currentGolf || '(구장명 없음)';
        const finalRegion = currentRegion || '미표시';
        const isActuallyMapped = currentMapped && !!currentGolf && currentGolf !== '(구장명 없음)';

        // 테이블 행(TR) 생성 및 다중 시간 지원 (한 줄에 여러 시간이 있는 경우 각각 티타임 행 생성)
        for (const rawTimeStr of allTimes) {
            const timeParts = rawTimeStr.split(':');
            let currentMins = parseInt(timeParts[0], 10) * 60 + parseInt(timeParts[1], 10);

            let partMatched = false;
            if (currentMins < 10 * 60) { if (fChk1) partMatched = true; }
            else if (currentMins < 16 * 60) { if (fChk2) partMatched = true; }
            else { if (fChk3) partMatched = true; }
            if (!partMatched) continue;

            let shiftedMins = currentMins - adjustMinsVal;
            if (shiftedMins < 0) shiftedMins += 24 * 60;
            let hr = Math.floor(shiftedMins / 60);
            let mn = shiftedMins % 60;
            let timeInt = (hr < 10 ? '0' + hr : '' + hr) + (mn < 10 ? '0' + mn : '' + mn);

            const tr = document.createElement('tr');
            tr.dataset.source = rowSource;
            tr.dataset.roomType = roomType;
            tr.dataset.origRoomType = roomType;
            tr.dataset.isPrepaid = isPrepaid ? 'true' : 'false';
            tr.dataset.isMeal = isMeal ? 'true' : 'false';
            const rowIsSeontiOrConfirmed = isTransferMode ? isTransferConfirmedOrSeonti : (isSeontiOrDaegi || isConfirmed || isDaegi);
            tr.dataset.isSeontiOrDaegi = rowIsSeontiOrConfirmed ? 'true' : 'false';
            if (isTransferMode) {
                if (isTransferConfirmedOrSeonti) {
                    tr.dataset.manualSeonti = 'true';
                    tr.dataset.roomType = '양도';
                    tr.dataset.origRoomType = '양도';
                }
            } else if (isConfirmed || isDaegi) {
                tr.dataset.manualSeonti = 'true';
                tr.dataset.roomType = '선티방';
                tr.dataset.origRoomType = '선티방';
            }
            tr.dataset.isConfirmed = isConfirmed ? 'true' : 'false';
            tr.dataset.isDaegi = isDaegi ? 'true' : 'false';
            tr.dataset.fullRawText = fullCheckText;
            tr.dataset.waitPax = String(actualWaitPax);
            tr.dataset.waitGender = resolvedWaitGender;
            tr.dataset.isMapped = isActuallyMapped ? 'true' : 'false';
            tr.dataset.rawGolf = currentGolfRaw;
            tr.dataset.golfmonGolf = currentGolfmon;
            tr.dataset.golfpangGolf = currentGolfpang;
            tr.dataset.golmarketGolf = currentGolmarket;
            tr.dataset.golfrockGolf = currentGolfrock;
            tr.dataset.golflandGolf = currentGolfland;
            tr.dataset.golftopGolf = currentGolftop;
            tr.dataset.baseFee = finalTotalFeeStr;
            tr.dataset.origBaseFee = finalTotalFeeStr;
            tr.dataset.totalFee = finalTotalFeeStr;
            tr.dataset.origTotalFee = finalTotalFeeStr;
            tr.dataset.fieldFee = finalFieldFeeStr;
            tr.dataset.origFieldFee = finalFieldFeeStr;
            tr.dataset.prepaidFee = finalPrepaidFeeStr;
            tr.dataset.origPrepaidFee = finalPrepaidFeeStr;
            tr.dataset.hasSlashFee = hasSlashFee ? 'true' : 'false';
            tr.dataset.slashFrontVal = slashFrontVal.toString();
            tr.dataset.slashBackVal = slashBackVal.toString();
            tr.dataset.prepaidAmount = rowPrepaidAmount.toString();

            const finalDate = rowDate || currentDate;
            tr.innerHTML = `
                <td>${finalDate}</td>
                <td>${finalRegion}</td>
                <td>${finalGolf}</td>
                <td>${timeInt}</td>
                <td>${tableFeeDisplay}</td>
                <td>${cady}</td>
                <td>${joinCondition}</td>
                <td>${sizenum}</td>
            `;

            rowDataList.push({
                date: finalDate,
                region: finalRegion,
                golf: finalGolf,
                rawGolf: currentGolfRaw,
                golfmonGolf: currentGolfmon,
                golfpangGolf: currentGolfpang,
                golmarketGolf: currentGolmarket,
                golfrockGolf: currentGolfrock,
                golflandGolf: currentGolfland,
                golftopGolf: currentGolftop,
                isMapped: isActuallyMapped,
                time: timeInt,
                fee: finalTotalFeeStr || extractPureFeeMan(tableFeeDisplay),
                displayFee: tableFeeDisplay,
                totalFee: finalTotalFeeStr,
                fieldFee: finalFieldFeeStr,
                prepaidFee: finalPrepaidFeeStr,
                baseFee: finalTotalFeeStr,
                origBaseFee: finalTotalFeeStr,
                hasSlashFee: hasSlashFee,
                slashFrontVal: slashFrontVal,
                slashBackVal: slashBackVal,
                prepaidAmount: rowPrepaidAmount,
                cady: cady,
                condition: joinCondition,
                sizenum: sizenum,
                isMeal: isMeal,
                roomType: roomType,
                origRoomType: roomType,
                isSeontiOrDaegi: isSeontiOrDaegi,
                isConfirmed: isConfirmed,
                isDaegi: isDaegi,
                fullRawText: fullCheckText,
                waitPax: actualWaitPax,
                waitGender: resolvedWaitGender,
                coursePriceAdj: '',
                source: rowSource,
                tr: tr
            });
        }
    }

    // 날짜 및 시간순 정렬
    rowDataList.sort((a, b) => {
        const dA = a.date.split('.'), dB = b.date.split('.');
        const mA = parseInt(dA[0], 10) || 0, mB = parseInt(dB[0], 10) || 0;
        if (mA !== mB) return mA - mB;
        const dayA = parseInt(dA[1], 10) || 0, dayB = parseInt(dB[1], 10) || 0;
        if (dayA !== dayB) return dayA - dayB;
        return (a.time || '').localeCompare(b.time || '');
    });

    // 미등록 구장 목록 추출 (유효한 티타임 행을 생성한 구장 중 사전에 미등록된 구장)
    const unmappedCourses = [];
    const seen = new Set();
    rowDataList.forEach(r => {
        if (!r.isMapped && r.rawGolf && !seen.has(r.rawGolf)) {
            seen.add(r.rawGolf);
            unmappedCourses.push(r.rawGolf);
        }
    });

    return { rowDataList, unmappedCourses };
}

// 날짜 비교 헬퍼 함수
function compareDateStrings(dAStr, dBStr) {
    if (!dAStr && !dBStr) return 0;
    if (!dAStr) return 1;
    if (!dBStr) return -1;
    const dA = dAStr.split('.'), dB = dBStr.split('.');
    const mA = parseInt(dA[0], 10) || 0, mB = parseInt(dB[0], 10) || 0;
    if (mA !== mB) return mA - mB;
    const dayA = parseInt(dA[1], 10) || 0, dayB = parseInt(dB[1], 10) || 0;
    return dayA - dayB;
}

let currentSortType = 'time'; // 'time' or 'golf'
let currentSortDir = 'asc';   // 'asc' or 'desc'

function updateSortBarUI() {
    const btnGolf = document.getElementById('btnSortGolf');
    const btnTime = document.getElementById('btnSortTime');
    const arrowGolf = document.getElementById('arrowSortGolf');
    const arrowTime = document.getElementById('arrowSortTime');

    if (btnGolf && arrowGolf) {
        if (currentSortType === 'golf') {
            btnGolf.classList.add('active');
            arrowGolf.innerText = currentSortDir === 'asc' ? '▲ ㄱ-ㅎ' : '▼ ㅎ-ㄱ';
        } else {
            btnGolf.classList.remove('active');
            arrowGolf.innerText = '⇅';
        }
    }

    if (btnTime && arrowTime) {
        if (currentSortType === 'time') {
            btnTime.classList.add('active');
            arrowTime.innerText = currentSortDir === 'asc' ? '▲ 이른순' : '▼ 늦은순';
        } else {
            btnTime.classList.remove('active');
            arrowTime.innerText = '⇅';
        }
    }
}

function sortTableAndCards(type) {
    const tbody = document.getElementById('tableBody');
    if (!tbody) return;
    const trs = Array.from(tbody.querySelectorAll('tr'));
    if (trs.length === 0) {
        showToast('정렬할 티타임이 없습니다.');
        return;
    }

    if (currentSortType === type) {
        // 동일 정렬 항목 다시 클릭 -> 방향 반전
        currentSortDir = (currentSortDir === 'asc') ? 'desc' : 'asc';
    } else {
        // 다른 정렬 항목 클릭 -> 기본 오름차순(asc) 시작
        currentSortType = type;
        currentSortDir = 'asc';
    }

    trs.sort((a, b) => {
        const dateA = a.cells[0]?.textContent.trim() || '';
        const dateB = b.cells[0]?.textContent.trim() || '';
        const golfA = a.cells[2]?.textContent.trim() || '';
        const golfB = b.cells[2]?.textContent.trim() || '';
        const timeA = (a.cells[3]?.textContent.trim() || '').replace(':', '');
        const timeB = (b.cells[3]?.textContent.trim() || '').replace(':', '');

        if (currentSortType === 'golf') {
            // 1순위: 구장명 (한 번 누르면 ㄱㄴㄷ 순, 한 번 더 누르면 역순)
            const cmpGolf = golfA.localeCompare(golfB, 'ko');
            if (cmpGolf !== 0) {
                return currentSortDir === 'asc' ? cmpGolf : -cmpGolf;
            }
            // 2순위: 날짜 (오름차순)
            const cmpDate = compareDateStrings(dateA, dateB);
            if (cmpDate !== 0) return cmpDate;
            // 3순위: 시간 (오름차순)
            return (parseInt(timeA, 10) || 0) - (parseInt(timeB, 10) || 0);
        } else {
            // 조인과 양도가 함께 있는 경우: 조인 먼저 따로, 양도 나중 따로 분리 유지
            const isTransA = (a.dataset.roomType === '양도' || (a.cells[4]?.textContent || '').includes('양도'));
            const isTransB = (b.dataset.roomType === '양도' || (b.cells[4]?.textContent || '').includes('양도'));
            if (isTransA !== isTransB) {
                return isTransA ? 1 : -1;
            }
            // 1순위: 날짜 (날짜별 묶음 유지)
            const cmpDate = compareDateStrings(dateA, dateB);
            if (cmpDate !== 0) return cmpDate;
            // 2순위: 시간 (한 번 누르면 이른 시간부터, 한 번 더 누르면 늦은 시간부터)
            const tA = parseInt(timeA, 10) || 0;
            const tB = parseInt(timeB, 10) || 0;
            if (tA !== tB) {
                return currentSortDir === 'asc' ? (tA - tB) : (tB - tA);
            }
            // 3순위: 구장명 (가나다순)
            return golfA.localeCompare(golfB, 'ko');
        }
    });

    trs.forEach(tr => tbody.appendChild(tr));
    renderCardList();
    saveCurrentTableState();
    updateSortBarUI();

    if (currentSortType === 'golf') {
        showToast(currentSortDir === 'asc' ? '구장명 가나다순(ㄱ→ㅎ) 정렬' : '구장명 역순(ㅎ→ㄱ) 정렬');
    } else {
        showToast(currentSortDir === 'asc' ? '⏰ 이른 시간순 정렬' : '⏰ 늦은 시간순 정렬');
    }
}

function applyParsedData(parsed, type) {
    try {
        const tbody = document.getElementById('tableBody');
        if (!tbody) return;

        const newItems = (parsed && Array.isArray(parsed.rowDataList)) ? parsed.rowDataList : [];
        const existingTrs = Array.from(tbody.querySelectorAll('tr'));
        const existingSelectedTrs = existingTrs.filter(tr => tr.classList.contains('selected'));
        const hasExistingData = existingTrs.length > 0;
        const shouldSmartPrepend = isSmartPrependActive() && hasExistingData && newItems.length > 0;

        if (shouldSmartPrepend) {
            // 1. 선택 체크가 안 된 기존 타임은 목록에서 완전 삭제 (체크된 타임만 그대로 보존!)
            if (existingSelectedTrs.length > 0) {
                existingTrs.forEach(tr => {
                    if (!tr.classList.contains('selected')) {
                        tr.remove();
                    }
                });
            }

            // 2. 신규 추가된 타임과 기존 체크 타임 간 중복(날짜+구장+시간 동일) 검사
            //    -> 동일 타임 발견 시: 가격/인원 변동 감지(인하 배지 및 새 인원 갱신), 기존 체크(selected) 상태 완벽 인계, 신규 정보로 교체!
            const remainingExistingTrs = Array.from(tbody.querySelectorAll('tr.selected'));
            const existingMap = new Map();

            // 구장명 정규화 헬퍼 (cc, gc, 괄호 홀수(9홀x2, p9 등), 지역명, 특수문자 제거)
            const cleanCourseMatchName = (name) => {
                if (!name) return '';
                let s = String(name).trim();
                s = s.replace(/\(?\d+\s*홀(?:\s*[x*]\s*\d+)?\)?|\(?p\d*\)?/gi, '');
                s = s.replace(/\((?:충청도|강원도|경기북부|경기남부|인천경인|전라도|경상도|제주)\)/gi, '');
                s = s.replace(/cc|gc|골프클럽|컨트리클럽|골프장/gi, '');
                return s.replace(/[\s\-_()[\]]/g, '').toLowerCase();
            };

            const makeMatchKey = (d, g, t, r) => {
                const normD = (typeof extractDayNumber === 'function' ? extractDayNumber(d) : '') || (d || '').trim();
                const normG = cleanCourseMatchName(g);
                const normT = (t || '').toString().replace(/[^\d]/g, '');
                const normR = (r === '양도') ? '양도' : '조인';
                return `${normD}|${normG}|${normT}|${normR}`;
            };

            remainingExistingTrs.forEach(oldTr => {
                const c = oldTr.querySelectorAll('td');
                const oDate = (c[0]?.textContent || oldTr.dataset.date || '').trim();
                const oGolf = (c[2]?.textContent || oldTr.dataset.rawGolf || oldTr.dataset.golf || '').trim();
                const oTime = (c[3]?.textContent || oldTr.dataset.time || '').trim();
                const oRoomType = (oldTr.dataset.roomType === '양도' || (c[4]?.textContent || '').includes('양도')) ? '양도' : '조인';
                const key = makeMatchKey(oDate, oGolf, oTime, oRoomType);
                existingMap.set(key, oldTr);
            });

            let priceUpdatedCount = 0;
            let peopleUpdatedCount = 0;

            newItems.forEach(item => {
                if (!item || !item.tr) return;
                const newDate = (item.date || '').trim();
                const newGolf = (item.golf || item.rawGolf || '').trim();
                const newTime = (item.time || '').trim();
                const newRoomType = (item.roomType === '양도' || item.tr?.dataset.roomType === '양도') ? '양도' : '조인';
                const key = makeMatchKey(newDate, newGolf, newTime, newRoomType);

                const oldTr = existingMap.get(key);
                if (oldTr) {
                    const oldC = oldTr.querySelectorAll('td');
                    const oldFee = parseFloat(oldTr.dataset.totalFee || oldTr.dataset.baseFee || oldC[4]?.textContent?.replace(/[^\d.]/g, '')) || 0;
                    const newFee = parseFloat(item.tr.dataset.totalFee || item.tr.dataset.baseFee || item.tr.querySelectorAll('td')[4]?.textContent?.replace(/[^\d.]/g, '')) || 0;

                    // 동일 타임의 가격이 변동(인하)된 경우: 이전 금액 기억 및 가격인하 배지 부여
                    if (oldFee > 0 && newFee > 0 && oldFee > newFee) {
                        const diff = Math.round((newFee - oldFee) * 10) / 10;
                        item.tr.dataset.isPriceDropped = 'true';
                        item.tr.dataset.prevFee = oldFee.toString();
                        item.tr.dataset.priceDiff = diff.toString();
                        priceUpdatedCount++;
                        console.log(`[가격 인하 갱신] ${newGolf} (${newDate} ${newTime}): 기존 ${oldFee}만 ➔ 새 가격 ${newFee}만 (${diff}만)`);
                    } else if (oldTr.dataset.isPriceDropped === 'true' && oldTr.dataset.prevFee) {
                        item.tr.dataset.isPriceDropped = 'true';
                        item.tr.dataset.prevFee = oldTr.dataset.prevFee;
                        item.tr.dataset.priceDiff = oldTr.dataset.priceDiff;
                    }

                    // 인원수(sizenum) 및 조건(condition) 변동 감지
                    const oldPeople = (oldC[7]?.textContent || '').trim();
                    const newPeople = (item.tr.querySelectorAll('td')[7]?.textContent || '').trim();
                    if (oldPeople && newPeople && oldPeople !== newPeople) {
                        peopleUpdatedCount++;
                        console.log(`[인원수 변동 갱신] ${newGolf} (${newDate} ${newTime}): 기존 [${oldPeople}] ➔ 새 인원 [${newPeople}]`);
                    }

                    // 기존에 체크되어 있던 타임은 무조건 체크(selected) 상태 100% 유지!
                    if (oldTr.classList.contains('selected')) {
                        item.tr.classList.add('selected');
                        item.isPreservedSelection = true;
                    }

                    oldTr.remove();
                    existingMap.delete(key);
                    const remIdx = remainingExistingTrs.indexOf(oldTr);
                    if (remIdx >= 0) remainingExistingTrs.splice(remIdx, 1);
                }
            });

            // 추가된 신규 데이터 중, 기존에 체크 유지된 항목을 제외한 '완전 순수 신규' 항목들에 대해서만 자동선택 적용
            const pureNewTrs = newItems.filter(it => it.tr && !it.isPreservedSelection).map(it => it.tr);
            const newSelectedCount = pureNewTrs.length > 0 ? applyAutoSelectTwoToTrs(pureNewTrs) : 0;

            // 3. 신규 추가된 타임들을 상단에 먼저 배치 (prepend)
            // ※ newItems[0], newItems[1], ... 순서가 그대로 유지되도록 firstExistingTr 앞에 순차 삽입
            const firstExistingTr = tbody.firstElementChild;
            newItems.forEach(item => {
                if (!item || !item.tr) return;
                if (firstExistingTr) {
                    tbody.insertBefore(item.tr, firstExistingTr);
                } else {
                    tbody.appendChild(item.tr);
                }
            });

            // 4. 공지 적용 규칙 자동 반영
            applyAllActiveNoticeRules();

            // 5. 화면 카드 뷰 및 배지 즉시 갱신 & 상태 영구 저장
            renderCardList();
            updateSelectedBadge();
            saveCurrentTableState();

            // 6. 입력창 비우기 (중복 추가 방지)
            const inputEl = document.getElementById('inputText');
            if (inputEl) inputEl.value = '';
            try { localStorage.removeItem('v2_savedInputText'); } catch(e) {}

            const keptCount = remainingExistingTrs.length;
            const priceMsg = priceUpdatedCount > 0 ? `, 가격인하 ${priceUpdatedCount}건 갱신` : '';
            showToast(`신규 타임 ${newItems.length}건 상단 우선배치 완료! (기존 체크 유지${priceMsg})`);
            return true;
        }

        tbody.innerHTML = '';

        if (newItems.length > 0) {
            newItems.forEach(item => {
                if (item && item.tr) tbody.appendChild(item.tr);
            });
        }
        applyAllActiveNoticeRules();
        currentSortType = 'time';
        currentSortDir = 'asc';
        updateSortBarUI();
        renderCardList();
        saveCurrentTableState();
        const count = newItems.length;
        if (type === 'transfer') {
            showToast(`총 ${count}건의 양도 건이 선별되었습니다. (조인 건 제외)`);
        } else if (type === 'both') {
            const transferCount = newItems.filter(it => it.roomType === '양도' || it.tr?.dataset.roomType === '양도').length;
            const joinCount = count - transferCount;
            showToast(`한번에 원클릭 완료: 조인 ${joinCount}건 + 양도 ${transferCount}건 (총 ${count}건)`);
        } else if (type === 'special4') {
            const transferLabel = (lastUsedMacroType === 'transfer') ? ' [양도]' : '';
            showToast(`특정구장 전용 변환 완료${transferLabel}: 총 ${count}건`);
        } else {
            showToast(`총 ${count}건이 변환되었습니다.`);
        }
        return false;
    } catch (e) {
        console.warn('applyParsedData safe error:', e);
        return false;
    }
}

function processData(type) {
    if (typeof isUserAuthenticated === 'function' && !isUserAuthenticated()) {
        showToast('회원 로그인이 필요합니다.');
        if (typeof showAuthOverlay === 'function') showAuthOverlay();
        return null;
    }
    const parsed = parseInputData(type);
    applyParsedData(parsed, type);
    return parsed;
}

// 티타임 카드 렌더링 함수 (AdGuard 스타일 컴팩트 모바일 뷰 & 드래그 다중 선택 지원)
let isCardDragging = false;
let dragTargetState = false;
let lastHoveredIndex = null;

// [대용량 최적화]: 6,000~8,000건 이상의 대용량 티타임도 0.05초 만에 렌더링하는 지연 가상 렌더링(Infinite Scroll) 설정
let visibleCardLimit = 100;
const INITIAL_CARD_CHUNK = 100;
const SCROLL_CARD_CHUNK = 80;

function createCardElement(tr, idx, trs) {
    const cells = tr.querySelectorAll('td');
    const date = cells[0]?.textContent || '';
    const region = cells[1]?.textContent || '';
    const golf = cells[2]?.textContent || '';
    const time = cells[3]?.textContent || '';
    const fee = cells[4]?.textContent || '';
    const cady = cells[5]?.textContent || '';
    const condition = cells[6]?.textContent || '';
    const sizenum = cells[7]?.textContent || '';
    const isSelected = tr.classList.contains('selected');
    const roomType = tr.dataset.roomType || '';
    const isMapped = tr.dataset.isMapped !== 'false';
    const isNoticeAdjusted = tr.dataset.noticeAdjusted === 'true';
    const noticePrice = tr.dataset.noticePrice || '';
    const noticeTagDesc = tr.dataset.noticeTagDesc || '';
    const hasSlashFee = tr.dataset.hasSlashFee === 'true';
    const slashBackVal = tr.dataset.slashBackVal || '';
    const rawNoticeReceivedAt = tr.dataset.noticeReceivedAt || '';
    const noticeReceivedTimestamp = tr.dataset.noticeReceivedTimestamp || '';
    const noticeReceivedAt = formatNoticeReceivedTime(rawNoticeReceivedAt, noticeReceivedTimestamp);
    let noticeTagHtml = '';
    if (isNoticeAdjusted) {
        const timeBadge = noticeReceivedAt ? ` <span style="font-size:9.5px; opacity:0.85;">${noticeReceivedAt}</span>` : '';
        const timeTooltip = noticeReceivedAt ? ` [수신: ${noticeReceivedAt}]` : '';

        if (noticeTagDesc) {
            noticeTagHtml = `<span class="card-tag notice-tag" data-course="${escapeAttr(golf)}" style="cursor: pointer;" title="공지 자동 적용${timeTooltip}: 클릭 시 공지 전문 보기">공지 ${noticeTagDesc}${timeBadge}</span>`;
        } else if (noticePrice) {
            if (hasSlashFee && slashBackVal) {
                noticeTagHtml = `<span class="card-tag notice-tag" data-course="${escapeAttr(golf)}" style="cursor: pointer;" title="공지 금액 ${noticePrice}만 + 선결제 ${slashBackVal}만${timeTooltip}: 클릭 시 공지 전문 보기">공지 ${noticePrice}만 / ${slashBackVal}만${timeBadge}</span>`;
            } else {
                noticeTagHtml = `<span class="card-tag notice-tag" data-course="${escapeAttr(golf)}" style="cursor: pointer;" title="공지 금액 ${noticePrice}만 자동 적용${timeTooltip}: 클릭 시 공지 전문 보기">공지 ${noticePrice}만${timeBadge}</span>`;
            }
        }
    }

    const hasPriceNotice = isNoticeAdjusted && (tr.dataset.noticeType === 'target' || tr.dataset.noticeType === 'discount');
    const coursePriceAdj = parseFloat(tr.dataset.coursePriceAdj) || 0;
    let courseAdjTagHtml = '';
    if (coursePriceAdj !== 0) {
        const sign = coursePriceAdj > 0 ? `+${coursePriceAdj}` : `${coursePriceAdj}`;
        const partNum = getTimePartNumber(time);
        const partLabel = `${partNum}부`;
        courseAdjTagHtml = `<span class="card-tag course-adj-tag" title="특정구장 가격조정 [${partLabel}] (${sign}만 적용)">${partLabel} ${sign}만</span>`;
    }

    // 가격 인하 감지 (이전 등록 이력 대비 또는 공지/특정구장 할인 적용 대비)
    const totalFee = tr.dataset.totalFee || tr.dataset.baseFee || fee;
    const rowFieldFee = tr.dataset.fieldFee || '';
    const rowPrepaidFee = tr.dataset.prepaidFee || '';
    const currentFeeNum = parseFloat(tr.dataset.totalFee || tr.dataset.baseFee) || parseFloat((fee || '').toString().match(/(\d+(?:\.\d+)?)/)?.[1]) || 0;
    const histKey1 = makeHistoryKey(date, golf, time);
    const histKey2 = makeHistoryKey(date, tr.dataset.rawGolf, time);
    const histRecord = registeredHistory[histKey1] || registeredHistory[histKey2];

    let prevFee = null;
    let priceDiff = 0;
    let isPriceDropped = false;

    if (histRecord && typeof histRecord.fee === 'number' && histRecord.fee > currentFeeNum && currentFeeNum > 0) {
        prevFee = histRecord.fee;
        priceDiff = Math.round((currentFeeNum - prevFee) * 10) / 10;
        isPriceDropped = true;
    } else if (tr.dataset.baseFee && parseFloat(tr.dataset.baseFee) > currentFeeNum && currentFeeNum > 0) {
        prevFee = parseFloat(tr.dataset.baseFee);
        priceDiff = Math.round((currentFeeNum - prevFee) * 10) / 10;
        isPriceDropped = true;
    } else if (!hasPriceNotice && parseFloat(tr.dataset.coursePriceAdj) < 0) {
        const adj = parseFloat(tr.dataset.coursePriceAdj);
        prevFee = Math.round((currentFeeNum - adj) * 10) / 10;
        priceDiff = adj;
        isPriceDropped = true;
    }

    let priceDropTagHtml = '';
    if (isPriceDropped && prevFee !== null) {
        tr.dataset.isPriceDropped = 'true';
        tr.dataset.prevFee = prevFee.toString();
        tr.dataset.priceDiff = priceDiff.toString();
        const sign = priceDiff > 0 ? `+${priceDiff}` : `${priceDiff}`;
        priceDropTagHtml = `<span class="card-tag price-dropped" title="이전 등록/기준가 ${prevFee}만 -> 현재 ${totalFee}만 (${sign}만 인하)">${prevFee}만->${totalFee}만 (${sign}만)</span>`;
    } else {
        delete tr.dataset.isPriceDropped;
        delete tr.dataset.prevFee;
        delete tr.dataset.priceDiff;
    }

    let feeCardHtml = '';
    if (rowFieldFee && rowPrepaidFee) {
        feeCardHtml = `현장 ${rowFieldFee}만 / 선입 ${rowPrepaidFee}만 <span style="font-size:9.5px; color:#4B5563; font-weight:700;">(합 ${totalFee}만)</span>`;
    } else if (!rowFieldFee && rowPrepaidFee) {
        feeCardHtml = `선입 ${rowPrepaidFee}만`;
    } else {
        feeCardHtml = `${totalFee || fee || '0'}만`;
    }

    const isTransferCard = (roomType === '양도' || tr.dataset.roomType === '양도');

    const card = document.createElement('div');
    card.className = 'tee-card' + (isSelected ? ' selected' : '') + (isTransferCard ? ' is-transfer' : ' is-join');
    card.dataset.index = idx;
    card.dataset.roomType = isTransferCard ? '양도' : '조인';
    if (tr.dataset.regId) card.dataset.regId = tr.dataset.regId;
    card.dataset.golf = golf;
    card.dataset.rawGolf = tr.dataset.rawGolf || '';
    card.dataset.date = date;
    card.dataset.time = time;
    tr.dataset.index = idx;

    let regionBg = '#EDE9FE';
    let regionColor = '#5C479C';
    if (region.includes('남부')) { regionBg = '#FEF3C7'; regionColor = '#92400E'; }
    else if (region.includes('북부')) { regionBg = '#DBEAFE'; regionColor = '#1E40AF'; }
    else if (region.includes('동부')) { regionBg = '#DCFCE7'; regionColor = '#166534'; }
    else if (region.includes('인천') || region.includes('경인')) { regionBg = '#E0E7FF'; regionColor = '#3730A3'; }
    else if (region.includes('충청')) { regionBg = '#F3E8FF'; regionColor = '#6B21A8'; }
    else if (region.includes('강원')) { regionBg = '#E0F2FE'; regionColor = '#0369A1'; }
    else if (region.includes('전라')) { regionBg = '#FFEDD5'; regionColor = '#9A3412'; }
    else if (region.includes('경상')) { regionBg = '#FEE2E2'; regionColor = '#991B1B'; }
    else if (region.includes('제주')) { regionBg = '#CCFBF1'; regionColor = '#115E59'; }

    const isSeonti = (roomType === '양도')
        ? (
            tr.dataset.manualSeonti === 'true' ||
            tr.dataset.isConfirmed === 'true' ||
            tr.dataset.isSeontiOrDaegi === 'true' ||
            (typeof isConfirmedTr === 'function' && isConfirmedTr(tr))
        )
        : (
            tr.dataset.isSeontiOrDaegi === 'true' ||
            tr.dataset.manualSeonti === 'true' ||
            tr.dataset.isConfirmed === 'true' ||
            tr.dataset.isDaegi === 'true' ||
            (typeof isDaegiTr === 'function' && isDaegiTr(tr)) ||
            (typeof isConfirmedTr === 'function' && isConfirmedTr(tr)) ||
            roomType === '선티방' ||
            roomType.includes('선티') ||
            /^[123]인$/.test(sizenum)
        );
    const isMeal = tr.dataset.isMeal === 'true';
    const source = tr.dataset.source || 'golfrock';
    const waitGender = tr.dataset.waitGender || (tr.dataset.waitPax === '0' || !tr.dataset.waitPax ? '인원없음' : '남');
    let waitGenderTagHtml = '';
    if (waitGender && waitGender !== '인원없음') {
        waitGenderTagHtml = `<span class="card-tag pax-gender" style="background:#FEF3C7; color:#92400E; font-weight:700;" title="골프락 대기성별: ${escapeAttr(waitGender)} (클릭하여 인원/가격 변경)">대기: ${escapeHtml(waitGender)}</span>`;
    } else {
        waitGenderTagHtml = `<span class="card-tag pax-gender" style="background:#F3F4F6; color:#6B7280;" title="골프락 대기성별: 인원없음 (클릭하여 인원/가격 변경)">대기없음</span>`;
    }
    const isConfirmedCard = typeof isConfirmedTr === 'function' && isConfirmedTr(tr);
    const isDaegiCard = typeof isDaegiTr === 'function' && isDaegiTr(tr);

    card.innerHTML = `
        <div class="card-check">
            <input type="checkbox" ${isSelected ? 'checked' : ''} tabindex="-1">
        </div>
        <div class="card-main">
            <div class="card-row-top">
                <div class="card-title-group">
                    <span class="card-golf">${golf}</span>
                    ${isTransferCard 
                        ? `<span class="card-room-badge transfer" title="양도 타임 (4인 - 클릭 시 인원/가격 변경)">양도</span>` 
                        : `<span class="card-room-badge join" title="조인 타임 (${sizenum || '조인'} - 클릭 시 인원/가격 변경)">조인</span>`
                    }
                    ${date ? `<span class="card-date">${date}</span>` : ''}
                    ${!isMapped ? `<span class="card-tag unmapped-tag" title="매핑사전에 미등록된 구장 (자동선택 제외)">미등록</span>` : ''}
                </div>
                <div class="card-meta-group">
                    ${region ? `<span class="card-region" style="background:${regionBg}; color:${regionColor};">${region}</span>` : ''}
                    <span class="card-source-badge ${source === 'golftop' ? 'source-top' : 'source-rock'}" data-index="${idx}" title="${source === 'golftop' ? '골프탑 데이터 (클릭 시 락/탑 변경)' : '골프락 데이터 (클릭 시 락/탑 변경)'}">${source === 'golftop' ? '탑' : '락'}</span>
                    <span class="card-time ${isSeonti ? 'is-seonti' : ''}" title="${isSeonti ? '선티 (확정금액)' : ''}">${time}</span>
                </div>
            </div>
            <div class="card-row-bottom">
                <span class="card-fee" title="클릭하여 가격/인원 변경">${feeCardHtml}</span>
                <label class="card-seonti-pill ${isSeonti ? 'active' : ''}" data-index="${idx}" title="${isSeonti ? '선티방으로 지정됨 (체크 해제 시 일반 타임 복구)' : '체크 시 선티방으로 강제 인식 (공지/특정구장 할인 제외)'}">
                    <input type="checkbox" class="chk-seonti" ${isSeonti ? 'checked' : ''}>
                    <span>${isSeonti ? (isTransferCard ? '선티' : '선티방') : '선티'}</span>
                </label>
                ${noticeTagHtml}
                ${courseAdjTagHtml}
                ${priceDropTagHtml}
                ${cady ? `<span class="card-tag">${cady}</span>` : ''}
                ${isMeal ? `<span class="card-tag meal" title="식사포함">식사포함</span>` : ''}
                ${condition ? `<span class="card-tag">${condition}</span>` : ''}
                ${isConfirmedCard ? `<span class="card-tag confirmed-tag" style="background:#EEF2FF; color:#4338CA; border:1px solid #C7D2FE; font-weight:700;" title="확정 타임 (최우선 선택)">확정</span>` : ''}
                ${isDaegiCard && !waitGenderTagHtml.includes('대기:') ? `<span class="card-tag daegi-tag" style="background:#FEF3C7; color:#92400E; border:1px solid #FDE68A; font-weight:700;" title="대기 타임 (최우선 선택)">대기</span>` : ''}
                ${roomType && roomType !== '미표시' && !roomType.includes('선티') ? `<span class="card-tag room">${roomType}</span>` : ''}
                ${waitGenderTagHtml}
                ${sizenum ? `<span class="card-tag pax" title="모집 인원 (클릭하여 인원/가격 변경)">${sizenum}</span>` : ''}
            </div>
        </div>
        <div class="card-right-actions">
            <button class="card-del-btn" title="삭제">&times;</button>
        </div>
    `;

    function applySelection(targetState) {
        card.classList.toggle('selected', targetState);
        const chk = card.querySelector('input[type="checkbox"]');
        if (chk) chk.checked = targetState;
        tr.classList.toggle('selected', targetState);
    }

    // 드래그 시작 (mousedown: 클릭 즉시 토글 및 드래그 모드 활성화)
    card.addEventListener('mousedown', (e) => {
        if (e.target.classList.contains('card-del-btn') || 
            e.target.closest('.notice-tag') || 
            e.target.closest('.card-seonti-pill') || 
            e.target.closest('.card-tag.meal') || 
            e.target.closest('.card-source-badge') ||
            e.target.closest('.card-fee') ||
            e.target.closest('.card-tag.pax') ||
            e.target.closest('.pax-gender') ||
            e.target.closest('.card-room-badge')) return;
        e.preventDefault();

        isCardDragging = true;
        dragTargetState = !card.classList.contains('selected');
        lastHoveredIndex = idx;

        applySelection(dragTargetState);
        updateSelectedBadge();
    });

    // 드래그 중 다른 카드 위로 마우스 진입 (mouseenter)
    card.addEventListener('mouseenter', () => {
        if (isCardDragging) {
            lastHoveredIndex = idx;
            applySelection(dragTargetState);
            updateSelectedBadge();
        }
    });

    // 카드 클릭 핸들러 (출처 토글, 마감/삭제 버튼 및 공지 태그 전문 보기, 식사포함 토글, 개별 가격/인원 수정 모달)
    card.addEventListener('click', (e) => {
        // ★ [사용자 요청] 개별 가격 또는 인원 클릭 시 수정 모달 오픈!
        const feeEl = e.target.closest('.card-fee');
        const paxEl = e.target.closest('.card-tag.pax') || e.target.closest('.pax-gender') || e.target.closest('.card-room-badge');
        if (feeEl || paxEl) {
            e.stopPropagation();
            e.preventDefault();
            openEditItemModal(tr, feeEl ? 'fee' : 'pax');
            return;
        }

        const sourceBadge = e.target.closest('.card-source-badge');
        if (sourceBadge) {
            e.stopPropagation();
            e.preventDefault();
            const cur = tr.dataset.source || 'golfrock';
            const nextSource = (cur === 'golftop') ? 'golfrock' : 'golftop';
            tr.dataset.source = nextSource;
            renderCardList(false);
            saveCurrentTableState();
            showToast(`출처가 [${nextSource === 'golftop' ? '골프탑(탑)' : '골프락(락)'}]으로 변경되었습니다.`);
            return;
        }
        const mealTag = e.target.closest('.card-tag.meal');
        if (mealTag) {
            e.stopPropagation();
            const cur = tr.dataset.isMeal === 'true';
            tr.dataset.isMeal = (!cur).toString();
            renderCardList(false);
            saveCurrentTableState();
            showToast(!cur ? '식사포함으로 지정되었습니다.' : '식사포함이 해제되었습니다.');
            return;
        }
        const noticeTag = e.target.closest('.notice-tag');
        if (noticeTag) {
            e.stopPropagation();
            const c = noticeTag.dataset.course || golf;
            showNoticeDetailModal(c);
            return;
        }
        if (e.target.classList.contains('card-del-btn')) {
            tr.remove();
            card.remove();
            updateSelectedBadge();
            saveCurrentTableState();
            if (document.querySelectorAll('#dataTable tbody tr').length === 0) renderCardList(true);
        }
    });

    // 선티 수동 체크박스 변경 이벤트 연결
    const seontiPill = card.querySelector('.card-seonti-pill');
    const chkSeonti = card.querySelector('.chk-seonti');
    if (seontiPill && chkSeonti) {
        seontiPill.addEventListener('mousedown', (e) => {
            e.stopPropagation();
        });
        chkSeonti.addEventListener('change', (e) => {
            e.stopPropagation();
            toggleSeontiStatus(tr, chkSeonti.checked);
        });
    }

    return card;
}

function loadMoreCards() {
    const cardContainer = document.getElementById('cardList');
    if (!cardContainer) return;
    const trs = Array.from(document.querySelectorAll('#dataTable tbody tr'));
    if (visibleCardLimit >= trs.length) {
        const sentinel = document.getElementById('cardLoadMoreSentinel');
        if (sentinel) sentinel.remove();
        return;
    }

    const prevLimit = visibleCardLimit;
    visibleCardLimit = Math.min(visibleCardLimit + SCROLL_CARD_CHUNK, trs.length);
    const nextBatch = trs.slice(prevLimit, visibleCardLimit);

    const fragment = document.createDocumentFragment();
    nextBatch.forEach((tr, i) => {
        const idx = prevLimit + i;
        fragment.appendChild(createCardElement(tr, idx, trs));
    });

    const sentinel = document.getElementById('cardLoadMoreSentinel');
    if (sentinel) {
        cardContainer.insertBefore(fragment, sentinel);
        if (visibleCardLimit >= trs.length) {
            sentinel.remove();
        } else {
            sentinel.innerHTML = `⬇️ 아래로 스크롤하여 더보기 (현재 ${visibleCardLimit.toLocaleString()}개 / 총 ${trs.length.toLocaleString()}개)`;
        }
    } else {
        cardContainer.appendChild(fragment);
    }
}

function renderCardList(resetLimit = true) {
    const cardContainer = document.getElementById('cardList');
    if (!cardContainer) return;
    cardContainer.innerHTML = '';
    const trs = Array.from(document.querySelectorAll('#dataTable tbody tr'));

    if (trs.length === 0) {
        cardContainer.innerHTML = `
            <div class="empty-state">
                <div class="empty-title">변환된 티타임이 없습니다</div>
                <div class="empty-desc">위 입력창에 티타임을 붙여넣고<br>[조인용 원클릭]을 실행해주세요.</div>
            </div>`;
        updateSelectedBadge();
        return;
    }

    if (resetLimit) {
        visibleCardLimit = INITIAL_CARD_CHUNK;
    }

    const fragment = document.createDocumentFragment();
    const sliceTrs = trs.slice(0, visibleCardLimit);

    sliceTrs.forEach((tr, idx) => {
        fragment.appendChild(createCardElement(tr, idx, trs));
    });

    if (trs.length > visibleCardLimit) {
        const sentinel = document.createElement('div');
        sentinel.id = 'cardLoadMoreSentinel';
        sentinel.className = 'card-load-more-sentinel';
        sentinel.style.cssText = 'text-align:center; padding:10px 6px; color:#6B7280; font-size:11px; font-weight:600; cursor:pointer; background:#F8FAFC; border-radius:6px; margin:8px 0; border:1px dashed #CBD5E1; transition:all 0.15s;';
        sentinel.innerHTML = `⬇️ 아래로 스크롤하여 더보기 (현재 ${Math.min(visibleCardLimit, trs.length).toLocaleString()}개 / 총 ${trs.length.toLocaleString()}개)`;
        sentinel.addEventListener('click', () => loadMoreCards());
        fragment.appendChild(sentinel);
    }

    cardContainer.appendChild(fragment);

    // 스크롤 이벤트 연결 (하단 접근 시 자동 추가 렌더링)
    if (!cardContainer.__hasScrollListener) {
        cardContainer.__hasScrollListener = true;
        cardContainer.addEventListener('scroll', () => {
            if (cardContainer.scrollTop + cardContainer.clientHeight >= cardContainer.scrollHeight - 250) {
                loadMoreCards();
            }
        });
    }

    // 고속 드래그 시 마우스 아래 카드를 실시간 감지하여 일괄 체크/해제
    cardContainer.onmousemove = (e) => {
        if (!isCardDragging) return;
        const hoveredCard = document.elementFromPoint(e.clientX, e.clientY)?.closest('.tee-card');
        if (hoveredCard) {
            const hIdx = parseInt(hoveredCard.dataset.index, 10);
            if (!isNaN(hIdx) && hIdx !== lastHoveredIndex) {
                lastHoveredIndex = hIdx;
                const targetTr = trs[hIdx];
                if (targetTr) {
                    hoveredCard.classList.toggle('selected', dragTargetState);
                    const chk = hoveredCard.querySelector('input[type="checkbox"]');
                    if (chk) chk.checked = dragTargetState;
                    targetTr.classList.toggle('selected', dragTargetState);
                    updateSelectedBadge();
                }
            }
        }
    };

    updateSelectedBadge();
}

// ==========================================
// 🚫 원클릭 마감/삭제 모듈
// ==========================================
function copyNoticeTextToClipboard(text) {
    if (!text) return;
    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).catch(() => {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand('copy'); } catch(e) {}
            ta.remove();
        });
    } else {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch(e) {}
        ta.remove();
    }
}

function handleSingleCardSoldOut(tr, card, golf, date, time, roomType) {
    const formattedDate = date ? `${date} ` : '';
    const typeLabel = roomType || '조인';
    const noticeText = `[예약 마감 안내]\n• ${golf} ${formattedDate}${time} (${typeLabel}) 예약 마감되었습니다.\n성원에 감사드립니다!`;
    
    copyNoticeTextToClipboard(noticeText);
    if (tr) tr.remove();
    if (card) card.remove();
    updateSelectedBadge();
    saveCurrentTableState();
    if (document.querySelectorAll('#dataTable tbody tr').length === 0) {
        renderCardList();
    }
    showToast(`[${golf} ${time}] 마감 처리 완료! (카톡 공지용 문구가 복사되었습니다)`);
}

function handleBatchSoldOut() {
    const selectedTrs = Array.from(document.querySelectorAll('#dataTable tbody tr.selected'));
    if (selectedTrs.length === 0) {
        showToast('마감 처리할 티타임을 1개 이상 선택(체크)해주세요.');
        return;
    }

    const items = [];
    selectedTrs.forEach(tr => {
        const cells = tr.querySelectorAll('td');
        const date = cells[0]?.textContent?.trim() || '';
        const golf = cells[2]?.textContent?.trim() || '';
        const time = cells[3]?.textContent?.trim() || '';
        const roomType = tr.dataset.roomType || '조인';
        const formattedDate = date ? `${date} ` : '';
        items.push(`• ${golf} ${formattedDate}${time} (${roomType})`);
    });

    const count = selectedTrs.length;
    const noticeText = `[예약 마감 안내]\n` + items.join('\n') + `\n위 티타임 예약 마감되었습니다.\n성원에 감사드립니다!`;
    copyNoticeTextToClipboard(noticeText);

    selectedTrs.forEach(tr => tr.remove());
    renderCardList();
    updateSelectedBadge();
    saveCurrentTableState();

    showToast(`선택된 ${count}개 티타임 마감 완료! (카톡 공지용 문구가 복사되었습니다)`);
}

// =========================================================================
// 🚫 문자 / 알림톡 붙여넣기 원클릭 글마감·삭제 시스템
// =========================================================================

let lastParsedSoldOutData = null;

// 문자/알림톡 텍스트 실시간 파싱 함수
function parseSoldOutBookingText(rawText) {
    if (!rawText || typeof rawText !== 'string') {
        return null;
    }
    const cleanText = rawText.trim();
    if (!cleanText) return null;

    // 1. 플랫폼 감지
    let platform = '';
    if (/골프몬|golfmon/i.test(cleanText)) platform = 'golfmon';
    else if (/골팡|golfpang/i.test(cleanText)) platform = 'golfpang';
    else if (/골마켓|golmarket/i.test(cleanText)) platform = 'golmarket';
    else if (/골프탑|golftop/i.test(cleanText)) platform = 'golftop';
    else if (/골프랜드|golfland/i.test(cleanText)) platform = 'golfland';
    else if (/골프락|golfrock/i.test(cleanText)) platform = 'golfrock';

    // 2. 구분 (조인 vs 양도 vs 전체)
    let roomType = '전체';
    if (/양도/.test(cleanText)) {
        roomType = '양도';
    } else if (/조인/.test(cleanText)) {
        roomType = '조인';
    }

    // 3. 날짜 추출 (예: "일정 : 11/15(일)", "일자 : 11월 15일", "11/15", "11.15", "2026-11-15")
    let dateStr = '';
    let dayOfWeek = '';
    const dateLabeledMatch = cleanText.match(/(?:일정|일자|날짜|일시)\s*[:：]?\s*(\d{1,2})[.\/월\-](\d{1,2})(?:일)?(?:\s*\(([월화수목금토일])\))?/);
    if (dateLabeledMatch) {
        const m = parseInt(dateLabeledMatch[1], 10);
        const d = parseInt(dateLabeledMatch[2], 10);
        dateStr = `${m}/${d}`;
        dayOfWeek = dateLabeledMatch[3] || '';
    } else {
        const dateMatch = cleanText.match(/\b(\d{1,2})[.\/](\d{1,2})(?:\(([월화수목금토일])\))?\b/);
        if (dateMatch) {
            const m = parseInt(dateMatch[1], 10);
            const d = parseInt(dateMatch[2], 10);
            dateStr = `${m}/${d}`;
            dayOfWeek = dateMatch[3] || '';
        }
    }

    // 4. 티업 시간 추출 (예: "티업 : 17:52", "시간 : 17:52", "17:52", "1752", "630")
    let timeStr = '';
    const timeLabeledMatch = cleanText.match(/(?:티업|시간|타임)\s*[:：]?\s*([012]?\d)\s*[:：시]?\s*([0-5]\d)/);
    if (timeLabeledMatch) {
        timeStr = `${timeLabeledMatch[1].padStart(2, '0')}:${timeLabeledMatch[2]}`;
    } else {
        const timeMatch = cleanText.match(/\b([012]?\d):([0-5]\d)\b/);
        if (timeMatch) {
            timeStr = `${timeMatch[1].padStart(2, '0')}:${timeMatch[2]}`;
        }
    }

    if (!timeStr) {
        // 4자리 연속 숫자 (예: "1752" -> "17:52", "0630" -> "06:30")
        // 또는 3자리 숫자 (예: "630" -> "06:30", "752" -> "07:52")
        const numTokens = cleanText.match(/\b\d{3,4}\b/g);
        if (numTokens) {
            for (const tok of numTokens) {
                if (tok.length === 4) {
                    const h = parseInt(tok.substring(0, 2), 10);
                    const m = parseInt(tok.substring(2, 4), 10);
                    // 연도(2024~2030) 제외
                    if (h === 20 && m >= 24 && m <= 30) continue;
                    if (h >= 5 && h <= 23 && m >= 0 && m <= 59) {
                        timeStr = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
                        break;
                    }
                } else if (tok.length === 3) {
                    const h = parseInt(tok.substring(0, 1), 10);
                    const m = parseInt(tok.substring(1, 3), 10);
                    if (h >= 5 && h <= 9 && m >= 0 && m <= 59) {
                        timeStr = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
                        break;
                    }
                }
            }
        }
    }

    // 5. 골프장명 추출
    let rawCourse = '';

    // 1순위: 사전(dictionary) 기반 탐색 (가장 정확한 구장명 식별)
    if (typeof dictionary === 'object' && Object.keys(dictionary).length > 0) {
        const sortedKeys = Object.keys(dictionary).sort((a, b) => b.length - a.length);
        for (const dictKey of sortedKeys) {
            if (dictKey.length >= 2 && cleanText.includes(dictKey)) {
                rawCourse = dictKey;
                break;
            }
        }
    }

    // 2순위: 구장명 라벨 탐색 (예: "골프장 : 옥스필드", "구장: 플라밍고", "클럽: 안성Q")
    if (!rawCourse || rawCourse.length < 2 || /^\d+$/.test(rawCourse)) {
        const labeledMatch = cleanText.match(/(?:골프장|구장명|구장|클럽)\s*[:：]?\s*([가-힣a-zA-Z0-9]+(?:\([가-힣a-zA-Z0-9]+\))?)/);
        if (labeledMatch && labeledMatch[1]) {
            const cand = labeledMatch[1].replace(/골프장|클럽|cc|gc/gi, '').trim();
            if (cand && cand.length >= 2 && !/^\d+$/.test(cand)) {
                rawCourse = cand;
            }
        }
    }

    // 3순위: 헤더 패턴: [플랫폼] / [구장명] [조인/양도] (순수 숫자 매칭 방지)
    if (!rawCourse || rawCourse.length < 2 || /^\d+$/.test(rawCourse)) {
        const firstLines = cleanText.split('\n').slice(0, 3).join(' ');
        const headerCourseMatch = firstLines.match(/(?:골프몬|골팡|골마켓|골프락|골프탑|골프랜드)?\s*[\/\[\]:]*\s*([가-힣a-zA-Z\s]{2,15})(?:cc|CC|골프장|클럽)?\s*(?:조인|양도)/i);
        if (headerCourseMatch && headerCourseMatch[1]) {
            const cand = headerCourseMatch[1].replace(/골프몬|골팡|골마켓|골프락|골프탑|골프랜드|[\/\[\]]/g, '').trim();
            if (cand && cand.length >= 2 && !/^\d+$/.test(cand)) {
                rawCourse = cand;
            }
        }
    }

    // 4순위: 플랫폼 접두사 제거 후 첫 단어 토큰 (예: "옥스필드 11/15 1752", "[골프탑] 안성Q 11/15 07:00")
    if (!rawCourse || rawCourse.length < 2 || /^\d+$/.test(rawCourse)) {
        const cleanNoPlatform = cleanText.replace(/^[\[\(]?(?:골프몬|골팡|골마켓|골프락|골프탑|골프랜드)[\]\)]?\s*[\/:\-]?\s*/i, '').trim();
        const firstTokenMatch = cleanNoPlatform.match(/^([가-힣a-zA-Z0-9]{2,15})/);
        if (firstTokenMatch && firstTokenMatch[1]) {
            const token = firstTokenMatch[1].trim();
            if (token && !/^\d+$/.test(token) && !/^(?:골프몬|골팡|골마켓|골프탑|골프랜드|골프락|양도|조인|예약|일정|일자|날짜|시간|티업)$/.test(token)) {
                rawCourse = token;
            }
        }
    }

    // 구장명 정규화 및 매핑
    let mappedCourse = rawCourse;
    let canonicalInfo = null;
    if (rawCourse) {
        canonicalInfo = (typeof getMappedName === 'function') ? getMappedName(rawCourse) : { name: rawCourse };
        if (canonicalInfo && canonicalInfo.name) {
            mappedCourse = canonicalInfo.name;
        }
    }

    // 6. 부가 정보 (금액, 요청자명)
    let priceStr = '';
    const priceMatch = cleanText.match(/(?:금액|그린피|회비)\s*[:：]?\s*(?:[1-4]인)?\s*([0-9,]+(?:\s*원|\s*만\s*원?))/);
    if (priceMatch) priceStr = priceMatch[1].trim();

    let requesterStr = '';
    const reqMatch = cleanText.match(/(?:요청자명|신청자명|신청자|예약자명|예약자|요청자)\s*[:：]?\s*([가-힣a-zA-Z]{2,10})/);
    if (reqMatch) requesterStr = reqMatch[1].trim();

    const isValid = Boolean(mappedCourse && (dateStr || timeStr));

    return {
        platform: platform,
        rawCourse: rawCourse,
        courseName: mappedCourse,
        date: dateStr,
        dayOfWeek: dayOfWeek,
        dateDisplay: dateStr ? (dateStr + (dayOfWeek ? `(${dayOfWeek})` : '')) : '',
        time: timeStr,
        roomType: roomType,
        price: priceStr,
        requester: requesterStr,
        canonicalInfo: canonicalInfo,
        isValid: isValid
    };
}

// 실시간 분석 결과 카드 갱신
function updateSoldOutModalParsedUI(parsed) {
    lastParsedSoldOutData = parsed;
    const badge = document.getElementById('soldOutParseStatusBadge');
    const valCourse = document.getElementById('soldOutValCourse');
    const valDate = document.getElementById('soldOutValDate');
    const valTime = document.getElementById('soldOutValTime');
    const valType = document.getElementById('soldOutValType');
    const selType = document.getElementById('selSoldOutRoomType');
    const extraBox = document.getElementById('soldOutExtraInfo');
    const valReq = document.getElementById('soldOutValRequester');
    const valPrice = document.getElementById('soldOutValPrice');
    const btnExecute = document.getElementById('btnExecuteSoldOut');

    if (!parsed || (!parsed.courseName && !parsed.time)) {
        if (badge) {
            badge.className = 'soldout-badge soldout-badge-waiting';
            badge.textContent = '문자 대기중';
        }
        if (valCourse) valCourse.textContent = '-';
        if (valDate) valDate.textContent = '-';
        if (valTime) valTime.textContent = '-';
        if (valType) valType.textContent = '-';
        if (selType) selType.value = '전체';
        if (extraBox) extraBox.style.display = 'none';
        if (btnExecute) btnExecute.disabled = true;
        return;
    }

    if (valCourse) valCourse.textContent = parsed.courseName || parsed.rawCourse || '구장 미인식';
    if (valDate) valDate.textContent = parsed.dateDisplay || parsed.date || '날짜 미인식';
    if (valTime) valTime.textContent = parsed.time || '시간 미인식';
    if (selType) {
        if (parsed.roomType === '양도' || parsed.roomType === '조인') {
            selType.value = parsed.roomType;
        } else {
            selType.value = '전체';
        }
    }
    if (valType) valType.textContent = parsed.roomType || '전체';

    if (extraBox && (parsed.requester || parsed.price)) {
        extraBox.style.display = 'flex';
        if (valReq) valReq.textContent = parsed.requester ? `요청자: ${parsed.requester}` : '';
        if (valPrice) valPrice.textContent = parsed.price ? `금액: ${parsed.price}` : '';
    } else if (extraBox) {
        extraBox.style.display = 'none';
    }

    if (parsed.isValid) {
        if (badge) {
            badge.className = 'soldout-badge soldout-badge-success';
            badge.textContent = '분석 완료';
        }
        if (btnExecute) btnExecute.disabled = false;
    } else {
        if (badge) {
            badge.className = 'soldout-badge soldout-badge-warn';
            badge.textContent = '정보 부족';
        }
        if (btnExecute) btnExecute.disabled = true;
    }

    // 플랫폼 자동 선택 반영 (문자에 명시된 플랫폼이 있으면 자동 체크)
    if (parsed.platform) {
        const pfMap = {
            golfmon: 'chkPfGolfmon',
            golfpang: 'chkPfGolfpang',
            golmarket: 'chkPfGolmarket',
            golftop: 'chkPfGolftop',
            golfland: 'chkPfGolfland',
            golfrock: 'chkPfGolfrock'
        };
        const targetId = pfMap[parsed.platform];
        if (targetId) {
            Object.values(pfMap).forEach(id => {
                const chk = document.getElementById(id);
                if (chk) {
                    chk.checked = (id === targetId);
                    chk.closest('label')?.classList.toggle('active', chk.checked);
                }
            });
        }
    }
}

// 모달 열기
function openSoldOutTextModal(initialText = '') {
    const modal = document.getElementById('soldOutTextModal');
    if (!modal) return;
    modal.style.display = 'flex';

    const txtArea = document.getElementById('txtSoldOutRaw');
    const progressBox = document.getElementById('soldOutProgressBox');
    if (progressBox) progressBox.style.display = 'none';

    if (txtArea) {
        if (initialText) {
            txtArea.value = initialText;
            const parsed = parseSoldOutBookingText(initialText);
            updateSoldOutModalParsedUI(parsed);
        } else if (!txtArea.value.trim()) {
            updateSoldOutModalParsedUI(null);
        } else {
            const parsed = parseSoldOutBookingText(txtArea.value);
            updateSoldOutModalParsedUI(parsed);
        }
        setTimeout(() => txtArea.focus(), 100);
    }
}

// 모달 닫기
function closeSoldOutTextModal() {
    const modal = document.getElementById('soldOutTextModal');
    if (modal) modal.style.display = 'none';
    const progressBox = document.getElementById('soldOutProgressBox');
    if (progressBox) progressBox.style.display = 'none';
}

// 실제 글 삭제/마감 실행 함수
async function executeSoldOutPostDeletion() {
    const txtArea = document.getElementById('txtSoldOutRaw');
    const rawText = txtArea ? txtArea.value.trim() : '';
    const parsed = parseSoldOutBookingText(rawText);

    if (!parsed || !parsed.isValid) {
        showToast('구장명과 날짜/시간 정보를 분석할 수 없습니다. 문자 내용을 확인해주세요.');
        return;
    }

    // 선택된 플랫폼 확인
    const selectedPlatforms = [];
    if (document.getElementById('chkPfGolfmon')?.checked) selectedPlatforms.push('golfmon');
    if (document.getElementById('chkPfGolfpang')?.checked) selectedPlatforms.push('golfpang');
    if (document.getElementById('chkPfGolmarket')?.checked) selectedPlatforms.push('golmarket');
    if (document.getElementById('chkPfGolftop')?.checked) selectedPlatforms.push('golftop');
    if (document.getElementById('chkPfGolfland')?.checked) selectedPlatforms.push('golfland');
    if (document.getElementById('chkPfGolfrock')?.checked) selectedPlatforms.push('golfrock');

    if (selectedPlatforms.length === 0) {
        showToast('삭제/마감할 대상 플랫폼을 1개 이상 선택해주세요.');
        return;
    }

    const modeRadio = document.querySelector('input[name="soldOutActionMode"]:checked');
    const actionMode = modeRadio ? modeRadio.value : 'delete'; // 'delete' or 'soldout'
    const actionLabel = (actionMode === 'soldout' ? '마감' : '삭제');

    const progressBox = document.getElementById('soldOutProgressBox');
    const progressTitle = document.getElementById('soldOutProgressTitle');
    const progressDesc = document.getElementById('soldOutProgressDesc');
    const btnExecute = document.getElementById('btnExecuteSoldOut');

    if (progressBox) {
        progressBox.style.display = 'block';
        progressBox.style.background = '#EFF6FF';
        progressBox.style.borderColor = '#BFDBFE';
    }
    if (progressTitle) {
        progressTitle.innerHTML = `<span style="animation: spinNoticeSync 1s linear infinite; display: inline-block;">⏳</span> [${parsed.courseName} ${parsed.dateDisplay || parsed.date} ${parsed.time}] 글 ${actionLabel} 진행 중...`;
    }
    if (progressDesc) {
        progressDesc.textContent = `대상 플랫폼: ${selectedPlatforms.map(p => p.toUpperCase()).join(', ')}`;
    }
    if (btnExecute) btnExecute.disabled = true;

    // Helper: Golfmon 삭제 실행
    const runGolfmon = () => new Promise((resolve) => {
        chrome.tabs.query({ url: ["*://*.golfmon.net/*", "*://golfmon.net/*"] }, (tabs) => {
            if (!tabs || tabs.length === 0) {
                if (confirm("열려 있는 골프몬(golfmon.net) 탭이 없습니다.\n골프몬 사이트를 새 탭으로 여시겠습니까?")) {
                    chrome.tabs.create({ url: "https://golfmon.net/" });
                }
                return resolve({ platform: 'golfmon', success: false, message: '골프몬 탭을 찾을 수 없습니다.' });
            }

            const selRoomType = document.getElementById('selSoldOutRoomType')?.value || parsed.roomType || '전체';
            const golfmonTab = tabs[0];
            const payload = {
                action: 'START_GOLFMON_POST_DELETE',
                isAdmin: (typeof isCurrentUserAdmin === 'function') ? isCurrentUserAdmin() : false,
                targetPost: {
                    golf: parsed.courseName,
                    rawGolf: parsed.rawCourse,
                    date: parsed.date,
                    time: parsed.time,
                    roomType: selRoomType,
                    mode: actionMode
                }
            };

            sendGolfmonMacroCommand(golfmonTab, payload, (res) => {
                if (res && res.success) {
                    resolve({ platform: 'golfmon', success: true, count: res.count || 1, message: '골프몬 글 처리 완료' });
                } else {
                    resolve({ platform: 'golfmon', success: false, message: (res && res.message) || '골프몬 글을 찾지 못했습니다.' });
                }
            });
        });
    });

    // Helper: Golftop MY 홍보 삭제 실행
    const runGolftop = () => new Promise((resolve) => {
        chrome.tabs.query({
            url: [
                "*://*.golftop.kr/*",
                "https://golftop.kr/*",
                "http://golftop.kr/*",
                "*://intra.golftop.kr/*",
                "https://intra.golftop.kr/*",
                "http://intra.golftop.kr/*"
            ]
        }, (tabs) => {
            if (!tabs || tabs.length === 0) {
                if (confirm("열려 있는 골프탑(intra.golftop.kr) 탭이 없습니다.\n골프탑 MY 홍보를 새 탭으로 여시겠습니까?")) {
                    chrome.tabs.create({ url: "https://intra.golftop.kr/Manage/Promotion" });
                }
                return resolve({ platform: 'golftop', success: false, message: '골프탑 탭을 찾을 수 없습니다.' });
            }

            const golftopTab = tabs[0];
            const currentTabUrl = golftopTab.url || '';
            const targetUrl = 'https://intra.golftop.kr/Manage/Promotion';

            const payload = {
                action: 'START_GOLFTOP_POST_DELETE',
                isAdmin: (typeof isCurrentUserAdmin === 'function') ? isCurrentUserAdmin() : false,
                targetPost: {
                    golf: (parsed.canonicalInfo && parsed.canonicalInfo.golftop) || parsed.courseName,
                    rawGolf: parsed.rawCourse,
                    date: parsed.date,
                    time: parsed.time,
                    mode: actionMode
                }
            };

            const sendGolftopMsg = () => {
                chrome.tabs.sendMessage(golftopTab.id, payload, (res) => {
                    if (chrome.runtime.lastError) {
                        console.warn("[Tee82] 골프탑 통신 에러, 재주입 시도:", chrome.runtime.lastError.message);
                        if (chrome.scripting && chrome.scripting.executeScript) {
                            chrome.scripting.executeScript({
                                target: { tabId: golftopTab.id },
                                files: ['golftop_interceptor.js', 'golftop_content.js']
                            }, () => {
                                void chrome.runtime.lastError;
                                setTimeout(() => {
                                    chrome.tabs.sendMessage(golftopTab.id, payload, (res2) => {
                                        if (chrome.runtime.lastError) {
                                            resolve({ platform: 'golftop', success: false, message: '골프탑 페이지 응답 없음' });
                                        } else {
                                            resolve({ platform: 'golftop', success: res2?.success !== false, count: res2?.count || 1, message: res2?.message || '골프탑 처리 완료' });
                                        }
                                    });
                                }, 300);
                            });
                        } else {
                            resolve({ platform: 'golftop', success: false, message: '골프탑 페이지 응답 없음' });
                        }
                    } else {
                        resolve({ platform: 'golftop', success: res?.success !== false, count: res?.count || 1, message: res?.message || '골프탑 처리 완료' });
                    }
                });
            };

            if (!currentTabUrl.includes('/Manage/Promotion')) {
                chrome.tabs.update(golftopTab.id, { url: targetUrl, active: true }, () => {
                    const onUpdated = (tabId, info) => {
                        if (tabId === golftopTab.id && info.status === 'complete') {
                            chrome.tabs.onUpdated.removeListener(onUpdated);
                            setTimeout(sendGolftopMsg, 600);
                        }
                    };
                    chrome.tabs.onUpdated.addListener(onUpdated);
                    setTimeout(() => {
                        try { chrome.tabs.onUpdated.removeListener(onUpdated); } catch(e) {}
                    }, 10000);
                });
            } else {
                chrome.tabs.update(golftopTab.id, { active: true }, () => {
                    sendGolftopMsg();
                });
            }
        });
    });

    // Helper: Golmarket 내가쓴글 삭제/마감 실행
    const runGolmarket = () => new Promise((resolve) => {
        let isSettled = false;
        let resultListener = null;
        let timeoutId = null;

        const cleanup = () => {
            if (resultListener) {
                chrome.runtime.onMessage.removeListener(resultListener);
                resultListener = null;
            }
            if (timeoutId) {
                clearTimeout(timeoutId);
                timeoutId = null;
            }
        };

        const settle = (result) => {
            if (isSettled) return;
            isSettled = true;
            cleanup();
            resolve(result);
        };

        resultListener = (msg, sender) => {
            if (msg && msg.type === 'GOLMARKET_POST_DELETE_RESULT') {
                console.log("[Tee82] 골마켓 마감/삭제 최종 결과 브로드캐스트 수신:", msg.result);
                settle(msg.result || { platform: 'golmarket', success: true, count: 1, message: '골마켓 처리 완료' });
            }
        };
        chrome.runtime.onMessage.addListener(resultListener);

        timeoutId = setTimeout(() => {
            settle({ platform: 'golmarket', success: false, message: '골마켓 작업 대기 시간 초과(35초)' });
        }, 35000);

        chrome.tabs.query({
            url: [
                "*://*.golmarket.co.kr/*",
                "https://golmarket.co.kr/*",
                "http://golmarket.co.kr/*",
                "https://www.golmarket.co.kr/*",
                "http://www.golmarket.co.kr/*"
            ]
        }, (tabs) => {
            if (!tabs || tabs.length === 0) {
                if (confirm("열려 있는 골마켓(golmarket.co.kr) 탭이 없습니다.\n골마켓 조인 게시판을 새 탭으로 여시겠습니까?")) {
                    chrome.tabs.create({ url: "https://www.golmarket.co.kr/join_list.php" });
                }
                return settle({ platform: 'golmarket', success: false, message: '골마켓 탭을 찾을 수 없습니다.' });
            }

            const golmarketTab = tabs[0];
            const currentTabUrl = golmarketTab.url || '';
            const targetUrl = 'https://www.golmarket.co.kr/join_list.php';

            const payload = {
                action: 'START_GOLMARKET_POST_DELETE',
                isAdmin: (typeof isCurrentUserAdmin === 'function') ? isCurrentUserAdmin() : false,
                targetPost: {
                    golf: (parsed.canonicalInfo && parsed.canonicalInfo.golmarket) || parsed.courseName,
                    rawGolf: parsed.rawCourse,
                    date: parsed.date,
                    time: parsed.time,
                    mode: actionMode
                }
            };

            const sendGolmarketMsg = () => {
                chrome.tabs.sendMessage(golmarketTab.id, payload, (res) => {
                    if (chrome.runtime.lastError) {
                        console.warn("[Tee82] 골마켓 통신 에러, 재주입 시도:", chrome.runtime.lastError.message);
                        if (chrome.scripting && chrome.scripting.executeScript) {
                            chrome.scripting.executeScript({
                                target: { tabId: golmarketTab.id },
                                files: ['golmarket_interceptor.js', 'golmarket_content.js']
                            }, () => {
                                void chrome.runtime.lastError;
                                setTimeout(() => {
                                    chrome.tabs.sendMessage(golmarketTab.id, payload, (res2) => {
                                        if (chrome.runtime.lastError) {
                                            settle({ platform: 'golmarket', success: false, message: '골마켓 페이지 응답 없음' });
                                        } else if (res2 && res2.pendingNavigation) {
                                            console.log("[Tee82] 골마켓 페이지 이동 중... 완료 브로드캐스트 대기");
                                            if (progressDesc) progressDesc.textContent = `[골마켓] '내가쓴글' 목록으로 이동하여 삭제 진행 중...`;
                                        } else {
                                            settle({ platform: 'golmarket', success: res2?.success !== false, count: res2?.count || 1, message: res2?.message || '골마켓 처리 완료' });
                                        }
                                    });
                                }, 300);
                            });
                        } else {
                            settle({ platform: 'golmarket', success: false, message: '골마켓 페이지 응답 없음' });
                        }
                    } else if (res && res.pendingNavigation) {
                        console.log("[Tee82] 골마켓 페이지 이동 중... 완료 브로드캐스트 대기");
                        if (progressDesc) progressDesc.textContent = `[골마켓] '내가쓴글' 목록으로 이동하여 삭제 진행 중...`;
                    } else {
                        settle({ platform: 'golmarket', success: res?.success !== false, count: res?.count || 1, message: res?.message || '골마켓 처리 완료' });
                    }
                });
            };

            if (!currentTabUrl.includes('join_list.php')) {
                chrome.tabs.update(golmarketTab.id, { url: targetUrl, active: true }, () => {
                    const onUpdated = (tabId, info) => {
                        if (tabId === golmarketTab.id && info.status === 'complete') {
                            chrome.tabs.onUpdated.removeListener(onUpdated);
                            setTimeout(sendGolmarketMsg, 600);
                        }
                    };
                    chrome.tabs.onUpdated.addListener(onUpdated);
                    setTimeout(() => {
                        try { chrome.tabs.onUpdated.removeListener(onUpdated); } catch(e) {}
                    }, 10000);
                });
            } else {
                chrome.tabs.update(golmarketTab.id, { active: true }, () => {
                    sendGolmarketMsg();
                });
            }
        });
    });

    const results = [];

    try {
        if (selectedPlatforms.includes('golfmon')) {
            if (progressDesc) progressDesc.textContent = `[골프몬] 글 ${actionLabel} 진행 중...`;
            const gmRes = await runGolfmon();
            results.push(gmRes);
        }

        if (selectedPlatforms.includes('golftop')) {
            if (progressDesc) progressDesc.textContent = `[골프탑] MY 홍보 글 ${actionLabel} 진행 중...`;
            const gtRes = await runGolftop();
            results.push(gtRes);
        }

        if (selectedPlatforms.includes('golmarket')) {
            if (progressDesc) progressDesc.textContent = `[골마켓] 내가쓴글 ${actionLabel} 진행 중...`;
            const gmkRes = await runGolmarket();
            results.push(gmkRes);
        }

        const otherPlatforms = selectedPlatforms.filter(p => p !== 'golfmon' && p !== 'golftop' && p !== 'golmarket');
        if (otherPlatforms.length > 0) {
            results.push({
                platform: otherPlatforms.join(', '),
                success: false,
                message: `${otherPlatforms.map(p => p.toUpperCase()).join(', ')}는 순차 업데이트 예정입니다.`
            });
        }
    } finally {
        if (btnExecute) btnExecute.disabled = false;
    }

    const getPlatformDisplayName = (p) => {
        if (p === 'golfmon') return '골프몬';
        if (p === 'golftop') return '골프탑';
        if (p === 'golmarket') return '골마켓';
        if (p === 'golfpang') return '골팡';
        if (p === 'golfland') return '골프랜드';
        if (p === 'golfrock') return '골프락';
        return p;
    };

    // 결과 취합 및 UI 갱신
    const successes = results.filter(r => r.success);
    const failures = results.filter(r => !r.success);

    if (successes.length > 0 && failures.length === 0) {
        if (progressBox) {
            progressBox.style.background = '#DCFCE7';
            progressBox.style.borderColor = '#86EFAC';
        }
        const summaryText = successes.map(s => {
            const name = getPlatformDisplayName(s.platform);
            const countStr = (s.count && s.count > 1) ? ` ${s.count}건` : '';
            return `[${name}]${countStr}`;
        }).join(', ');

        if (progressTitle) {
            progressTitle.innerHTML = `${summaryText} 글이 성공적으로 ${actionLabel}되었습니다!`;
        }
        if (progressDesc) {
            progressDesc.textContent = `${parsed.courseName} | ${parsed.dateDisplay || parsed.date} | ${parsed.time}`;
        }
        showToast(`[${parsed.courseName} ${parsed.time}] ${summaryText} 글이 성공적으로 ${actionLabel}되었습니다.`);

        // 완료 후 2.5초 뒤 입력창 초기화
        setTimeout(() => {
            if (txtArea) txtArea.value = '';
            updateSoldOutModalParsedUI(null);
        }, 2500);
    } else if (successes.length > 0 && failures.length > 0) {
        if (progressBox) {
            progressBox.style.background = '#FEF9C3';
            progressBox.style.borderColor = '#FDE047';
        }
        const succStr = successes.map(s => getPlatformDisplayName(s.platform)).join(', ');
        const failMsgs = failures.map(f => `${getPlatformDisplayName(f.platform)}: ${f.message}`).join(' / ');
        if (progressTitle) {
            progressTitle.innerHTML = `일부 플랫폼 ${actionLabel} 완료 (${succStr} 성공)`;
        }
        if (progressDesc) {
            progressDesc.textContent = `실패: ${failMsgs}`;
        }
        showToast(`${succStr} 성공, 실패: ${failMsgs}`);
    } else {
        if (progressBox) {
            progressBox.style.background = '#FEF2F2';
            progressBox.style.borderColor = '#FECACA';
        }
        const failMsgs = failures.map(f => `${getPlatformDisplayName(f.platform)}: ${f.message}`).join(' / ');
        if (progressTitle) {
            progressTitle.innerHTML = `글 ${actionLabel} 실패`;
        }
        if (progressDesc) {
            progressDesc.textContent = failMsgs || '글을 찾지 못했거나 처리 중 오류가 발생했습니다.';
        }
        showToast(`${failMsgs || '글 마감/삭제 실패'}`);
    }
}

// ============================================================================
// ★ [사용자 요청] 티타임 개별 수정 (가격·인원) 모달 로직
// ============================================================================
let currentEditingTr = null;

function openEditItemModal(tr, focusField = 'fee') {
    if (!tr) return;
    currentEditingTr = tr;

    const cells = tr.querySelectorAll('td');
    const date = cells[0]?.textContent?.trim() || tr.dataset.date || '';
    const golf = cells[2]?.textContent?.trim() || tr.dataset.rawGolf || tr.dataset.golf || '';
    const time = cells[3]?.textContent?.trim() || tr.dataset.time || '';
    const totalFee = tr.dataset.totalFee || tr.dataset.baseFee || cells[4]?.textContent?.replace(/[^\d.]/g, '') || '';
    const fieldFee = tr.dataset.fieldFee || '';
    const prepaidFee = tr.dataset.prepaidFee || '';
    const sizenum = (cells[7]?.textContent?.trim() || tr.dataset.sizenum || '4인').replace(/\s+/g, '');
    const waitGender = tr.dataset.waitGender || (tr.dataset.waitPax === '0' || !tr.dataset.waitPax ? '인원없음' : (cells[6]?.textContent?.trim() || ''));
    const roomType = tr.dataset.roomType || (cells[4]?.textContent?.includes('양도') ? '양도' : '조인');
    const isSeonti = (tr.dataset.manualSeonti === 'true' || tr.dataset.isSeontiOrDaegi === 'true' || roomType === '선티방' || roomType.includes('선티'));

    // 타이틀 설정
    const titleEl = document.getElementById('editItemModalTitle');
    const subTitleEl = document.getElementById('editItemModalSubTitle');
    if (titleEl) titleEl.textContent = `[${golf}] ${time} 정보 수정`;
    if (subTitleEl) subTitleEl.textContent = `날짜: ${date} | 현재 구분: ${roomType}`;

    // 1. 가격 세팅
    const totalFeeInput = document.getElementById('editItemTotalFee');
    const fieldFeeInput = document.getElementById('editItemFieldFee');
    const prepaidFeeInput = document.getElementById('editItemPrepaidFee');
    const splitBox = document.getElementById('editItemFeeSplitBox');

    if (totalFeeInput) totalFeeInput.value = totalFee;
    if (fieldFeeInput) fieldFeeInput.value = fieldFee;
    if (prepaidFeeInput) prepaidFeeInput.value = prepaidFee;

    if (fieldFee && prepaidFee && splitBox) {
        splitBox.style.display = 'block';
    } else if (splitBox) {
        splitBox.style.display = 'none';
    }

    // 2. 인원수 버튼 세팅 (1인, 2인, 3인, 4인)
    const paxButtons = document.querySelectorAll('#editItemPaxGroup .btn-pax-choice');
    paxButtons.forEach(btn => {
        const p = btn.dataset.pax;
        if (p === sizenum || (sizenum.startsWith(p.replace('인', '')))) {
            btn.classList.add('active');
        } else {
            btn.classList.remove('active');
        }
    });

    // 3. 대기 구성 / 성별 세팅
    const genderButtons = document.querySelectorAll('#editItemGenderGroup .btn-gender-choice');
    const waitGenderInput = document.getElementById('editItemWaitGenderText');
    genderButtons.forEach(btn => {
        const g = btn.dataset.gender;
        if (g === waitGender || (g === '인원없음' && (!waitGender || waitGender === '대기없음' || waitGender === '인원없음'))) {
            btn.classList.add('active');
        } else {
            btn.classList.remove('active');
        }
    });
    if (waitGenderInput) {
        waitGenderInput.value = (waitGender && waitGender !== '인원없음' && waitGender !== '대기없음') ? waitGender : '';
    }

    // 4. 구분 (조인 / 양도) 세팅
    const roomButtons = document.querySelectorAll('#editItemRoomTypeGroup .btn-room-choice');
    roomButtons.forEach(btn => {
        if (btn.dataset.room === roomType) {
            btn.classList.add('active');
        } else {
            btn.classList.remove('active');
        }
    });

    // 5. 선티방 체크박스 세팅
    const chkSeonti = document.getElementById('editItemChkSeonti');
    if (chkSeonti) chkSeonti.checked = isSeonti;

    // 모달 노출
    const modal = document.getElementById('editItemModal');
    if (modal) {
        modal.style.display = 'flex';
        setTimeout(() => {
            if (focusField === 'pax') {
                const activePaxBtn = document.querySelector('#editItemPaxGroup .btn-pax-choice.active') || document.querySelector('#editItemPaxGroup .btn-pax-choice');
                activePaxBtn?.focus();
            } else {
                totalFeeInput?.focus();
                totalFeeInput?.select();
            }
        }, 50);
    }
}

function closeEditItemModal() {
    const modal = document.getElementById('editItemModal');
    if (modal) modal.style.display = 'none';
    currentEditingTr = null;
}

function saveEditItemModal() {
    if (!currentEditingTr) {
        closeEditItemModal();
        return;
    }
    const tr = currentEditingTr;
    const cells = tr.querySelectorAll('td');

    const totalFeeInput = document.getElementById('editItemTotalFee');
    const fieldFeeInput = document.getElementById('editItemFieldFee');
    const prepaidFeeInput = document.getElementById('editItemPrepaidFee');
    const waitGenderInput = document.getElementById('editItemWaitGenderText');
    const chkSeonti = document.getElementById('editItemChkSeonti');

    // 선택된 인원
    const activePaxBtn = document.querySelector('#editItemPaxGroup .btn-pax-choice.active');
    const selectedPax = activePaxBtn ? activePaxBtn.dataset.pax : (cells[7]?.textContent?.trim() || '4인');

    // 선택된 대기 조건
    let selectedGender = waitGenderInput ? waitGenderInput.value.trim() : '';
    if (!selectedGender) {
        const activeGenderBtn = document.querySelector('#editItemGenderGroup .btn-gender-choice.active');
        selectedGender = activeGenderBtn ? activeGenderBtn.dataset.gender : '인원없음';
    }

    // 선택된 구분 (조인 / 양도)
    const activeRoomBtn = document.querySelector('#editItemRoomTypeGroup .btn-room-choice.active');
    const selectedRoom = activeRoomBtn ? activeRoomBtn.dataset.room : (selectedPax === '4인' ? '양도' : '조인');

    // 새 가격
    const rawVal = totalFeeInput ? totalFeeInput.value.trim() : '';
    const newFee = parseFloat(rawVal) || 0;
    const oldFee = parseFloat(tr.dataset.totalFee || tr.dataset.baseFee || cells[4]?.textContent?.replace(/[^\d.]/g, '')) || 0;

    if (newFee > 0) {
        tr.dataset.totalFee = newFee.toString();
        tr.dataset.baseFee = newFee.toString();
        
        // 현장/선입 분리 필드가 채워져 있는 경우
        if (fieldFeeInput && fieldFeeInput.value.trim()) {
            tr.dataset.fieldFee = fieldFeeInput.value.trim();
        }
        if (prepaidFeeInput && prepaidFeeInput.value.trim()) {
            tr.dataset.prepaidFee = prepaidFeeInput.value.trim();
        }

        // 가격 인하 감지
        if (oldFee > 0 && oldFee > newFee) {
            const diff = Math.round((newFee - oldFee) * 10) / 10;
            tr.dataset.isPriceDropped = 'true';
            tr.dataset.prevFee = oldFee.toString();
            tr.dataset.priceDiff = diff.toString();
        } else if (oldFee === newFee && tr.dataset.isPriceDropped === 'true') {
            // 기존 인하 배지 유지
        } else {
            delete tr.dataset.isPriceDropped;
            delete tr.dataset.prevFee;
            delete tr.dataset.priceDiff;
        }

        if (tr.dataset.fieldFee && tr.dataset.prepaidFee) {
            cells[4].textContent = `현장 ${tr.dataset.fieldFee}만/선입 ${tr.dataset.prepaidFee}만`;
        } else {
            cells[4].textContent = `${newFee}만`;
        }
    }

    // 인원(sizenum) 업데이트
    if (selectedPax) {
        tr.dataset.sizenum = selectedPax;
        if (cells[7]) cells[7].textContent = selectedPax;
    }

    // 대기 구성 / 성별 업데이트
    tr.dataset.waitGender = selectedGender;
    const numericPax = selectedPax.replace(/[^\d]/g, '');
    tr.dataset.waitPax = (selectedGender === '인원없음' || selectedGender === '대기없음') ? '0' : (numericPax || '2');
    if (cells[6] && selectedGender && selectedGender !== '인원없음') {
        cells[6].textContent = selectedGender;
    }

    // 구분 및 선티방 업데이트
    tr.dataset.roomType = selectedRoom;
    if (chkSeonti) {
        tr.dataset.manualSeonti = chkSeonti.checked ? 'true' : 'false';
        if (chkSeonti.checked) {
            tr.dataset.isSeontiOrDaegi = 'true';
        }
    }

    // 상태 저장 및 카드 뷰 즉각 갱신
    renderCardList(false);
    saveCurrentTableState();

    const golfName = cells[2]?.textContent?.trim() || tr.dataset.rawGolf || '';
    const timeVal = cells[3]?.textContent?.trim() || tr.dataset.time || '';
    showToast(`[${golfName} ${timeVal}] 가격(${newFee}만) / 인원(${selectedPax}) 변경 완료`);

    closeEditItemModal();
}

function initEditItemModal() {
    // 닫기 버튼들
    document.getElementById('btnCloseEditItemModalX')?.addEventListener('click', closeEditItemModal);
    document.getElementById('btnCancelEditItemModal')?.addEventListener('click', closeEditItemModal);

    // 모달 배경 클릭 시 닫기
    document.getElementById('editItemModal')?.addEventListener('click', (e) => {
        if (e.target.id === 'editItemModal') closeEditItemModal();
    });

    // 저장 버튼
    document.getElementById('btnSaveEditItemModal')?.addEventListener('click', (e) => {
        e.preventDefault();
        saveEditItemModal();
    });

    // 빠른 가격 조정 버튼 (+1만, -1만, +0.5만, -0.5만)
    document.querySelectorAll('.btn-quick-adjust').forEach(btn => {
        btn.addEventListener('click', () => {
            const adj = parseFloat(btn.dataset.adj) || 0;
            const feeInput = document.getElementById('editItemTotalFee');
            if (feeInput) {
                let cur = parseFloat(feeInput.value) || 0;
                cur = Math.max(0, Math.round((cur + adj) * 10) / 10);
                feeInput.value = cur;
                
                // 현장/선입이 있는 경우 현장가도 동일하게 조정
                const fieldInput = document.getElementById('editItemFieldFee');
                if (fieldInput && fieldInput.value.trim()) {
                    let curField = parseFloat(fieldInput.value) || 0;
                    curField = Math.max(0, Math.round((curField + adj) * 10) / 10);
                    fieldInput.value = curField;
                }
            }
        });
    });

    // 인원수 선택 버튼 (1인, 2인, 3인, 4인)
    document.querySelectorAll('#editItemPaxGroup .btn-pax-choice').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('#editItemPaxGroup .btn-pax-choice').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            
            // 4인 선택 시 구분도 양도로 유도하거나 대기없음 선택
            const pax = btn.dataset.pax;
            if (pax === '4인') {
                const waitText = document.getElementById('editItemWaitGenderText');
                if (waitText && (!waitText.value || waitText.value === '남' || waitText.value === '남남')) {
                    document.querySelectorAll('#editItemGenderGroup .btn-gender-choice').forEach(b => {
                        b.classList.toggle('active', b.dataset.gender === '인원없음');
                    });
                    waitText.value = '';
                }
            }
        });
    });

    // 대기 성별 버튼
    document.querySelectorAll('#editItemGenderGroup .btn-gender-choice').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('#editItemGenderGroup .btn-gender-choice').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const g = btn.dataset.gender;
            const waitText = document.getElementById('editItemWaitGenderText');
            if (waitText) {
                waitText.value = (g === '인원없음') ? '' : g;
            }
        });
    });

    // 대기 직접입력창 입력 시 성별 버튼 active 동기화
    document.getElementById('editItemWaitGenderText')?.addEventListener('input', (e) => {
        const val = e.target.value.trim();
        document.querySelectorAll('#editItemGenderGroup .btn-gender-choice').forEach(btn => {
            btn.classList.toggle('active', btn.dataset.gender === val);
        });
    });

    // 구분 버튼 (조인 / 양도)
    document.querySelectorAll('#editItemRoomTypeGroup .btn-room-choice').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('#editItemRoomTypeGroup .btn-room-choice').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        });
    });

    // 키보드 단축키 (모달 내부에서 Enter 치면 저장, ESC 치면 닫기)
    document.getElementById('editItemModal')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
            e.preventDefault();
            saveEditItemModal();
        } else if (e.key === 'Escape') {
            e.preventDefault();
            closeEditItemModal();
        }
    });
}

// 모달 이벤트 리스너 등록
function initSoldOutTextModal() {
    // 1. 헤더 및 정렬바 오픈 버튼
    document.getElementById('btnNavSoldOutText')?.addEventListener('click', (e) => {
        e.preventDefault();
        openSoldOutTextModal();
    });

    document.getElementById('btnOpenSoldOutTextModal')?.addEventListener('click', (e) => {
        e.preventDefault();
        openSoldOutTextModal();
    });

    // 2. 닫기 버튼
    document.getElementById('btnCloseSoldOutTextModalX')?.addEventListener('click', closeSoldOutTextModal);
    document.getElementById('btnCancelSoldOutModal')?.addEventListener('click', closeSoldOutTextModal);

    // 3. 클립보드 붙여넣기 버튼
    document.getElementById('btnPasteSoldOutClipboard')?.addEventListener('click', async () => {
        try {
            const clipText = await navigator.clipboard.readText();
            if (clipText) {
                const txtArea = document.getElementById('txtSoldOutRaw');
                if (txtArea) {
                    txtArea.value = clipText;
                    const parsed = parseSoldOutBookingText(clipText);
                    updateSoldOutModalParsedUI(parsed);
                }
            } else {
                showToast('클립보드가 비어있습니다.');
            }
        } catch(err) {
            showToast('클립보드 접근 권한이 없습니다. 텍스트창에 직접 붙여넣어주세요.');
        }
    });

    // 4. 문자 텍스트 입력창 실시간 분석
    const txtArea = document.getElementById('txtSoldOutRaw');
    if (txtArea) {
        ['input', 'change', 'paste', 'keyup'].forEach(ev => {
            txtArea.addEventListener(ev, () => {
                setTimeout(() => {
                    const parsed = parseSoldOutBookingText(txtArea.value);
                    updateSoldOutModalParsedUI(parsed);
                }, 10);
            });
        });
    }

    // 5. 플랫폼 체크박스 토글
    const pfCheckboxes = [
        'chkPfGolfmon', 'chkPfGolfpang', 'chkPfGolmarket',
        'chkPfGolftop', 'chkPfGolfland', 'chkPfGolfrock'
    ];
    pfCheckboxes.forEach(id => {
        const chk = document.getElementById(id);
        if (chk) {
            chk.addEventListener('change', function() {
                this.closest('label')?.classList.toggle('active', this.checked);
            });
        }
    });

    document.getElementById('btnSoldOutSelectAllPlatforms')?.addEventListener('click', () => {
        pfCheckboxes.forEach(id => {
            const chk = document.getElementById(id);
            if (chk) {
                chk.checked = true;
                chk.closest('label')?.classList.add('active');
            }
        });
    });

    document.getElementById('btnSoldOutClearPlatforms')?.addEventListener('click', () => {
        pfCheckboxes.forEach(id => {
            const chk = document.getElementById(id);
            if (chk) {
                chk.checked = false;
                chk.closest('label')?.classList.remove('active');
            }
        });
    });

    // 5-2. 구분 셀렉트 변경 시 lastParsedSoldOutData 동기화
    document.getElementById('selSoldOutRoomType')?.addEventListener('change', (e) => {
        if (lastParsedSoldOutData) {
            lastParsedSoldOutData.roomType = e.target.value;
        }
    });

    // 6. 실행 버튼
    document.getElementById('btnExecuteSoldOut')?.addEventListener('click', (e) => {
        e.preventDefault();
        executeSoldOutPostDeletion();
    });

    // 7. 메인 텍스트 입력창(inputText)에서 예약/조인 문자 감지 시 스마트 배너 노출
    const mainInput = document.getElementById('inputText');
    const detectBanner = document.getElementById('soldOutSmartDetectBanner');
    const detectPreview = document.getElementById('soldOutDetectPreview');
    const btnFromDetect = document.getElementById('btnOpenSoldOutFromDetect');

    if (mainInput && detectBanner) {
        mainInput.addEventListener('input', () => {
            const val = mainInput.value;
            // 예약/조인 알림 문자 패턴 감지
            if (val && /골프몬|옥스필드|신청자|요청자명|무관\s*\d명|조인\s*희망|문자\s*발송/s.test(val) &&
                /(?:일정|일자|날짜)\s*:/s.test(val) && /(?:티업|시간)\s*:/s.test(val)) {
                const parsed = parseSoldOutBookingText(val);
                if (parsed && parsed.isValid) {
                    detectBanner.style.display = 'flex';
                    if (detectPreview) {
                        detectPreview.textContent = `[${parsed.courseName} ${parsed.dateDisplay || parsed.date} ${parsed.time}]`;
                    }
                    return;
                }
            }
            detectBanner.style.display = 'none';
        });

        btnFromDetect?.addEventListener('click', (e) => {
            e.preventDefault();
            const textToPass = mainInput.value;
            detectBanner.style.display = 'none';
            openSoldOutTextModal(textToPass);
        });
    }
}

// 창 어디서든 마우스를 떼면 드래그 종료 및 상태 저장
window.addEventListener('mouseup', () => {
    if (isCardDragging) {
        isCardDragging = false;
        lastHoveredIndex = null;
        updateSelectedBadge();
        saveCurrentTableState();
    }
});

// 특정 타임 선티방 강제 지정 / 해제 함수 (개별 토글)
function toggleSeontiStatus(tr, targetState) {
    if (!tr) return;
    const golfName = tr.cells[2]?.textContent.trim() || '';
    const timeStr = tr.cells[3]?.textContent.trim() || '';

    if (targetState) {
        if (!tr.dataset.origRoomType) {
            tr.dataset.origRoomType = tr.dataset.roomType || '미표시';
        }
        const isTransferRow = (tr.dataset.roomType === '양도' || tr.dataset.origRoomType === '양도');
        tr.dataset.isSeontiOrDaegi = 'true';
        tr.dataset.roomType = isTransferRow ? '양도' : '선티방';
        tr.dataset.manualSeonti = 'true';
        if (!isTransferRow && (!tr.dataset.waitGender || tr.dataset.waitGender === '인원없음')) {
            tr.dataset.waitGender = '남';
            tr.dataset.waitPax = '1';
        }
        showToast(`[${golfName} ${timeStr}] 선티방으로 지정되었습니다. (확정금액 적용)`);
    } else {
        const isTransferRow = (tr.dataset.roomType === '양도' || tr.dataset.origRoomType === '양도');
        tr.dataset.isSeontiOrDaegi = 'false';
        tr.dataset.isConfirmed = 'false';
        tr.dataset.isDaegi = 'false';
        tr.dataset.roomType = isTransferRow ? '양도' : (tr.dataset.origRoomType === '선티방' ? '조인' : (tr.dataset.origRoomType || '미표시'));
        delete tr.dataset.manualSeonti;
        tr.dataset.waitGender = '인원없음';
        tr.dataset.waitPax = '0';
        showToast(`↩️ [${golfName} ${timeStr}] 일반 타임으로 복구되었습니다.`);
    }

    applyAllActiveNoticeRules();
    updateSelectedBadge();
}

// 선티방 일괄 지정 / 해제 함수 (툴바 체크박스: 전체선택/전체해제, 빠른메뉴: 선택항목 우선)
function handleBatchToggleSeonti(forAll = true) {
    const trs = Array.from(document.querySelectorAll('#dataTable tbody tr'));
    if (trs.length === 0) {
        showToast('변환된 티타임이 없습니다.');
        return;
    }

    const selectedTrs = Array.from(document.querySelectorAll('#dataTable tbody tr.selected'));
    // forAll이 true이거나 선택된 항목이 없으면 전체 항목 대상, 그 외에는 선택된 항목 대상
    const targetPool = (!forAll && selectedTrs.length > 0) ? selectedTrs : trs;

    // 대상 항목 중 하나라도 선티가 아니면 -> 모두 선티로 지정 (전체선택)
    // 대상 항목이 이미 모두 선티라면 -> 모두 일반 타임으로 복구 (전체해제)
    const hasNonSeonti = targetPool.some(tr => (
        tr.dataset.isSeontiOrDaegi !== 'true' &&
        !(tr.dataset.roomType || '').includes('선티') &&
        tr.dataset.manualSeonti !== 'true'
    ));

    const targetState = hasNonSeonti;

    targetPool.forEach(tr => {
        const isTransferRow = (tr.dataset.roomType === '양도' || tr.dataset.origRoomType === '양도');
        if (targetState) {
            if (!tr.dataset.origRoomType) {
                tr.dataset.origRoomType = tr.dataset.roomType || '미표시';
            }
            tr.dataset.isSeontiOrDaegi = 'true';
            tr.dataset.roomType = isTransferRow ? '양도' : '선티방';
            tr.dataset.manualSeonti = 'true';
            if (!isTransferRow && (!tr.dataset.waitGender || tr.dataset.waitGender === '인원없음')) {
                tr.dataset.waitGender = '남';
                tr.dataset.waitPax = '1';
            }
        } else {
            tr.dataset.isSeontiOrDaegi = 'false';
            tr.dataset.isConfirmed = 'false';
            tr.dataset.isDaegi = 'false';
            tr.dataset.roomType = isTransferRow ? '양도' : (tr.dataset.origRoomType === '선티방' ? '조인' : (tr.dataset.origRoomType || '미표시'));
            delete tr.dataset.manualSeonti;
            tr.dataset.waitGender = '인원없음';
            tr.dataset.waitPax = '0';
        }
    });

    applyAllActiveNoticeRules();
    updateSelectedBadge();

    if (targetPool === trs) {
        if (targetState) {
            showToast(`총 ${trs.length}건 전체 선티방으로 지정되었습니다. (확정금액 적용)`);
        } else {
            showToast('↩️ 전체 선티 지정이 해제되었습니다.');
        }
    } else {
        if (targetState) {
            showToast(`선택된 ${selectedTrs.length}건이 선티방으로 지정되었습니다. (확정금액 적용)`);
        } else {
            showToast(`↩️ 선택된 ${selectedTrs.length}건이 일반 타임으로 복구되었습니다.`);
        }
    }
}

// 테이블 행에서 그린피 금액 추출 헬퍼 (숫자 파싱)
function getTrFee(tr) {
    if (!tr) return 9999;
    if (tr.dataset.totalFee) {
        const val = parseFloat(tr.dataset.totalFee);
        if (!isNaN(val)) return val;
    }
    const text = tr.cells[4]?.textContent.trim() || '';
    const sumMatch = text.match(/\(합\s*([\d.]+)\)/);
    if (sumMatch) {
        const val = parseFloat(sumMatch[1]);
        if (!isNaN(val)) return val;
    }
    const match = text.match(/(\d+(?:\.\d+)?)/);
    if (match) {
        const val = parseFloat(match[1]);
        if (!isNaN(val)) return val;
    }
    if (tr.dataset.baseFee) {
        const val = parseFloat(tr.dataset.baseFee);
        if (!isNaN(val)) return val;
    }
    return 9999;
}

// 테이블 행에서 시간(분 단위 정수) 추출 헬퍼 (HH:MM 또는 0746 등 4자리/3자리 숫자 형식 모두 지원)
function getTrMinutes(tr) {
    if (!tr) return 0;
    const timeStr = tr.cells[3]?.textContent.trim() || '';
    return timeToMinutes(timeStr);
}

// 행이 조인 인원이 이미 존재하는 타임인지 판별 (대기방, 선티방, 또는 1~3인 대기)
function hasJoinedPax(tr) {
    if (!tr) return false;
    const roomType = tr.dataset.roomType || '';
    if (roomType === '대기방' || roomType === '선티방') return true;
    if (tr.dataset.isSeontiOrDaegi === 'true') return true;
    const size = tr.cells[7]?.textContent.trim() || '';
    if (/^[123]인$/.test(size)) return true;
    return false;
}

// 행이 속한 부제 판별 (1부: < 11:00, 2부: 11:00 ~ 15:59, 3부: >= 16:00)
function getTrPart(tr) {
    const mins = getTrMinutes(tr);
    if (mins < 660) return 1;
    if (mins < 960) return 2;
    return 3;
}

// 특정 부제 목록에서 최적의 1개 타임 선정
// 규칙:
// 🎲 회원별 고유 분산 선택 + 기존 타임 유지(Sticky) 활성화 여부 확인:
// - 관리자(isCurrentUserAdmin): 랜덤 분산 하지 않고 기존대로(결정론적 기준시간/최저가 순) 고정 선택!
// - 일반 회원: 회원(계정/PC) 고유 시드 기반으로 회원마다 서로 다른 타임이 분산 선택되면서도,
//   동일 회원이 새 목록을 다시 변환할 때는 이전에 선택/등록한 타임이 그대로 유지되어 스마트수정 시 불필요한 재수정을 100% 방지!
function isRandomSelectEnabled() {
    if (typeof isCurrentUserAdmin === 'function' && isCurrentUserAdmin()) {
        return false; // 관리자는 기존대로 고정 선택
    }
    return true; // 일반 회원은 회원별 고유 시드 분산 + 기등록 타임 유지
}

function getUserDispersionSeed() {
    try {
        if (typeof currentAuthUser === 'object' && currentAuthUser && currentAuthUser.id) {
            return String(currentAuthUser.id);
        }
        const savedUser = localStorage.getItem('v2_auth_user');
        if (savedUser) {
            const parsed = JSON.parse(savedUser);
            if (parsed && parsed.id) return String(parsed.id);
        }
        const mobId = localStorage.getItem('v2_device_id_mob');
        if (mobId) return mobId;
        let seed = localStorage.getItem('v2_userDispersionSeed');
        if (!seed) {
            seed = 'USR_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 10);
            localStorage.setItem('v2_userDispersionSeed', seed);
        }
        return seed;
    } catch (e) {
        return 'DEFAULT_USER_SEED';
    }
}

function computeDeterministicHash(str) {
    let h = 2166136261 >>> 0;
    for (let i = 0; i < str.length; i++) {
        h ^= str.charCodeAt(i);
        h = Math.imul(h, 16777619);
    }
    h ^= h >>> 16;
    h = Math.imul(h, 2246822507);
    h ^= h >>> 13;
    h = Math.imul(h, 3266489909);
    h ^= h >>> 16;
    return h >>> 0;
}

function getStickyCourseMap() {
    try {
        const raw = localStorage.getItem('v2_stickyCourseTimes');
        return raw ? JSON.parse(raw) : {};
    } catch (e) {
        return {};
    }
}

function saveStickyCourseMap(map) {
    try {
        localStorage.setItem('v2_stickyCourseTimes', JSON.stringify(map));
    } catch (e) {}
}

function makeStickyGroupKeyFromTr(tr) {
    if (!tr) return '';
    const date = (tr.cells[0]?.textContent || '').replace(/[^\d]/g, '');
    const golf = (tr.cells[2]?.textContent || '').replace(/\s+/g, '').replace(/cc|gc|골프장|골프클럽/gi, '').trim().toLowerCase();
    const isTransfer = (tr.dataset.roomType === '양도' || (tr.cells[4]?.textContent || '').includes('양도'));
    const typeCategory = isTransfer ? '양도' : '조인';
    return `${date}_${golf}_${typeCategory}`;
}

function isPreviouslyRegisteredTr(tr) {
    if (!tr || typeof makeHistoryKey !== 'function') return false;
    const dateStr = tr.cells[0]?.textContent || '';
    const timeStr = tr.cells[1]?.textContent || '';
    const golfStr = tr.cells[2]?.textContent || '';
    const rawGolfStr = tr.dataset.rawGolf || golfStr;
    const k1 = makeHistoryKey(dateStr, golfStr, timeStr);
    const k2 = makeHistoryKey(dateStr, rawGolfStr, timeStr);
    return Boolean((k1 && typeof registeredHistory === 'object' && registeredHistory[k1]) ||
                   (k2 && typeof registeredHistory === 'object' && registeredHistory[k2]));
}

function isStickySelectedTr(tr) {
    if (!tr) return false;
    const gKey = makeStickyGroupKeyFromTr(tr);
    const timeDigits = (tr.cells[1]?.textContent || '').replace(/[^\d]/g, '');
    if (!gKey || !timeDigits) return false;
    const map = getStickyCourseMap();
    const arr = map[gKey];
    return Array.isArray(arr) && arr.includes(timeDigits);
}

// 부제별 황금 기준시간(1부: 08:00, 2부: 11:00, 3부: 가장 빠른 타임) 근접 후보군(±25분 내 최대 4~5개) 추출 헬퍼
function getGoldenWindowCandidates(activePool, partNumber) {
    if (!activePool || activePool.length === 0) return [];
    if (activePool.length === 1) return activePool;

    // 부제별 기준 시간(targetMins) 계산
    let targetMins = 480; // 기본 8시
    if (partNumber === 1) {
        targetMins = 480; // 1부: 8시(08:00)
    } else if (partNumber === 2) {
        targetMins = 660; // 2부: 11시(11:00)
    } else if (partNumber === 3) {
        // 3부: 가장 빠른 타임
        targetMins = Math.min(...activePool.map(tr => getTrMinutes(tr)));
    }

    // 기준 시간에 가장 가까운 앵커 타임 선정 (거리 동일 시 그린피 저렴한 순, 이른 시간 순)
    const sortedByTarget = activePool.slice().sort((a, b) => {
        const distA = Math.abs(getTrMinutes(a) - targetMins);
        const distB = Math.abs(getTrMinutes(b) - targetMins);
        if (distA !== distB) return distA - distB;

        const feeA = getTrFee(a);
        const feeB = getTrFee(b);
        if (feeA !== feeB) return feeA - feeB;

        return getTrMinutes(a) - getTrMinutes(b);
    });

    const anchorTr = sortedByTarget[0];
    const anchorMins = getTrMinutes(anchorTr);
    const anchorFee = getTrFee(anchorTr);

    // 1차: 앵커 타임 기준 ±20분 또는 황금 기준시간(targetMins) 기준 ±25분 이내의 근접 타임들만 선별 (너무 먼 타임 원천 배제!)
    const nearby = sortedByTarget.filter(tr => {
        const mins = getTrMinutes(tr);
        return Math.abs(mins - anchorMins) <= 20 || Math.abs(mins - targetMins) <= 25;
    });

    if (nearby.length <= 1) {
        // 만약 ±20~25분 내에 타임이 1개뿐인데 바로 옆(앵커 기준 ±30분 이내, 가격 동일/유사)에 2번째 타임이 있다면 2개까지 허용
        if (sortedByTarget.length >= 2) {
            const secondTr = sortedByTarget[1];
            if (Math.abs(getTrMinutes(secondTr) - anchorMins) <= 30 && (getTrFee(secondTr) - anchorFee) <= 1.0) {
                return [anchorTr, secondTr];
            }
        }
        return [anchorTr];
    }

    // 근접 후보들 중 최저가 확인: 최저가 대비 1만원 이하 차이 나는 합리적인 타임들만 유지 (터무니없이 비싼 타임 제외)
    const minNearbyFee = Math.min(...nearby.map(tr => getTrFee(tr)));
    const goodPricePool = nearby.filter(tr => (getTrFee(tr) - minNearbyFee) <= 1.0);
    const finalWindow = goodPricePool.length > 0 ? goodPricePool : nearby;

    // 기준시간에 가장 가까운 상위 최대 4개까지만 후보로 제한하여, 회원 간 분산되면서도 항상 황금 시간대 기조를 유지!
    return finalWindow.slice(0, 4);
}

// 회원 고유 시드 분산 + 기존 등록/선택 타임 최우선 유지 선택기 (황금 기준시간 근접 범위 내에서만 분산!)
function pickUserConsistentOne(pool, salt = '', partNumber = null) {
    if (!pool || pool.length === 0) return null;
    if (pool.length === 1) return pool[0];

    // 0단계: 부제 번호를 기반으로 황금 기준시간(1부 08:00, 2부 11:00, 3부 첫타임) 근접 후보군 추출
    const effectivePart = partNumber || getTrPart(pool[0]) || 1;
    const goldenCandidates = getGoldenWindowCandidates(pool, effectivePart);

    // 1순위: 이미 등록/수정한 이력이 있는 타임 최우선 재선택 (스마트수정 0초 통과 보장)
    // 단, 황금 시간대 근처(앵커 기준 ±35분 이내)에 있는 기등록 타임 우선
    const regInGolden = goldenCandidates.filter(tr => isPreviouslyRegisteredTr(tr));
    if (regInGolden.length > 0) return regInGolden[0];
    const regMatches = pool.filter(tr => isPreviouslyRegisteredTr(tr));
    if (regMatches.length > 0) return regMatches[0];

    // 2순위: 직전 변환에서 선택되었던 타임 유지 (황금 후보군 내에 있을 때 유지)
    const stickyInGolden = goldenCandidates.filter(tr => isStickySelectedTr(tr));
    if (stickyInGolden.length > 0) return stickyInGolden[0];

    // 3순위: 황금 기준시간 근접 후보군(goldenCandidates, 최대 4개) 안에서만 회원(계정/PC) 고유 시드로 분산 선택!
    const candidatePool = goldenCandidates.length > 0 ? goldenCandidates : pool;
    if (candidatePool.length === 1) return candidatePool[0];

    const userSeed = getUserDispersionSeed();
    let bestTr = candidatePool[0];
    let bestScore = -1;

    for (const tr of candidatePool) {
        const date = (tr.cells[0]?.textContent || '').replace(/[^\d]/g, '');
        const time = (tr.cells[1]?.textContent || '').replace(/[^\d]/g, '');
        const golf = (tr.cells[2]?.textContent || '').replace(/\s+/g, '').toLowerCase();
        const roomType = (tr.dataset.roomType === '양도' ? '양도' : '조인');
        const keyStr = `${userSeed}|${date}|${golf}|${roomType}|${time}|${salt}`;
        const score = computeDeterministicHash(keyStr);
        if (score > bestScore) {
            bestScore = score;
            bestTr = tr;
        }
    }
    return bestTr;
}

// 사용자 맞춤 부제별 기준시간(분 단위) 획득
function getPartTargetMinutes(partNumber, activePool = null) {
    if (partNumber === 1) {
        const saved = localStorage.getItem('v2_targetTimePart1') || '08:00';
        return timeToMinutes(saved);
    } else if (partNumber === 2) {
        const saved = localStorage.getItem('v2_targetTimePart2') || '11:00';
        return timeToMinutes(saved);
    } else if (partNumber === 3) {
        const saved = localStorage.getItem('v2_targetTimePart3') || 'earliest';
        if (saved === 'earliest') {
            if (activePool && activePool.length > 0) {
                return Math.min(...activePool.map(tr => getTrMinutes(tr)));
            }
            return 17 * 60;
        }
        return timeToMinutes(saved);
    }
    return 480;
}

// 부제별 기준시간 및 20분 내 최저가 타임 결정론적 선별 알고리즘 (시드 분산 제거, 사용자 맞춤 기준시간 반영)
function pickDeterministicFromPart(activePool, partNumber) {
    if (!activePool || activePool.length === 0) return null;
    if (activePool.length === 1) return activePool[0];

    // 1순위: 이미 등록/수정한 이력이 있는 타임 최우선 재선택 (스마트수정 0초 통과 보장)
    const regMatches = activePool.filter(tr => isPreviouslyRegisteredTr(tr));
    if (regMatches.length > 0) return regMatches[0];

    // 2순위: 직전 변환에서 선택되었던 타임 유지
    const stickyMatches = activePool.filter(tr => isStickySelectedTr(tr));
    if (stickyMatches.length > 0) return stickyMatches[0];

    // 3순위: 사용자가 직접 지정한 부제별 기준 시간(targetMins) 기준 최적 타임 선별
    const targetMins = getPartTargetMinutes(partNumber, activePool);

    // 기준 시간에 가장 가까운 앵커 타임 선정 (거리 동일 시 그린피 저렴한 순, 이른 시간 순)
    const sortedByTarget = activePool.slice().sort((a, b) => {
        const distA = Math.abs(getTrMinutes(a) - targetMins);
        const distB = Math.abs(getTrMinutes(b) - targetMins);
        if (distA !== distB) return distA - distB;

        const feeA = getTrFee(a);
        const feeB = getTrFee(b);
        if (feeA !== feeB) return feeA - feeB;

        return getTrMinutes(a) - getTrMinutes(b);
    });
    const anchorTr = sortedByTarget[0];
    const anchorMins = getTrMinutes(anchorTr);
    const anchorFee = getTrFee(anchorTr);

    // 20분 차이 내(앵커 타임 기준 +-20분 또는 targetMins 기준 +-20분) 후보군 선별
    const nearbyCandidates = activePool.filter(tr => {
        const mins = getTrMinutes(tr);
        return Math.abs(mins - anchorMins) <= 20 || Math.abs(mins - targetMins) <= 20;
    });

    // 20분 차이 내에 더 저렴한 타임이 있는지 확인
    const cheaperCandidates = nearbyCandidates.filter(tr => getTrFee(tr) < anchorFee);
    if (cheaperCandidates.length > 0) {
        // 더 저렴한 타임 중 가장 저렴한 타임 선택 (금액 동일 시 targetMins에 가장 가까운 순)
        cheaperCandidates.sort((a, b) => {
            const feeA = getTrFee(a);
            const feeB = getTrFee(b);
            if (feeA !== feeB) return feeA - feeB;

            const distA = Math.abs(getTrMinutes(a) - targetMins);
            const distB = Math.abs(getTrMinutes(b) - targetMins);
            if (distA !== distB) return distA - distB;

            return getTrMinutes(a) - getTrMinutes(b);
        });
        return cheaperCandidates[0];
    }

    // 더 저렴한 타임이 없으면 anchorTr 선택
    return anchorTr;
}

// 1. 인원이 있는 타임(선티/대기/확정/1~3인 조인 대기)이 있으면 1순위로 최우선 선택
// 2. 일반 타임: 사용자가 지정한 부제별 기준시간 알고리즘으로 일관된 최적 타임 선택 (시드 분산 제거)
function pickBestOneFromPart(pool, partNumber) {
    if (!pool || pool.length === 0) return null;
    if (pool.length === 1) return pool[0];

    // 1. 인원 있는 타임 우선 풀 (선티방, 대기방, 확정, 1~3인 조인 대기)
    const paxPool = pool.filter(tr => (typeof isPriorityTagTr === 'function' && isPriorityTagTr(tr)) || hasJoinedPax(tr));
    if (paxPool.length > 0) {
        if (paxPool.length === 1) return paxPool[0];
        return pickDeterministicFromPart(paxPool, partNumber);
    }

    // 2. 일반 타임: 사용자 지정 부제별 기준시간에 따른 일관된 최적 타임 선택
    return pickDeterministicFromPart(pool, partNumber);
}

// 동일 부제 내에서 2개 타임을 선별할 때 (최소 15분 간격 유지 우선)
function pickTwoFromSamePart(partList, partNumber) {
    if (!partList || partList.length === 0) return [];
    if (partList.length <= 2) return partList;

    const first = pickBestOneFromPart(partList, partNumber);
    if (!first) return [];

    const remaining = partList.filter(tr => tr !== first);
    if (remaining.length === 0) return [first];

    const firstMins = getTrMinutes(first);
    const MIN_TIME_GAP = 15;

    // 15분 이상 떨어진 후보군 우선
    const spacedCandidates = remaining.filter(tr => Math.abs(getTrMinutes(tr) - firstMins) >= MIN_TIME_GAP);
    const secondPool = (spacedCandidates.length > 0) ? spacedCandidates : remaining;

    if (isRandomSelectEnabled() && secondPool.length > 1) {
        // 선티 타임이 남아있다면 선티 우선
        const secondPax = secondPool.filter(tr => (typeof isPriorityTagTr === 'function' && isPriorityTagTr(tr)) || hasJoinedPax(tr));
        const activeSecond = (secondPax.length > 0) ? secondPax : secondPool;
        const second = pickUserConsistentOne(activeSecond, 'second_' + partNumber, partNumber);
        return [first, second];
    }

    const second = pickBestOneFromPart(secondPool, partNumber);
    return second ? [first, second] : [first];
}

// 구장별 최적의 2개 타임 선별
// [사용자 지정 우선순위]
// 1순위: 1부에서 1개 + 2부에서 1개
// 2순위: 1부에서 1개 + 3부에서 1개
// 3순위: 2부에서 1개 + 3부에서 1개
// 4순위: 단일 부제만 존재하는 경우 해당 부제에서 2개 선택 (15분 이상 간격 확보)
function pickBestTwoTrs(list) {
    if (!list || list.length === 0) return [];
    if (list.length <= 2) return list;

    // 1부, 2부, 3부로 분리 (1부: < 11:00, 2부: 11:00~15:59, 3부: >= 16:00)
    const part1 = list.filter(tr => getTrPart(tr) === 1);
    const part2 = list.filter(tr => getTrPart(tr) === 2);
    const part3 = list.filter(tr => getTrPart(tr) === 3);

    // 1순위: 1부에서 1개 + 2부에서 1개
    if (part1.length > 0 && part2.length > 0) {
        const p1 = pickBestOneFromPart(part1, 1);
        const p2 = pickBestOneFromPart(part2, 2);
        if (p1 && p2) return [p1, p2];
    }

    // 2순위: 1부에서 1개 + 3부에서 1개
    if (part1.length > 0 && part3.length > 0) {
        const p1 = pickBestOneFromPart(part1, 1);
        const p3 = pickBestOneFromPart(part3, 3);
        if (p1 && p3) return [p1, p3];
    }

    // 3순위: 2부에서 1개 + 3부에서 1개
    if (part2.length > 0 && part3.length > 0) {
        const p2 = pickBestOneFromPart(part2, 2);
        const p3 = pickBestOneFromPart(part3, 3);
        if (p2 && p3) return [p2, p3];
    }

    // 4순위: 단일 부제만 존재하는 경우 해당 부제에서 2개 선택
    if (part1.length >= 2) return pickTwoFromSamePart(part1, 1);
    if (part2.length >= 2) return pickTwoFromSamePart(part2, 2);
    if (part3.length >= 2) return pickTwoFromSamePart(part3, 3);

    // 전체 중 남은 것에서 최대 2개 반환
    return list.slice(0, 2);
}

// ========================================================
// 2개 자동선택 시 플랫폼 우선순위 ('none', 'golftop', 'golfrock')
// ========================================================
let autoSelectPriority = 'none';

function initAutoSelectPriority() {
    try {
        const saved = localStorage.getItem('v2_autoSelectPriority');
        if (saved && (saved === 'none' || saved === 'golftop' || saved === 'golfrock')) {
            autoSelectPriority = saved;
        }
    } catch(e) {}
    updateAutoSelectPriorityUI();
}

function setAutoSelectPriority(priority, triggerReselect = true) {
    if (priority !== 'none' && priority !== 'golftop' && priority !== 'golfrock') {
        priority = 'none';
    }
    autoSelectPriority = priority;
    try {
        localStorage.setItem('v2_autoSelectPriority', priority);
    } catch(e) {}
    try {
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.set({ v2_autoSelectPriority: priority });
        }
    } catch(e) {}

    updateAutoSelectPriorityUI();

    if (triggerReselect) {
        const trs = document.querySelectorAll('#dataTable tbody tr');
        if (trs.length > 0) {
            autoSelectTwo();
            let msg = '기본 (시간/조건순) 자동선택이 적용되었습니다.';
            if (priority === 'golftop') msg = '골프탑 타임 우선으로 자동선택되었습니다.';
            else if (priority === 'golfrock') msg = '골프락 타임 우선으로 자동선택되었습니다.';
            showToast(msg);
        }
    }
}

function updateAutoSelectPriorityUI() {
    const selMain = document.getElementById('selAutoSelectPriority');
    const selSettings = document.getElementById('selAutoSelectPrioritySettings');

    if (selMain) {
        selMain.value = autoSelectPriority;
        selMain.classList.remove('priority-top', 'priority-rock');
        if (autoSelectPriority === 'golftop') selMain.classList.add('priority-top');
        else if (autoSelectPriority === 'golfrock') selMain.classList.add('priority-rock');
    }

    if (selSettings) {
        selSettings.value = autoSelectPriority;
    }
}

// 선호 플랫폼 보충 타임 선별 헬퍼 (first 타임과 다른 부제 우선, 동일 부제 시 15분 이상 간격 우선)
function pickComplementaryOneWithPriority(pool, first, priority = 'none') {
    if (!pool || pool.length === 0) return null;
    if (pool.length === 1) return pool[0];

    // 만약 플랫폼 우선순위가 설정되어 있다면 선호 플랫폼 풀을 우선 탐색
    let candidatePool = pool;
    if (priority === 'golftop' || priority === 'golfrock') {
        const preferred = pool.filter(tr => (tr.dataset.source || 'golfrock') === priority);
        if (preferred.length > 0) {
            candidatePool = preferred;
        }
    }

    const firstPart = getTrPart(first);
    const firstMins = getTrMinutes(first);

    let second = null;
    if (firstPart === 1) {
        const p2 = candidatePool.filter(tr => getTrPart(tr) === 2);
        const p3 = candidatePool.filter(tr => getTrPart(tr) === 3);
        if (p2.length > 0) second = pickBestOneFromPart(p2, 2);
        else if (p3.length > 0) second = pickBestOneFromPart(p3, 3);
    } else if (firstPart === 2) {
        const p1 = candidatePool.filter(tr => getTrPart(tr) === 1);
        const p3 = candidatePool.filter(tr => getTrPart(tr) === 3);
        if (p1.length > 0) second = pickBestOneFromPart(p1, 1);
        else if (p3.length > 0) second = pickBestOneFromPart(p3, 3);
    } else {
        const p1 = candidatePool.filter(tr => getTrPart(tr) === 1);
        const p2 = candidatePool.filter(tr => getTrPart(tr) === 2);
        if (p1.length > 0) second = pickBestOneFromPart(p1, 1);
        else if (p2.length > 0) second = pickBestOneFromPart(p2, 2);
    }

    // 만약 선호 풀에서 다른 부제를 못 찾았는데 전체 풀에 다른 부제가 있다면 전체 풀에서 보충
    if (!second && candidatePool !== pool) {
        if (firstPart === 1) {
            const p2 = pool.filter(tr => getTrPart(tr) === 2);
            const p3 = pool.filter(tr => getTrPart(tr) === 3);
            if (p2.length > 0) second = pickBestOneFromPart(p2, 2);
            else if (p3.length > 0) second = pickBestOneFromPart(p3, 3);
        } else if (firstPart === 2) {
            const p1 = pool.filter(tr => getTrPart(tr) === 1);
            const p3 = pool.filter(tr => getTrPart(tr) === 3);
            if (p1.length > 0) second = pickBestOneFromPart(p1, 1);
            else if (p3.length > 0) second = pickBestOneFromPart(p3, 3);
        } else {
            const p1 = pool.filter(tr => getTrPart(tr) === 1);
            const p2 = pool.filter(tr => getTrPart(tr) === 2);
            if (p1.length > 0) second = pickBestOneFromPart(p1, 1);
            else if (p2.length > 0) second = pickBestOneFromPart(p2, 2);
        }
    }

    // 동일 부제만 남아있는 경우 15분 이상 떨어진 타임 우선 선택
    if (!second) {
        const activePoolToUse = (candidatePool.length > 0) ? candidatePool : pool;
        const samePartPool = activePoolToUse.filter(tr => getTrPart(tr) === firstPart);
        const spacedPool = samePartPool.filter(tr => Math.abs(getTrMinutes(tr) - firstMins) >= 15);
        const finalPool = spacedPool.length > 0 ? spacedPool : (samePartPool.length > 0 ? samePartPool : activePoolToUse);
        second = pickBestOneFromPart(finalPool, firstPart);
    }

    return second;
}

// 특정 타임 풀 내에서 플랫폼 우선순위(골프탑/골프락)를 적용하여 2개 선별
function pickTwoFromPoolWithPlatformPriority(pool, priority = 'none') {
    if (!pool || pool.length === 0) return [];
    if (pool.length <= 2) return pool;

    if (priority === 'golftop' || priority === 'golfrock') {
        const preferred = pool.filter(tr => (tr.dataset.source || 'golfrock') === priority);
        const fallback = pool.filter(tr => (tr.dataset.source || 'golfrock') !== priority);

        // 1. 선호 플랫폼 타임이 2개 이상 있는 경우 -> 선호 플랫폼 내에서 최적 2개 선별
        if (preferred.length >= 2) {
            return pickBestTwoTrs(preferred);
        }

        // 2. 선호 플랫폼 타임이 1개 있는 경우 -> 선호 플랫폼 1개 확보 + 대체 플랫폼에서 1개 보충
        if (preferred.length === 1) {
            const first = preferred[0];
            const second = pickComplementaryOneWithPriority(fallback, first, 'none');
            return second ? [first, second] : [first];
        }

        // 3. 선호 플랫폼 타임이 0개인 경우 -> 대체 플랫폼에서 선별
        if (fallback.length > 0) {
            return pickBestTwoTrs(fallback);
        }
    }

    return pickBestTwoTrs(pool);
}

// ========================================================
// [대기] 및 [확정] 타임 판별 및 최우선 2개 선별 로직
// ========================================================

// [확정] 표시 타임 판별
function isConfirmedTr(tr) {
    if (!tr) return false;
    if (tr.dataset.isConfirmed === 'false') return false;
    if (tr.dataset.isConfirmed === 'true') return true;
    const text = [
        tr.dataset.fullRawText || '',
        tr.cells[3]?.textContent || '',
        tr.cells[4]?.textContent || '',
        tr.cells[6]?.textContent || '',
        tr.cells[7]?.textContent || '',
        tr.dataset.condition || '',
        tr.dataset.memo || ''
    ].join(' ');
    return (/\[\s*확정\s*\]|\(\s*확정\s*\)/.test(text) || (text.includes('확정') && !text.includes('미확정') && !text.includes('확정전')));
}

// [대기] 표시 타임 판별
function isDaegiTr(tr) {
    if (!tr) return false;
    if (tr.dataset.isDaegi === 'false') return false;
    if (tr.dataset.isDaegi === 'true') return true;
    if (tr.dataset.roomType === '대기방') return true;
    const text = [
        tr.dataset.fullRawText || '',
        tr.cells[3]?.textContent || '',
        tr.cells[4]?.textContent || '',
        tr.cells[6]?.textContent || '',
        tr.cells[7]?.textContent || '',
        tr.dataset.condition || '',
        tr.dataset.memo || ''
    ].join(' ');
    if (/\[\s*대기\s*\]|\(\s*대기\s*\)/.test(text) || /대기(?:중)?\s*[:\s]?\s*\d+/.test(text)) return true;
    if (text.includes('대기') && !text.includes('대기없음') && !text.includes('대기X')) return true;
    return false;
}

// [선티] / [대기] / [확정] 표시가 포함된 최우선 타임인지 판별 (모든 부제 공통)
function isPriorityTagTr(tr) {
    if (!tr) return false;
    if (tr.dataset.manualSeonti === 'true' || tr.dataset.isSeontiOrDaegi === 'true') return true;
    const roomType = (tr.dataset.roomType || '').trim();
    if (roomType === '선티방' || roomType === '대기방' || roomType.includes('선티')) return true;
    const text = [
        tr.dataset.fullRawText || '',
        tr.cells[3]?.textContent || '',
        tr.cells[4]?.textContent || '',
        tr.cells[6]?.textContent || '',
        tr.cells[7]?.textContent || '',
        tr.dataset.condition || '',
        tr.dataset.memo || ''
    ].join(' ');
    if (text.includes('선티')) return true;
    return isConfirmedTr(tr) || isDaegiTr(tr);
}

// [대기] 및 [확정] 타임 풀에서 최적의 2개 선별 (동일 시간/간격 제한 무관하게 둘 다 선택 보장)
function pickBestTwoFromPriorityPool(priorityPool, priority = 'none') {
    if (!priorityPool || priorityPool.length === 0) return [];
    if (priorityPool.length <= 2) return priorityPool;

    // 1. [대기]와 [확정]이 모두 존재하는 경우: [대기] 1개 + [확정] 1개 최우선 조합
    const daegiList = priorityPool.filter(tr => isDaegiTr(tr));
    const confirmedList = priorityPool.filter(tr => isConfirmedTr(tr));

    if (daegiList.length > 0 && confirmedList.length > 0) {
        // 서로 다른 부제(1부+2부 등)를 구성할 수 있는 쌍 우선 탐색
        for (const d of daegiList) {
            for (const c of confirmedList) {
                if (d !== c && getTrPart(d) !== getTrPart(c)) {
                    return [d, c];
                }
            }
        }
        // 같은 부제라도 [대기] 1개 + [확정] 1개 반환 (시간차가 0분이어도 모두 선택)
        const first = daegiList[0];
        const second = confirmedList.find(c => c !== first) || confirmedList[0];
        return [first, second];
    }

    // 2. [대기]만 3개 이상이거나 [확정]만 3개 이상인 경우: 부제 조합(1부+2부 등) 고려해 2개 선별
    const part1 = priorityPool.filter(tr => getTrPart(tr) === 1);
    const part2 = priorityPool.filter(tr => getTrPart(tr) === 2);
    const part3 = priorityPool.filter(tr => getTrPart(tr) === 3);

    if (part1.length > 0 && part2.length > 0) {
        return [pickBestOneFromPart(part1, 1), pickBestOneFromPart(part2, 2)].filter(Boolean);
    }
    if (part1.length > 0 && part3.length > 0) {
        return [pickBestOneFromPart(part1, 1), pickBestOneFromPart(part3, 3)].filter(Boolean);
    }
    if (part2.length > 0 && part3.length > 0) {
        return [pickBestOneFromPart(part2, 2), pickBestOneFromPart(part3, 3)].filter(Boolean);
    }

    // 단일 부제에 몰려 있는 경우: 황금 기준시간 근접 + 15분 이상 간격 우선
    const singlePartNum = getTrPart(priorityPool[0]) || 1;
    return pickTwoFromSamePart(priorityPool, singlePartNum);
}

// 플랫폼 우선순위(골프탑 우선 / 골프락 우선 / 기본) 및 [대기]/[확정] 최우선, 조인인원을 고려한 2개 타임 선별
function pickBestTwoWithPriority(list, priority = 'none') {
    if (!list || list.length === 0) return [];
    if (list.length <= 2) return list;

    // [최우선 0단계] [대기] 또는 [확정] 표시 타임 최우선 선별!
    const priorityList = list.filter(tr => isPriorityTagTr(tr));
    const nonPriorityList = list.filter(tr => !isPriorityTagTr(tr));

    if (priorityList.length >= 2) {
        // [대기]/[확정] 타임이 2개 이상 있는 경우 -> 이들 중에서 2개 선택!
        return pickBestTwoFromPriorityPool(priorityList, priority);
    } else if (priorityList.length === 1) {
        // [대기]/[확정] 타임이 딱 1개 있는 경우 -> 무조건 1순위로 포함하고 나머지 1개는 나머지 타임에서 보충
        const first = priorityList[0];
        if (nonPriorityList.length === 0) return [first];
        const second = pickComplementaryOneWithPriority(nonPriorityList, first, priority) || nonPriorityList[0];
        return second ? [first, second] : [first];
    }

    // 1. 인원이 있는 타임(대기방, 선티방, 1~3인 조인 대기)과 일반 타임 분리
    const paxList = list.filter(tr => hasJoinedPax(tr));
    const nonPaxList = list.filter(tr => !hasJoinedPax(tr));

    // [최우선 규칙 1] 인원이 있는 타임이 2개 이상 있는 경우:
    // -> 인원 있는 타임들 중에서 최우선으로 2개 선별! (인원 있는 타임들 사이에서 골프탑/골프락 우선순위 적용)
    if (paxList.length >= 2) {
        return pickTwoFromPoolWithPlatformPriority(paxList, priority);
    }

    // [최우선 규칙 2] 인원이 있는 타임이 딱 1개 있는 경우:
    // -> 해당 인원 타임은 무조건 1순위로 확보!
    // -> 나머지 1개는 일반 타임(nonPaxList) 중에서 골프탑/골프락 우선순위 + 부제 조합(1부+2부)을 고려해 선별
    if (paxList.length === 1) {
        const first = paxList[0];
        if (nonPaxList.length === 0) return [first];

        const second = pickComplementaryOneWithPriority(nonPaxList, first, priority);
        return second ? [first, second] : [first];
    }

    // [규칙 3] 인원이 있는 타임이 없는 경우:
    // -> 전체 일반 타임 중에서 플랫폼 우선순위(골프탑/골프락/기본) 적용
    return pickTwoFromPoolWithPlatformPriority(list, priority);
}

// 동서울CC 판별 헬퍼
function isDongSeoulCourse(tr) {
    if (!tr) return false;
    const targets = [
        tr.cells[2]?.textContent || '',
        tr.dataset.rawGolf || '',
        tr.dataset.golfmonGolf || '',
        tr.dataset.golfpangGolf || '',
        tr.dataset.golmarketGolf || '',
        tr.dataset.golfrockGolf || '',
        tr.dataset.golflandGolf || ''
    ];
    return targets.some(name => name.replace(/\s+/g, '').toLowerCase().includes('동서울'));
}

// 노캐디 타임 판별 헬퍼
function isNoCaddyTr(tr) {
    if (!tr) return false;
    const cady = (tr.cells[5]?.textContent || tr.dataset.cady || '').replace(/\s+/g, '').toLowerCase();
    if (cady.includes('노캐디')) return true;
    const condition = (tr.cells[6]?.textContent || '').trim().toLowerCase();
    if (condition.includes('노캐디') && !condition.includes('불가') && !condition.includes('제외')) return true;
    return false;
}

// 동서울CC 전용 노캐디 우선 2개 선별 ([대기]/[확정] 최우선 적용)
function pickBestTwoForDongSeoul(list, priority = 'none') {
    if (!list || list.length === 0) return [];
    if (list.length <= 2) return list;

    // [최우선 0단계] [대기] 또는 [확정] 표시 타임이 있는 경우 최우선 선별
    const priorityList = list.filter(tr => isPriorityTagTr(tr));
    const nonPriorityList = list.filter(tr => !isPriorityTagTr(tr));

    if (priorityList.length >= 2) {
        return pickBestTwoFromPriorityPool(priorityList, priority);
    } else if (priorityList.length === 1) {
        const first = priorityList[0];
        if (nonPriorityList.length === 0) return [first];
        const second = pickComplementaryOneWithPriority(nonPriorityList, first, priority) || nonPriorityList[0];
        return second ? [first, second] : [first];
    }

    const noCaddyList = list.filter(tr => isNoCaddyTr(tr));
    const caddyList = list.filter(tr => !isNoCaddyTr(tr));

    // 1. 노캐디 타임이 2개 이상 있는 경우 -> 노캐디 타임 중에서 최우선으로 2개 선별!
    if (noCaddyList.length >= 2) {
        return pickBestTwoWithPriority(noCaddyList, priority);
    }

    // 2. 노캐디 타임이 딱 1개 있는 경우 -> 해당 노캐디 타임 1순위 확보 + 일반(캐디) 타임에서 1개 보충
    if (noCaddyList.length === 1) {
        const first = noCaddyList[0];
        if (caddyList.length === 0) return [first];

        const second = pickComplementaryOneWithPriority(caddyList, first, priority) || caddyList[0];
        return second ? [first, second] : [first];
    }

    // 3. 노캐디 타임이 없는 경우 -> 일반 규칙으로 2개 선별
    return pickBestTwoWithPriority(list, priority);
}

// ========================================================
// ★ 사용자 핵심 요청: 1부, 2부, 3부 우선선택 기능
// - 2부, 3부 체크: 2부 1개 + 3부 1개 선택 (단, 1부에 선티(확정/대기)가 있다면 1부 선티 최우선 포함!)
// - 1부만 체크: 1부 1개 + 2부/3부 중 있는 것 1개 선택
// - 1부, 2부, 3부 모두 체크: 1부 1개 + 2부 1개 + 3부 1개 선택
// ========================================================

function getPreferredPartsConfig() {
    const chk1 = document.getElementById('chkPrefPart1');
    const chk2 = document.getElementById('chkPrefPart2');
    const chk3 = document.getElementById('chkPrefPart3');

    const p1 = chk1 ? chk1.checked : (localStorage.getItem('v2_prefPart1') === 'true');
    const p2 = chk2 ? chk2.checked : (localStorage.getItem('v2_prefPart2') !== 'false'); // 기본 2부 체크
    const p3 = chk3 ? chk3.checked : (localStorage.getItem('v2_prefPart3') !== 'false'); // 기본 3부 체크

    return { p1, p2, p3 };
}

function pickBestOneFromPartWithPriority(partPool, partNumber, priority = 'none') {
    if (!partPool || partPool.length === 0) return null;
    if (partPool.length === 1) return partPool[0];

    // 1순위: [선티] / [확정] / [대기] 최우선
    const priorityList = partPool.filter(tr => isPriorityTagTr(tr));
    if (priorityList.length > 0) {
        const withPax = priorityList.filter(tr => hasJoinedPax(tr));
        const poolToUse = withPax.length > 0 ? withPax : priorityList;
        return pickBestOneFromPart(poolToUse, partNumber);
    }

    // 동서울CC인 경우 노캐디 타임 우선
    if (partPool.some(tr => isDongSeoulCourse(tr))) {
        const noCaddyPool = partPool.filter(tr => isNoCaddyTr(tr));
        if (noCaddyPool.length > 0) {
            partPool = noCaddyPool;
            if (partPool.length === 1) return partPool[0];
        }
    }

    // 2순위: 조인 대기 인원 있는 타임
    const paxList = partPool.filter(tr => hasJoinedPax(tr));
    if (paxList.length > 0) {
        return pickBestOneFromPart(paxList, partNumber);
    }

    // 3순위: 플랫폼 우선순위 적용
    if (priority === 'golftop' || priority === 'golfrock') {
        const preferred = partPool.filter(tr => (tr.dataset.source || 'golfrock') === priority);
        if (preferred.length > 0) {
            return pickBestOneFromPart(preferred, partNumber);
        }
    }

    return pickBestOneFromPart(partPool, partNumber);
}

function pickPreferredTimesForGroup(list, priority = 'none') {
    if (!list || list.length === 0) return [];
    if (list.length <= 1) return list;

    const { p1, p2, p3 } = getPreferredPartsConfig();
    const maxTargetCount = (p1 && p2 && p3) ? 3 : 2;

    // 부제별 분리
    const part1List = list.filter(tr => getTrPart(tr) === 1);
    const part2List = list.filter(tr => getTrPart(tr) === 2);
    const part3List = list.filter(tr => getTrPart(tr) === 3);

    const picked = [];
    const allSeontiList = list.filter(tr => isPriorityTagTr(tr));

    // 부제별 선택 헬퍼 (이미 해당 부제에서 뽑힌 타임이 있는지 고려)
    const hasPickedFromPart = (partNum) => picked.some(tr => getTrPart(tr) === partNum);
    const tryPickFromPart = (pool, partNum) => {
        if (picked.length >= maxTargetCount) return;
        const avail = pool.filter(tr => !picked.includes(tr));
        if (avail.length === 0) return;
        const one = pickBestOneFromPartWithPriority(avail, partNum, priority);
        if (one && !picked.includes(one)) picked.push(one);
    };

    // ★ [1부, 2부, 3부 모두 체크한 경우]: 1부·2부·3부 셋 다(최대 3개) 고르게 우선 선택!
    // (각 부제 내부에서는 pickBestOneFromPartWithPriority에 의해 선티가 1순위로 자동 선택되며,
    //  특정 부제에 타임이 없는 경우 아래 보충 단계에서 남은 선티 및 타 부제 타임으로 총 3개까지 채움)
    if (p1 && p2 && p3) {
        tryPickFromPart(part1List, 1);
        tryPickFromPart(part2List, 2);
        tryPickFromPart(part3List, 3);
    } else {
        // ★ [최우선 규칙: 모든 타임(1부/2부/3부 전체)에서 선티(선티방/수동선티/확정/대기)가 있으면 무조건 최우선 선택!]
        if (allSeontiList.length > 0) {
            const seontiP1 = part1List.filter(tr => isPriorityTagTr(tr));
            const seontiP2 = part2List.filter(tr => isPriorityTagTr(tr));
            const seontiP3 = part3List.filter(tr => isPriorityTagTr(tr));

            // 1차: 체크된 선호 부제의 선티를 부제별로 1개씩 먼저 확보
            const prefSeontiPools = [];
            if (p1 && seontiP1.length > 0) prefSeontiPools.push({ pool: seontiP1, part: 1 });
            if (p2 && seontiP2.length > 0) prefSeontiPools.push({ pool: seontiP2, part: 2 });
            if (p3 && seontiP3.length > 0) prefSeontiPools.push({ pool: seontiP3, part: 3 });

            for (const item of prefSeontiPools) {
                if (picked.length >= maxTargetCount) break;
                const one = pickBestOneFromPartWithPriority(item.pool, item.part, priority);
                if (one && !picked.includes(one)) picked.push(one);
            }

            // 2차: 체크되지 않은 부제에 있는 선티도 최우선 포함 (모든 타임 선티 최우선)
            const nonPrefSeontiPools = [];
            if (!p1 && seontiP1.length > 0) nonPrefSeontiPools.push({ pool: seontiP1, part: 1 });
            if (!p2 && seontiP2.length > 0) nonPrefSeontiPools.push({ pool: seontiP2, part: 2 });
            if (!p3 && seontiP3.length > 0) nonPrefSeontiPools.push({ pool: seontiP3, part: 3 });

            for (const item of nonPrefSeontiPools) {
                if (picked.length >= maxTargetCount) break;
                const one = pickBestOneFromPartWithPriority(item.pool, item.part, priority);
                if (one && !picked.includes(one)) picked.push(one);
            }

            // 3차: 여전히 목표 개수 미만이고 남은 선티가 있다면 남은 선티에서 보충
            if (picked.length < maxTargetCount) {
                const remSeonti = allSeontiList.filter(tr => !picked.includes(tr));
                const bestRem = pickBestTwoFromPriorityPool(remSeonti, priority);
                for (const s of bestRem) {
                    if (picked.length >= maxTargetCount) break;
                    if (!picked.includes(s)) picked.push(s);
                }
            }
        }

        // 이미 선티만으로 목표 개수(2개)가 모두 채워졌다면 즉시 반환
        if (picked.length >= maxTargetCount) {
            return picked.slice(0, maxTargetCount);
        }

        // 1. [1부만 선택한 경우]: 1부에서 하나 선택. 2부, 3부 중 있는 것 선택
        if (p1 && !p2 && !p3) {
            if (!hasPickedFromPart(1)) tryPickFromPart(part1List, 1);
            if (picked.length < maxTargetCount) {
                if (part2List.some(tr => !picked.includes(tr))) tryPickFromPart(part2List, 2);
                else if (part3List.some(tr => !picked.includes(tr))) tryPickFromPart(part3List, 3);
            }
        }
        // 2. [2부, 3부 선택한 경우]: 2부 1개 + 3부 1개 선택
        else if (!p1 && p2 && p3) {
            if (!hasPickedFromPart(2)) tryPickFromPart(part2List, 2);
            if (!hasPickedFromPart(3)) tryPickFromPart(part3List, 3);
            if (picked.length < maxTargetCount) {
                tryPickFromPart(part2List, 2);
                tryPickFromPart(part3List, 3);
            }
            if (picked.length === 0 && part1List.length > 0) {
                tryPickFromPart(part1List, 1);
            }
        }
        // 4. [1부, 2부 선택한 경우]: 1부 1개 + 2부 1개 선택
        else if (p1 && p2 && !p3) {
            if (!hasPickedFromPart(1)) tryPickFromPart(part1List, 1);
            if (!hasPickedFromPart(2)) tryPickFromPart(part2List, 2);
        }
        // 5. [1부, 3부 선택한 경우]: 1부 1개 + 3부 1개 선택
        else if (p1 && !p2 && p3) {
            if (!hasPickedFromPart(1)) tryPickFromPart(part1List, 1);
            if (!hasPickedFromPart(3)) tryPickFromPart(part3List, 3);
        }
        // 6. [2부만 선택한 경우]: 2부 1개 선택 (없으면 3부에서 보충)
        else if (!p1 && p2 && !p3) {
            if (!hasPickedFromPart(2)) tryPickFromPart(part2List, 2);
            if (picked.length < maxTargetCount && part2List.filter(tr => !picked.includes(tr)).length === 0) {
                tryPickFromPart(part3List, 3);
            }
        }
        // 7. [3부만 선택한 경우]: 3부 1개 선택 (없으면 2부에서 보충)
        else if (!p1 && !p2 && p3) {
            if (!hasPickedFromPart(3)) tryPickFromPart(part3List, 3);
            if (picked.length < maxTargetCount && part3List.filter(tr => !picked.includes(tr)).length === 0) {
                tryPickFromPart(part2List, 2);
            }
        }
        // 8. 아무것도 체크 안 된 경우: 기본 선별 적용
        else {
            return pickBestTwoWithPriority(list, priority);
        }
    }

    // ★ [구장별 최대 목표 개수(2개 또는 1·2·3부 모두 체크 시 3개) 선택 채우기!]
    if (picked.length < maxTargetCount && list.length > picked.length) {
        // 0) 아직 선택되지 않은 선티가 남아있다면 최우선 보충
        const remSeonti = allSeontiList.filter(tr => !picked.includes(tr));
        for (const s of remSeonti) {
            if (picked.length >= maxTargetCount) break;
            if (!picked.includes(s)) picked.push(s);
        }

        // 1) 체크된 부제의 남은 타임들에서 우선 보충 (동일 부제 내 기존 선택 타임과 15분 이상 간격 우선)
        const preferredRemainingParts = [];
        if (p2) preferredRemainingParts.push({ pool: part2List.filter(tr => !picked.includes(tr)), part: 2 });
        if (p3) preferredRemainingParts.push({ pool: part3List.filter(tr => !picked.includes(tr)), part: 3 });
        if (p1) preferredRemainingParts.push({ pool: part1List.filter(tr => !picked.includes(tr)), part: 1 });

        for (const item of preferredRemainingParts) {
            while (picked.length < maxTargetCount && item.pool.length > 0) {
                const pickedInSamePart = picked.filter(tr => getTrPart(tr) === item.part);
                const spacedPool = pickedInSamePart.length > 0
                    ? item.pool.filter(tr => pickedInSamePart.every(p => Math.abs(getTrMinutes(tr) - getTrMinutes(p)) >= 15))
                    : item.pool;
                const poolToPick = spacedPool.length > 0 ? spacedPool : item.pool;
                const nextOne = pickBestOneFromPartWithPriority(poolToPick, item.part, priority);
                if (nextOne && !picked.includes(nextOne)) {
                    picked.push(nextOne);
                    const idx = item.pool.indexOf(nextOne);
                    if (idx >= 0) item.pool.splice(idx, 1);
                } else {
                    break;
                }
            }
            if (picked.length >= maxTargetCount) break;
        }

        // 2) 그래도 maxTargetCount개가 안 찼다면 전체 리스트의 남은 타임에서 보충
        // ★ [핵심 개선]: 사용자가 특정 부제(예: 2부, 3부)를 명시적으로 선택한 경우,
        // 체크되지 않은 부제(예: 1부)의 타임은 3부가 비어있더라도 절대 강제로 끌어오지 않음!
        const hasSpecificPartFilter = (p1 || p2 || p3);
        if (picked.length < maxTargetCount && !hasSpecificPartFilter) {
            const allRemaining = list.filter(tr => !picked.includes(tr));
            while (picked.length < maxTargetCount && allRemaining.length > 0) {
                const partNum = getTrPart(allRemaining[0]) || 2;
                const nextOne = pickBestOneFromPartWithPriority(allRemaining, partNum, priority);
                if (nextOne && !picked.includes(nextOne)) {
                    picked.push(nextOne);
                    const idx = allRemaining.indexOf(nextOne);
                    if (idx >= 0) allRemaining.splice(idx, 1);
                } else {
                    picked.push(allRemaining[0]);
                    allRemaining.splice(0, 1);
                }
            }
        }
    }

    return picked.length > 0 ? picked : pickBestTwoWithPriority(list, priority);
}

// 구장별 자동 선택 로직 (1·2·3부 모두 체크 시 구장별 양도 최대 3개 / 조인 최대 3개 선택)
function applyAutoSelectTwoToTrs(trsList) {
    if (!trsList || trsList.length === 0) return 0;
    trsList.forEach(tr => tr.classList.remove('selected'));

    const groups = {};
    trsList.forEach(tr => {
        // 매핑사전에 등록되지 않은 구장은 자동 선택에서 제외!
        if (tr.dataset.isMapped === 'false') return;

        // 현장/선결제 합산 금액이 0만 이하인 항목 자동 선택 제외
        const totalFeeVal = parseFloat(tr.dataset.totalFee) || 0;
        if (totalFeeVal <= 0) return;

        const date = tr.cells[0]?.textContent || '';
        const golf = tr.cells[2]?.textContent || '';
        const isTransfer = (tr.dataset.roomType === '양도' || (tr.cells[4]?.textContent || '').includes('양도'));
        const typeCategory = isTransfer ? '양도' : '조인';
        const key = `${date}_${golf}_${typeCategory}`;
        if (!groups[key]) groups[key] = [];
        groups[key].push(tr);
    });

    const stickyMap = getStickyCourseMap();
    let count = 0;
    for (const key in groups) {
        const list = groups[key];
        // ★ 사용자 우선선택 규칙(1부/2부/3부 모두 체크 시 3개 선택, 전 타임 선티 최우선, 동서울 노캐디 우선) 통합 적용!
        const picked = pickPreferredTimesForGroup(list, autoSelectPriority);

        picked.forEach(tr => {
            tr.classList.add('selected');
            count++;
        });

        if (picked.length > 0) {
            const gKey = makeStickyGroupKeyFromTr(picked[0]);
            if (gKey) {
                stickyMap[gKey] = picked.map(tr => (tr.cells[1]?.textContent || '').replace(/[^\d]/g, '')).filter(Boolean);
            }
        }
    }
    saveStickyCourseMap(stickyMap);
    return count;
}

// 자동 선택 (전체 테이블 대상)
function autoSelectTwo() {
    const trs = Array.from(document.querySelectorAll('#dataTable tbody tr'));
    const count = applyAutoSelectTwoToTrs(trs);

    renderCardList();
    syncCardsSelection();
    updateSelectedBadge();
    saveCurrentTableState();
    if (count > 0) {
        let pLabel = '';
        if (autoSelectPriority === 'golftop') pLabel = ' (골프탑 우선)';
        else if (autoSelectPriority === 'golfrock') pLabel = ' (골프락 우선)';
        const { p1, p2, p3 } = getPreferredPartsConfig();
        const maxPerGroup = (p1 && p2 && p3) ? 3 : 2;
        const selectedTrs = trs.filter(tr => tr.classList.contains('selected'));
        const selTransferCount = selectedTrs.filter(tr => tr.dataset.roomType === '양도').length;
        const selJoinCount = selectedTrs.length - selTransferCount;
        if (selTransferCount > 0 && selJoinCount > 0) {
            showToast(`한번에 원클릭 자동선택: 조인 ${selJoinCount}건 + 양도 ${selTransferCount}건 (총 ${count}건)${pLabel}`);
        } else {
            showToast(`구장별 최대 ${maxPerGroup}개씩 총 ${count}건 자동 선택됨${pLabel}`);
        }
    } else if (trs.length > 0) {
        const unmappedTrs = trs.filter(tr => tr.dataset.isMapped === 'false');
        if (unmappedTrs.length === trs.length) {
            showToast('구장명이 없거나 미등록 상태여서 자동 선택되지 않았습니다.');
        }
    }
}

function syncCardsSelection() {
    const trs = Array.from(document.querySelectorAll('#dataTable tbody tr'));
    const cards = Array.from(document.querySelectorAll('#cardList .tee-card'));

    // [최적화]: 화면에 렌더링된 카드(예: 100개)만 순회하여 0.1ms 고속 동기화
    cards.forEach((card) => {
        const idx = parseInt(card.dataset.index, 10);
        const tr = trs[idx];
        if (tr) {
            const isSel = tr.classList.contains('selected');
            card.classList.toggle('selected', isSel);
            const chk = card.querySelector('input[type="checkbox"]');
            if (chk) chk.checked = isSel;
        }
    });
}

// 부제(1부/2부/3부) 우선선택 UI 초기화 및 이벤트 연결
function initPreferredPartsUI() {
    const chk1 = document.getElementById('chkPrefPart1');
    const chk2 = document.getElementById('chkPrefPart2');
    const chk3 = document.getElementById('chkPrefPart3');
    const lbl1 = document.getElementById('lblPrefPart1');
    const lbl2 = document.getElementById('lblPrefPart2');
    const lbl3 = document.getElementById('lblPrefPart3');

    if (!chk1 || !chk2 || !chk3) return;

    // 저장된 설정 로드 (기본: 2부 true, 3부 true, 1부 false)
    const p1 = localStorage.getItem('v2_prefPart1') === 'true';
    const p2 = localStorage.getItem('v2_prefPart2') !== 'false';
    const p3 = localStorage.getItem('v2_prefPart3') !== 'false';

    chk1.checked = p1;
    chk2.checked = p2;
    chk3.checked = p3;

    if (lbl1) lbl1.classList.toggle('active', p1);
    if (lbl2) lbl2.classList.toggle('active', p2);
    if (lbl3) lbl3.classList.toggle('active', p3);

    const updatePrefPart = () => {
        try {
            localStorage.setItem('v2_prefPart1', chk1.checked ? 'true' : 'false');
            localStorage.setItem('v2_prefPart2', chk2.checked ? 'true' : 'false');
            localStorage.setItem('v2_prefPart3', chk3.checked ? 'true' : 'false');
        } catch(e) {}
        if (lbl1) lbl1.classList.toggle('active', chk1.checked);
        if (lbl2) lbl2.classList.toggle('active', chk2.checked);
        if (lbl3) lbl3.classList.toggle('active', chk3.checked);

        // 이미 변환된 티타임 목록이 있는 경우 즉시 재선택 적용
        const trs = document.querySelectorAll('#dataTable tbody tr');
        if (trs.length > 0) {
            autoSelectTwo();
            const parts = [];
            if (chk1.checked) parts.push('1부');
            if (chk2.checked) parts.push('2부');
            if (chk3.checked) parts.push('3부');
            const partStr = parts.length > 0 ? parts.join('·') : '기본';
            const maxPerGroup = (chk1.checked && chk2.checked && chk3.checked) ? 3 : 2;
            showToast(`부제 우선선택 [${partStr}] 재적용 완료 (구장별 최대 ${maxPerGroup}개 선택)`);
        }
    };

    chk1.addEventListener('change', updatePrefPart);
    chk2.addEventListener('change', updatePrefPart);
    chk3.addEventListener('change', updatePrefPart);

    // 🕒 부제별 사용자 맞춤 기준시간 설정 UI 연결
    const btnToggle = document.getElementById('btnTogglePartTargetTime');
    const boxTime = document.getElementById('boxPartTargetTime');
    const selP1 = document.getElementById('selTargetTimePart1');
    const selP2 = document.getElementById('selTargetTimePart2');
    const selP3 = document.getElementById('selTargetTimePart3');
    const btnApplyTimes = document.getElementById('btnApplyPartTargetTimes');

    if (btnToggle && boxTime) {
        btnToggle.addEventListener('click', () => {
            const isHidden = boxTime.style.display === 'none' || !boxTime.style.display;
            boxTime.style.display = isHidden ? 'flex' : 'none';
        });
    }

    if (selP1) {
        const saved1 = localStorage.getItem('v2_targetTimePart1') || '08:00';
        selP1.value = saved1;
        selP1.addEventListener('change', () => {
            try { localStorage.setItem('v2_targetTimePart1', selP1.value); } catch(e) {}
        });
    }

    if (selP2) {
        const saved2 = localStorage.getItem('v2_targetTimePart2') || '11:00';
        selP2.value = saved2;
        selP2.addEventListener('change', () => {
            try { localStorage.setItem('v2_targetTimePart2', selP2.value); } catch(e) {}
        });
    }

    if (selP3) {
        const saved3 = localStorage.getItem('v2_targetTimePart3') || 'earliest';
        selP3.value = saved3;
        selP3.addEventListener('change', () => {
            try { localStorage.setItem('v2_targetTimePart3', selP3.value); } catch(e) {}
        });
    }

    if (btnApplyTimes) {
        btnApplyTimes.addEventListener('click', () => {
            const t1 = selP1 ? selP1.value : '08:00';
            const t2 = selP2 ? selP2.value : '11:00';
            const t3 = selP3 ? selP3.value : 'earliest';
            try {
                localStorage.setItem('v2_targetTimePart1', t1);
                localStorage.setItem('v2_targetTimePart2', t2);
                localStorage.setItem('v2_targetTimePart3', t3);
            } catch(e) {}

            const trs = document.querySelectorAll('#dataTable tbody tr');
            if (trs.length > 0) {
                autoSelectTwo();
                const p3Label = (t3 === 'earliest') ? '첫타임' : t3;
                showToast(`기준시간 [1부 ${t1} · 2부 ${t2} · 3부 ${p3Label}] 맞춤 재선택 완료!`);
            } else {
                showToast(`기준시간 [1부 ${t1} · 2부 ${t2} · 3부 ${(t3 === 'earliest' ? '첫타임' : t3)}] 저장되었습니다.`);
            }
        });
    }
}

// ========================================================
// New GolfTee82: 등록 이력 관리 & 가격 변동 추적
// ========================================================
let registeredHistory = {};

function makeHistoryKey(dateStr, golfStr, timeStr) {
    const cleanDate = (dateStr || '').replace(/[^\d]/g, '');
    const cleanGolf = (golfStr || '').replace(/\s+/g, '').replace(/cc|gc|골프장|골프클럽/gi, '').trim().toLowerCase();
    const cleanTime = (timeStr || '').replace(/[^\d]/g, '');
    return `${cleanDate}_${cleanGolf}_${cleanTime}`;
}

function pruneOldRegisteredHistory() {
    try {
        const now = Date.now();
        const MAX_AGE_MS = 14 * 24 * 60 * 60 * 1000; // 14일 초과 과거 데이터 자동 정리 (TTL)
        let pruned = false;
        for (const k in registeredHistory) {
            const item = registeredHistory[k];
            const ts = item?.registeredAt ? new Date(item.registeredAt).getTime() : (item?.timestamp || 0);
            if (ts && (now - ts > MAX_AGE_MS)) {
                delete registeredHistory[k];
                pruned = true;
            }
        }
        if (pruned) saveRegisteredHistory();
    } catch(e) {}
}

function loadRegisteredHistory() {
    try {
        const local = localStorage.getItem('v2_registeredHistory');
        if (local) {
            registeredHistory = JSON.parse(local);
            pruneOldRegisteredHistory();
        }
    } catch(e) {}
    try {
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.get(['v2_registeredHistory'], (res) => {
                if (res && res.v2_registeredHistory && typeof res.v2_registeredHistory === 'object') {
                    registeredHistory = Object.assign({}, res.v2_registeredHistory, registeredHistory);
                    pruneOldRegisteredHistory();
                }
            });
        }
    } catch(e) {}
}

function saveRegisteredHistory() {
    try {
        localStorage.setItem('v2_registeredHistory', JSON.stringify(registeredHistory));
    } catch(e) {}
    try {
        if (typeof chrome !== 'undefined' && chrome.storage && chrome.storage.local) {
            chrome.storage.local.set({ v2_registeredHistory: registeredHistory });
        }
    } catch(e) {}
}

function recordRegisteredItem(item) {
    if (!item) return;
    const feeNum = parseFloat((item.fee || '').toString().replace(/[^\d.]/g, '')) || 0;
    const entry = {
        date: item.date,
        golf: item.golf,
        rawGolf: item.rawGolf || item.golf,
        time: item.time,
        fee: feeNum,
        updatedAt: Date.now()
    };
    const k1 = makeHistoryKey(item.date, item.golf, item.time);
    const k2 = makeHistoryKey(item.date, item.rawGolf, item.time);
    if (k1) registeredHistory[k1] = entry;
    if (k2) registeredHistory[k2] = entry;
    saveRegisteredHistory();
}

// 가격 인하건만 필터/선택 핸들러
function handleSelectPriceDropped() {
    const trs = Array.from(document.querySelectorAll('#dataTable tbody tr'));
    if (trs.length === 0) {
        showToast('변환된 티타임이 없습니다.');
        return;
    }

    const priceDroppedTrs = trs.filter(tr => tr.dataset.isPriceDropped === 'true');
    if (priceDroppedTrs.length === 0) {
        showToast('현재 인하(할인)된 티타임이 없습니다.');
        return;
    }

    const isAllDropSelected = priceDroppedTrs.every(tr => tr.classList.contains('selected'));
    const targetState = !isAllDropSelected;

    trs.forEach(tr => {
        if (tr.dataset.isPriceDropped === 'true') {
            tr.classList.toggle('selected', targetState);
        } else {
            tr.classList.remove('selected');
        }
    });

    syncCardsSelection();
    updateSelectedBadge();
    saveCurrentTableState();

    if (targetState) {
        showToast(`가격 인하 타임 ${priceDroppedTrs.length}건이 선택되었습니다!`);
    } else {
        showToast('인하건 선택이 해제되었습니다.');
    }
}

// ========================================================
// 골프몬 탭 탐색 최적화 및 스마트 통신/재연결 헬퍼
// ========================================================
function findBestGolfmonTab(callback) {
    chrome.tabs.query({}, (allTabs) => {
        if (chrome.runtime.lastError || !allTabs || allTabs.length === 0) {
            callback(null);
            return;
        }

        const golfmonTabs = allTabs.filter(t => t.url && t.url.includes('golfmon.net'));
        if (golfmonTabs.length === 0) {
            callback(null);
            return;
        }

        // 스마트 스코어링: 실제 작업 중인 product/list 탭 및 활성 탭 최우선 선택!
        golfmonTabs.sort((a, b) => {
            let scoreA = 0;
            let scoreB = 0;

            if (a.url && a.url.includes('product/list')) scoreA += 100;
            else if (a.url && a.url.includes('product')) scoreA += 50;

            if (b.url && b.url.includes('product/list')) scoreB += 100;
            else if (b.url && b.url.includes('product')) scoreB += 50;

            if (a.active) scoreA += 50;
            if (b.active) scoreB += 50;

            if (!a.discarded) scoreA += 30;
            if (!b.discarded) scoreB += 30;

            const accessA = a.lastAccessed || 0;
            const accessB = b.lastAccessed || 0;

            if (scoreA !== scoreB) return scoreB - scoreA;
            return accessB - accessA;
        });

        const bestTab = golfmonTabs[0];
        console.log(`[Tee82] 선택된 골프몬 타겟 탭: ID=${bestTab.id}, URL=${bestTab.url}, active=${bestTab.active}, discarded=${bestTab.discarded}`);
        callback(bestTab);
    });
}

function sendGolfmonMacroCommand(tab, payload, onStarted) {
    if (!tab || !tab.id) {
        showToast("골프몬(golfmon.net) 탭을 찾을 수 없습니다.");
        return;
    }

    if (payload && typeof payload === 'object') {
        payload.isAdmin = (typeof isCurrentUserAdmin === 'function') ? isCurrentUserAdmin() : true;
    }

    // 1단계: 이미 로드되어 있는 골프몬 탭으로 실제 명령 직접 전송 (0ms 즉시 통신)
    chrome.tabs.sendMessage(tab.id, payload, (res) => {
        if (!chrome.runtime.lastError) {
            // 통신 성공! 즉시 실행 콜백 호출
            if (typeof onStarted === 'function') onStarted(res);
            return;
        }

        const errMsg = chrome.runtime.lastError.message || '';
        console.warn("[Tee82] 골프몬 1차 명령 전송 실패, 스크립트 연결 확인/재주입 시도:", errMsg);

        // 2단계: 스크립트가 아직 로드되지 않은 탭인 경우(새로 열린 탭 등)에만 1회 주입 시도
        if (chrome.scripting && chrome.scripting.executeScript) {
            chrome.scripting.executeScript({
                target: { tabId: tab.id },
                files: ['content_script.js']
            }, () => {
                if (chrome.runtime.lastError) {
                    console.error("[Tee82] executeScript 주입 실패:", chrome.runtime.lastError.message);
                    showToast("골프몬 창을 [F5] 새로고침해주세요! (" + chrome.runtime.lastError.message + ")");
                    return;
                }
                // 주입 완료 후 150ms 대기 후 2차 전송 시도
                setTimeout(() => {
                    chrome.tabs.sendMessage(tab.id, payload, (res2) => {
                        if (!chrome.runtime.lastError) {
                            if (typeof onStarted === 'function') onStarted(res2);
                        } else {
                            console.error("[Tee82] 2차 주입 후 통신 실패:", chrome.runtime.lastError.message);
                            const errMsg2 = chrome.runtime.lastError.message || '';
                            if (errMsg2.includes('Receiving end does not exist') || errMsg2.includes('Could not establish')) {
                                showToast("골프몬 창을 [F5] 새로고침해주세요! (업데이트 후 연결 초기화 필요)");
                            } else {
                                showToast("골프몬 통신 실패 (" + errMsg2 + ")");
                            }
                        }
                    });
                }, 150);
            });
        } else {
            showToast("골프몬 창을 [F5] 새로고침해주세요! (업데이트 후 연결 초기화 필요)");
        }
    });
}

// 골프몬 내글 가격수정 실행 중복 클릭 방지 플래그
let isGolfmonPriceUpdating = false;

// 골프몬 내글 가격수정 실행 핸들러
function startGolfmonPriceUpdate() {
    if (!checkAuthSecurityGuard('몬')) return;
    if (isGolfmonPriceUpdating) {
        console.warn("[Tee82] 이미 가격수정 명령이 전달 중입니다. 중복 클릭 무시.");
        return;
    }
    isGolfmonPriceUpdating = true;
    setTimeout(() => { isGolfmonPriceUpdating = false; }, 3000);

    let targetTrs = Array.from(document.querySelectorAll('#dataTable tbody tr.selected'));
    if (targetTrs.length === 0) {
        const dropTrs = Array.from(document.querySelectorAll('#dataTable tbody tr')).filter(tr => tr.dataset.isPriceDropped === 'true');
        if (dropTrs.length > 0) {
            targetTrs = dropTrs;
            dropTrs.forEach(tr => tr.classList.add('selected'));
            syncCardsSelection();
            updateSelectedBadge();
        }
    }

    if (targetTrs.length === 0) {
        alert("가격 수정할 티타임이 선택되지 않았습니다.\n수정할 타임을 목록에서 체크하거나 [인하건 선택]을 눌러주세요.");
        return;
    }

    targetTrs.forEach((tr, idx) => {
        tr.dataset.regId = `edit_gm_${Date.now()}_${idx}`;
    });

    const golfrockMemo = document.getElementById('golfrockMemo')?.value || document.getElementById('golfmonMemo')?.value || '';
    const golftopMemo = document.getElementById('golftopMemo')?.value || '';

    const items = targetTrs.map(tr => {
        const cells = tr.querySelectorAll('td');
        const origGolf = cells[2]?.textContent.trim() || '';
        const rawGolf = tr.dataset.rawGolf || origGolf;
        const golfmonGolf = tr.dataset.golfmonGolf || getMappedName(rawGolf, 'golfmon').name || origGolf;

        const roomTypeRaw = (tr.dataset.roomType || '').trim();
        const sizenumRaw = (cells[7]?.textContent || '').trim();
        const conditionRaw = (cells[6]?.textContent || '').trim();

        // 골프몬 등록글 양도/조인 구별 판별
        let resolvedRoomType = '조인';
        // 1. TR 자체에 명시된 roomType 최우선 판별
        if (roomTypeRaw === '양도') {
            resolvedRoomType = '양도';
        } else if (roomTypeRaw === '조인' || roomTypeRaw === '선티방' || roomTypeRaw.includes('선티') || roomTypeRaw.includes('대기')) {
            resolvedRoomType = '조인';
        }
        // 2. 단독 매크로 모드 판별
        else if (typeof lastUsedMacroType !== 'undefined' && lastUsedMacroType === 'join') {
            resolvedRoomType = '조인';
        } else if (typeof lastUsedMacroType !== 'undefined' && lastUsedMacroType === 'transfer') {
            resolvedRoomType = '양도';
        }
        // 3. 인원 수 및 기타 조건 판별
        else if (sizenumRaw && /^[123]인$/.test(sizenumRaw)) {
            resolvedRoomType = '조인';
        } else if (conditionRaw && conditionRaw !== '무관') {
            resolvedRoomType = '조인';
        } else if (sizenumRaw === '4인' && roomTypeRaw !== '조인') {
            resolvedRoomType = '양도';
        } else {
            resolvedRoomType = '조인';
        }

        const source = tr.dataset.source || 'golfrock';
        const itemMemo = resolveItemRegistrationMemo(golfmonGolf || rawGolf || origGolf);

        return {
            regId: tr.dataset.regId,
            date: cells[0]?.textContent.trim() || '',
            region: cells[1]?.textContent.trim() || '',
            golf: golfmonGolf,
            rawGolf: rawGolf,
            time: cells[3]?.textContent.trim() || '',
            fee: tr.dataset.totalFee || tr.dataset.baseFee || cells[4]?.textContent.trim().replace(/[^\d.]/g, '') || '',
            cady: cells[5]?.textContent.trim() || '',
            condition: conditionRaw,
            sizenum: sizenumRaw,
            roomType: resolvedRoomType,
            origRoomType: roomTypeRaw,
            isPrepaid: tr.dataset.isPrepaid === 'true',
            isMeal: tr.dataset.isMeal === 'true',
            source: source,
            memo: itemMemo,
            isPriceDropped: tr.dataset.isPriceDropped === 'true',
            prevFee: tr.dataset.prevFee || ''
        };
    });

    const delayPreset = document.getElementById('selRandomDelay')?.value || localStorage.getItem('v2_randomDelayPreset') || 'fast';
    const stepPreset = document.getElementById('selStepDelay')?.value || localStorage.getItem('v2_stepDelayPreset') || 'fast';
    const confirmMismatch = document.getElementById('chkConfirmCourseMismatch')?.checked ?? true;

    // 양도용 원클릭 vs 조인용 원클릭 모드 또는 항목 구성에 따른 구분 필터('양도' or '조인' or '전체')
    const transferCount = items.filter(it => it.roomType === '양도').length;
    const joinCount = items.filter(it => it.roomType === '조인').length;
    let filterType = '조인';
    if (transferCount > 0 && joinCount > 0) {
        filterType = '전체';
    } else if (typeof lastUsedMacroType !== 'undefined' && lastUsedMacroType === 'transfer') {
        filterType = '양도';
    } else if (typeof lastUsedMacroType !== 'undefined' && lastUsedMacroType === 'join') {
        filterType = '조인';
    } else if (transferCount > joinCount) {
        filterType = '양도';
    } else {
        filterType = '조인';
    }

    chrome.tabs.query({ url: ["*://golfmon.net/*", "https://golfmon.net/*", "http://golfmon.net/*", "*://*.golfmon.net/*", "https://*.golfmon.net/*", "http://*.golfmon.net/*"] }, (tabs) => {
        if (tabs && tabs.length > 0) {
            const golfmonTab = tabs[0];
            let effectivePriceItems = items;
            if (includeSpecialInPriceUpdate === false && Array.isArray(specialTargetCourses) && specialTargetCourses.length > 0) {
                const cleanSpecs = specialTargetCourses.map(s => String(s || '').replace(/[\s\-_()\[\]]/g, '').toLowerCase()).filter(Boolean);
                effectivePriceItems = items.filter(it => {
                    const names = [it.golf, it.rawGolf].filter(Boolean).map(n => String(n).replace(/[\s\-_()\[\]]/g, '').toLowerCase());
                    return !names.some(name => cleanSpecs.some(spec => name.includes(spec) || spec.includes(name)));
                });
            }
            startGolfmonMacroSupervision({
                tabId: golfmonTab.id,
                macroType: 'PRICE_UPDATE',
                items: effectivePriceItems,
                filterType: filterType,
                delayPreset: delayPreset,
                stepPreset: stepPreset,
                customMemo: golfrockMemo,
                confirmMismatch: confirmMismatch
            });
            chrome.tabs.update(golfmonTab.id, { active: true }, () => {
                sendGolfmonMacroCommand(golfmonTab, {
                    action: 'START_GOLFMON_PRICE_UPDATE',
                    isAdmin: isCurrentUserAdmin(),
                    items: items,
                    filterType: filterType,
                    delayPreset: delayPreset,
                    stepPreset: stepPreset,
                    memo: golfrockMemo,
                    confirmMismatch: confirmMismatch,
                    includeSpecial: includeSpecialInPriceUpdate,
                    specialCourses: Array.isArray(specialTargetCourses) ? [...specialTargetCourses] : []
                }, () => {
                    document.getElementById('btnHeaderStop')?.classList.add('active');
                    showProgressModal(items.length, 'price_update');
                    if (items[0]) {
                        updateProgress(1, items.length, items[0].golf, items[0].date, items[0].time, items[0].fee);
                    }
                });
            });
        } else {
            if (confirm("열려 있는 골프몬(golfmon.net) 탭이 없습니다.\n골프몬 사이트를 새 탭으로 여시겠습니까?")) {
                chrome.tabs.create({ url: "https://golfmon.net/" });
            }
        }
    });
}

// 골프몬 내글 교체수정(같은 날짜 같은 구장의 기존 글을 새 타임/가격/인원으로 통째로 교체) 실행 중복 방지 플래그
let isGolfmonPostReplacing = false;

// 골프몬 내글 교체수정(스마트수정: 변동타임 위주 / 전체수정: 동일타임도 전체수정) 실행 핸들러
function startGolfmonPostReplacement(forceAllEdit = false) {
    if (!checkAuthSecurityGuard('몬')) return;
    if (typeof hasUserFeature === 'function' && !hasUserFeature('수정')) {
        alert("이 기능은 [수정] 권한이 부여된 회원만 이용하실 수 있습니다.\n관리자에게 문의해주세요.");
        return;
    }
    if (isGolfmonPostReplacing) {
        console.warn("[Tee82] 이미 교체수정 명령이 전달 중입니다. 중복 클릭 무시.");
        return;
    }
    isGolfmonPostReplacing = true;
    setTimeout(() => { isGolfmonPostReplacing = false; }, 3000);

    let targetTrs = Array.from(document.querySelectorAll('#dataTable tbody tr.selected'));
    if (targetTrs.length === 0) {
        alert("수정할 티타임이 선택되지 않았습니다.\n목록에서 수정할 타임을 체크하거나 [원클릭]을 먼저 실행해주세요.");
        return;
    }

    targetTrs.forEach((tr, idx) => {
        tr.dataset.regId = `repl_gm_${Date.now()}_${idx}`;
    });

    const golfrockMemo = document.getElementById('golfrockMemo')?.value || document.getElementById('golfmonMemo')?.value || '';
    const golftopMemo = document.getElementById('golftopMemo')?.value || '';

    const items = targetTrs.map(tr => {
        const cells = tr.querySelectorAll('td');
        const origGolf = cells[2]?.textContent.trim() || '';
        const rawGolf = tr.dataset.rawGolf || origGolf;
        const golfmonGolf = tr.dataset.golfmonGolf || getMappedName(rawGolf, 'golfmon').name || origGolf;

        const roomTypeRaw = (tr.dataset.roomType || '').trim();
        const sizenumRaw = (cells[7]?.textContent || '').trim();
        const conditionRaw = (cells[6]?.textContent || '').trim();

        let resolvedRoomType = '조인';
        // 1. TR 자체에 명시된 roomType 최우선 판별
        if (roomTypeRaw === '양도') {
            resolvedRoomType = '양도';
        } else if (roomTypeRaw === '조인' || roomTypeRaw === '선티방' || roomTypeRaw.includes('선티') || roomTypeRaw.includes('대기')) {
            resolvedRoomType = '조인';
        }
        // 2. 단독 매크로 모드 판별
        else if (typeof lastUsedMacroType !== 'undefined' && lastUsedMacroType === 'join') {
            resolvedRoomType = '조인';
        } else if (typeof lastUsedMacroType !== 'undefined' && lastUsedMacroType === 'transfer') {
            resolvedRoomType = '양도';
        }
        // 3. 인원 수 및 기타 조건 판별
        else if (sizenumRaw && /^[123]인$/.test(sizenumRaw)) {
            resolvedRoomType = '조인';
        } else if (conditionRaw && conditionRaw !== '무관') {
            resolvedRoomType = '조인';
        } else if (sizenumRaw === '4인' && roomTypeRaw !== '조인') {
            resolvedRoomType = '양도';
        } else {
            resolvedRoomType = '조인';
        }

        const source = tr.dataset.source || 'golfrock';
        const itemMemo = resolveItemRegistrationMemo(golfmonGolf || rawGolf || origGolf);

        return {
            regId: tr.dataset.regId,
            date: cells[0]?.textContent.trim() || '',
            region: cells[1]?.textContent.trim() || '',
            golf: golfmonGolf,
            rawGolf: rawGolf,
            time: cells[3]?.textContent.trim() || '',
            fee: tr.dataset.totalFee || tr.dataset.baseFee || cells[4]?.textContent.trim().replace(/[^\d.]/g, '') || '',
            cady: cells[5]?.textContent.trim() || '',
            condition: conditionRaw,
            sizenum: sizenumRaw,
            roomType: resolvedRoomType,
            origRoomType: roomTypeRaw,
            isPrepaid: tr.dataset.isPrepaid === 'true',
            isMeal: tr.dataset.isMeal === 'true',
            memo: itemMemo,
            isPriceDropped: tr.dataset.isPriceDropped === 'true',
            prevFee: tr.dataset.prevFee || ''
        };
    });

    const delayPreset = document.getElementById('selRandomDelay')?.value || localStorage.getItem('v2_randomDelayPreset') || 'fast';
    const stepPreset = document.getElementById('selStepDelay')?.value || localStorage.getItem('v2_stepDelayPreset') || 'fast';
    const confirmMismatch = document.getElementById('chkConfirmCourseMismatch')?.checked ?? true;

    // 양도용 원클릭 vs 조인용 원클릭 모드 또는 항목 구성에 따른 구분 필터('양도' or '조인' or '전체')
    const transferCount = items.filter(it => it.roomType === '양도').length;
    const joinCount = items.filter(it => it.roomType === '조인').length;
    let filterType = '조인';
    if (transferCount > 0 && joinCount > 0) {
        filterType = '전체';
    } else if (typeof lastUsedMacroType !== 'undefined' && lastUsedMacroType === 'transfer') {
        filterType = '양도';
    } else if (typeof lastUsedMacroType !== 'undefined' && lastUsedMacroType === 'join') {
        filterType = '조인';
    } else if (transferCount > joinCount) {
        filterType = '양도';
    } else {
        filterType = '조인';
    }

    findBestGolfmonTab((golfmonTab) => {
        if (golfmonTab) {
            let effectiveReplaceItems = items;
            if (includeSpecialInReplaceUpdate === false && Array.isArray(specialTargetCourses) && specialTargetCourses.length > 0) {
                const cleanSpecs = specialTargetCourses.map(s => String(s || '').replace(/[\s\-_()\[\]]/g, '').toLowerCase()).filter(Boolean);
                effectiveReplaceItems = items.filter(it => {
                    const names = [it.golf, it.rawGolf].filter(Boolean).map(n => String(n).replace(/[\s\-_()\[\]]/g, '').toLowerCase());
                    return !names.some(name => cleanSpecs.some(spec => name.includes(spec) || spec.includes(name)));
                });
            }
            startGolfmonMacroSupervision({
                tabId: golfmonTab.id,
                macroType: 'POST_REPLACE',
                forceAllEdit: Boolean(forceAllEdit),
                items: effectiveReplaceItems,
                filterType: filterType,
                delayPreset: delayPreset,
                stepPreset: stepPreset,
                customMemo: golfrockMemo,
                confirmMismatch: confirmMismatch
            });
            chrome.tabs.update(golfmonTab.id, { active: true }, () => {
                sendGolfmonMacroCommand(golfmonTab, {
                    action: 'START_GOLFMON_POST_REPLACEMENT',
                    forceAllEdit: Boolean(forceAllEdit),
                    isAdmin: isCurrentUserAdmin(),
                    items: items,
                    filterType: filterType,
                    delayPreset: delayPreset,
                    stepPreset: stepPreset,
                    memo: golfrockMemo,
                    confirmMismatch: confirmMismatch,
                    includeSpecial: includeSpecialInReplaceUpdate,
                    specialCourses: Array.isArray(specialTargetCourses) ? [...specialTargetCourses] : []
                }, () => {
                    document.getElementById('btnHeaderStop')?.classList.add('active');
                    showProgressModal(items.length, forceAllEdit ? 'post_replace_all' : 'post_replace');
                    if (items[0]) {
                        updateProgress(1, items.length, items[0].golf, items[0].date, items[0].time, items[0].fee);
                    }
                });
            });
        } else {
            if (confirm("열려 있는 골프몬(golfmon.net) 탭이 없습니다.\n골프몬 사이트를 새 탭으로 여시겠습니까?")) {
                chrome.tabs.create({ url: "https://golfmon.net/" });
            }
        }
    });
}

// 골프몬 날짜별 전체리셋 / 선택리셋 중복 방지 플래그 및 자동 주기 반복 제어
let isGolfmonDateResetting = false;
let isGolfmonSelectedResetting = false;
let resetIntervalMinutes = 0;         // 0: 1회 실행, 그 외: 설정된 분 단위 주기
let currentResetCycle = 1;            // 현재 실행 중인 회차 (1, 2, ...)
let isResetRepeatingActive = false;   // 주기 반복 활성 상태
let resetCountdownTimerId = null;     // 카운트다운 인터벌 타이머
let resetNextRunTimestamp = 0;        // 다음 실행 예정 시각 (ms 타임스탬프)
let activeResetMode = 'full';         // 'full' (전체리셋) 또는 'selected' (선택리셋)
let lastSelectedResetItems = [];      // 선택리셋 주기 반복을 위한 대상 티타임 보존

// 전체리셋/선택리셋 주기(분) 반환 (0: 1회, 그 외 분 단위 정수)
function getSelectedResetIntervalMinutes() {
    const checked = document.querySelector('input[name="resetIntervalOption"]:checked');
    if (!checked || checked.value === '0') return 0;
    if (checked.value === 'custom') {
        const customInput = document.getElementById('inputResetCustomMinutes');
        const val = parseInt(customInput?.value, 10);
        return (isNaN(val) || val <= 0) ? 30 : val;
    }
    const n = parseInt(checked.value, 10);
    return isNaN(n) ? 0 : n;
}

// 리셋 주기 라디오 버튼 및 사용자 직접입력 분 인풋 초기화
function initResetIntervalRadios() {
    const savedVal = localStorage.getItem('v2_savedResetInterval') || '0';
    const savedCustomMin = localStorage.getItem('v2_savedResetCustomMinutes') || '30';

    const customInput = document.getElementById('inputResetCustomMinutes');
    if (customInput) {
        customInput.value = savedCustomMin;

        const activateCustomRadio = () => {
            const customRadio = document.querySelector('input[name="resetIntervalOption"][value="custom"]');
            if (customRadio) {
                customRadio.checked = true;
                const minVal = parseInt(customInput.value, 10) || 30;
                resetIntervalMinutes = minVal;
                try {
                    localStorage.setItem('v2_savedResetInterval', 'custom');
                    localStorage.setItem('v2_savedResetCustomMinutes', String(minVal));
                } catch(e) {}
            }
        };

        customInput.addEventListener('focus', activateCustomRadio);
        customInput.addEventListener('input', () => {
            activateCustomRadio();
            const minVal = parseInt(customInput.value, 10);
            if (!isNaN(minVal) && minVal > 0) {
                resetIntervalMinutes = minVal;
                try {
                    localStorage.setItem('v2_savedResetCustomMinutes', String(minVal));
                } catch(e) {}
            }
        });
    }

    const radios = document.querySelectorAll('input[name="resetIntervalOption"]');
    radios.forEach(r => {
        if (r.value === savedVal) {
            r.checked = true;
        }
        r.addEventListener('change', () => {
            if (r.checked) {
                try {
                    localStorage.setItem('v2_savedResetInterval', r.value);
                } catch(e) {}
                const newInterval = getSelectedResetIntervalMinutes();
                resetIntervalMinutes = newInterval;
                if (newInterval === 0 && isResetRepeatingActive) {
                    stopResetIntervalTimer(true);
                }
            }
        });
    });

    // 카운트다운 배너의 [중단] 버튼 클릭 리스너
    document.getElementById('btnStopResetTimer')?.addEventListener('click', (e) => {
        e.stopPropagation();
        e.preventDefault();
        stopResetIntervalTimer(true);
    });
}

// 리셋 카운트다운 배너 UI 갱신
function updateResetTimerBannerUI(remainingSec) {
    const banner = document.getElementById('resetTimerStatusBanner');
    const text = document.getElementById('resetTimerStatusText');
    if (!banner || !text) return;

    if (!isResetRepeatingActive || remainingSec <= 0) {
        banner.style.display = 'none';
        return;
    }

    banner.style.display = 'flex';
    const min = Math.floor(remainingSec / 60);
    const sec = remainingSec % 60;
    const timeStr = min > 0 ? `${min}분 ${sec}초` : `${sec}초`;
    const intervalLabel = resetIntervalMinutes >= 60 && (resetIntervalMinutes % 60 === 0)
        ? `${resetIntervalMinutes / 60}시간`
        : `${resetIntervalMinutes}분`;
    const modeLabel = (activeResetMode === 'selected') ? '선택리셋' : '전체리셋';
    text.innerText = `${modeLabel} 자동 반복 중 (${intervalLabel} 주기, 다음 실행: ${timeStr} 후) [${currentResetCycle}회차 대기]`;
}

// 다음 리셋 실행 스케줄 등록 및 1초 주기 카운트다운 타이머 구동
function scheduleNextResetRun(delayMs, intervalMin) {
    if (resetCountdownTimerId) {
        clearInterval(resetCountdownTimerId);
        resetCountdownTimerId = null;
    }
    resetIntervalMinutes = intervalMin;
    isResetRepeatingActive = true;
    resetNextRunTimestamp = Date.now() + delayMs;

    try {
        localStorage.setItem('v2_resetIntervalMinutes', String(intervalMin));
        localStorage.setItem('v2_resetNextRunTimestamp', String(resetNextRunTimestamp));
        localStorage.setItem('v2_resetIntervalActive', 'true');
        localStorage.setItem('v2_activeResetMode', activeResetMode);
        chrome.storage.local.set({
            v2_resetIntervalMinutes: intervalMin,
            v2_resetNextRunTimestamp: resetNextRunTimestamp,
            v2_resetIntervalActive: true,
            v2_activeResetMode: activeResetMode
        });
    } catch(e) {}

    const tick = () => {
        const remainingMs = resetNextRunTimestamp - Date.now();
        const remainingSec = Math.max(0, Math.ceil(remainingMs / 1000));
        updateResetTimerBannerUI(remainingSec);

        if (remainingSec <= 0) {
            if (resetCountdownTimerId) {
                clearInterval(resetCountdownTimerId);
                resetCountdownTimerId = null;
            }
            if (isResetRepeatingActive) {
                currentResetCycle++;
                if (activeResetMode === 'selected') {
                    startGolfmonSelectedReset(true);
                } else {
                    startGolfmonDateReset(true);
                }
            }
        }
    };

    tick();
    resetCountdownTimerId = setInterval(tick, 1000);
}

// 리셋 자동 주기 반복 중단
function stopResetIntervalTimer(showToastMsg = true) {
    if (resetCountdownTimerId) {
        clearInterval(resetCountdownTimerId);
        resetCountdownTimerId = null;
    }
    isResetRepeatingActive = false;
    resetNextRunTimestamp = 0;
    resetIntervalMinutes = 0;

    try {
        localStorage.removeItem('v2_resetNextRunTimestamp');
        localStorage.setItem('v2_resetIntervalActive', 'false');
        localStorage.setItem('v2_savedResetInterval', '0');
        chrome.storage.local.set({
            v2_resetIntervalActive: false,
            v2_resetNextRunTimestamp: 0
        });
    } catch(e) {}

    const banner = document.getElementById('resetTimerStatusBanner');
    if (banner) banner.style.display = 'none';

    // 라디오 버튼을 '1회'로 변경
    const rZero = document.querySelector('input[name="resetIntervalOption"][value="0"]');
    if (rZero) rZero.checked = true;

    if (showToastMsg) {
        const modeLabel = (activeResetMode === 'selected') ? '선택리셋' : '전체리셋';
        showToast(`${modeLabel} 자동 반복이 중단되었습니다.`);
    }
}

// 팝업 오픈 시 저장된 자동 리셋 스케줄 복원
function restoreActiveResetTimer() {
    try {
        const isActive = localStorage.getItem('v2_resetIntervalActive') === 'true';
        const nextTsRaw = localStorage.getItem('v2_resetNextRunTimestamp');
        const intervalRaw = localStorage.getItem('v2_resetIntervalMinutes');
        activeResetMode = localStorage.getItem('v2_activeResetMode') || 'full';

        if (isActive && nextTsRaw) {
            const nextTs = parseInt(nextTsRaw, 10);
            const intervalMin = parseInt(intervalRaw, 10) || 30;
            const remainingMs = nextTs - Date.now();
            if (remainingMs > 0) {
                scheduleNextResetRun(remainingMs, intervalMin);
            } else if (remainingMs > -600000) { // 10분 이내 경과 시 즉시 실행
                if (activeResetMode === 'selected') {
                    startGolfmonSelectedReset(true);
                } else {
                    startGolfmonDateReset(true);
                }
            } else {
                stopResetIntervalTimer(false);
            }
        }
    } catch(e) {}
}

function recordLastBumpTime() {
    try {
        const now = Date.now();
        localStorage.setItem('v2_lastResetTimestamp', now.toString());
        chrome.storage.local.set({ v2_lastResetTimestamp: now });
    } catch(e) {}
}

// 현재 목록에서 체크(선택)된 티타임 데이터 배열 추출 헬퍼
function getSelectedTeeTimeItems() {
    let targetTrs = Array.from(document.querySelectorAll('#dataTable tbody tr.selected'));
    if (targetTrs.length === 0) {
        const selectedCards = Array.from(document.querySelectorAll('.tee-card.selected, .tee-card input[type="checkbox"]:checked'));
        if (selectedCards.length > 0) {
            const allTrs = Array.from(document.querySelectorAll('#dataTable tbody tr'));
            const matchedTrs = [];
            selectedCards.forEach(c => {
                const cardEl = c.closest('.tee-card') || c;
                const idx = parseInt(cardEl.dataset.index, 10);
                if (!isNaN(idx) && allTrs[idx]) matchedTrs.push(allTrs[idx]);
            });
            if (matchedTrs.length > 0) targetTrs = matchedTrs;
        }
    }

    if (targetTrs.length === 0) return [];

    targetTrs.forEach((tr, idx) => {
        if (!tr.dataset.regId) {
            tr.dataset.regId = `sel_reset_${Date.now()}_${idx}`;
        }
    });

    return targetTrs.map(tr => {
        const cells = tr.querySelectorAll('td');
        const origGolf = cells[2]?.textContent?.trim() || '';
        const rawGolf = tr.dataset.rawGolf || origGolf;
        const golfmonGolf = tr.dataset.golfmonGolf || getMappedName(rawGolf, 'golfmon').name || origGolf;

        const roomTypeRaw = (tr.dataset.roomType || '').trim();
        const sizenumRaw = (cells[7]?.textContent || '').trim();
        const conditionRaw = (cells[6]?.textContent || '').trim();

        let resolvedRoomType = '조인';
        if (roomTypeRaw === '양도') {
            resolvedRoomType = '양도';
        } else if (roomTypeRaw === '조인' || roomTypeRaw === '선티방' || roomTypeRaw.includes('선티') || roomTypeRaw.includes('대기')) {
            resolvedRoomType = '조인';
        } else if (sizenumRaw === '4인' && roomTypeRaw !== '조인') {
            resolvedRoomType = '양도';
        }

        return {
            regId: tr.dataset.regId,
            date: cells[0]?.textContent?.trim() || '',
            region: cells[1]?.textContent?.trim() || '',
            golf: golfmonGolf,
            rawGolf: rawGolf,
            time: cells[3]?.textContent?.trim() || '',
            fee: tr.dataset.totalFee || tr.dataset.baseFee || cells[4]?.textContent?.trim().replace(/[^\d.]/g, '') || '',
            cady: cells[5]?.textContent?.trim() || '',
            condition: conditionRaw,
            sizenum: sizenumRaw,
            roomType: resolvedRoomType,
            origRoomType: roomTypeRaw,
            isPrepaid: tr.dataset.isPrepaid === 'true',
            isMeal: tr.dataset.isMeal === 'true'
        };
    });
}

// 골프몬 선택리셋 핸들러 (목록에서 체크된 타임만 골프몬에서 찾아 내용 변경 없이 수정완료/끌올)
function startGolfmonSelectedReset(isSubsequentCycle = false) {
    if (!checkAuthSecurityGuard('몬')) return;
    if (isGolfmonSelectedResetting) {
        console.warn("[Tee82] 이미 선택리셋 명령이 전달 중입니다. 중복 클릭 무시.");
        return;
    }

    activeResetMode = 'selected';
    try {
        localStorage.setItem('v2_activeResetMode', 'selected');
    } catch(e) {}

    let items = getSelectedTeeTimeItems();
    if (!items || items.length === 0) {
        if (isSubsequentCycle && lastSelectedResetItems && lastSelectedResetItems.length > 0) {
            items = lastSelectedResetItems;
        } else {
            alert("리셋할 티타임을 먼저 목록에서 체크(선택)해주세요.");
            return;
        }
    }

    lastSelectedResetItems = items.slice();

    const intervalMinutes = getSelectedResetIntervalMinutes();

    if (!isSubsequentCycle) {
        currentResetCycle = 1;
        if (intervalMinutes > 0) {
            resetIntervalMinutes = intervalMinutes;
            isResetRepeatingActive = true;
        } else {
            stopResetIntervalTimer(false);
        }
    }

    const delayPreset = document.getElementById('selRandomDelay')?.value || localStorage.getItem('v2_randomDelayPreset') || 'fast';
    const stepPreset = document.getElementById('selStepDelay')?.value || localStorage.getItem('v2_stepDelayPreset') || 'fast';

    isGolfmonSelectedResetting = true;
    setTimeout(() => { isGolfmonSelectedResetting = false; }, 3000);

    const intervalLabel = resetIntervalMinutes >= 60 && (resetIntervalMinutes % 60 === 0)
        ? `${resetIntervalMinutes / 60}시간`
        : `${resetIntervalMinutes}분`;
    const cycleLabel = (isResetRepeatingActive && resetIntervalMinutes > 0)
        ? ` (${currentResetCycle}회차 - ${intervalLabel} 주기)`
        : '';

    findBestGolfmonTab((golfmonTab) => {
        if (golfmonTab) {
            clearGolfmonMacroSupervision();
            chrome.tabs.update(golfmonTab.id, { active: true }, () => {
                const payload = {
                    action: 'START_GOLFMON_SELECTED_RESET',
                    isAdmin: isCurrentUserAdmin(),
                    items: items,
                    delayPreset: delayPreset,
                    stepPreset: stepPreset,
                    repeatCycle: currentResetCycle,
                    totalRepeat: (isResetRepeatingActive && resetIntervalMinutes > 0 ? `${intervalLabel} 주기` : 1),
                    cycleLabel: cycleLabel
                };
                sendGolfmonMacroCommand(golfmonTab, payload, () => {
                    document.getElementById('btnHeaderStop')?.classList.add('active');
                    showProgressModal(items.length, 'selected_reset', cycleLabel);
                });
            });
        } else {
            if (confirm("열려 있는 골프몬(golfmon.net) 탭이 없습니다.\n골프몬 사이트를 새 탭으로 여시겠습니까?")) {
                chrome.tabs.create({ url: "https://golfmon.net/" });
            }
        }
    });
}

// 골프몬 날짜별(기간별) 전체리셋 핸들러 (사용자 지정 분 주기 또는 1회 반복 지원)
function startGolfmonDateReset(isSubsequentCycle = false) {
    if (!checkAuthSecurityGuard('몬')) return;
    if (isGolfmonDateResetting) {
        console.warn("[Tee82] 이미 전체리셋 명령이 전달 중입니다. 중복 클릭 무시.");
        return;
    }

    activeResetMode = 'full';
    try {
        localStorage.setItem('v2_activeResetMode', 'full');
    } catch(e) {}

    const intervalMinutes = getSelectedResetIntervalMinutes();

    // 신규 수동 클릭 시 반복 상태 초기화 또는 설정
    if (!isSubsequentCycle) {
        currentResetCycle = 1;
        if (intervalMinutes > 0) {
            resetIntervalMinutes = intervalMinutes;
            isResetRepeatingActive = true;
        } else {
            stopResetIntervalTimer(false);
        }
    }

    const dateInput = document.getElementById('inputResetTargetDate');
    const endDateInput = document.getElementById('inputResetEndDate');

    let rawStartVal = (dateInput?.value || '').trim();
    let rawEndVal = (endDateInput?.value || rawStartVal).trim();
    let filterType = document.getElementById('selResetFilterType')?.value || '전체';

    if (!rawStartVal) {
        alert("전체리셋을 시작할 날짜를 먼저 선택해주세요.");
        dateInput?.focus();
        return;
    }
    if (!rawEndVal) {
        rawEndVal = rawStartVal;
        if (endDateInput) endDateInput.value = rawStartVal;
    }

    // 시작 날짜 ~ 종료 날짜 사이의 모든 날짜(MM.DD) 배열 생성
    let startStr = rawStartVal;
    let endStr = rawEndVal;
    if (startStr > endStr) {
        const tmp = startStr;
        startStr = endStr;
        endStr = tmp;
    }

    const formatToMmDd = (ymd) => {
        const m = ymd.match(/(\d{4})-(\d{1,2})-(\d{1,2})/);
        if (m) return `${parseInt(m[2], 10)}.${parseInt(m[3], 10)}`;
        return ymd;
    };

    const targetDates = [];
    const sMatch = startStr.match(/(\d{4})-(\d{1,2})-(\d{1,2})/);
    const eMatch = endStr.match(/(\d{4})-(\d{1,2})-(\d{1,2})/);

    if (sMatch && eMatch) {
        const curDate = new Date(parseInt(sMatch[1], 10), parseInt(sMatch[2], 10) - 1, parseInt(sMatch[3], 10));
        const lastDate = new Date(parseInt(eMatch[1], 10), parseInt(eMatch[2], 10) - 1, parseInt(eMatch[3], 10));
        let safety = 0;
        while (curDate <= lastDate && safety < 35) {
            const mm = curDate.getMonth() + 1;
            const dd = curDate.getDate();
            targetDates.push(`${mm}.${dd}`);
            curDate.setDate(curDate.getDate() + 1);
            safety++;
        }
    }
    if (targetDates.length === 0) {
        targetDates.push(formatToMmDd(startStr));
    }

    const formattedDate = targetDates.length > 1
        ? `${targetDates[0]}~${targetDates[targetDates.length - 1]}`
        : targetDates[0];

    const delayPreset = document.getElementById('selRandomDelay')?.value || localStorage.getItem('v2_randomDelayPreset') || 'fast';
    const stepPreset = document.getElementById('selStepDelay')?.value || localStorage.getItem('v2_stepDelayPreset') || 'fast';

    isGolfmonDateResetting = true;
    setTimeout(() => { isGolfmonDateResetting = false; }, 3000);

    try {
        localStorage.setItem('v2_savedResetTargetDate', startStr);
        localStorage.setItem('v2_savedResetEndDate', endStr);
        localStorage.setItem('v2_savedResetFilterType', filterType);
    } catch(e) {}

    const intervalLabel = resetIntervalMinutes >= 60 ? `${resetIntervalMinutes / 60}시간` : `${resetIntervalMinutes}분`;
    const cycleLabel = (isResetRepeatingActive && resetIntervalMinutes > 0)
        ? ` (${currentResetCycle}회차 - ${intervalLabel} 주기)`
        : '';

    findBestGolfmonTab((golfmonTab) => {
        if (golfmonTab) {
            clearGolfmonMacroSupervision();
            chrome.tabs.update(golfmonTab.id, { active: true }, () => {
                const payload = {
                    action: 'START_GOLFMON_DATE_RESET',
                    isAdmin: isCurrentUserAdmin(),
                    targetDate: formattedDate,
                    targetDates: targetDates,
                    rawDate: startStr,
                    rawEndDate: endStr,
                    filterType: filterType,
                    delayPreset: delayPreset,
                    stepPreset: stepPreset,
                    repeatCycle: currentResetCycle,
                    totalRepeat: (isResetRepeatingActive && resetIntervalMinutes > 0 ? `${intervalLabel} 주기` : 1),
                    cycleLabel: cycleLabel
                };
                sendGolfmonMacroCommand(golfmonTab, payload, () => {
                    document.getElementById('btnHeaderStop')?.classList.add('active');
                    showProgressModal(0, 'date_reset', cycleLabel);
                });
            });
        } else {
            if (confirm("열려 있는 골프몬(golfmon.net) 탭이 없습니다.\n골프몬 사이트를 새 탭으로 여시겠습니까?")) {
                chrome.tabs.create({ url: "https://golfmon.net/" });
            }
        }
    });
}

let unmappedModalCallback = null;

function showUnmappedCourseModal(unmappedCourses, callback) {
    const modal = document.getElementById('unmappedCourseModal');
    const container = document.getElementById('unmappedListContainer');
    if (!modal || !container) {
        callback(false);
        return;
    }

    unmappedModalCallback = callback;
    container.innerHTML = '';

    const validUnmapped = (unmappedCourses || []).filter(rawName => rawName && !isJunkDictKey(rawName));
    if (validUnmapped.length === 0) {
        callback(false);
        return;
    }

    validUnmapped.forEach(rawName => {
        const suggestedReg = getRegion('', rawName);
        const mapObj = getMappedName(rawName);
        const defGolfmon = mapObj.golfmon || rawName;
        const defGolfpang = mapObj.golfpang || rawName;
        const defGolmarket = mapObj.golmarket || getGolmarketGolfName(rawName) || rawName;
        const defGolfrock = mapObj.golfrock || rawName;
        const defGolfland = mapObj.golfland || rawName;
        const isGolflandOpen = true;
        const golflandFieldHtml = isGolflandOpen ? `
                    <div class="unmapped-field lab-golfland-field">
                        <label>골프랜드</label>
                        <input type="text" class="unmapped-gld-input" placeholder="골프랜드 구장명" value="${defGolfland}">
                    </div>
        ` : '';

        const itemRow = document.createElement('div');
        itemRow.className = 'unmapped-item-row';
        itemRow.dataset.raw = rawName;

        itemRow.innerHTML = `
            <div class="unmapped-item-top">
                <span class="unmapped-item-badge">미등록</span>
                <span class="unmapped-item-raw">${rawName}</span>
            </div>
            <div class="unmapped-item-fields" style="display: flex; flex-direction: column; gap: 6px;">
                <div style="display: flex; gap: 6px;">
                    <div class="unmapped-field" style="width: 120px;">
                        <label>지역</label>
                        <input type="text" class="unmapped-reg-input" list="regionSuggestions" placeholder="예: 경기북부" value="${suggestedReg}">
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 5px;">
                    <div class="unmapped-field">
                        <label>골프몬</label>
                        <input type="text" class="unmapped-gm-input" placeholder="골프몬 구장명" value="${defGolfmon}">
                    </div>
                    <div class="unmapped-field">
                        <label>골팡</label>
                        <input type="text" class="unmapped-gp-input" placeholder="골팡 구장명" value="${defGolfpang}">
                    </div>
                    <div class="unmapped-field">
                        <label>골마켓</label>
                        <input type="text" class="unmapped-gmk-input" placeholder="골마켓 구장명" value="${defGolmarket}">
                    </div>
                    <div class="unmapped-field">
                        <label>골프락</label>
                        <input type="text" class="unmapped-grk-input" placeholder="골프락 구장명" value="${defGolfrock}">
                    </div>
                    ${golflandFieldHtml}
                </div>
            </div>
        `;
        container.appendChild(itemRow);
    });

    modal.style.display = 'flex';
}

function closeUnmappedModal(registered) {
    const modal = document.getElementById('unmappedCourseModal');
    if (modal) modal.style.display = 'none';
    if (typeof unmappedModalCallback === 'function') {
        const cb = unmappedModalCallback;
        unmappedModalCallback = null;
        cb(registered);
    }
}

// 원클릭 매크로 (미등록 구장 자동 감지 및 등록 창 연동)
function runMacro(type) {
    try {
        if (type === 'special4' && (!specialTargetCourses || specialTargetCourses.length === 0)) {
            showToast('지정된 특정구장이 없습니다. [특정구장 변환] 우측의 설정 버튼을 눌러 구장을 설정해주세요.');
            return;
        }
        const existingTransferRows = document.querySelectorAll('#dataTable tbody tr[data-room-type="양도"]');
        const isTransferSpecial = (type === 'special4' && (lastUsedMacroType === 'transfer' || existingTransferRows.length > 0));
        const effectiveMacroType = (type === 'special4') ? (isTransferSpecial ? 'transfer' : 'join') : type;
        lastUsedMacroType = effectiveMacroType;
        try { localStorage.setItem('v2_lastUsedMacroType', effectiveMacroType); } catch(e) {}

        const parsed = parseInputData(type);

        if (!parsed || !parsed.rowDataList || parsed.rowDataList.length === 0) {
            if (type === 'special4') {
                showToast(`입력된 데이터에 지정된 특정구장(${specialTargetCourses.join(', ')}) 티타임이 없습니다.`);
            } else {
                showToast('변환할 수 있는 유효한 티타임 데이터가 없습니다.');
            }
            // ★ 중요: 기존 목록이 이미 존재하는 경우 절대 기존 목록을 초기화(삭제)하지 않고 보존!
            const tbody = document.getElementById('tableBody');
            const hasExisting = tbody && tbody.querySelectorAll('tr').length > 0;
            if (!hasExisting) {
                applyParsedData(parsed || { rowDataList: [], unmappedCourses: [] }, type);
            }
            return;
        }

        // 구장명이 누락된 데이터 안내 (예: "11/15 18:46 10만" 구장명 없이 시간/금액만 입력한 경우)
        const allMissingCourse = parsed.rowDataList.every(r => !r.rawGolf && (!r.golf || r.golf === '(구장명 없음)'));
        if (allMissingCourse) {
            showToast('구장명이 포함되어 있지 않습니다. 구장명을 함께 입력해주세요 (예: 남양주 11/01 13:30 18만[현장17+선입1만])');
            // 구장명이 아예 없으면 기존 목록을 보호하고 추가 작업을 중단!
            return;
        }

        if (parsed.unmappedCourses && parsed.unmappedCourses.length > 0) {
            // 미등록 구장 발견 -> 자동으로 등록 모달 표시
            showUnmappedCourseModal(parsed.unmappedCourses, (didRegister) => {
                try {
                    if (didRegister) {
                        // 사전에 등록했으므로 갱신된 사전으로 재파싱
                        const reParsed = parseInputData(type);
                        const didPrepend = applyParsedData(reParsed, type);
                        if (!didPrepend) autoSelectTwo();
                    } else {
                        // 등록 안 함 -> 변환은 하되, 미등록 구장은 자동 선택에서 제외
                        const didPrepend = applyParsedData(parsed, type);
                        if (!didPrepend) autoSelectTwo();
                        showToast(`총 ${parsed.rowDataList.length}건 변환 완료 (미등록 구장 ${parsed.unmappedCourses.length}개는 선택 제외됨)`);
                    }
                } catch (cbErr) {
                    console.warn('runMacro modal callback error:', cbErr);
                }
            });
        } else {
            // 미등록 구장 없음 -> 바로 변환 (스마트 상단 우선배치 시에는 기존 및 신규 선택 체크 100% 보존을 위해 autoSelectTwo 생략!)
            const didPrepend = applyParsedData(parsed, type);
            if (!didPrepend) autoSelectTwo();
        }
    } catch (err) {
        console.error('runMacro error:', err);
        showToast('매크로 실행 중 오류가 발생했습니다: ' + err.message);
    }
}

// 텍스트 복사
function copySelected() {
    const selectedTrs = Array.from(document.querySelectorAll('#dataTable tbody tr.selected'));
    if (selectedTrs.length === 0) {
        alert("선택된 항목이 없습니다.");
        return;
    }
    const lines = selectedTrs.map(tr => Array.from(tr.cells).map(td => td.textContent).join('\t'));
    navigator.clipboard.writeText(lines.join('\n')).then(() => {
        showToast(`선택된 ${selectedTrs.length}건이 클립보드에 복사되었습니다.`);
    });
}

// 등록 완료된 단일 항목 체크 해제
function uncheckItem(regId, itemInfo = null) {
    let tr = null;
    if (regId) {
        tr = document.querySelector(`#dataTable tbody tr[data-reg-id="${regId}"]`);
    }
    if (!tr && itemInfo) {
        const trs = Array.from(document.querySelectorAll('#dataTable tbody tr.selected'));
        tr = trs.find(r => {
            const cells = r.querySelectorAll('td');
            return cells[0]?.textContent.trim() === itemInfo.date &&
                   cells[2]?.textContent.trim() === itemInfo.golf &&
                   cells[3]?.textContent.trim() === itemInfo.time;
        });
    }
    if (tr && tr.classList.contains('selected')) {
        tr.classList.remove('selected');
        syncCardsSelection();
        updateSelectedBadge();
        saveCurrentTableState();
    }
}

// 활성 멀티 플랫폼 트래커
let activeConcurrentPlatforms = new Set();

// 스토리지에 기록된 등록 완료 항목 전체 체크 해제
function checkAndUncheckCompletedFromStorage() {
    try {
        chrome.storage.local.get(['completedItems'], (res) => {
            if (res && res.completedItems && Array.isArray(res.completedItems)) {
                res.completedItems.forEach(item => {
                    uncheckItem(item.regId, item);
                });
            }
        });
    } catch(e) {}
}

// 즉시중단 공통 처리 함수 (헤더 버튼 및 모달 [즉시중단] 버튼에서 호출)
function stopRegistration() {
    stopResetIntervalTimer(false);
    clearGolfmonMacroSupervision();
    activeConcurrentPlatforms.clear();
    isGolfmonPostReplacing = false;
    isGolfmonDateResetting = false;

    try {
        chrome.storage.local.set({
            isRegistrationRunning: false,
            golfmon_isRegistrationRunning: false,
            golftop_isRegistrationRunning: false,
            golmarket_isRegistrationRunning: false,
            golfrock_isRegistrationRunning: false,
            golfland_isRegistrationRunning: false
        });
    } catch(e) {}

    // 0. 모든 열려 있는 탭에 즉시 중단 메시지 전송 및 스크립트 강제 정지 주입
    try {
        const hudSelector = '#gm_hud_status_panel, #gm_status_panel_wrap, #grk_status_panel_wrap, #gld_status_panel_wrap, #gtp_status_panel';
        chrome.tabs.query({}, (tabs) => {
            if (tabs && tabs.length > 0) {
                tabs.forEach(tab => {
                    try { chrome.tabs.sendMessage(tab.id, { action: 'STOP_REGISTRATION' }); } catch(e) {}
                    try { chrome.tabs.sendMessage(tab.id, { action: 'STOP_GOLFMON_REGISTRATION' }); } catch(e) {}
                    try { chrome.tabs.sendMessage(tab.id, { action: 'STOP_GOLFTOP_REGISTRATION' }); } catch(e) {}

                    try {
                        chrome.scripting.executeScript({
                            target: { tabId: tab.id },
                            func: (sel) => {
                                try {
                                    if (typeof stopAllGolfmonMacros === 'function') stopAllGolfmonMacros();
                                    if (typeof shouldStopRegistration !== 'undefined') shouldStopRegistration = true;
                                    if (typeof isRegistrationRunning !== 'undefined') isRegistrationRunning = false;
                                    if (typeof _priceUpdateRunning !== 'undefined') _priceUpdateRunning = false;
                                    if (typeof isPostReplacementRunning !== 'undefined') isPostReplacementRunning = false;
                                    if (typeof isDateResetRunning !== 'undefined') isDateResetRunning = false;
                                    window.shouldStopRegistration = true;
                                } catch(e) {}
                                try {
                                    document.querySelectorAll(sel).forEach(el => el.remove());
                                } catch(e) {}
                            },
                            args: [hudSelector]
                        });
                    } catch(e) {}
                });
            }
        });
    } catch(e) {}

    // UI 즉시 초기화
    const overlay = document.getElementById('progressOverlay');
    if (overlay) overlay.style.display = 'none';
    clearActiveProgressHighlight();

    // 전체리셋 반복 타이머 및 모드 즉각 취소
    isResetRepeatingActive = false;
    if (resetRepeatTimer) {
        clearTimeout(resetRepeatTimer);
        resetRepeatTimer = null;
    }

    document.getElementById('btnHeaderStop')?.classList.remove('active');

    // Storage 상태 즉각 강제 삭제 (새로고침/페이지 이동 후 자동 재개 원천 차단)
    try {
        chrome.storage.local.set({
            golfmon_stop_requested_at: Date.now(),
            active_batch_task: null,
            golmarket_task: null,
            golfrock_task: null,
            golfland_task: null,
            golftop_task: null,
            isRegistrationRunning: false
        });
        chrome.storage.local.remove(['active_batch_task', 'golmarket_task', 'golfrock_task', 'golfland_task', 'golftop_task']);
    } catch(e) {}

    // 내부 이벤트 리스너에도 즉각 STOP 전파
    try {
        chrome.runtime.sendMessage({ type: 'REGISTER_STOPPED' });
    } catch(e) {}

    checkAndUncheckCompletedFromStorage();
    showToast('즉시중단 되었습니다.');
}

// 골프몬에 등록 실행
function startGolfmonRegistration(isFromMulti = false) {
    if (!checkAuthSecurityGuard('몬')) return;
    const selectedTrs = Array.from(document.querySelectorAll('#dataTable tbody tr.selected'));
    if (selectedTrs.length === 0) {
        alert("골프몬에 등록할 항목이 선택되지 않았습니다.\n목록에서 카드를 클릭하거나 [원클릭]을 먼저 실행해주세요.");
        return;
    }

    // 각 선택된 항목에 고유 등록 ID 부여
    selectedTrs.forEach((tr, idx) => {
        tr.dataset.regId = `reg_${Date.now()}_${idx}`;
    });

    const golfrockMemo = document.getElementById('golfrockMemo')?.value || document.getElementById('golfmonMemo')?.value || '';
    const golftopMemo = document.getElementById('golftopMemo')?.value || '';

    const items = selectedTrs.map(tr => {
        const cells = tr.querySelectorAll('td');
        const origGolf = cells[2].textContent.trim();
        const rawGolf = tr.dataset.rawGolf || origGolf;
        const golfmonGolf = tr.dataset.golfmonGolf || getMappedName(rawGolf, 'golfmon').name || origGolf;
        const source = tr.dataset.source || 'golfrock';
        const itemMemo = resolveItemRegistrationMemo(golfmonGolf || rawGolf || origGolf);
        return {
            regId: tr.dataset.regId,
            date: cells[0].textContent.trim(),
            region: cells[1].textContent.trim(),
            golf: golfmonGolf,
            rawGolf: rawGolf,
            time: cells[3].textContent.trim(),
            fee: tr.dataset.totalFee || tr.dataset.baseFee || extractPureFeeMan(cells[4].textContent.trim()),
            fieldFee: tr.dataset.fieldFee || '',
            prepaidFee: tr.dataset.prepaidFee || '',
            cady: cells[5].textContent.trim(),
            condition: cells[6].textContent.trim(),
            sizenum: cells[7].textContent.trim(),
            roomType: tr.dataset.roomType || '',
            isPrepaid: tr.dataset.isPrepaid === 'true',
            isMeal: tr.dataset.isMeal === 'true',
            source: source,
            memo: itemMemo
        };
    });

    activeConcurrentPlatforms.add('golfmon');
    try {
        const updateData = {
            golfmon_isRegistrationRunning: true,
            isRegistrationRunning: true
        };
        if (!isFromMulti) {
            updateData.completedItems = [];
        }
        chrome.storage.local.set(updateData);
    } catch(e) {}

    const memo = golfrockMemo;
    // 조인용 원클릭 vs 양도용 원클릭 vs 한번에 원클릭(혼합) 모드 판별
    const hasTransfer = items.some(it => it.roomType === '양도');
    const hasJoin = items.some(it => it.roomType !== '양도');
    const isTransferMode = (hasTransfer && !hasJoin) || (!hasTransfer && !hasJoin && lastUsedMacroType === 'transfer');
    const mode = (hasTransfer && hasJoin) ? 'both' : (isTransferMode ? 'transfer' : 'join');
    const delayPreset = document.getElementById('selRandomDelay')?.value || localStorage.getItem('v2_randomDelayPreset') || 'fast';
    const stepPreset = document.getElementById('selStepDelay')?.value || localStorage.getItem('v2_stepDelayPreset') || 'fast';

    findBestGolfmonTab((golfmonTab) => {
        if (golfmonTab) {
            startGolfmonMacroSupervision({
                tabId: golfmonTab.id,
                macroType: 'REGISTRATION',
                items: items,
                mode: mode,
                delayPreset: delayPreset,
                stepPreset: stepPreset,
                customMemo: memo
            });
            chrome.tabs.update(golfmonTab.id, { active: true }, () => {
                sendGolfmonMacroCommand(golfmonTab, {
                    action: 'START_REGISTRATION',
                    items: items,
                    memo: memo,
                    mode: mode,
                    delayPreset: delayPreset,
                    stepPreset: stepPreset,
                    isAdmin: isCurrentUserAdmin()
                }, () => {
                    document.getElementById('btnHeaderStop')?.classList.add('active');
                    showProgressModal(items.length, mode);
                });
            });
        } else {
            if (confirm("열려 있는 골프몬(golfmon.net) 탭이 없습니다.\n골프몬 사이트를 새 탭으로 여시겠습니까?")) {
                chrome.tabs.create({ url: "https://golfmon.net/" });
            }
        }
    });
}

// 골마켓에 등록 실행
function startGolfmarketRegistration(isFromMulti = false) {
    if (!checkAuthSecurityGuard('마켓')) return;
    const selectedTrs = Array.from(document.querySelectorAll('#dataTable tbody tr.selected'));
    if (selectedTrs.length === 0) {
        alert("골마켓에 등록할 항목이 선택되지 않았습니다.\n목록에서 카드를 클릭하거나 [원클릭]을 먼저 실행해주세요.");
        return;
    }

    // 각 선택된 항목에 고유 등록 ID 부여
    selectedTrs.forEach((tr, idx) => {
        tr.dataset.regId = `reg_gm_${Date.now()}_${idx}`;
    });

    const golfrockMemo = document.getElementById('golfrockMemo')?.value || document.getElementById('golfmonMemo')?.value || '';
    const golftopMemo = document.getElementById('golftopMemo')?.value || '';

    const items = selectedTrs.map(tr => {
        const cells = tr.querySelectorAll('td');
        const origGolf = cells[2].textContent.trim();
        const rawGolf = tr.dataset.rawGolf || origGolf;
        const golmarketGolf = tr.dataset.golmarketGolf || getMappedName(rawGolf, 'golmarket').name || getGolmarketGolfName(origGolf) || origGolf;
        const source = tr.dataset.source || 'golfrock';
        const itemMemo = resolveItemRegistrationMemo(golmarketGolf || rawGolf || origGolf);
        return {
            regId: tr.dataset.regId,
            date: cells[0].textContent.trim(),
            region: cells[1].textContent.trim(),
            golf: golmarketGolf,
            rawGolf: rawGolf,
            time: cells[3].textContent.trim(),
            fee: tr.dataset.totalFee || tr.dataset.baseFee || extractPureFeeMan(cells[4].textContent.trim()),
            fieldFee: tr.dataset.fieldFee || '',
            prepaidFee: tr.dataset.prepaidFee || '',
            cady: cells[5].textContent.trim(),
            condition: cells[6].textContent.trim(),
            sizenum: cells[7].textContent.trim(),
            roomType: tr.dataset.roomType || '',
            isPrepaid: tr.dataset.isPrepaid === 'true',
            isMeal: tr.dataset.isMeal === 'true',
            source: source,
            memo: itemMemo
        };
    });

    const memo = golfrockMemo;
    const delayPreset = document.getElementById('selRandomDelay')?.value || localStorage.getItem('v2_randomDelayPreset') || 'fast';
    const stepPreset = document.getElementById('selStepDelay')?.value || localStorage.getItem('v2_stepDelayPreset') || 'fast';

    // 조인용 원클릭 vs 양도용 원클릭 vs 한번에 원클릭(혼합) 모드 판별
    const hasTransfer = items.some(it => it.roomType === '양도');
    const hasJoin = items.some(it => it.roomType !== '양도');
    const isFirstTransfer = Boolean(items[0] && items[0].roomType === '양도');
    const isTransferMode = (hasTransfer && !hasJoin) || (!hasTransfer && !hasJoin && lastUsedMacroType === 'transfer');
    const mode = (hasTransfer && hasJoin) ? 'both' : (isTransferMode ? 'transfer' : 'join');

    const task = {
        isRunning: true,
        isAdmin: isCurrentUserAdmin(),
        platform: 'golmarket',
        mode: mode,
        isTransferMode: isFirstTransfer,
        items: items,
        currentIndex: 0,
        totalCount: items.length,
        memo: memo,
        delayPreset: delayPreset,
        stepPreset: stepPreset,
        status: 'pending',
        startedAt: Date.now()
    };

    activeConcurrentPlatforms.add('golmarket');
    try {
        const updateData = {
            golmarket_task: task,
            golmarket_isRegistrationRunning: true,
            isRegistrationRunning: true
        };
        if (!isFromMulti) {
            updateData.completedItems = [];
        }
        chrome.storage.local.set(updateData);
    } catch(e) {}

    // 즉각 진행상황 모달 표시 및 헤더 중단 버튼 활성화 (화면에 즉시 팝업 표시)
    document.getElementById('btnHeaderStop')?.classList.add('active');
    showProgressModal(items.length, isFirstTransfer ? 'golmarket_transfer' : 'golmarket');
    if (items[0]) {
        updateProgress(1, items.length, items[0].golf, items[0].date, items[0].time);
    }

    // 골마켓 탭 탐색 및 실행
    chrome.tabs.query({ url: ["*://*.golmarket.co.kr/*", "https://golmarket.co.kr/*", "http://golmarket.co.kr/*"] }, (tabs) => {
        if (tabs && tabs.length > 0) {
            const golmarketTab = tabs[0];
            chrome.tabs.update(golmarketTab.id, { active: true }, () => {
                const currentTabUrl = golmarketTab.url || '';

                if (isFirstTransfer) {
                    // 양도(부킹) 모드:
                    // 현재 탭이 이미 booking_form.php 에 있다면 바로 시작 메시지 전송
                    if (currentTabUrl.includes('booking_form.php')) {
                        chrome.tabs.sendMessage(golmarketTab.id, {
                            action: 'START_GOLMARKET_REGISTRATION',
                            isAdmin: isCurrentUserAdmin(),
                            items: items,
                            memo: memo,
                            mode: 'transfer',
                            isTransferMode: true,
                            delayPreset: delayPreset,
                            stepPreset: stepPreset
                        }, () => {
                            document.getElementById('btnHeaderStop')?.classList.add('active');
                            showProgressModal(items.length, 'golmarket_transfer');
                        });
                    } else {
                        // 부킹등록 작성 페이지(booking_form.php)로 직접 페이지 이동 (이동 후 content_script가 큐를 감지하여 자동 시작)
                        chrome.tabs.update(golmarketTab.id, { url: "https://golmarket.co.kr/booking_form.php" }, () => {
                            document.getElementById('btnHeaderStop')?.classList.add('active');
                            showProgressModal(items.length, 'golmarket_transfer');
                        });
                    }
                } else {
                    // 조인 모드:
                    if (currentTabUrl.includes('join_form.php')) {
                        chrome.tabs.sendMessage(golmarketTab.id, {
                            action: 'START_GOLMARKET_REGISTRATION',
                            isAdmin: isCurrentUserAdmin(),
                            items: items,
                            memo: memo,
                            mode: 'join',
                            isTransferMode: false,
                            delayPreset: delayPreset,
                            stepPreset: stepPreset
                        }, () => {
                            document.getElementById('btnHeaderStop')?.classList.add('active');
                            showProgressModal(items.length, 'golmarket');
                        });
                    } else {
                        // 조인 등록 폼으로 페이지 이동 (이동 후 content_script가 큐를 감지하여 자동 시작)
                        chrome.tabs.update(golmarketTab.id, { url: "https://www.golmarket.co.kr/join_form.php" }, () => {
                            document.getElementById('btnHeaderStop')?.classList.add('active');
                            showProgressModal(items.length, 'golmarket');
                        });
                    }
                }
            });
        } else {
            // 골마켓 탭이 열려있지 않은 경우
            if (isFirstTransfer) {
                // 양도(부킹) 모드: booking_form.php 로 직접 새 탭 열기
                chrome.tabs.create({ url: "https://golmarket.co.kr/booking_form.php" }, () => {
                    document.getElementById('btnHeaderStop')?.classList.add('active');
                    showProgressModal(items.length, 'golmarket_transfer');
                });
            } else {
                // 조인 모드: join_form.php 로 새 탭 열기
                chrome.tabs.create({ url: "https://www.golmarket.co.kr/join_form.php" }, () => {
                    document.getElementById('btnHeaderStop')?.classList.add('active');
                    showProgressModal(items.length, 'golmarket');
                });
            }
        }
    });
}

// 골프락에 등록 실행
function startGolfrockRegistration(isFromMulti = false) {
    if (!checkAuthSecurityGuard('락')) return;
    const selectedTrs = Array.from(document.querySelectorAll('#dataTable tbody tr.selected'));
    if (selectedTrs.length === 0) {
        alert("골프락에 등록할 항목이 선택되지 않았습니다.\n목록에서 카드를 클릭하거나 [원클릭]을 먼저 실행해주세요.");
        return;
    }

    // 각 선택된 항목에 고유 등록 ID 부여
    selectedTrs.forEach((tr, idx) => {
        tr.dataset.regId = `reg_grk_${Date.now()}_${idx}`;
    });

    const golfrockMemo = document.getElementById('golfrockMemo')?.value || document.getElementById('golfmonMemo')?.value || '';
    const golftopMemo = document.getElementById('golftopMemo')?.value || '';

    const items = selectedTrs.map(tr => {
        const cells = tr.querySelectorAll('td');
        const origGolf = cells[2].textContent.trim();
        const rawGolf = tr.dataset.rawGolf || origGolf;
        const mappedRock = getMappedName(rawGolf, 'golfrock');
        const golfrockGolf = tr.dataset.golfrockGolf || mappedRock.name || origGolf;
        const golfrockRegion = mappedRock.region || toGolfrockRegion(cells[1].textContent.trim()) || cells[1].textContent.trim();
        const source = tr.dataset.source || 'golfrock';
        const itemMemo = resolveItemRegistrationMemo(golfrockGolf || rawGolf || origGolf);
        const waitPax = parseInt(tr.dataset.waitPax, 10) || 0;
        const waitGender = tr.dataset.waitGender || (waitPax === 0 ? '인원없음' : '남');
        return {
            regId: tr.dataset.regId,
            date: cells[0].textContent.trim(),
            region: golfrockRegion,
            golf: golfrockGolf,
            rawGolf: rawGolf,
            time: cells[3].textContent.trim(),
            fee: tr.dataset.totalFee || tr.dataset.baseFee || extractPureFeeMan(cells[4].textContent.trim()),
            fieldFee: tr.dataset.fieldFee || '',
            prepaidFee: tr.dataset.prepaidFee || '',
            cady: cells[5].textContent.trim(),
            condition: cells[6].textContent.trim(),
            sizenum: cells[7].textContent.trim(),
            waitPax: waitPax,
            waitGender: waitGender,
            roomType: tr.dataset.roomType || '',
            isPrepaid: tr.dataset.isPrepaid === 'true',
            isMeal: tr.dataset.isMeal === 'true',
            source: source,
            memo: itemMemo
        };
    });

    const memo = golfrockMemo;
    const delayPreset = document.getElementById('selRandomDelay')?.value || localStorage.getItem('v2_randomDelayPreset') || 'fast';
    const stepPreset = document.getElementById('selStepDelay')?.value || localStorage.getItem('v2_stepDelayPreset') || 'fast';

    // 조인용 원클릭 vs 양도용 원클릭 vs 한번에 원클릭(혼합) 모드 판별
    const hasTransfer = items.some(it => it.roomType === '양도');
    const hasJoin = items.some(it => it.roomType !== '양도');
    const isFirstTransfer = Boolean(items[0] && items[0].roomType === '양도');
    const isTransferMode = (hasTransfer && !hasJoin) || (!hasTransfer && !hasJoin && lastUsedMacroType === 'transfer');
    const mode = (hasTransfer && hasJoin) ? 'both' : (isTransferMode ? 'transfer' : 'join');

    const task = {
        isRunning: true,
        isAdmin: isCurrentUserAdmin(),
        platform: 'golfrock',
        mode: mode,
        isTransferMode: isFirstTransfer,
        items: items,
        currentIndex: 0,
        totalCount: items.length,
        memo: memo,
        delayPreset: delayPreset,
        stepPreset: stepPreset,
        status: 'pending',
        startedAt: Date.now()
    };

    activeConcurrentPlatforms.add('golfrock');
    try {
        const updateData = {
            golfrock_task: task,
            golfrock_isRegistrationRunning: true,
            isRegistrationRunning: true
        };
        if (!isFromMulti) {
            updateData.completedItems = [];
        }
        chrome.storage.local.set(updateData);
    } catch(e) {}

    // 즉각 진행상황 모달 표시 및 헤더 중단 버튼 활성화
    document.getElementById('btnHeaderStop')?.classList.add('active');
    showProgressModal(items.length, 'golfrock');
    if (items[0]) {
        updateProgress(1, items.length, items[0].golf, items[0].date, items[0].time);
    }

    const targetUrl = `https://m.golfrock.co.kr/tran_write.asp?tran_div=${isFirstTransfer ? '1' : '2'}&latitude=null&longitude=null`;

    // 골프락 탭 탐색 및 실행
    chrome.tabs.query({ url: ["*://*.golfrock.co.kr/*", "https://golfrock.co.kr/*", "http://golfrock.co.kr/*"] }, (tabs) => {
        if (tabs && tabs.length > 0) {
            const golfrockTab = tabs[0];
            const currentTabUrl = golfrockTab.url || '';
            const isAlreadyOnWritePage = currentTabUrl.includes('tran_write.asp') && currentTabUrl.includes(`tran_div=${isFirstTransfer ? '1' : '2'}`);

            if (isAlreadyOnWritePage) {
                chrome.tabs.update(golfrockTab.id, { active: true }, () => {
                    chrome.tabs.sendMessage(golfrockTab.id, {
                        action: 'START_GOLFROCK_REGISTRATION',
                        isAdmin: isCurrentUserAdmin(),
                        items: items,
                        memo: memo,
                        mode: mode,
                        delayPreset: delayPreset,
                        stepPreset: stepPreset
                    }, (response) => {
                        if (chrome.runtime.lastError) {
                            console.log("[Tee82] 골프락 탭 활성화 완료:", golfrockTab.url);
                        }
                    });
                });
            } else {
                chrome.tabs.update(golfrockTab.id, { url: targetUrl, active: true }, () => {
                    console.log("[Tee82] 골프락 등록 폼으로 페이지 이동:", targetUrl);
                });
            }
        } else {
            if (confirm("열려 있는 골프락(golfrock.co.kr) 탭이 없습니다.\n골프락 등록 페이지를 새 탭으로 여시겠습니까?")) {
                chrome.tabs.create({ url: targetUrl });
            }
        }
    });
}

