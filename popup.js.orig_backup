/**
 * Tee82 - 골프몬(golfmon.net) 조인 자동등록 올인원 변환기
 * AdGuard 스타일의 컴팩트 모던 UI & 카드형 티타임 뷰 엔진
 */

// 기본 동기화 코드 (사용자 기본 제공 사전 데이터)
const DEFAULT_SYNC_CODE = "";

// 동기화 코드 디코더 (순수 Base64, 하이브리드, URL인코딩, JSON 모두 대응)
function decodeSyncString(str) {
    if (!str || typeof str !== 'string') return null;
    str = str.trim().replace(/[\r\n\t\s]+/g, '').replace(/^['"]|['"]$/g, '');
    if (!str) return null;

    // 1. 순수 Base64 + URL 인코딩 (atob -> decodeURIComponent)
    try {
        let b64 = str;
        while (b64.length % 4 !== 0) b64 += '=';
        const binaryStr = (typeof atob === 'function')
            ? atob(b64)
            : (typeof Buffer !== 'undefined' ? Buffer.from(b64, 'base64').toString('binary') : '');
        if (binaryStr) {
            try {
                const decoded = JSON.parse(decodeURIComponent(binaryStr));
                if (decoded && typeof decoded === 'object') return decoded;
            } catch(e) {}

            try {
                const bytes = new Uint8Array(binaryStr.length);
                for (let i = 0; i < binaryStr.length; i++) {
                    bytes[i] = binaryStr.charCodeAt(i);
                }
                const utf8Str = (typeof TextDecoder !== 'undefined')
                    ? new TextDecoder('utf-8').decode(bytes)
                    : decodeURIComponent(escape(binaryStr));
                try {
                    const decoded = JSON.parse(decodeURIComponent(utf8Str));
                    if (decoded && typeof decoded === 'object') return decoded;
                } catch(e) {}
                const decodedDirect = JSON.parse(utf8Str);
                if (decodedDirect && typeof decodedDirect === 'object') return decodedDirect;
            } catch(e) {}
        }
    } catch(e) {}

    // 2. 하이브리드 인코딩 (앞 50글자 Base64 + 뒷부분 URL인코딩)
    try {
        if (str.startsWith("JTdCJTIy") && str.length > 50) {
            const b64Part = str.substring(0, 50) + "==";
            const decodedB64 = (typeof atob === 'function') ? atob(b64Part) : Buffer.from(b64Part, 'base64').toString('utf8');
            const fullUri = decodedB64 + str.substring(50);
            const decoded = JSON.parse(decodeURIComponent(fullUri));
            if (decoded && typeof decoded === 'object') return decoded;
        }
    } catch(e) {}

    // 3. 순수 URI 인코딩 JSON
    try {
        if (str.includes('%7B') || str.includes('%7b') || str.includes('%22')) {
            const decoded = JSON.parse(decodeURIComponent(str));
            if (decoded && typeof decoded === 'object') return decoded;
        }
    } catch(e) {}

    // 4. 일반 JSON
    try {
        const decoded = JSON.parse(str);
        if (decoded && typeof decoded === 'object') return decoded;
    } catch(e) {}

    return null;
}

// 기본 사전 로드 및 초기화
const defaultDict = decodeSyncString(DEFAULT_SYNC_CODE) || {};

// 글로벌 인증 회원 객체 (TDZ 방지 전역 선언)
var currentAuthUser = null;

// 골마켓 전용 기본 골프장명 매핑 테이블
const GOLMARKET_GOLF_NAME_MAP = {
    '골프존진천': '골프존카운티 진천',
    '골프존화랑': '골프존카운티 화랑',
    '골프존송도': '골프존카운티 송도',
    '골프존천안': '골프존카운티 천안',
    '골프존 진천': '골프존카운티 진천',
    '골프존 화랑': '골프존카운티 화랑',
    '골프존 송도': '골프존카운티 송도',
    '골프존 천안': '골프존카운티 천안',
    '골프존카운티진천': '골프존카운티 진천',
